@namespace API.HR.Node.Components.DesignSystem

<div class="@ComputedClass" @attributes="AdditionalAttributes">
    <div class="hr-empty-art @(IsDanger ? "hr-empty-art-danger" : "")" aria-hidden="true">
        <Icon Name="@IconName" Size="lg" />
    </div>
    <h3 class="hr-empty-title">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="hr-empty-desc">@Description</p>
    }
    @if (ChildContent != null)
    {
        <div class="hr-empty-custom">
            @ChildContent
        </div>
    }
    @if (!string.IsNullOrEmpty(ActionLabel) || !string.IsNullOrEmpty(SecondaryActionLabel))
    {
        <div class="hr-empty-actions">
            @if (!string.IsNullOrEmpty(ActionLabel))
            {
                <DsButton Variant="DsButton.ButtonVariant.Primary"
                          Size="DsButton.ButtonSize.Sm"
                          OnClick="HandleAction">
                    @ActionLabel
                </DsButton>
            }
            @if (!string.IsNullOrEmpty(SecondaryActionLabel))
            {
                <DsButton Variant="DsButton.ButtonVariant.Secondary"
                          Size="DsButton.ButtonSize.Sm"
                          OnClick="HandleSecondaryAction">
                    @SecondaryActionLabel
                </DsButton>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string IconName { get; set; } = "inbox";
    [Parameter] public bool IsDanger { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public string? SecondaryActionLabel { get; set; }
    [Parameter] public EventCallback OnSecondaryAction { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var classes = new List<string> { "hr-empty" };
            if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private async Task HandleAction()
    {
        if (OnAction.HasDelegate)
        {
            await OnAction.InvokeAsync();
        }
    }

    private async Task HandleSecondaryAction()
    {
        if (OnSecondaryAction.HasDelegate)
        {
            await OnSecondaryAction.InvokeAsync();
        }
    }
}
