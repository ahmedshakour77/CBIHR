@namespace API.HR.Node.Components.DesignSystem

@for (var i = 0; i < Count; i++)
{
    <div class="@ComputedClass"
         style="@InlineStyle"
         aria-hidden="true"
         @attributes="AdditionalAttributes"></div>
}

@code {
    public enum SkeletonType
    {
        Text,
        Avatar,
        Card,
        Row
    }

    [Parameter] public SkeletonType Type { get; set; } = SkeletonType.Text;
    [Parameter] public int Count { get; set; } = 1;
    [Parameter] public string? Height { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Radius { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var typeClass = Type switch
            {
                SkeletonType.Avatar => "hr-skeleton-avatar",
                SkeletonType.Card => "hr-skeleton-card",
                SkeletonType.Row => "hr-skeleton-row",
                _ => "hr-skeleton-text"
            };

            var classes = new List<string> { "hr-skeleton", typeClass };
            if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private string InlineStyle
    {
        get
        {
            var styles = new List<string>();
            if (!string.IsNullOrEmpty(Height)) styles.Add($"height:{Height}");
            if (!string.IsNullOrEmpty(Width)) styles.Add($"width:{Width}");
            if (!string.IsNullOrEmpty(Radius)) styles.Add($"border-radius:{Radius}");
            return string.Join(";", styles);
        }
    }
}
