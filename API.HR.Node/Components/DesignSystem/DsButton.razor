@namespace API.HR.Node.Components.DesignSystem

<button type="@Type"
        class="@ComputedClass"
        disabled="@(Disabled || Loading)"
        aria-busy="@(Loading ? "true" : "false")"
        aria-label="@AriaLabel"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="hr-spinner" aria-hidden="true"></span>
        @if (ChildContent != null)
        {
            <span>@ChildContent</span>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(IconLeading))
        {
            <Icon Name="@IconLeading" Size="@IconSize" />
        }
        @if (ChildContent != null)
        {
            @ChildContent
        }
        @if (!string.IsNullOrEmpty(IconTrailing))
        {
            <Icon Name="@IconTrailing" Size="@IconSize" />
        }
    }
</button>

@code {
    public enum ButtonVariant
    {
        Primary,
        Secondary,
        Ghost,
        Quiet,
        Danger
    }

    public enum ButtonSize
    {
        Sm,
        Md,
        Lg
    }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Md;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? IconLeading { get; set; }
    [Parameter] public string? IconTrailing { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string IconSize => Size switch
    {
        ButtonSize.Sm => "xs",
        ButtonSize.Lg => "md",
        _ => "sm"
    };

    private string ComputedClass
    {
        get
        {
            var variantClass = Variant switch
            {
                ButtonVariant.Secondary => "hr-btn-secondary",
                ButtonVariant.Ghost => "hr-btn--ghost",
                ButtonVariant.Quiet => "hr-btn-quiet",
                ButtonVariant.Danger => "hr-btn-danger",
                _ => "hr-btn-primary"
            };

            var sizeClass = Size switch
            {
                ButtonSize.Sm => "hr-btn-sm",
                ButtonSize.Lg => "hr-btn-lg",
                _ => ""
            };

            var classes = new List<string> { "hr-btn", variantClass };
            if (!string.IsNullOrEmpty(sizeClass)) classes.Add(sizeClass);
            if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!Disabled && !Loading && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}
