    /// <summary>Catalog key, e.g. "users" or "chevron-down".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "question-mark-circle";

    /// <summary>xs | sm | md | lg | xl. Maps onto the .hr-i-* size steps.</summary>
    [Parameter] public string? Size { get; set; }

    /// <summary>Extra classes, for colour or spacing.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Accessible name. Supply only when the icon carries meaning alone.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public double StrokeWidth { get; set; } = 1.5;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

