@*
    Password input with a reveal toggle.

    Typing a password blind is where most mistyped-password loops start, so
    the toggle is standard here. It reports its own state through
    aria-pressed and swaps its label, rather than relying on the icon alone
    to say whether the value is currently visible.

    The field keeps autocomplete on and allows paste, so password managers
    keep working — an authentication step should never require someone to
    remember and retype a secret.
*@

<div class="hr-field">
    <label class="hr-field-label" for="@Id">
        @Label
        @if (Required)
        {
            <span class="hr-req" aria-hidden="true">*</span>
            <span class="hr-sr">(حقل مطلوب)</span>
        }
    </label>

    <div class="hr-pw">
        <input id="@Id"
               type="@(revealed ? "text" : "password")"
               class="hr-input"
               autocomplete="@Autocomplete"
               placeholder="@Placeholder"
               aria-describedby="@(string.IsNullOrWhiteSpace(Help) ? null : helpId)"
               value="@Value"
               @oninput="OnInput" />

        <button type="button"
                class="hr-pw-toggle"
                @onclick="Toggle"
                aria-pressed="@(revealed ? "true" : "false")"
                aria-label="@(revealed ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")"
                title="@(revealed ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")">
            <Icon Name="@(revealed ? "eye-slash" : "eye")" Size="sm" />
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Help))
    {
        <p id="@helpId" class="hr-help">@Help</p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "كلمة المرور";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool revealed;
    private readonly string Id = $"pw-{Guid.NewGuid():N}";
    private string helpId => $"{Id}-help";

    private void Toggle() => revealed = !revealed;

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
