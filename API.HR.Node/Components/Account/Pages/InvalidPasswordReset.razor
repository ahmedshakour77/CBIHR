@page "/Account/InvalidPasswordReset"

<PageTitle>رابط غير صالح | منظومة الموارد البشرية</PageTitle>

<div class="hr-stack">
    <div class="hr-card">
        <div class="hr-card-body">
            <div class="hr-empty">
                <span class="hr-empty-art hr-empty-art-danger" aria-hidden="true">
                    <Icon Name="link-slash" Size="lg" />
                </span>
                <h1 class="hr-h1">رابط إعادة التعيين غير صالح</h1>
                <p class="hr-sub hr-measure-sm" role="alert">
                    انتهت صلاحية الرابط أو أنه استُخدم من قبل. اطلب رابطاً جديداً للمتابعة.
                </p>
                <a class="hr-btn hr-btn-primary" href="Account/ForgotPassword" style="margin-block-start:.5rem">
                    <Icon Name="arrow-path" Size="sm" />
                    <span>طلب رابط جديد</span>
                </a>
            </div>
        </div>
    </div>
</div>
