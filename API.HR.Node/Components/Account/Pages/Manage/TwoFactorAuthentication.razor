@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using API.HR.Node.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>التحقق بخطوتين | منظومة الموارد البشرية</PageTitle>

@*
    Recovery-code supply is the thing most likely to lock someone out, so it
    is stated as a count whose severity rises as the count falls — and each
    level says what to do about it, not just that a number is low.
*@

<div class="hr-stack-sm">
    <StatusMessage />

    @if (!canTrack)
    {
        <div class="hr-alert hr-alert-danger" role="alert">
            <Icon Name="exclamation-triangle" Size="sm" />
            <div>
                <p class="hr-alert-title">لم تُقبل سياسة الخصوصية وملفات الارتباط</p>
                <p style="margin-block-start:.25rem">
                    يلزم قبول السياسة قبل تفعيل التحقق بخطوتين.
                </p>
            </div>
        </div>
    }
    else
    {
        @if (is2faEnabled)
        {
            @if (recoveryCodesLeft == 0)
            {
                <div class="hr-alert hr-alert-danger" role="alert">
                    <Icon Name="exclamation-triangle" Size="sm" />
                    <div>
                        <p class="hr-alert-title">لم تتبقَّ أي رموز استرداد</p>
                        <p style="margin-block-start:.25rem">
                            يجب <a class="hr-link" href="Account/Manage/GenerateRecoveryCodes">توليد مجموعة جديدة</a>
                            قبل أن تتمكن من الدخول برمز استرداد.
                        </p>
                    </div>
                </div>
            }
            else if (recoveryCodesLeft == 1)
            {
                <div class="hr-alert hr-alert-danger" role="alert">
                    <Icon Name="exclamation-triangle" Size="sm" />
                    <div>
                        <p class="hr-alert-title">تبقى رمز استرداد واحد</p>
                        <p style="margin-block-start:.25rem">
                            يُنصح بشدة <a class="hr-link" href="Account/Manage/GenerateRecoveryCodes">بتوليد مجموعة جديدة</a> الآن.
                        </p>
                    </div>
                </div>
            }
            else if (recoveryCodesLeft <= 3)
            {
                <div class="hr-alert hr-alert-warn" role="alert">
                    <Icon Name="exclamation-circle" Size="sm" />
                    <div>
                        <p class="hr-alert-title">
                            تبقت <span class="hr-num">@recoveryCodesLeft</span> رموز استرداد
                        </p>
                        <p style="margin-block-start:.25rem">
                            يُستحسن <a class="hr-link" href="Account/Manage/GenerateRecoveryCodes">توليد مجموعة جديدة</a>.
                        </p>
                    </div>
                </div>
            }
        }

        <section class="hr-card">
            <div class="hr-card-head">
                <div class="hr-idcell">
                    <span class="hr-iconplate @(is2faEnabled ? "hr-iconplate-ok" : "")" aria-hidden="true">
                        <Icon Name="shield-check" Size="sm" />
                    </span>
                    <div class="hr-idcell-text">
                        <h2 class="hr-h2">التحقق بخطوتين</h2>
                        <p class="hr-meta" style="margin-block-start:.25rem">طبقة حماية إضافية عند تسجيل الدخول</p>
                    </div>
                    @if (is2faEnabled)
                    {
                        <span class="hr-badge hr-badge-ok">
                            <Icon Name="check-circle" Size="xs" />
                            <span>مفعّل</span>
                        </span>
                    }
                    else
                    {
                        <span class="hr-badge hr-badge-warn">
                            <Icon Name="no-symbol" Size="xs" />
                            <span>غير مفعّل</span>
                        </span>
                    }
                </div>
            </div>

            <div class="hr-card-body">
                <dl class="hr-deflist">
                    <div class="hr-deflist-row">
                        <dt>تطبيق المصادقة</dt>
                        <dd>@(hasAuthenticator ? "مُعدّ" : "غير مُعدّ")</dd>
                    </div>
                    @if (is2faEnabled)
                    {
                        <div class="hr-deflist-row">
                            <dt>رموز الاسترداد المتبقية</dt>
                            <dd class="hr-num">@recoveryCodesLeft</dd>
                        </div>
                        <div class="hr-deflist-row">
                            <dt>هذا المتصفح</dt>
                            <dd>@(isMachineRemembered ? "متذكَّر، ولا يُطلب رمز عليه" : "غير متذكَّر")</dd>
                        </div>
                    }
                </dl>
            </div>

            <div class="hr-card-foot hr-settings-actions">
                @if (!hasAuthenticator)
                {
                    <a href="Account/Manage/EnableAuthenticator" class="hr-btn hr-btn-primary">
                        <Icon Name="plus" Size="xs" />
                        <span>إضافة تطبيق مصادقة</span>
                    </a>
                }
                else
                {
                    <a href="Account/Manage/EnableAuthenticator" class="hr-btn hr-btn-secondary">
                        <Icon Name="cog-6-tooth" Size="xs" />
                        <span>إعداد تطبيق المصادقة</span>
                    </a>
                    <a href="Account/Manage/ResetAuthenticator" class="hr-btn hr-btn-secondary">
                        <Icon Name="arrow-path" Size="xs" />
                        <span>إعادة تعيين المفتاح</span>
                    </a>
                }

                @if (is2faEnabled)
                {
                    <a href="Account/Manage/GenerateRecoveryCodes" class="hr-btn hr-btn-secondary">
                        <Icon Name="key" Size="xs" />
                        <span>رموز الاسترداد</span>
                    </a>

                    @if (isMachineRemembered)
                    {
                        <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="hr-btn hr-btn-secondary">
                                <Icon Name="computer-desktop" Size="xs" />
                                <span>عدم تذكر هذا المتصفح</span>
                            </button>
                        </form>
                    }

                    <span class="hr-rowactions-sep" aria-hidden="true"></span>

                    <a href="Account/Manage/Disable2fa" class="hr-btn hr-btn-danger-quiet">
                        <Icon Name="no-symbol" Size="xs" />
                        <span>إيقاف التحقق بخطوتين</span>
                    </a>
                }
            </div>
        </section>
    }
</div>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "The current browser has been forgotten. When you login again from this browser you will be prompted for your 2fa code.",
            HttpContext);
    }
}
