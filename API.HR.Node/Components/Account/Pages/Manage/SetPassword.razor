@page "/Account/Manage/SetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using API.HR.Node.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>تعيين كلمة مرور | منظومة الموارد البشرية</PageTitle>

<div class="hr-stack-sm">
    <StatusMessage Message="@message" />

    <section class="hr-card">
        <div class="hr-card-head">
            <div>
                <h2 class="hr-h2">تعيين كلمة مرور</h2>
                <p class="hr-meta" style="margin-block-start:.25rem">لحسابك حالياً دخول خارجي فقط</p>
            </div>
        </div>

        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            <div class="hr-card-body">
                <div class="hr-alert hr-alert-accent" style="margin-block-end:1rem">
                    <Icon Name="information-circle" Size="sm" />
                    <p>
                        دخولك حالياً يتم عبر مزوّد خارجي دون كلمة مرور محلية.
                        تعيين كلمة مرور يتيح لك الدخول مباشرة إلى النظام أيضاً.
                    </p>
                </div>

                <ValidationSummary class="hr-error-summary" role="alert" />

                <div class="hr-field">
                    <label class="hr-field-label" for="Input.NewPassword">
                        كلمة المرور <span class="hr-req" aria-hidden="true">*</span><span class="hr-sr">(حقل مطلوب)</span>
                    </label>
                    <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="hr-input" dir="ltr"
                               autocomplete="new-password" aria-required="true" aria-describedby="sp-help" />
                    <ValidationMessage For="() => Input.NewPassword" class="hr-error" />
                    <p id="sp-help" class="hr-help">ستة أحرف على الأقل.</p>
                </div>

                <div class="hr-field">
                    <label class="hr-field-label" for="Input.ConfirmPassword">
                        تأكيد كلمة المرور <span class="hr-req" aria-hidden="true">*</span><span class="hr-sr">(حقل مطلوب)</span>
                    </label>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="hr-input" dir="ltr"
                               autocomplete="new-password" aria-required="true" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="hr-error" />
                </div>
            </div>

            <div class="hr-card-foot" style="display:flex;justify-content:flex-end">
                <button type="submit" class="hr-btn hr-btn-primary">
                    <Icon Name="check" Size="xs" />
                    <span>تعيين كلمة المرور</span>
                </button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var hasPassword = await UserManager.HasPasswordAsync(user);
        if (hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var addPasswordResult = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            message = $"Error: {string.Join("، ", addPasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("تم تعيين كلمة المرور.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "أدخل كلمة المرور.")]
        [StringLength(100, ErrorMessage = "يجب أن تتكوّن كلمة المرور من {2} حرفاً على الأقل و{1} على الأكثر.", MinimumLength = 10)]
        [DataType(DataType.Password)]
        [Display(Name = "كلمة المرور")]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Display(Name = "تأكيد كلمة المرور")]
        [Compare("NewPassword", ErrorMessage = "كلمتا المرور غير متطابقتين.")]
        public string? ConfirmPassword { get; set; }
    }
}
