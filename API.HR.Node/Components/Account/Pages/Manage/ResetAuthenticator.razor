@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using API.HR.Node.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>إعادة تعيين مفتاح المصادقة | منظومة الموارد البشرية</PageTitle>

<div class="hr-stack-sm">
    <StatusMessage />

    <section class="hr-card">
        <div class="hr-card-head">
            <div class="hr-idcell">
                <span class="hr-iconplate hr-iconplate-danger" aria-hidden="true">
                    <Icon Name="exclamation-triangle" Size="sm" />
                </span>
                <div class="hr-idcell-text">
                    <h2 class="hr-h2">إعادة تعيين مفتاح المصادقة</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">سيتوقف تطبيق المصادقة الحالي عن العمل</p>
                </div>
            </div>
        </div>

        <div class="hr-card-body">
            <div class="hr-alert hr-alert-danger">
                <Icon Name="exclamation-triangle" Size="sm" />
                <div>
                    <p class="hr-alert-title">لن يعمل تطبيق المصادقة حتى تعيد إعداده</p>
                    <p style="margin-block-start:.25rem">
                        يوقف هذا الإجراء التحقق بخطوتين مؤقتاً إلى أن تربط التطبيق بالمفتاح الجديد.
                        إن لم تُكمل الإعداد، فقد تفقد إمكانية الوصول إلى حسابك.
                    </p>
                </div>
            </div>
        </div>

        <div class="hr-card-foot" style="display:flex;justify-content:flex-end">
            <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
                <AntiforgeryToken />
                <button class="hr-btn hr-btn-danger" type="submit">
                    <Icon Name="arrow-path" Size="xs" />
                    <span>إعادة تعيين المفتاح</span>
                </button>
            </form>
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "أُعيد تعيين مفتاح المصادقة. أعد إعداد التطبيق باستخدام المفتاح الجديد.",
            HttpContext);
    }
}
