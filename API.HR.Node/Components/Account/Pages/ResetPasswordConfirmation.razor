@page "/Account/ResetPasswordConfirmation"

<PageTitle>تم تغيير كلمة المرور | الموظف ٣٦٠°   </PageTitle>

<div class="hr-stack">
    <div class="hr-card">
        <div class="hr-card-body">
            <div class="hr-empty">
                <span class="hr-empty-art hr-empty-art-ok" aria-hidden="true">
                    <Icon Name="check-circle" Size="lg" />
                </span>
                <h1 class="hr-h1">تم تغيير كلمة المرور</h1>
                <p class="hr-sub hr-measure-sm" role="alert">
                    يمكنك الآن تسجيل الدخول بكلمة المرور الجديدة.
                </p>
                <a class="hr-btn hr-btn-primary" href="Account/Login" style="margin-block-start:.5rem">
                    <Icon Name="arrow-right-on-rectangle" Size="sm" />
                    <span>تسجيل الدخول</span>
                </a>
            </div>
        </div>
    </div>
</div>
