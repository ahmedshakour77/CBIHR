@page "/Account/ExternalLogin"
@layout API.HR.Node.Components.Layout.FocusLayout

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger
@inject API.HR.Node.Services.Identity.IUserEmployeeService UserEmployeeService

<PageTitle>جارٍ التحقق من الحساب | الموظف ٣٦٠°   </PageTitle>

@*
    A transient screen: the browser lands here mid-handshake and is
    redirected on. It says what is happening rather than only spinning, so
    a slow provider response does not read as a hang.
*@

<div class="hr-focus-center">
    <div class="hr-card hr-focus-card">
        <div class="hr-card-body">
            <div class="hr-empty">
                <span class="hr-spinner hr-spinner-lg" aria-hidden="true"></span>
                <h1 class="hr-h2">جارٍ التحقق من الحساب</h1>
                <p class="hr-sub hr-measure-sm">
                    يجري توثيق دخولك عبر Microsoft ومطابقته مع قائمة الحسابات المصرّح لها.
                </p>
                <div style="width:100%;text-align:start">
                    <StatusMessage Message="@message" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private string? message;
    private ExternalLoginInfo? externalLoginInfo;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"خطأ من المزود الخارجي: {RemoteError}", HttpContext);
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "تعذر جلب بيانات المصادقة الخارجية من Microsoft.", HttpContext);
            return;
        }

        externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        if (externalLoginInfo is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "تعذر تحميل معلومات الدخول الخارجي.", HttpContext);
            return;
        }

        // 1. Extract Email and Phone Number from Claims
        var email = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Email)
            ?? externalLoginInfo.Principal.FindFirstValue("preferred_username")
            ?? externalLoginInfo.Principal.FindFirstValue(ClaimTypes.Name);

        var phoneNumber = externalLoginInfo.Principal.FindFirstValue(ClaimTypes.MobilePhone)
            ?? externalLoginInfo.Principal.FindFirstValue(ClaimTypes.OtherPhone)
            ?? externalLoginInfo.Principal.FindFirstValue("phone_number");

        if (string.IsNullOrEmpty(email))
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "لم يتم العثور على بريد إلكتروني مرتبط بحساب Microsoft الخاص بك.", HttpContext);
            return;
        }

        // 2. Whitelist Verification (Check Email or Phone Number against AllowedUsers)
        var hasWhitelist = await DbContext.AllowedUsers.AnyAsync();
        if (hasWhitelist)
        {
            var isAllowed = await DbContext.AllowedUsers.AnyAsync(w =>
                w.IsActive &&
                ((!string.IsNullOrEmpty(email) && w.Email == email) ||
                 (!string.IsNullOrEmpty(phoneNumber) && w.PhoneNumber == phoneNumber)));

            if (!isAllowed)
            {
                Logger.LogWarning("Unauthorized login attempt by non-whitelisted email {Email} / phone {Phone}", email, phoneNumber);
                RedirectManager.RedirectToWithStatus("Account/Login", "عذراً، هذا البريد الإلكتروني أو رقم الهاتف غير مصرح له بالدخول للنظام (غير مدرج في القائمة البيضاء Whitelist). يرجى مراجعة إدارة الموارد البشرية.", HttpContext);
                return;
            }
        }

        // 3. Attempt Sign-in if login provider is already linked
        var result = await SignInManager.ExternalLoginSignInAsync(
            externalLoginInfo.LoginProvider,
            externalLoginInfo.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (result.Succeeded)
        {
            var u = await UserManager.FindByEmailAsync(email);
            if (u != null)
            {
                var linkRes = await UserEmployeeService.ValidateOrRepairUserEmployeeLinkAsync(u);
                if (!linkRes.IsValid)
                {
                    await SignInManager.SignOutAsync();
                    Logger.LogWarning("Microsoft login refused for {Email}: not linked to employee record.", email);
                    RedirectManager.RedirectToWithStatus("Account/Login", linkRes.FailureReason ?? "هذا الحساب غير مرتبط بسجل موظف في نظام الموارد البشرية. يرجى مراجعة إدارة الموارد البشرية.", HttpContext);
                    return;
                }

                Logger.LogInformation("{Name} logged in with {LoginProvider} provider.", externalLoginInfo.Principal.Identity?.Name, externalLoginInfo.LoginProvider);
                await RedirectUserAsync(u);
                return;
            }
            RedirectManager.RedirectTo(ReturnUrl);
            return;
        }

        if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        // 4. User Provisioning with Auto-Confirmed Email
        var existingUser = await UserManager.FindByEmailAsync(email);
        if (existingUser != null)
        {
            var linkRes = await UserEmployeeService.ValidateOrRepairUserEmployeeLinkAsync(existingUser);
            if (!linkRes.IsValid)
            {
                Logger.LogWarning("Microsoft login refused for existing user {Email}: not linked to employee record.", email);
                RedirectManager.RedirectToWithStatus("Account/Login", linkRes.FailureReason ?? "هذا الحساب غير مرتبط بسجل موظف في نظام الموارد البشرية. يرجى مراجعة إدارة الموارد البشرية.", HttpContext);
                return;
            }

            // Auto-confirm email if not confirmed yet
            if (!existingUser.EmailConfirmed)
            {
                existingUser.EmailConfirmed = true;
                await UserManager.UpdateAsync(existingUser);
            }

            var addLoginResult = await UserManager.AddLoginAsync(existingUser, externalLoginInfo);
            if (addLoginResult.Succeeded || addLoginResult.Errors.Any(e => e.Code == "LoginAlreadyAssociated"))
            {
                await SignInManager.SignInAsync(existingUser, isPersistent: false, externalLoginInfo.LoginProvider);
                await RedirectUserAsync(existingUser);
                return;
            }
        }

        // Strictly verify that the Microsoft email matches an existing registered Employee record
        var normEmail = email.Trim().ToLower();
        var candidateEmpIds = await DbContext.EmployeeEmails
            .AsNoTracking()
            .Where(e => e.Email.Trim().ToLower() == normEmail)
            .Select(e => e.EmployeeID)
            .Distinct()
            .ToListAsync();

        if (candidateEmpIds.Count != 1 || !await DbContext.Employees.AnyAsync(e => e.EmployeeID == candidateEmpIds[0]))
        {
            Logger.LogWarning("Refused auto-creation for Microsoft user {Email}: no unique matching employee record.", email);
            RedirectManager.RedirectToWithStatus("Account/Login", "عذراً، هذا البريد الإلكتروني غير مرتبط بأي سجل موظف في نظام الموارد البشرية. لا يمكن إنشاء حساب لمستخدم غير مسجل كموظف.", HttpContext);
            return;
        }

        var matchedEmployeeId = candidateEmpIds[0];

        // Create new user automatically with EmployeeID and EmailConfirmed = true
        var newUser = new ApplicationUser
        {
            UserName = email,
            Email = email,
            EmailConfirmed = true,
            EmployeeID = matchedEmployeeId,
            PhoneNumber = phoneNumber,
            PhoneNumberConfirmed = !string.IsNullOrEmpty(phoneNumber)
        };

        var createResult = await UserManager.CreateAsync(newUser);
        if (createResult.Succeeded)
        {
            await UserManager.AddToRoleAsync(newUser, "Employee");
            await UserManager.AddLoginAsync(newUser, externalLoginInfo);
            await SignInManager.SignInAsync(newUser, isPersistent: false, externalLoginInfo.LoginProvider);
            Logger.LogInformation("Auto-created user {Email} linked to EmployeeID {EmployeeID} via {Provider}",
                email, matchedEmployeeId, externalLoginInfo.LoginProvider);
            await RedirectUserAsync(newUser);
            return;
        }

        message = $"خطأ في إنشاء الحساب الآلي: {string.Join(", ", createResult.Errors.Select(e => e.Description))}";
    }

    private async Task RedirectUserAsync(ApplicationUser user)
    {
        var targetUrl = ReturnUrl;
        if (string.IsNullOrWhiteSpace(targetUrl) || targetUrl == "/" || targetUrl == "")
        {
            var roles = await UserManager.GetRolesAsync(user);
            var isStaff = roles.Any(r => r is "Admin" or "HRManager" or "FormationManager" or "Supervisor");
            targetUrl = isStaff ? "" : "portal";
        }
        RedirectManager.RedirectTo(targetUrl);
    }
}
