    private async Task SetMapViewModeAsync(string mode)
    {
        mapViewMode = mode;
        StateHasChanged();

        if (mode == "leaflet")
        {
            await Task.Delay(50);
            await RenderLeafletMapAsync();
        }
    }

    private async Task RenderLeafletMapAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("hrLoadScript", "js/hr-general-map.js");
            var payload = GovernorateStats.Select(g => new
            {
                code = g.Code,
                name = g.Name,
                shortName = g.ShortName,
                branchLabel = g.BranchLabel,
                isMainBranchHub = g.IsMainBranchHub,
                lat = g.Lat,
                lng = g.Lng,
                color = g.Color,
                employeeCount = g.EmployeeCount,
                arabicCount = ToArabicDigits(g.EmployeeCount),
                maleCount = g.MaleCount,
                femaleCount = g.FemaleCount,
                formationCount = g.FormationCount,
                percentage = g.Percentage
            }).ToList();

            await JSRuntime.InvokeVoidAsync("hrGeneralMap.initOrUpdate", "hrGeneralLeafletMap", payload, selectedGovCode, dotNetRef);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Leaflet map initialization warning.");
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("المحافظة,الفرع,التشكيل الإداري,إجمالي الموظفين,الذكور,الإناث,النسبة من الإجمالي %");

            foreach (var f in FilteredFormations)
            {
                var safeName = f.FormationName.Replace("\"", "\"\"");
                sb.AppendLine($"\"{f.GovernorateName}\",\"{f.BranchLabel}\",\"{safeName}\",{f.TotalCount},{f.MaleCount},{f.FemaleCount},{f.ShareOfTotal:F2}");
            }

            var csvContent = sb.ToString();
            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvContent)).ToArray();
            var base64 = Convert.ToBase64String(bytes);

            await JSRuntime.InvokeVoidAsync("eval", $@"
                (function() {{
                    var a = document.createElement('a');
                    a.href = 'data:text/csv;base64,{base64}';
                    a.download = 'Iraq-General-Map-Formations-{DateTime.Now:yyyyMMdd}.csv';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV export failed.");
        }
    }

