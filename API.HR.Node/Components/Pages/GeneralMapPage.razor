@page "/general-map"
@page "/reports/general-map"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text
@using API.HR.Node.Data
@using API.HR.Node.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@implements IAsyncDisposable

@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<GeneralMapPage> Logger

<PageTitle>الخريطة العامة — توزيع الموظفين على المحافظات | الموظف ٣٦٠°</PageTitle>

@if (!hasAccess && !isLoading)
{
    <div class="hr-card" style="padding:var(--s-6);text-align:center;margin-block:var(--s-6);">
        <Icon Name="shield-exclamation" Size="xl" />
        <h1 class="hr-h2" style="margin-block:var(--s-2);">غير مصرّح بعرض الخريطة العامة</h1>
        <p class="hr-muted">يتطلب عرض هذه الصفحة صلاحية الاطلاع على التقارير أو لوحة المؤشرات.</p>
    </div>
}
else
{
    <div class="hr-stack general-map-page">

        @* ==================== 1. HEADER & CONTROLS ==================== *@
        <header class="hr-pagehead">
            <div class="hr-pagehead-titles">
                <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                    <span class="hr-eyebrow">المؤشرات والتقارير الجغرافية</span>
                    <span class="hr-badge hr-badge-accent">
                        <Icon Name="map" Size="xs" />
                        <span>التوزيع حسب التشكيلات والفروع</span>
                    </span>
                </div>

                <h1 class="hr-h1 hr-balance" style="display:flex;align-items:center;gap:var(--s-2);margin-block-start:.25rem;">
                    <Icon Name="map" Size="md" />
                    <span>الخريطة العامة — توزيع الموظفين على المحافظات</span>
                </h1>
                <p class="hr-subtitle">
                    توزيع الكادر الوظيفي على محافظات العراق وفق الحدود الإدارية المعتمدة بالاعتماد على التشكيلات (الفرع الرئيسي في بغداد، فرع الموصل في نينوى، فرع أربيل في أربيل، وفرع البصرة في البصرة).
                </p>
            </div>

            <div class="hr-pagehead-actions" style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                <div class="hr-segmented" role="group" aria-label="نمط عرض الخريطة">
                    <button type="button"
                            class="hr-segmented-btn @(mapViewMode == "svg" ? "is-active" : "")"
                            @onclick='() => SetMapViewModeAsync("svg")'>
                        <Icon Name="map" Size="xs" />
                        <span>خارطة الحدود الإدارية</span>
                    </button>
                    <button type="button"
                            class="hr-segmented-btn @(mapViewMode == "leaflet" ? "is-active" : "")"
                            @onclick='() => SetMapViewModeAsync("leaflet")'>
                        <Icon Name="globe-alt" Size="xs" />
                        <span>الخريطة الجغرافية (GIS)</span>
                    </button>
                </div>

                <button type="button" class="hr-btn hr-btn-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="تحديث البيانات">
                    <Icon Name="arrow-path" Size="sm" />
                    <span>تحديث</span>
                </button>

                <button type="button" class="hr-btn hr-btn-secondary" @onclick="ExportCsvAsync" disabled="@isLoading" title="تصدير توزيع المحافظات والتشكيلات CSV">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>تصدير CSV</span>
                </button>

                <button type="button" class="hr-btn hr-btn-primary" @onclick="PrintPageAsync" title="طباعة التقرير">
                    <Icon Name="printer" Size="sm" />
                    <span>طباعة</span>
                </button>
            </div>
        </header>

        @if (isLoading)
        {
            <div class="hr-kpi-grid">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="hr-kpi-card">
                        <div class="hr-skeleton hr-skeleton-line" style="width:55%;height:1rem;"></div>
                        <div class="hr-skeleton" style="width:40%;height:2.2rem;margin-block:.6rem;"></div>
                        <div class="hr-skeleton hr-skeleton-line" style="width:75%;height:.75rem;"></div>
                    </div>
                }
            </div>
        }
        else
        {
            var baghdadStat = GetGovStat("BGD");
            var mosulStat = GetGovStat("NIN");
            var erbilStat = GetGovStat("EBL");
            var basraStat = GetGovStat("BSR");

            @* ==================== 2. EXECUTIVE KPI CARDS ==================== *@
            <section class="hr-kpi-grid" aria-label="ملخص التوزيع الجغرافي">
                <div class="hr-kpi-card gm-kpi-card @(selectedGovCode == null ? "is-selected" : "")"
                     style="cursor:pointer;"
                     @onclick="() => SelectGovernorateAsync(null)">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">إجمالي الكادر الوظيفي (العراق)</span>
                        <span class="hr-iconplate"><Icon Name="users" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-value">@ToArabicDigits(FilteredTotalEmployees)</div>
                        <div class="hr-kpi-meta">
                            <span>ذكور: <strong>@ToArabicDigits(FilteredTotalMales)</strong></span>
                            <span>•</span>
                            <span>إناث: <strong>@ToArabicDigits(FilteredTotalFemales)</strong></span>
                            <span>•</span>
                            <span><strong>@ToArabicDigits(TotalFormationsCount)</strong> تشكيل</span>
                        </div>
                    </div>
                </div>

                <div class="hr-kpi-card gm-kpi-card @(selectedGovCode == "BGD" ? "is-selected" : "")"
                     style="cursor:pointer;border-inline-start:4px solid #1a669d;"
                     @onclick='() => SelectGovernorateAsync("BGD")'>
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">بغداد — الفرع الرئيسي</span>
                        <span class="hr-badge" style="background:rgba(26,102,157,0.12);color:#1a669d;">@ToArabicDigits(baghdadStat.Percentage.ToString("F1"))٪</span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-value" style="color:#1a669d;">@ToArabicDigits(baghdadStat.EmployeeCount)</div>
                        <div class="hr-kpi-meta">
                            <span><strong>@ToArabicDigits(baghdadStat.FormationCount)</strong> تشكيل مركزي</span>
                            <span>•</span>
                            <span>ذكور @ToArabicDigits(baghdadStat.MaleCount) / إناث @ToArabicDigits(baghdadStat.FemaleCount)</span>
                        </div>
                    </div>
                </div>

                <div class="hr-kpi-card gm-kpi-card @(selectedGovCode == "NIN" ? "is-selected" : "")"
                     style="cursor:pointer;border-inline-start:4px solid #0d7a7b;"
                     @onclick='() => SelectGovernorateAsync("NIN")'>
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">نينوى — فرع الموصل</span>
                        <span class="hr-badge" style="background:rgba(13,122,123,0.12);color:#0d7a7b;">@ToArabicDigits(mosulStat.Percentage.ToString("F1"))٪</span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-value" style="color:#0d7a7b;">@ToArabicDigits(mosulStat.EmployeeCount)</div>
                        <div class="hr-kpi-meta">
                            <span><strong>@ToArabicDigits(mosulStat.FormationCount)</strong> تشكيل</span>
                            <span>•</span>
                            <span>ذكور @ToArabicDigits(mosulStat.MaleCount) / إناث @ToArabicDigits(mosulStat.FemaleCount)</span>
                        </div>
                    </div>
                </div>

                <div class="hr-kpi-card gm-kpi-card @(selectedGovCode == "EBL" ? "is-selected" : "")"
                     style="cursor:pointer;border-inline-start:4px solid #6b4ea2;"
                     @onclick='() => SelectGovernorateAsync("EBL")'>
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">أربيل — فرع أربيل</span>
                        <span class="hr-badge" style="background:rgba(107,78,162,0.12);color:#6b4ea2;">@ToArabicDigits(erbilStat.Percentage.ToString("F1"))٪</span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-value" style="color:#6b4ea2;">@ToArabicDigits(erbilStat.EmployeeCount)</div>
                        <div class="hr-kpi-meta">
                            <span><strong>@ToArabicDigits(erbilStat.FormationCount)</strong> تشكيل</span>
                            <span>•</span>
                            <span>ذكور @ToArabicDigits(erbilStat.MaleCount) / إناث @ToArabicDigits(erbilStat.FemaleCount)</span>
                        </div>
                    </div>
                </div>

                <div class="hr-kpi-card gm-kpi-card @(selectedGovCode == "BSR" ? "is-selected" : "")"
                     style="cursor:pointer;border-inline-start:4px solid #b45a2a;"
                     @onclick='() => SelectGovernorateAsync("BSR")'>
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">البصرة — فرع البصرة</span>
                        <span class="hr-badge" style="background:rgba(180,90,42,0.12);color:#b45a2a;">@ToArabicDigits(basraStat.Percentage.ToString("F1"))٪</span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-value" style="color:#b45a2a;">@ToArabicDigits(basraStat.EmployeeCount)</div>
                        <div class="hr-kpi-meta">
                            <span><strong>@ToArabicDigits(basraStat.FormationCount)</strong> تشكيل</span>
                            <span>•</span>
                            <span>ذكور @ToArabicDigits(basraStat.MaleCount) / إناث @ToArabicDigits(basraStat.FemaleCount)</span>
                        </div>
                    </div>
                </div>
            </section>

            @* ==================== 3. FILTER RIBBON ==================== *@
            <section class="hr-card gm-filter-bar" aria-label="فلاتر الخريطة العامة">
                <div style="display:flex;align-items:center;gap:var(--s-3);flex-wrap:wrap;width:100%;">
                    <div style="display:flex;align-items:center;gap:var(--s-2);flex:1 1 16rem;">
                        <Icon Name="magnifying-glass" Size="sm" />
                        <input type="search"
                               class="hr-input"
                               placeholder="ابحث باسم التشكيل، المحافظة، أو اسم/رقم الموظف..."
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @bind:after="OnFilterChangedAsync" />
                    </div>

                    <div style="display:flex;align-items:center;gap:var(--s-2);">
                        <label class="hr-muted" style="font-size:var(--fs-sm);white-space:nowrap;">المحافظة / الفرع:</label>
                        <select class="hr-select" style="min-width:13rem;" value="@(selectedGovCode ?? "")" @onchange="OnGovDropdownChangedAsync">
                            <option value="">كل محافظات العراق (@ToArabicDigits(FilteredTotalEmployees))</option>
                            @foreach (var gov in GovernorateStats.Where(g => g.EmployeeCount > 0 || g.IsMainBranchHub))
                            {
                                <option value="@gov.Code">@gov.Name — @gov.BranchLabel (@ToArabicDigits(gov.EmployeeCount))</option>
                            }
                        </select>
                    </div>

                    <div style="display:flex;align-items:center;gap:var(--s-2);">
                        <label class="hr-muted" style="font-size:var(--fs-sm);white-space:nowrap;">النوع الاجتماعي:</label>
                        <select class="hr-select" style="min-width:9rem;" @bind="genderFilter" @bind:after="OnFilterChangedAsync">
                            <option value="all">الكل (ذكور وإناث)</option>
                            <option value="male">الذكور فقط</option>
                            <option value="female">الإناث فقط</option>
                        </select>
                    </div>

                    @if (selectedGovCode != null || selectedFormationName != null || !string.IsNullOrWhiteSpace(searchQuery) || genderFilter != "all")
                    {
                        <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="ResetFiltersAsync">
                            <Icon Name="x-mark" Size="xs" />
                            <span>إعادة ضبط الفلاتر</span>
                        </button>
                    }
                </div>
            </section>

            @* ==================== 4. MAIN GRID: IRAQ MAP + GOVERNORATE CARDS ==================== *@
            <div class="gm-main-layout">

                @* ---- RIGHT/CENTER: ADMINISTRATIVE BOUNDARY MAP OF IRAQ (MATCHING REFERENCE DESIGN) ---- *@
                <section class="hr-card gm-map-poster" aria-label="خارطة العراق — المحافظات الأربع">
                    @* Poster Header matching user's reference image *@
                    <div class="gm-poster-header">
                        <div class="gm-poster-accent-bar"></div>
                        <h2 class="gm-poster-title">خارطة العراق</h2>
                        <p class="gm-poster-subtitle">
                            @(showAllGovernoratesOnMap ? "حدود كافة المحافظات (١٨ محافظة)" : "المحافظات الأربع")
                        </p>

                        @if (selectedGovCode != null)
                        {
                            var activeGov = GetGovStat(selectedGovCode);
                            <div style="margin-top:.5rem;">
                                <span class="hr-badge" style="background:@activeGov.Color;color:#fff;display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .75rem;">
                                    <span>المحافظة المحددة: @activeGov.Name (@activeGov.BranchLabel) — @ToArabicDigits(activeGov.EmployeeCount) موظف</span>
                                    <button type="button" style="background:none;border:none;color:#fff;cursor:pointer;padding:0;display:inline-flex;" @onclick="() => SelectGovernorateAsync(null)" title="إلغاء التحديد">
                                        <Icon Name="x-mark" Size="xs" />
                                    </button>
                                </span>
                            </div>
                        }
                    </div>

                    <div class="gm-poster-divider"></div>

                    @if (mapViewMode == "svg")
                    {
                        <div class="gm-svg-stage">
                            <svg viewBox="0 0 900 565" class="gm-iraq-svg" role="img" aria-label="خارطة العراق — توزيع الموظفين على المحافظات الأربع">
                                <defs>
                                    <filter id="gmMapShadow" x="-10%" y="-10%" width="120%" height="120%">
                                        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0f172a" flood-opacity="0.07" />
                                    </filter>
                                    <filter id="gmCalloutShadow" x="-20%" y="-25%" width="140%" height="160%">
                                        <feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#0f172a" flood-opacity="0.08" />
                                    </filter>
                                </defs>

                                @* 1. Base Outer Administrative Boundary of Iraq (ADM0) *@
                                <g filter="url(#gmMapShadow)">
                                    <path d="@IraqMapGeometry.IraqOuterPath"
                                          fill="#e6edf4"
                                          stroke="#475569"
                                          stroke-width="1.35"
                                          stroke-linejoin="round" />
                                </g>

                                @* 2. Optional 14 Other Governorates Boundaries (when toggled or if they have staff) *@
                                @foreach (var gov in GovernorateStats.Where(g => !g.IsMainBranchHub))
                                {
                                    var isSel = selectedGovCode == gov.Code;
                                    var hasEmp = gov.EmployeeCount > 0;
                                    if (showAllGovernoratesOnMap || hasEmp || isSel)
                                    {
                                        <g class="gm-gov-region @(isSel ? "is-selected" : "")"
                                           style="cursor:pointer;"
                                           @onclick="() => SelectGovernorateAsync(gov.Code)">
                                            <path d="@gov.SvgPath"
                                                  fill="@(hasEmp || isSel ? gov.Color : "#e6edf4")"
                                                  fill-opacity="@(isSel ? "0.92" : (hasEmp ? "0.82" : "1"))"
                                                  stroke="@(isSel ? "#0f172a" : "#94a3b8")"
                                                  stroke-width="@(isSel ? "2" : "0.9")"
                                                  stroke-linejoin="round" />
                                            <title>@gov.Name: @ToArabicDigits(gov.EmployeeCount) موظف</title>
                                            @if (showAllGovernoratesOnMap)
                                            {
                                                <g>
                                                    <text x="@gov.SvgX" y="@gov.SvgY" text-anchor="middle" font-size="10.5" font-weight="600" fill="@(hasEmp || isSel ? "#ffffff" : "#64748b")">
                                                        @gov.ShortName
                                                    </text>
                                                </g>
                                            }
                                        </g>
                                    }
                                }

                                @* 3. The 4 Main Governorates Colored on Exact Administrative Boundaries *@

                                @* ---- نينوى (الموصل) - Teal (#0d7a7b) ---- *@
                                @{
                                    var isNinSelected = selectedGovCode == "NIN";
                                }
                                <g class="gm-gov-region @(isNinSelected ? "is-selected" : "")"
                                   style="cursor:pointer;"
                                   @onclick='() => SelectGovernorateAsync("NIN")'>
                                    <path d="@mosulStat.SvgPath"
                                          fill="#0d7a7b"
                                          stroke="@(isNinSelected ? "#0f172a" : "#095c5d")"
                                          stroke-width="@(isNinSelected ? "2.6" : "1.2")"
                                          stroke-linejoin="round" />
                                    <text x="366" y="152"
                                          text-anchor="middle"
                                          dominant-baseline="middle"
                                          fill="#ffffff"
                                          font-size="22"
                                          font-weight="800"
                                          style="letter-spacing:0.5px;">
                                        @ToArabicDigits(mosulStat.EmployeeCount)
                                    </text>
                                    <title>نينوى (فرع الموصل): @ToArabicDigits(mosulStat.EmployeeCount) موظف (@ToArabicDigits(mosulStat.Percentage.ToString("F1"))٪)</title>
                                </g>

                                @* ---- أربيل - Purple (#6b4ea2) ---- *@
                                @{
                                    var isEblSelected = selectedGovCode == "EBL";
                                }
                                <g class="gm-gov-region @(isEblSelected ? "is-selected" : "")"
                                   style="cursor:pointer;"
                                   @onclick='() => SelectGovernorateAsync("EBL")'>
                                    <path d="@erbilStat.SvgPath"
                                          fill="#6b4ea2"
                                          stroke="@(isEblSelected ? "#0f172a" : "#533a82")"
                                          stroke-width="@(isEblSelected ? "2.6" : "1.2")"
                                          stroke-linejoin="round" />
                                    <text x="476" y="91"
                                          text-anchor="middle"
                                          dominant-baseline="middle"
                                          fill="#ffffff"
                                          font-size="18"
                                          font-weight="800">
                                        @ToArabicDigits(erbilStat.EmployeeCount)
                                    </text>
                                    <title>أربيل (فرع أربيل): @ToArabicDigits(erbilStat.EmployeeCount) موظف (@ToArabicDigits(erbilStat.Percentage.ToString("F1"))٪)</title>
                                </g>

                                @* ---- بغداد - Royal Blue (#1a669d) ---- *@
                                @{
                                    var isBgdSelected = selectedGovCode == "BGD";
                                }
                                <g class="gm-gov-region @(isBgdSelected ? "is-selected" : "")"
                                   style="cursor:pointer;"
                                   @onclick='() => SelectGovernorateAsync("BGD")'>
                                    <path d="@baghdadStat.SvgPath"
                                          transform="translate(480.4, 271.7) scale(1.38) translate(-480.4, -271.7)"
                                          fill="#1a669d"
                                          stroke="@(isBgdSelected ? "#0f172a" : "#124b75")"
                                          stroke-width="@(isBgdSelected ? "2.2" : "1.0")"
                                          stroke-linejoin="round" />
                                    <text x="480" y="275"
                                          text-anchor="middle"
                                          dominant-baseline="middle"
                                          fill="#ffffff"
                                          font-size="16"
                                          font-weight="800">
                                        @ToArabicDigits(baghdadStat.EmployeeCount)
                                    </text>
                                    <title>بغداد (الفرع الرئيسي والتشكيلات المركزية): @ToArabicDigits(baghdadStat.EmployeeCount) موظف (@ToArabicDigits(baghdadStat.Percentage.ToString("F1"))٪)</title>
                                </g>

                                @* ---- البصرة - Terracotta (#b45a2a) ---- *@
                                @{
                                    var isBsrSelected = selectedGovCode == "BSR";
                                }
                                <g class="gm-gov-region @(isBsrSelected ? "is-selected" : "")"
                                   style="cursor:pointer;"
                                   @onclick='() => SelectGovernorateAsync("BSR")'>
                                    <path d="@basraStat.SvgPath"
                                          fill="#b45a2a"
                                          stroke="@(isBsrSelected ? "#0f172a" : "#8f441e")"
                                          stroke-width="@(isBsrSelected ? "2.6" : "1.2")"
                                          stroke-linejoin="round" />
                                    <text x="627" y="456"
                                          text-anchor="middle"
                                          dominant-baseline="middle"
                                          fill="#ffffff"
                                          font-size="20"
                                          font-weight="800">
                                        @ToArabicDigits(basraStat.EmployeeCount)
                                    </text>
                                    <title>البصرة (فرع البصرة): @ToArabicDigits(basraStat.EmployeeCount) موظف (@ToArabicDigits(basraStat.Percentage.ToString("F1"))٪)</title>
                                </g>

                                @* 4. Callout Lines & Callout Label Cards (Exact Reference Layout) *@

                                @* ---- Callout: نينوى / الموصل (Left) ---- *@
                                <g style="cursor:pointer;" @onclick='() => SelectGovernorateAsync("NIN")'>
                                    <path d="M 412 103 L 266 112" stroke="#ffffff" stroke-width="3.6" fill="none" stroke-linecap="round" />
                                    <path d="M 412 103 L 266 112" stroke="#0d7a7b" stroke-width="2" fill="none" stroke-linecap="round" />
                                    <circle cx="412" cy="103" r="4.2" fill="#0d7a7b" stroke="#ffffff" stroke-width="2" />

                                    <g filter="url(#gmCalloutShadow)">
                                        <rect x="64" y="80" width="202" height="62" rx="10"
                                              fill="#ffffff"
                                              stroke="@(isNinSelected ? "#0d7a7b" : "#e2e8f0")"
                                              stroke-width="@(isNinSelected ? "2.2" : "1")" />
                                    </g>
                                    <circle cx="246" cy="111" r="4.5" fill="#0d7a7b" />
                                    <text x="156" y="106" text-anchor="middle" font-size="20" font-weight="800" fill="#1e293b">نينوى</text>
                                    <text x="156" y="128" text-anchor="middle" font-size="13.5" font-weight="500" fill="#64748b">الموصل</text>
                                </g>

                                @* ---- Callout: أربيل (Top Right) ---- *@
                                <g style="cursor:pointer;" @onclick='() => SelectGovernorateAsync("EBL")'>
                                    <path d="M 466 106 L 495 96 L 560 96" stroke="#ffffff" stroke-width="3.4" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                                    <path d="M 466 106 L 495 96 L 560 96" stroke="#6b4ea2" stroke-width="1.8" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                                    <circle cx="466" cy="106" r="4" fill="#6b4ea2" stroke="#ffffff" stroke-width="2" />

                                    <g filter="url(#gmCalloutShadow)">
                                        <rect x="560" y="68" width="156" height="56" rx="10"
                                              fill="#ffffff"
                                              stroke="@(isEblSelected ? "#6b4ea2" : "#e2e8f0")"
                                              stroke-width="@(isEblSelected ? "2.2" : "1")" />
                                    </g>
                                    <circle cx="696" cy="96" r="4.5" fill="#6b4ea2" />
                                    <text x="630" y="103" text-anchor="middle" font-size="20" font-weight="800" fill="#1e293b">أربيل</text>
                                </g>

                                @* ---- Callout: بغداد (Middle Right) ---- *@
                                <g style="cursor:pointer;" @onclick='() => SelectGovernorateAsync("BGD")'>
                                    <path d="M 490 264 L 632 268" stroke="#ffffff" stroke-width="3.6" fill="none" stroke-linecap="round" />
                                    <path d="M 490 264 L 632 268" stroke="#1a669d" stroke-width="2" fill="none" stroke-linecap="round" />
                                    <circle cx="490" cy="264" r="4.2" fill="#1a669d" stroke="#ffffff" stroke-width="2" />

                                    <g filter="url(#gmCalloutShadow)">
                                        <rect x="632" y="240" width="158" height="56" rx="10"
                                              fill="#ffffff"
                                              stroke="@(isBgdSelected ? "#1a669d" : "#e2e8f0")"
                                              stroke-width="@(isBgdSelected ? "2.2" : "1")" />
                                    </g>
                                    <circle cx="770" cy="268" r="4.5" fill="#1a669d" />
                                    <text x="702" y="275" text-anchor="middle" font-size="20" font-weight="800" fill="#1e293b">بغداد</text>
                                </g>

                                @* ---- Callout: البصرة (Bottom Right) ---- *@
                                <g style="cursor:pointer;" @onclick='() => SelectGovernorateAsync("BSR")'>
                                    <path d="M 655 443 L 672 452 L 722 452" stroke="#ffffff" stroke-width="3.4" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                                    <path d="M 655 443 L 672 452 L 722 452" stroke="#b45a2a" stroke-width="1.8" fill="none" stroke-linejoin="round" stroke-linecap="round" />
                                    <circle cx="655" cy="443" r="4" fill="#b45a2a" stroke="#ffffff" stroke-width="2" />

                                    <g filter="url(#gmCalloutShadow)">
                                        <rect x="722" y="424" width="154" height="56" rx="10"
                                              fill="#ffffff"
                                              stroke="@(isBsrSelected ? "#b45a2a" : "#e2e8f0")"
                                              stroke-width="@(isBsrSelected ? "2.2" : "1")" />
                                    </g>
                                    <circle cx="856" cy="452" r="4.5" fill="#b45a2a" />
                                    <text x="790" y="459" text-anchor="middle" font-size="20" font-weight="800" fill="#1e293b">البصرة</text>
                                </g>

                                @* 5. North Arrow (شمال ↑) at Bottom Left *@
                                <g transform="translate(115, 425)">
                                    <text x="0" y="0" text-anchor="middle" font-size="15" font-weight="600" fill="#475569">شمال</text>
                                    <path d="M 0 12 L -8 30 L 0 25 L 8 30 Z" fill="#475569" />
                                    <line x1="0" y1="23" x2="0" y2="48" stroke="#475569" stroke-width="2.2" stroke-linecap="round" />
                                </g>
                            </svg>

                            <div class="gm-poster-divider"></div>

                            @* Footer matching reference image + toggle for all 18 governorates *@
                            <div class="gm-poster-footer">
                                <div class="gm-poster-source">
                                    <div style="font-weight:600;color:#475569;">مصدر الحدود الإدارية</div>
                                    <div style="font-size:0.75rem;color:#64748b;">FAO Data in Emergencies Hub</div>
                                </div>

                                <label class="gm-toggle-all-govs">
                                    <input type="checkbox" @bind="showAllGovernoratesOnMap" />
                                    <span>إظهار حدود وأسماء كافة المحافظات (١٨ محافظة)</span>
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="gm-leaflet-wrapper">
                            <div id="hrGeneralLeafletMap" class="gm-leaflet-canvas"></div>
                        </div>
                    }
                </section>

                @* ---- LEFT: GOVERNORATE BREAKDOWN CARDS ---- *@
                <aside class="hr-card gm-gov-sidebar" aria-label="توزيع المحافظات والفروع">
                    <div class="gm-panel-head">
                        <div>
                            <h2 class="hr-h3" style="margin:0;">توزيع المحافظات والفروع</h2>
                            <p class="hr-muted" style="font-size:var(--fs-xs);margin-block-start:.2rem;">
                                التوزيع المعتمد للموظفين حسب موقع التشكيل الإداري
                            </p>
                        </div>
                        <button type="button"
                                class="hr-btn hr-btn-quiet hr-btn-sm"
                                @onclick="() => showEmptyGovernoratesInList = !showEmptyGovernoratesInList">
                            @(showEmptyGovernoratesInList ? "المحافظات الأربع فقط" : "عرض كل المحافظات")
                        </button>
                    </div>

                    <div class="gm-gov-cards-list">
                        @foreach (var gov in VisibleGovernorateCards)
                        {
                            var isSel = selectedGovCode == gov.Code;
                            <div class="gm-gov-card @(isSel ? "is-selected" : "")"
                                 style="border-inline-start: 4px solid @gov.Color;"
                                 @onclick="() => SelectGovernorateAsync(gov.Code)">
                                <div class="gm-gov-card-top">
                                    <div>
                                        <div style="display:flex;align-items:center;gap:.4rem;">
                                            <span class="gm-gov-name">@gov.Name</span>
                                            <span class="hr-badge" style="font-size:.7rem;">@gov.BranchLabel</span>
                                        </div>
                                        <div class="hr-muted" style="font-size:var(--fs-xs);margin-top:.15rem;">
                                            @ToArabicDigits(gov.FormationCount) تشكيل إداري معتمد
                                        </div>
                                    </div>

                                    <div style="text-align:left;">
                                        <div style="font-size:1.3rem;font-weight:800;color:@gov.Color;line-height:1.1;">
                                            @ToArabicDigits(gov.EmployeeCount)
                                        </div>
                                        <div class="hr-muted" style="font-size:var(--fs-xs);">
                                            @ToArabicDigits(gov.Percentage.ToString("F1"))٪ من الإجمالي
                                        </div>
                                    </div>
                                </div>

                                <div class="gm-progress-track" title="نسبة المحافظة من إجمالي الموظفين">
                                    <div class="gm-progress-fill" style="width:@(Math.Clamp(gov.Percentage, 0, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:@gov.Color;"></div>
                                </div>

                                <div class="gm-gov-card-footer">
                                    <span>ذكور: <strong>@ToArabicDigits(gov.MaleCount)</strong></span>
                                    <span>إناث: <strong>@ToArabicDigits(gov.FemaleCount)</strong></span>
                                    <span style="margin-inline-start:auto;color:@gov.Color;font-weight:700;font-size:var(--fs-xs);">
                                        @(isSel ? "محدد حالياً ✓" : "استعراض التشكيلات ←")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </aside>
            </div>

            @* ==================== 5. FORMATIONS TABLE PER GOVERNORATE ==================== *@
            <section class="hr-card" aria-label="جدول التشكيلات الإدارية وتوزيعها على المحافظات">
                <div class="gm-panel-head" style="margin-bottom:var(--s-3);">
                    <div>
                        <h2 class="hr-h3" style="display:flex;align-items:center;gap:var(--s-2);margin:0;">
                            <Icon Name="building-office-2" Size="sm" />
                            <span>
                                التشكيلات الإدارية وتوزيعها الجغرافي
                                @if (selectedGovCode != null)
                                {
                                    var g = GetGovStat(selectedGovCode);
                                    <span> — @g.Name (@g.BranchLabel)</span>
                                }
                            </span>
                        </h2>
                        <p class="hr-muted" style="font-size:var(--fs-xs);margin-block-start:.2rem;">
                            انقر على أي تشكيل لعرض قائمة موظفيه أدناه أو الانتقال إلى دليل الموظفين
                        </p>
                    </div>

                    <div style="display:flex;align-items:center;gap:var(--s-2);">
                        @if (selectedFormationName != null)
                        {
                            <span class="hr-badge hr-badge-accent" style="display:inline-flex;align-items:center;gap:.35rem;">
                                <span>التشكيل المحدد: @selectedFormationName</span>
                                <button type="button" style="background:none;border:none;color:inherit;cursor:pointer;padding:0;display:inline-flex;" @onclick="() => SelectFormation(null)">
                                    <Icon Name="x-mark" Size="xs" />
                                </button>
                            </span>
                        }
                        <span class="hr-badge">@ToArabicDigits(FilteredFormations.Count) تشكيل</span>
                    </div>
                </div>

                <div class="hr-table-wrap">
                    <table class="hr-table">
                        <thead>
                            <tr>
                                <th style="width:3.5rem;">#</th>
                                <th>اسم التشكيل الإداري</th>
                                <th>المحافظة / الفرع المعتمد</th>
                                <th>إجمالي الموظفين</th>
                                <th>الذكور</th>
                                <th>الإناث</th>
                                <th>النسبة من الإجمالي</th>
                                <th style="text-align:left;">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredFormations.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" style="text-align:center;padding:var(--s-5);" class="hr-muted">
                                        لا توجد تشكيلات مطابقة لمعايير البحث الحالية.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rowIdx = 1;
                                @foreach (var form in FilteredFormations)
                                {
                                    var isFormSelected = string.Equals(selectedFormationName, form.FormationName, StringComparison.OrdinalIgnoreCase);
                                    <tr class="@(isFormSelected ? "gm-row-selected" : "")"
                                        style="cursor:pointer;"
                                        @onclick="() => SelectFormation(form.FormationName)">
                                        <td>@ToArabicDigits(rowIdx++)</td>
                                        <td>
                                            <div style="font-weight:700;display:flex;align-items:center;gap:.45rem;">
                                                <Icon Name="building-office-2" Size="xs" />
                                                <span>@form.FormationName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="hr-badge" style="border-inline-start:3px solid @form.GovColor;">
                                                @form.GovernorateName — @form.BranchLabel
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="font-size:1rem;">@ToArabicDigits(form.TotalCount)</strong>
                                        </td>
                                        <td>@ToArabicDigits(form.MaleCount) (@ToArabicDigits(form.MalePercentage.ToString("F0"))٪)</td>
                                        <td>@ToArabicDigits(form.FemaleCount) (@ToArabicDigits(form.FemalePercentage.ToString("F0"))٪)</td>
                                        <td style="min-width:9rem;">
                                            <div style="display:flex;align-items:center;gap:.5rem;">
                                                <div class="gm-progress-track" style="flex:1;margin:0;">
                                                    <div class="gm-progress-fill" style="width:@(Math.Clamp(form.ShareOfTotal, 0, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;background:@form.GovColor;"></div>
                                                </div>
                                                <span style="font-size:var(--fs-xs);font-weight:700;min-width:2.8rem;">@ToArabicDigits(form.ShareOfTotal.ToString("F1"))٪</span>
                                            </div>
                                        </td>
                                        <td style="text-align:left;" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="hr-btn hr-btn-secondary hr-btn-sm"
                                                    @onclick="() => SelectFormation(form.FormationName)">
                                                <Icon Name="users" Size="xs" />
                                                <span>عرض الكادر (@ToArabicDigits(form.TotalCount))</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @* ==================== 6. EMPLOYEES PREVIEW TABLE ==================== *@
            <section class="hr-card" aria-label="قائمة الموظفين حسب المحافظة والتشكيل">
                <div class="gm-panel-head" style="margin-bottom:var(--s-3);">
                    <div>
                        <h2 class="hr-h3" style="display:flex;align-items:center;gap:var(--s-2);margin:0;">
                            <Icon Name="users" Size="sm" />
                            <span>
                                كادر الموظفين
                                @if (selectedFormationName != null)
                                {
                                    <span> — @selectedFormationName</span>
                                }
                                else if (selectedGovCode != null)
                                {
                                    var g = GetGovStat(selectedGovCode);
                                    <span> — @g.Name (@g.BranchLabel)</span>
                                }
                            </span>
                        </h2>
                        <p class="hr-muted" style="font-size:var(--fs-xs);margin-block-start:.2rem;">
                            يتم عرض @ToArabicDigits(Math.Min(FilteredEmployeesList.Count, employeePageSize)) من أصل @ToArabicDigits(FilteredEmployeesList.Count) موظف مطابق للفلتر
                        </p>
                    </div>

                    <div style="display:flex;align-items:center;gap:var(--s-2);">
                        @if (canViewEmployees)
                        {
                            <a href="employees" class="hr-btn hr-btn-secondary hr-btn-sm">
                                <Icon Name="arrow-top-right-on-square" Size="xs" />
                                <span>فتح سجل الموظفين الكامل</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="hr-table-wrap">
                    <table class="hr-table">
                        <thead>
                            <tr>
                                <th>الرقم الوظيفي</th>
                                <th>اسم الموظف</th>
                                <th>التشكيل الإداري</th>
                                <th>المحافظة / الفرع</th>
                                <th>العنوان الوظيفي</th>
                                <th>الدرجة / المرحلة</th>
                                <th>النوع الاجتماعي</th>
                                @if (canViewEmployees)
                                {
                                    <th style="text-align:left;">الملف</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (PagedEmployees.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" style="text-align:center;padding:var(--s-5);" class="hr-muted">
                                        لا يوجد موظفون مطابقون للفلتر المحدد.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var emp in PagedEmployees)
                                {
                                    <tr>
                                        <td><span class="hr-mono">@emp.EmployeeID</span></td>
                                        <td style="font-weight:700;">@emp.Name</td>
                                        <td>@emp.FormationName</td>
                                        <td>
                                            <span class="hr-badge" style="border-inline-start:3px solid @emp.GovColor;">
                                                @emp.GovernorateName (@emp.BranchLabel)
                                            </span>
                                        </td>
                                        <td>@(emp.JobTitleName ?? "—")</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(emp.GradeName) || !string.IsNullOrWhiteSpace(emp.StageName))
                                            {
                                                <span>@(emp.GradeName ?? "—") / @(emp.StageName ?? "—")</span>
                                            }
                                            else
                                            {
                                                <span class="hr-muted">—</span>
                                            }
                                        </td>
                                        <td>@emp.GenderName</td>
                                        @if (canViewEmployees)
                                        {
                                            <td style="text-align:left;">
                                                <a class="hr-btn hr-btn-quiet hr-btn-sm" href="employees/@emp.EmployeeID" title="فتح إضبارة الموظف">
                                                    <Icon Name="identification" Size="xs" />
                                                    <span>الإضبارة</span>
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalEmployeePages > 1)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--s-3);flex-wrap:wrap;gap:var(--s-2);">
                        <span class="hr-muted" style="font-size:var(--fs-xs);">
                            صفحة @ToArabicDigits(currentEmployeePage) من @ToArabicDigits(TotalEmployeePages) (إجمالي @ToArabicDigits(FilteredEmployeesList.Count) موظف)
                        </span>
                        <div style="display:flex;align-items:center;gap:var(--s-1);">
                            <button type="button"
                                    class="hr-btn hr-btn-secondary hr-btn-sm"
                                    disabled="@(currentEmployeePage <= 1)"
                                    @onclick="() => ChangeEmployeePage(currentEmployeePage - 1)">
                                السابق
                            </button>
                            <button type="button"
                                    class="hr-btn hr-btn-secondary hr-btn-sm"
                                    disabled="@(currentEmployeePage >= TotalEmployeePages)"
                                    @onclick="() => ChangeEmployeePage(currentEmployeePage + 1)">
                                التالي
                            </button>
                        </div>
                    </div>
                }
            </section>
        }
    </div>
}

