@code {
    private bool isLoading = true;
    private bool hasAccess = true;
    private bool canViewEmployees = false;

    private string mapViewMode = "svg"; // "svg" | "leaflet"
    private bool showAllGovernoratesOnMap = false;
    private bool showEmptyGovernoratesInList = false;

    private string? selectedGovCode = null;
    private string? selectedFormationName = null;
    private string searchQuery = string.Empty;
    private string genderFilter = "all";

    private int currentEmployeePage = 1;
    private const int employeePageSize = 25;

    private DotNetObjectReference<GeneralMapPage>? dotNetRef;

    private List<EmployeeMapRow> allEmployees = new();
    private List<GovernorateMapStat> GovernorateStats = new();
    private List<FormationMapStat> FilteredFormations = new();
    private List<EmployeeMapRow> FilteredEmployeesList = new();

    private int FilteredTotalEmployees => FilteredEmployeesList.Count;
    private int FilteredTotalMales => FilteredEmployeesList.Count(e => !e.IsFemale);
    private int FilteredTotalFemales => FilteredEmployeesList.Count(e => e.IsFemale);
    private int TotalFormationsCount => FilteredFormations.Count;

    private int TotalEmployeePages => Math.Max(1, (int)Math.Ceiling((double)FilteredEmployeesList.Count / employeePageSize));

    private List<EmployeeMapRow> PagedEmployees =>
        FilteredEmployeesList
            .Skip((currentEmployeePage - 1) * employeePageSize)
            .Take(employeePageSize)
            .ToList();

    private IEnumerable<GovernorateMapStat> VisibleGovernorateCards =>
        showEmptyGovernoratesInList
            ? GovernorateStats.OrderByDescending(g => g.EmployeeCount).ThenBy(g => g.Order)
            : GovernorateStats.Where(g => g.EmployeeCount > 0 || g.IsMainBranchHub).OrderByDescending(g => g.EmployeeCount).ThenBy(g => g.Order);

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var isAdmin = user.IsInRole("Admin") ||
                          user.HasClaim(c => (c.Type == ClaimTypes.Role || c.Type == "role") &&
                                             c.Value.Equals("Admin", StringComparison.OrdinalIgnoreCase));

            hasAccess = isAdmin
                        || user.HasPermission(Permissions.ReportsView)
                        || user.HasPermission(Permissions.DashboardView)
                        || user.HasPermission(Permissions.FormationDashboardView);

            canViewEmployees = isAdmin || user.HasPermission(Permissions.EmployeesView);
        }
        else
        {
            hasAccess = false;
        }

        if (hasAccess)
        {
            await LoadDataAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (mapViewMode == "leaflet" && !isLoading && hasAccess)
        {
            await RenderLeafletMapAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var dbGenders = await db.Genders.AsNoTracking().ToListAsync();
            var femaleGenderIds = dbGenders
                .Where(g => g.Name.Contains("أنثى") || g.Name.Contains("انثى") || g.Name.Equals("Female", StringComparison.OrdinalIgnoreCase))
                .Select(g => g.Id)
                .ToHashSet();

            var dbFormations = await db.Formations.AsNoTracking().ToListAsync();
            var formationDict = dbFormations.ToDictionary(f => f.Id, f => f.Name.Trim());

            var employees = await db.Employees
                .AsNoTracking()
                .Where(e => !e.IsArchived)
                .Include(e => e.Formation)
                .Include(e => e.Gender)
                .Include(e => e.JobTitle)
                .Include(e => e.Grade)
                .Include(e => e.Stage)
                .ToListAsync();

            var rows = new List<EmployeeMapRow>(employees.Count);
            foreach (var emp in employees)
            {
                var formationName = emp.FormationId.HasValue && formationDict.TryGetValue(emp.FormationId.Value, out var fName)
                    ? fName
                    : (!string.IsNullOrWhiteSpace(emp.Formation?.Name) ? emp.Formation.Name.Trim() : "الفرع الرئيسي - غير محدد");

                var isFemale = (emp.GenderId.HasValue && femaleGenderIds.Contains(emp.GenderId.Value))
                               || (emp.Gender != null && (emp.Gender.Name.Contains("أنثى") || emp.Gender.Name.Contains("انثى") || emp.Gender.Name.Equals("Female", StringComparison.OrdinalIgnoreCase)));

                var govMeta = ResolveGovernorateForFormation(formationName);

                rows.Add(new EmployeeMapRow
                {
                    EmployeeID = emp.EmployeeID,
                    Name = emp.Name,
                    FormationName = formationName,
                    GovernorateCode = govMeta.Code,
                    GovernorateName = govMeta.Name,
                    BranchLabel = govMeta.BranchLabel,
                    GovColor = govMeta.Color,
                    IsFemale = isFemale,
                    GenderName = isFemale ? "أنثى" : "ذكر",
                    JobTitleName = emp.JobTitle?.Name,
                    GradeName = emp.Grade?.Name,
                    StageName = emp.Stage?.Name
                });
            }

            allEmployees = rows;
            RecalculateStats();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading General Map data.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RecalculateStats()
    {
        var catalog = GetIraqGovernoratesCatalog();

        IEnumerable<EmployeeMapRow> baseQuery = allEmployees;

        if (genderFilter == "male")
            baseQuery = baseQuery.Where(e => !e.IsFemale);
        else if (genderFilter == "female")
            baseQuery = baseQuery.Where(e => e.IsFemale);

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim();
            baseQuery = baseQuery.Where(e =>
                e.FormationName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.GovernorateName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.BranchLabel.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.EmployeeID.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        var baseList = baseQuery.ToList();
        var grandTotal = baseList.Count;

        var byGov = baseList.GroupBy(e => e.GovernorateCode).ToDictionary(g => g.Key, g => g.ToList());

        foreach (var gov in catalog)
        {
            if (byGov.TryGetValue(gov.Code, out var govEmps))
            {
                gov.EmployeeCount = govEmps.Count;
                gov.MaleCount = govEmps.Count(e => !e.IsFemale);
                gov.FemaleCount = govEmps.Count(e => e.IsFemale);
                gov.FormationCount = govEmps.Select(e => e.FormationName).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                gov.Percentage = grandTotal > 0 ? (double)govEmps.Count * 100.0 / grandTotal : 0;
            }
            else
            {
                gov.EmployeeCount = 0;
                gov.MaleCount = 0;
                gov.FemaleCount = 0;
                gov.FormationCount = 0;
                gov.Percentage = 0;
            }
        }

        GovernorateStats = catalog;

        var govFilteredEmployees = selectedGovCode != null
            ? baseList.Where(e => e.GovernorateCode == selectedGovCode).ToList()
            : baseList;

        FilteredFormations = govFilteredEmployees
            .GroupBy(e => (e.FormationName, e.GovernorateCode, e.GovernorateName, e.BranchLabel, e.GovColor))
            .Select(g =>
            {
                var count = g.Count();
                var females = g.Count(x => x.IsFemale);
                var males = count - females;
                return new FormationMapStat
                {
                    FormationName = g.Key.FormationName,
                    GovernorateCode = g.Key.GovernorateCode,
                    GovernorateName = g.Key.GovernorateName,
                    BranchLabel = g.Key.BranchLabel,
                    GovColor = g.Key.GovColor,
                    TotalCount = count,
                    MaleCount = males,
                    FemaleCount = females,
                    MalePercentage = count > 0 ? (double)males * 100.0 / count : 0,
                    FemalePercentage = count > 0 ? (double)females * 100.0 / count : 0,
                    ShareOfTotal = grandTotal > 0 ? (double)count * 100.0 / grandTotal : 0
                };
            })
            .OrderByDescending(f => f.TotalCount)
            .ThenBy(f => f.FormationName)
            .ToList();

        var finalEmps = selectedFormationName != null
            ? govFilteredEmployees.Where(e => string.Equals(e.FormationName, selectedFormationName, StringComparison.OrdinalIgnoreCase)).ToList()
            : govFilteredEmployees;

        FilteredEmployeesList = finalEmps;
        currentEmployeePage = 1;
    }

    private GovernorateMapStat GetGovStat(string code) =>
        GovernorateStats.FirstOrDefault(g => g.Code == code)
        ?? new GovernorateMapStat { Code = code, Name = code, BranchLabel = "" };

    private async Task SelectGovernorateAsync(string? code)
    {
        selectedGovCode = selectedGovCode == code ? null : code;
        selectedFormationName = null;
        RecalculateStats();
        StateHasChanged();

        if (mapViewMode == "leaflet")
        {
            await RenderLeafletMapAsync();
        }
    }

