    private static string ToArabicDigits(object? value)
    {
        if (value == null) return "٠";
        var s = value.ToString() ?? "0";
        return s
            .Replace('0', '٠')
            .Replace('1', '١')
            .Replace('2', '٢')
            .Replace('3', '٣')
            .Replace('4', '٤')
            .Replace('5', '٥')
            .Replace('6', '٦')
            .Replace('7', '٧')
            .Replace('8', '٨')
            .Replace('9', '٩');
    }

    private static (string Code, string Name, string BranchLabel, string Color) ResolveGovernorateForFormation(string? formationName)
    {
        if (string.IsNullOrWhiteSpace(formationName))
        {
            return ("BGD", "بغداد", "الفرع الرئيسي — المقر العام", "#1a669d");
        }

        var norm = formationName.Trim();

        if (norm.Contains("الموصل", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("موصل", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("نينوى", StringComparison.OrdinalIgnoreCase))
        {
            return ("NIN", "نينوى", "فرع الموصل", "#0d7a7b");
        }

        if (norm.Contains("أربيل", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("اربيل", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("إربيل", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("هولير", StringComparison.OrdinalIgnoreCase))
        {
            return ("EBL", "أربيل", "فرع أربيل", "#6b4ea2");
        }

        if (norm.Contains("البصرة", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("بصرة", StringComparison.OrdinalIgnoreCase) ||
            norm.Contains("البصره", StringComparison.OrdinalIgnoreCase))
        {
            return ("BSR", "البصرة", "فرع البصرة", "#b45a2a");
        }

        if (norm.Contains("النجف", StringComparison.OrdinalIgnoreCase) || norm.Contains("نجف", StringComparison.OrdinalIgnoreCase))
            return ("NJF", "النجف الأشرف", "فرع النجف", "#8b5cf6");

        if (norm.Contains("كربلاء", StringComparison.OrdinalIgnoreCase))
            return ("KRB", "كربلاء المقدسة", "فرع كربلاء", "#14b8a6");

        if (norm.Contains("السليمانية", StringComparison.OrdinalIgnoreCase) || norm.Contains("سليمانية", StringComparison.OrdinalIgnoreCase))
            return ("SUL", "السليمانية", "فرع السليمانية", "#06b6d4");

        if (norm.Contains("دهوك", StringComparison.OrdinalIgnoreCase))
            return ("DHK", "دهوك", "فرع دهوك", "#3b82f6");

        if (norm.Contains("كركوك", StringComparison.OrdinalIgnoreCase))
            return ("KIR", "كركوك", "فرع كركوك", "#ec4899");

        if (norm.Contains("الأنبار", StringComparison.OrdinalIgnoreCase) || norm.Contains("الانبار", StringComparison.OrdinalIgnoreCase))
            return ("ANB", "الأنبار", "فرع الأنبار", "#6366f1");

        if (norm.Contains("بابل", StringComparison.OrdinalIgnoreCase) || norm.Contains("الحلة", StringComparison.OrdinalIgnoreCase))
            return ("BBL", "بابل", "فرع بابل", "#84cc16");

        if (norm.Contains("ديالى", StringComparison.OrdinalIgnoreCase))
            return ("DIY", "ديالى", "فرع ديالى", "#f97316");

        if (norm.Contains("صلاح الدين", StringComparison.OrdinalIgnoreCase) || norm.Contains("تكريت", StringComparison.OrdinalIgnoreCase))
            return ("SAL", "صلاح الدين", "فرع صلاح الدين", "#a855f7");

        if (norm.Contains("واسط", StringComparison.OrdinalIgnoreCase) || norm.Contains("الكوت", StringComparison.OrdinalIgnoreCase))
            return ("WAS", "واسط", "فرع واسط", "#22c55e");

        if (norm.Contains("ميسان", StringComparison.OrdinalIgnoreCase) || norm.Contains("العمارة", StringComparison.OrdinalIgnoreCase))
            return ("MYS", "ميسان", "فرع ميسان", "#0284c7");

        if (norm.Contains("ذي قار", StringComparison.OrdinalIgnoreCase) || norm.Contains("الناصرية", StringComparison.OrdinalIgnoreCase))
            return ("DHI", "ذي قار", "فرع ذي قار", "#e11d48");

        if (norm.Contains("المثنى", StringComparison.OrdinalIgnoreCase) || norm.Contains("السماوة", StringComparison.OrdinalIgnoreCase))
            return ("MUT", "المثنى", "فرع المثنى", "#64748b");

        if (norm.Contains("القادسية", StringComparison.OrdinalIgnoreCase) || norm.Contains("الديوانية", StringComparison.OrdinalIgnoreCase))
            return ("QAD", "الديوانية (القادسية)", "فرع الديوانية", "#d97706");

        return ("BGD", "بغداد", "الفرع الرئيسي — المقر العام", "#1a669d");
    }

