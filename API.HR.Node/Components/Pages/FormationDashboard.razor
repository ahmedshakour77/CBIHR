@page "/formation-dashboard"
@rendermode InteractiveServer
@using System.Security.Claims
@using API.HR.Node.Data
@using API.HR.Node.Security
@using API.HR.Node.Services.OrganizationalHierarchy
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = Permissions.FormationDashboardView)]
@implements IAsyncDisposable

@inject IFormationKpiService KpiService
@inject AuthenticationStateProvider AuthStateProvider
@inject API.HR.Node.Services.Localization.ILanguageService Lang
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<FormationDashboard> Logger

<PageTitle>لوحة مؤشرات التشكيل الإداري | الموظف ٣٦٠°   </PageTitle>

<div class="hr-stack formation-dashboard-container">

    @* ==================== 1. EXECUTIVE HEADER & ACTIONS ==================== *@
    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                <span class="hr-eyebrow">
                    @(Lang.IsKurdish ? "تەختەی نیشاندەرە جێبەجێکارییەکانی پێکهاتە" : "لوحة المؤشرات والتقارير التنفيذية للتشكيل")
                </span>
                @if (isLockedFormation)
                {
                    <span class="hr-badge hr-badge-ok" title="هذا الحساب مقيد بتشكيل إداري محدد">
                        <Icon Name="lock-closed" Size="xs" />
                        <span>تشكيل محدد ومصرّح</span>
                    </span>
                }
                else
                {
                    <span class="hr-badge hr-badge-accent" title="صلاحية إدارية عليا لاستعراض كافة التشكيلات">
                        <Icon Name="shield-check" Size="xs" />
                        <span>إشراف عام لكافة التشكيلات</span>
                    </span>
                }
            </div>

            <h1 class="hr-h1 hr-balance" style="display:flex;align-items:center;gap:var(--s-2);margin-block-start:.25rem;">
                <Icon Name="building-office-2" Size="md" />
                <span>@(report?.FormationName ?? "لوحة مؤشرات التشكيل الإداري")</span>
            </h1>

        </div>

        <div class="hr-pagehead-actions" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--s-2);width:100%;">
            @* Formation Selector for Admins *@
            @if (isAdminOrGlobal)
            {
                <div style="min-width:18rem;flex:1 1 18rem;">
                    <label for="formation-selector" class="hr-sr">اختر التشكيل الإداري</label>
                    <select id="formation-selector" class="hr-select" @onchange="OnFormationSelectionChanged" value="@(selectedFormationId?.ToString() ?? "")">
                        <option value="">-- كافة تشكيلات البنك المركزي (عرض مدمج شامل) --</option>
                        @foreach (var f in availableFormations)
                        {
                            <option value="@f.Id">@f.Name (@f.EmployeeCount موظف)</option>
                        }
                    </select>
                </div>
            }
            else if (isLockedFormation)
            {
                <div class="hr-badge hr-badge-solid" style="padding:.55rem 1rem;font-size:var(--fs-body);border-radius:var(--r-md);">
                    <Icon Name="building-office-2" Size="sm" />
                    <span style="font-weight:700;">@report?.FormationName</span>
                </div>
            }

            <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;margin-inline-start:auto;">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="ReloadDataAsync" disabled="@isLoading" title="تحديث البيانات لحظياً">
                    @if (isLoading)
                    {
                        <span class="hr-spinner" aria-hidden="true"></span>
                        <span>جارٍ التحديث…</span>
                    }
                    else
                    {
                        <Icon Name="arrow-path" Size="sm" />
                        <span>تحديث</span>
                    }
                </button>

                <button type="button" class="hr-btn hr-btn-secondary" @onclick="ExportDashboardCsv" disabled="@(isLoading || report == null)" title="تصدير ملخص المؤشرات كملف CSV">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>تصدير CSV</span>
                </button>

                <button type="button" class="hr-btn hr-btn-primary" @onclick="PrintOrExportReport" title="طباعة تقرير التشكيل التنفيذي أو حفظه كـ PDF">
                    <Icon Name="printer" Size="sm" />
                    <span>طباعة التقرير</span>
                </button>
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="hr-kpi-grid">
            @for (var i = 0; i < 8; i++)
            {
                <div class="hr-kpi-card" aria-hidden="true">
                    <div class="hr-kpi-header">
                        <div class="hr-skeleton hr-skeleton-line" style="width:50%"></div>
                        <div class="hr-skeleton" style="width:2.25rem;height:2.25rem;border-radius:var(--r-md)"></div>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-skeleton" style="height:2.25rem;width:40%;margin-block:0.5rem"></div>
                        <div class="hr-skeleton" style="height:6px;width:100%;border-radius:999px"></div>
                    </div>
                    <div class="hr-skeleton hr-skeleton-line" style="width:70%"></div>
                </div>
            }
        </div>
    }
    else if (report != null)
    {
        @* ==================== 2. EXECUTIVE HERO KPI METRICS (8 CARDS) ==================== *@
        <section aria-labelledby="kpis-title">
            <h2 id="kpis-title" class="hr-sr">مؤشرات الأداء الرئيسية للتشكيل</h2>

            <div class="hr-kpi-grid">
                @* 1. Total Workforce *@
                <div class="hr-kpi-card hr-kpi-accent">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">إجمالي كادر التشكيل</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="users" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.TotalStaff.ToString("N0")</strong>
                            <span class="hr-kpi-unit">كادر وظيفي</span>
                        </div>
                        <div class="hr-kpi-split" title="توزيع الذكور والإناث">
                            <div class="hr-kpi-split-a" style="width:@($"{report.MalePercentage:F1}%");background:var(--accent);" title="@($"ذكور: {report.MaleCount:N0} ({report.MalePercentage:F1}%)")"></div>
                            <div class="hr-kpi-split-b" style="width:@($"{report.FemalePercentage:F1}%");background:var(--series-4);" title="@($"إناث: {report.FemaleCount:N0} ({report.FemalePercentage:F1}%)")"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <div class="hr-kpi-chips">
                            <span class="hr-kpi-chip">
                                <span class="hr-kpi-chip-dot" style="background:var(--accent);"></span>
                                <span>ذكور <strong class="hr-num">@report.MaleCount.ToString("N0")</strong> (@report.MalePercentage.ToString("F1")%)</span>
                            </span>
                            <span class="hr-kpi-chip">
                                <span class="hr-kpi-chip-dot" style="background:var(--series-4);"></span>
                                <span>إناث <strong class="hr-num">@report.FemaleCount.ToString("N0")</strong> (@report.FemalePercentage.ToString("F1")%)</span>
                            </span>
                        </div>
                    </div>
                </div>

                @* 2. Active Workforce & Hiring *@
                <div class="hr-kpi-card hr-kpi-ok">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">الموظفون الفعليون</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="check-circle" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.ActiveStaff.ToString("N0")</strong>
                            <span class="hr-kpi-unit">على رأس العمل</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill is-ok" style="width:100%;"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">تعيينات العام الحالي: <strong class="hr-num">@report.NewHiresThisYear.ToString("N0")</strong> موظف</span>
                    </div>
                </div>

                @* 3. Demographics: Average Age & Service *@
                <div class="hr-kpi-card">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">متوسط العمر والخدمة</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="calendar" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.AvgAgeYears.ToString("F1")</strong>
                            <span class="hr-kpi-unit">سنة (العمر)</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill" style="width:@($"{Math.Min(100, (report.AvgAgeYears / 60.0) * 100):F0}%");background:var(--series-5);"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">متوسط سنوات الخدمة: <strong class="hr-num">@report.AvgServiceYears.ToString("F1")</strong> سنة</span>
                    </div>
                </div>

                @* 4. Approaching Retirement & Promotions *@
                <div class="hr-kpi-card hr-kpi-warn">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">استحقاقات التقاعد والترفيع</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="clock" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.ApproachingRetirementCount.ToString("N0")</strong>
                            <span class="hr-kpi-unit">قريب من التقاعد (58+)</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill is-warn" style="width:@($"{Math.Min(100, (report.TotalStaff > 0 ? report.ApproachingRetirementCount * 100.0 / report.TotalStaff : 0)):F0}%")"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">مستحقو ترفيع/علاوة قادمة: <strong class="hr-num">@report.EligibleForPromotionCount.ToString("N0")</strong> موظف</span>
                    </div>
                </div>

                @* 5. Recognition & Discipline *@
                <div class="hr-kpi-card hr-kpi-ok">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">التقدير والانضباط</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="document-text" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.TotalAppreciationLetters.ToString("N0")</strong>
                            <span class="hr-kpi-unit">كتاب شكر</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill is-ok" style="width:@($"{report.CleanDisciplinePercentage:F0}%")"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">العقوبات: <strong class="hr-num">@report.TotalPenalties.ToString("N0")</strong> | سجل نظيف: <strong class="hr-num">@report.CleanDisciplinePercentage.ToString("F1")%</strong></span>
                    </div>
                </div>

                @* 6. Leave Balance *@
                <div class="hr-kpi-card">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">رصيد الإجازات التراكمي</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="calendar-days" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.TotalLeaveBalanceDays.ToString("N0")</strong>
                            <span class="hr-kpi-unit">يوم إجمالي</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill" style="width:75%;background:var(--series-6);"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">متوسط الرصيد لكل كادر: <strong class="hr-num">@report.AvgLeaveBalanceDays.ToString("F1")</strong> يوم</span>
                    </div>
                </div>

                @* 7. Vehicles & Gate Authorizations *@
                <div class="hr-kpi-card hr-kpi-accent">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">أسطول المركبات والتخويلات</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="truck" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.VehiclesStats.TotalVehicles.ToString("N0")</strong>
                            <span class="hr-kpi-unit">مركبة مسجلة</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill" style="width:@($"{Math.Min(100, (report.VehiclesStats.TotalVehicles > 0 ? report.VehiclesStats.AuthorizedVehicles * 100.0 / report.VehiclesStats.TotalVehicles : 0)):F0}%");background:var(--accent);"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">مركبات مخولة: <strong class="hr-num">@report.VehiclesStats.AuthorizedVehicles.ToString("N0")</strong> | المبنى الرئيسي: <strong class="hr-num">@report.VehiclesStats.MainBuildingAccess.ToString("N0")</strong></span>
                    </div>
                </div>

                @* 8. Digital Profile Completeness *@
                <div class="hr-kpi-card hr-kpi-ok">
                    <div class="hr-kpi-header">
                        <span class="hr-kpi-title">الهوية الرقمية والأرشفة</span>
                        <span class="hr-kpi-iconplate" aria-hidden="true"><Icon Name="identification" Size="sm" /></span>
                    </div>
                    <div class="hr-kpi-body">
                        <div class="hr-kpi-figure-row">
                            <strong class="hr-kpi-figure hr-num">@report.DigitalPhotoPercentage.ToString("F1")</strong>
                            <span class="hr-kpi-unit">% موثق</span>
                        </div>
                        <div class="hr-kpi-meter">
                            <div class="hr-kpi-meter-fill is-ok" style="width:@($"{report.DigitalPhotoPercentage:F0}%")"></div>
                        </div>
                    </div>
                    <div class="hr-kpi-foot">
                        <span class="hr-meta">الصور الموثقة: <strong class="hr-num">@report.DigitalPhotoCount.ToString("N0")</strong> من أصل <strong class="hr-num">@report.TotalStaff.ToString("N0")</strong></span>
                    </div>
                </div>
            </div>
        </section>

        @* ==================== 2.2 EXECUTIVE HEALTH GAUGES COCKPIT ==================== *@
        <section class="hr-stack-sm" style="margin-block-start:var(--s-4);">
            <div class="hr-section-head">
                <div>
                    <h2 class="hr-h2" style="display:flex;align-items:center;gap:var(--s-2);">
                        <Icon Name="adjustments-horizontal" Size="md" />
                        <span>مؤشرات السلامة والأداء القيادي للتشكيل </span>
                    </h2>
                  </div>
            </div>

            <div class="hr-fd-grid" style="--fd-min:13rem;gap:var(--s-3);">
                @* Gauge 1: Clean Discipline *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            نقاء السجل الانضباطي
                        </div> 
                    </div>
                    <div id="gauge-discipline" role="img" aria-label="@GaugeLabel("نقاء السجل الانضباطي", report.CleanDisciplinePercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-badge-ok hr-fd-gauge-badge">
                            @(report.TotalPenalties == 0 ? "سجل نظيف 100%" : $"{report.TotalPenalties} عقوبات مسجلة")
                        </span>
                    </div>
                </div>

                @* Gauge 2: Active Workforce Readiness *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            الجاهزية والدوام الفعلي
                        </div>
                      </div>
                    <div id="gauge-readiness" role="img" aria-label="@GaugeLabel("الجاهزية والدوام الفعلي", report.ActiveStaffPercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-badge-accent hr-fd-gauge-badge">
                            @report.ActiveStaff من أصل @report.TotalStaff موظف
                        </span>
                    </div>
                </div>

                @* Gauge 3: Higher Academic Degrees *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            الكفاءات والشهادات العليا
                        </div>
                        <p class="hr-meta hr-fd-gauge-sub">دكتوراه وماجستير ودبلوم عالي</p>
                    </div>
                    <div id="gauge-higher-edu" role="img" aria-label="@GaugeLabel("الكفاءات والشهادات العليا", report.HigherEducationPercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-fd-gauge-badge" style="background:var(--series-4);color:var(--series-on);">
                            @report.HigherEducationCount حامل شهادة عليا
                        </span>
                    </div>
                </div>

                @* Gauge 4: Career Promotion Pipeline *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            استحقاق الترفيع والعلاوة
                        </div>
                        <p class="hr-meta hr-fd-gauge-sub">المستحقون للترقية القادمة</p>
                    </div>
                    <div id="gauge-promotion" role="img" aria-label="@GaugeLabel("استحقاق الترفيع والعلاوة", report.PromotionReadinessPercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-badge-warn hr-fd-gauge-badge">
                            @report.EligibleForPromotionCount مرشح للاستحقاق
                        </span>
                    </div>
                </div>

                @* Gauge 5: Digital Archive & Dossier *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            الأرشفة والهوية الرقمية
                        </div>
                        <p class="hr-meta hr-fd-gauge-sub">اكتمال الملفات والصور</p>
                    </div>
                    <div id="gauge-digital" role="img" aria-label="@GaugeLabel("الأرشفة والهوية الرقمية", report.DigitalPhotoPercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-badge-ok hr-fd-gauge-badge">
                            @report.DigitalPhotoCount ملف موثق رقمياً
                        </span>
                    </div>
                </div>

                @* Gauge 6: Contract Staff (موظفو العقود) *@
                <div class="hr-card hr-fd-gauge">
                    <div>
                        <div class="hr-fd-gauge-title">
                            موظفو العقود
                        </div>
                        <p class="hr-meta hr-fd-gauge-sub">بحسب الحالة الوظيفية للموظف</p>
                    </div>
                    <div id="gauge-contracts" role="img" aria-label="@GaugeLabel("موظفو العقود", report.ContractStaffPercentage)" class="hr-fd-gauge-plot"></div>
                    <div>
                        <span class="hr-badge hr-fd-gauge-badge" style="background:var(--series-5);color:var(--series-on);">
                            @report.ContractStaffCount موظف عقد (@report.ContractStaffPercentage.ToString("F1")%)
                        </span>
                    </div>
                </div>
            </div>
        </section>

        @* Gender, education, age, grades, tenure and gate access each have a
           detailed view in the tabs below, so they are not charted twice here. *@

        @* ==================== 3. EXECUTIVE TABS FOR DETAILED SECTIONS ==================== *@
        <div class="hr-tabs" role="tablist" aria-label="أقسام تقارير التشكيل" style="margin-block-start:var(--s-4);">
            <button type="button" role="tab" class="hr-tab"
                    id="tab-cadre" aria-controls="panel-cadre"
                    aria-selected="@((activeTab == "cadre") ? "true" : "false")"
                    @onclick='() => activeTab = "cadre"'>
                <Icon Name="chart-bar" Size="sm" />
                <span>الدرجات والعناوين الوظيفية</span>
            </button>

            <button type="button" role="tab" class="hr-tab"
                    id="tab-education" aria-controls="panel-education"
                    aria-selected="@((activeTab == "education") ? "true" : "false")"
                    @onclick='() => activeTab = "education"'>
                <Icon Name="academic-cap" Size="sm" />
                <span>المؤهلات العلمية والديموغرافيا</span>
            </button>

            <button type="button" role="tab" class="hr-tab"
                    id="tab-performance" aria-controls="panel-performance"
                    aria-selected="@((activeTab == "performance") ? "true" : "false")"
                    @onclick='() => activeTab = "performance"'>
                <Icon Name="document-text" Size="sm" />
                <span>الأداء والانضباط والإجازات</span>
            </button>

            <button type="button" role="tab" class="hr-tab"
                    id="tab-vehicles" aria-controls="panel-vehicles"
                    aria-selected="@((activeTab == "vehicles") ? "true" : "false")"
                    @onclick='() => activeTab = "vehicles"'>
                <Icon Name="truck" Size="sm" />
                <span>المركبات وبوابات الدخول</span>
            </button>

            <button type="button" role="tab" class="hr-tab"
                    id="tab-roster" aria-controls="panel-roster"
                    aria-selected="@((activeTab == "roster") ? "true" : "false")"
                    @onclick='() => activeTab = "roster"'>
                <Icon Name="table-cells" Size="sm" />
                <span>سجل كادر التشكيل التفصيلي</span>
                <span class="hr-badge hr-num">@report.TotalStaff</span>
            </button>
        </div>

        @* ==================== 4. TAB PANELS ==================== *@

        @* ---------------- PANEL 1: GRADES & CADRE ---------------- *@
        @if (activeTab == "cadre")
        {
            <div id="panel-cadre" role="tabpanel" aria-labelledby="tab-cadre" tabindex="0" class="hr-stack-sm">
                <div class="hr-fd-grid">
                    
                    @* Grades Bar Chart *@
                    <div class="hr-card hr-card-pad">
                        <div class="hr-section-head">
                            <div>
                                <h3 class="hr-h3">توزيع السلم الوظيفي (الدرجات من 1 إلى 10)</h3>
                                <p class="hr-meta">التوزيع العددي والنسبي للموظفين حسب درجات الخدمة المدنية</p>
                            </div>
                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick='() => ExportSectionCsv(report.GradeDistribution, "الدرجة_الوظيفية")'>
                                <Icon Name="arrow-down-tray" Size="xs" />
                                <span>تصدير CSV</span>
                            </button>
                        </div>

                        <ul class="hr-barlist" style="margin-block-start:var(--s-3);">
                            @foreach (var grade in report.GradeDistribution)
                            {
                                <li class="hr-barlist-item">
                                    <div class="hr-barlist-head">
                                        <span class="hr-barlist-name" style="font-weight:600;">@grade.Label</span>
                                        <span class="hr-barlist-value">
                                            <span class="hr-num">@grade.Count.ToString("N0") موظف</span>
                                            <span class="hr-barlist-pct hr-num">@grade.Percentage.ToString("F1")%</span>
                                        </span>
                                    </div>
                                    <div class="hr-meter" aria-hidden="true">
                                        <div class="hr-meter-fill" style="width:@($"{grade.Percentage:F1}%");background:@(grade.ColorToken ?? "var(--accent)");"></div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>

                    @* Top Job Titles *@
                    <div class="hr-card hr-card-pad">
                        <div class="hr-section-head">
                            <div>
                                <h3 class="hr-h3">أبرز العناوين الوظيفية في التشكيل</h3>
                                <p class="hr-meta">المسميات الوظيفية الأكثر تمثيلاً ضمن الكادر</p>
                            </div>
                            <span class="hr-badge hr-badge-accent">أعلى @report.TopJobTitles.Count عناوين</span>
                        </div>

                        <ul class="hr-barlist" style="margin-block-start:var(--s-3);">
                            @foreach (var jt in report.TopJobTitles)
                            {
                                <li class="hr-barlist-item">
                                    <div class="hr-barlist-head">
                                        <span class="hr-barlist-name hr-truncate" title="@jt.Label">@jt.Label</span>
                                        <span class="hr-barlist-value">
                                            <span class="hr-num">@jt.Count.ToString("N0")</span>
                                            <span class="hr-barlist-pct hr-num">@jt.Percentage.ToString("F1")%</span>
                                        </span>
                                    </div>
                                    <div class="hr-meter" aria-hidden="true">
                                        <div class="hr-meter-fill" style="width:@($"{jt.Percentage:F1}%");background:linear-gradient(90deg, var(--series-4), var(--accent));"></div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
