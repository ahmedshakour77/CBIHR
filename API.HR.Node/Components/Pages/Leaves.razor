@code {
    [SupplyParameterFromQuery(Name = "employeeId")]
    public string? QueryEmployeeId { get; set; }

    // Page state
    private bool isLoading = true;
    private bool loadFailed = false;
    private DateOnly today = DateOnly.FromDateTime(DateTime.Today);

    // Filter properties
    private string searchQuery = string.Empty;
    private int? selectedLeaveTypeId;
    private int? selectedFormationId;
    private string selectedStatus = string.Empty;
    private DateOnly? filterStartDate;
    private DateOnly? filterEndDate;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalFilteredCount = 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalFilteredCount / pageSize));
    private int RangeStart => totalFilteredCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int RangeEnd => Math.Min(currentPage * pageSize, totalFilteredCount);

    // KPI Counters
    private int totalRecordsCount = 0;
    private int totalDaysConsumed = 0;
    private int currentlyOnLeaveCount = 0;

    // Data lists
    private List<EmployeeLeave> leaves = new();
    private List<LeaveType> leaveTypes = new();
    private List<Formation> formations = new();
    private Dictionary<string, string> photoThumbnails = new();

    // Quick employee lookup
    private string empLookupQuery = string.Empty;
    private bool isLookupSearching = false;
    private List<Employee> lookupResults = new();
    private CancellationTokenSource? lookupCts;

    // Employee Leave Dossier Modal State
    private bool isDossierOpen = false;
    private bool isDossierLoading = false;
    private Employee? dossierEmployee;
    private string? dossierPhotoUrl;
    private List<EmployeeLeave> dossierLeaves = new();
    private List<LeaveTypeSummary> dossierTypeBreakdown = new();
    private int dossierTotalDays = 0;
    private int dossierThisYearDays = 0;
    private EmployeeLeave? dossierCurrentLeave;
    private EmployeeLeave? dossierLastLeave;

    // Leave Create / Edit Editor State
    private bool isEditorOpen = false;
    private bool isSaving = false;
    private int? editingLeaveId;
    private Employee? editorSelectedEmployee;
    private string editorEmpQuery = string.Empty;
    private List<Employee> editorEmpResults = new();
    private int editorLeaveTypeId = 0;
    private string editorStatus = "معتمدة";
    private DateOnly editorStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly editorEndDate = DateOnly.FromDateTime(DateTime.Today);
    private int editorDaysCount = 1;
    private string? editorOrderNumber;
    private DateOnly? editorOrderDate;
    private string? editorNotes;
    private string? editorErrorMessage;

    // Delete state
    private EmployeeLeave? leaveToDelete;
    private bool isDeleting = false;

    // Toast state
    private string? toastMessage;
    private bool toastIsSuccess;
    private CancellationTokenSource? toastCts;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        selectedLeaveTypeId.HasValue ||
        selectedFormationId.HasValue ||
        !string.IsNullOrWhiteSpace(selectedStatus) ||
        filterStartDate.HasValue ||
        filterEndDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadDataAsync();

        if (!string.IsNullOrWhiteSpace(QueryEmployeeId))
        {
            await OpenEmployeeDossier(QueryEmployeeId);
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            leaveTypes = await db.LeaveTypes.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
            formations = await db.Formations.AsNoTracking().OrderBy(f => f.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed loading leave types or formations lookups");
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // 1. Overall stats
            totalRecordsCount = await db.EmployeeLeaves.CountAsync();
            totalDaysConsumed = totalRecordsCount > 0 ? await db.EmployeeLeaves.SumAsync(l => l.DaysCount) : 0;
            currentlyOnLeaveCount = await db.EmployeeLeaves
                .Where(l => l.StartDate <= today && l.EndDate >= today)
                .Select(l => l.EmployeeId)
                .Distinct()
                .CountAsync();

            // 2. Query with filters
            var query = db.EmployeeLeaves.AsNoTracking()
                .Include(l => l.Employee)
                    .ThenInclude(e => e.Formation)
                .Include(l => l.Employee)
                    .ThenInclude(e => e.JobTitle)
                .Include(l => l.Employee)
                    .ThenInclude(e => e.PositionTitle)
                .Include(l => l.LeaveType)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLower();
                query = query.Where(l =>
                    l.Employee.Name.ToLower().Contains(q) ||
                    l.Employee.EmployeeID.ToLower().Contains(q) ||
                    (l.OrderNumber != null && l.OrderNumber.ToLower().Contains(q)) ||
                    (l.Notes != null && l.Notes.ToLower().Contains(q)));
            }

            if (selectedLeaveTypeId.HasValue)
            {
                query = query.Where(l => l.LeaveTypeId == selectedLeaveTypeId.Value);
            }

            if (selectedFormationId.HasValue)
            {
                query = query.Where(l => l.Employee.FormationId == selectedFormationId.Value);
            }

            if (!string.IsNullOrWhiteSpace(selectedStatus))
            {
                query = query.Where(l => l.Status == selectedStatus);
            }

            if (filterStartDate.HasValue)
            {
                query = query.Where(l => l.StartDate >= filterStartDate.Value);
            }

            if (filterEndDate.HasValue)
            {
                query = query.Where(l => l.EndDate <= filterEndDate.Value);
            }

            totalFilteredCount = await query.CountAsync();

            leaves = await query
                .OrderByDescending(l => l.StartDate)
                .ThenByDescending(l => l.Id)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToListAsync();

            // Thumbnail URLs for employees in view. The browser fetches them from
            // the photo endpoint; only the active version is read here.
            var allEmpIds = leaves.Select(l => l.Employee.EmployeeID).Distinct().ToList();
            var activePhotos = allEmpIds.Count > 0
                ? await db.EmployeeProfilePhotos.AsNoTracking()
                    .Where(p => allEmpIds.Contains(p.EmployeeID) && p.IsActive)
                    .Select(p => new { p.EmployeeID, p.Version })
                    .ToListAsync()
                : [];

            photoThumbnails.Clear();
            foreach (var photo in activePhotos)
            {
                photoThumbnails[photo.EmployeeID] = ProfilePhotoUrls.Thumbnail(photo.EmployeeID, photo.Version);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed loading leaves list");
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ResetFilters()
    {
        searchQuery = string.Empty;
        selectedLeaveTypeId = null;
        selectedFormationId = null;
        selectedStatus = string.Empty;
        filterStartDate = null;
        filterEndDate = null;
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize))
        {
            pageSize = newSize;
            currentPage = 1;
            await LoadDataAsync();
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > totalPages) return;
        currentPage = newPage;
        await LoadDataAsync();
    }

    // ---------- Quick Employee Lookup ----------
    private async Task OnEmpLookupQueryChanged()
    {
        lookupCts?.Cancel();
        lookupCts?.Dispose();
        lookupCts = new CancellationTokenSource();
        var token = lookupCts.Token;

        if (string.IsNullOrWhiteSpace(empLookupQuery) || empLookupQuery.Trim().Length < 2)
        {
            lookupResults.Clear();
            return;
        }

        try
        {
            await Task.Delay(300, token);
            if (token.IsCancellationRequested) return;

            isLookupSearching = true;
            StateHasChanged();

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var q = empLookupQuery.Trim().ToLower();
            lookupResults = await db.Employees.AsNoTracking()
                .Include(e => e.Formation)
                .Include(e => e.JobTitle)
                .Where(e => e.Name.ToLower().Contains(q) || e.EmployeeID.ToLower().Contains(q))
                .Take(6)
                .ToListAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching employees for leave lookup");
        }
        finally
        {
            isLookupSearching = false;
            StateHasChanged();
        }
    }

    private async Task SelectLookupEmployee(Employee emp)
    {
        lookupResults.Clear();
        empLookupQuery = string.Empty;
        await OpenEmployeeDossier(emp.EmployeeID);
    }

    // ---------- Employee Dossier Modal ("أضبارة إجازات الموظف") ----------
    private async Task OpenEmployeeDossier(string employeeNumber)
    {
        if (string.IsNullOrWhiteSpace(employeeNumber)) return;

        isDossierOpen = true;
        isDossierLoading = true;
        dossierEmployee = null;
        dossierPhotoUrl = null;
        dossierLeaves.Clear();
        dossierTypeBreakdown.Clear();
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            dossierEmployee = await db.Employees.AsNoTracking()
                .Include(e => e.Formation)
                .Include(e => e.JobTitle)
                .Include(e => e.PositionTitle)
                .Include(e => e.Grade)
                .Include(e => e.Stage)
                .FirstOrDefaultAsync(e => e.EmployeeID == employeeNumber);

            if (dossierEmployee is null)
            {
                ShowToast("لم يتم العثور على سجل الموظف في النظام.", false);
                return;
            }

            var photoVersion = await db.EmployeeProfilePhotos.AsNoTracking()
                .Where(p => p.EmployeeID == employeeNumber && p.IsActive)
                .Select(p => (int?)p.Version)
                .FirstOrDefaultAsync();
            if (photoVersion is not null)
            {
                dossierPhotoUrl = ProfilePhotoUrls.Thumbnail(employeeNumber, photoVersion);
            }

            // Fetch all leaves for this employee
            dossierLeaves = await db.EmployeeLeaves.AsNoTracking()
                .Include(l => l.LeaveType)
                .Where(l => l.EmployeeId == dossierEmployee.Id)
                .OrderByDescending(l => l.StartDate)
                .ThenByDescending(l => l.Id)
                .ToListAsync();

            dossierTotalDays = dossierLeaves.Sum(l => l.DaysCount);
            dossierThisYearDays = dossierLeaves
                .Where(l => l.StartDate.Year == today.Year || l.EndDate.Year == today.Year)
                .Sum(l => l.DaysCount);

            dossierCurrentLeave = dossierLeaves.FirstOrDefault(l => l.StartDate <= today && l.EndDate >= today);
            dossierLastLeave = dossierLeaves.OrderByDescending(l => l.EndDate).FirstOrDefault();

            dossierTypeBreakdown = dossierLeaves
                .GroupBy(l => l.LeaveType?.Name ?? "غير محدد")
                .Select(g => new LeaveTypeSummary
                {
                    TypeName = g.Key,
                    TotalDays = g.Sum(x => x.DaysCount),
                    Count = g.Count()
                })
                .OrderByDescending(x => x.TotalDays)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed loading leave dossier for employee {EmployeeID}", employeeNumber);
            ShowToast("تعذّر استرجاع أضبارة إجازات الموظف.", false);
        }
        finally
        {
            isDossierLoading = false;
            StateHasChanged();
        }
    }

    private void CloseEmployeeDossier()
    {
        isDossierOpen = false;
        dossierEmployee = null;
        dossierLeaves.Clear();
    }

    private async Task PrintEmployeeDossier()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    // ---------- Create / Edit Modal ----------
    private void OpenCreateLeaveModal()
    {
        editingLeaveId = null;
        editorSelectedEmployee = null;
        editorEmpQuery = string.Empty;
        editorEmpResults.Clear();
        editorLeaveTypeId = leaveTypes.FirstOrDefault()?.Id ?? 0;
        editorStatus = "معتمدة";
        editorStartDate = today;
        editorEndDate = today;
        editorDaysCount = 1;
        editorOrderNumber = null;
        editorOrderDate = null;
        editorNotes = null;
        editorErrorMessage = null;
        isEditorOpen = true;
    }

    private void OpenCreateLeaveForEmployee(Employee emp)
    {
        OpenCreateLeaveModal();
        editorSelectedEmployee = emp;
    }

    private void OpenEditLeaveModal(EmployeeLeave leave)
    {
        editingLeaveId = leave.Id;
        editorSelectedEmployee = leave.Employee;
        editorEmpQuery = string.Empty;
        editorEmpResults.Clear();
        editorLeaveTypeId = leave.LeaveTypeId ?? 0;
        editorStatus = leave.Status;
        editorStartDate = leave.StartDate;
        editorEndDate = leave.EndDate;
        editorDaysCount = leave.DaysCount;
        editorOrderNumber = leave.OrderNumber;
        editorOrderDate = leave.OrderDate;
        editorNotes = leave.Notes;
        editorErrorMessage = null;
        isEditorOpen = true;
    }

    private void CloseEditor()
    {
        isEditorOpen = false;
        editorSelectedEmployee = null;
    }

    private void RecalculateDays()
    {
        if (editorEndDate >= editorStartDate)
        {
            editorDaysCount = editorEndDate.DayNumber - editorStartDate.DayNumber + 1;
        }
        else
        {
            editorDaysCount = 1;
        }
    }

    private async Task OnEditorEmpQueryChanged()
    {
        if (string.IsNullOrWhiteSpace(editorEmpQuery) || editorEmpQuery.Trim().Length < 2)
        {
            editorEmpResults.Clear();
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var q = editorEmpQuery.Trim().ToLower();

            editorEmpResults = await db.Employees.AsNoTracking()
                .Include(e => e.Formation)
                .Where(e => e.Name.ToLower().Contains(q) || e.EmployeeID.ToLower().Contains(q))
                .Take(6)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed searching employees in editor");
        }
    }

    private void SelectEditorEmployee(Employee e)
    {
        editorSelectedEmployee = e;
        editorEmpResults.Clear();
        editorEmpQuery = string.Empty;
    }

    private async Task SaveLeaveAsync()
    {
        editorErrorMessage = null;

        if (editorSelectedEmployee is null)
        {
            editorErrorMessage = "يُرجى اختيار الموظف أولاً.";
            return;
        }

        if (editorLeaveTypeId <= 0)
        {
            editorErrorMessage = "يُرجى اختيار نوع الإجازة.";
            return;
        }

        if (editorEndDate < editorStartDate)
        {
            editorErrorMessage = "تاريخ الانتهاء لا يمكن أن يكون قبل تاريخ البدء.";
            return;
        }

        if (editorDaysCount <= 0)
        {
            editorErrorMessage = "عدد الأيام يجب أن يكون يوماً واحداً على الأقل.";
            return;
        }

        isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            if (editingLeaveId.HasValue)
            {
                var existing = await db.EmployeeLeaves.FirstOrDefaultAsync(l => l.Id == editingLeaveId.Value);
                if (existing is null)
                {
                    editorErrorMessage = "السجل المطلوب تعديله غير موجود.";
                    return;
                }

                existing.LeaveTypeId = editorLeaveTypeId;
                existing.StartDate = editorStartDate;
                existing.EndDate = editorEndDate;
                existing.DaysCount = editorDaysCount;
                existing.OrderNumber = editorOrderNumber?.Trim();
                existing.OrderDate = editorOrderDate;
                existing.Notes = editorNotes?.Trim();
                existing.Status = editorStatus;

                await db.SaveChangesAsync();
                ShowToast("تم تعديل سجل الإجازة بنجاح.", true);
            }
            else
            {
                var newLeave = new EmployeeLeave
                {
                    EmployeeId = editorSelectedEmployee.Id,
                    LeaveTypeId = editorLeaveTypeId,
                    StartDate = editorStartDate,
                    EndDate = editorEndDate,
                    DaysCount = editorDaysCount,
                    OrderNumber = editorOrderNumber?.Trim(),
                    OrderDate = editorOrderDate,
                    Notes = editorNotes?.Trim(),
                    Status = editorStatus,
                    CreatedAtUtc = DateTimeOffset.UtcNow
                };

                db.EmployeeLeaves.Add(newLeave);
                await db.SaveChangesAsync();
                ShowToast("تم تسجيل الإجازة بنجاح.", true);
            }

            CloseEditor();
            await LoadDataAsync();

            if (isDossierOpen && dossierEmployee?.Id == editorSelectedEmployee.Id)
            {
                await OpenEmployeeDossier(dossierEmployee.EmployeeID);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed saving employee leave");
            editorErrorMessage = "حدث خطأ أثناء حفظ الإجازة في قاعدة البيانات.";
        }
        finally
        {
            isSaving = false;
        }
    }

    // ---------- Delete ----------
    private void PromptDeleteLeave(EmployeeLeave item)
    {
        leaveToDelete = item;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (leaveToDelete is null) return;
        isDeleting = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var record = await db.EmployeeLeaves.FirstOrDefaultAsync(l => l.Id == leaveToDelete.Id);
            if (record is not null)
            {
                db.EmployeeLeaves.Remove(record);
                await db.SaveChangesAsync();
                ShowToast("تم حذف سجل الإجازة بنجاح.", true);
            }

            var deletedEmpId = leaveToDelete.Employee?.EmployeeID;
            leaveToDelete = null;
            await LoadDataAsync();

            if (isDossierOpen && !string.IsNullOrWhiteSpace(deletedEmpId))
            {
                await OpenEmployeeDossier(deletedEmpId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed deleting leave record {Id}", leaveToDelete?.Id);
            ShowToast("تعذّر حذف السجل بسبب خطأ في النظام.", false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    // ---------- Formatting Helpers ----------
    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Or(string? value, string fallback = "—") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string D(DateOnly? date) =>
        date?.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture) ?? "—";

    private static string AvatarTone(string? employeeId)
    {
        // Steps on the brand ramp, as in EmployeeDirectory and EmployeeGallery.
        // The old hsl(hue 55% 40%) put white initials on fills as weak as
        // 2.84:1 (yellow-green hues) and ignored the brand and theme.
        var tones = new[] { "var(--b-800)", "var(--b-700)", "var(--b-600)", "var(--b-500)" };

        var sum = 0;
        foreach (var ch in employeeId ?? string.Empty)
        {
            sum = (sum * 31 + ch) & 0x7fffffff;
        }

        return tones[sum % tones.Length];
    }

    private static string LeaveTypeBadgeClass(string? typeName)
    {
        if (string.IsNullOrWhiteSpace(typeName)) return string.Empty;
        if (typeName.Contains("مرض")) return "hr-badge-warn";
        if (typeName.Contains("اعتياد")) return "hr-badge-ok";
        if (typeName.Contains("دراس")) return "hr-badge-accent";
        if (typeName.Contains("أمومة") || typeName.Contains("وضع")) return "hr-badge-ok";
        if (typeName.Contains("بدون راتب")) return "hr-badge-danger";
        return string.Empty;
    }

    private static string FormatServiceLength(DateOnly? hireDate)
    {
        if (hireDate is null) return "غير محدد";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (hireDate > today) return "لم تبدأ بعد";

        var years = today.Year - hireDate.Value.Year;
        var months = today.Month - hireDate.Value.Month;
        if (months < 0) { years--; months += 12; }

        if (years > 0) return $"{years} سنة{(months > 0 ? $" و {months} شهر" : "")}";
        return $"{months} شهر";
    }

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastIsSuccess = success;

        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                if (token.IsCancellationRequested) return;
                toastMessage = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        });

        StateHasChanged();
    }

    public void Dispose()
    {
        lookupCts?.Cancel();
        lookupCts?.Dispose();
        toastCts?.Cancel();
        toastCts?.Dispose();
    }

    private sealed class LeaveTypeSummary
    {
        public string TypeName { get; set; } = string.Empty;
        public int TotalDays { get; set; }
        public int Count { get; set; }
    }
