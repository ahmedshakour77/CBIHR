        if (!isCallerAdmin && sourceUser.AssignedRoles.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase)))
        {
            ShowStatus("لا تملك صلاحية استنساخ صلاحيات حساب مدير النظام (Admin).", isError: true);
            return;
        }

        using var scope = ScopeFactory.CreateScope();
        var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var uObj = await userMgr.FindByIdAsync(sourceUser.Id);
        if (uObj != null)
        {
            var roles = await userMgr.GetRolesAsync(uObj);
            editingRoles = new HashSet<string>(roles);
            var claims = await userMgr.GetClaimsAsync(uObj);
            editingClaims.Clear();
            foreach (var c in claims.Where(c => c.Type == "permission" || c.Type == "Permission"))
            {
                editingClaims.Add(c.Value);
            }
            ShowStatus($"تم استنساخ أدوار وصلاحيات الحساب ({sourceUser.UserName}) بنجاح. يمكنك المراجعة قبل الحفظ.");
        }
    }

    private bool HasSensitivePermissionsSelected()
    {
        return editingClaims.Contains(Permissions.UsersEdit) ||
               editingClaims.Contains(Permissions.AuditLogsView) ||
               editingClaims.Contains(Permissions.FeaturesEdit) ||
               editingClaims.Contains(Permissions.DataImportEdit) ||
               editingClaims.Contains(Permissions.SalariesEdit);
    }

    private async Task ResetPasswordSubmit()
    {
        if (selectedUserForPasswordReset == null || string.IsNullOrWhiteSpace(newPasswordInput)) return;
        if (!canEditUsers)
        {
            ShowStatus("لا تملك صلاحية إعادة تعيين كلمات المرور (Users.Edit).", isError: true);
            return;
        }

        isProcessing = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            var user = await userMgr.FindByIdAsync(selectedUserForPasswordReset.Id);
            if (user != null)
            {
                var token = await userMgr.GeneratePasswordResetTokenAsync(user);
                var res = await userMgr.ResetPasswordAsync(user, token, newPasswordInput.Trim());
                if (res.Succeeded)
                {
                    await UserEmployeeService.ForceLogoutUserAsync(user.Id, currentUserId ?? "SYSTEM");
                    ShowStatus($"تم تغيير كلمة المرور للمستخدم ({user.UserName}) بنجاح وتحديث الختم الأمني.");
                    CloseModals();
                }
                else
                {
                    var errs = string.Join(" | ", res.Errors.Select(e => e.Description));
                    ShowStatus($"فشل تغيير كلمة السر: {errs}", isError: true);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset password.");
            ShowStatus("حدث خطأ أثناء إعادة تعيين كلمة المرور.", isError: true);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void AskToggleLockout(UserViewModel userVM) => pendingLockout = userVM;

    private async Task ConfirmToggleLockout()
    {
        if (pendingLockout is null) return;
        if (!canEditUsers)
        {
            ShowStatus("لا تملك صلاحية تعديل حالة الحسابات (Users.Edit).", isError: true);
            return;
        }

        isProcessing = true;
        var userVM = pendingLockout;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            var user = await userMgr.FindByIdAsync(userVM.Id);
            if (user != null)
            {
                if (userVM.IsLockedOut)
                {
                    await userMgr.SetLockoutEndDateAsync(user, null);
                    ShowStatus($"تم إلغاء حظر المستخدم ({user.UserName}).");
                }
                else
                {
                    await userMgr.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddYears(100));
                    await UserEmployeeService.ForceLogoutUserAsync(user.Id, currentUserId ?? "SYSTEM");
                    ShowStatus($"تم حظر حساب المستخدم ({user.UserName}) وإنهاء كافة جلساته النشطة فوراً.");
                }

                pendingLockout = null;
                await RefreshAllData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle lockout status.");
            ShowStatus("تعذّر تغيير حالة الحساب.", isError: true);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowStatus(string msg, bool isError = false)
    {
        statusMessage = msg;
        isStatusError = isError;
    }

    private static string FormatRole(string role) => role switch
    {
        "Admin" => "مدير النظام",
        "HRManager" => "مدير الموارد البشرية",
        "FormationManager" => "مدير التشكيل",
        "Supervisor" => "مشرف",
        "Employee" => "موظف",
        _ => role
    };

    private async Task LogSecurityAuditAsync(string action, string targetIdentifier, bool success, string details)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await AuditLogger.LogAsync(
                action: action,
                employeeID: targetIdentifier,
                photoId: null,
                success: success,
                user: authState.User,
                ipAddress: null,
                userAgent: details,
                failureReason: success ? null : details
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write audit log for {Action}", action);
        }
    }
}
