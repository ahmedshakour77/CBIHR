@code {
    public sealed class UserViewModel
    {
        public string Id { get; set; } = string.Empty;
        public string? UserName { get; set; }
        public string? Email { get; set; }
        public string? EmployeeID { get; set; }
        public string? LinkedEmployeeName { get; set; }
        public int? FormationId { get; set; }
        public string? FormationName { get; set; }
        public bool IsLockedOut { get; set; }
        public List<string> AssignedRoles { get; set; } = [];
        public int PermissionClaimsCount { get; set; }
    }

    public sealed class RoleViewModel
    {
        public string RoleId { get; set; } = string.Empty;
        public string RoleName { get; set; } = string.Empty;
        public int UserCount { get; set; }
        public List<string> MemberUsernames { get; set; } = [];
    }

    public sealed class CreateUserModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Password { get; set; }
        public string? EmployeeID { get; set; }
        public int? FormationId { get; set; }
        public List<string> SelectedRoles { get; set; } = [];
    }

    public sealed class WhitelistModel
    {
        public string Email { get; set; } = string.Empty;
        public string? FullName { get; set; }
        public string? Notes { get; set; }
    }

    private string activeTab = "users";
    private List<UserViewModel> usersList = [];
    private List<UserViewModel> filteredUsers = [];
    private List<RoleViewModel> rolesList = [];
    private List<AllowedUser> whitelistedUsers = [];

    private string? searchTerm;
    private bool isLoading = true;
    private bool isProcessing;
    private string? statusMessage;
    private bool isStatusError;

    // Available granular permission claims map
    private static readonly Dictionary<string, string> availablePermissions = new()
    {
        { Permissions.ProfilePhotoRead, "قراءة وتصفح الصور الشخصية" },
        { Permissions.ProfilePhotoUpload, "رفع صورة شخصية جديدة" },
        { Permissions.ProfilePhotoReplace, "استبدال وتحديث صورة شخصية مفعلة" },
        { Permissions.ProfilePhotoDelete, "حذف وأرشفة الصور الشخصية" },
        { Permissions.ManageUsers, "إدارة المستخدمين والأدوار والصلاحيات" },
        { Permissions.ManageDevices, "إدارة وتقييد هواتف الموظفين المقترنة" },
        { Permissions.ViewAuditLogs, "تصفح واستعراض سجل التدقيق الأمني" },
        { Permissions.ManageWorkflows, "تصميم، إدارة، ونشر المسارات الإدارية" },
        { Permissions.ImportEmployees, "استيراد وتحديث بيانات الموظفين بالجملة" },
        { Permissions.ImportAppreciationLetters, "استيراد وتحديث كتب الشكر والتقدير" },
        { Permissions.ImportJobTitles, "استيراد وتحديث وتصنيف العناوين والدرجات الوظيفية" },
        { Permissions.ImportLastAllowanceDate, "استيراد وتحديث تواريخ العلاوة السنوية للموظفين" },
        { Permissions.ManageFeedback, "إدارة ومتابعة تواصل ومقترحات وشكاوى الموظفين" },
        { Permissions.ViewFormationDashboard, "تصفح لوحة مؤشرات التشكيل الإداري" }
    };

    private string? permissionSearchTerm;

    private IEnumerable<MenuGroupDefinition> GetFilteredPermissionGroups()
    {
        if (string.IsNullOrWhiteSpace(permissionSearchTerm))
        {
            return FeaturePermissionCatalog.Groups;
        }

        var term = permissionSearchTerm.Trim();
        var result = new List<MenuGroupDefinition>();

        foreach (var group in FeaturePermissionCatalog.Groups)
        {
            var matchedFeatures = group.Features.Where(f =>
                f.FeatureName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.ViewPermission.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.EditPermission.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.ViewPermission.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.EditPermission.Code.Contains(term, StringComparison.OrdinalIgnoreCase)
            ).ToList();

            if (matchedFeatures.Any() || group.GroupTitle.Contains(term, StringComparison.OrdinalIgnoreCase))
            {
                result.Add(new MenuGroupDefinition(
                    group.GroupKey,
                    group.GroupTitle,
                    group.Icon,
                    matchedFeatures.Any() ? matchedFeatures : group.Features));
            }
        }

        return result;
    }

    // Modal States
    private UserViewModel? selectedUserForRoles;
    private HashSet<string> editingRoles = new();
    private HashSet<string> editingClaims = new();
    private List<Formation> allFormations = [];
    private int? selectedUserFormationId;
    private string rolesModalTab = "direct";
    private bool forceLogoutAfterSave = true;
    private string? cloneSourceUserId;

    private bool showCreateUserModal;
    private CreateUserModel newUserModel = new();
    private bool isTechnicalAccount;
    private string createEmpSearchTerm = "";
    private List<EmployeePickerItem> foundEmployeesForCreate = [];
    private EmployeePickerItem? selectedEmployeeForCreate;
    private bool isSearchingEmployeesForCreate;

    private bool showCreateRoleModal;
    private string? newRoleNameInput;

    private bool showAddWhitelistModal;
    private WhitelistModel newWhitelistModel = new();

    private UserViewModel? selectedUserForLinking;
    private UserViewModel? selectedUserForRelinking;
    private string? inputEmployeeIdToLink;
    private string relinkEmpSearchTerm = "";
    private List<EmployeePickerItem> foundEmployeesForRelink = [];
    private EmployeePickerItem? selectedEmployeeForRelink;
    private bool isSearchingEmployeesForRelink;

    private UserViewModel? selectedUserForPasswordReset;
    private string? newPasswordInput;

    // Pending destructive & administrative actions
    private RoleViewModel? pendingRole;
    private AllowedUser? pendingWhitelist;
    private UserViewModel? pendingLockout;
    private UserViewModel? pendingForceLogout;
    private BatchRepairReport? batchRepairReport;

    private string? currentUserId;
    private string? currentUserName;
    private bool isCallerAdmin;
    private bool canEditUsers;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        currentUserId = principal.FindFirst(ClaimTypes.NameIdentifier)?.Value
                     ?? principal.FindFirst("sub")?.Value;
        currentUserName = principal.Identity?.Name;
        isCallerAdmin = principal.IsInRole("Admin") ||
                        principal.HasClaim(c => (c.Type == ClaimTypes.Role || c.Type == "role") && c.Value.Equals("Admin", StringComparison.OrdinalIgnoreCase)) ||
                        string.Equals(currentUserName, "admin", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(currentUserName, "systemadmin", StringComparison.OrdinalIgnoreCase);

        canEditUsers = isCallerAdmin || principal.HasPermission(Permissions.UsersEdit);

        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("search", out var sVal))
        {
            searchTerm = sVal.ToString();
        }

        await RefreshAllData();
    }

    private async Task RefreshAllData()
    {
        isLoading = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var roleMgr = scope.ServiceProvider.GetRequiredService<RoleManager<IdentityRole>>();

            // 1. Load Whitelist
            whitelistedUsers = await dbContext.AllowedUsers.AsNoTracking().OrderByDescending(w => w.CreatedAt).ToListAsync();

            // 2. Load Roles
            var roles = await roleMgr.Roles.AsNoTracking().ToListAsync();
            rolesList.Clear();
            foreach (var r in roles)
            {
                var members = await userMgr.GetUsersInRoleAsync(r.Name!);
                rolesList.Add(new RoleViewModel
                {
                    RoleId = r.Id,
                    RoleName = r.Name!,
                    UserCount = members.Count,
                    MemberUsernames = members.Select(m => m.UserName!).ToList()
                });
            }

            // 3. Load Formations
            allFormations = await dbContext.Formations.AsNoTracking().OrderBy(f => f.Name).ToListAsync();

            // 4. Load Users
            var dbUsers = await dbContext.Users
                .AsNoTracking()
                .Include(u => u.Employee)
                    .ThenInclude(e => e!.Formation)
                .Include(u => u.Formation)
                .ToListAsync();

            usersList.Clear();
            foreach (var u in dbUsers)
            {
                var assignedRoles = (await userMgr.GetRolesAsync(u)).ToList();
                var claims = await userMgr.GetClaimsAsync(u);
                var permCount = claims.Count(c => c.Type == "permission" || c.Type == "Permission");

                var effFormationId = u.FormationId ?? u.Employee?.FormationId;
                var effFormationName = u.Formation?.Name ?? u.Employee?.Formation?.Name;

                usersList.Add(new UserViewModel
                {
                    Id = u.Id,
                    UserName = u.UserName,
                    Email = u.Email,
                    EmployeeID = u.EmployeeID,
                    LinkedEmployeeName = u.Employee?.Name,
                    FormationId = effFormationId,
                    FormationName = effFormationName,
                    IsLockedOut = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTimeOffset.UtcNow,
                    AssignedRoles = assignedRoles,
                    PermissionClaimsCount = permCount
                });
            }

            ApplySearch();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing roles and users data.");
            ShowStatus("حدث خطأ أثناء تحميل بيانات المستخدمين والأدوار.", isError: true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString();
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = usersList.ToList();
            return;
        }

        var term = searchTerm.Trim();
        filteredUsers = usersList.Where(u =>
            (u.UserName != null && u.UserName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (u.Email != null && u.Email.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (u.EmployeeID != null && u.EmployeeID.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (u.LinkedEmployeeName != null && u.LinkedEmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            u.AssignedRoles.Any(r => r.Contains(term, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    // Modal Openers
    private async Task OpenRolesPermissionsModal(UserViewModel userVM)
    {
        selectedUserForRoles = userVM;
        editingRoles = new HashSet<string>(userVM.AssignedRoles);
        editingClaims.Clear();
        selectedUserFormationId = userVM.FormationId;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userMgr.FindByIdAsync(userVM.Id);
            if (user != null)
            {
                selectedUserFormationId = user.FormationId ?? userVM.FormationId;
                var claims = await userMgr.GetClaimsAsync(user);
                foreach (var c in claims.Where(c => c.Type == "permission" || c.Type == "Permission"))
                {
                    editingClaims.Add(c.Value);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading claims for user.");
        }
    }

    private void OpenCreateUserModal()
    {
        newUserModel = new CreateUserModel();
