    private void AskToggleLockout(UserViewModel userVM) => pendingLockout = userVM;

    private async Task ConfirmToggleLockout()
    {
        if (pendingLockout is null) return;

        isProcessing = true;
        var userVM = pendingLockout;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            var user = await userMgr.FindByIdAsync(userVM.Id);
            if (user != null)
            {
                if (userVM.IsLockedOut)
                {
                    await userMgr.SetLockoutEndDateAsync(user, null);
                    ShowStatus($"تم إلغاء حظر المستخدم ({user.UserName}).");
                }
                else
                {
                    await userMgr.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddYears(100));
                    ShowStatus($"تم حظر حساب المستخدم ({user.UserName}).");
                }

                pendingLockout = null;
                await RefreshAllData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle lockout status.");
            ShowStatus("تعذّر تغيير حالة الحساب.", isError: true);
        }
        finally
        {
            isProcessing = false;
        }
    }

