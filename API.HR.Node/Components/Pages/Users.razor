    // Form Submissions
    private async Task SaveUserRolesAndPermissions()
    {
        if (selectedUserForRoles == null) return;

        // Security Check 1: Prevent Self-Escalation
        if (string.Equals(selectedUserForRoles.Id, currentUserId, StringComparison.OrdinalIgnoreCase) && !isCallerAdmin)
        {
            ShowStatus("لا يمكنك تعديل أدوارك أو صلاحياتك بنفسك لتفادي رفع الصلاحيات غير المصرّح به.", isError: true);
            await LogSecurityAuditAsync("UNAUTHORIZED_SELF_ROLE_MODIFICATION_ATTEMPT", selectedUserForRoles.UserName ?? selectedUserForRoles.Id, false, "Caller attempted to modify their own roles/permissions.");
            return;
        }

        // Security Check 2: Only Admins can assign Admin role or modify Admin users
        var isTargetAdmin = selectedUserForRoles.AssignedRoles.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase));
        var isAssigningAdmin = editingRoles.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase));

        if (!isCallerAdmin && (isTargetAdmin || isAssigningAdmin))
        {
            ShowStatus("صلاحية إسناد دور مدير النظام (Admin) أو تعديل حسابات المدراء محصورة حصرياً بمدراء النظام.", isError: true);
            await LogSecurityAuditAsync("UNAUTHORIZED_ADMIN_ROLE_ESCALATION_ATTEMPT", selectedUserForRoles.UserName ?? selectedUserForRoles.Id, false, "Non-admin attempted to assign Admin role or edit Admin user.");
            return;
        }

        isProcessing = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userMgr.FindByIdAsync(selectedUserForRoles.Id);

            if (user != null)
            {
                // 1. Sync Roles
                var currentRoles = await userMgr.GetRolesAsync(user);
                var rolesToRemove = currentRoles.Except(editingRoles).ToList();
                var rolesToAdd = editingRoles.Except(currentRoles).ToList();

                // Extra safety: non-admin cannot add Admin role under any circumstance
                if (!isCallerAdmin && rolesToAdd.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase)))
                {
                    ShowStatus("لا تملك صلاحية إسناد دور مدير النظام (Admin).", isError: true);
                    await LogSecurityAuditAsync("UNAUTHORIZED_ADMIN_ROLE_ESCALATION_ATTEMPT", user.UserName ?? user.Id, false, "Non-admin attempted to add Admin role.");
                    return;
                }

                await userMgr.RemoveFromRolesAsync(user, rolesToRemove);
                await userMgr.AddToRolesAsync(user, rolesToAdd);

                // 2. Sync Permission Claims
                var currentClaims = await userMgr.GetClaimsAsync(user);
                var permClaims = currentClaims.Where(c => c.Type == "permission" || c.Type == "Permission").ToList();
                await userMgr.RemoveClaimsAsync(user, permClaims);

                var claimsToAdd = editingClaims.Select(c => new Claim("permission", c)).ToList();
                await userMgr.AddClaimsAsync(user, claimsToAdd);

                // 3. Sync Formation Linkage & Claims
                user.FormationId = selectedUserFormationId;
                await userMgr.UpdateAsync(user);

                var existingFormationClaims = currentClaims.Where(c => c.Type == "formation_id" || c.Type == "formation_name").ToList();
                if (existingFormationClaims.Any())
                {
                    await userMgr.RemoveClaimsAsync(user, existingFormationClaims);
                }
                if (selectedUserFormationId.HasValue)
                {
                    var fObj = allFormations.FirstOrDefault(f => f.Id == selectedUserFormationId.Value);
                    await userMgr.AddClaimAsync(user, new Claim("formation_id", selectedUserFormationId.Value.ToString()));
                    if (fObj != null)
                    {
                        await userMgr.AddClaimAsync(user, new Claim("formation_name", fObj.Name));
                    }
                }

                // 4. Audit Log
                await LogSecurityAuditAsync("UPDATE_USER_ROLES_PERMISSIONS", user.EmployeeID ?? user.UserName ?? user.Id, true,
                    $"Target: {user.UserName}, Roles: [{string.Join(", ", editingRoles)}], PermissionsCount: {editingClaims.Count}, ForceLogout: {forceLogoutAfterSave}");

                if (forceLogoutAfterSave)
                {
                    await UserEmployeeService.ForceLogoutUserAsync(user.Id, currentUserId ?? "SYSTEM");
                }

                ShowStatus($"تم تحديث أدوار وصلاحيات وتشكيل الحساب ({user.UserName}) بنجاح{(forceLogoutAfterSave ? "، وتم إنهاء جلسات الحساب لتطبيق الصلاحيات فوراً" : "")}.");
                CloseModals();
                await RefreshAllData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save user roles and permissions.");
            ShowStatus("حدث خطأ أثناء حفظ الصلاحيات والأدوار.", isError: true);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CreateUserSubmit()
    {
        if (!canEditUsers)
        {
            ShowStatus("لا تملك صلاحية إنشاء حسابات المستخدمين (Users.Edit).", isError: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(newUserModel.Username) || string.IsNullOrWhiteSpace(newUserModel.Email) || string.IsNullOrWhiteSpace(newUserModel.Password))
        {
            ShowStatus("يرجى ملء اسم المستخدم والبريد الإلكتروني وكلمة المرور.", isError: true);
            return;
        }

        if (!isTechnicalAccount)
        {
            if (string.IsNullOrWhiteSpace(newUserModel.EmployeeID))
            {
                ShowStatus("يجب اختيار وربط موظف رسمي لكل حساب مستخدم في النظام.", isError: true);
                return;
            }

            if (!await UserEmployeeService.ValidateEmployeeExistsAsync(newUserModel.EmployeeID))
            {
                ShowStatus("الموظف المحدد غير موجود في قاعدة بيانات الموظفين.", isError: true);
                return;
            }
        }
        else
        {
            if (!isCallerAdmin)
            {
                ShowStatus("إنشاء الحسابات التقنية الاستثنائية محصور بمدير النظام فقط.", isError: true);
                return;
            }
        }

        // Security Check: Non-admins cannot create Admin accounts
        if (!isCallerAdmin && newUserModel.SelectedRoles.Any(r => string.Equals(r, "Admin", StringComparison.OrdinalIgnoreCase)))
        {
            ShowStatus("لا تملك صلاحية إنشاء حساب بدور مدير النظام (Admin). هذه العملية محصورة بمدراء النظام فقط.", isError: true);
            await LogSecurityAuditAsync("UNAUTHORIZED_ADMIN_CREATION_ATTEMPT", newUserModel.Username, false, "Non-admin attempted to create user with Admin role.");
            return;
        }

        isProcessing = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userMgr = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var newUser = new ApplicationUser
            {
                UserName = newUserModel.Username.Trim(),
                Email = newUserModel.Email.Trim(),
                EmailConfirmed = true,
                EmployeeID = string.IsNullOrWhiteSpace(newUserModel.EmployeeID) ? null : newUserModel.EmployeeID.Trim(),
                FormationId = newUserModel.FormationId
            };

            var res = await userMgr.CreateAsync(newUser, newUserModel.Password);
            if (res.Succeeded)
            {
                if (newUserModel.SelectedRoles.Count > 0)
                {
                    await userMgr.AddToRolesAsync(newUser, newUserModel.SelectedRoles);
                }

                // Add to whitelist automatically
                if (!dbContext.AllowedUsers.Any(a => a.Email != null && a.Email == newUserModel.Email))
                {
                    dbContext.AllowedUsers.Add(new AllowedUser
                    {
                        Email = newUserModel.Email.Trim(),
                        FullName = newUserModel.Username,
                        Notes = "Created via Admin Hub",
                        IsActive = true,
                        CreatedAt = DateTimeOffset.UtcNow
                    });
                    await dbContext.SaveChangesAsync();
                }

                ShowStatus($"تم إنشاء حساب المستخدم ({newUser.UserName}) بنجاح وتعيين الأدوار.");
                CloseModals();
                await RefreshAllData();
            }
            else
            {
                var errs = string.Join(" | ", res.Errors.Select(e => e.Description));
                ShowStatus($"فشل إنشاء الحساب: {errs}", isError: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create new user account.");
            ShowStatus("حدث خطأ أثناء إنشاء حساب المستخدم.", isError: true);
        }
        finally
        {
            isProcessing = false;
        }
    }

