@page "/users"
@rendermode InteractiveServer
@using System.Security.Claims
@using API.HR.Node.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Security
@attribute [Authorize(Policy = AuthorizationPolicies.ManageUsers)]

@inject IServiceScopeFactory ScopeFactory
@inject ILogger<Users> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject API.HR.Node.Services.Audit.IAuditLogger AuditLogger

<PageTitle>المستخدمون والأدوار | منظومة الموارد البشرية</PageTitle>

@*
    Accounts, roles and the sign-up allow list.

    Three related but distinct jobs, so they are tabs on one page rather
    than three pages — and real tabs: a tablist, aria-selected, and one
    panel at a time, so a screen reader reports the same structure the eye
    sees.

    Each row carries four actions. Naming them all in full would crowd the
    table, so the two frequent ones keep their labels and the two rarer
    ones become icon controls with accessible names — and the destructive
    lockout toggle is separated from the rest.
*@

<div class="hr-stack">

    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <span class="hr-eyebrow">الحسابات والأمان</span>
            <h1 class="hr-h1">المستخدمون والأدوار والصلاحيات</h1>
            <p class="hr-sub hr-measure" style="margin-block-start:.5rem">
                إدارة حسابات الدخول، وإسناد أدوار النظام والصلاحيات التفصيلية، وضبط قائمة البريد المصرّح له بالتسجيل.
            </p>
        </div>

        <div class="hr-pagehead-actions">
            <a href="/data-import" class="hr-btn hr-btn-secondary" title="استيراد وتحديث البريد المؤسسي للموظفين من ملف إكسل">
                <Icon Name="arrow-up-tray" Size="sm" />
                <span>استيراد البريد المؤسسي (Excel)</span>
            </a>
            <button type="button" class="hr-btn hr-btn-primary" @onclick="OpenCreateUserModal">
                <Icon Name="user-plus" Size="sm" />
                <span>حساب جديد</span>
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="hr-alert @(isStatusError ? "hr-alert-danger" : "hr-alert-ok")" role="alert">
            <Icon Name="@(isStatusError ? "exclamation-triangle" : "check-circle")" Size="sm" />
            <div class="hr-alert-grow">
                <p class="hr-wrap-any">@statusMessage</p>
            </div>
            <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                    @onclick="() => statusMessage = null" aria-label="إخفاء الرسالة">
                <Icon Name="x-mark" Size="sm" />
            </button>
        </div>
    }

    <div class="hr-tabs" role="tablist" aria-label="أقسام إدارة الحسابات">
        <button type="button" role="tab" class="hr-tab"
                id="tab-users" aria-controls="panel-users"
                aria-selected="@((activeTab == "users") ? "true" : "false")"
                @onclick='() => activeTab = "users"'>
            <Icon Name="user-circle" Size="sm" />
            <span>الحسابات</span>
            <span class="hr-badge hr-num">@usersList.Count</span>
        </button>

        <button type="button" role="tab" class="hr-tab"
                id="tab-roles" aria-controls="panel-roles"
                aria-selected="@((activeTab == "roles") ? "true" : "false")"
                @onclick='() => activeTab = "roles"'>
            <Icon Name="shield-check" Size="sm" />
            <span>أدوار النظام</span>
            <span class="hr-badge hr-num">@rolesList.Count</span>
        </button>

        <button type="button" role="tab" class="hr-tab"
                id="tab-whitelist" aria-controls="panel-whitelist"
                aria-selected="@((activeTab == "whitelist") ? "true" : "false")"
                @onclick='() => activeTab = "whitelist"'>
            <Icon Name="clipboard-document-list" Size="sm" />
            <span>القائمة المصرّح بها</span>
            <span class="hr-badge hr-num">@whitelistedUsers.Count</span>
        </button>
    </div>

    @* ---------- accounts ---------- *@
    @if (activeTab == "users")
    {
        <div id="panel-users" role="tabpanel" aria-labelledby="tab-users" tabindex="0">
            <section class="hr-card">
                <div class="hr-toolbar">
                    <div class="hr-toolbar-search">
                        <label class="hr-field-label" for="user-search">بحث في الحسابات</label>
                        <div class="hr-search">
                            <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="sm" /></span>
                            <input id="user-search"
                                   type="search"
                                   class="hr-input"
                                   placeholder="اسم الحساب، البريد، الدور أو الرقم الوظيفي"
                                   value="@searchTerm"
                                   @oninput="OnSearchInput" />
                        </div>
                    </div>

                    <div class="hr-toolbar-actions">
                        <button type="button" class="hr-btn hr-btn-secondary" @onclick="RefreshAllData" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="hr-spinner" aria-hidden="true"></span>
                                <span>جارٍ التحديث…</span>
                            }
                            else
                            {
                                <Icon Name="arrow-path" Size="sm" />
                                <span>تحديث</span>
                            }
                        </button>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="hr-card-body">
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="hr-skeleton" style="height:3.25rem;margin-block-end:.5rem" aria-hidden="true"></div>
                        }
                    </div>
                }
                else if (filteredUsers.Count == 0)
                {
                    <div class="hr-empty">
                        <span class="hr-empty-art" aria-hidden="true"><Icon Name="user-circle" Size="lg" /></span>
                        <p class="hr-h3">@(usersList.Count == 0 ? "لا توجد حسابات" : "لا نتائج مطابقة")</p>
                        <p class="hr-sub hr-measure-sm">
                            @(usersList.Count == 0
                                ? "لم يُنشأ أي حساب مستخدم بعد."
                                : "جرّب تعديل نص البحث.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="hr-tablewrap">
                        <table class="hr-table hr-table-wide">
                            <caption class="hr-sr">حسابات المستخدمين وأدوارهم وصلاحياتهم</caption>
                            <thead>
                                <tr>
                                    <th scope="col">الحساب</th>
                                    <th scope="col">البريد الإلكتروني</th>
                                    <th scope="col">الموظف المرتبط</th>
                                    <th scope="col">الأدوار</th>
                                    <th scope="col">الصلاحيات</th>
                                    <th scope="col">الحالة</th>
                                    <th scope="col"><span class="hr-sr">إجراءات</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in filteredUsers)
                                {
                                    <tr @key="u.Id">
                                        <td>
                                            <div class="hr-idcell">
                                                <API.HR.Node.Components.Layout.UserAvatar EmployeeId="@u.EmployeeID"
                                                                                          UserName="@u.UserName"
                                                                                          Size="sm" />
                                                <div class="hr-idcell-text">
                                                    <span class="hr-cell-strong hr-truncate">@u.UserName</span>
                                                    @if (!string.IsNullOrWhiteSpace(u.EmployeeID))
                                                    {
                                                        <span class="hr-cell-sub hr-num hr-truncate">رقم: @u.EmployeeID</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>

                                        <td><span class="hr-wrap-any">@(u.Email ?? "—")</span></td>

                                        <td>
                                            @if (!string.IsNullOrEmpty(u.EmployeeID))
                                            {
                                                <span class="hr-cell-strong">@(u.LinkedEmployeeName ?? "—")</span>
                                                <span class="hr-cell-sub hr-num">@u.EmployeeID</span>
                                            }
                                            else
                                            {
                                                <span class="hr-badge hr-badge-warn">
                                                    <Icon Name="link-slash" Size="xs" />
                                                    <span>غير مرتبط</span>
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(u.FormationName))
                                            {
                                                <div style="margin-block-start:0.25rem;">
                                                    <span class="hr-badge hr-badge-accent" title="التشكيل الإداري: @u.FormationName">
                                                        <Icon Name="building-office-2" Size="xs" />
                                                        <span class="hr-truncate" style="max-width:10rem;">@u.FormationName</span>
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @if (u.AssignedRoles.Count == 0)
                                            {
                                                <span class="hr-meta">بدون أدوار</span>
                                            }
                                            else
                                            {
                                                <div class="hr-chips">
                                                    @foreach (var r in u.AssignedRoles)
                                                    {
                                                        <span class="hr-badge hr-badge-solid" title="@r">@FormatRole(r)</span>
                                                    }
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            <span class="hr-badge hr-badge-accent">
                                                <span class="hr-num">@u.PermissionClaimsCount</span>
                                                <span>إذن</span>
                                            </span>
                                        </td>

                                        <td>
                                            @if (u.IsLockedOut)
                                            {
                                                <span class="hr-badge hr-badge-danger">
                                                    <Icon Name="lock-closed" Size="xs" />
                                                    <span>محظور</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="hr-badge hr-badge-ok">
                                                    <Icon Name="check-circle" Size="xs" />
                                                    <span>نشط</span>
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <div class="hr-rowactions">
                                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                                                        @onclick="() => OpenRolesPermissionsModal(u)">
                                                    <Icon Name="shield-check" Size="xs" />
                                                    <span>الأدوار</span>
                                                </button>

                                                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => OpenLinkModal(u)"
                                                        aria-label="@($"ربط الحساب {u.UserName} برقم وظيفي")"
                                                        title="ربط برقم وظيفي">
                                                    <Icon Name="link" Size="xs" />
                                                </button>

                                                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => OpenResetPasswordModal(u)"
                                                        aria-label="@($"إعادة تعيين كلمة مرور {u.UserName}")"
                                                        title="إعادة تعيين كلمة المرور">
                                                    <Icon Name="key" Size="xs" />
                                                </button>

                                                <span class="hr-rowactions-sep" aria-hidden="true"></span>

                                                <button type="button"
                                                        class="hr-btn hr-btn-sm hr-btn-icon @(u.IsLockedOut ? "hr-btn-secondary" : "hr-btn-danger-quiet")"
                                                        @onclick="() => AskToggleLockout(u)"
                                                        aria-label="@(u.IsLockedOut ? $"إلغاء حظر {u.UserName}" : $"حظر حساب {u.UserName}")"
                                                        title="@(u.IsLockedOut ? "إلغاء الحظر" : "حظر الحساب")">
                                                    <Icon Name="@(u.IsLockedOut ? "lock-open" : "lock-closed")" Size="xs" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="hr-card-foot">
                        <p class="hr-meta">
                            عرض <span class="hr-num">@filteredUsers.Count</span>
                            من <span class="hr-num">@usersList.Count</span> حساب
                        </p>
                    </div>
                }
            </section>
        </div>
    }

    @* ---------- roles ---------- *@
    @if (activeTab == "roles")
    {
        <div id="panel-roles" role="tabpanel" aria-labelledby="tab-roles" tabindex="0" class="hr-stack-sm">
            <div class="hr-section-head">
                <div>
                    <h2 class="hr-h2">أدوار النظام</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        الأدوار التي يُبنى عليها التحكم بالوصول عبر صفحات النظام.
                    </p>
                </div>
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="OpenCreateRoleModal">
                    <Icon Name="plus" Size="sm" />
                    <span>دور جديد</span>
                </button>
            </div>

            @if (rolesList.Count == 0)
            {
                <div class="hr-card">
                    <div class="hr-empty">
                        <span class="hr-empty-art" aria-hidden="true"><Icon Name="shield-check" Size="lg" /></span>
                        <p class="hr-h3">لا توجد أدوار معرّفة</p>
                    </div>
                </div>
            }
            else
            {
                <div class="hr-grid-cards">
                    @foreach (var role in rolesList)
                    {
                        <article class="hr-card" @key="role.RoleId">
                            <div class="hr-card-body">
                                <div class="hr-idcell">
                                    <span class="hr-iconplate" aria-hidden="true"><Icon Name="shield-check" Size="sm" /></span>
                                    <div class="hr-idcell-text">
                                        <h3 class="hr-h3 hr-truncate">@role.RoleName</h3>
                                        <span class="hr-cell-sub hr-num hr-truncate hr-cell-id">@role.RoleId</span>
                                    </div>
                                    <span class="hr-badge hr-badge-accent">
                                        <span class="hr-num">@role.UserCount</span>
                                        <span>عضو</span>
                                    </span>
                                </div>

                                <div style="margin-block-start:1rem">
                                    <p class="hr-eyebrow" style="margin-block-end:.5rem">الأعضاء</p>
                                    @if (role.MemberUsernames.Count == 0)
                                    {
                                        <p class="hr-meta">لا يوجد أعضاء في هذا الدور.</p>
                                    }
                                    else
                                    {
                                        <div class="hr-chips">
                                            @foreach (var m in role.MemberUsernames.Take(5))
                                            {
                                                <span class="hr-badge">@m</span>
                                            }
                                            @if (role.MemberUsernames.Count > 5)
                                            {
                                                <span class="hr-badge hr-badge-accent">
                                                    <span class="hr-num">+@(role.MemberUsernames.Count - 5)</span>
                                                    <span>آخرين</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @* The Admin role is the system's own floor and is not
                               offered for deletion. *@
                            @if (role.RoleName != "Admin")
                            {
                                <div class="hr-card-foot" style="display:flex;justify-content:flex-end">
                                    <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm"
                                            @onclick="() => AskDeleteRole(role)">
                                        <Icon Name="trash" Size="xs" />
                                        <span>حذف الدور</span>
                                    </button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    }

    @* ---------- whitelist ---------- *@
    @if (activeTab == "whitelist")
    {
        <div id="panel-whitelist" role="tabpanel" aria-labelledby="tab-whitelist" tabindex="0" class="hr-stack-sm">
            <div class="hr-section-head">
                <div>
                    <h2 class="hr-h2">القائمة المصرّح لها بالتسجيل</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        يقتصر إنشاء الحسابات على عناوين البريد المدرجة هنا.
                    </p>
                </div>
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="OpenAddWhitelistModal">
                    <Icon Name="plus" Size="sm" />
                    <span>إضافة بريد</span>
                </button>
            </div>

            <section class="hr-card">
                @if (whitelistedUsers.Count == 0)
                {
                    <div class="hr-empty">
                        <span class="hr-empty-art" aria-hidden="true"><Icon Name="clipboard-document-list" Size="lg" /></span>
                        <p class="hr-h3">القائمة فارغة</p>
                        <p class="hr-sub hr-measure-sm">لم يُضَف أي بريد إلى قائمة التصريح بعد.</p>
                    </div>
                }
                else
                {
                    <div class="hr-tablewrap">
                        <table class="hr-table">
                            <caption class="hr-sr">عناوين البريد المصرّح لها بإنشاء حساب</caption>
                            <thead>
                                <tr>
                                    <th scope="col">البريد الإلكتروني</th>
                                    <th scope="col">الاسم والملاحظات</th>
                                    <th scope="col">تاريخ الإضافة</th>
                                    <th scope="col">الحالة</th>
                                    <th scope="col"><span class="hr-sr">إجراءات</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in whitelistedUsers)
                                {
                                    <tr @key="w.Id">
                                        <td><span class="hr-cell-strong hr-wrap-any">@w.Email</span></td>
                                        <td>
                                            <span class="hr-cell-strong">@(w.FullName ?? "—")</span>
                                            @if (!string.IsNullOrWhiteSpace(w.Notes))
                                            {
                                                <span class="hr-cell-sub hr-wrap-any">@w.Notes</span>
                                            }
                                        </td>
                                        <td class="hr-num">@w.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                        <td>
                                            @if (w.IsActive)
                                            {
                                                <span class="hr-badge hr-badge-ok">
                                                    <Icon Name="check-circle" Size="xs" />
                                                    <span>مصرّح</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="hr-badge hr-badge-warn">
                                                    <Icon Name="no-symbol" Size="xs" />
                                                    <span>موقوف</span>
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="hr-rowactions">
                                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                                                        @onclick="() => ToggleWhitelistStatus(w)">
                                                    <Icon Name="@(w.IsActive ? "no-symbol" : "check")" Size="xs" />
                                                    <span>@(w.IsActive ? "إيقاف" : "تفعيل")</span>
                                                </button>

                                                <span class="hr-rowactions-sep" aria-hidden="true"></span>

                                                <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => AskRemoveWhitelist(w)"
                                                        aria-label="@($"حذف {w.Email} من القائمة")"
                                                        title="حذف من القائمة">
                                                    <Icon Name="trash" Size="xs" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
</div>

@* ---------- roles & permissions ---------- *@
<Modal IsOpen="@(selectedUserForRoles != null)"
       Title="الأدوار والصلاحيات"
       Subtitle="@selectedUserForRoles?.UserName"
       Icon="shield-check"
       Size="xl"
       OnClose="CloseModals">
    <Body>
        <fieldset class="hr-fieldset">
            <legend class="hr-legend-title">أدوار النظام</legend>
            <p class="hr-help" style="margin-block-end:.75rem">
                يمنح الدور مجموعة صلاحيات جاهزة. يمكن دمج أكثر من دور للحساب الواحد.
            </p>
            <div class="hr-optiongrid">
                @foreach (var role in rolesList)
                {
                    var rName = role.RoleName;
                    var isChecked = editingRoles.Contains(rName);
                    var isAdminRole = string.Equals(rName, "Admin", StringComparison.OrdinalIgnoreCase);
                    var isDisabled = isAdminRole && !isCallerAdmin;
                    <label class="hr-optioncard @(isChecked ? "is-selected" : "") @(isDisabled ? "is-disabled" : "")" style="@(isDisabled ? "opacity:0.5;cursor:not-allowed;" : "")">
                        <input type="checkbox" checked="@isChecked" disabled="@isDisabled"
                               @onchange='(e) => ToggleRoleSelection(rName, (bool)e.Value!)' />
                        <span class="hr-optioncard-text">
                            @rName
                            @if (isAdminRole)
                            {
                                <span class="hr-badge hr-badge-neutral" style="font-size:0.65rem;margin-inline-start:0.35rem">محصور بمدير النظام</span>
                            }
                        </span>
                    </label>
                }
            </div>
        </fieldset>

        <fieldset class="hr-fieldset" style="margin-block-start:1.5rem">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);margin-block-end:.75rem">
                <div>
                    <legend class="hr-legend-title" style="margin:0">الصلاحيات التفصيلية (رؤية وتعديل لكل ميزة وتاب)</legend>
                    <p class="hr-help" style="margin-block-start:.25rem">
                        حدد صلاحيات الرؤية والتعديل لكل قسم وتبويب في النظام. تتيح للمستخدم الوصول وإجراء العمليات بدقة.
                    </p>
                </div>
                <div style="display:flex;align-items:center;gap:var(--s-1);flex-wrap:wrap">
                    <button type="button" class="hr-btn hr-btn-sm hr-btn-secondary" @onclick="SelectAllPermissions">
                        <Icon Name="check-badge" Size="xs" />
                        <span>منح الكل (رؤية وتعديل)</span>
                    </button>
                    <button type="button" class="hr-btn hr-btn-sm hr-btn-secondary" @onclick="SelectAllViewPermissions">
                        <Icon Name="eye" Size="xs" />
                        <span>منح الرؤية فقط للجميع</span>
                    </button>
                    <button type="button" class="hr-btn hr-btn-sm hr-btn-quiet" @onclick="ClearAllPermissions">
                        <Icon Name="x-mark" Size="xs" />
                        <span>إلغاء التحديد</span>
                    </button>
                </div>
            </div>

            <div style="margin-block-end:1rem">
                <input type="search" class="hr-input" placeholder="بحث سريع في الصلاحيات والميزات..."
                       @bind="permissionSearchTerm" @bind:event="oninput" />
            </div>

            <div class="hr-stack" style="gap:var(--s-3)">
                @foreach (var group in GetFilteredPermissionGroups())
                {
                    <div class="hr-card" style="padding:var(--s-3);background:var(--surface-raised);border:1px solid var(--line);border-radius:var(--r-md)">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);padding-block-end:var(--s-2);border-block-end:1px solid var(--line-subtle);margin-block-end:var(--s-2)">
                            <div style="display:flex;align-items:center;gap:var(--s-2)">
                                <span class="hr-iconplate" aria-hidden="true" style="width:28px;height:28px">
                                    <Icon Name="@group.Icon" Size="xs" />
                                </span>
                                <strong>@group.GroupTitle</strong>
                                <span class="hr-meta">(@group.Features.Count ميزة)</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:var(--s-1)">
                                <button type="button" class="hr-btn hr-btn-xs hr-btn-secondary" @onclick="() => SelectGroupPermissions(group, false)">
                                    تحديد المجموعة
                                </button>
                                <button type="button" class="hr-btn hr-btn-xs hr-btn-secondary" @onclick="() => SelectGroupPermissions(group, true)">
                                    رؤية فقط
                                </button>
                                <button type="button" class="hr-btn hr-btn-xs hr-btn-quiet" @onclick="() => ClearGroupPermissions(group)">
                                    إلغاء
                                </button>
                            </div>
                        </div>

                        <div class="hr-table-container" style="background:transparent;border:none">
                            <table class="hr-table" style="font-size:0.875rem">
                                <thead>
                                    <tr>
                                        <th style="width:38%">الميزة / التبويب</th>
                                        <th style="width:23%">صلاحية الرؤية (View)</th>
                                        <th style="width:23%">صلاحية التعديل (Edit)</th>
                                        <th style="width:16%">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var feat in group.Features)
                                    {
                                        var hasView = editingClaims.Contains(feat.ViewPermission.Code);
                                        var hasEdit = editingClaims.Contains(feat.EditPermission.Code);
                                        <tr>
                                            <td>
                                                <div style="display:flex;align-items:center;gap:var(--s-1)">
                                                    <Icon Name="@feat.Icon" Size="xs" />
                                                    <span class="hr-cell-strong">@feat.FeatureName</span>
                                                </div>
                                                <small class="hr-meta" style="display:block;font-size:0.75rem">@feat.ViewPermission.Description</small>
                                            </td>
                                            <td>
                                                <label style="display:flex;align-items:center;gap:var(--s-1);cursor:pointer">
                                                    <input type="checkbox" checked="@hasView"
                                                           @onchange="(e) => ToggleClaimSelection(feat.ViewPermission.Code, (bool)e.Value!)" />
                                                    <span>رؤية</span>
                                                </label>
                                            </td>
                                            <td>
                                                <label style="display:flex;align-items:center;gap:var(--s-1);cursor:pointer">
                                                    <input type="checkbox" checked="@hasEdit"
                                                           @onchange="(e) => ToggleEditClaimSelection(feat, (bool)e.Value!)" />
                                                    <span style="color:var(--accent-text);font-weight:600">تعديل</span>
                                                </label>
                                            </td>
                                            <td>
                                                @if (hasEdit)
                                                {
                                                    <span class="hr-badge hr-badge-accent" style="font-size:0.7rem">رؤية + تعديل</span>
                                                }
                                                else if (hasView)
                                                {
                                                    <span class="hr-badge hr-badge-neutral" style="font-size:0.7rem">رؤية فقط</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta" style="font-size:0.75rem">معطل</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </fieldset>

        <div class="hr-field" style="margin-block-start:1.5rem;padding:var(--s-3);background:var(--surface-raised);border-radius:var(--r-md);border:1px solid var(--line);">
            <label class="hr-field-label" for="edit-user-formation" style="display:flex;align-items:center;gap:var(--s-1);">
