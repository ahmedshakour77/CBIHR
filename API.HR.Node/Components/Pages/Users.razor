    private void ApplyPreset(string presetName)
    {
        if (presetName == "Admin" && !isCallerAdmin) return;

        if (FeaturePermissionCatalog.RolePermissionPackages.TryGetValue(presetName, out var permissions))
        {
            editingRoles.Clear();
            editingRoles.Add(presetName);
            editingClaims.Clear();
            foreach (var p in permissions)
            {
                editingClaims.Add(p);
            }
            ShowStatus($"تم تطبيق باقة ({FormatRole(presetName)}) بنجاح. يمكنك المراجعة قبل الحفظ.");
        }
    }

