    private static string FormatRole(string role) => role switch
    {
        "Admin" => "مدير النظام",
        "HRManager" => "مدير الموارد البشرية",
        "FormationManager" => "مدير التشكيل",
        "Supervisor" => "مشرف",
        "Employee" => "موظف",
        _ => role
    };

    private async Task LogSecurityAuditAsync(string action, string targetIdentifier, bool success, string details)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await AuditLogger.LogAsync(
                action: action,
                employeeID: targetIdentifier,
                photoId: null,
                success: success,
                user: authState.User,
                ipAddress: null,
                userAgent: details,
                failureReason: success ? null : details
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to write audit log for {Action}", action);
        }
    }
