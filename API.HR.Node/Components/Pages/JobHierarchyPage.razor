@page "/job-hierarchy"
@rendermode InteractiveServer
@using API.HR.Node.Security
@attribute [Authorize(Policy = Permissions.JobHierarchyView)]

@using API.HR.Node.Services.OrganizationalHierarchy
@using API.HR.Node.Services.Localization
@inject IJobHierarchyService JobHierarchyService
@inject ILanguageService Lang
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@(Lang.IsKurdish ? "پێکهاتەی وەزیفی و هێڵکاریی دارێژەیی | CBI HR" : "الهيكل الوظيفي والتنظيمي الشجري | البنك المركزي العراقي")</PageTitle>

<div class="hr-page" dir="rtl">

    @* ==================== 1. PAGE HEADER ==================== *@
    <header>
        <div class="hr-pagehead">
            <div class="hr-pagehead-titles hr-card-head__lead" style="align-items: center">
                <div class="hr-iconplate hr-iconplate-lg hr-tone-4" aria-hidden="true">
                    <Icon Name="squares-2x2" Size="md" />
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                        <h1 class="hr-h1" style="margin:0">الهيكل الوظيفي والتنظيمي الشجري</h1>
                        <span class="hr-badge hr-badge-accent" style="background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);border:1px solid color-mix(in srgb, var(--series-4) 30%, transparent);">
                            البنك المركزي العراقي
                        </span>
                        <span class="hr-badge hr-badge-ok">بيانات حية 100%</span>
                    </div>
                    <p class="hr-meta" style="margin:4px 0 0 0;line-height:1.5;">
                        مخطط شجري تفاعلي متطور يعرض سلسلة القيادة والتبعية، التشكيلات المركزية، الفروع الإقليمية، وتوزيع الكوادر والمناصب الإشرافية.
                    </p>
                </div>
            </div>

            <div class="hr-pagehead-actions">
                <a href="org-hierarchy" 
                   class="hr-btn hr-btn-secondary hr-btn-sm" 
                   title="إدارة وتعديل وحدات شجرة الهيكل الوظيفي والمسؤولين والكوادر">
                    <Icon Name="pencil-square" Size="xs" />
                    <span>إدارة شجرة الهيكل الوظيفي </span>
                </a>

                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="PrintOrgChart" title="طباعة المخطط الشجري">
                    <Icon Name="printer" Size="xs" />
                    <span>طباعة المخطط</span>
                </button>

                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ReloadDataAsync" title="تحديث البيانات">
                    <Icon Name="arrow-path" Size="xs" />
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @* STATS STRIP *@
        @if (overviewStats != null)
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(180px, 100%), 1fr));gap:var(--s-2);margin-block-start:var(--s-3);">
                <div class="hr-card" style="padding:var(--s-2) var(--s-3);display:flex;align-items:center;gap:var(--s-2);background:var(--surface);">
                    <span style="width:34px;height:34px;border-radius:var(--r-md);background:color-mix(in srgb, var(--series-4) 12%, transparent);color:var(--series-4);display:grid;place-items:center;">
                        <Icon Name="building-library" Size="xs" />
                    </span>
                    <div>
                        <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">الوحدات والتشكيلات الإدارية</span>
                        <strong class="hr-num" style="font-size:var(--fs-title);color:var(--text);">@overviewStats.TotalFormations وحدة</strong>
                    </div>
                </div>

                <div class="hr-card" style="padding:var(--s-2) var(--s-3);display:flex;align-items:center;gap:var(--s-2);background:var(--surface);">
                    <span style="width:34px;height:34px;border-radius:var(--r-md);background:color-mix(in srgb, var(--series-2) 12%, transparent);color:var(--series-2);display:grid;place-items:center;">
                        <Icon Name="users" Size="xs" />
                    </span>
                    <div>
                        <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">الموظفون في الهيكلية</span>
                        <strong class="hr-num" style="font-size:var(--fs-title);color:var(--text);">@overviewStats.TotalEmployees.ToString("N0") موظف</strong>
                    </div>
                </div>

                <div class="hr-card" style="padding:var(--s-2) var(--s-3);display:flex;align-items:center;gap:var(--s-2);background:var(--surface);">
                    <span style="width:34px;height:34px;border-radius:var(--r-md);background:color-mix(in srgb, var(--series-1) 12%, transparent);color:var(--series-1);display:grid;place-items:center;">
                        <Icon Name="shield-check" Size="xs" />
                    </span>
                    <div>
                        <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">المناصب والمسؤولون المكلفون</span>
                        <strong class="hr-num" style="font-size:var(--fs-title);color:var(--text);">@overviewStats.LeadershipPositionsCount منصب</strong>
                    </div>
                </div>

                <div class="hr-card" style="padding:var(--s-2) var(--s-3);display:flex;align-items:center;gap:var(--s-2);background:var(--surface);">
                    <span style="width:34px;height:34px;border-radius:var(--r-md);background:color-mix(in srgb, var(--series-3) 12%, transparent);color:var(--series-3);display:grid;place-items:center;">
                        <Icon Name="map-pin" Size="xs" />
                    </span>
                    <div>
                        <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">الفروع المعتمدة في الشجرة</span>
                        <strong class="hr-num" style="font-size:var(--fs-title);color:var(--text);">@overviewStats.BranchCount @(overviewStats.BranchCount == 1 ? "فرع" : "فروع")</strong>
                    </div>
                </div>

                <div class="hr-card" style="padding:var(--s-2) var(--s-3);display:flex;align-items:center;gap:var(--s-2);background:var(--surface);">
                    <span style="width:34px;height:34px;border-radius:var(--r-md);background:color-mix(in srgb, var(--series-2) 12%, transparent);color:var(--series-2);display:grid;place-items:center;">
                        <Icon Name="chart-bar" Size="xs" />
                    </span>
                    <div>
                        <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">الشعب الإدارية</span>
                        <strong class="hr-num" style="font-size:var(--fs-title);color:var(--text);">@overviewStats.SupervisorySectionsCount شعبة</strong>
                    </div>
                </div>
            </div>
        }
    </header>

    @* SYNC SUCCESS ALERT *@
    @if (!string.IsNullOrEmpty(syncMessage))
    {
        <div class="hr-alert hr-alert-ok" style="margin-block-end:var(--s-3);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
            <div style="display:flex;align-items:center;gap:var(--s-2);">
                <Icon Name="check-circle" Size="sm" />
                <span>@syncMessage</span>
            </div>
            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => syncMessage = null">
                <Icon Name="x-mark" Size="xs" />
            </button>
        </div>
    }

    @* ==================== 2. TOOLBAR & VIEW SWITCHER ==================== *@
    <div class="hr-card" style="padding:var(--s-3);margin-block-end:var(--s-3);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);background:var(--surface);">
        
        @* View Mode Selector *@
        <div style="display:flex;align-items:center;gap:var(--s-1);background:var(--surface-sunken);padding:3px;border-radius:var(--r-md);border:1px solid var(--line);">
            <button type="button" 
                    class="hr-btn hr-btn-sm @(activeTab == "chart" ? "hr-btn-primary" : "hr-btn-quiet")" 
                    style="border-radius:var(--r-sm);font-weight:600;" 
                    @onclick='() => SetTab("chart")'>
                <Icon Name="squares-2x2" Size="xs" />
                <span>المخطط الشجري التفاعلي (Org Chart)</span>
            </button>
            <button type="button" 
                    class="hr-btn hr-btn-sm @(activeTab == "grades" ? "hr-btn-primary" : "hr-btn-quiet")" 
                    style="border-radius:var(--r-sm);font-weight:600;" 
                    @onclick='() => SetTab("grades")'>
                 
                <span>شجرة الدرجات والعناوين الوظيفية</span>
            </button>
            <button type="button" 
                    class="hr-btn hr-btn-sm @(activeTab == "grid" ? "hr-btn-primary" : "hr-btn-quiet")" 
                    style="border-radius:var(--r-sm);font-weight:600;" 
                    @onclick='() => SetTab("grid")'>
                <Icon Name="table-cells" Size="xs" />
                <span>دليل التشكيلات والمسؤولين</span>
            </button>
        </div>

        @* Search & Filters *@
        <div style="display:flex;align-items:center;gap:var(--s-2);flex:1;max-width:400px;min-width:min(240px, 100%);">
            <div style="position:relative;width:100%;">
                <input aria-label="ابحث عن تشكيل، منصب، أو مسؤول" type="text" 
                       class="hr-input hr-input-sm" 
                       style="padding-inline-start:2rem;width:100%;" 
                       placeholder="ابحث عن تشكيل، منصب، أو مسؤول..." 
                       @bind="searchQuery" 
                       @bind:event="oninput" />
                <span style="position:absolute;inset-inline-start:8px;top:50%;transform:translateY(-50%);color:var(--text-3);pointer-events:none;">
                    <Icon Name="magnifying-glass" Size="xs" />
                </span>
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" 
                            style="position:absolute;inset-inline-end:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-3);cursor:pointer;" 
                            @onclick="() => searchQuery = string.Empty">
                        <Icon Name="x-mark" Size="xs" />
                    </button>
                }
            </div>
        </div>

        @* Tree Controls (Only visible in Chart mode) *@
        @if (activeTab == "chart")
        {
            <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                
                @* Mouse Interaction Badge *@
                <span class="hr-badge" style="font-size:var(--fs-caption);padding:4px 8px;gap:5px;border:1px solid var(--line-soft);" title="اسحب بالماوس لتحريك المخطط بحرية في كل الاتجاهات، واستخدم عجلة الماوس للتكبير والتصغير">
                    <span>🖱️ سحب لتحريك المخطط · عجلة للتكبير</span>
                </span>

                @* Adjustable Layout Mode Button *@
                <button type="button" 
                        class="hr-btn hr-btn-sm @(isCompactLeafLayout ? "hr-btn-primary" : "hr-btn-secondary")" 
                        style="border-radius:var(--r-sm);font-weight:600;font-size:var(--fs-label);" 
                        @onclick="ToggleLayoutMode" 
                        title="تخطيط متوازن: عرض الأقسام بدون فروع واحدة تحت الأخرى لتوفير مساحة الشاشة أو التمدد أفقياً">
                    <Icon Name="squares-2x2" Size="xs" />
                    <span>@(isCompactLeafLayout ? "تخطيط متوازن (رأسي للأقسام)" : "تخطيط أفقي ممتد")</span>
                </button>

                <div style="width:1px;height:20px;background:var(--line);margin:0 2px;"></div>

                @* Zoom Controls *@
                <div style="display:flex;align-items:center;gap:2px;">
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ZoomOut" title="تصغير">
                        <Icon Name="minus" Size="xs" />
                    </button>
                    <span class="hr-meta hr-num" style="min-width:44px;text-align:center;font-size:var(--fs-caption);">@((int)(zoomLevel * 100))%</span>
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ZoomIn" title="تكبير">
                        <Icon Name="plus" Size="xs" />
                    </button>
                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="ResetZoom" title="إعادة ضبط الحجم (100%)">
                        <span>100%</span>
                    </button>
                </div>

                <div style="width:1px;height:20px;background:var(--line);margin:0 2px;"></div>

                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="ExpandAll">
                    <Icon Name="chevron-down" Size="xs" />
                    <span>توسيع الكل</span>
                </button>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="CollapseAll">
                    <Icon Name="chevron-up" Size="xs" />
                    <span>طي الفروع</span>
                </button>
            </div>
        }
    </div>

    @* ==================== 3. CONTENT AREA ==================== *@
    @if (isLoading)
    {
        <div class="hr-card" style="padding:var(--s-8);text-align:center;">
            <div class="hr-spinner hr-spinner-lg" style="margin-inline:auto;"></div>
            <p class="hr-meta" style="margin-block-start:var(--s-3);">جارٍ تحليل وتحميل شجرة الهيكل الوظيفي اللحظية...</p>
        </div>
    }
    else if (treeRoot == null)
    {
        <div class="hr-card hr-empty" style="padding:var(--s-8);text-align:center;">
            <Icon Name="exclamation-circle" Size="lg" />
            <h2 class="hr-h2">تعذر قراءة الهيكل الوظيفي</h2>
            <p class="hr-meta">يرجى التأكد من اتصال قاعدة البيانات والمحاولة مجدداً.</p>
        </div>
    }
    else
    {
        @* TAB 1: INTERACTIVE VISUAL ORG CHART TREE *@
        @if (activeTab == "chart")
        {
            @if (treeRoot.Id == "empty-tree")
            {
                <div class="hr-card hr-empty" style="padding:var(--s-8);text-align:center;max-width:560px;margin:var(--s-8) auto;border:1px dashed var(--line);border-radius:var(--r-lg);">
                    <div style="font-size:3rem;margin-block-end:var(--s-2);">🌳</div>
                    <h2 class="hr-h2" style="margin-block-end:var(--s-2);">شجرة الهيكل الوظيفي فارغة حالياً</h2>
                    <p class="hr-meta" style="line-height:1.6;margin-block-end:var(--s-4);">
                        المخطط التفاعلي يعتمد حصراً على الشجرة التي تنشئها في نظام الهيكل الوظيفي. لم يتم العثور على تشكيلات إدارية حتى الآن.
                    </p>
                    <a href="org-hierarchy" class="hr-btn hr-btn-primary">
                        <Icon Name="squares-plus" Size="sm" />
                        <span>بناء وإضافة تشكيلات الشجرة الآن </span>
                    </a>
                </div>
            }
            else
            {
                <div id="hr-orgchart-viewport"
                     class="hr-orgchart-viewport">
                    
                    <div id="hr-orgchart-canvas"
                         class="hr-orgchart-canvas" 
                         style="transform: scale(@zoomLevel);">
                        
                        @* Render Tree Recursively *@
                        @RenderOrgNode(treeRoot)

                    </div>
                </div>
            }
        }

        @* TAB 2: JOB TITLES & GRADES BREAKDOWN *@
        @if (activeTab == "grades")
        {
            <div style="display:flex;flex-direction:column;gap:var(--s-4);">
                <div class="hr-card" style="padding:var(--s-4);background:var(--surface);">
                    <h2 class="hr-h2" style="margin:0 0 var(--s-1) 0;">التدرج الوظيفي للدرجات والعناوين</h2>
                    <p class="hr-meta" style="margin:0;">تحليل أعداد الكوادر عبر الدرجات الوظيفية الرسمية والعناوين التخصصية في البنك المركزي.</p>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(320px, 100%), 1fr));gap:var(--s-3);">
                    @foreach (var grade in jobGrades)
                    {
                        <div class="hr-card" style="padding:var(--s-4);border:1px solid color-mix(in srgb, var(--series-1) 40%, var(--line));">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:var(--s-3);padding-block-end:var(--s-2);border-block-end:1px solid var(--line);flex-wrap:wrap;gap:var(--s-2);">
                                <div>
                                    <strong style="font-size:var(--fs-title);color:var(--text);display:block;">@grade.GradeName</strong>
                                    <span class="hr-meta">@grade.JobTitles.Count عنوان وظيفي</span>
                                </div>
                                <span class="hr-badge hr-badge-accent hr-num" style="font-size:var(--fs-body);padding:4px 10px;">
                                    @grade.TotalEmployees موظف
                                </span>
                            </div>

                            <div style="display:flex;flex-direction:column;gap:var(--s-2);">
                                @foreach (var jt in grade.JobTitles.Take(6))
                                {
                                    <div style="display:flex;flex-direction:column;gap:4px;padding:6px 8px;background:var(--surface-sunken);border-radius:var(--r-xs);border:1px solid var(--line-soft);">
                                        <div style="display:flex;align-items:center;justify-content:space-between;font-size:var(--fs-caption);flex-wrap:wrap;gap:var(--s-2);">
                                            <strong style="color:var(--text);">@jt.JobTitleName</strong>
                                            <span class="hr-num hr-badge" style="background:var(--surface);padding:1px 6px;border-radius:var(--r-full);border:1px solid var(--line);font-size:var(--fs-caption);">
                                                @jt.EmployeesCount
                                            </span>
                                        </div>
                                        @if (jt.SampleEmployees.Count > 0)
                                        {
                                            <div style="display:flex;align-items:center;gap:4px;margin-block-start:2px;flex-wrap:wrap;">
                                                @foreach (var sample in jt.SampleEmployees.Take(4))
                                                {
                                                    <div style="display:inline-flex;align-items:center;gap:4px;background:var(--surface);padding:2px 6px;border-radius:var(--r-full);border:1px solid var(--line);font-size:var(--fs-caption);" title="@sample.Name (@sample.EmployeeID)">
                                                        <UserAvatar EmployeeId="@sample.EmployeeID" UserName="@sample.Name" Size="xs" />
                                                        <span style="max-width:85px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@sample.Name</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (grade.JobTitles.Count > 6)
                                {
                                    <span class="hr-meta" style="font-size:var(--fs-caption);text-align:center;">+ @(grade.JobTitles.Count - 6) عناوين وظيفية أخرى</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* TAB 3: SUMMARY GRID *@
        @if (activeTab == "grid")
        {
            <div class="hr-card" style="overflow:hidden;">
                <div class="hr-card-head" style="padding:var(--s-4);border-block-end:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                    <div>
                        <h2 class="hr-h2" style="margin:0;">دليل وحدات وتشكيلات شجرة الهيكل الوظيفي</h2>
                        <span class="hr-meta">كافة التشكيلات المعرفة في الشجرة مع مسؤوليها وكوادرها</span>
                    </div>
                    <span class="hr-badge hr-badge-ok">@GetAllTreeNodesFlat(treeRoot).Count وحدة مسجلة</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="hr-table" style="width:100%;font-size:var(--fs-body);">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">اسم التشكيل / الوحدة</th>
                                <th scope="col">نوع الوحدة</th>
                                <th scope="col">المسؤول / المدير المكلف</th>
                                <th scope="col">عنوان المنصب</th>
                                <th scope="col" style="text-align:center;">إجمالي الكادر</th>
                                <th scope="col" style="text-align:center;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ 
                                int rowIdx = 1; 
                                var flatNodes = GetAllTreeNodesFlat(treeRoot);
                            }
                            @if (flatNodes.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" style="text-align:center;padding:var(--s-6);color:var(--text-3);">
                                        لا توجد وحدات معرفة في شجرة الهيكل الوظيفي حالياً.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var form in flatNodes)
                                {
                                    <tr>
                                        <td class="hr-num" style="color:var(--text-3);">@(rowIdx++)</td>
                                        <td>
                                            <strong style="color:var(--text);">@form.Title</strong>
                                            <span class="hr-meta hr-num" style="display:block;font-size:var(--fs-caption);">@(form.Code ?? "-")</span>
                                        </td>
                                        <td>
                                            <span class="hr-badge" style="background:var(--surface-sunken);font-size:var(--fs-caption);">@form.Category</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(form.LeaderName))
                                            {
                                                <div style="display:flex;align-items:center;gap:8px;">
                                                    <UserAvatar EmployeeId="@form.LeaderEmployeeId" UserName="@form.LeaderName" Size="sm" />
                                                    <div>
                                                        <strong style="color:var(--text);display:block;font-size:var(--fs-control);">@form.LeaderName</strong>
                                                        @if (!string.IsNullOrEmpty(form.LeaderEmployeeId))
                                                        {
                                                            <span class="hr-meta hr-num" style="font-size:var(--fs-caption);">الرقم: @form.LeaderEmployeeId</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="display:flex;align-items:center;gap:6px;">
                                                    <UserAvatar EmployeeId="" UserName="شاغر" Size="xs" />
                                                    <span class="hr-meta">قيد التكليف / غير مخصص</span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="hr-meta" style="font-weight:600;">@(form.LeaderTitle ?? "المسؤول")</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <span class="hr-badge hr-badge-accent hr-num" style="font-size:var(--fs-label);padding:2px 8px;">
                                                @form.TotalEmployeesCount
                                            </span>
                                        </td>
