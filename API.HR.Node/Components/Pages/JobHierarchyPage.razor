                                @onclick:stopPropagation="true" 
                                @onclick="() => ToggleCollapse(node.Id)">
                            <Icon Name="@(isCollapsed ? "plus" : "minus")" Size="xs" />
                            <span>@(isCollapsed ? $"إظهار ({node.Children.Count})" : "طي")</span>
                        </button>
