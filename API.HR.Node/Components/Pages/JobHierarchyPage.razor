            </div>
        </div>
    };

    private RenderFragment RenderOrgNode(JobHierarchyNodeDto node) => __builder =>
    {
        var isCollapsed = collapsedNodeIds.Contains(node.Id);
        var hasChildren = node.Children.Count > 0;

        <div class="hr-org-node-container">
            
            @RenderCard(node, false)

            @* CHILDREN & CONNECTING BRANCHES *@
            @if (hasChildren && !isCollapsed)
            {
                var isAllChildrenLeaves = node.Children.Count > 0 && node.Children.All(c => c.Children.Count == 0);
                var renderAsVerticalStack = isCompactLeafLayout && isAllChildrenLeaves && node.Children.Count > 1;

                @* Vertical stem from parent down to branches *@
                <div style="width:2px; height:24px; background:var(--line);"></div>

                @if (renderAsVerticalStack)
                {
                    @* COMPACT VERTICAL STACK (الاقسام تظهر واحدة جوة الاخرى اذا مبيهه فروع علمود يوازي عرض الشاشة) *@
                    <div class="hr-org-leaf-stack">
                        @for (int i = 0; i < node.Children.Count; i++)
                        {
                            var child = node.Children[i];
                            var isFirst = i == 0;
                            var isLast = i == node.Children.Count - 1;

                            <div style="position:relative; display:flex; align-items:flex-start;">
                                @* Vertical trunk line segment along side *@
                                <div style="position:absolute; inset-inline-start:-36px; width:2px; background:var(--line);
                                            top: 0;
                                            bottom: @(isLast ? "calc(100% - 24px)" : "0");"></div>

                                @* Top horizontal connector from parent stem to vertical trunk line (first card only) *@
                                @if (isFirst)
                                {
                                    <div style="position:absolute; inset-inline-start:-36px; top:0; width:calc(50% + 36px); height:2px; background:var(--line);"></div>
                                }

                                @* Horizontal branch line entering card header *@
                                <div style="position:absolute; inset-inline-start:-36px; top:24px; width:36px; height:2px; background:var(--line);"></div>

                                @RenderCard(child, isVertical: true)
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* CONTINUOUS HORIZONTAL CONNECTING TREE *@
                    <div class="hr-org-children">
                        @for (int i = 0; i < node.Children.Count; i++)
                        {
                            var child = node.Children[i];
                            var isFirst = i == 0;
                            var isLast = i == node.Children.Count - 1;
                            var isSingle = node.Children.Count == 1;

                            <div class="hr-org-child-col">
                                @* Continuous Horizontal Line across siblings *@
                                @if (!isSingle)
                                {
                                    @if (isFirst)
                                    {
                                        <div style="position:absolute; top:0; left:0; right:50%; height:2px; background:var(--line);"></div>
                                    }
                                    else if (isLast)
                                    {
                                        <div style="position:absolute; top:0; left:50%; right:0; height:2px; background:var(--line);"></div>
                                    }
                                    else
                                    {
                                        <div style="position:absolute; top:0; left:0; right:0; height:2px; background:var(--line);"></div>
                                    }
                                }

                                @* Vertical drop line into child *@
                                <div style="width:2px; height:20px; background:var(--line);"></div>

                                @RenderOrgNode(child)
                            </div>
                        }
                    </div>
                }
            }
        </div>
    };
}

@* ==================== CODE LOGIC ==================== *@
@code {
    private bool isLoading = true;
    private bool isCompactLeafLayout = true;
    private string activeTab = "chart"; // "chart", "grades", "grid"
    private string searchQuery = string.Empty;
    private string drawerSearch = string.Empty;
    private double zoomLevel = 0.95;

    private string? syncMessage;
    private JobHierarchyOverviewStatsDto? overviewStats;
    private JobHierarchyNodeDto? treeRoot;
    private List<JobGradeHierarchyDto> jobGrades = new();
    private HashSet<string> collapsedNodeIds = new();
    private JobHierarchyNodeDto? selectedDrawerNode;
    private DotNetObjectReference<JobHierarchyPage>? dotNetRef;

    private void ToggleLayoutMode()
    {
        isCompactLeafLayout = !isCompactLeafLayout;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            overviewStats = await JobHierarchyService.GetOverviewStatsAsync();
            treeRoot = await JobHierarchyService.GetOrgChartTreeAsync();
            jobGrades = await JobHierarchyService.GetJobGradesHierarchyAsync();

            // Default: keep sectors expanded, collapse large sub-branches if needed
            collapsedNodeIds.Clear();
        }
        catch (Exception ex)
        {
            syncMessage = $"حدث خطأ أثناء تحميل الهيكل: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReloadDataAsync()
    {
        syncMessage = null;
        await LoadDataAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void ToggleCollapse(string nodeId)
    {
        if (collapsedNodeIds.Contains(nodeId))
            collapsedNodeIds.Remove(nodeId);
        else
            collapsedNodeIds.Add(nodeId);
    }

    private void ExpandAll()
    {
        collapsedNodeIds.Clear();
    }

    private void CollapseAll()
    {
        if (treeRoot != null)
        {
            collapsedNodeIds.Clear();
            AddCollapsedRecursive(treeRoot);
        }
    }

    private void AddCollapsedRecursive(JobHierarchyNodeDto node)
    {
        if (node.Children.Count > 0)
        {
            collapsedNodeIds.Add(node.Id);
            foreach (var child in node.Children)
            {
                AddCollapsedRecursive(child);
            }
        }
    }

    private List<JobHierarchyNodeDto> GetAllTreeNodesFlat(JobHierarchyNodeDto? root)
    {
        var result = new List<JobHierarchyNodeDto>();
        if (root == null || root.Id == "empty-tree") return result;

        void Traverse(JobHierarchyNodeDto node)
        {
            if (node.Id != "cbi-umbrella-root")
            {
                result.Add(node);
            }
            foreach (var child in node.Children)
            {
                Traverse(child);
            }
        }

        Traverse(root);
        return result;
    }

    private void ZoomIn()
    {
        if (zoomLevel < 1.6)
            zoomLevel = Math.Round(zoomLevel + 0.1, 2);
    }

    private void ZoomOut()
    {
        if (zoomLevel > 0.4)
            zoomLevel = Math.Round(zoomLevel - 0.1, 2);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeTab == "chart" && treeRoot != null && treeRoot.Id != "empty-tree")
        {
            try
            {
                dotNetRef ??= DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("hrLoadScript", Assets["js/hr-orgchart.js"]);
                await JSRuntime.InvokeVoidAsync("hrOrgChart.init", "hr-orgchart-viewport", "hr-orgchart-canvas", dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void ResetZoom()
    {
        zoomLevel = 0.95;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnJsWheelZoom(double delta)
    {
        zoomLevel = Math.Round(Math.Clamp(zoomLevel + delta, 0.35, 2.0), 2);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("hrOrgChart.destroy", "hr-orgchart-viewport");
        }
        catch { }
        dotNetRef?.Dispose();
    }

    private void OpenUnitDrawer(JobHierarchyNodeDto node)
    {
        selectedDrawerNode = node;
        drawerSearch = string.Empty;
    }

    private void CloseDrawer()
    {
        selectedDrawerNode = null;
    }

    // Escape is the expected way out of any dismissible overlay.
    private void OnDrawerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseDrawer();
    }

    private async Task PrintOrgChart()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static double CalculateGenderPct(List<JobHierarchyEmployeeItemDto> emps, string match)
    {
        if (emps.Count == 0) return 0;
        var count = emps.Count(e => e.Gender != null && e.Gender.Contains(match, StringComparison.OrdinalIgnoreCase));
        return Math.Round((double)count / emps.Count * 100, 1);
    }
}
