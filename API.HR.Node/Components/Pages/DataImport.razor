    @* ================= TAB 8: ALLOWANCES (المخصصات المالية والبدلات) ================= *@
    @if (activeTab == ImportTab.BankingAllowances)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="banknotes" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتحديث المخصصات المالية والبدلات</h2>
                        <p class="hr-meta">
