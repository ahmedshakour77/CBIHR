                        <Icon Name="briefcase" Size="xs" />
                        <span>5. مخصصات عدم مزاولة مهنة</span>
                    </button>
                    <button type="button" class="hr-btn @(allowanceSubTab == AllowanceSubTab.CraftAndSocial ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
