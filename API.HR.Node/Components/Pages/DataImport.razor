                                            <th scope="col" style="text-align: center;">محتسب للترفيع</th>
                                            <th scope="col" style="text-align: center;">محتسب للتقاعد</th>
                                            <th scope="col">ملاحظات</th>
                                        </tr>
                                    </thead>
