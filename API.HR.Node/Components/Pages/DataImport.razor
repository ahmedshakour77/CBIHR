                                                <td>@(row.Type ?? "—")</td>
                                                <td>@(row.LetterNumber ?? "—")</td>
                                                <td class="hr-meta">@(row.Notes ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div style="display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
                                @if (isImporting)
                                {
                                    <div class="hr-busy" role="status">
                                        <span class="hr-spinner" aria-hidden="true"></span>
                                        <span>جارٍ حفظ كتب الشكر بقاعدة البيانات…</span>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteLettersImport" disabled="@letterParseResult.HasErrors">
