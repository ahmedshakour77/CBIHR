                    <Icon Name="identification" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استكمال وتحديث بيانات البطاقة الموحدة (ترميم السجلات)</h2>
                        <p class="hr-meta">
                            تحديث وإثراء قيود الموظفين الحالية (الرقم الوطني للبطاقة الموحدة، الرقم الوظيفي الموحد، اسم الأم، الاسم الرباعي) عبر مطابقة رقم الموظف تلقائياً
                        </p>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <span class="hr-badge">تعديل بالربط على رقم الموظف</span>
                    <a href="/api/import/template/civil-data" target="_blank" class="hr-btn hr-btn-secondary hr-btn-sm">
                        <Icon Name="arrow-down-tray" Size="xs" />
                        <span>تحميل القالب المعتمد</span>
                    </a>
                </div>
            </div>

            <div class="hr-card-body">
                @* Upload Dropzone *@
                <div class="hr-dropzone hr-dropzone--plain" style="margin-block-end: var(--s-6)">
                    <div style="margin-bottom: 1rem;">
                        <Icon Name="arrow-up-tray" Size="xl" Class="hr-text-copper" />
                    </div>
                    <h3 style="margin-bottom: 0.5rem; font-weight: 700;">اختر أو اسحب ملف Excel (.xlsx) لاستكمال بيانات الهوية والبطاقة الموحدة</h3>
                    <p class="hr-meta" style="margin-bottom: 1rem; max-width: 44rem; margin-inline: auto;">
                        يقوم النظام بمطابقة رقم الموظف وتعديل الحقول المضافة تلقائياً (الرقم الوطني، الرقم الوظيفي الموحد، اسم الأم، تفاصيل الاسم الرباعي)، مع إهمال الأعمدة الثانوية (التشكيل، التولد، التعيين، الجنس، حالة الموظف).
                    </p>

                    <label class="hr-btn hr-btn-primary" style="cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <Icon Name="document-arrow-up" Size="sm" />
                        <span>اختيار ملف إكسل</span>
                        <InputFile OnChange="HandleCivilDataFileSelected" accept=".xlsx,.xlsm" style="display: none;" />
                    </label>

                    @if (isParsing)
                    {
                        <div class="hr-busy" role="status" style="display: flex; justify-content: center; margin-block-start: var(--s-4)">
                            <span class="hr-spinner hr-spinner-xs"></span>
                            <span>جارٍ قراءة وفحص أعمدة الملف...</span>
                        </div>
                    }
                </div>

                @* Parsing Errors *@
                @if (civilDataParseResult?.HasErrors == true)
                {
                    <div class="hr-alert hr-alert-danger" style="margin-bottom: 1.5rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                            <Icon Name="exclamation-circle" Size="md" />
                            <strong>تم العثور على أخطاء في ملف البيانات تمنع الاستيراد:</strong>
                        </div>
                        <ul style="margin: 0; padding-inline-start: 1.5rem;">
                            @foreach (var err in civilDataParseResult.ParseErrors.Take(10))
                            {
                                <li>@err.Message (الحقل: @err.Field)</li>
                            }
                            @if (civilDataParseResult.ParseErrors.Count > 10)
                            {
                                <li>... وهناك @(civilDataParseResult.ParseErrors.Count - 10) أخطاء إضافية.</li>
                            }
                        </ul>
                    </div>
                }

                @* Preview & Mapping *@
                @if (civilDataParseResult != null && !civilDataParseResult.HasErrors)
                {
                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                            <div>
                                <h3 style="font-weight: 700; margin: 0; font-size: var(--fs-title);">
                                    معاينة البيانات المستخرجة (@civilDataParseResult.Rows.Count سجل)
                                </h3>
                                <p class="hr-meta" style="margin: 0;">الأعمدة المستهدفة بالتحديث تم تمييزها بنجاح</p>
                            </div>
                        </div>

                        @* Column Mapping Summary *@
                        <div class="hr-card hr-card-quiet" style="padding: 1rem; margin-bottom: 1rem; border-radius:var(--r-md);">
                            <div style="font-weight: 700; font-size: var(--fs-label); margin-bottom: 0.5rem;">حالة تحليل الأعمدة في الملف:</div>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
                                <span class="hr-meta" style="font-size: var(--fs-label); margin-inline-end: 0.5rem;">الأعمدة المطابقة للتعديل:</span>
                                @foreach (var h in civilDataParseResult.MatchedHeaders)
                                {
                                    <span class="hr-badge hr-badge-ok">@h (يعدل)</span>
                                }
                                @if (civilDataParseResult.UnmappedHeaders.Count > 0)
                                {
                                    <span class="hr-meta" style="font-size: var(--fs-label); margin-inline-start: 0.75rem; margin-inline-end: 0.5rem;">الأعمدة المهملة:</span>
                                    @foreach (var uh in civilDataParseResult.UnmappedHeaders)
                                    {
                                        <span class="hr-badge" style="opacity: 0.75;">@uh (يهمل)</span>
                                    }
                                }
                            </div>
                        </div>

                        @* Preview Table *@
                        <div class="hr-tablewrap" style="max-height: 22rem; overflow-y: auto;">
                            <table class="hr-table hr-table-compact">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">رقم الموظف (الربط)</th>
                                        <th scope="col">الاسم الكامل (معاينة)</th>
                                        <th scope="col">الرقم الوطني (البطاقة الموحدة)</th>
                                        <th scope="col">الرقم الوظيفي الموحد</th>
                                        <th scope="col">اسم الأم</th>
                                        <th scope="col">الاسم الأول</th>
                                        <th scope="col">الاسم الثاني</th>
                                        <th scope="col">الاسم الثالث</th>
                                        <th scope="col">الاسم الرابع</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rowIdx = 1; }
                                    @foreach (var row in civilDataParseResult.Rows.Take(50))
                                    {
                                        <tr>
                                            <td>@(rowIdx++)</td>
                                            <td><span class="hr-num hr-cell-strong">@row.EmployeeID</span></td>
                                            <td>@(row.FullName ?? "—")</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.NationalId))
                                                {
                                                    <span class="hr-badge hr-badge-ok hr-num">@row.NationalId</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.UnifiedEmployeeNumber))
                                                {
                                                    <span class="hr-badge hr-num">@row.UnifiedEmployeeNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>@(row.MotherName ?? "—")</td>
                                            <td>@(row.FirstName ?? "—")</td>
                                            <td>@(row.SecondName ?? "—")</td>
                                            <td>@(row.ThirdName ?? "—")</td>
                                            <td>@(row.FourthName ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (civilDataParseResult.Rows.Count > 50)
                        {
                            <p class="hr-meta" style="margin-top: 0.5rem; text-align: center;">
                                يتم عرض أول 50 صفاً من أصل @civilDataParseResult.Rows.Count صفاً متوفراً للاستيراد والتحديث.
                            </p>
                        }

                        @* Action Bar *@
                        <div class="hr-result__actions">
                            <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteCivilDataImport" disabled="@isImporting">
                                @if (isImporting)
                                {
                                    <span class="hr-spinner hr-spinner-xs"></span>
                                    <span>جارٍ تعديل وتحديث بيانات الموظفين...</span>
                                }
                                else
                                {
                                    <Icon Name="check-badge" Size="sm" />
                                    <span>تأكيد وبدء تحديث (@civilDataParseResult.Rows.Count) سجل موظف</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                @* Results Card *@
                @if (civilDataImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status">
                        <div class="hr-card-body">
                            <div class="hr-result__head">
                                <Icon Name="check-circle" Size="lg" />
                                <h3 class="hr-result__title">تم إنجاز تحديث واستكمال بيانات البطاقة الموحدة بنجاح!</h3>
                            </div>
                            <div class="hr-result__grid">
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">إجمالي الصفوف المعالجة</div>
                                    <div class="hr-result__value">@civilDataImportResponse.TotalRows</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">سجلات الموظفين المحدثة</div>
                                    <div class="hr-result__value hr-result__value--ok">@civilDataImportResponse.Updated</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">سجلات متخطاة (بدون تغيير / غير متوفر)</div>
                                    <div class="hr-result__value @(civilDataImportResponse.Skipped > 0 ? "hr-result__value--warn" : "")">@civilDataImportResponse.Skipped</div>
                                </div>
                            </div>

                            @if (civilDataImportResponse.MissingEmployeeIDs.Count > 0)
                            {
                                <div class="hr-alert hr-alert-warn" style="margin-top: 1rem;">
                                    <strong>الأرقام الوظيفية غير المسجلة مسبقاً في النظام ولم يتم العثور عليها لتحديثها:</strong>
                                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem;">
                                        @foreach (var id in civilDataImportResponse.MissingEmployeeIDs)
                                        {
                                            <span class="hr-badge hr-badge-danger">@id</span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="hr-result__actions">
                                <a href="/employees" class="hr-btn hr-btn-primary">
                                    <Icon Name="users" Size="sm" />
                                    <span>الانتقال لسجلات ودليل الموظفين</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 7: EMAIL ACCOUNTS ================= *@
    @if (activeTab == ImportTab.EmailAccounts)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="envelope" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتحديث البريد الإلكتروني المؤسسي والحسابات</h2>
                        <p class="hr-meta">
                            استيراد ملف يحتوي على (الرقم الوظيفي، اسم الموظف، البريد الإلكتروني). المطابق لا يُعدَّل، ويتم تحديث المتغيرات أو إضافة السجلات الجديدة وقائمة التصريح تلقائياً (@@cbi.iq / @@aml.lan).
                        </p>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
