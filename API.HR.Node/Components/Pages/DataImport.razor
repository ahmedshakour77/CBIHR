                @if (martyrsParseResult != null)
                {
                    <div class="hr-preview" style="margin-top: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;flex-wrap:wrap;gap:var(--s-2);">
                            <h3 class="hr-h4">معاينة بيانات ذوي الشهداء قبل التثبيت</h3>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="CancelMartyrsPreview">
                                إلغاء المعاينة
                            </button>
                        </div>

                        <div class="hr-stat-grid">
                            <div class="hr-stat-card">
                                <span class="hr-meta">إجمالي السجلات بالملف</span>
                                <strong class="hr-stat-val">@martyrsParseResult.TotalRows</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--ok">
                                <span class="hr-meta">صالحة ومطابقة للربط</span>
                                <strong class="hr-stat-val">@martyrsParseResult.ValidRows</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--danger">
                                <span class="hr-meta">أخطاء أو أرقام غير موجودة</span>
                                <strong class="hr-stat-val">@martyrsParseResult.InvalidRows</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--warn">
                                <span class="hr-meta">مسجلة مسبقاً لنفس الموظف</span>
                                <strong class="hr-stat-val">@martyrsParseResult.DuplicateOrExistingRows</strong>
                            </div>
                        </div>

                        <div class="hr-tablewrap" style="max-height: 480px; overflow-y: auto;">
                            <table class="hr-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">الرقم الوظيفي</th>
                                        <th scope="col">اسم الموظف المطابق</th>
                                        <th scope="col">اسم الشهيد</th>
                                        <th scope="col">نوع الشهادة</th>
                                        <th scope="col">الصلة</th>
                                        <th scope="col">رقم القرار</th>
                                        <th scope="col">حالة السطر</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in martyrsParseResult.Rows)
                                    {
                                        <tr class="@(!r.IsValid ? "hr-row-error" : (r.IsAlreadyRegistered ? "hr-row-warning" : ""))">
                                            <td>@r.RowIndex</td>
                                            <td><span class="hr-num hr-cell-strong">@r.EmployeeIdNumber</span></td>
                                            <td>
                                                @if (r.EmployeeExists)
                                                {
                                                    <span>@r.MatchedEmployeeName</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-danger">غير مسجل بالمنظومة</span>
                                                }
                                            </td>
                                            <td><strong>@r.MartyrName</strong></td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(r.MartyrdomType))
                                                {
                                                    <span class="hr-badge hr-badge-accent">@r.MartyrdomType</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(r.Kinship))
                                                {
                                                    <span class="hr-badge" style="background: var(--surface-sunken); font-weight: 600;">@r.Kinship</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(r.DecisionNumber))
                                                {
                                                    <span class="hr-num">@r.DecisionNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!r.IsValid)
                                                {
                                                    <span class="hr-badge hr-badge-danger">@r.ErrorMessage</span>
                                                }
                                                else if (r.IsAlreadyRegistered)
                                                {
                                                    <span class="hr-badge hr-badge-warn">مسجل مسبقاً لنفس الموظف</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-ok">جاهز للتثبيت</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteMartyrsImport" disabled="@(isImporting || martyrsParseResult.ValidRows == 0)">
                                <Icon Name="check-circle" Size="sm" />
                                <span>تنفيذ تثبيت ذوي الشهداء (@martyrsParseResult.ValidRows سجل)</span>
                            </button>
                        </div>
                    </div>
                }

                @if (martyrsImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status" style="margin-top: 1rem;">
                        <div class="hr-card-body">
                            <h4 style="margin: 0 0 0.5rem 0; color: var(--ok); font-weight: 700;">اكتملت العملية بنجاح</h4>
                            @foreach (var m in martyrsImportResponse.Messages)
                            {
                                <p class="hr-meta">@m</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 12: FINANCIAL ACCOUNTS (البيانات المالية والرصيد والقروض والسلف) ================= *@
    @if (activeTab == ImportTab.FinancialAccounts)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="banknotes" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتحديث البيانات المالية (الرصيد، القروض، السلف)</h2>
                        <p class="hr-meta">تحديث الرصيد المالي الحالي، متبقي القروض، ومتبقي السلف للموظفين مع حفظ الحركات والتواريخ تلقائياً</p>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <a href="/api/import/template/financial-accounts" target="_blank" class="hr-btn hr-btn-secondary hr-btn-sm">
                        <Icon Name="arrow-down-tray" Size="xs" />
                        <span>تحميل القالب المعتمد</span>
                    </a>
                    <span class="hr-badge">تحديث مباشر للحساب المالي</span>
                </div>
            </div>

            <div class="hr-card-body">
                <div class="hr-dropzone @(isParsing ? "is-busy" : "")">
                    <div class="hr-dropzone__icon" aria-hidden="true">
                        <Icon Name="arrow-up-tray" Size="lg" />
                    </div>
                    <h3 class="hr-dropzone__title">اختر ملف Excel (.xlsx) للبيانات المالية</h3>
                    <p class="hr-meta hr-dropzone__hint">اسحب الملف هنا أو اضغط للاختيار من جهازك (الأعمدة: الرقم الوظيفي، اسم الموظف، الرصيد المالي، متبقي القرض، متبقي السلفة، الملاحظات)</p>

                    <InputFile OnChange="HandleFinancialAccountsFileSelected" accept=".xlsx,.xlsm" class="hr-dropzone__input" />

                    @if (isParsing)
                    {
                        <div class="hr-dropzone__busy">
                            <span class="hr-spinner" aria-hidden="true"></span>
                            <span>جارٍ فحص وتحليل ملف البيانات المالية ومطابقة أرقام الموظفين…</span>
                        </div>
                    }
                </div>

                @if (financialParseResult != null)
                {
                    <div class="hr-preview" style="margin-top: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;flex-wrap:wrap;gap:var(--s-2);">
                            <h3 class="hr-h4">معاينة البيانات المالية قبل التثبيت في النظام</h3>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="CancelFinancialAccountsPreview">
                                إلغاء المعاينة
                            </button>
                        </div>

                        <div class="hr-stat-grid">
                            <div class="hr-stat-card">
                                <span class="hr-meta">إجمالي السجلات المقروءة</span>
                                <strong class="hr-stat-val">@financialParseResult.Rows.Count</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--ok">
                                <span class="hr-meta">سجلات تتضمن رصيد</span>
                                <strong class="hr-stat-val">
                                    @financialParseResult.Rows.Count(r => r.Balance.HasValue)
                                </strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--accent">
                                <span class="hr-meta">سجلات تتضمن متبقي قروض</span>
                                <strong class="hr-stat-val">
                                    @financialParseResult.Rows.Count(r => r.LoanRemaining.HasValue)
                                </strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--warn">
                                <span class="hr-meta">سجلات تتضمن متبقي سلف</span>
                                <strong class="hr-stat-val">
                                    @financialParseResult.Rows.Count(r => r.AdvanceRemaining.HasValue)
                                </strong>
                            </div>
                        </div>

                        @if (financialParseResult.ParseErrors.Count > 0)
                        {
                            <div class="hr-alert hr-alert-danger" style="margin-bottom: 1rem;">
                                <strong>تنبيهات الفحص:</strong>
                                <ul style="margin: 0.5rem 0 0 1.5rem; padding: 0;">
                                    @foreach (var err in financialParseResult.ParseErrors)
                                    {
                                        <li>@err.Message (الصف @err.Row)</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="hr-tablewrap" style="max-height: 480px; overflow-y: auto;">
                            <table class="hr-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">الرقم الوظيفي</th>
                                        <th scope="col">اسم الموظف</th>
                                        <th scope="col">الرصيد المالي</th>
                                        <th scope="col">متبقي القرض</th>
                                        <th scope="col">متبقي السلفة</th>
                                        <th scope="col">الملاحظات والبيان</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var fRowIdx = 1; }
                                    @foreach (var row in financialParseResult.Rows)
                                    {
                                        <tr>
                                            <td>@fRowIdx</td>
                                            <td><span class="hr-num hr-cell-strong">@row.EmployeeID</span></td>
                                            <td>@(row.EmployeeName ?? "—")</td>
                                            <td>
                                                @if (row.Balance.HasValue)
                                                {
                                                    <span class="hr-num hr-cell-strong" style="color:var(--ok);">@row.Balance.Value.ToString("N0") د.ع</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (row.LoanRemaining.HasValue)
                                                {
                                                    <span class="hr-num" style="color: var(--accent-text);">@row.LoanRemaining.Value.ToString("N0") د.ع</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (row.AdvanceRemaining.HasValue)
                                                {
                                                    <span class="hr-num" style="color:var(--warn);">@row.AdvanceRemaining.Value.ToString("N0") د.ع</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">—</span>
                                                }
                                            </td>
                                            <td>@(row.Notes ?? "—")</td>
                                        </tr>
                                        fRowIdx++;
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
                            <button type="button" class="hr-btn hr-btn-secondary" @onclick="CancelFinancialAccountsPreview" disabled="@isImporting">
                                إلغاء
                            </button>
                            <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteFinancialAccountsImport" disabled="@isImporting">
                                @if (isImporting)
                                {
                                    <span class="hr-spinner hr-spinner-xs" aria-hidden="true"></span>
                                    <span>جارٍ تحديث الحسابات المالية…</span>
                                }
                                else
                                {
                                    <Icon Name="check" Size="sm" />
                                    <span>تأكيد واستيراد البيانات المالية (@financialParseResult.Rows.Count سجل)</span>
                                }
                            </button>
                        </div>
                    </div>
                }

                @if (financialImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status" style="margin-top: 1rem;">
                        <div class="hr-card-body">
                            <h4 style="margin: 0 0 0.5rem 0; color: var(--ok); font-weight: 700;">اكتمل استيراد البيانات المالية بنجاح</h4>
                            <p class="hr-meta">
                                تم تحديث بيانات <strong>@financialImportResponse.Updated</strong> موظفاً بنجاح.
                                @if (financialImportResponse.Skipped > 0)
                                {
                                    <span> تم تخطي <strong>@financialImportResponse.Skipped</strong> سجلاً لعدم العثور على أرقامهم الوظيفية.</span>
                                }
                            </p>
                            @if (financialImportResponse.MissingEmployeeIDs.Count > 0)
                            {
                                <div class="hr-alert hr-alert-warn" style="margin-top: 0.75rem;">
                                    <span>أرقام وظيفية لم يتم العثور عليها: </span>
                                    <span>@string.Join("، ", financialImportResponse.MissingEmployeeIDs.Take(20))</span>
                                    @if (financialImportResponse.MissingEmployeeIDs.Count > 20)
                                    {
                                        <span> … وغيرهم</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 13: JOB TITLES & CLASSIFICATION (العناوين والعوائل والدرجات الوظيفية) ================= *@
    @if (activeTab == ImportTab.JobTitles)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="identification" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتصنيف العناوين والعوائل الوظيفية</h2>
                        <p class="hr-meta">استيراد وتحديث قاموس وتصنيف العناوين الوظيفية مع الرمز والعائلة الوظيفية والدرجة المعتمدة</p>
                    </div>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <a href="/api/import/template/job-titles" target="_blank" class="hr-btn hr-btn-secondary hr-btn-sm">
                        <Icon Name="arrow-down-tray" Size="xs" />
                        <span>تحميل القالب المعتمد</span>
                    </a>
                    <span class="hr-badge">تحديث قاموس العناوين</span>
                </div>
            </div>

            <div class="hr-card-body">
                <div class="hr-dropzone @(isParsing ? "is-busy" : "")">
                    <div class="hr-dropzone__icon" aria-hidden="true">
                        <Icon Name="arrow-up-tray" Size="lg" />
                    </div>
                    <h3 class="hr-dropzone__title">اختر ملف Excel (.xlsx) للعناوين الوظيفية</h3>
                    <p class="hr-meta hr-dropzone__hint">اسحب الملف هنا أو اضغط للاختيار من جهازك (الأعمدة المطلوبة: الرمز، العائلة الوظيفية، العنوان الوظيفي، الدرجة الوظيفية)</p>

                    <InputFile OnChange="HandleJobTitlesFileSelected" accept=".xlsx,.xlsm" class="hr-dropzone__input" />

                    @if (isParsing)
                    {
                        <div class="hr-dropzone__busy">
                            <span class="hr-spinner" aria-hidden="true"></span>
                            <span>جارٍ فحص وتحليل ملف العناوين ومطابقة الأسماء…</span>
