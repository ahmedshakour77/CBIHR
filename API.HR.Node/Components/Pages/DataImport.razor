                            <Icon Name="exclamation-circle" Size="md" />
                            <strong>تم العثور على أخطاء في ملف البيانات تمنع الاستيراد:</strong>
                        </div>
                        <ul style="margin: 0; padding-inline-start: 1.5rem;">
                            @foreach (var err in emailAccountsParseResult.ParseErrors.Take(10))
                            {
                                <li>@err.Message (الحقل: @err.Field)</li>
                            }
                            @if (emailAccountsParseResult.ParseErrors.Count > 10)
                            {
                                <li>... وهناك @(emailAccountsParseResult.ParseErrors.Count - 10) أخطاء إضافية.</li>
                            }
                        </ul>
                    </div>
                }

                @* Preview & Mapping *@
                @if (emailAccountsParseResult != null && !emailAccountsParseResult.HasErrors)
                {
