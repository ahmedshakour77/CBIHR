@page "/data-import"
@page "/import"
@using API.HR.Node.Contracts
@using API.HR.Node.Services.Import
@using API.HR.Node.Services.Localization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,HRManager,FormationManager,Supervisor")]
@rendermode InteractiveServer
@inject IExcelImportService ImportService
@inject IToastService Toast
@inject ILanguageService Lang
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>استيراد البيانات من Excel | منظومة الموارد البشرية</PageTitle>

<div class="hr-stack">
    @* Page Header *@
    <header class="hr-pagehead">
            <div class="hr-pagehead-titles">
                <h1 class="hr-h1">مركز استيراد البيانات (Excel Data Import)</h1>
                <p class="hr-sub hr-measure" style="margin-block-start: var(--s-2)">
                    استيراد وتحديث جماعي لسجلات الموظفين، كتب الشكر والتقدير، وإجازات الموظفين عبر ملفات Excel الرسمية
                </p>
            </div>
            <div class="hr-pagehead-actions" aria-label="قوالب Excel الفارغة" role="group">
                <a href="/api/import/template/employees" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لسجلات الموظفين">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب الموظفين (.xlsx)</span>
                </a>
                <a href="/api/import/template/appreciation-letters" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لكتب الشكر">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب كتب الشكر (.xlsx)</span>
                </a>
                <a href="/api/import/template/leaves" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لإجازات الموظفين">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب الإجازات (.xlsx)</span>
                </a>
                <a href="/api/import/template/leave-balances" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لأرصدة الإجازات المتبقية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب أرصدة الإجازات (.xlsx)</span>
                </a>
                <a href="/api/import/template/career-movements" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لحركات الخدمة والتنقلات">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب التنقلات والخدمة (.xlsx)</span>
                </a>
                <a href="/api/import/template/courses" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للدورات التدريبية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب الدورات (.xlsx)</span>
                </a>
                <a href="/api/import/template/civil-data" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لاستكمال بيانات البطاقة الموحدة">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب البطاقة الموحدة (.xlsx)</span>
                </a>
                <a href="/api/import/template/email-accounts" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للبريد المؤسسي والحسابات">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب البريد المؤسسي (.xlsx)</span>
                </a>
                <a href="/api/import/template/banking-allowances" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للمخصصات المصرفية والمسؤولية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب المخصصات المصرفية (.xlsx)</span>
                </a>
                <a href="/api/import/template/engineering-allowances" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للمخصصات الهندسية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب المخصصات الهندسية (.xlsx)</span>
                </a>
                <a href="/api/import/template/legal-allowances" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للمخصصات القانونية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب المخصصات القانونية (.xlsx)</span>
                </a>
                <a href="/api/import/template/certificate-allowances" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لمخصصات الشهادة">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب مخصصات الشهادة (.xlsx)</span>
                </a>
                <a href="/api/import/template/penalties" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ للعقوبات الانضباطية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب العقوبات (.xlsx)</span>
                </a>
                <a href="/api/import/template/martyrs" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل فارغ لذوي الشهداء">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب ذوي الشهداء (.xlsx)</span>
                </a>
                <a href="/api/import/template/financial-accounts" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل للبيانات المالية (الرصيد، القروض، السلف)">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب البيانات المالية والرصيد والقروض (.xlsx)</span>
                </a>
                <a href="/api/import/template/job-titles" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل لتصنيف العناوين والعوائل الوظيفية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب العناوين والعوائل الوظيفية (.xlsx)</span>
                </a>
                <a href="/api/import/template/last-allowance-date" target="_blank" class="hr-btn hr-btn-secondary" title="تحميل نموذج إكسل لتاريخ آخر علاوة سنوية">
                    <Icon Name="arrow-down-tray" Size="sm" />
                    <span>قالب آخر علاوة سنوية (.xlsx)</span>
                </a>
            </div>
    </header>

    @* Navigation Tabs *@
    <div class="hr-tabs hr-tabs--wrap" role="tablist" aria-label="نوع البيانات المستوردة" style="margin-block-end: var(--s-6)">
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Employees ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Employees)">
            <Icon Name="users" Size="sm" />
            <span>سجلات الموظفين</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Letters ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Letters)">
            <Icon Name="document-text" Size="sm" />
            <span>كتب الشكر والتقدير</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Leaves ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Leaves)">
            <Icon Name="calendar-days" Size="sm" />
            <span>إجازات الموظفين</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Movements ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Movements)">
            <Icon Name="arrows-right-left" Size="sm" />
            <span>حركات الخدمة والتنقلات</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Courses ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Courses)">
            <Icon Name="academic-cap" Size="sm" />
            <span>الدورات التدريبية</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.CivilData ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.CivilData)">
            <Icon Name="identification" Size="sm" />
            <span>استكمال بيانات البطاقة الموحدة</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.EmailAccounts ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.EmailAccounts)">
            <Icon Name="envelope" Size="sm" />
            <span>البريد الإلكتروني والحسابات</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.BankingAllowances ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.BankingAllowances)">
            <Icon Name="banknotes" Size="sm" />
            <span>المخصصات المالية والبدلات (مصرفية / هندسية / قانونية / شهادة)</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Penalties ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Penalties)">
            <Icon Name="exclamation-triangle" Size="sm" />
            <span>العقوبات الانضباطية</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.MaritalStatus ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.MaritalStatus)">
            <Icon Name="heart" Size="sm" />
            <span>الحالة الاجتماعية</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.Martyrs ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.Martyrs)">
            <Icon Name="flag" Size="sm" />
            <span>ذوي الشهداء</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.FinancialAccounts ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.FinancialAccounts)">
            <Icon Name="banknotes" Size="sm" />
            <span>البيانات المالية (الرصيد / القروض / السلف)</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.JobTitles ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.JobTitles)">
            <Icon Name="identification" Size="sm" />
            <span>العناوين والعوائل الوظيفية</span>
        </button>
        <button type="button" role="tab" class="hr-tab" aria-selected="@(activeTab == ImportTab.LastAllowanceDate ? "true" : "false")"
                @onclick="() => SetTab(ImportTab.LastAllowanceDate)">
            <Icon Name="award" Size="sm" />
            <span>تاريخ آخر علاوة سنوية</span>
        </button>
    </div>

    @* ================= TAB 1: EMPLOYEES ================= *@
    @if (activeTab == ImportTab.Employees)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="users" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد سجلات الموظفين</h2>
                        <p class="hr-meta">يدعم ملفات .xlsx بأسماء الأعمدة القياسية (المسمى الوظيفي / المنصب / التشكيل / العناوين)</p>
                    </div>
                </div>
                <span class="hr-badge">الحد الأقصى: 100,000 موظف لكل ملف</span>
            </div>

            <div class="hr-card-body">
                @* Options Row *@
                <div class="hr-filterbar-row" style="margin-bottom: 1.25rem;">
                    <div class="hr-field">
                        <label for="f-data-import-1" class="hr-field-label">وضع الاستيراد (Import Mode)</label>
                        <select id="f-data-import-1" class="hr-select" @bind="employeeImportMode">
                            <option value="upsert">تحديث وإضافة (Upsert) - ينشئ الجديد ويحدّث القائم</option>
                            <option value="insert">إضافة جديد فقط (Insert) - يمنع تعديل أي موظف مسجل مسبقاً</option>
                        </select>
                    </div>

                    <label class="hr-check" style="align-self: center; margin-block: var(--s-2); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="checkbox" id="emp-auto-lookups" @bind="employeeCreateMissingLookups" />
                        <span style="font-size:var(--fs-label); font-weight: 600;">إنشاء التصنيفات الجديدة تلقائياً (التشكيلات، العناوين، المناصب، الدرجات، الشهادات)</span>
                    </label>
                </div>

                @* Upload Dropzone *@
                <div class="hr-dropzone @(isParsing ? "is-busy" : "")">
                    <div class="hr-dropzone__icon" aria-hidden="true">
                        <Icon Name="arrow-up-tray" Size="lg" />
                    </div>
                    <h3 class="hr-dropzone__title">اختر ملف Excel (.xlsx) لسجلات الموظفين</h3>
                    <p class="hr-meta hr-dropzone__hint">اسحب الملف هنا أو اضغط للاختيار من جهازك</p>

                    <InputFile OnChange="HandleEmployeeFileSelected" accept=".xlsx,.xlsm" class="hr-dropzone__input" />

                    @if (isParsing)
                    {
                        <div class="hr-busy" role="status">
                            <span class="hr-spinner" aria-hidden="true"></span>
                            <span>جارٍ قراءة وفحص ملف الإكسل…</span>
                        </div>
                    }
                </div>

                @* Parse Result / Preview *@
                @if (empParseResult != null)
                {
                    <div style="margin-top: 1.5rem;">
                        @if (empParseResult.HasErrors)
                        {
                            <div class="hr-alert hr-alert-danger" style="margin-bottom: 1rem;">
                                <div style="font-weight: 700; margin-bottom: 0.5rem;">تعذّر معالجة بعض صفوف الملف:</div>
                                <ul style="margin: 0; padding-inline-start: 1.25rem; font-size: var(--fs-label);">
                                    @foreach (var err in empParseResult.ParseErrors.Take(6))
                                    {
                                        <li>@err.Message (@err.Field)</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="hr-alert hr-alert-ok" style="margin-bottom: 1rem;">
                                <Icon Name="check-circle" Size="sm" />
                                <span>تم فحص الملف بنجاح! تم استخراج <strong>@empParseResult.Rows.Count</strong> صف سجل موظف جاهز للاستيراد.</span>
                            </div>
                        }

                        @if (empParseResult.UnmappedHeaders.Any(h => h.Contains("إجاز") || h.Contains("اجاز") || h.Contains("بدء") || h.Contains("انتهاء") || h.Contains("أيام") || h.Contains("ايام")))
                        {
                            <div class="hr-alert hr-alert-warn" style="margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                                <div>
                                    <strong>تنبيه: يبدو أنك قمت برفع ملف "إجازات" في تبويب سجلات الموظفين!</strong>
                                    <p style="margin: 0.25rem 0 0 0; font-size: var(--fs-label);">هذا التبويب مخصص لبيانات الموظفين الأساسية فقط. يرجى التبديل إلى تبويب "إجازات الموظفين" ليتم التعرف على تواريخ الإجازة وأيامها وربطها بالموظفين بدقة.</p>
                                </div>
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="() => SetTab(ImportTab.Leaves)">
                                    <Icon Name="calendar-days" Size="sm" />
                                    <span>الانتقال لتبويب إجازات الموظفين</span>
                                </button>
                            </div>
                        }

                        @* Headers mapping review *@
                        <div class="hr-tagrow">
                            <span class="hr-meta hr-tagrow__label">الأعمدة المطابقة:</span>
                            @foreach (var h in empParseResult.MatchedHeaders)
                            {
                                <span class="hr-badge hr-badge-ok">@h</span>
                            }
                            @if (empParseResult.UnmappedHeaders.Count > 0)
                            {
                                <span class="hr-meta hr-tagrow__label">أعمدة إضافية تم تجاهلها:</span>
                                @foreach (var un in empParseResult.UnmappedHeaders)
                                {
                                    <span class="hr-badge">@un</span>
                                }
                            }
                        </div>

                        @* Preview Table of First 8 rows *@
                        @if (empParseResult.Rows.Count > 0)
                        {
                            <div class="hr-tablewrap" style="max-height: 20rem; overflow-y: auto; margin-bottom: 1.5rem;">
                                <table class="hr-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">الرقم الوظيفي</th>
                                            <th scope="col">الاسم الكامل</th>
                                            <th scope="col">التشكيل</th>
                                            <th scope="col">العنوان الوظيفي</th>
                                            <th scope="col">المسمى الوظيفي / المنصب</th>
                                            <th scope="col">المباشرة</th>
                                            <th scope="col">التولد</th>
                                            <th scope="col">الشهادة والاختصاص</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Math.Min(empParseResult.Rows.Count, 8); i++)
                                        {
                                            var row = empParseResult.Rows[i];
                                            <tr>
                                                <td class="hr-meta">@(i + 1)</td>
                                                <td><span class="hr-cell-strong hr-num">@row.EmployeeID</span></td>
                                                <td style="font-weight: 600;">@row.Name</td>
                                                <td>@(row.Formation ?? "—")</td>
                                                <td>@(row.JobTitle ?? "—")</td>
                                                <td>@(row.PositionTitle ?? "—")</td>
                                                <td class="hr-num">@(row.HireDate ?? "—")</td>
                                                <td class="hr-num">@(row.BirthDate ?? "—")</td>
                                                <td>@(row.EducationLevel ?? "—") @(!string.IsNullOrEmpty(row.Specialization) ? $"({row.Specialization})" : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* Confirm Import Button *@
                            <div style="display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
                                @if (isImporting)
                                {
                                    <div class="hr-busy" role="status">
                                        <span class="hr-spinner" aria-hidden="true"></span>
                                        <span>جارٍ حفظ السجلات بقاعدة البيانات…</span>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteEmployeeImport" disabled="@empParseResult.HasErrors">
                                        <Icon Name="arrow-up-tray" Size="sm" />
                                        <span>تأكيد استيراد (@empParseResult.Rows.Count) سجل إلى قاعدة البيانات</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @* Import Execution Response Card *@
                @if (empImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status">
                        <div class="hr-card-body">
                            <div class="hr-result__head">
                                <Icon Name="check-circle" Size="lg" />
                                <h3 class="hr-result__title">تم إنجاز استيراد سجلات الموظفين بنجاح!</h3>
                            </div>
                            <div class="hr-result__grid">
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">إجمالي الصفوف</div>
                                    <div class="hr-result__value">@empImportResponse.TotalRows</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">السجلات الجديدة المضافة</div>
                                    <div class="hr-result__value hr-result__value--ok">@empImportResponse.Inserted</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">السجلات القائمة المحدّثة</div>
                                    <div class="hr-result__value hr-result__value--accent">@empImportResponse.Updated</div>
                                </div>
                            </div>
                            <div class="hr-result__actions">
                                <a href="/employees" class="hr-btn hr-btn-secondary">
                                    <Icon Name="users" Size="sm" />
                                    <span>الانتقال لدليل الموظفين واستعراض السجلات</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 2: APPRECIATION LETTERS ================= *@
    @if (activeTab == ImportTab.Letters)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="document-text" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد كتب الشكر والتقدير</h2>
                        <p class="hr-meta">يدعم ملفات .xlsx لربط كتب الشكر بالأرقام الوظيفية للموظفين واستخراجها بدقة</p>
                    </div>
                </div>
                <span class="hr-badge">الحد الأقصى: 100,000 كتاب لكل ملف</span>
            </div>

            <div class="hr-card-body">
                <div class="hr-filterbar-row" style="margin-bottom: 1.25rem;">
                    <div class="hr-field">
                        <label for="f-data-import-2" class="hr-field-label">وضع الاستيراد (Import Mode)</label>
                        <select id="f-data-import-2" class="hr-select" @bind="letterImportMode">
                            <option value="upsert">تحديث وإضافة (Upsert) - ينشئ الجديد ويحدّث القائم</option>
                            <option value="insert">إضافة جديد فقط (Insert) - يمنع تعديل أي كتاب موجود</option>
                        </select>
                    </div>

                    <label for="f-data-import-3" class="hr-check" style="align-self: end;">
                        <input type="checkbox" id="let-auto-lookups" @bind="letterCreateMissingLookups" />
                        <span>إنشاء أنواع كتب الشكر الجديدة تلقائياً</span>
                    </label>
                </div>

                <div class="hr-dropzone @(isParsing ? "is-busy" : "")">
                    <div class="hr-dropzone__icon" aria-hidden="true">
                        <Icon Name="arrow-up-tray" Size="lg" />
                    </div>
