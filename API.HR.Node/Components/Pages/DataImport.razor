                                    <Icon Name="check-circle" Size="sm" />
                                    <span>تم فحص الملف بنجاح! تم استخراج <strong>@leaveParseResult.Rows.Count</strong> إجازة جاهزة للاستيراد.</span>
                                </div>
                            }

                            <div class="hr-tagrow">
                                <span class="hr-meta hr-tagrow__label">الأعمدة المطابقة:</span>
                                @foreach (var h in leaveParseResult.MatchedHeaders)
