                                <ul style="margin: 0; padding-inline-start: 1.25rem; font-size: var(--fs-label);">
                                    @foreach (var err in maritalStatusParseResult.ParseErrors.Take(6))
                                    {
                                        <li>@err.Message (@err.Field)</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="hr-filterbar-row" style="margin-bottom: 0.75rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                            <span class="hr-badge">إجمالي السجلات: @maritalStatusParseResult.Rows.Count</span>
                            <span class="hr-badge hr-badge-ok">مطابق بالمنظومة: @msMatched</span>
                            @if (msUnmatched > 0)
                            {
                                <span class="hr-badge hr-badge-danger">غير مطابق: @msUnmatched</span>
                            }
