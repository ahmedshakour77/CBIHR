            var req = new FinancialAccountImportRequest(
                Mode: "upsert",
                Rows: financialParseResult.Rows);

            financialImportResponse = await ImportService.ImportFinancialAccountsAsync(req, username);
            Toast.Success($"تم تحديث البيانات المالية لـ {financialImportResponse.Updated} موظفاً بنجاح.");
        }
        catch (Exception ex)
        {
            Toast.Danger($"خطأ أثناء حفظ البيانات المالية: {ex.Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    private void CancelFinancialAccountsPreview()
    {
        financialParseResult = null;
        financialImportResponse = null;
        StateHasChanged();
    }

    private async Task HandleJobTitlesFileSelected(InputFileChangeEventArgs e)
