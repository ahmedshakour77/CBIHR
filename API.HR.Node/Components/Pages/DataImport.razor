                                <strong>تنبيهات وأخطاء التحقق (@jobTitlesParseResult.ParseErrors.Count):</strong>
                                <ul style="margin: 0.5rem 0 0; padding-inline-start: 1.25rem;">
                                    @foreach (var err in jobTitlesParseResult.ParseErrors.Take(10))
                                    {
                                        <li>الصف @err.Row: @err.Message</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div style="margin-block: 1rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
