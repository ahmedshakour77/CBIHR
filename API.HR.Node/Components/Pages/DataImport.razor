                        <Icon Name="banknotes" Size="xs" />
                        <span>1. المخصصات المصرفية (المسؤولية)</span>
                    </button>
                    <button type="button" class="hr-btn @(allowanceSubTab == AllowanceSubTab.Engineering ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
                            @onclick="() => allowanceSubTab = AllowanceSubTab.Engineering">
                        <Icon Name="cog-6-tooth" Size="xs" />
                        <span>2. المخصصات الهندسية</span>
                    </button>
                    <button type="button" class="hr-btn @(allowanceSubTab == AllowanceSubTab.Legal ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
                            @onclick="() => allowanceSubTab = AllowanceSubTab.Legal">
                        <Icon Name="document-text" Size="xs" />
                        <span>3. المخصصات القانونية (35%)</span>
                    </button>
                    <button type="button" class="hr-btn @(allowanceSubTab == AllowanceSubTab.Certificate ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
