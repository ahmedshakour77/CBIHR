                            <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteJobTitlesImport" disabled="@isImporting">
                                @if (isImporting)
                                {
                                    <span class="hr-spinner" aria-hidden="true"></span>
                                    <span>جارٍ التثبيت والحفظ…</span>
                                }
                                else
                                {
                                    <Icon Name="check-circle" Size="sm" />
                                    <span>تثبيت وحفظ العناوين الوظيفية في النظام</span>
                                }
                            </button>
                        </div>

                        <div class="hr-tablewrap" style="max-height: 400px; overflow-y: auto;">
                            <table class="hr-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">الرمز</th>
                                        <th scope="col">العائلة الوظيفية</th>
                                        <th scope="col">العنوان الوظيفي</th>
                                        <th scope="col">الدرجة الوظيفية</th>
                                        <th scope="col">الحالة الإجرائية</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in jobTitlesParseResult.Rows.Take(100))
                                    {
                                        <tr>
                                            <td>@row.RowNumber</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.Code))
                                                {
                                                    <span class="hr-badge" style="font-family: monospace;">@row.Code</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">-</span>
                                                }
                                            </td>
                                            <td>@(row.JobFamily ?? "-")</td>
                                            <td>
                                                <strong>@row.Name</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(row.GradeName))
                                                {
                                                    <span class="hr-badge">@row.GradeName</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (row.IsExisting)
                                                {
                                                    <span class="hr-badge hr-badge-accent">تحديث مسجل</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-ok">عنوان جديد</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 14: LAST ALLOWANCE DATE ================= *@
    @if (activeTab == ImportTab.LastAllowanceDate)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="award" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتحديث تاريخ آخر علاوة سنوية</h2>
                        <p class="hr-meta">تحديث تاريخ آخر علاوة سنوية في ملف الموظف، مع دعم عامودي "تاريخ علاوة السنة الحالية" و"تاريخ العلاوة الاساس" واعتماد الأقرب قبل اليوم تلقائياً وإهمال التواريخ المستقبلية</p>
