                                                <th scope="col" style="text-align: center;">مخصصات الحرفة (%)</th>
                                                <th scope="col" style="text-align: right;">احتساب الحرفة</th>
                                                <th scope="col" style="text-align: right;">مخصصات زوجية</th>
                                                <th scope="col" style="text-align: right;">مخصصات أطفال</th>
                                                <th scope="col" style="text-align: right;">مخصصات خطورة</th>
                                                <th scope="col">الحالة والتفاصيل</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in craftAndSocialAllowancesParseResult.Rows.Take(100))
                                            {
                                                <tr class="@(!r.IsMatched ? "hr-row--unmatched" : "")">
                                                    <td>@r.RowNumber</td>
                                                    <td style="font-weight: 700; font-family: var(--font-numeric);">@r.EmployeeID</td>
                                                    <td>@(string.IsNullOrWhiteSpace(r.EmployeeName) ? "-" : r.EmployeeName)</td>
                                                    <td>
                                                        @if (r.IsMatched)
                                                        {
                                                            <span class="hr-badge hr-badge-ok">@r.MatchedName</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="hr-badge hr-badge-danger">غير مسجل</span>
                                                        }
                                                    </td>
                                                    <td style="text-align: right;">@(r.BasicSalary.HasValue ? $"{r.BasicSalary.Value:N0} د.ع" : "-")</td>
                                                    <td style="text-align: center; font-weight: 700; color: var(--series-4);">
                                                        @(r.CraftPercentage.HasValue ? $"{r.CraftPercentage.Value}%" : "-")
                                                    </td>
                                                    <td style="text-align: start; font-weight: 600; color: var(--series-4);">
                                                        @(r.CraftCalculatedAmount.HasValue ? $"{r.CraftCalculatedAmount.Value:N0} د.ع" : "-")
                                                    </td>
                                                    <td style="text-align: start; font-weight: 600; color: var(--series-3);">
                                                        @(r.MarriageFixedAmount.HasValue && r.MarriageFixedAmount.Value > 0 ? $"{r.MarriageFixedAmount.Value:N0} د.ع" : "-")
                                                    </td>
                                                    <td style="text-align: start; font-weight: 600; color: var(--series-2);">
                                                        @(r.ChildrenFixedAmount.HasValue && r.ChildrenFixedAmount.Value > 0 ? $"{r.ChildrenFixedAmount.Value:N0} د.ع" : "-")
                                                    </td>
                                                    <td style="text-align: start; font-weight: 600; color: var(--series-5);">
                                                        @(r.HazardFixedAmount.HasValue && r.HazardFixedAmount.Value > 0 ? $"{r.HazardFixedAmount.Value:N0} د.ع" : "-")
                                                    </td>
                                                    <td><span class="hr-meta" style="font-size: var(--fs-caption);">@r.StatusMessage</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteCraftAndSocialAllowancesImport" disabled="@(isImporting || csMatched == 0)">
                                        <Icon Name="check-circle" Size="sm" />
                                        <span>تنفيذ استيراد وتحديث مخصصات الحرفة والاجتماعية والخطورة (@csMatched موظف)</span>
                                    </button>
                                </div>
                            </div>
                        }

                        @if (craftAndSocialAllowancesImportResponse != null)
                        {
                            <div class="hr-card hr-result" role="status" style="margin-top: 1rem;">
                                <div class="hr-card-body">
                                    <h4 style="margin: 0 0 0.5rem 0; color: var(--ok); font-weight: 700;">اكتملت العملية بنجاح</h4>
                                    <p class="hr-meta">@craftAndSocialAllowancesImportResponse.Message</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 9: PENALTIES ================= *@
    @if (activeTab == ImportTab.Penalties)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="exclamation-triangle" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد العقوبات الانضباطية</h2>
                        <p class="hr-meta">استيراد وتوثيق العقوبات وتاريخ نيل العقوبة وربطها بالرقم الوظيفي للموظف</p>
                    </div>
                </div>
                <span class="hr-badge">الحد الأقصى: 100,000 عقوبة لكل ملف</span>
            </div>

            <div class="hr-card-body">
                <div class="hr-filterbar-row" style="margin-bottom: 1.25rem;">
                    <div class="hr-field">
                        <label for="f-data-import-penalties" class="hr-field-label">وضع الاستيراد (Import Mode)</label>
                        <select id="f-data-import-penalties" class="hr-select" @bind="penaltyImportMode">
                            <option value="upsert">تحديث وإضافة (Upsert) - ينشئ الجديد ويحدّث القائم</option>
                            <option value="insert">إضافة جديد فقط (Insert) - يمنع تعديل أي عقوبة مسجلة مسبقاً</option>
                        </select>
                    </div>

                    <label for="pen-auto-lookups" class="hr-check" style="align-self: end;">
                        <input type="checkbox" id="pen-auto-lookups" @bind="penaltyCreateMissingLookups" />
                        <span>إنشاء أنواع العقوبات الجديدة تلقائياً في قائمة العقوبات</span>
                    </label>
                </div>

                <div class="hr-dropzone @(isParsing ? "is-busy" : "")">
                    <div class="hr-dropzone__icon" aria-hidden="true">
                        <Icon Name="arrow-up-tray" Size="lg" />
                    </div>
                    <h3 class="hr-dropzone__title">اختر ملف Excel (.xlsx) للعقوبات الانضباطية</h3>
                    <p class="hr-meta hr-dropzone__hint">اسحب الملف هنا أو اضغط للاختيار من جهازك</p>

                    <InputFile OnChange="HandlePenaltiesFileSelected" accept=".xlsx,.xlsm" class="hr-dropzone__input" />

                    @if (isParsing)
                    {
                        <div class="hr-busy" role="status">
                            <span class="hr-spinner" aria-hidden="true"></span>
                            <span>جارٍ قراءة وفحص ملف العقوبات…</span>
                        </div>
                    }
                </div>

                @if (penaltiesParseResult != null)
                {
                    <div style="margin-top: 1.5rem;">
                        @if (penaltiesParseResult.HasErrors)
                        {
                            <div class="hr-alert hr-alert-danger" style="margin-bottom: 1rem;">
                                <div style="font-weight: 700; margin-bottom: 0.5rem;">تعذّر معالجة بعض صفوف الملف:</div>
                                <ul style="margin: 0; padding-inline-start: 1.25rem; font-size: var(--fs-label);">
                                    @foreach (var err in penaltiesParseResult.ParseErrors.Take(6))
                                    {
                                        <li>@err.Message (@err.Field)</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="hr-alert hr-alert-ok" style="margin-bottom: 1rem;">
                                <Icon Name="check-circle" Size="sm" />
                                <span>تم فحص الملف بنجاح! تم استخراج <strong>@penaltiesParseResult.Rows.Count</strong> عقوبة جاهزة للاستيراد.</span>
                            </div>
                        }

                        <div class="hr-tagrow">
                            <span class="hr-meta hr-tagrow__label">الأعمدة المطابقة:</span>
                            @foreach (var h in penaltiesParseResult.MatchedHeaders)
                            {
                                <span class="hr-badge hr-badge-ok">@h</span>
                            }
                            @if (penaltiesParseResult.UnmappedHeaders.Count > 0)
                            {
                                <span class="hr-meta hr-tagrow__label">أعمدة إضافية تم تجاهلها بأمان:</span>
                                @foreach (var un in penaltiesParseResult.UnmappedHeaders)
                                {
                                    <span class="hr-badge">@un</span>
                                }
                            }
                        </div>

                        @if (penaltiesParseResult.Rows.Count > 0)
                        {
                            <div class="hr-tablewrap" style="max-height: 20rem; overflow-y: auto; margin-bottom: 1.5rem;">
                                <table class="hr-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">الرقم الوظيفي</th>
                                            <th scope="col">اسم الموظف</th>
                                            <th scope="col">العقوبة</th>
                                            <th scope="col">تاريخ نيل العقوبة</th>
                                            <th scope="col">رقم الكتاب</th>
                                            <th scope="col">الملاحظات (نوع العقوبة)</th>
                                            <th scope="col">المديرية</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Math.Min(penaltiesParseResult.Rows.Count, 10); i++)
                                        {
                                            var row = penaltiesParseResult.Rows[i];
                                            <tr>
                                                <td class="hr-meta">@(i + 1)</td>
                                                <td><span class="hr-cell-strong hr-num">@row.EmployeeID</span></td>
                                                <td>@(row.EmployeeName ?? "—")</td>
                                                <td><span class="hr-badge hr-badge-danger">@(row.PenaltyName ?? "—")</span></td>
                                                <td class="hr-num">@(row.PenaltyDate ?? "—")</td>
                                                <td>@(row.OrderNumber ?? "—")</td>
                                                <td class="hr-meta">@(row.Notes ?? "—")</td>
                                                <td class="hr-meta">@(row.Directorate ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div style="display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
                                @if (isImporting)
                                {
                                    <div class="hr-busy" role="status">
                                        <span class="hr-spinner" aria-hidden="true"></span>
                                        <span>جارٍ حفظ العقوبات بقاعدة البيانات…</span>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="hr-btn hr-btn-secondary" @onclick="CancelPenaltiesPreview">
                                        <span>إلغاء</span>
                                    </button>
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecutePenaltiesImport" disabled="@penaltiesParseResult.HasErrors">
                                        <Icon Name="arrow-up-tray" Size="sm" />
                                        <span>تأكيد استيراد (@penaltiesParseResult.Rows.Count) عقوبة</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (penaltiesImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status" style="margin-top: 1.5rem;">
                        <div class="hr-card-body">
                            <div class="hr-result__head">
                                <Icon Name="check-circle" Size="lg" />
                                <h3 class="hr-result__title">تم إنجاز استيراد العقوبات الانضباطية بنجاح!</h3>
                            </div>
                            <div class="hr-result__grid">
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">إجمالي الصفوف</div>
                                    <div class="hr-result__value">@penaltiesImportResponse.TotalRows</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">العقوبات المضافة حديثاً</div>
                                    <div class="hr-result__value hr-result__value--ok">@penaltiesImportResponse.Inserted</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">العقوبات المحدثة</div>
                                    <div class="hr-result__value hr-result__value--accent">@penaltiesImportResponse.Updated</div>
                                </div>
                                <div class="hr-result__tile">
                                    <div class="hr-result__label">عقوبات متجاهلة (أرقام غير مسجلة)</div>
                                    <div class="hr-result__value @(penaltiesImportResponse.Skipped > 0 ? "hr-result__value--danger" : "")">@penaltiesImportResponse.Skipped</div>
                                </div>
                            </div>

                            @if (penaltiesImportResponse.MissingEmployeeIDs.Count > 0)
                            {
                                <div class="hr-alert hr-alert-warn" style="margin-top: 1rem;">
                                    <strong>الأرقام الوظيفية غير المسجلة مسبقاً في النظام وتم تخطي عقوباتها:</strong>
                                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem;">
                                        @foreach (var id in penaltiesImportResponse.MissingEmployeeIDs)
                                        {
                                            <span class="hr-badge hr-badge-danger">@id</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ================= TAB 10: MARITAL STATUS (الحالة الاجتماعية) ================= *@
    @if (activeTab == ImportTab.MaritalStatus)
    {
        <div class="hr-card" style="margin-bottom: 1.5rem;">
            <div class="hr-card-head">
                <div class="hr-card-head__lead">
                    <Icon Name="heart" Size="md" Class="hr-text-copper" />
                    <div>
                        <h2 class="hr-h3">استيراد وتحديث الحالة الاجتماعية</h2>
                        <p class="hr-meta">ربط الرقم الوظيفي بالملف الأساسي للموظف وتحديث حالته الاجتماعية مع التثبيت التلقائي للحالات في قائمة النظام</p>
