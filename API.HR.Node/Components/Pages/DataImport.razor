                    </a>
                </div>
            </div>

            <div class="hr-card-body">
                @* Upload Dropzone *@
                <div class="hr-dropzone hr-dropzone--plain" style="margin-block-end: var(--s-6)">
                    <div style="margin-bottom: 1rem;">
                        <Icon Name="arrow-up-tray" Size="xl" Class="hr-text-copper" />
                    </div>
                    <h3 style="margin-bottom: 0.5rem; font-weight: 700;">اختر أو اسحب ملف Excel (.xlsx) يحتوي على الرقم الوظيفي والاسم والبريد</h3>
                    <p class="hr-meta" style="margin-bottom: 1rem; max-width: 44rem; margin-inline: auto;">
