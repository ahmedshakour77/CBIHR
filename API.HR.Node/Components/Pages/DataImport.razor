                            {
                                <span class="hr-badge hr-badge-ok">@h</span>
                            }
                            @if (movementParseResult.UnmappedHeaders.Count > 0)
                            {
                                <span class="hr-meta hr-tagrow__label">أعمدة إضافية:</span>
                                @foreach (var un in movementParseResult.UnmappedHeaders)
                                {
                                    <span class="hr-badge">@un</span>
                                }
                            }
