                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;flex-wrap:wrap;gap:var(--s-2);">
                            <h4 class="hr-h4" style="margin: 0;">معاينة السجلات المقروءة (أول @Math.Min(maritalStatusParseResult.Rows.Count, 100) سجل)</h4>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" @onclick="CancelMaritalStatusPreview">إلغاء المعاينة</button>
                        </div>

                        <div class="hr-tablewrap" style="max-height: 400px; overflow-y: auto;">
                            <table class="hr-table hr-table-compact">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 3rem;">#</th>
                                        <th scope="col">الرقم الوظيفي</th>
                                        <th scope="col">اسم الموظف (الملف)</th>
                                        <th scope="col">المطابقة بالنظام</th>
                                        <th scope="col">الحالة الحالية بالنظام</th>
                                        <th scope="col">الحالة بالملف</th>
                                        <th scope="col">الحالة المعتمدة للتثبيت</th>
                                        <th scope="col">الملاحظات / النتيجة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in maritalStatusParseResult.Rows.Take(100))
                                    {
                                        <tr class="@(!r.IsMatched ? "hr-row--unmatched" : "")">
                                            <td>@r.RowNumber</td>
                                            <td style="font-weight: 700; font-family: var(--font-numeric);">@r.EmployeeID</td>
                                            <td>@(string.IsNullOrWhiteSpace(r.EmployeeName) ? "-" : r.EmployeeName)</td>
                                            <td>
                                                @if (r.IsMatched)
                                                {
                                                    <span class="hr-badge hr-badge-ok">@r.MatchedName</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-danger">غير مسجل</span>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(r.CurrentMaritalStatus) ? "—" : r.CurrentMaritalStatus)</td>
                                            <td><span class="hr-cell-strong">@(string.IsNullOrWhiteSpace(r.MaritalStatusRaw) ? "—" : r.MaritalStatusRaw)</span></td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(r.ResolvedMaritalStatus))
                                                {
                                                    <span class="hr-badge hr-badge-accent" style="font-weight: 700;">@r.ResolvedMaritalStatus</span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td><span class="hr-meta" style="font-size: var(--fs-caption);">@r.StatusMessage</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteMaritalStatusImport" disabled="@(isImporting || msMatched == 0)">
                                <Icon Name="check-circle" Size="sm" />
                                <span>تنفيذ استيراد وتحديث الحالة الاجتماعية (@msMatched موظف)</span>
                            </button>
                        </div>
                    </div>
                }

                @if (maritalStatusImportResponse != null)
                {
                    <div class="hr-card hr-result" role="status" style="margin-top: 1rem;">
                        <div class="hr-card-body">
                            <h4 style="margin: 0 0 0.5rem 0; color: var(--ok); font-weight: 700;">اكتملت العملية بنجاح</h4>
                            <p class="hr-meta">@maritalStatusImportResponse.Message</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
