                                    }
                                </button>
                            </div>
                        </div>

                        <div class="hr-stat-grid">
                            <div class="hr-stat-card">
                                <span class="hr-meta">إجمالي السجلات بالملف</span>
                                <strong class="hr-stat-val">@lastAllowanceDateParseResult.Rows.Count</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--ok">
                                <span class="hr-meta">جاهزة للتحديث</span>
                                <strong class="hr-stat-val">@lastAllowanceDateParseResult.Rows.Count(r => r.IsValid && (!r.CurrentAllowanceDate.HasValue || r.CurrentAllowanceDate != r.ParsedDate))</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--warn">
                                <span class="hr-meta">مطابقة مسبقاً (لا تغيير)</span>
                                <strong class="hr-stat-val">@lastAllowanceDateParseResult.Rows.Count(r => r.IsValid && r.CurrentAllowanceDate.HasValue && r.CurrentAllowanceDate == r.ParsedDate)</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--danger">
                                <span class="hr-meta">أخطاء أو أرقام غير موجودة</span>
                                <strong class="hr-stat-val">@lastAllowanceDateParseResult.Rows.Count(r => !r.IsValid)</strong>
                            </div>
                        </div>

                        <div class="hr-tablewrap" style="max-height: 480px; overflow-y: auto;">
                            <table class="hr-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">الرقم الوظيفي</th>
                                        <th scope="col">اسم الموظف في النظام</th>
                                        <th scope="col">تاريخ العلاوة بالملف</th>
                                        <th scope="col">تاريخ العلاوة الحالي في النظام</th>
                                        <th scope="col">حالة السطر</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in lastAllowanceDateParseResult.Rows)
                                    {
                                        <tr class="@(!r.IsValid ? "hr-row-error" : (r.CurrentAllowanceDate.HasValue && r.CurrentAllowanceDate == r.ParsedDate ? "hr-row-warning" : ""))">
                                            <td>@r.RowNumber</td>
                                            <td><span class="hr-num hr-cell-strong">@r.EmployeeID</span></td>
                                            <td>
                                                @if (r.IsMatched)
                                                {
                                                    <span>@r.MatchedName</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta" style="color:var(--cbi-danger);">غير مسجل</span>
                                                }
                                            </td>
                                            <td>
                                                @if (r.ParsedDate.HasValue)
                                                {
                                                    <span class="hr-num hr-cell-strong">@r.ParsedDate.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta" style="color:var(--cbi-danger);">@r.AllowanceDateRaw (غير صالح)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (r.CurrentAllowanceDate.HasValue)
                                                {
                                                    <span class="hr-num">@r.CurrentAllowanceDate.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">غير محدد</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!r.IsValid)
                                                {
                                                    <span class="hr-badge hr-badge-danger">@r.StatusMessage</span>
                                                }
                                                else if (r.CurrentAllowanceDate.HasValue && r.CurrentAllowanceDate == r.ParsedDate)
                                                {
                                                    <span class="hr-badge hr-badge-warning">@r.StatusMessage</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-success">@r.StatusMessage</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (lastAllowanceDateImportResponse != null)
                {
                    <div class="hr-alert hr-alert-success" style="margin-top: 1rem;">
                        <Icon Name="check-circle" Size="sm" />
                        <div>
                            <strong>تم إكمال العملية:</strong> @lastAllowanceDateImportResponse.Message
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

