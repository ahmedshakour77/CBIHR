                                                    {
                                                        <span class="hr-badge hr-badge-ok">نعم</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-badge">لا</span>
                                                    }
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (row.CountForPromotion == true)
                                                    {
                                                        <span class="hr-badge hr-badge-ok">نعم</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-badge">لا</span>
                                                    }
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (row.CountForPension == true)
                                                    {
                                                        <span class="hr-badge hr-badge-ok">نعم</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-badge">لا</span>
                                                    }
                                                </td>
                                                <td class="hr-meta">@(row.Notes ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div style="display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
                                @if (isImporting)
                                {
                                    <div class="hr-busy" role="status">
                                        <span class="hr-spinner" aria-hidden="true"></span>
                                        <span>جارٍ حفظ حركات الخدمة والتنقلات بقاعدة البيانات…</span>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteMovementsImport" disabled="@movementParseResult.HasErrors">
