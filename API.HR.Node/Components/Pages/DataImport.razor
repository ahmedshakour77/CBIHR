                            <div class="hr-stat-card">
                                <span class="hr-meta">إجمالي العناوين المقروءة</span>
                                <strong class="hr-stat-val">@jobTitlesParseResult.Rows.Count</strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--ok">
                                <span class="hr-meta">عناوين مسجلة سيتم تحديثها</span>
                                <strong class="hr-stat-val">
                                    @jobTitlesParseResult.Rows.Count(r => r.IsExisting)
                                </strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--accent">
                                <span class="hr-meta">عناوين وظيفية جديدة ستضاف</span>
                                <strong class="hr-stat-val">
                                    @jobTitlesParseResult.Rows.Count(r => !r.IsExisting)
                                </strong>
                            </div>
                            <div class="hr-stat-card hr-stat-card--warn">
                                <span class="hr-meta">تحتوي على رمز وظيفي</span>
                                <strong class="hr-stat-val">
                                    @jobTitlesParseResult.Rows.Count(r => !string.IsNullOrWhiteSpace(r.Code))
