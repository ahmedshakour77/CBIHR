                        <Icon Name="academic-cap" Size="xs" />
                        <span>4. مخصصات الشهادة (سلم النسب)</span>
                    </button>
                    <button type="button" class="hr-btn @(allowanceSubTab == AllowanceSubTab.NonPractice ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
