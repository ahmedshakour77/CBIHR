                                    @if (isImporting)
                                    {
                                        <span class="hr-spinner" aria-hidden="true"></span>
                                        <span>جارٍ الحفظ…</span>
                                    }
                                    else
                                    {
                                        <Icon Name="check" Size="xs" />
