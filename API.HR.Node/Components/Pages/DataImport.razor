    /// <summary>
    /// Excel parsing needs a seekable stream. A 25 MB workbook buffered in a
    /// MemoryStream sits in server memory (on the large-object heap) for every
    /// import in flight; a temp file costs disk instead and deletes itself on dispose.
    /// </summary>
    private static async Task<FileStream> BufferToTempFileAsync(Stream source)
    {
        var buffer = new FileStream(
            Path.Combine(Path.GetTempPath(), "hr-import-" + Guid.NewGuid().ToString("N") + ".tmp"),
            FileMode.CreateNew, FileAccess.ReadWrite, FileShare.None, 81920,
            FileOptions.Asynchronous | FileOptions.DeleteOnClose);
        await source.CopyToAsync(buffer);
        buffer.Position = 0;
        return buffer;
    }

    private async Task HandleEmployeeFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        isParsing = true;
        empParseResult = null;
        empImportResponse = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await using var ms = await BufferToTempFileAsync(stream);

            empParseResult = await ImportService.ParseEmployeesExcelAsync(ms);
            if (empParseResult.HasErrors)
            {
                Toast.Danger("الملف يحتوي على أخطاء في ترويسة الأعمدة أو البيانات.");
            }
            else
            {
                Toast.Success($"تمت قراءة {empParseResult.Rows.Count} صف من ملف الموظفين بنجاح.");
            }
        }
        catch (Exception ex)
        {
            Toast.Danger($"فشل قراءة الملف: {ex.Message}");
        }
        finally
        {
            isParsing = false;
            StateHasChanged();
        }
    }

