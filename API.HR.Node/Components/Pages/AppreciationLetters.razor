    private async Task SaveLetter()
    {
        modalError = null;

        if (letterModel.EmployeeId <= 0)
        {
            modalError = "يرجى اختيار الموظف المكرم أولاً.";
            return;
        }

        if (string.IsNullOrWhiteSpace(letterModel.Title))
        {
            modalError = "يرجى اختيار أو إدخال عنوان / جهة كتاب الشكر.";
            return;
        }

        if (letterModel.LetterDate == null)
        {
            modalError = "يرجى تحديد تاريخ صدور كتاب الشكر.";
            return;
        }

        if (letterModel.Count <= 0)
        {
            modalError = "عدد كتب الشكر يجب أن يكون رقماً موجباً (1 على الأقل).";
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // Resolve or create AppreciationLetterTitle
            var cleanTitle = letterModel.Title.Trim();
            var existingTitle = await db.AppreciationLetterTitles.FirstOrDefaultAsync(t => t.Name == cleanTitle);
            if (existingTitle == null)
            {
                existingTitle = new AppreciationLetterTitle { Name = cleanTitle };
                db.AppreciationLetterTitles.Add(existingTitle);
                await db.SaveChangesAsync();
                await LoadLookupsAsync();
            }

            if (editingLetterId.HasValue)
            {
                var letter = await db.AppreciationLetters.FindAsync(editingLetterId.Value);
                if (letter == null)
                {
                    modalError = "السجل المطلوب تعديله غير موجود.";
                    isSaving = false;
                    return;
                }

                letter.TitleId = existingTitle.Id;
                letter.Title = existingTitle.Name;
                letter.TypeId = letterModel.TypeId;
                letter.LetterDate = letterModel.LetterDate;
                letter.Count = letterModel.Count;
                letter.LetterNumber = string.IsNullOrWhiteSpace(letterModel.LetterNumber) ? null : letterModel.LetterNumber.Trim();
                letter.Notes = string.IsNullOrWhiteSpace(letterModel.Notes) ? null : letterModel.Notes.Trim();
            }
            else
            {
                var letter = new AppreciationLetter
                {
                    EmployeeId = letterModel.EmployeeId,
                    TitleId = existingTitle.Id,
                    Title = existingTitle.Name,
                    TypeId = letterModel.TypeId,
                    LetterDate = letterModel.LetterDate,
                    Count = letterModel.Count,
                    LetterNumber = string.IsNullOrWhiteSpace(letterModel.LetterNumber) ? null : letterModel.LetterNumber.Trim(),
                    Notes = string.IsNullOrWhiteSpace(letterModel.Notes) ? null : letterModel.Notes.Trim()
                };

                db.AppreciationLetters.Add(letter);
            }

            await db.SaveChangesAsync();
            CloseLetterModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save appreciation letter");
            modalError = "حدث خطأ أثناء حفظ كتاب الشكر. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

