    // Types & Seniority Management
    private bool isTypesModalOpen;
    private string? typesStatusMessage;
    private string newTypeName = "";
    private int newTypeYears;
    private int newTypeMonths;
    private int newTypeDays;

    private void OpenTypesManagementModal()
    {
        typesStatusMessage = null;
        newTypeName = "";
        newTypeYears = 0;
        newTypeMonths = 0;
        newTypeDays = 0;
        isTypesModalOpen = true;
    }

    private void CloseTypesModal()
    {
        isTypesModalOpen = false;
        typesStatusMessage = null;
    }

    private async Task CreateNewTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(newTypeName)) return;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var trimmed = newTypeName.Trim();
            var exists = await db.AppreciationLetterTypes.AnyAsync(t => t.Name == trimmed);
            if (exists)
            {
                typesStatusMessage = $"النوع '{trimmed}' موجود مسبقاً.";
                return;
            }

            var entity = new AppreciationLetterType
            {
                Name = trimmed,
                SeniorityYears = Math.Max(0, newTypeYears),
                SeniorityMonths = Math.Max(0, newTypeMonths),
                SeniorityDays = Math.Max(0, newTypeDays)
            };

            db.AppreciationLetterTypes.Add(entity);
            await db.SaveChangesAsync();

            availableTypes = await db.AppreciationLetterTypes.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
            typesStatusMessage = $"تمت إضافة نوع كتاب الشكر '{trimmed}' وتحديد القِدم بنجاح.";
            newTypeName = "";
            newTypeYears = 0;
            newTypeMonths = 0;
            newTypeDays = 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create appreciation letter type");
            typesStatusMessage = "حدث خطأ أثناء إضافة النوع.";
        }
    }

    private async Task SaveTypeAsync(AppreciationLetterType type)
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var entity = await db.AppreciationLetterTypes.FindAsync(type.Id);
            if (entity != null)
            {
                entity.Name = type.Name.Trim();
                entity.SeniorityYears = Math.Max(0, type.SeniorityYears);
                entity.SeniorityMonths = Math.Max(0, type.SeniorityMonths);
                entity.SeniorityDays = Math.Max(0, type.SeniorityDays);
                await db.SaveChangesAsync();

                typesStatusMessage = $"تم حفظ تعديلات النوع '{entity.Name}' بنجاح.";
                await LoadLookupsAsync();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update appreciation letter type");
            typesStatusMessage = "حدث خطأ أثناء حفظ التعديل.";
        }
    }

    private async Task SaveAllTypesAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            foreach (var t in availableTypes)
            {
                var entity = await db.AppreciationLetterTypes.FindAsync(t.Id);
                if (entity != null)
                {
                    entity.Name = t.Name.Trim();
                    entity.SeniorityYears = Math.Max(0, t.SeniorityYears);
                    entity.SeniorityMonths = Math.Max(0, t.SeniorityMonths);
                    entity.SeniorityDays = Math.Max(0, t.SeniorityDays);
                }
            }

            await db.SaveChangesAsync();
            typesStatusMessage = "تم حفظ كافة أنواع كتب الشكر ومدد القِدم بنجاح.";
            await LoadLookupsAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save all appreciation letter types");
            typesStatusMessage = "حدث خطأ أثناء حفظ التغييرات.";
        }
    }

    private static bool HasSeniority(AppreciationLetterType? t) =>
        t != null && (t.SeniorityYears > 0 || t.SeniorityMonths > 0 || t.SeniorityDays > 0);

    private static string FormatTypeSeniority(AppreciationLetterType? t)
    {
        if (t == null || (t.SeniorityYears == 0 && t.SeniorityMonths == 0 && t.SeniorityDays == 0))
            return "غير محدد";

        var parts = new List<string>();
        if (t.SeniorityYears > 0) parts.Add($"{t.SeniorityYears} {(t.SeniorityYears == 1 ? "سنة" : (t.SeniorityYears == 2 ? "سنتان" : (t.SeniorityYears <= 10 ? "سنوات" : "سنة")))}");
        if (t.SeniorityMonths > 0) parts.Add($"{t.SeniorityMonths} {(t.SeniorityMonths == 1 ? "شهر" : (t.SeniorityMonths == 2 ? "شهران" : (t.SeniorityMonths <= 10 ? "أشهر" : "شهراً")))}");
        if (t.SeniorityDays > 0) parts.Add($"{t.SeniorityDays} {(t.SeniorityDays == 1 ? "يوم" : (t.SeniorityDays == 2 ? "يومان" : (t.SeniorityDays <= 10 ? "أيام" : "يوماً")))}");

        return string.Join(" و", parts);
    }

    private static string FormatSeniority(AppreciationLetter letter)
    {
        var count = letter.Count ?? 1;
        if (count <= 0) count = 1;
        var type = letter.Type;
        if (type != null && (type.SeniorityYears > 0 || type.SeniorityMonths > 0 || type.SeniorityDays > 0))
        {
            var totalY = type.SeniorityYears * count;
            var totalM = type.SeniorityMonths * count;
            var totalD = type.SeniorityDays * count;

            if (totalD >= 30) { totalM += totalD / 30; totalD %= 30; }
            if (totalM >= 12) { totalY += totalM / 12; totalM %= 12; }

            var parts = new List<string>();
            if (totalY > 0) parts.Add($"{totalY} {(totalY == 1 ? "سنة" : (totalY == 2 ? "سنتان" : (totalY <= 10 ? "سنوات" : "سنة")))}");
            if (totalM > 0) parts.Add($"{totalM} {(totalM == 1 ? "شهر" : (totalM == 2 ? "شهران" : (totalM <= 10 ? "أشهر" : "شهراً")))}");
            if (totalD > 0) parts.Add($"{totalD} {(totalD == 1 ? "يوم" : (totalD == 2 ? "يومان" : (totalD <= 10 ? "أيام" : "يوماً")))}");

            return parts.Count > 0 ? "+" + string.Join(" و ", parts) + " قِدم" : "بدون قِدم";
        }

        return "بدون قِدم";
    }

    private static string FormatTotalDossierSeniority(IEnumerable<AppreciationLetter> letters)
    {
        var list = letters.ToList();
        if (list.Count == 0) return "بدون قِدم";

        int totalY = 0;
        int totalM = 0;
        int totalD = 0;

        foreach (var l in list)
        {
            var c = l.Count ?? 1;
            if (c <= 0) c = 1;
            if (l.Type != null)
            {
                totalY += l.Type.SeniorityYears * c;
                totalM += l.Type.SeniorityMonths * c;
                totalD += l.Type.SeniorityDays * c;
            }
        }

        if (totalD >= 30)
        {
            totalM += totalD / 30;
            totalD = totalD % 30;
        }
        if (totalM >= 12)
        {
            totalY += totalM / 12;
            totalM = totalM % 12;
        }

        var parts = new List<string>();
        if (totalY > 0) parts.Add($"{totalY} {(totalY == 1 ? "سنة" : (totalY == 2 ? "سنتان" : (totalY <= 10 ? "سنوات" : "سنة")))}");
        if (totalM > 0) parts.Add($"{totalM} {(totalM == 1 ? "شهر" : (totalM == 2 ? "شهران" : (totalM <= 10 ? "أشهر" : "شهراً")))}");
        if (totalD > 0) parts.Add($"{totalD} {(totalD == 1 ? "يوم" : (totalD == 2 ? "يومان" : (totalD <= 10 ? "أيام" : "يوماً")))}");

        if (parts.Count == 0) return "بدون قِدم";
        return "+" + string.Join(" و ", parts);
    }

