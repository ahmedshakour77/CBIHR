                        </span>
                    </div>

                    @* رقم كتاب *@
                    <div class="hr-field">
                        <label for="f-appreciation-letters-5" class="hr-label">
                            رقم كتاب (الأمر الإداري / الصادر)
                        </label>
                        <input id="f-appreciation-letters-5" type="text" class="hr-input" placeholder="مثال: ش/125/2024" @bind="letterModel.LetterNumber" />
                    </div>
                </div>

                <div class="hr-alert hr-alert-ok" style="font-size:var(--fs-label);padding:0.625rem 0.875rem">
                    <Icon Name="check" Size="xs" />
                    <span>
                        <strong>ملاحظة تنظيمية:</strong> يُسمح بإصدار أكثر من كتاب شكر لنفس الموظف في نفس اليوم بتواريخ متطابقة وأرقام كتب مستقلة.
                    </span>
                </div>

                @* الملاحظات *@
                <div class="hr-field">
                    <label for="f-appreciation-letters-6" class="hr-label">الملاحظات (نص حر)</label>
                    <textarea id="f-appreciation-letters-6" class="hr-input" rows="2" placeholder="أي تفاصيل أو أسباب إضافية لصدور كتاب الشكر…" @bind="letterModel.Notes"></textarea>
                </div>
            </div>
        </Body>
        <Footer>
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseLetterModal">إلغاء</button>
            <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveLetter" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="hr-spinner" aria-hidden="true"></span>
                    <span>جارٍ الحفظ…</span>
                }
                else
                {
                    <Icon Name="check" Size="xs" />
                    <span>@(editingLetterId.HasValue ? "حفظ التعديلات" : "تأكيد التسجيل")</span>
                }
            </button>
        </Footer>
    </Modal>
