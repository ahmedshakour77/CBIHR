@* ======================================================== *@
@* CONFIRM DELETE DIALOG                                    *@
@* ======================================================== *@
<ConfirmDialog IsOpen="@isConfirmDeleteOpen"
               Title="تأكيد حذف كتاب الشكر والتقدير"
               Message="@($"هل أنت متأكد من رغبتك بحذف كتاب الشكر الصادر برقم '{(letterToDelete?.LetterNumber ?? "—")}' للموظف '{letterToDelete?.Employee?.Name}'؟ سيتم خصم شهر القِدم المحتسب.")"
               ConfirmText="نعم، احذف السجل"
               CancelText="إلغاء"
               Destructive="true"
               OnConfirm="ExecuteDeleteLetter"
               OnCancel="() => isConfirmDeleteOpen = false" />

@code {
    private bool isLoading = true;
    private bool isSaving = false;

    // KPI Counters
    private int totalRecordsCount;
    private int totalSeniorityMonths;
    private string totalSeniorityFormattedText = "بدون قِدم";
    private int honoredEmployeesCount;
    private int titlesCount;

    // Filters
    private string filterSearch = "";
    private string filterTitleId = "";
    private string filterTypeId = "";
    private string filterFormationId = "";
    private string filterDateFrom = "";
    private string filterDateTo = "";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(filterSearch) ||
        !string.IsNullOrWhiteSpace(filterTitleId) ||
        !string.IsNullOrWhiteSpace(filterTypeId) ||
        !string.IsNullOrWhiteSpace(filterFormationId) ||
        !string.IsNullOrWhiteSpace(filterDateFrom) ||
        !string.IsNullOrWhiteSpace(filterDateTo);

    // Lookups
    private List<AppreciationLetterTitle> availableTitles = [];
    private List<AppreciationLetterType> availableTypes = [];
    private List<Formation> availableFormations = [];
    private Dictionary<int, int> empLetterCounts = [];

    // Table Data
    private List<AppreciationLetter> displayedLetters = [];
    private int filteredTotalCount;
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredTotalCount / (double)pageSize));

    // Quick Dossier Search
    private string lookupDossierQuery = "";
    private bool showDossierDropdown = false;
    private List<Employee> dossierSearchResults = [];

    // Dossier Modal
    private bool isDossierModalOpen;
    private Employee? dossierEmployee;
    private List<AppreciationLetter> dossierLetters = [];

    // Create / Edit Modal
    private bool isLetterModalOpen;
    private int? editingLetterId;
    private string? modalError;
    private LetterFormModel letterModel = new();
    private string selectedEmployeeName = "";
    private string selectedEmployeeCode = "";
    private string employeeModalSearchQuery = "";
    private bool showModalEmpDropdown;
    private List<Employee> modalEmpSearchResults = [];
    private string selectedTitleOption = "";
    private bool isCustomTitle = false;

    // Delete Dialog
    private bool isConfirmDeleteOpen;
    private AppreciationLetter? letterToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadDataAsync();
    }

    private async Task LoadLookupsAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        availableTitles = await db.AppreciationLetterTitles.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        availableTypes = await db.AppreciationLetterTypes.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        availableFormations = await db.Formations.AsNoTracking().OrderBy(f => f.Name).ToListAsync();

        // Seed default titles if empty
        if (!availableTitles.Any())
        {
            var defaultTitles = new[]
            {
                "كتاب شكر وتقدير",
                "شكر وتقدير محافظ البنك المركزي",
                "شكر وتقدير رئيس الوزراء",
                "شكر وتقدير وزير المالية",
                "شكر وتقدير المدير العام",
                "تكريم متميز"
            };

            foreach (var dt in defaultTitles)
            {
                db.AppreciationLetterTitles.Add(new AppreciationLetterTitle { Name = dt });
            }
            await db.SaveChangesAsync();
            availableTitles = await db.AppreciationLetterTitles.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        }

        // Seed default types if empty
        if (!availableTypes.Any())
        {
            var defaultTypes = new[]
            {
                "فردي",
                "جماعي",
                "عام",
                "شكر مع قِدم",
                "شهادة تقديرية"
            };

            foreach (var dt in defaultTypes)
            {
                db.AppreciationLetterTypes.Add(new AppreciationLetterType { Name = dt });
            }
            await db.SaveChangesAsync();
            availableTypes = await db.AppreciationLetterTypes.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        // 1. Overall KPIs
        totalRecordsCount = await db.AppreciationLetters.CountAsync();
        honoredEmployeesCount = await db.AppreciationLetters.Select(l => l.EmployeeId).Distinct().CountAsync();
        titlesCount = availableTitles.Count;

        var allLettersSeniority = await db.AppreciationLetters
            .Include(l => l.Type)
            .Select(l => new
            {
                Count = l.Count ?? 1,
                SeniorityYears = l.Type != null ? l.Type.SeniorityYears : 0,
                SeniorityMonths = l.Type != null ? l.Type.SeniorityMonths : 0,
                SeniorityDays = l.Type != null ? l.Type.SeniorityDays : 0
            })
            .ToListAsync();

        int kpiY = 0, kpiM = 0, kpiD = 0;
        foreach (var item in allLettersSeniority)
        {
            kpiY += item.SeniorityYears * item.Count;
            kpiM += item.SeniorityMonths * item.Count;
            kpiD += item.SeniorityDays * item.Count;
        }
        if (kpiD >= 30) { kpiM += kpiD / 30; kpiD %= 30; }
        if (kpiM >= 12) { kpiY += kpiM / 12; kpiM %= 12; }

        totalSeniorityMonths = kpiY * 12 + kpiM;
        var kpiParts = new List<string>();
        if (kpiY > 0) kpiParts.Add($"{kpiY} {(kpiY == 1 ? "سنة" : (kpiY == 2 ? "سنتان" : (kpiY <= 10 ? "سنوات" : "سنة")))}");
        if (kpiM > 0) kpiParts.Add($"{kpiM} {(kpiM == 1 ? "شهر" : (kpiM == 2 ? "شهران" : (kpiM <= 10 ? "أشهر" : "شهراً")))}");
        if (kpiD > 0) kpiParts.Add($"{kpiD} {(kpiD == 1 ? "يوم" : (kpiD == 2 ? "يومان" : (kpiD <= 10 ? "أيام" : "يوماً")))}");
        totalSeniorityFormattedText = kpiParts.Count > 0 ? string.Join(" و ", kpiParts) : "بدون قِدم";

        empLetterCounts = await db.AppreciationLetters
            .GroupBy(l => l.EmployeeId)
            .Select(g => new { EmpId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.EmpId, x => x.Count);

        // 2. Query with filters
        var query = db.AppreciationLetters
            .Include(l => l.Employee)
                .ThenInclude(e => e.Formation)
            .Include(l => l.TitleLookup)
            .Include(l => l.Type)
            .AsNoTracking();

        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            var q = filterSearch.Trim();
            query = query.Where(l =>
                (l.Employee != null && (l.Employee.Name.Contains(q) || l.Employee.EmployeeID.Contains(q))) ||
                (l.LetterNumber != null && l.LetterNumber.Contains(q)) ||
                (l.Title != null && l.Title.Contains(q)) ||
                (l.Notes != null && l.Notes.Contains(q)));
        }

        if (int.TryParse(filterTitleId, out var tid))
        {
            query = query.Where(l => l.TitleId == tid);
        }

        if (int.TryParse(filterTypeId, out var typId))
        {
            query = query.Where(l => l.TypeId == typId);
        }

        if (int.TryParse(filterFormationId, out var fid))
        {
            query = query.Where(l => l.Employee != null && l.Employee.FormationId == fid);
        }

        if (DateOnly.TryParse(filterDateFrom, out var dFrom))
        {
            query = query.Where(l => l.LetterDate >= dFrom);
        }

        if (DateOnly.TryParse(filterDateTo, out var dTo))
        {
            query = query.Where(l => l.LetterDate <= dTo);
        }

        filteredTotalCount = await query.CountAsync();

        displayedLetters = await query
            .OrderByDescending(l => l.LetterDate)
            .ThenByDescending(l => l.Id)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        isLoading = false;
        StateHasChanged();
    }

    // Filter event handlers
    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        filterSearch = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task OnTitleFilterChanged(ChangeEventArgs e)
    {
        filterTitleId = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadDataAsync();
    }

