    private async Task ExecuteDeleteLetter()
    {
        if (letterToDelete == null) return;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var entity = await db.AppreciationLetters.FindAsync(letterToDelete.Id);
            if (entity != null)
            {
                db.AppreciationLetters.Remove(entity);
                await db.SaveChangesAsync();
            }

            isConfirmDeleteOpen = false;
            letterToDelete = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete appreciation letter");
        }
    }

