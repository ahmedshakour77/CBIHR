@page "/appreciation-letters"
@page "/letters"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using API.HR.Node.Services.ProfilePhotos
@attribute [Authorize(Roles = "Admin,HRManager,FormationManager,Supervisor")]

@inject IServiceScopeFactory ScopeFactory
@inject IEmployeeProfilePhotoService PhotoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject ILogger<AppreciationLetters> Logger

<PageTitle>سجلات وإدارة كتب الشكر والتقدير | منظومة الموارد البشرية</PageTitle>

<div class="hr-stack">

    @* ---------- 1. Page Header & Actions ---------- *@
    <header class="hr-pagehead hr-no-print">
        <div class="hr-pagehead-titles">
            <nav class="hr-crumbs" aria-label="مسار التنقل">
                <a href="" class="hr-crumb">
                    <Icon Name="home" Size="xs" />
                    <span>الرئيسية</span>
                </a>
                <span class="hr-crumb-sep" aria-hidden="true">/</span>
                <span class="hr-crumb is-current" aria-current="page">كتب الشكر والتقدير</span>
            </nav>
            <h1 class="hr-h1" style="margin-block-start:.5rem">إدارة وسجلات كتب الشكر والتقدير</h1>
            <p class="hr-sub hr-measure" style="margin-block-start:.25rem">
                توثيق ومتابعة كتب الشكر والتقدير والتكريم الوزاري والمؤسسي، واحتساب أشهر القِدم المكتسبة للموظفين وفق القوانين والأنظمة النافذة.
            </p>
        </div>

        <div class="hr-pagehead-actions">
            <button type="button" class="hr-btn hr-btn-primary" @onclick="OpenCreateLetterModal">
                <Icon Name="plus" Size="xs" />
                <span>إضافة كتاب شكر جديد</span>
            </button>

            <button type="button" class="hr-btn hr-btn-secondary" @onclick="OpenTypesManagementModal">
                <Icon Name="cog-6-tooth" Size="xs" />
                <span>إدارة أنواع الكتب والقِدم</span>
            </button>

            <a href="data-import" class="hr-btn hr-btn-secondary">
                <Icon Name="arrow-up-tray" Size="xs" />
                <span>استيراد ملف Excel</span>
            </a>

            <button type="button" class="hr-btn hr-btn-secondary hr-btn-icon" @onclick="PrintPage" title="طباعة الصفحة" aria-label="طباعة الصفحة">
                <Icon Name="printer" Size="xs" />
            </button>
        </div>
    </header>

    @* ---------- 2. Top Executive KPI Cards ---------- *@
    <section class="hr-grid-kpi hr-no-print" aria-label="مؤشرات كتب الشكر العامة">
        <article class="hr-kpi">
            <div class="hr-kpi-head">
                <span class="hr-kpi-label">إجمالي سجلات كتب الشكر</span>
                <span class="hr-iconplate" aria-hidden="true"><Icon Name="document-text" Size="sm" /></span>
            </div>
            <div class="hr-kpi-value">
                <span class="hr-num">@N(totalRecordsCount)</span>
                <span class="hr-kpi-unit">سجل</span>
            </div>
            <p class="hr-kpi-hint">كتاب شكر مسجل وموثق في المنظومة</p>
        </article>

        <article class="hr-kpi">
            <div class="hr-kpi-head">
                <span class="hr-kpi-label">إجمالي القِدم المكتسب</span>
                <span class="hr-iconplate" aria-hidden="true"><Icon Name="academic-cap" Size="sm" /></span>
            </div>
            <div class="hr-kpi-value">
                <span class="hr-num" style="font-size:var(--fs-title)">@totalSeniorityFormattedText</span>
            </div>
            <p class="hr-kpi-hint">مجموع مدد القِدم المحتسبة للترقيات والعلاوات وفق الأنواع المعتمدة</p>
        </article>

        <article class="hr-kpi">
            <div class="hr-kpi-head">
                <span class="hr-kpi-label">الموظفون المكرّمون</span>
                <span class="hr-iconplate hr-iconplate-ok" aria-hidden="true"><Icon Name="users" Size="sm" /></span>
            </div>
            <div class="hr-kpi-value">
                <span class="hr-num">@N(honoredEmployeesCount)</span>
                <span class="hr-kpi-unit">موظفاً</span>
            </div>
            <p class="hr-kpi-hint">موظف حاصل على كتاب شكر واحد على الأقل</p>
        </article>

        <article class="hr-kpi">
            <div class="hr-kpi-head">
                <span class="hr-kpi-label">عناوين وأنواع الشكر</span>
                <span class="hr-iconplate" aria-hidden="true"><Icon Name="squares-2x2" Size="sm" /></span>
            </div>
            <div class="hr-kpi-value">
                <span class="hr-num">@N(titlesCount)</span>
                <span class="hr-kpi-unit">تصنيف</span>
            </div>
            <p class="hr-kpi-hint">عناوين وجهات شكر وتقدير معتمدة</p>
        </article>
    </section>

    @* ---------- 3. Quick Employee Dossier Lookup Bar ---------- *@
    <section class="hr-card hr-no-print" style="padding:1rem 1.25rem;border:1px solid var(--line-control);background:var(--surface-sunken)">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
            <div style="display:flex;align-items:center;gap:0.75rem">
                <span class="hr-iconplate" aria-hidden="true">
                    <Icon Name="identification" Size="sm" />
                </span>
                <div>
                    <strong style="font-size:var(--fs-body);color:var(--text)">البحث السريع عن إضبارة كتب الشكر لموظف</strong>
                    <p class="hr-sub" style="margin:0;font-size:var(--fs-label)">
                        اكتب اسم الموظف أو رقمه الوظيفي لعرض كافة كتب الشكر وأشهر القِدم الخاصة به مباشرة.
                    </p>
                </div>
            </div>

            <div style="position:relative;min-width:min(20rem, 100%);flex:1;max-width:28rem">
                <div class="hr-search">
                    <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="xs" /></span>
                    <input type="text"
                           class="hr-input hr-input-sm"
                           placeholder="ابحث بالاسم أو الرقم الوظيفي…"
                           aria-label="البحث عن موظف لعرض إضبارته"
                           value="@lookupDossierQuery"
                           @oninput="OnDossierSearchInput"
                           @onfocus="() => showDossierDropdown = true" />
                </div>

                @if (showDossierDropdown && dossierSearchResults.Any())
                {
                    <div class="hr-popover" style="position:absolute;top:calc(100% + 4px);left:0;right:0;max-height:18rem;overflow-y:auto;z-index:calc(var(--z-popover) + 1);">
                        @foreach (var emp in dossierSearchResults)
                        {
                            <button type="button" class="hr-menu-item" @onclick="() => SelectEmployeeForDossier(emp.Id)">
                                <span class="hr-avatar hr-avatar-sm" aria-hidden="true">
                                    @AvatarInitials.FromName(emp.Name)
                                </span>
                                <div style="flex:1;text-align:right">
                                    <div style="font-weight:700;font-size:var(--fs-control)">@emp.Name</div>
                                    <div class="hr-meta" style="font-size:var(--fs-caption)">
                                        <span class="hr-num">#@emp.EmployeeID</span> · @(emp.Formation?.Name ?? "غير محدد")
                                    </div>
                                </div>
                                <span class="hr-badge">
                                    @N(empLetterCounts.GetValueOrDefault(emp.Id, 0)) كتب
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    @* ---------- 4. Filter Toolbar ---------- *@
    <section class="hr-toolbar hr-no-print" aria-label="أدوات التصفية والفرز">
        <div class="hr-toolbar-group" style="flex:1;min-width:14rem">
            <div class="hr-search" style="width:100%">
                <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="xs" /></span>
                <input type="text"
                       class="hr-input hr-input-sm"
                       placeholder="بحث بالاسم، الرقم الوظيفي، رقم الكتاب، أو الملاحظات…"
                       aria-label="بحث في كتب الشكر"
                       value="@filterSearch"
                       @oninput="OnSearchChanged" />
            </div>
        </div>

        @* كتب الشكر (قائمة منسدلة) *@
        <div class="hr-toolbar-group">
            <select class="hr-select hr-input-sm" aria-label="تصفية حسب عنوان كتاب الشكر" value="@filterTitleId" @onchange="OnTitleFilterChanged">
                <option value="">جميع كتب الشكر (العناوين)</option>
                @foreach (var t in availableTitles)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>

        @* نوع كتب شكر (قائمة منسدلة) *@
        <div class="hr-toolbar-group">
            <select class="hr-select hr-input-sm" aria-label="تصفية حسب نوع كتاب الشكر" value="@filterTypeId" @onchange="OnTypeFilterChanged">
                <option value="">جميع أنواع كتب الشكر</option>
                @foreach (var t in availableTypes)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>

        @* التشكيل *@
        <div class="hr-toolbar-group">
            <select class="hr-select hr-input-sm" aria-label="تصفية حسب التشكيل" value="@filterFormationId" @onchange="OnFormationFilterChanged">
                <option value="">جميع التشكيلات</option>
                @foreach (var f in availableFormations)
                {
                    <option value="@f.Id">@f.Name</option>
                }
            </select>
        </div>

        @* التواريخ *@
        <div class="hr-toolbar-group" style="display:flex;gap:0.25rem;align-items:center;flex:1 1 18rem">
            <input type="date" class="hr-input hr-input-sm" style="flex:1;min-width:0" value="@filterDateFrom" @onchange="OnDateFromChanged" title="من تاريخ" aria-label="من تاريخ" />
            <span class="hr-meta">—</span>
            <input type="date" class="hr-input hr-input-sm" style="flex:1;min-width:0" value="@filterDateTo" @onchange="OnDateToChanged" title="إلى تاريخ" aria-label="إلى تاريخ" />
        </div>

        @if (HasActiveFilters)
        {
            <div class="hr-toolbar-group">
                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ClearFilters" title="إعادة تعيين الفلاتر">
                    <Icon Name="x-mark" Size="xs" />
                    <span>مسح الفلاتر</span>
                </button>
            </div>
        }
    </section>

    @* ---------- 5. Data Table Section ---------- *@
    <section class="hr-card" style="padding:0;overflow:hidden">
        <div class="hr-tablewrap">
            <table class="hr-table" aria-label="جدول كتب الشكر والتقدير">
                <thead>
                    <tr>
                        <th scope="col" style="width:3.5rem">#</th>
                        <th scope="col" style="min-width:14rem">الموظف والتشكيل</th>
                        <th scope="col" style="min-width:12rem">كتاب الشكر (العنوان)</th>
                        <th scope="col" style="min-width:8rem">نوع الكتاب</th>
                        <th scope="col" style="min-width:8rem">رقم الكتاب</th>
                        <th scope="col" style="min-width:7.5rem">تاريخ الصدور</th>
                        <th scope="col" style="min-width:7rem">العدد والقِدم</th>
                        <th scope="col">الملاحظات</th>
                        <th scope="col" class="hr-no-print" style="width:7.5rem;text-align:center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="9" style="text-align:center;padding:3rem">
                                <div style="display:inline-flex;align-items:center;gap:0.75rem;color:var(--text-muted)">
                                    <span class="hr-spinner" aria-hidden="true"></span>
                                    <span>جارٍ تحميل سجلات كتب الشكر والتقدير…</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!displayedLetters.Any())
                    {
                        <tr>
                            <td colspan="9" style="text-align:center;padding:3rem">
                                <div style="display:inline-flex;flex-direction:column;align-items:center;gap:0.5rem">
                                    <span class="hr-iconplate" style="width:3rem;height:3rem" aria-hidden="true">
                                        <Icon Name="document-text" Size="md" />
                                    </span>
                                    <strong style="color:var(--text);font-size:var(--fs-lead)">لا توجد سجلات كتب شكر مطابقة للبحث</strong>
                                    <p class="hr-sub" style="margin:0;font-size:var(--fs-label)">
                                        جرّب تغيير كلمات البحث أو مسح الفلاتر، أو قم بإضافة كتاب شكر جديد.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowIdx = (currentPage - 1) * pageSize;
                        @foreach (var letter in displayedLetters)
                        {
                            rowIdx++;
                            var emp = letter.Employee;
                            <tr>
                                <td class="hr-meta hr-num" style="font-size:var(--fs-caption)">@rowIdx</td>

                                <td>
                                    <div style="display:flex;align-items:center;gap:0.625rem">
                                        <span class="hr-avatar hr-avatar-sm" aria-hidden="true">
                                            @AvatarInitials.FromName(emp?.Name)
                                        </span>
                                        <div>
                                            <button type="button"
                                                    class="hr-linklike"
                                                    style="font-weight:700;font-size:var(--fs-control);text-align:right"
                                                    @onclick="() => OpenDossierModal(letter.EmployeeId)">
                                                @(emp?.Name ?? "غير معروف")
                                            </button>
                                            <div class="hr-meta" style="font-size:var(--fs-caption)">
                                                <span class="hr-num">#@(emp?.EmployeeID ?? "—")</span> · @(emp?.Formation?.Name ?? "غير محدد")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span style="font-weight:700;color:var(--text)">
                                        @(letter.TitleLookup?.Name ?? letter.Title ?? "كتاب شكر وتقدير")
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(letter.Type?.Name))
                                    {
                                        <span class="hr-badge hr-badge">@letter.Type.Name</span>
                                    }
                                    else
                                    {
                                        <span class="hr-meta">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(letter.LetterNumber))
                                    {
                                        <span class="hr-badge hr-num">
                                            @letter.LetterNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hr-meta">—</span>
                                    }
                                </td>

                                <td class="hr-num" style="font-size:var(--fs-label)">
                                    @(letter.LetterDate?.ToString("yyyy/MM/dd") ?? "—")
                                </td>

                                <td>
                                    <div style="display:inline-flex;align-items:center;gap:0.35rem">
                                        @if (HasSeniority(letter.Type))
                                        {
                                            <span class="hr-badge hr-badge-ok hr-num" style="font-weight:700">
                                                @FormatSeniority(letter)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge hr-num" style="opacity:0.75">
                                                بدون قِدم
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td class="hr-meta hr-truncate" style="max-width:14rem" title="@letter.Notes">
                                    @(string.IsNullOrWhiteSpace(letter.Notes) ? "—" : letter.Notes)
                                </td>

                                <td class="hr-no-print" style="text-align:center">
                                    <div style="display:inline-flex;gap:0.25rem;align-items:center">
                                        <button type="button"
                                                class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                                                title="عرض إضبارة كتب الشكر للموظف" aria-label="عرض إضبارة كتب الشكر للموظف"
                                                @onclick="() => OpenDossierModal(letter.EmployeeId)">
                                            <Icon Name="eye" Size="xs" />
                                        </button>
                                        <button type="button"
                                                class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                                                title="تعديل كتاب الشكر" aria-label="تعديل كتاب الشكر"
                                                @onclick="() => OpenEditLetterModal(letter)">
                                            <Icon Name="pencil-square" Size="xs" />
                                        </button>
                                        <button type="button"
                                                class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm hr-text-danger"
                                                title="حذف السجل" aria-label="حذف السجل"
                                                @onclick="() => PromptDeleteLetter(letter)">
                                            <Icon Name="trash" Size="xs" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ---------- 6. Table Pagination & Info ---------- *@
        <div class="hr-table-pagination hr-no-print" style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1.25rem;border-top:1px solid var(--line);flex-wrap:wrap;gap:0.75rem">
            <div class="hr-meta" style="font-size:var(--fs-label)">
                إظهار <strong>@displayedLetters.Count</strong> من إجمالي <strong>@filteredTotalCount</strong> كتاب شكر
            </div>

            <div style="display:flex;align-items:center;gap:0.5rem">
                <span class="hr-meta" style="font-size:var(--fs-label)">لكل صفحة:</span>
                <select class="hr-select hr-input-sm" aria-label="عدد السجلات في الصفحة" value="@pageSize" @onchange="OnPageSizeChanged" style="width:auto">
                    <option value="15">15</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>

                <div class="hr-pager" style="margin:0">
                    <button type="button"
                            class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                            disabled="@(currentPage <= 1)"
                            aria-label="الصفحة السابقة"
                            @onclick="() => GoToPage(currentPage - 1)">
                        <Icon Name="chevron-right" Size="xs" />
                    </button>
                    <span class="hr-meta" style="font-size:var(--fs-label);padding:0 0.5rem">
                        صفحة <strong>@currentPage</strong> من <strong>@totalPages</strong>
                    </span>
                    <button type="button"
                            class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                            disabled="@(currentPage >= totalPages)"
                            aria-label="الصفحة التالية"
                            @onclick="() => GoToPage(currentPage + 1)">
                        <Icon Name="chevron-left" Size="xs" />
                    </button>
                </div>
            </div>
        </div>
    </section>
</div>

@* ======================================================== *@
@* MODAL 1: CREATE / EDIT APPRECIATION LETTER               *@
@* ======================================================== *@
@if (isLetterModalOpen)
{
    <Modal IsOpen="@isLetterModalOpen"
           Title="@(editingLetterId.HasValue ? "تعديل كتاب شكر وتقدير" : "تسجيل كتاب شكر وتقدير جديد")"
           Subtitle="توثيق كتاب الشكر واحتساب القِدم الوظيفي المستحق للموظف"
           Icon="document-text"
           Size="lg"
           OnClose="CloseLetterModal">
        <Body>
            <div class="hr-stack" style="gap:1.25rem">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="hr-alert hr-alert-danger" role="alert">
                        <Icon Name="shield-exclamation" Size="xs" />
                        <span>@modalError</span>
                    </div>
                }

                @* اختيار الموظف *@
                <div class="hr-field">
                    <label for="f-appreciation-letters-1" class="hr-label">
                        الموظف المكرم <span class="hr-req" aria-hidden="true">*</span>
                    </label>
                    @if (editingLetterId.HasValue)
                    {
                        <div class="hr-input" style="display:flex;align-items:center;gap:0.5rem;background:var(--surface-sunken)">
                            <span class="hr-avatar hr-avatar-xs">@AvatarInitials.FromName(selectedEmployeeName)</span>
                            <strong>@selectedEmployeeName</strong>
                            <span class="hr-meta">(#@selectedEmployeeCode)</span>
                        </div>
                    }
                    else
                    {
                        <div style="position:relative">
                            <div class="hr-search">
                                <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="xs" /></span>
                                <input type="text"
                                       class="hr-input"
                                       placeholder="ابحث بالاسم أو الرقم الوظيفي لاختيار الموظف…"
                                       aria-label="البحث عن الموظف المكرم"
                                       value="@employeeModalSearchQuery"
                                       @oninput="OnModalEmployeeSearchInput"
                                       @onfocus="() => showModalEmpDropdown = true" />
                            </div>

                            @if (showModalEmpDropdown && modalEmpSearchResults.Any())
                            {
                                <div class="hr-popover" style="position:absolute;top:calc(100% + 4px);left:0;right:0;max-height:14rem;overflow-y:auto;z-index:calc(var(--z-popover) + 1)">
                                    @foreach (var emp in modalEmpSearchResults)
                                    {
                                        <button type="button" class="hr-menu-item" @onclick="() => SelectModalEmployee(emp)">
                                            <span class="hr-avatar hr-avatar-sm">@AvatarInitials.FromName(emp.Name)</span>
                                            <div style="flex:1;text-align:right">
                                                <div style="font-weight:700">@emp.Name</div>
                                                <div class="hr-meta" style="font-size:var(--fs-caption)">#@emp.EmployeeID · @(emp.Formation?.Name ?? "غير محدد")</div>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        @if (letterModel.EmployeeId > 0)
                        {
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.35rem;padding:0.35rem 0.625rem;border-radius:var(--r);background:var(--accent-tint)">
                                <Icon Name="check-circle" Size="xs" Class="text-accent" />
                                <span style="font-weight:700;font-size:var(--fs-label)">تم اختيار: @selectedEmployeeName (#@selectedEmployeeCode)</span>
                            </div>
                        }
                    }
                </div>

                <div class="hr-grid-2">
                    @* كتب الشكر (قائمة منسدلة) *@
                    <div class="hr-field">
                        <label for="f-appreciation-letters-1" class="hr-label">
                            كتب الشكر (العنوان / الجهة المانحة) <span class="hr-req" aria-hidden="true">*</span>
                        </label>
                        <select id="f-appreciation-letters-1" class="hr-select" value="@selectedTitleOption" @onchange="OnTitleSelectionChanged">
                            <option value="">-- اختر عنوان / جهة كتاب الشكر --</option>
                            @foreach (var t in availableTitles)
                            {
                                <option value="@t.Name">@t.Name</option>
                            }
