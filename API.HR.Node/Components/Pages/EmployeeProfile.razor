    private List<ServicePeriodDisplay> GetServicePeriods()
    {
        var list = new List<ServicePeriodDisplay>();
        if (employee == null) return list;

        var today = DateOnly.FromDateTime(DateTime.Today);

        if (careerMovements.Count == 0)
        {
            var start = employee.HireDate ?? today;
            var (y, m, d) = CalculateYMD(start, today);
            list.Add(new ServicePeriodDisplay(
                Id: 0,
                StartDate: start,
                EndDate: today,
                FormationName: employee.Formation?.Name ?? "الجهة الحالية / مستمر بالخدمة",
                CountForAllowance: true,
                CountForPromotion: true,
                CountForPension: true,
                Notes: "فترة خدمة فعلية مستمرة",
                Years: y,
                Months: m,
                Days: d,
                IsCurrent: true
            ));
            return list;
        }

        var ordered = careerMovements.OrderBy(m => m.MovementDate).ToList();
        for (var i = 0; i < ordered.Count; i++)
        {
            var current = ordered[i];
            var start = current.MovementDate;
            DateOnly end;
            bool isCurr = false;

            if (i < ordered.Count - 1)
            {
                var nextDate = ordered[i + 1].MovementDate;
                end = nextDate > start ? nextDate.AddDays(-1) : start;
            }
            else
            {
                end = today >= start ? today : start;
                isCurr = true;
            }

            var (y, m, d) = CalculateYMD(start, end);
            list.Add(new ServicePeriodDisplay(
                Id: current.Id,
                StartDate: start,
                EndDate: end,
                FormationName: current.FormationName,
                CountForAllowance: current.CountForAllowance,
                CountForPromotion: current.CountForPromotion,
                CountForPension: current.CountForPension,
                Notes: current.Notes,
                Years: y,
                Months: m,
                Days: d,
                IsCurrent: isCurr
            ));
        }

        return list;
    }

    private string GetPenaltyFormation(EmployeePenalty pen)
    {
        // 1. If penalty date exists and career movements are recorded, match the exact formation at that time
        if (pen.PenaltyDate.HasValue && careerMovements.Count > 0)
        {
            var pDate = pen.PenaltyDate.Value;
            var periods = GetServicePeriods();
            var match = periods.FirstOrDefault(p => pDate >= p.StartDate && pDate <= p.EndDate);
            if (match != null && !string.IsNullOrWhiteSpace(match.FormationName))
            {
                return match.FormationName;
            }

            var prior = careerMovements
                .Where(m => m.MovementDate <= pDate)
                .OrderByDescending(m => m.MovementDate)
                .FirstOrDefault();

            if (prior != null && !string.IsNullOrWhiteSpace(prior.FormationName))
            {
                return prior.FormationName;
            }
        }

        // 2. Fallback to current formation
        return employee?.Formation?.Name ?? "—";
    }

    private static (int years, int months, int days) CalculateYMD(DateOnly from, DateOnly to)
    {
        if (to < from) return (0, 0, 0);

        var end = to.AddDays(1);
        var years = end.Year - from.Year;
        var months = end.Month - from.Month;
        var days = end.Day - from.Day;

        if (days < 0)
        {
            months--;
            var prevMonth = end.AddMonths(-1);
            days += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }

        return (Math.Max(0, years), Math.Max(0, months), Math.Max(0, days));
    }

