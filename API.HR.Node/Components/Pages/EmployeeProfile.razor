            }
        }
        finally
        {
            isPerformingLifecycle = false;
        }
    }

    private async Task ToggleVehicleAuthInProfile(EmployeeVehicle vehicle)
    {
        if (!isStaff) return;
        var newStatus = !vehicle.IsAuthorized;
        var ok = await VehicleService.ToggleAuthorizationAsync(vehicle.Id, newStatus);
        if (ok)
        {
            vehicle.IsAuthorized = newStatus;
            Toast.Success(newStatus ? "تم تفعيل تخويل دخول المركبة" : "تم إيقاف تخويل دخول المركبة");
            StateHasChanged();
        }
