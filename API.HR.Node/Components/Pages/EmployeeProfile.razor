    private async Task TryParseOrResolveUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(modalLocationUrl))
        {
            locationDetectionStatus = null;
            return;
        }

        var direct = EmployeeResidence.ParseCoordinates(modalLocationUrl);
        if (direct.HasValue)
        {
            modalLatitude = direct.Value.Lat;
            modalLongitude = direct.Value.Lng;
            locationDetectionStatus = $"تم التقاط الموقع بنجاح: {modalLatitude:F5}, {modalLongitude:F5}";
            return;
        }

        if (modalLocationUrl.Contains("maps.app.goo.gl", StringComparison.OrdinalIgnoreCase) ||
            modalLocationUrl.Contains("goo.gl/maps", StringComparison.OrdinalIgnoreCase))
        {
            isResolvingLocation = true;
            locationDetectionStatus = "جارِ فحص الرابط وفك الرابط المختصر...";
            StateHasChanged();
            try
            {
                var resolved = await EmployeeResidence.ResolveUrlAndCoordinatesAsync(modalLocationUrl);
                if (resolved.HasValue)
                {
                    modalLatitude = resolved.Value.Lat;
                    modalLongitude = resolved.Value.Lng;
                    locationDetectionStatus = $"تم فك الرابط واستخراج الموقع بدقة: {modalLatitude:F5}, {modalLongitude:F5}";
                }
                else
                {
                    locationDetectionStatus = "تعذر استخراج الإحداثيات تلقائياً من الرابط. يمكنك إدخال خط العرض والطول يدوياً.";
                }
            }
            finally
            {
                isResolvingLocation = false;
            }
        }
        else
        {
            locationDetectionStatus = "لم يتم التعرف على إحداثيات صريحة. يمكنك إدخال خط العرض والطول في الحقلين أدناه.";
        }
    }

    private async Task GetCurrentLocationAsync()
    {
        try
        {
            var coords = await JSRuntime.InvokeAsync<double[]>("eval", "new Promise((resolve, reject) => { if (!navigator.geolocation) { reject('No geolocation'); return; } navigator.geolocation.getCurrentPosition(pos => resolve([pos.coords.latitude, pos.coords.longitude]), err => reject(err.message), { enableHighAccuracy: true, timeout: 10000 }); })");
            if (coords != null && coords.Length == 2)
            {
                modalLatitude = Math.Round(coords[0], 6);
                modalLongitude = Math.Round(coords[1], 6);
                modalLocationUrl = $"https://www.google.com/maps?q={modalLatitude},{modalLongitude}";
                locationDetectionStatus = $"تم التقاط موقعك الجغرافي الحالي بنجاح: {modalLatitude}, {modalLongitude}";
            }
        }
        catch
        {
            locationDetectionStatus = "تعذر تحديد الموقع الجغرافي للجهاز. يرجى التأكد من تفعيل إذن الموقع في المتصفح.";
        }
    }

    private async Task HandleResidenceCardSelected(InputFileChangeEventArgs e, bool isFront)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            residenceModalError = "حجم الملف المرفق يتجاوز الحد المسموح (10 ميغابايت).";
            return;
        }

        // An identity card is a photo or a scan: nothing else is stored or served back.
        if (!ResidenceCardExtensions.Contains(Path.GetExtension(file.Name)))
        {
            residenceModalError = "نوع الملف غير مدعوم. المسموح: JPG أو PNG أو WEBP أو PDF.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            if (isFront)
            {
                modalCardFrontFile = file;
                modalCardFrontBytes = bytes;
                modalCardFrontPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            }
            else
            {
                modalCardBackFile = file;
                modalCardBackBytes = bytes;
                modalCardBackPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            }
        }
        catch (Exception ex)
        {
            residenceModalError = $"تعذر قراءة الملف: {ex.Message}";
        }
    }

