    private static string FormatDuration(int years, int months, int days)
    {
        var parts = new List<string>();
        if (years > 0) parts.Add($"{years} سنة");
        if (months > 0) parts.Add($"{months} شهر");
        if (days > 0 || parts.Count == 0) parts.Add($"{days} يوم");
        return string.Join(" و ", parts);
    }

    private string GetNetAllowanceServiceText()
    {
        var periods = GetServicePeriods().Where(p => p.CountForAllowance).ToList();
        return CalculateAggregateDuration(periods);
    }

    private string GetNetPromotionServiceText()
    {
        var periods = GetServicePeriods().Where(p => p.CountForPromotion).ToList();
        return CalculateAggregateDuration(periods);
    }

    private string GetNetPensionServiceText()
    {
        var periods = GetServicePeriods().Where(p => p.CountForPension).ToList();
        return CalculateAggregateDuration(periods);
    }

    private static string CalculateAggregateDuration(IEnumerable<ServicePeriodDisplay> periods)
    {
        var totalDays = 0;
        foreach (var p in periods)
        {
            totalDays += (p.EndDate.DayNumber - p.StartDate.DayNumber + 1);
        }

        if (totalDays <= 0) return "0 يوم";

        var y = totalDays / 365;
        var rem = totalDays % 365;
        var m = rem / 30;
        var d = rem % 30;

        return FormatDuration(y, m, d);
    }

    private static string FormatGradeAndStageValue(string? grade, string? stage)
    {
        var g = string.IsNullOrWhiteSpace(grade)
            ? "بدون درجة"
            : (grade.StartsWith("الدرجة") ? grade : $"الدرجة {grade}");

        var s = string.IsNullOrWhiteSpace(stage)
            ? "بدون مرحلة"
            : (stage.StartsWith("المرحلة") ? stage : $"المرحلة {stage}");

        return $"{g} / {s}";
    }

