    private void ApplyMrzScan()
    {
        mrzScanSuccessNotice = null;
        passportModalError = null;

        var text = string.IsNullOrWhiteSpace(mrzInputDraft) ? modalPassportRawMrz : mrzInputDraft;
        if (string.IsNullOrWhiteSpace(text))
        {
            passportModalError = "يرجى إدخال أو لصق أسطر الـ MRZ للجواز (سطرين × 44 حرفاً).";
            return;
        }

        var result = PassportReader.ParseMrz(text);
        if (!result.IsValid)
        {
            passportModalError = string.Join(" · ", result.ValidationErrors);
            return;
        }

        modalPassportNumber = result.PassportNumber;
        modalPassportType = result.DocumentType;
        modalPassportCountryCode = result.IssuingCountry;
        modalPassportIssuingCountry = result.IssuingCountry == "IRQ" ? "العراق" : result.IssuingCountry;
        modalPassportFullNameEn = result.FullNameEn;
        modalPassportDateOfBirth = result.DateOfBirth;
        modalPassportGender = result.Gender;
        modalPassportExpiryDate = result.ExpiryDate;
        modalPassportRawMrz = text.Trim();
        if (!string.IsNullOrEmpty(result.NationalIdNumber))
        {
            modalPassportNationalId = result.NationalIdNumber;
        }

        mrzScanSuccessNotice = result.IsCheckDigitsValid 
            ? "تم فك تشفير وتدقيق الـ MRZ بنجاح وفق معيار ICAO 9303 (الأرقام الرياضية مطابقة ومعتمدة 100%)."
            : "تم استخراج البيانات، مع ملاحظة تدقيق: " + string.Join(" · ", result.ValidationErrors);
    }

    private void ApplyChipReading()
    {
        chipScanSuccessNotice = null;
        passportModalError = null;

        var req = new PassportChipDataRequest
        {
            Dg1Mrz = string.IsNullOrWhiteSpace(chipDg1Mrz) ? modalPassportRawMrz : chipDg1Mrz,
            Dg2BiometricPhotoBase64 = chipDg2PhotoBase64,
            Dg11FullNameAr = chipDg11NameAr,
            Dg11MotherName = chipDg11Mother,
            Dg11PlaceOfBirth = chipDg11PlaceOfBirth
        };

        var result = PassportReader.ParseChipData(req);
        if (!result.Success && result.Errors.Count > 0)
        {
            passportModalError = string.Join(" · ", result.Errors);
            return;
        }

        if (result.MrzInfo != null && result.MrzInfo.IsValid)
        {
            modalPassportNumber = result.MrzInfo.PassportNumber;
            modalPassportType = result.MrzInfo.DocumentType;
            modalPassportCountryCode = result.MrzInfo.IssuingCountry;
            modalPassportIssuingCountry = result.MrzInfo.IssuingCountry == "IRQ" ? "العراق" : result.MrzInfo.IssuingCountry;
            modalPassportFullNameEn = result.MrzInfo.FullNameEn;
            modalPassportDateOfBirth = result.MrzInfo.DateOfBirth;
            modalPassportGender = result.MrzInfo.Gender;
            modalPassportExpiryDate = result.MrzInfo.ExpiryDate;
            modalPassportRawMrz = req.Dg1Mrz;
        }

        if (!string.IsNullOrWhiteSpace(result.FullNameAr)) modalPassportFullNameAr = result.FullNameAr;
        if (!string.IsNullOrWhiteSpace(result.MotherName)) modalPassportMotherName = result.MotherName;
        if (!string.IsNullOrWhiteSpace(result.PlaceOfBirth)) modalPassportPlaceOfBirth = result.PlaceOfBirth;
        if (!string.IsNullOrWhiteSpace(result.NationalId)) modalPassportNationalId = result.NationalId;

        if (result.BiometricPhotoBytes != null && result.BiometricPhotoBytes.Length > 0)
        {
            modalBiometricPhotoBytes = result.BiometricPhotoBytes;
            modalBiometricPhotoPreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(result.BiometricPhotoBytes)}";
        }

        chipScanSuccessNotice = "تم تفريغ كافة بيانات شريحة الجواز الإلكتروني والصورة البيومترية بنجاح.";
    }

    private async Task HandlePassportImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            passportModalError = "حجم صورة الجواز يتجاوز الحد المسموح (10 ميغابايت).";
            return;
        }

        if (!ResidenceCardExtensions.Contains(Path.GetExtension(file.Name)))
        {
            passportModalError = "نوع الملف غير مدعوم. المسموح: JPG أو PNG أو WEBP أو PDF.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            modalPassportImageFile = file;
            modalPassportImageBytes = bytes;
            modalPassportImagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            passportModalError = null;

            // Trigger Automatic OCR directly on the uploaded image
            if (file.ContentType.StartsWith("image/"))
            {
                await TriggerPassportOcrAsync(modalPassportImagePreviewUrl);
            }
        }
        catch (Exception ex)
        {
            passportModalError = $"تعذر قراءة ملف صورة الجواز: {ex.Message}";
        }
    }

    private async Task TriggerPassportOcrAsync(string dataUrl)
    {
        isScanningOcr = true;
        mrzScanSuccessNotice = null;
        ocrScanWarning = null;
        StateHasChanged();

        try
        {
            var res = await JSRuntime.InvokeAsync<PassportOcrJsResult>("scanPassportImageMrz", dataUrl);
            if (res != null && res.Success && !string.IsNullOrWhiteSpace(res.Mrz))
            {
                var mrzParsed = PassportReader.ParseMrz(res.Mrz);
                if (mrzParsed.IsValid)
                {
                    modalPassportNumber = mrzParsed.PassportNumber;
                    modalPassportType = mrzParsed.DocumentType;
                    modalPassportCountryCode = mrzParsed.IssuingCountry;
                    modalPassportIssuingCountry = mrzParsed.IssuingCountry == "IRQ" ? "العراق" : mrzParsed.IssuingCountry;
                    modalPassportFullNameEn = mrzParsed.FullNameEn;
                    modalPassportDateOfBirth = mrzParsed.DateOfBirth;
                    modalPassportGender = mrzParsed.Gender;
                    modalPassportExpiryDate = mrzParsed.ExpiryDate;
                    modalPassportRawMrz = res.Mrz;
                    mrzInputDraft = res.Mrz;
                    if (!string.IsNullOrEmpty(mrzParsed.NationalIdNumber))
                    {
                        modalPassportNationalId = mrzParsed.NationalIdNumber;
                    }
                    if (string.IsNullOrWhiteSpace(modalPassportFullNameAr))
                    {
                        modalPassportFullNameAr = employee?.Name;
                    }
                    if (string.IsNullOrWhiteSpace(modalPassportMotherName))
                    {
                        modalPassportMotherName = employee?.MotherName;
                    }

                    mrzScanSuccessNotice = mrzParsed.IsCheckDigitsValid
                        ? "تمت قراءة وفحص صورة الجواز بنجاح عبر الـ OCR وتعبئة كافة الحقول وتدقيقها رياضياً 100%! يرجى مراجعة وتأكيد البيانات أدناه ثم الضغط على حفظ."
                        : "تم استخراج البيانات من الصورة آلياً مع ملاحظة تدقيق: " + string.Join(" · ", mrzParsed.ValidationErrors);
                }
                else
                {
                    ocrScanWarning = "تمت قراءة نص من الصورة ولكن لم يكتمل مطابقة سطرين الـ MRZ. يرجى مراجعة وتعبئة الحقول أدناه يدوياً.";
                }
            }
            else
            {
                ocrScanWarning = res?.Error ?? "لم نتمكن من قراءة أسطر الـ MRZ تلقائياً من الصورة. يرجى مراجعة وتأكيد البيانات في الحقول أدناه.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Client OCR processing failed");
            ocrScanWarning = "تم رفع الصورة بنجاح. يمكنك إدخال ومراجعة البيانات في الحقول أدناه.";
        }
        finally
        {
            isScanningOcr = false;
            StateHasChanged();
        }
    }

