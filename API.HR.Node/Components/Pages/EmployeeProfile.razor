        </nav>

        @* ==================== TAB 1: BASIC PROFILE (الملف الأساسي والبيانات العامة) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Basic ? "is-active" : "")">
            <div class="hr-stack">
            
            @* ---------- SECTION 1: PERSONAL DATA (البيانات الشخصية) ---------- *@
            <section class="hr-card">
                <div class="hr-card-head">
                    <div class="hr-modal-lead">
                        <span class="hr-iconplate hr-plate-b" aria-hidden="true"><Icon Name="user" Size="sm" /></span>
                        <div class="hr-modal-titles">
                            <h2 class="hr-h2">البيانات الشخصية</h2>
                        </div>
                    </div>
                </div>

                <div class="hr-card-body">
                    <dl class="hr-deflist hr-deflist-cols">
                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="identification" Size="xs" />
                                    <span>الاسم الرباعي</span>
                                </span>
                            </dt>
                            <dd>
                                <span class="hr-cell-strong">
                                    @if (!string.IsNullOrWhiteSpace(employee.FirstName) || !string.IsNullOrWhiteSpace(employee.SecondName))
                                    {
                                        @($"{employee.FirstName} {employee.SecondName} {employee.ThirdName} {employee.FourthName}".Trim())
                                    }
                                    else
                                    {
                                        @employee.Name
                                    }
                                </span>
                            </dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="globe-alt" Size="xs" />
                                    <span>الاسم الكامل بالانكليزي</span>
                                </span>
                            </dt>
                            <dd>
                                @(nationalCard?.FullNameEn ?? employeePassport?.FullNameEn ?? TransliterateArabicToEnglish(employee.Name))
                            </dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="user-circle" Size="xs" />
                                    <span>اسم الأم</span>
                                </span>
                            </dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(employee.MotherName))
                                {
                                    <strong style="color:var(--text);">@employee.MotherName</strong>
                                }
                                else
                                {
                                    <span class="hr-meta">غير مدرج بالسجلات</span>
                                }
                            </dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="calendar-days" Size="xs" />
                                    <span>تاريخ الميلاد والعمر</span>
                                </span>
                            </dt>
                            <dd>
                                <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
                                    <span class="hr-num hr-cell-strong">@D(employee.BirthDate)</span>
                                    <span class="hr-badge hr-badge-accent"> 
                                        <span>العمر: @FormatAge(employee.BirthDate)</span>
                                    </span>
                                </div>
                            </dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="users" Size="xs" />
                                    <span>النوع الاجتماعي</span>
                                </span>
                            </dt>
                            <dd>
                                <span class="hr-badge" style="font-weight:600;">
                                    @Or(employee.Gender?.Name, "غير محدد")
                                </span>
                            </dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="heart" Size="xs" />
                                    <span>الحالة الاجتماعية</span>
                                </span>
                            </dt>
                            <dd>
                                <span class="hr-badge" style="font-weight:600;">
                                    @Or(employee.MaritalStatus?.Name, "غير محدد")
                                </span>
                            </dd>
                        </div>


                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="sparkles" Size="xs" />
                                    <span>الديانة</span>
                                </span>
                            </dt>
                            <dd>@Or(employee.Religion?.Name, "غير محدد")</dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="shield-check" Size="xs" />
                                    <span>الجنسية</span>
                                </span>
                            </dt>
                            <dd>@Or(employee.Nationality?.Name, "عراقية")</dd>
                        </div>

                        <div class="hr-deflist-row">
                            <dt>
                                <span class="hr-deflist-label">
                                    <Icon Name="clock" Size="xs" />
                                    <span>الإحالة للتقاعد</span>
                                </span>
                            </dt>
                            <dd>
                                <span class="hr-num">@D(employee.BirthDate?.AddYears(RetirementAge))</span>
                                <span class="hr-meta">(السن القانوني <span class="hr-num">@RetirementAge</span> سنة)</span>
                            </dd>
                        </div>
                    </dl>
                </div>
            </section>

                  
                    @* ---------- SECTION 2: JOB DETAILS (تفاصيل الوظيفة) ---------- *@
                    <section class="hr-card">
                        <div class="hr-card-head">
                            <div class="hr-modal-lead">
                                <span class="hr-iconplate hr-plate-a" aria-hidden="true"><Icon Name="briefcase" Size="sm" /></span>
                                <div class="hr-modal-titles">
                                    <h2 class="hr-h2">تفاصيل الوظيفة</h2>
                                </div>
                            </div>
                        </div>

                        <div class="hr-card-body">
                            <dl class="hr-deflist hr-deflist-cols">
                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="identification" Size="xs" />
                                            <span>الرقم الوظيفي</span>
                                        </span>
                                    </dt>
                                    <dd><span class="hr-num hr-cell-strong" style="font-size:var(--fs-title);color:var(--accent);">@employee.EmployeeID</span></dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="document-text" Size="xs" />
                                            <span>الرقم الوظيفي الموحد</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(employee.UnifiedEmployeeNumber))
                                        {
                                            <span class="hr-num hr-cell-strong">@employee.UnifiedEmployeeNumber</span>
                                        }
                                        else
                                        {
                                            <span class="hr-meta">غير مدرج</span>
                                        }
                                    </dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="squares-2x2" Size="xs" />
                                            <span>الوحدة الإدارية</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        @if (unitLineage.Count > 0)
                                        {
                                            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                                @foreach (var unitName in unitLineage)
                                                {
                                                    <div style="font-size:var(--fs-body); font-weight:600; color:var(--text); line-height:1.4;">
                                                        @unitName
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (effectiveUnit != null)
                                        {
                                            <div style="font-size:var(--fs-body); font-weight:600; color:var(--text);">
                                                @effectiveUnit.Name
                                            </div>
                                        }
                                        else if (managedUnits.Count > 0)
                                        {
                                            <div style="display:flex; flex-direction:column; gap:0.25rem;">
                                                @foreach (var mu in managedUnits)
                                                {
                                                    <div style="font-size:var(--fs-body); font-weight:600; color:var(--text);">
                                                        @mu.Name
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="hr-meta">غير محدد في الهيكل</span>
                                        }
                                    </dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="briefcase" Size="xs" />
                                            <span>العنوان الوظيفي</span>
                                        </span>
                                    </dt>
                                    <dd><strong style="font-size:var(--fs-lead);color:var(--text);">@Or(employee.JobTitle?.Name)</strong></dd>
                                </div>

                                @if (employee.PositionTitle != null && !string.IsNullOrWhiteSpace(employee.PositionTitle.Name) && employee.PositionTitle.Name != "غير محدد" && !employee.PositionTitle.Name.Contains("غير مكلف"))
                                {
                                    <div class="hr-deflist-row">
                                        <dt>
                                            <span class="hr-deflist-label">
                                                <Icon Name="sparkles" Size="xs" />
                                                <span>المنصب الإداري</span>
                                            </span>
                                        </dt>
                                        <dd>
                                            <span class="hr-badge hr-badge-accent">
                                                <Icon Name="briefcase" Size="xs" />
                                                <span>@employee.PositionTitle.Name</span>
                                            </span>
                                        </dd>
                                    </div>
                                }

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="square-3-stack-3d" Size="xs" />
                                            <span>الدرجة والمرحلة</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        <span class="hr-cell-strong">
                                            @(FormatGradeAndStageValue(employee.Grade?.Name, employee.Stage?.Name))
                                        </span>
                                    </dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="calendar-days" Size="xs" />
                                            <span>تاريخ التعيين والمباشرة</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                            <span class="hr-num hr-cell-strong">@D(employee.HireDate)</span>
                                            <span class="hr-meta">(@FormatServiceLength(employee.HireDate))</span>
                                        </div>
                                    </dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="clock" Size="xs" />
                                            <span>تاريخ والمدة في العنوان</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                            <span class="hr-num hr-cell-strong">@D(employee.LastJobTitleDate)</span>
                                            <span class="hr-badge" style="font-size:var(--fs-caption);">
                                                <Icon Name="clock" Size="xs" />
                                                <span>المدة: @FormatServiceLength(employee.LastJobTitleDate)</span>
                                            </span>
                                        </div>
                                    </dd>
                                </div>

                                <div class="hr-deflist-row">
                                    <dt>
                                        <span class="hr-deflist-label">
                                            <Icon Name="award" Size="xs" />
                                            <span>تاريخ آخر علاوة سنوية</span>
                                        </span>
                                    </dt>
                                    <dd>
                                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                            <span class="hr-num hr-cell-strong">@D(employee.LastAllowanceDate)</span>
                                            @if (employee.LastAllowanceDate.HasValue)
                                            {
                                                <span class="hr-badge hr-badge-success" style="font-size:var(--fs-caption);">
                                                    <Icon Name="clock" Size="xs" />
                                                    <span>المدة: @FormatServiceLength(employee.LastAllowanceDate)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="hr-meta">غير محدد</span>
                                            }
                                        </div>
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </section>

                @* ==================== 3. NATIONAL ID & CIVIL STATUS (بيانات البطاقة الوطنية الموحدة والأحوال المدنية) ==================== *@
                <section class="hr-card" style="border:1px solid color-mix(in srgb, var(--cbi-copper) 40%, var(--line));">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-d" aria-hidden="true"><Icon Name="identification" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">بيانات البطاقة الوطنية الموحدة والأحوال المدنية</h2>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(employee.NationalId))
                        {
                            <span class="hr-badge hr-badge-ok">
                                <Icon Name="check-circle" Size="xs" />
                                <span>بطاقة وطنية مسجلة وموثقة</span>
                            </span>
                        }
                        else
                        {
                            <span class="hr-badge hr-badge-warn">
                                <Icon Name="exclamation-triangle" Size="xs" />
                                <span>بانتظار استكمال البطاقة الموحدة</span>
                            </span>
                        }
                    </div>

                    <div class="hr-card-body">
                        <dl class="hr-deflist hr-deflist-cols">
                            <div class="hr-deflist-row">
                                <dt>
                                    <span class="hr-deflist-label">
                                        <Icon Name="identification" Size="xs" />
                                        <span>الرقم الوطني (البطاقة الموحدة)</span>
                                    </span>
                                </dt>
                                <dd>
                                    @if (!string.IsNullOrWhiteSpace(employee.NationalId))
                                    {
                                        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
                                            <span class="hr-num hr-cell-strong" style="font-size: var(--fs-h2); letter-spacing: 0.08em; color: var(--accent);">@employee.NationalId</span>
                                          
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                            <span class="hr-meta">غير مدرج — يمكن استكماله عبر مركز الاستيراد أو إدارة السجلات المدنية</span>
                                            <span class="hr-badge hr-badge-warn">غير مكتمل</span>
                                        </div>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </section>

                @* --- education --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-c" aria-hidden="true"><Icon Name="academic-cap" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">المؤهلات العلمية والتخصص</h2>
