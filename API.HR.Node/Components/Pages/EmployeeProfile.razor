    private static string FormatSenioritySpan(int y, int m, int d)
    {
        var parts = new List<string>();
        if (y > 0)
        {
            if (y == 1) parts.Add("سنة واحدة");
            else if (y == 2) parts.Add("سنتان");
            else if (y <= 10) parts.Add($"{y} سنوات");
            else parts.Add($"{y} سنة");
        }
        if (m > 0)
        {
            if (m == 1) parts.Add("شهر واحد");
            else if (m == 2) parts.Add("شهران");
            else if (m <= 10) parts.Add($"{m} أشهر");
            else parts.Add($"{m} شهراً");
        }
        if (d > 0)
        {
            if (d == 1) parts.Add("يوم واحد");
            else if (d == 2) parts.Add("يومان");
            else if (d <= 10) parts.Add($"{d} أيام");
            else parts.Add($"{d} يوماً");
        }
        return parts.Count > 0 ? string.Join(" و ", parts) : "بدون قِدم";
    }

    private static bool HasLetterSeniority(AppreciationLetter letter)
    {
        if (letter.Type == null) return false;
        return letter.Type.SeniorityYears > 0 || letter.Type.SeniorityMonths > 0 || letter.Type.SeniorityDays > 0;
    }

    private static string FormatLetterSeniority(AppreciationLetter letter)
    {
        var count = letter.Count ?? 1;
        if (count <= 0) count = 1;
        int y = 0, m = 0, d = 0;
        if (letter.Type != null)
        {
            y = letter.Type.SeniorityYears * count;
            m = letter.Type.SeniorityMonths * count;
            d = letter.Type.SeniorityDays * count;
        }

        m += d / 30;
        d %= 30;
        y += m / 12;
        m %= 12;
        return FormatSenioritySpan(y, m, d);
    }

    private string FormatTotalSeniority()
    {
        var sY = 0;
        var sM = 0;
        var sD = 0;
        foreach (var l in appreciationLetters)
        {
            var count = l.Count ?? 1;
            if (count <= 0) count = 1;
            if (l.Type != null)
            {
                sY += l.Type.SeniorityYears * count;
                sM += l.Type.SeniorityMonths * count;
                sD += l.Type.SeniorityDays * count;
            }
        }
        sM += sD / 30;
        sD %= 30;
        sY += sM / 12;
        sM %= 12;
        return FormatSenioritySpan(sY, sM, sD);
    }

