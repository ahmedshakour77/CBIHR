                    CreatedAt = DateTime.UtcNow
                };
                db.EmployeeMartyrs.Add(newMartyr);
            }
            else
            {
                var existing = await db.EmployeeMartyrs.FirstOrDefaultAsync(m => m.Id == editingMartyr.Id);
                if (existing != null)
                {
                    existing.MartyrName = modalMartyrName.Trim();
                    existing.MartyrdomTypeId = modalMartyrdomTypeId;
                    existing.KinshipId = modalKinshipId;
                    existing.DecisionNumber = string.IsNullOrWhiteSpace(modalDecisionNumber) ? null : modalDecisionNumber.Trim();
