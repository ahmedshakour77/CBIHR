    private async Task ToggleMovementFlag(int movementId, string flag)
    {
        if (movementId <= 0) return;

        if (!isAdmin)
        {
            ShowToast("تعديل احتساب فترات الخدمة متاح لمدير النظام (Admin) فقط.", false);
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var mov = await db.EmployeeCareerMovements.FindAsync(movementId);
            if (mov is not null)
            {
                if (flag == "allowance") mov.CountForAllowance = !mov.CountForAllowance;
                else if (flag == "promotion") mov.CountForPromotion = !mov.CountForPromotion;
                else if (flag == "pension") mov.CountForPension = !mov.CountForPension;

                await db.SaveChangesAsync();

                var local = careerMovements.FirstOrDefault(m => m.Id == movementId);
                if (local is not null)
                {
                    local.CountForAllowance = mov.CountForAllowance;
                    local.CountForPromotion = mov.CountForPromotion;
                    local.CountForPension = mov.CountForPension;
                }

                ShowToast("تم تحديث حالة احتساب الفترة بنجاح.", true);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle career movement flag for movement {MovementId}", movementId);
            ShowToast("تعذر تحديث حالة الاحتساب: " + ex.Message, false);
        }
    }

    private static string TransliterateArabicToEnglish(string? arabic)
    {
        if (string.IsNullOrWhiteSpace(arabic)) return "—";

        var nameMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["محمد"] = "Mohammed",
            ["احمد"] = "Ahmed",
            ["أحمد"] = "Ahmed",
            ["علي"] = "Ali",
            ["حسن"] = "Hassan",
            ["حسين"] = "Hussein",
            ["محمود"] = "Mahmoud",
            ["مصطفى"] = "Mustafa",
            ["عبدالله"] = "Abdullah",
            ["عبد الله"] = "Abdullah",
            ["عبد"] = "Abdul",
            ["الله"] = "Allah",
            ["الرحمن"] = "Al-Rahman",
            ["العزيز"] = "Al-Aziz",
            ["خيري"] = "Khairi",
            ["داود"] = "Dawood",
            ["داوود"] = "Dawood",
            ["خنجر"] = "Khanjar",
            ["عمر"] = "Omar",
            ["عثمان"] = "Othman",
            ["ابراهيم"] = "Ibrahim",
            ["إبراهيم"] = "Ibrahim",
            ["يوسف"] = "Youssef",
            ["خالد"] = "Khalid",
            ["سعد"] = "Saad",
            ["سعيد"] = "Saeed",
            ["فاضل"] = "Fadhil",
            ["مهدي"] = "Mehdi",
            ["جاسم"] = "Jassim",
            ["كاظم"] = "Kadhim",
            ["صالح"] = "Saleh",
            ["طارق"] = "Tariq",
            ["ياسر"] = "Yasser",
            ["ماجد"] = "Majid",
            ["كريم"] = "Karim",
            ["حيدر"] = "Haidar",
            ["زيد"] = "Zaid",
            ["فاطمة"] = "Fatima",
            ["زينب"] = "Zainab",
            ["مريم"] = "Maryam",
            ["سارة"] = "Sara",
            ["نور"] = "Noor",
            ["هدى"] = "Huda",
            ["زهراء"] = "Zahraa",
            ["آمنة"] = "Amina",
            ["اسراء"] = "Israa",
            ["إسراء"] = "Israa",
            ["وفاء"] = "Wafaa",
            ["نجاة"] = "Najat",
            ["سهير"] = "Suheir",
            ["أمل"] = "Amal",
            ["امل"] = "Amal"
        };

        var words = arabic.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var transliterated = new List<string>();

        foreach (var w in words)
        {
            if (nameMap.TryGetValue(w, out var mapped))
            {
                transliterated.Add(mapped);
            }
            else
            {
                var sb = new System.Text.StringBuilder();
                for (int i = 0; i < w.Length; i++)
                {
                    var c = w[i];
                    switch (c)
                    {
                        case 'ا': case 'أ': case 'إ': case 'آ': sb.Append(i == 0 ? "A" : "a"); break;
                        case 'ب': sb.Append(i == 0 ? "B" : "b"); break;
                        case 'ت': sb.Append(i == 0 ? "T" : "t"); break;
                        case 'ث': sb.Append(i == 0 ? "Th" : "th"); break;
                        case 'ج': sb.Append(i == 0 ? "J" : "j"); break;
                        case 'ح': sb.Append(i == 0 ? "H" : "h"); break;
                        case 'خ': sb.Append(i == 0 ? "Kh" : "kh"); break;
                        case 'د': sb.Append(i == 0 ? "D" : "d"); break;
                        case 'ذ': sb.Append(i == 0 ? "Dh" : "dh"); break;
                        case 'ر': sb.Append(i == 0 ? "R" : "r"); break;
                        case 'ز': sb.Append(i == 0 ? "Z" : "z"); break;
                        case 'س': sb.Append(i == 0 ? "S" : "s"); break;
                        case 'ش': sb.Append(i == 0 ? "Sh" : "sh"); break;
                        case 'ص': sb.Append(i == 0 ? "S" : "s"); break;
                        case 'ض': sb.Append(i == 0 ? "Dh" : "dh"); break;
                        case 'ط': sb.Append(i == 0 ? "T" : "t"); break;
                        case 'ظ': sb.Append(i == 0 ? "Z" : "z"); break;
                        case 'ع': sb.Append(i == 0 ? "A" : "a"); break;
                        case 'غ': sb.Append(i == 0 ? "Gh" : "gh"); break;
                        case 'ف': sb.Append(i == 0 ? "F" : "f"); break;
                        case 'ق': sb.Append(i == 0 ? "Q" : "q"); break;
                        case 'ك': sb.Append(i == 0 ? "K" : "k"); break;
                        case 'ل': sb.Append(i == 0 ? "L" : "l"); break;
                        case 'م': sb.Append(i == 0 ? "M" : "m"); break;
                        case 'ن': sb.Append(i == 0 ? "N" : "n"); break;
                        case 'ه': case 'ة': sb.Append(i == 0 ? "H" : "h"); break;
                        case 'و': sb.Append(i == 0 ? "W" : "w"); break;
                        case 'ي': case 'ى': case 'ئ': sb.Append(i == 0 ? "Y" : "y"); break;
                        default: sb.Append(c); break;
                    }
                }
                if (sb.Length > 0)
                {
                    var s = sb.ToString();
                    transliterated.Add(char.ToUpperInvariant(s[0]) + (s.Length > 1 ? s[1..].ToLowerInvariant() : ""));
                }
            }
        }

        return string.Join(" ", transliterated);
    }

    public record ServicePeriodDisplay(
