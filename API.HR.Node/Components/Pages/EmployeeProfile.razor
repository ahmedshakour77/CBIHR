    private string? loadedId;

    protected override async Task OnInitializedAsync()
    {
        systemFeatures = await FeatureService.GetSettingsAsync();
        FeatureService.OnSettingsChanged += HandleFeaturesChanged;
    }

    private async void HandleFeaturesChanged()
    {
        systemFeatures = await FeatureService.GetSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSetAsync runs again on every render cycle that
        // re-supplies the parameter; reloading the whole dossier each time
        // would throw away the photo and re-query for the same record.
        var curParam = EmployeeId ?? string.Empty;
        if (loadedId == curParam) return;

        loadedId = curParam;
        await LoadDossier();
    }

    private async Task LoadDossier()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        isAdmin = currentUser.IsInRole("Admin");
        isStaff = isAdmin || currentUser.IsInRole("HRManager") || currentUser.IsInRole("FormationManager") || currentUser.IsInRole("Supervisor");
        canManageLifecycle = isAdmin || currentUser.IsInRole("HRManager");
        currentUserName = currentUser.Identity?.Name ?? "User";

        isLoading = true;
        loadFailed = false;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // 1. Resolve current logged-in user's employee_id
            var myEmpId = currentUser.FindFirst("employee_id")?.Value;
            if (string.IsNullOrWhiteSpace(myEmpId))
            {
                var userEmail = currentUser.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    ?? currentUser.Identity?.Name;

                if (!string.IsNullOrWhiteSpace(userEmail))
                {
                    var matchedEmail = await db.EmployeeEmails
                        .AsNoTracking()
                        .FirstOrDefaultAsync(e => e.Email == userEmail);

                    if (matchedEmail != null)
                    {
                        myEmpId = matchedEmail.EmployeeID;
                    }
                    else
                    {
                        var appUserRecord = await db.Users
                            .AsNoTracking()
                            .FirstOrDefaultAsync(u => (u.Email != null && u.Email == userEmail)
                                || (u.UserName != null && u.UserName == userEmail));

                        if (appUserRecord != null && !string.IsNullOrWhiteSpace(appUserRecord.EmployeeID))
                        {
                            myEmpId = appUserRecord.EmployeeID;
                        }
                    }
                }
            }

            // 2. Strict role-based authorization check:
            // Ordinary employees can ONLY view their own file.
            string? targetEmpId;
            if (!isStaff)
            {
                // If they specify an EmployeeId in the URL that is not their own, redirect to their portal file
                if (!string.IsNullOrWhiteSpace(EmployeeId) && !string.IsNullOrWhiteSpace(myEmpId)
                    && !string.Equals(EmployeeId, myEmpId, StringComparison.OrdinalIgnoreCase))
                {
                    Nav.NavigateTo("portal", replace: true);
                    return;
                }

                targetEmpId = myEmpId;
            }
            else
            {
                // Staff member: use route parameter if supplied, else their own employee record, else first employee in db
                if (!string.IsNullOrWhiteSpace(EmployeeId))
                {
                    targetEmpId = EmployeeId;
                }
                else if (!string.IsNullOrWhiteSpace(myEmpId))
                {
                    targetEmpId = myEmpId;
                }
                else
                {
                    targetEmpId = await db.Employees.AsNoTracking().Select(e => e.EmployeeID).FirstOrDefaultAsync();
                }
            }

            if (string.IsNullOrWhiteSpace(targetEmpId))
            {
                loadFailed = true;
                return;
            }

            employee = await db.Employees.IgnoreQueryFilters().AsNoTracking()
                .Include(e => e.Formation)
                .Include(e => e.AdministrativeUnit)
                    .ThenInclude(u => u!.UnitType)
                .Include(e => e.JobTitle)
                .Include(e => e.PositionTitle)
                .Include(e => e.Stage)
                .Include(e => e.Grade)
                .Include(e => e.EducationLevel)
                .Include(e => e.Specialization)
                .Include(e => e.Gender)
                .Include(e => e.Religion)
                .Include(e => e.Nationality)
                .Include(e => e.MaritalStatus)
                .Include(e => e.EmployeeStatus)
                .FirstOrDefaultAsync(e => e.EmployeeID == targetEmpId);

            if (employee is null || (employee.IsArchived && !isStaff))
            {
                employee = null;
                loadFailed = true;
                return;
            }

            profilePhoto = await db.EmployeeProfilePhotos.AsNoTracking()
                .Where(p => p.EmployeeID == targetEmpId && p.IsActive)
                .FirstOrDefaultAsync();

            // The browser loads the portrait from the photo endpoint, which
            // audits the read against the real client address.
            photoUrl = profilePhoto is null
                ? null
                : ProfilePhotoUrls.Original(targetEmpId, profilePhoto.Version);

            phones = await db.EmployeePhones.AsNoTracking()
                .Where(p => p.EmployeeID == targetEmpId)
                .OrderByDescending(p => p.IsPrimary)
                .ThenByDescending(p => p.CreatedAt)
                .ToListAsync();

            emails = await db.EmployeeEmails.AsNoTracking()
                .Where(e => e.EmployeeID == targetEmpId)
                .OrderByDescending(e => e.IsPrimary)
                .ThenByDescending(e => e.CreatedAt)
                .ToListAsync();

            appreciationLetters = await db.AppreciationLetters.AsNoTracking()
                .Include(a => a.Type)
                .Include(a => a.TitleLookup)
                .Where(a => a.Employee.EmployeeID == targetEmpId)
                .OrderByDescending(a => a.LetterDate)
                .ToListAsync();

            employeeLeaves = await db.EmployeeLeaves.AsNoTracking()
                .Include(l => l.LeaveType)
                .Where(l => l.EmployeeId == employee.Id)
                .OrderByDescending(l => l.StartDate)
                .ToListAsync();

            employeePenalties = await db.EmployeePenalties.AsNoTracking()
                .Include(p => p.PenaltyType)
                .Where(p => p.EmployeeId == employee.Id)
                .OrderByDescending(p => p.PenaltyDate)
                .ToListAsync();

            employeeMartyrs = await db.EmployeeMartyrs.AsNoTracking()
                .Include(m => m.MartyrdomType)
                .Include(m => m.Kinship)
                .Where(m => m.EmployeeId == employee.Id)
                .OrderBy(m => m.Id)
                .ToListAsync();

            allMartyrdomTypes = await db.MartyrdomTypes.AsNoTracking().OrderBy(t => t.Id).ToListAsync();
            allMartyrKinships = await db.MartyrKinships.AsNoTracking().OrderBy(k => k.Degree).ThenBy(k => k.Id).ToListAsync();

            // Load National Identity Card
            nationalCard = await NationalCardService.GetByEmployeeIdAsync(employee.Id);

            // Load Employee Residences & Governorates
            employeeResidences = await db.EmployeeResidences.AsNoTracking()
                .Include(r => r.Governorate)
                .Where(r => r.EmployeeId == employee.Id)
                .OrderByDescending(r => r.ToDate == null ? 1 : 0)
                .ThenByDescending(r => r.FromDate)
                .ToListAsync();

            allGovernorates = await db.Governorates.AsNoTracking()
                .OrderBy(g => g.DisplayOrder)
                .ToListAsync();

            // Load Employee Passport
            employeePassport = await db.EmployeePassports.AsNoTracking()
                .Where(p => p.EmployeeId == employee.Id && p.IsActive)
                .OrderByDescending(p => p.Id)
                .FirstOrDefaultAsync();

            careerMovements = await db.EmployeeCareerMovements.AsNoTracking()
                .Where(m => m.EmployeeId == employee.Id)
                .OrderBy(m => m.MovementDate)
                .ToListAsync();

            employeeCourses = await db.EmployeeCourses.AsNoTracking()
                .Where(c => c.EmployeeId == employee.Id)
                .OrderByDescending(c => c.StartDate)
                .ToListAsync();

            var emailList = emails.Select(m => m.Email.ToLower()).ToList();
            appUser = await db.Users.AsNoTracking()
                .FirstOrDefaultAsync(u => u.EmployeeID == targetEmpId
                    || (u.Email != null && emailList.Contains(u.Email.ToLower())));

            // Load feedback and voice submissions
            employeeFeedbacks = await db.EmployeeFeedbacks.AsNoTracking()
                .Where(f => f.EmployeeId == employee.Id || (appUser != null && f.UserId == appUser.Id))
                .OrderByDescending(f => f.CreatedAt)
                .ToListAsync();

            // Load employee vehicles and gate authorizations
            employeeVehicles = await db.EmployeeVehicles.AsNoTracking()
                .Where(v => v.EmployeeId == employee.Id)
                .OrderByDescending(v => v.CreatedAtUtc)
                .ToListAsync();

            // Load administrative units where this employee is designated as Manager in the hierarchy
            managedUnits = await db.AdministrativeUnits.AsNoTracking()
                .Include(u => u.UnitType)
                .Include(u => u.ParentUnit)
                .Where(u => u.ManagerEmployeeId == targetEmpId)
                .ToListAsync();

            if (employee.AdministrativeUnit != null)
            {
                effectiveUnit = employee.AdministrativeUnit;
            }
            else if (managedUnits.Count > 0)
            {
                effectiveUnit = managedUnits[0];

                var empRecord = await db.Employees.IgnoreQueryFilters().FirstOrDefaultAsync(e => e.EmployeeID == targetEmpId);
                if (empRecord != null && empRecord.AdministrativeUnitId == null)
                {
                    empRecord.AdministrativeUnitId = effectiveUnit.Id;
                    await db.SaveChangesAsync();
                    employee.AdministrativeUnitId = effectiveUnit.Id;
                    employee.AdministrativeUnit = effectiveUnit;
                }
            }
            else
            {
                effectiveUnit = null;
            }

            unitLineage.Clear();
            if (effectiveUnit != null)
            {
                var closures = await db.AdministrativeUnitClosures.AsNoTracking()
                    .Where(c => c.DescendantId == effectiveUnit.Id)
                    .Include(c => c.Ancestor)
                        .ThenInclude(a => a!.UnitType)
                    .OrderBy(c => c.Depth)
                    .ToListAsync();

                if (closures.Count > 0)
                {
                    foreach (var cl in closures)
                    {
                        var ancestorName = cl.Ancestor?.Name?.Trim();
                        var typeCode = cl.Ancestor?.UnitType?.Code;
                        var typeName = cl.Ancestor?.UnitType?.Name?.Trim();

                        if (ancestorName == "المحافظ" || typeCode == "GOV" || typeName == "المحافظ")
                            continue;

                        if (!string.IsNullOrWhiteSpace(ancestorName) && !unitLineage.Contains(ancestorName))
                        {
                            unitLineage.Add(ancestorName);
                        }
                    }
                }
                else
                {
                    var curr = effectiveUnit;
                    int safety = 0;
                    while (curr != null && safety++ < 10)
                    {
                        var uName = curr.Name?.Trim();
                        var typeCode = curr.UnitType?.Code;
                        var typeName = curr.UnitType?.Name?.Trim();

                        if (uName != "المحافظ" && typeCode != "GOV" && typeName != "المحافظ")
                        {
                            if (!string.IsNullOrWhiteSpace(uName) && !unitLineage.Contains(uName))
                            {
                                unitLineage.Add(uName);
                            }
                        }

                        if (curr.ParentUnit != null)
                        {
                            curr = curr.ParentUnit;
                        }
                        else if (curr.ParentUnitId.HasValue)
                        {
                            curr = await db.AdministrativeUnits.AsNoTracking()
                                .Include(u => u.ParentUnit)
                                .Include(u => u.UnitType)
                                .FirstOrDefaultAsync(u => u.Id == curr.ParentUnitId.Value);
                        }
                        else
                        {
                            break;
                        }
                    }
                }
            }

            if (employee != null)
            {
                await LoadAllowancesData(employee.Id);
                await LoadFinancialData(employee.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading employee dossier");
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

