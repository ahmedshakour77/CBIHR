    // ---------- toast ----------

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastIsSuccess = success;

        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(6000, token);
                if (token.IsCancellationRequested) return;

                toastMessage = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { /* replaced by a newer toast */ }
            catch (ObjectDisposedException) { /* circuit gone */ }
        });

        StateHasChanged();
    }

    private void DismissToast()
    {
        toastCts?.Cancel();
        toastMessage = null;
    }

    // ---------- formatting helpers ----------

    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Or(string? value, string fallback = "—") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string D(DateOnly? date) =>
        date?.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture) ?? "—";

    private static string FormatServiceLength(DateOnly? hireDate)
    {
        if (hireDate is null) return "غير محدد";

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (hireDate > today) return "لم تبدأ بعد";

        var years = today.Year - hireDate.Value.Year;
        var months = today.Month - hireDate.Value.Month;
        var days = today.Day - hireDate.Value.Day;

        if (days < 0)
        {
            months--;
            var prev = today.AddMonths(-1);
            days += DateTime.DaysInMonth(prev.Year, prev.Month);
        }
        if (months < 0)
        {
            years--;
            months += 12;
        }

        var parts = new List<string>();
        if (years > 0) parts.Add($"{years.ToString(CultureInfo.InvariantCulture)} سنة");
        if (months > 0) parts.Add($"{months.ToString(CultureInfo.InvariantCulture)} شهر");
        if (parts.Count == 0) parts.Add($"{days.ToString(CultureInfo.InvariantCulture)} يوم");

        return string.Join(" و ", parts);
    }

    private static string FormatAge(DateOnly? birthDate)
    {
        if (birthDate is null) return "غير محدد";

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (birthDate > today) return "—";

        var bDate = birthDate.Value;
        var years = today.Year - bDate.Year;
        var months = today.Month - bDate.Month;
        var days = today.Day - bDate.Day;

        if (days < 0)
        {
            months--;
            var prevMonthDate = today.AddMonths(-1);
            var daysInPrevMonth = DateTime.DaysInMonth(prevMonthDate.Year, prevMonthDate.Month);
            days += daysInPrevMonth;
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }

        return $"{years.ToString(CultureInfo.InvariantCulture)} سنة و {months.ToString(CultureInfo.InvariantCulture)} شهر و {days.ToString(CultureInfo.InvariantCulture)} يوم";
    }

    private static string RetirementHorizon(DateOnly? birthDate, int targetAge = RetirementAge)
    {
        if (birthDate is null) return "تاريخ الميلاد غير متوفر";

        var retirementDate = birthDate.Value.AddYears(targetAge);
        var today = DateOnly.FromDateTime(DateTime.Today);

        if (today >= retirementDate) return $"بلغ السن القانوني للتقاعد ({targetAge}+)";

        var remainingYears = retirementDate.Year - today.Year;
        var remainingMonths = retirementDate.Month - today.Month;
        if (remainingMonths < 0)
        {
            remainingYears--;
            remainingMonths += 12;
        }

        return $"متبقٍ للتقاعد {remainingYears.ToString(CultureInfo.InvariantCulture)} سنة و {remainingMonths.ToString(CultureInfo.InvariantCulture)} شهر";
    }

    private static string FormatRetirementCompact(DateOnly? birthDate, int targetAge = RetirementAge)
    {
        if (birthDate is null) return "غير متوفر";

        var retirementDate = birthDate.Value.AddYears(targetAge);
        var today = DateOnly.FromDateTime(DateTime.Today);

        if (today >= retirementDate) return $"مستحق ({targetAge}+)";

        var remainingYears = retirementDate.Year - today.Year;
        var remainingMonths = retirementDate.Month - today.Month;
        if (remainingMonths < 0)
        {
            remainingYears--;
            remainingMonths += 12;
        }

        if (remainingYears <= 0) return $"{remainingMonths.ToString(CultureInfo.InvariantCulture)} شهر";
        if (remainingMonths == 0) return $"{remainingYears.ToString(CultureInfo.InvariantCulture)} سنة";
        return $"{remainingYears.ToString(CultureInfo.InvariantCulture)} س و {remainingMonths.ToString(CultureInfo.InvariantCulture)} ش";
    }

    // Deterministic across restarts: string.GetHashCode is randomized per
    // process, so the placeholder used to change colour on every app start.
    // Tones are steps on the brand ramp rather than arbitrary hues.
    private static string AvatarTone(string? employeeId)
    {
        var tones = new[] { "var(--b-800)", "var(--b-700)", "var(--b-600)", "var(--b-500)" };

        var sum = 0;
        foreach (var ch in employeeId ?? string.Empty)
        {
            sum = (sum * 31 + ch) & 0x7fffffff;
        }

        return tones[sum % tones.Length];
    }

