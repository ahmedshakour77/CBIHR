    private async Task ConfirmArchive()
    {
        if (employee is null) return;
        isPerformingLifecycle = true;
        try
        {
            var result = await LifecycleService.ArchiveEmployeeAsync(
                employee.EmployeeID,
                archiveReasonInput,
                currentUserName);

            if (result.Succeeded)
            {
                Toast.Success(result.Message);
                showArchiveModal = false;
                await LoadDossier();
