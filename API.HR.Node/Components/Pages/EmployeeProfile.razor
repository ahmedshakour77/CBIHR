@page "/portal"
@page "/portal/profile"
@page "/my-profile"
@page "/employees/{EmployeeId}"
@page "/employee-profile/{EmployeeId}"
 
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using API.HR.Node.Data.OrganizationalHierarchy
@using API.HR.Node.Data.Feedback
@using API.HR.Node.Data.Allowances
@using API.HR.Node.Contracts
@using API.HR.Node.Services.ProfilePhotos
@using API.HR.Node.Data.Financial
@using API.HR.Node.Services.Common
@using API.HR.Node.Services.Financial
@using API.HR.Node.Services.IdentityDocuments
@attribute [Authorize]

@inject IServiceScopeFactory ScopeFactory
@inject INationalCardService NationalCardService
@inject IPassportReaderService PassportReader
@inject IEmployeeProfilePhotoService PhotoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<EmployeeProfile> Logger
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject API.HR.Node.Services.Feedback.IFeedbackModalState FeedbackModal
@inject API.HR.Node.Services.Allowances.IEmployeeAllowanceService AllowanceService
@inject API.HR.Node.Services.Features.ISystemFeatureService FeatureService
@inject API.HR.Node.Services.Storage.IFileStorageService FileStorage
@inject API.HR.Node.Services.Security.IFileMalwareScanner MalwareScanner
@inject IEmployeeFinancialService FinancialService
@inject API.HR.Node.Services.DesignSystem.IToastService Toast
@inject API.HR.Node.Services.Employees.IEmployeeLifecycleService LifecycleService
@inject API.HR.Node.Services.Employees.IEmployeeVehicleService VehicleService

<PageTitle>@(employee is null ? "الملف الإلكتروني للموظف" : $"{employee.Name} | الملف الإلكتروني للموظف")</PageTitle>

@*
    Employee dossier — one record, read end to end, and printable as an
    official service summary.

    This page was written against Tailwind's own palette and its `dark:`
    variant. Neither held: the app flags its theme with <html data-theme>,
    while tailwind.config sets darkMode to `.dark &`, a class only the
    sign-in screen ever writes. Every `dark:` utility here was inert, so
    dark mode rendered slate-900 text on the system's dark surfaces. The
    page now reads its colour from the same tokens as the rest of the
    system, which is what App.razor says Tailwind is not for.

    Also settled here:
      · Deleting the photo asked nothing and reported nothing. It now goes
        through the shared ConfirmDialog, and both upload and delete say
        what happened — including when they fail, which was silent.
      · The avatar placeholder was keyed on string.GetHashCode, randomized
        per process, so its colour changed on every app restart.
      · The print header and the profile both opened an <h1>.
*@

<div class="hr-stack">

    @* ---------- breadcrumb + document actions ---------- *@
    <div class="hr-pagehead hr-no-print">
        <nav class="hr-crumbs" aria-label="مسار التنقل">
            @if (isStaff)
            {
                <a href="employees" class="hr-crumb">
                    <Icon Name="users" Size="xs" />
                    <span>دليل وسجلات الموظفين</span>
                </a>
                <span class="hr-crumb-sep" aria-hidden="true">/</span>
            }
            <span class="hr-crumb is-current" aria-current="page">
                @(employee is null ? "الملف الإلكتروني" : employee.Name)
            </span>
        </nav>

        <div class="hr-pagehead-actions">
          

            @if (employee is not null && isStaff)
            {
                <a href="employee-contacts/@employee.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm">
                    <Icon Name="phone" Size="xs" />
                    <span>وسائل التواصل</span>
                </a>

                <a href="employee-vehicles/@employee.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm">
                    <Icon Name="truck" Size="xs" />
                    <span>المركبات والمتعلقات</span>
                </a>

                @if (canManageLifecycle)
                {
                    @if (employee.IsArchived)
                    {
                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="PromptRestore">
                            <Icon Name="arrow-uturn-left" Size="xs" />
                            <span>استرجاع إلى النظام</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="PromptArchive">
                            <Icon Name="archive-box" Size="xs" />
                            <span>استبعاد مؤقت</span>
                        </button>
                    }

                    <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm" @onclick="PromptHardDelete">
                        <Icon Name="trash" Size="xs" />
                        <span>حذف نهائي</span>
                    </button>
                }
            }

            @if (isStaff)
            {
                <a href="employees" class="hr-btn hr-btn-quiet hr-btn-sm">
                    <Icon Name="arrow-right" Size="xs" />
                    <span>رجوع</span>
                </a>
            }
        </div>
    </div>

    @if (employee is not null && employee.IsArchived)
    {
        <div class="hr-alert hr-alert-warn" style="margin-block-end:1rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div style="display:flex;align-items:center;gap:0.75rem;">
                <Icon Name="exclamation-triangle" Size="md" />
                <div>
                    <strong style="font-size:1.05rem;">تنبيه: هذا الموظف مستبعد مؤقتاً من النظام والتقارير</strong>
                    <p class="hr-meta" style="margin:0.25rem 0 0 0;">
                        تاريخ الاستبعاد: @(employee.ArchivedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")
                        @if (!string.IsNullOrWhiteSpace(employee.ArchivedBy)) { <span>· بواسطة: @employee.ArchivedBy</span> }
                        @if (!string.IsNullOrWhiteSpace(employee.ArchiveReason)) { <span>· السبب: @employee.ArchiveReason</span> }
                    </p>
                </div>
            </div>
            @if (canManageLifecycle)
            {
                <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="PromptRestore">
                    <Icon Name="arrow-uturn-left" Size="xs" />
                    <span>استرجاع إلى النظام والتقارير</span>
                </button>
            }
        </div>
    }

    @if (isLoading)
    {
        @* The shape of the dossier is known before its content is, so the
           placeholder reserves it rather than spinning over empty space. *@
        <div class="hr-stack" aria-hidden="true">
            <div class="hr-skeleton" style="height:14rem;border-radius:var(--r-lg)"></div>
            <div class="hr-profile-kpi-grid">
                @for (var i = 0; i < 9; i++)
                {
                    <div class="hr-skeleton" style="height:7.75rem;border-radius:var(--r-lg)"></div>
                }
            </div>
            <div class="hr-grid-dossier">
                <div class="hr-skeleton" style="height:22rem;border-radius:var(--r-lg)"></div>
                <div class="hr-skeleton" style="height:22rem;border-radius:var(--r-lg)"></div>
            </div>
        </div>
        <p class="hr-sr" aria-live="polite">جارٍ تحميل الملف الإلكتروني للموظف…</p>
    }
    else if (loadFailed || employee is null)
    {
        <div class="hr-card">
            <div class="hr-empty">
                <span class="hr-empty-art hr-empty-art-danger" aria-hidden="true">
                    <Icon Name="exclamation-triangle" Size="lg" />
                </span>
                <p class="hr-h3">تعذّر العثور على ملف الموظف</p>
                <p class="hr-sub hr-measure-sm">
                    @(isStaff
                        ? $"الرقم الوظيفي {EmployeeId} غير متوفر في سجلات قاعدة البيانات، أو أن السجل حُذف. تحقّق من الرقم أو عد إلى الدليل واختر الموظف من هناك."
                        : "لم يتم العثور على سجل وظيفي مرتبط بحسابك. يُرجى مراجعة إدارة الموارد البشرية لربط حسابك بسجلك الرسمي في المنظومة.")
                </p>
                <div class="hr-chips" style="justify-content:center">
                    <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="LoadDossier">
                        <Icon Name="arrow-path" Size="xs" />
                        <span>إعادة المحاولة</span>
                    </button>
                    @if (isStaff)
                    {
                        <a href="employees" class="hr-btn hr-btn-secondary hr-btn-sm">العودة لدليل الموظفين</a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        @* ---------- official print letterhead (print only) ---------- *@
        @* Not an <h1>: the profile below already opens the document with
           the employee's name, and one page carries one first heading. *@
        <div class="hr-printhead" aria-hidden="true">
            <div class="hr-printhead-side">
                <p><strong>جمهورية العراق</strong></p>
                <p>البنك المركزي العراقي</p>
                <p>الدائرة الإدارية — إدارة الموارد البشرية</p>
            </div>
            <div class="hr-printhead-title">
                <p class="hr-printhead-name">خلاصة الخدمة والملف الإلكتروني للموظف</p>
                <p>تاريخ الإصدار: @DateTime.Now.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture)</p>
            </div>
            <div class="hr-printhead-side">
                <p>الرقم الوظيفي: <span class="hr-num">@employee.EmployeeID</span></p>
                <p>الحالة: @(employee.EmployeeStatus?.Name ?? "مستمر")</p>
            </div>
        </div>

        @* ---------- identity ---------- *@
        <section class="hr-card hr-dossier" aria-labelledby="dossier-name">
            <div class="hr-dossier-banner">
                
            </div>

            <div class="hr-dossier-head">
                <div class="hr-dossier-identity">
                    <div class="hr-portrait">
                        <div class="hr-portrait-face" style="@(photoUrl is null ? $"background:{AvatarTone(employee.EmployeeID)}" : null)">
                            @if (photoUrl is not null)
                            {
                                <img src="@photoUrl" alt="@($"الصورة الشخصية للموظف {employee.Name}")" decoding="async"
                                     @onerror="() => photoUrl = null" />
                            }
                            else
                            {
                                <span aria-hidden="true">@AvatarInitials.FromName(employee.Name)</span>
                            }
                        </div>

                        @* The mark repeats what the badge beside the name
                           already says, so it is decoration here. *@
                    </div>

                    <div class="hr-dossier-titles">
                        <h1 id="dossier-name" class="hr-h1 hr-balance">@employee.Name</h1>

                        <p class="hr-sub" style="margin-block-start:.5rem">
                            <span class="hr-num">@employee.EmployeeID</span>
                            · @(employee.JobTitle?.Name ?? "بدون عنوان وظيفي")
                            @if (employee.PositionTitle is not null)
                            {
                                <text> · </text>
                                <strong>@employee.PositionTitle.Name</strong>
                            }
                        </p>

                        <p class="hr-meta hr-inlinefield" style="margin-block-start:.25rem">
                            <Icon Name="building-office-2" Size="xs" />
                            <span>@(employee.Formation?.Name ?? "غير محدد التشكيل")</span>
                        </p>
                    </div>
                </div>

                <div class="hr-dossier-actions hr-no-print">
                    @if (isStaff)
                    {
                        <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="ExportPdfAsync" disabled="@isExportingPdf" title="تحميل وتصدير الملف كملف PDF رسمي موثق">
                            @if (isExportingPdf)
                            {
                                <span class="hr-spinner hr-spinner-xs" aria-hidden="true"></span>
                                <span>جارٍ إنشاء PDF…</span>
                            }
                            else
                            {
                                <Icon Name="arrow-down-tray" Size="xs" />
                                <span>تحميل كملف PDF</span>
                            }
                        </button>
                    }

                    @if (isStaff)
                    {
                        <label class="hr-btn hr-btn-secondary hr-btn-sm hr-uploadlabel">
                            @if (isUploading)
                            {
                                <span class="hr-spinner" aria-hidden="true"></span>
                                <span>جارٍ الرفع…</span>
                            }
                            else
                            {
                                <Icon Name="arrow-up-tray" Size="xs" />
                                <span>@(profilePhoto is not null ? "تغيير الصورة" : "رفع صورة")</span>
                            }
                            <span class="hr-sr">الصورة الشخصية للموظف @employee.Name</span>
                            <InputFile OnChange="UploadPhoto" accept=".jpg,.jpeg,.png,.webp" disabled="@isUploading" />
                        </label>

                        @if (profilePhoto is not null)
                        {
                            <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm"
                                    @onclick="() => pendingPhotoDelete = true" disabled="@isUploading">
                                <Icon Name="trash" Size="xs" />
                                <span>حذف الصورة</span>
                            </button>
                        }
                    }
                </div>
            </div>
        </section>

        @* ---------- vital metrics ---------- *@
        <div class="hr-profile-kpi-grid">
            <button type="button" class="hr-card hr-stat hr-stat-a hr-stat-link" @onclick="() => SetTab(ProfileTab.Basic)" title="انتقل إلى تفاصيل الخدمة والملف الأساسي">
                <div class="hr-stat-label">
                    <span>الخدمة الوظيفية الفعلية</span>
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true"><Icon Name="clock" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure hr-stat-figure-text">@FormatServiceLength(employee.HireDate)</strong>
                <div class="hr-stat-foot">
                    <span>تاريخ التعيين</span>
                    <strong class="hr-num">@D(employee.HireDate)</strong>
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-warn hr-stat-link" @onclick="() => SetTab(ProfileTab.Basic)" title="انتقل إلى البيانات الشخصية وتاريخ التقاعد">
                <div class="hr-stat-label">
                    <span>العمر والتقاعد القانوني</span>
                    <span class="hr-iconplate hr-iconplate-warn" aria-hidden="true"><Icon Name="calendar-days" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure hr-stat-figure-text">@FormatAge(employee.BirthDate)</strong>
                <div class="hr-stat-foot" title="@RetirementHorizon(employee.BirthDate)">
                    <span>المتبقي للتقاعد</span>
                    <strong class="hr-cell-strong hr-num">@FormatRetirementCompact(employee.BirthDate)</strong>
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-ok hr-stat-link" @onclick="() => SetTab(ProfileTab.Letters)" title="انتقل إلى تبويب كتب الشكر والتقدير">
                <div class="hr-stat-label">
                    <span>رصيد كتب الشكر والتقدير</span>
                    <span class="hr-iconplate hr-iconplate-ok" aria-hidden="true"><Icon Name="sparkles" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @if (appreciationLetters.Count is 1 or 2)
                    {
                        <span>@FormatBooksUnit(appreciationLetters.Count)</span>
                    }
                    else
                    {
                        @N(appreciationLetters.Count)<span class="hr-stat-unit"> @FormatBooksUnit(appreciationLetters.Count)</span>
                    }
                </strong>
                <div class="hr-stat-foot">
                    <span>إجمالي القِدم</span>
                    <strong class="hr-num hr-cell-strong" style="color:var(--color-success);">@FormatTotalSeniority()</strong>
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-d hr-stat-link" @onclick="() => SetTab(ProfileTab.Basic)" title="انتقل إلى تفاصيل الدرجة والمرحلة بالسلم">
                <div class="hr-stat-label">
                    <span>الدرجة والمرحلة بالسلم</span>
                    <span class="hr-iconplate hr-plate-d" aria-hidden="true"><Icon Name="square-3-stack-3d" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure hr-stat-figure-text">@Or(employee.Grade?.Name) / @Or(employee.Stage?.Name)</strong>
                <div class="hr-stat-foot">
                    <span>تاريخ العنوان الحالي</span>
                    <strong class="hr-num">@D(employee.LastJobTitleDate)</strong>
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-b hr-stat-link" @onclick="() => SetTab(ProfileTab.Leaves)" title="انتقل إلى تبويب الإجازات والدوام">
                <div class="hr-stat-label">
                    <span>رصيد الإجازات المتبقي</span>
                    <span class="hr-iconplate hr-plate-b" aria-hidden="true"><Icon Name="calendar-days" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @(employee.LeaveBalance.HasValue ? $"{employee.LeaveBalance.Value:G29}" : "—")<span class="hr-stat-unit">@(employee.LeaveBalance.HasValue ? "يوم متبقي" : "يوم")</span>
                </strong>
                <div class="hr-stat-foot">
                    <span>المتخذ: <strong class="hr-num">@N(GetTotalLeaveDays())</strong> يوم</span>
                    @if (GetCurrentActiveLeave() is { } curLeave)
                    {
                        <span class="hr-badge hr-badge-warn" style="font-size:0.7rem; padding:0.1rem 0.4rem;" title="مجاز حتى @D(curLeave.EndDate)">
                            <Icon Name="clock" Size="xs" /> مجاز
                        </span>
                    }
                    else
                    {
                        <span class="hr-badge hr-badge-ok" style="font-size:0.7rem; padding:0.1rem 0.4rem;">
                            <Icon Name="check-circle" Size="xs" /> مستمر
                        </span>
                    }
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-c hr-stat-link" @onclick="() => SetTab(ProfileTab.Movements)" title="انتقل إلى تبويب حركة التنقلات والخدمة">
                <div class="hr-stat-label">
                    <span>محطات الخدمة والتنقلات</span>
                    <span class="hr-iconplate hr-plate-c" aria-hidden="true"><Icon Name="arrows-right-left" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @N(careerMovements.Count)<span class="hr-stat-unit">محطة</span>
                </strong>
                <div class="hr-stat-foot">
                    <span>خدمة التقاعد</span>
                    <strong class="hr-num">@GetNetPensionServiceText()</strong>
                </div>
            </button>

            <button type="button" class="hr-card hr-stat @(employeePenalties.Count > 0 ? "hr-stat-danger" : "hr-stat-ok") hr-stat-link" @onclick="() => SetTab(ProfileTab.Penalties)" title="انتقل إلى تبويب العقوبات الانضباطية">
                <div class="hr-stat-label">
                    <span>العقوبات الانضباطية</span>
                    <span class="hr-iconplate @(employeePenalties.Count > 0 ? "hr-iconplate-danger" : "hr-iconplate-ok")" aria-hidden="true"><Icon Name="exclamation-triangle" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @N(employeePenalties.Count)<span class="hr-stat-unit">عقوبة</span>
                </strong>
                <div class="hr-stat-foot">
                    @if (employeePenalties.Count > 0)
                    {
                        var lastPen = employeePenalties.First();
                        <span class="hr-truncate" title="@(lastPen.PenaltyType?.Name ?? "عقوبة") (@D(lastPen.PenaltyDate))">
                            آخرها: <strong class="hr-cell-strong">@(lastPen.PenaltyType?.Name ?? "عقوبة")</strong>
                        </span>
                        <span class="hr-num hr-text-muted" style="font-size:0.72rem;">@D(lastPen.PenaltyDate)</span>
                    }
                    else
                    {
                        <span class="hr-badge hr-badge-ok" style="font-size:0.72rem; padding:0.1rem 0.5rem; width:100%; justify-content:center;">
                            <Icon Name="check-circle" Size="xs" /> سجل نظيف بدون عقوبات
                        </span>
                    }
                </div>
            </button>

            <button type="button" class="hr-card hr-stat hr-stat-a hr-stat-link" @onclick="() => SetTab(ProfileTab.Courses)" title="انتقل إلى تبويب الدورات التدريبية والتطوير">
                <div class="hr-stat-label">
                    <span>الدورات التدريبية</span>
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true"><Icon Name="academic-cap" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @N(employeeCourses.Count)<span class="hr-stat-unit">@(employeeCourses.Count is >= 3 and <= 10 ? "دورات" : "دورة")</span>
                </strong>
                <div class="hr-stat-foot">
                    @if (employeeCourses.Count > 0)
                    {
                        var lastCourse = employeeCourses.OrderByDescending(c => c.StartDate ?? DateOnly.MinValue).First();
                        <span class="hr-truncate" title="@lastCourse.CourseName">
                            آخرها: <strong class="hr-cell-strong">@lastCourse.CourseName</strong>
                        </span>
                    }
                    else
                    {
                        <span class="hr-text-muted">لا توجد دورات مسجلة</span>
                    }
                </div>
            </button>

            <a href="my-feedback" class="hr-card hr-stat hr-stat-b hr-stat-link" title="انتقل إلى صفحة مشاركاتي والتواصل">
                <div class="hr-stat-label">
                    <span>مشاركاتي</span>
                    <span class="hr-iconplate hr-plate-b" aria-hidden="true"><Icon Name="chat-bubble-left-right" Size="sm" /></span>
                </div>
                <strong class="hr-stat-figure">
                    @N(employeeFeedbacks.Count)<span class="hr-stat-unit">@(employeeFeedbacks.Count is >= 3 and <= 10 ? "مشاركات" : "مشاركة")</span>
                </strong>
                <div class="hr-stat-foot">
                    @if (employeeFeedbacks.Count > 0)
                    {
                        var lastFb = employeeFeedbacks.OrderByDescending(f => f.CreatedAt).First();
                        <span class="hr-truncate" title="@lastFb.Title">
                            آخرها: <strong class="hr-cell-strong">@lastFb.Title</strong>
                        </span>
                    }
                    else
                    {
                        <span class="hr-text-muted">لا توجد مشاركات مسجلة</span>
                    }
                </div>
            </a>
        </div>

        @* ---------- TAB NAVIGATION SLIDER (سلايدر التبويبات) ---------- *@
        <nav class="hr-tabs-nav hr-tabs-slider hr-no-print" aria-label="أقسام الملف الوظيفي">
            <div class="hr-tabs" role="tablist">
                <button type="button"
                        role="tab"
                        aria-selected="@(activeTab == ProfileTab.Basic ? "true" : "false")"
                        class="hr-tab @(activeTab == ProfileTab.Basic ? "is-active" : "")"
                        @onclick="() => SetTab(ProfileTab.Basic)">
                    <Icon Name="user" Size="sm" />
                    <span> الأساسيات</span>
                </button>

                <button type="button"
                        role="tab"
                        aria-selected="@(activeTab == ProfileTab.Documents ? "true" : "false")"
                        class="hr-tab @(activeTab == ProfileTab.Documents ? "is-active" : "")"
                        @onclick="() => SetTab(ProfileTab.Documents)">
                    <Icon Name="identification" Size="sm" />
                    <span>المستمسكات</span>
                </button>

                <button type="button"
                        role="tab"
                        aria-selected="@(activeTab == ProfileTab.Privileges ? "true" : "false")"
                        class="hr-tab @(activeTab == ProfileTab.Privileges ? "is-active" : "")"
                        @onclick="() => SetTab(ProfileTab.Privileges)">
                    <Icon Name="shield-check" Size="sm" />
                    <span>امتيازات</span>
                 
                </button>

                <button type="button"
                        role="tab"
