    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || employee is null || !isStaff) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var wrapper = new FormFileWrapper(ms, file.Name, file.ContentType, file.Size);

            var result = await PhotoService.UploadOrReplacePhotoAsync(
                employee.EmployeeID, wrapper, authState.User, "127.0.0.1", "BlazorClient");

            // The old handler reloaded on success and did nothing at all on
            // failure, so a rejected file looked exactly like a no-op click.
            switch (result)
            {
                case PhotoServiceResult.Success<ProfilePhotoResponse>:
                    ShowToast("تم حفظ الصورة الشخصية.", true);
                    await LoadDossier();
                    break;
                case PhotoServiceResult.ValidationError ve:
                    ShowToast($"الملف مرفوض: {ve.Message} — اختر صورة JPEG أو PNG أو WebP بحجم أقل من 10 ميغابايت.", false);
                    break;
                case PhotoServiceResult.NotFound nf:
                    ShowToast(nf.Message, false);
                    break;
                default:
                    ShowToast("تعذّر رفع الصورة. تأكد أن الملف صورة صالحة (JPEG أو PNG أو WebP).", false);
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed uploading photo for employee {EmployeeID}", employee.EmployeeID);
            ShowToast("فشل رفع الصورة بسبب خطأ في النظام. حاول مرة أخرى.", false);
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeletePhoto()
    {
        if (employee is null || !isStaff) return;

        isDeletingPhoto = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await PhotoService.DeletePhotoAsync(
