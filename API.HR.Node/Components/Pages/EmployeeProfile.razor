                @* --- contacts --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-b" aria-hidden="true"><Icon Name="phone" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">وسائل الاتصال والملف الرقمي</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">أرقام الهواتف والبريد الإلكتروني المعتمد</p>
                            </div>
                        </div>

                        @if (isStaff)
                        {
                            <a href="employee-contacts/@employee.EmployeeID" class="hr-btn hr-btn-quiet hr-btn-sm hr-no-print">
                                <Icon Name="pencil-square" Size="xs" />
                                <span>تعديل</span>
                            </a>
                        }
                    </div>

                    <div class="hr-card-body hr-stack-sm">
                        <div>
                            <h3 class="hr-eyebrow" style="margin-block-end:.5rem">أرقام الهواتف المسجلة</h3>
                            @if (phones.Count == 0)
                            {
                                <p class="hr-contactempty">لم يُسجَّل أي رقم هاتف للموظف بعد.</p>
                            }
                            else
                            {
                                <ul class="hr-contactlist">
                                    @foreach (var phone in phones)
                                    {
                                        <li class="hr-contactrow" @key="phone.Id">
                                            <span class="hr-contactrow-value hr-inlinefield">
                                                <Icon Name="phone" Size="xs" />
                                                <bdi class="hr-num" dir="ltr">@phone.PhoneNumber</bdi>
                                            </span>
                                            <span class="hr-chips">
                                                <span class="hr-meta">@phone.Label</span>
                                                @if (phone.IsPrimary)
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="check-circle" Size="xs" />
                                                        <span>رئيسي</span>
                                                    </span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div>
                            <h3 class="hr-eyebrow" style="margin-block-end:.5rem">عناوين البريد الإلكتروني</h3>
                            @if (emails.Count == 0)
                            {
                                <p class="hr-contactempty">لم يُسجَّل أي بريد إلكتروني للموظف بعد.</p>
                            }
                            else
                            {
                                <ul class="hr-contactlist">
                                    @foreach (var mail in emails)
                                    {
                                        <li class="hr-contactrow" @key="mail.Id">
                                            <span class="hr-contactrow-value hr-inlinefield hr-wrap-any">
                                                <Icon Name="envelope" Size="xs" />
                                                <bdi dir="ltr">@mail.Email</bdi>
                                            </span>
                                            <span class="hr-chips">
                                                <span class="hr-meta">@mail.Label</span>
                                                @if (mail.IsPrimary)
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="check-circle" Size="xs" />
                                                        <span>رئيسي</span>
                                                    </span>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div>
                            <h3 class="hr-eyebrow" style="margin-block-end:.5rem">الحساب الرقمي بالمنظومة</h3>
                            @if (appUser is not null)
                            {
                                <div class="hr-alert hr-alert-ok">
                                    <Icon Name="shield-check" Size="sm" />
                                    <div class="hr-alert-grow">
                                        <p class="hr-alert-title">حساب مستخدم مفعّل</p>
                                        <p class="hr-meta hr-wrap-any">@appUser.UserName</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="hr-alert">
                                    <Icon Name="information-circle" Size="sm" />
                                    <div class="hr-alert-grow">
                                        <p>لا يمتلك حساب تسجيل دخول بالمنظومة حتى الآن.</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>



                @if (isAdmin)
                {
                    @* --- archival (للأدمن فقط) --- *@
                    <section class="hr-card">
                        <div class="hr-card-head">
                            <div class="hr-modal-lead">
                                <span class="hr-iconplate" aria-hidden="true"><Icon Name="identification" Size="sm" /></span>
                                <div class="hr-modal-titles">
