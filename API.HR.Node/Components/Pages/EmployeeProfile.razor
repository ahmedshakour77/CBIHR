    {
        if (employee == null || !isStaff) return;
        residenceModalError = null;

        if (!modalGovernorateId.HasValue)
        {
            residenceModalError = "يرجى اختيار المحافظة.";
            return;
        }

        isSavingResidence = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            EmployeeResidence res;
            if (editingResidence == null)
            {
                res = new EmployeeResidence
                {
                    EmployeeId = employee.Id,
                    EmployeeIdNumber = employee.EmployeeID,
                    CreatedAt = DateTime.UtcNow
                };
                db.EmployeeResidences.Add(res);
            }
            else
            {
                res = await db.EmployeeResidences.FirstOrDefaultAsync(r => r.Id == editingResidence.Id)
                      ?? throw new InvalidOperationException("لم يتم العثور على سجل السكن المطلوب تعديله.");
                res.UpdatedAt = DateTime.UtcNow;
            }

            res.GovernorateId = modalGovernorateId;
            res.HousingType = modalHousingType;
            res.InformationOffice = string.IsNullOrWhiteSpace(modalInformationOffice) ? null : modalInformationOffice.Trim();
            res.FamilyHeadName = string.IsNullOrWhiteSpace(modalFamilyHeadName) ? null : modalFamilyHeadName.Trim();
            res.FormNumber = string.IsNullOrWhiteSpace(modalFormNumber) ? null : modalFormNumber.Trim();
            res.FormDate = modalFormDate;
            res.LocationUrl = string.IsNullOrWhiteSpace(modalLocationUrl) ? null : modalLocationUrl.Trim();
            if (modalLatitude.HasValue && modalLongitude.HasValue)
            {
                res.Latitude = modalLatitude.Value;
                res.Longitude = modalLongitude.Value;
            }
            else
            {
                var parsedCoords = await EmployeeResidence.ResolveUrlAndCoordinatesAsync(res.LocationUrl);
                if (parsedCoords.HasValue)
                {
                    res.Latitude = parsedCoords.Value.Lat;
                    res.Longitude = parsedCoords.Value.Lng;
                }
                else
                {
                    res.Latitude = null;
                    res.Longitude = null;
                }
            }

            if (string.IsNullOrWhiteSpace(res.LocationUrl) && res.Latitude.HasValue && res.Longitude.HasValue)
            {
                res.LocationUrl = $"https://www.google.com/maps?q={res.Latitude.Value},{res.Longitude.Value}";
            }
            res.FromDate = modalFromDate;
            res.ToDate = modalToDate;
            res.Notes = string.IsNullOrWhiteSpace(modalResidenceNotes) ? null : modalResidenceNotes.Trim();

            if (modalHousingType == "شقة")
            {
                res.ComplexName = string.IsNullOrWhiteSpace(modalComplexName) ? null : modalComplexName.Trim();
                res.BuildingNumber = string.IsNullOrWhiteSpace(modalBuildingNumber) ? null : modalBuildingNumber.Trim();
                res.FloorNumber = string.IsNullOrWhiteSpace(modalFloorNumber) ? null : modalFloorNumber.Trim();
                res.ApartmentNumber = string.IsNullOrWhiteSpace(modalApartmentNumber) ? null : modalApartmentNumber.Trim();
                res.District = null;
                res.Mahalla = null;
                res.Zuqaq = null;
                res.Dar = null;
            }
            else
            {
                res.District = string.IsNullOrWhiteSpace(modalDistrict) ? null : modalDistrict.Trim();
                res.Mahalla = string.IsNullOrWhiteSpace(modalMahalla) ? null : modalMahalla.Trim();
                res.Zuqaq = string.IsNullOrWhiteSpace(modalZuqaq) ? null : modalZuqaq.Trim();
                res.Dar = string.IsNullOrWhiteSpace(modalDar) ? null : modalDar.Trim();
                res.ComplexName = null;
                res.BuildingNumber = null;
                res.FloorNumber = null;
                res.ApartmentNumber = null;
            }

            // Scan both sides before anything is written; one bad file rejects the save.
            foreach (var (bytes, picked) in new[] { (modalCardFrontBytes, modalCardFrontFile), (modalCardBackBytes, modalCardBackFile) })
            {
                if (bytes == null || picked == null) continue;
                using var scanStream = new MemoryStream(bytes);
                var scan = await MalwareScanner.ScanAsync(scanStream, picked.Name);
                if (scan.IsRejected())
                {
                    residenceModalError = "تعذر قبول ملف البطاقة: لم يجتز الفحص الأمني.";
                    return;
                }
            }

            // Save card front file if newly uploaded
            if (modalCardFrontBytes != null && modalCardFrontFile != null)
            {
                var ext = Path.GetExtension(modalCardFrontFile.Name);
                if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";
                var key = $"residences/{employee.EmployeeID}/{Guid.NewGuid():N}_front{ext}";
                using var stream = new MemoryStream(modalCardFrontBytes);
                await FileStorage.SaveAsync(stream, key);
                res.CardFrontKey = key;
                res.CardFrontFileName = Path.GetFileName(modalCardFrontFile.Name);
                res.CardFrontContentType = modalCardFrontFile.ContentType;
            }

            // Save card back file if newly uploaded
            if (modalCardBackBytes != null && modalCardBackFile != null)
            {
                var ext = Path.GetExtension(modalCardBackFile.Name);
                if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";
                var key = $"residences/{employee.EmployeeID}/{Guid.NewGuid():N}_back{ext}";
                using var stream = new MemoryStream(modalCardBackBytes);
                await FileStorage.SaveAsync(stream, key);
                res.CardBackKey = key;
                res.CardBackFileName = Path.GetFileName(modalCardBackFile.Name);
                res.CardBackContentType = modalCardBackFile.ContentType;
            }

            await db.SaveChangesAsync();

            // Reload residences
            employeeResidences = await db.EmployeeResidences.AsNoTracking()
                .Include(r => r.Governorate)
                .Where(r => r.EmployeeId == employee.Id)
                .OrderByDescending(r => r.ToDate == null ? 1 : 0)
                .ThenByDescending(r => r.FromDate)
                .ToListAsync();

            showResidenceModal = false;
            ShowToast("تم حفظ وتحديث بيانات السكن وبطاقة السكن بنجاح.", true);
        }
        catch (Exception ex)
        {
            residenceModalError = $"حدث خطأ أثناء حفظ بيانات السكن: {ex.Message}";
        }
        finally
        {
            isSavingResidence = false;
        }
    }

    private async Task DeleteResidenceAsync(int residenceId)
    {
        if (employee == null) return;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var existing = await db.EmployeeResidences.FirstOrDefaultAsync(r => r.Id == residenceId);
            if (existing != null)
            {
                // Delete storage files if present
                if (!string.IsNullOrEmpty(existing.CardFrontKey))
                {
                    try { await FileStorage.DeleteAsync(existing.CardFrontKey); } catch { }
                }
                if (!string.IsNullOrEmpty(existing.CardBackKey))
                {
                    try { await FileStorage.DeleteAsync(existing.CardBackKey); } catch { }
                }

                db.EmployeeResidences.Remove(existing);
                await db.SaveChangesAsync();
            }

            employeeResidences = await db.EmployeeResidences.AsNoTracking()
                .Include(r => r.Governorate)
                .Where(r => r.EmployeeId == employee.Id)
                .OrderByDescending(r => r.ToDate == null ? 1 : 0)
                .ThenByDescending(r => r.FromDate)
                .ToListAsync();

            ShowToast("تم حذف قيد السكن بنجاح.", true);
        }
        catch (Exception ex)
        {
            ShowToast($"تعذر الحذف: {ex.Message}", false);
        }
    }

