                                            else
                                            {
                                                <div style="height:120px;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:var(--fs-caption);border:1px dashed var(--line);border-radius:var(--r-sm);">
                                                    غير مرفوع
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <section class="hr-card">
                        <div class="hr-empty" style="padding:var(--s-5) var(--s-3);">
                            <span class="hr-empty-art" aria-hidden="true">
                                <Icon Name="home" Size="lg" />
                            </span>
                            <h3 class="hr-h3">لم يتم تسجيل بطاقة سكن للموظف بعد</h3>
                            <p class="hr-sub hr-measure-sm" style="margin-inline:auto;">
                                يمكنك توثيق بيانات بطاقة السكن ومكتب المعلومات ورفع صور الوثيقة لاعتمادها رسمياً في ملف الموظف.
                            </p>
                            @if (isStaff)
                            {
                                <div style="margin-block-start:var(--s-3);">
                                    <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="OpenAddResidenceModal">
                                        <Icon Name="plus" Size="xs" />
                                        <span>إضافة بيانات وبطاقة السكن الآن</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </section>
                }

                @* ==================== 2.3 EMPLOYEE PASSPORT (جواز السفر الإلكتروني العراقي) ==================== *@
                @if (employeePassport != null)
                {
                    <section class="hr-card" style="border:1px solid color-mix(in srgb, var(--series-2) 25%, var(--line));">
                        <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                            <div class="hr-modal-lead">
                                <span class="hr-iconplate hr-plate-a" style="background:color-mix(in srgb, var(--series-2) 12%, transparent);color:var(--series-2);" aria-hidden="true">
                                    <Icon Name="globe-alt" Size="sm" />
                                </span>
                                <div class="hr-modal-titles">
                                    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                        <h2 class="hr-h2">جواز السفر الإلكتروني (@Or(employeePassport.CountryCode, "IRQ"))</h2>
                                        <span class="hr-badge hr-badge-accent">@employeePassport.PassportType</span>
                                        @if (employeePassport.ExpiryDate.HasValue)
                                        {
                                            var isExp = employeePassport.ExpiryDate.Value < DateOnly.FromDateTime(DateTime.Today);
                                            var isNear = !isExp && employeePassport.ExpiryDate.Value <= DateOnly.FromDateTime(DateTime.Today.AddMonths(6));
                                            if (isExp)
                                            {
                                                <span class="hr-badge hr-badge-danger">نافذ الصلاحية</span>
                                            }
                                            else if (isNear)
                                            {
                                                <span class="hr-badge hr-badge-warn">ينتهي قريباً (@employeePassport.ExpiryDate.Value.ToString("yyyy/MM/dd"))</span>
                                            }
                                            else
                                            {
                                                <span class="hr-badge hr-badge-ok">ساري الصلاحية</span>
                                            }
                                        }
                                        @if (!string.IsNullOrEmpty(employeePassport.PassportImageKey))
                                        {
                                            <span class="hr-badge hr-badge-ok">نسخة الجواز مرفقة</span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge">بانتظار رفع صورة الجواز</span>
                                        }
                                    </div>
                                    <p class="hr-meta" style="margin-block-start:.25rem">
                                        رقم الجواز: <strong class="hr-num" style="letter-spacing:1px;font-size:1rem;color:var(--text);">@employeePassport.PassportNumber</strong>
                                        @if (!string.IsNullOrEmpty(employeePassport.IssuingAuthority))
                                        {
                                            <span> · جهة الإصدار: @employeePassport.IssuingAuthority</span>
                                        }
                                        @if (employeePassport.IssueDate.HasValue)
                                        {
                                            <span> · تاريخ الإصدار: <span class="hr-num">@employeePassport.IssueDate.Value.ToString("yyyy/MM/dd")</span></span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm hr-no-print" @onclick='() => CopyToClipboard(employeePassport.PassportNumber, "رقم الجواز")'>
                                    <Icon Name="clipboard-document" Size="xs" />
                                    <span>نسخ رقم الجواز</span>
                                </button>
                                @if (isStaff)
                                {
                                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm hr-no-print" @onclick="() => OpenEditPassportModal(employeePassport)">
                                        <Icon Name="pencil-square" Size="xs" />
                                        <span>تعديل بيانات / رفع صورة الجواز</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="hr-card-body">
                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(320px, 100%), 1fr));gap:var(--s-4);align-items:start;">
                                
                                @* تفاصيل وبيانات جواز السفر *@
                                <div>
                                    <dl class="hr-deflist hr-deflist-cols" style="grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));">
                                        <div class="hr-deflist-row">
                                            <dt>الاسم الكامل بالعربية</dt>
                                            <dd class="hr-cell-strong">@Or(employeePassport.FullNameAr, employee.Name)</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>الاسم بالإنجليزية (Full Name)</dt>
                                            <dd class="hr-cell-strong" style="font-family:monospace;letter-spacing:0.5px;">@Or(employeePassport.FullNameEn, "—")</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>رقم الجواز (Passport No)</dt>
                                            <dd class="hr-num hr-cell-strong" style="color:var(--accent);font-size:1.05rem;letter-spacing:1px;">@employeePassport.PassportNumber</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>الرقم الوطني / الشخصي</dt>
                                            <dd class="hr-num">@Or(employeePassport.NationalIdNumber, employee.NationalId ?? "—")</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>نوع وسلطة الإصدار</dt>
                                            <dd>@employeePassport.PassportType · @Or(employeePassport.IssuingAuthority, employeePassport.IssuingCountry)</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>اسم الأم</dt>
                                            <dd>@Or(employeePassport.MotherName, employee.MotherName ?? "—")</dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>محل وتاريخ الولادة</dt>
                                            <dd>
                                                <span>@Or(employeePassport.PlaceOfBirth, "—")</span>
                                                @if (employeePassport.DateOfBirth.HasValue)
                                                {
                                                    <span> · <span class="hr-num">@employeePassport.DateOfBirth.Value.ToString("yyyy/MM/dd")</span></span>
                                                }
                                            </dd>
                                        </div>

                                        <div class="hr-deflist-row">
                                            <dt>الجنس والجنسية</dt>
                                            <dd>@Or(employeePassport.Gender, "—") · @Or(employeePassport.IssuingCountry, "العراق") (@employeePassport.CountryCode)</dd>
                                        </div>

                                        <div class="hr-deflist-row" style="grid-column: 1 / -1;">
                                            <dt>فترة صلاحية الجواز</dt>
                                            <dd>
                                                <span class="hr-num">
                                                    @(employeePassport.IssueDate?.ToString("yyyy/MM/dd") ?? "—")
                                                    إلى
                                                    <strong>@(employeePassport.ExpiryDate?.ToString("yyyy/MM/dd") ?? "—")</strong>
                                                </span>
                                            </dd>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(employeePassport.RawMrz))
                                        {
                                            <div class="hr-deflist-row" style="grid-column: 1 / -1;">
                                                <dt>شريط القراءة الآلية (MRZ)</dt>
                                                <dd style="font-family:monospace;font-size:0.8rem;background:var(--surface-sunken);padding:6px;border-radius:var(--r-xs);overflow-x:auto;letter-spacing:1px;direction:ltr;text-align:left;">
                                                    @employeePassport.RawMrz
                                                </dd>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(employeePassport.Notes))
                                        {
                                            <div class="hr-deflist-row" style="grid-column: 1 / -1;">
                                                <dt>ملاحظات</dt>
                                                <dd>@employeePassport.Notes</dd>
                                            </div>
                                        }
                                    </dl>
                                </div>

                                @* صور وثيقة جواز السفر *@
                                <div>
                                    <div style="font-size:var(--fs-caption);font-weight:700;margin-block-end:var(--s-2);color:var(--text);display:flex;align-items:center;gap:var(--s-1);">
                                        <Icon Name="photo" Size="xs" />
                                        <span>الصور والوثائق المرفقة للجواز:</span>
                                    </div>

                                    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(160px, 100%), 1fr));gap:var(--s-2);">
                                        @* صفحة البيانات الرئيسية (Bio Page) *@
                                        <div style="border:1px solid var(--line);border-radius:var(--r-sm);padding:var(--s-2);background:var(--surface-sunken);text-align:center;">
                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:6px;">
                                                <span style="font-size:var(--fs-caption);font-weight:600;">صفحة البيانات الرئيسية</span>
                                                @if (!string.IsNullOrEmpty(employeePassport.PassportImageKey))
                                                {
                                                    <span class="hr-badge hr-badge-ok" style="font-size:0.65rem;">مرفوعة</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(employeePassport.PassportImageKey))
                                            {
                                                <div style="position:relative;cursor:pointer;border-radius:var(--r-sm);overflow:hidden;background:var(--surface);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;height:140px;"
                                                     @onclick='() => OpenCardLightbox("جواز سفر - " + employee.Name + " (" + employeePassport.PassportNumber + ")", $"/api/passport/{employeePassport.Id}/image")'
                                                     title="انقر لتكبير واستعراض صفحة الجواز">
                                                    <img src="/api/passport/@(employeePassport.Id)/image" alt="صفحة بيانات الجواز" style="max-height:140px;max-width:100%;object-fit:contain;" />
                                                    <span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.65);color:#fff;padding:2px 6px;border-radius:4px;font-size:var(--fs-caption);display:flex;align-items:center;gap:2px;">
                                                        <Icon Name="magnifying-glass-plus" Size="xs" /> تكبير
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="height:140px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--s-1);color:var(--text-muted);font-size:var(--fs-caption);border:1px dashed var(--line);border-radius:var(--r-sm);">
                                                    <Icon Name="globe-alt" Size="md" />
                                                    <span>لا توجد صورة مرفوعة</span>
                                                </div>
                                            }
                                        </div>

                                        @* الصورة البيومترية إن وجدت *@
                                        @if (!string.IsNullOrEmpty(employeePassport.BiometricPhotoKey))
                                        {
                                            <div style="border:1px solid var(--line);border-radius:var(--r-sm);padding:var(--s-2);background:var(--surface-sunken);text-align:center;">
                                                <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:6px;">
                                                    <span style="font-size:var(--fs-caption);font-weight:600;">الصورة البيومترية (DG2)</span>
                                                    <span class="hr-badge hr-badge-accent" style="font-size:0.65rem;">شريحة RFID</span>
                                                </div>
                                                <div style="position:relative;cursor:pointer;border-radius:var(--r-sm);overflow:hidden;background:var(--surface);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;height:140px;"
                                                     @onclick='() => OpenCardLightbox("الصورة البيومترية للجواز - " + employee.Name, $"/api/passport/{employeePassport.Id}/photo")'
                                                     title="انقر لتكبير الصورة البيومترية">
                                                    <img src="/api/passport/@(employeePassport.Id)/photo" alt="الصورة البيومترية" style="max-height:140px;max-width:100%;object-fit:contain;" />
                                                    <span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.65);color:#fff;padding:2px 6px;border-radius:4px;font-size:var(--fs-caption);display:flex;align-items:center;gap:2px;">
                                                        <Icon Name="magnifying-glass-plus" Size="xs" /> تكبير
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <section class="hr-card">
                        <div class="hr-empty" style="padding:var(--s-5) var(--s-3);">
                            <span class="hr-empty-art" aria-hidden="true">
                                <Icon Name="globe-alt" Size="lg" />
                            </span>
                            <h3 class="hr-h3">لم يتم تسجيل جواز سفر للموظف بعد</h3>
                            <p class="hr-sub hr-measure-sm" style="margin-inline:auto;">
                                يمكنك توثيق بيانات جواز السفر العراقي أو الدبلوماسي أو الخدمة وتواريخ الإصدار والنفاذ ورفع صورة الصفحة الرئيسية لاعتمادها رسمياً.
                            </p>
                            @if (isStaff)
                            {
                                <div style="margin-block-start:var(--s-3);">
                                    <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="OpenAddPassportModal">
                                        <Icon Name="plus" Size="xs" />
                                        <span>إضافة بيانات وجواز السفر الآن</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </section>
                }

            </div>
        </div>

        @* ==================== TAB: PRIVILEGES (امتيازات) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Privileges ? "is-active" : "")">
            <div class="hr-stack">

                @* ================= SECTION: ذوي الشهداء ================= *@
                <section class="hr-card" style="border: 1px solid color-mix(in srgb, var(--series-5) 30%, var(--line)); background: linear-gradient(180deg, color-mix(in srgb, var(--series-5) 4%, var(--surface)), var(--surface));">
                    <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-c" style="background:color-mix(in srgb, var(--series-5) 15%, transparent);color:var(--series-5);" aria-hidden="true">
                                <Icon Name="shield-check" Size="sm" />
                            </span>
                            <div class="hr-modal-titles">
                                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                    <h2 class="hr-h2" style="color:color-mix(in srgb, var(--series-5) 90%, var(--text));">بيانات ذوي الشهداء</h2>
                                    @if (employeeMartyrs.Count > 0)
                                    {
                                        <span class="hr-badge" style="background:color-mix(in srgb, var(--series-5) 15%, transparent);color:var(--series-5);font-weight:700;">
                                            <Icon Name="shield-check" Size="xs" /> مشمول بذوي الشهداء (@N(employeeMartyrs.Count))
                                        </span>
                                    }
                                </div>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    بيانات وقرارات الشهداء المعتمدة للموظف وفق القوانين والتعليمات النافذة والامتيازات الممنوحة
                                </p>
                            </div>
                        </div>

                        @if (isStaff)
                        {
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm hr-no-print" @onclick="OpenAddMartyrModal">
                                <Icon Name="plus" Size="xs" />
                                <span>إضافة شهيد</span>
                            </button>
                        }
                    </div>

                    <div class="hr-card-body">
                        @if (employeeMartyrs.Count > 0)
                        {
                            <div class="hr-tablewrap">
                                <table class="hr-table">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="width:40px;text-align:center;">#</th>
                                            <th scope="col">اسم الشهيد</th>
                                            <th scope="col">نوع الشهادة</th>
                                            <th scope="col">صلة القرابة</th>
                                            <th scope="col">رقم القرار المعتمد</th>
                                            <th scope="col">ملاحظات</th>
                                            @if (isStaff)
                                            {
                                                <th scope="col" class="hr-no-print" style="width:100px;text-align:center;">إجراءات</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < employeeMartyrs.Count; i++)
                                        {
                                            var m = employeeMartyrs[i];
                                            <tr>
                                                <td style="text-align:center;"><span class="hr-num">@(i + 1)</span></td>
                                                <td>
                                                    <strong style="color:var(--text);font-size:var(--fs-body);">@m.MartyrName</strong>
                                                </td>
                                                <td>
                                                    <span class="hr-badge hr-badge-accent">
                                                        @Or(m.MartyrdomType?.Name, "غير محدد")
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="hr-badge" style="background:var(--surface-sunken);font-weight:700;">
                                                        @Or(m.Kinship?.Name, "غير محدد")
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(m.DecisionNumber))
                                                    {
                                                        <span class="hr-num hr-cell-strong">@m.DecisionNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-meta">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="hr-meta">@Or(m.Notes, "—")</span>
                                                </td>
                                                @if (isStaff)
                                                {
                                                    <td class="hr-no-print" style="text-align:center;">
                                                        <div style="display:flex;gap:0.35rem;justify-content:center;">
                                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" title="تعديل" @onclick="() => OpenEditMartyrModal(m)">
                                                                <Icon Name="pencil-square" Size="xs" />
                                                            </button>
                                                            <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-xs" title="حذف" @onclick="() => DeleteMartyrAsync(m.Id)">
                                                                <Icon Name="trash" Size="xs" />
                                                            </button>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="hr-empty" style="padding:var(--s-5) var(--s-3);">
                                <span class="hr-empty-art" aria-hidden="true">
                                    <Icon Name="shield-check" Size="lg" />
                                </span>
                                <h3 class="hr-h3" style="margin:0 0 var(--s-1) 0;font-size:1.1rem;">لا توجد بيانات ذوي شهداء مسجلة لهذا الموظف</h3>
                                <p class="hr-meta" style="max-width:480px;margin:0 auto var(--s-3) auto;">
                                    يمكنك توثيق قرارات مؤسسة الشهداء ونوع الشهادة وصلة القرابة للاستفادة من الامتيازات القانونية المقررة.
                                </p>
                                @if (isStaff)
                                {
                                    <button type="button" class="hr-btn hr-btn-primary hr-btn-sm hr-no-print" @onclick="OpenAddMartyrModal">
                                        <Icon Name="plus" Size="xs" />
                                        <span>إضافة شهيد إلى سجل الموظف</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </section>

            </div>
        </div>

        @* ==================== TAB 3: ALLOWANCES & SALARY (المخصصات والراتب الإجمالي) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Allowances ? "is-active" : "")">
            <div class="hr-stack">

                @* ==================== 3.5 EMPLOYEE ALLOWANCES & GROSS SALARY (المخصصات والراتب الإجمالي) ==================== *@
                <section class="hr-card" style="border:1px solid color-mix(in srgb, var(--accent) 35%, var(--line));">
                    <div class="hr-card-head" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-a" style="background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);" aria-hidden="true">
                                <Icon Name="banknotes" Size="sm" />
                            </span>
                            <div class="hr-modal-titles">
                                <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                                    <h2 class="hr-h2">سجل المخصصات والراتب الإجمالي</h2>
                                    @if (activeAllowancePeriod == null)
                                    {
                                        <span class="hr-badge hr-badge-warn">بانتظار التهيئة</span>
                                    }
                                </div>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    المخصصات النسبية والمقطوعة وسجل الفترات السابقة وفق سلم الرواتب وقانون الخدمة
                                </p>
                            </div>
                        </div>

                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                            @if (allowancePeriodsHistory.Count > 1)
                            {
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ToggleHistoryDrawer" title="عرض الفترات والتعديلات السابقة">
                                    <Icon Name="clock" Size="xs" />
                                    <span>أرشيف الفترات (@allowancePeriodsHistory.Count)</span>
                                </button>
                            }

                            @if (isStaff)
                            {
                                <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="() => OpenAllowanceModal(isEditCurrent: activeAllowancePeriod != null)">
                                    <Icon Name="plus" Size="xs" />
                                    <span>@(activeAllowancePeriod != null ? "تعديل / إضافة مخصصات (فترة جديدة)" : "تهيئة حزمة المخصصات")</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="hr-card-body hr-stack">
                        @if (activeAllowancePeriod != null)
                        {
                            @* --- 4 KPI Metric Summary Cards --- *@
                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(170px, 100%), 1fr));gap:var(--s-2);">
                                @* 1. Basic Salary *@
                                <div class="hr-card" style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                                        <span class="hr-meta" style="font-size:var(--fs-caption);">الراتب الإسمي الأساسي</span>
                                        <span class="hr-badge" style="font-size:var(--fs-caption);">السلم الوظيفي</span>
                                    </div>
                                    <div class="hr-num" style="font-size:1.25rem;font-weight:800;color:var(--text);">
                                        @activeAllowancePeriod.BasicSalary.ToString("N0") <span style="font-size:var(--fs-caption);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                    </div>
                                </div>

                                @* 2. Percentage Allowances Total *@
                                <div class="hr-card" style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                                        <span class="hr-meta" style="font-size:var(--fs-caption);">المخصصات النسبية</span>
                                        <span class="hr-badge hr-badge-accent" style="font-size:var(--fs-caption);">
                                            @activeAllowancePeriod.TotalPercentageRate.ToString("G29")%
                                        </span>
                                    </div>
                                    <div class="hr-num" style="font-size:1.25rem;font-weight:800;color:var(--series-2);">
                                        @activeAllowancePeriod.TotalPercentageAmount.ToString("N0") <span style="font-size:var(--fs-caption);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                    </div>
                                </div>

                                @* 3. Fixed Allowances Total *@
                                <div class="hr-card" style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                                        <span class="hr-meta" style="font-size:var(--fs-caption);">المخصصات الثابتة (المقطوعة)</span>
                                        <span class="hr-badge" style="font-size:var(--fs-caption);background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);">
                                            مبالغ ثابتة
                                        </span>
                                    </div>
                                    <div class="hr-num" style="font-size:1.25rem;font-weight:800;color:var(--series-4);">
                                        @activeAllowancePeriod.TotalFixedAmount.ToString("N0") <span style="font-size:var(--fs-caption);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                    </div>
                                </div>

                                @* 4. Gross Salary Total *@
                                <div class="hr-card" style="padding:var(--s-3);background:color-mix(in srgb, var(--series-3) 8%, var(--surface));border:1.5px solid var(--series-3);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                                        <span class="hr-meta" style="font-size:var(--fs-caption);font-weight:700;color:var(--series-3);">إجمالي الراتب والمخصصات</span>
                                        <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">الراتب الكلي</span>
                                    </div>
                                    <div class="hr-num" style="font-size:1.35rem;font-weight:900;color:var(--series-3);">
                                        @activeAllowancePeriod.GrossSalary.ToString("N0") <span style="font-size:var(--fs-caption);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                    </div>
                                </div>
                            </div>

                            @* --- Period Details Banner --- *@
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--s-2);flex-wrap:wrap;padding:var(--s-2) var(--s-3);background:var(--surface-sunken);border-radius:var(--r-md);font-size:var(--fs-label);">
                                <div style="display:flex;align-items:center;gap:var(--s-3);flex-wrap:wrap;">
                                    <span>📅 <strong>تاريخ السريان:</strong> @D(activeAllowancePeriod.StartDate)</span>
                                    @if (activeAllowancePeriod.EndDate.HasValue)
                                    {
                                        <span>إلى @D(activeAllowancePeriod.EndDate.Value)</span>
                                    }
                                    else
                                    {
                                        <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">مستمرة وغير مقيدة بأجل</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(activeAllowancePeriod.OrderNumber))
                                    {
                                        <span>📜 <strong>أمر إداري:</strong> @activeAllowancePeriod.OrderNumber</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(activeAllowancePeriod.ChangeReason))
                                    {
                                        <span class="hr-meta">(@activeAllowancePeriod.ChangeReason)</span>
                                    }
                                </div>
                                <div class="hr-meta" style="font-size:var(--fs-caption);">
                                    💡 المعادلة: الراتب الإجمالي = الراتب الإسمي + (مجموع النسب % × الراتب الإسمي) + المخصصات الثابتة
                                </div>
                            </div>

                            @* --- Active Allowances Table --- *@
                            @if (activeAllowancePeriod.Items.Count > 0)
                            {
                                <div class="hr-tablewrap">
                                    <table class="hr-table">
                                        <thead>
                                            <tr>
                                                <th scope="col" style="width:40px;text-align:center;">#</th>
                                                <th scope="col">اسم المخصص</th>
                                                <th scope="col" style="text-align:center;">نوع الاحتساب</th>
                                                <th scope="col" style="text-align:center;">المعدل / المبلغ المحدد</th>
                                                <th scope="col" style="text-align:left;">المبلغ الشهري المحتسب</th>
                                                <th scope="col">السند والملاحظات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ var aIdx = 1; }
                                            @foreach (var item in activeAllowancePeriod.Items)
                                            {
                                                <tr>
                                                    <td style="text-align:center;" class="hr-meta">@(aIdx++)</td>
                                                    <td>
                                                        <strong style="color:var(--text);">@item.Name</strong>
                                                    </td>
                                                    <td style="text-align:center;">
                                                        @if (item.CalculationType == API.HR.Node.Data.Allowances.AllowanceCalculationType.Percentage)
                                                        {
                                                            <span class="hr-badge hr-badge-accent" style="font-size:var(--fs-caption);">
                                                                نسبية %
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="hr-badge" style="font-size:var(--fs-caption);background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);">
                                                                مقطوعة (ثابتة)
                                                            </span>
                                                        }
                                                    </td>
                                                    <td style="text-align:center;">
                                                        @if (item.CalculationType == API.HR.Node.Data.Allowances.AllowanceCalculationType.Percentage)
                                                        {
                                                            <span class="hr-num hr-cell-strong" style="color:var(--series-2);">
                                                                @item.Percentage?.ToString("G29")%
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="hr-num hr-cell-strong" style="color:var(--series-4);">
                                                                @((item.FixedAmount ?? item.CalculatedAmount).ToString("N0")) د.ع
                                                            </span>
                                                        }
                                                    </td>
                                                    <td style="text-align:left;">
                                                        <span class="hr-num hr-cell-strong" style="color:var(--series-3);font-size:0.95rem;">
                                                            @item.CalculatedAmount.ToString("N0") د.ع
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="hr-meta">@Or(item.Notes, "—")</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="hr-empty" style="padding:var(--s-3);">
                                    <p class="hr-meta">لا توجد مخصصات مدخلة لهذه الفترة الحالية بعد.</p>
                                </div>
                            }

                            @* --- Past History Expandable Accordion --- *@
                            @if (showHistoryDrawer && allowancePeriodsHistory.Count > 1)
                            {
                                <div style="margin-block-start:var(--s-3);padding:var(--s-3);background:var(--surface-sunken);border:1px dashed var(--line);border-radius:var(--r-lg);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:var(--s-3);flex-wrap:wrap;gap:var(--s-2);">
                                        <h3 class="hr-h3" style="margin:0;display:flex;align-items:center;gap:var(--s-2);">
                                            <Icon Name="clock" Size="xs" />
                                            <span>السجل التاريخي للفترات السابقة للمخصصات</span>
                                        </h3>
                                        <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="ToggleHistoryDrawer">
                                            <span>إغلاق الأرشيف ✕</span>
                                        </button>
                                    </div>

                                    <div style="display:flex;flex-direction:column;gap:var(--s-3);">
                                        @foreach (var hp in allowancePeriodsHistory.Where(p => !p.IsCurrent))
                                        {
                                            <div class="hr-card" style="padding:var(--s-3);border:1px solid var(--line);background:var(--surface);">
                                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);margin-block-end:var(--s-2);padding-block-end:var(--s-2);border-block-end:1px solid var(--line);">
                                                    <div>
                                                        <span class="hr-badge" style="font-size:var(--fs-caption);">فترة منتهية</span>
                                                        <strong style="margin-inline-start:var(--s-2);">@D(hp.StartDate) إلى @D(hp.EndDate)</strong>
                                                        @if (!string.IsNullOrWhiteSpace(hp.OrderNumber))
                                                        {
                                                            <span class="hr-meta" style="margin-inline-start:var(--s-2);">الأمر: @hp.OrderNumber</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(hp.ChangeReason))
                                                        {
                                                            <span class="hr-meta" style="margin-inline-start:var(--s-2);">(@hp.ChangeReason)</span>
                                                        }
                                                    </div>
                                                    <div style="display:flex;align-items:center;gap:var(--s-3);">
                                                        <span class="hr-num">الراتب: <strong>@hp.GrossSalary.ToString("N0") د.ع</strong></span>
                                                        @if (isStaff)
                                                        {
                                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" style="color:var(--danger);" @onclick="() => DeletePeriodHistoryAsync(hp.Id)" title="حذف هذه الفترة من الأرشيف">
                                                                <Icon Name="trash" Size="xs" />
                                                            </button>
                                                        }
                                                    </div>
                                                </div>

                                                <div style="display:flex;flex-wrap:wrap;gap:var(--s-2);">
                                                    @foreach (var hItem in hp.Items)
                                                    {
                                                        <span class="hr-badge" style="background:var(--surface-sunken);border:1px solid var(--line);font-size:var(--fs-caption);">
                                                            @hItem.Name:
                                                            @(hItem.CalculationType == API.HR.Node.Data.Allowances.AllowanceCalculationType.Percentage ? $"{hItem.Percentage:G29}%" : $"{hItem.CalculatedAmount:N0} د.ع")
                                                            (@hItem.CalculatedAmount.ToString("N0") د.ع)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="hr-empty" style="padding:var(--s-5);text-align:center;">
                                <div style="width:48px;height:48px;border-radius:var(--r-full);background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);display:grid;place-items:center;margin:0 auto var(--s-2) auto;">
                                    <Icon Name="banknotes" Size="md" />
                                </div>
                                <h3 class="hr-h3" style="margin-block-end:var(--s-1);">لم يتم تهيئة حزمة مخصصات لهذا الموظف بعد</h3>
                                <p class="hr-meta" style="max-width:480px;margin:0 auto var(--s-3) auto;">
                                    يمكنك بنقرة واحدة تهيئة حزمة المخصصات، وسيقوم النظام باقتراح الراتب الإسمي تلقائياً بناءً على الدرجة والمرحلة (@(suggestedBasicSalary > 0 ? $"{suggestedBasicSalary:N0} د.ع" : "السلم الوظيفي")).
                                </p>
                                @if (isStaff)
                                {
                                    <button type="button" class="hr-btn hr-btn-primary" @onclick="() => OpenAllowanceModal(isEditCurrent: false)">
                                        <Icon Name="plus" Size="xs" />
                                        <span>تهيئة وإضافة مخصصات الموظف الآن</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>

        @* ==================== TAB: FINANCIAL ACCOUNTS (الذمة المالية والحسابات: الرصيد والسلف والقروض) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Financial ? "is-active" : "")">
            <div class="hr-stack">
                <section class="hr-card" style="border:1px solid color-mix(in srgb, var(--accent) 35%, var(--line));">
                    <div class="hr-card-head" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-a" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color: var(--accent-text);" aria-hidden="true">
                                <Icon Name="banknotes" Size="sm" />
                            </span>
                            <div class="hr-modal-titles">
                                <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                                    <h2 class="hr-h2">الذمة المالية وحسابات الموظف</h2>
                                    @if (financialAccount != null)
                                    {
                                        <span class="hr-badge hr-badge-ok">حساب نشط وموثق</span>
                                    }
                                    else
                                    {
                                        <span class="hr-badge">البيانات المالية: غير متوفرة</span>
                                    }
                                </div>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    متابعة الرصيد المالي الحالي، متبقي القروض، متبقي السلف، وسجل حركات الإيداع والسحب
                                </p>
                            </div>
                        </div>

                        @if (isStaff)
                        {
                            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="OpenUpdateBalancesModal" title="تعديل مباشر للأرصدة والقروض والسلف">
                                    <Icon Name="pencil-square" Size="xs" />
                                    <span>تعديل الأرصدة والقروض</span>
                                </button>
                                <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="OpenAddTransactionModal" title="تسجيل حركة إيداع أو سحب جديدة على الرصيد">
                                    <Icon Name="plus" Size="xs" />
                                    <span>تسجيل حركة مالية (إيداع / سحب)</span>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="hr-card-body hr-stack">
                        @* --- 3 DEDICATED SECTIONS FOR BALANCE, LOAN, ADVANCE --- *@
                        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(280px, 100%), 1fr));gap:var(--s-4);">
                            @* 1. Balance Section *@
                            <div class="hr-card" style="padding:var(--s-4);background:color-mix(in srgb, var(--series-2) 6%, var(--surface));border:1.5px solid color-mix(in srgb, var(--series-2) 40%, var(--line));border-radius:var(--r-lg);display:flex;flex-direction:column;justify-content:space-between;gap:var(--s-3);">
                                <div>
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:0.5rem;flex-wrap:wrap;gap:var(--s-2);">
                                        <div style="display:flex;align-items:center;gap:0.5rem;">
                                            <span class="hr-iconplate hr-iconplate-ok" style="width:2rem;height:2rem;" aria-hidden="true">
                                                <Icon Name="banknotes" Size="xs" />
                                            </span>
                                            <span style="font-weight:700;font-size:0.95rem;color:var(--text);">الرصيد المالي الحالي</span>
                                        </div>
                                        @if (financialAccount != null)
                                        {
                                            <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">حساب جاري</span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge" style="font-size:var(--fs-caption);">غير متوفر</span>
                                        }
                                    </div>
                                    <div class="hr-num" style="font-size:1.85rem;font-weight:900;color:var(--series-2);margin-block:0.5rem 0.25rem;">
                                        @if (financialAccount != null)
                                        {
                                            @financialAccount.Balance.ToString("N0") <span style="font-size:var(--fs-body);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:1.4rem;font-weight:700;color:var(--text-muted);font-style:italic;">غير متوفر</span>
                                        }
                                    </div>
                                </div>
                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;padding-block-start:0.5rem;border-block-start:1px dashed var(--line);">
                                    <span class="hr-meta" style="font-size:var(--fs-label);display:flex;align-items:center;gap:0.35rem;" title="@financialAccount?.BalanceLastUpdatedAt.ToExactString()">
                                        <Icon Name="clock" Size="xs" />
                                        <span>آخر تحديث: <strong>@(financialAccount != null ? financialAccount.BalanceLastUpdatedAt.ToRelativeArabic() : "غير متوفر")</strong></span>
                                    </span>
                                    @if (isStaff)
                                    {
                                        <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => OpenQuickTransaction(FinancialTransactionType.Deposit)">
                                            <Icon Name="plus" Size="xs" />
                                            <span>إيداع سريع</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            @* 2. Loan Remaining Section *@
                            <div class="hr-card" style="padding:var(--s-4);background:color-mix(in srgb, var(--accent) 6%, var(--surface));border:1.5px solid color-mix(in srgb, var(--accent) 40%, var(--line));border-radius:var(--r-lg);display:flex;flex-direction:column;justify-content:space-between;gap:var(--s-3);">
                                <div>
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:0.5rem;flex-wrap:wrap;gap:var(--s-2);">
                                        <div style="display:flex;align-items:center;gap:0.5rem;">
                                            <span class="hr-iconplate hr-plate-a" style="width:2rem;height:2rem;" aria-hidden="true">
                                                <Icon Name="briefcase" Size="xs" />
                                            </span>
                                            <span style="font-weight:700;font-size:0.95rem;color:var(--text);">متبقي القرض</span>
                                        </div>
                                        @if (financialAccount == null)
                                        {
                                            <span class="hr-badge" style="font-size:var(--fs-caption);">غير متوفر</span>
                                        }
                                        else if (financialAccount.LoanRemaining > 0)
                                        {
                                            <span class="hr-badge hr-badge-accent" style="font-size:var(--fs-caption);">قيد الاستقطاع</span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">مسدد بالكامل</span>
                                        }
                                    </div>
                                    <div class="hr-num" style="font-size:1.85rem;font-weight:900;color: var(--accent-text);margin-block:0.5rem 0.25rem;">
                                        @if (financialAccount != null)
                                        {
                                            @financialAccount.LoanRemaining.ToString("N0") <span style="font-size:var(--fs-body);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:1.4rem;font-weight:700;color:var(--text-muted);font-style:italic;">غير متوفر</span>
                                        }
                                    </div>
                                </div>
                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;padding-block-start:0.5rem;border-block-start:1px dashed var(--line);">
                                    <span class="hr-meta" style="font-size:var(--fs-label);display:flex;align-items:center;gap:0.35rem;" title="@financialAccount?.LoanLastUpdatedAt.ToExactString()">
                                        <Icon Name="clock" Size="xs" />
                                        <span>آخر تحديث: <strong>@(financialAccount != null ? financialAccount.LoanLastUpdatedAt.ToRelativeArabic() : "غير متوفر")</strong></span>
                                    </span>
                                    <span class="hr-badge" style="font-size:var(--fs-caption);">قروض مصرفية / إسكان</span>
                                </div>
                            </div>

                            @* 3. Advance Remaining Section *@
                            <div class="hr-card" style="padding:var(--s-4);background:color-mix(in srgb, var(--series-4) 6%, var(--surface));border:1.5px solid color-mix(in srgb, var(--series-4) 40%, var(--line));border-radius:var(--r-lg);display:flex;flex-direction:column;justify-content:space-between;gap:var(--s-3);">
                                <div>
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:0.5rem;flex-wrap:wrap;gap:var(--s-2);">
                                        <div style="display:flex;align-items:center;gap:0.5rem;">
                                            <span class="hr-iconplate hr-iconplate-warn" style="width:2rem;height:2rem;" aria-hidden="true">
                                                <Icon Name="calendar-days" Size="xs" />
                                            </span>
                                            <span style="font-weight:700;font-size:0.95rem;color:var(--text);">متبقي السلفة</span>
                                        </div>
                                        @if (financialAccount == null)
                                        {
                                            <span class="hr-badge" style="font-size:var(--fs-caption);">غير متوفر</span>
                                        }
                                        else if (financialAccount.AdvanceRemaining > 0)
                                        {
                                            <span class="hr-badge hr-badge-warn" style="font-size:var(--fs-caption);">سلفة جارية</span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">مسددة بالكامل</span>
                                        }
                                    </div>
                                    <div class="hr-num" style="font-size:1.85rem;font-weight:900;color:var(--series-4);margin-block:0.5rem 0.25rem;">
                                        @if (financialAccount != null)
                                        {
                                            @financialAccount.AdvanceRemaining.ToString("N0") <span style="font-size:var(--fs-body);font-weight:normal;color:var(--text-muted);">د.ع</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:1.4rem;font-weight:700;color:var(--text-muted);font-style:italic;">غير متوفر</span>
                                        }
                                    </div>
                                </div>
                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;padding-block-start:0.5rem;border-block-start:1px dashed var(--line);">
                                    <span class="hr-meta" style="font-size:var(--fs-label);display:flex;align-items:center;gap:0.35rem;" title="@financialAccount?.AdvanceLastUpdatedAt.ToExactString()">
                                        <Icon Name="clock" Size="xs" />
                                        <span>آخر تحديث: <strong>@(financialAccount != null ? financialAccount.AdvanceLastUpdatedAt.ToRelativeArabic() : "غير متوفر")</strong></span>
                                    </span>
                                    <span class="hr-badge" style="font-size:var(--fs-caption);">سلف تشغيلية / شخصية</span>
                                </div>
                            </div>
                        </div>

                        @* --- TRANSACTIONS SECTION --- *@
                        <div class="hr-card" style="margin-block-start:var(--s-4);border:1px solid var(--line);">
                            <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);padding:var(--s-3) var(--s-4);">
                                <div>
                                    <h3 class="hr-h3" style="display:flex;align-items:center;gap:0.5rem;">
                                        <Icon Name="arrows-right-left" Size="sm" />
                                        <span>سجل حركات الإيداعات والسحب على الرصيد</span>
                                        <span class="hr-badge">@financialTransactions.Count حركة</span>
                                    </h3>
                                    <p class="hr-meta" style="margin-block-start:0.2rem;">
                                        توثيق كامل لكافة حركات الإيداع والسحب والتسويات مع أوقات الحركات بدقة وتوقيت نسبي
                                    </p>
                                </div>

                                <div style="display:flex;align-items:center;gap:0.35rem;">
                                    <button type="button" class="hr-btn @(financialTransactionFilter == "all" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                            @onclick='() => financialTransactionFilter = "all"'>الكل</button>
                                    <button type="button" class="hr-btn @(financialTransactionFilter == "deposit" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                            @onclick='() => financialTransactionFilter = "deposit"'>الإيداعات</button>
                                    <button type="button" class="hr-btn @(financialTransactionFilter == "withdrawal" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                            @onclick='() => financialTransactionFilter = "withdrawal"'>السحوبات</button>
                                    <button type="button" class="hr-btn @(financialTransactionFilter == "adjustment" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                            @onclick='() => financialTransactionFilter = "adjustment"'>التسويات</button>
                                </div>
                            </div>

                            <div class="hr-card-body" style="padding:0;">
                                @{
                                    var filteredTxs = financialTransactions.Where(t =>
                                        financialTransactionFilter == "all" ||
                                        (financialTransactionFilter == "deposit" && t.TransactionType == FinancialTransactionType.Deposit) ||
                                        (financialTransactionFilter == "withdrawal" && t.TransactionType == FinancialTransactionType.Withdrawal) ||
                                        (financialTransactionFilter == "adjustment" && (t.TransactionType == FinancialTransactionType.Adjustment || t.TransactionType == FinancialTransactionType.InitialBalance))
                                    ).ToList();
                                }

                                @if (filteredTxs.Count == 0)
                                {
                                    <div class="hr-empty" style="padding:var(--s-8) var(--s-4);">
                                        <span class="hr-empty-art" aria-hidden="true">
                                            <Icon Name="banknotes" Size="lg" />
                                        </span>
                                        <p class="hr-h3">لا توجد حركات مالية مسجلة</p>
                                        <p class="hr-sub">لم يتم تسجيل أي عمليات إيداع أو سحب في سجل حركات هذا الموظف حتى الآن.</p>
                                        @if (isStaff)
                                        {
                                            <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="OpenAddTransactionModal">
                                                <Icon Name="plus" Size="xs" />
                                                <span>تسجيل حركة جديدة</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="hr-tablewrap">
                                        <table class="hr-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col" style="width:50px;">#</th>
                                                    <th scope="col">نوع الحركة</th>
                                                    <th scope="col">المبلغ</th>
                                                    <th scope="col">الرصيد بعد الحركة</th>
                                                    <th scope="col">وقت وتاريخ الحركة</th>
                                                    <th scope="col">رقم الإشعار / المرجع</th>
                                                    <th scope="col">البيان والملاحظات</th>
                                                    <th scope="col">المنفذ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ var txIdx = 1; }
                                                @foreach (var tx in filteredTxs)
                                                {
                                                    <tr>
                                                        <td>@txIdx</td>
                                                        <td>
                                                            @if (tx.TransactionType == FinancialTransactionType.Deposit)
                                                            {
                                                                <span class="hr-badge hr-badge-ok" style="gap:0.25rem;">
                                                                    <Icon Name="arrow-down-tray" Size="xs" /> إيداع
                                                                </span>
                                                            }
                                                            else if (tx.TransactionType == FinancialTransactionType.Withdrawal)
                                                            {
                                                                <span class="hr-badge hr-badge-danger" style="gap:0.25rem;">
                                                                    <Icon Name="arrow-up-tray" Size="xs" /> سحب
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="hr-badge hr-badge-accent" style="gap:0.25rem;">
                                                                    <Icon Name="arrows-right-left" Size="xs" /> تسوية
                                                                </span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (tx.TransactionType == FinancialTransactionType.Deposit)
                                                            {
                                                                <span class="hr-num hr-cell-strong" style="color:var(--ok);">
                                                                    + @tx.Amount.ToString("N0") د.ع
                                                                </span>
                                                            }
                                                            else if (tx.TransactionType == FinancialTransactionType.Withdrawal)
                                                            {
                                                                <span class="hr-num hr-cell-strong" style="color:var(--danger);">
                                                                    - @tx.Amount.ToString("N0") د.ع
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="hr-num hr-cell-strong" style="color:var(--series-3);">
                                                                    @tx.Amount.ToString("N0") د.ع
                                                                </span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="hr-num" style="font-weight:700;">
                                                                @tx.BalanceAfter.ToString("N0") د.ع
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div style="display:flex;flex-direction:column;gap:2px;">
                                                                <strong style="color:var(--text);font-size:var(--fs-control);" title="@tx.TransactionDate.ToExactString()">
                                                                    @tx.TransactionDate.ToRelativeArabic()
                                                                </strong>
                                                                <span class="hr-meta" style="font-size:var(--fs-caption);">
                                                                    @tx.TransactionDate.ToExactString()
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(tx.ReferenceNumber))
                                                            {
                                                                <code class="hr-num" style="font-size:var(--fs-caption);padding:2px 6px;border-radius:4px;background:var(--surface-sunken);">
                                                                    @tx.ReferenceNumber
                                                                </code>
                                                            }
                                                            else
                                                            {
                                                                <span class="hr-meta">—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span style="font-size:var(--fs-control);">@(tx.Description ?? "—")</span>
                                                        </td>
                                                        <td>
                                                            <span class="hr-meta" style="font-size:var(--fs-label);">@(tx.CreatedBy ?? "النظام")</span>
                                                        </td>
                                                    </tr>
                                                    txIdx++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        @* ==================== TAB 2: CAREER MOVEMENTS (حركة التنقلات) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Movements ? "is-active" : "")">
            <div class="hr-stack">

                @* ==================== 4. SERVICE MOVEMENTS (حركة التنقلات) ==================== *@
                @{
                    var servicePeriods = careerMovements.Count == 0 ? new List<ServicePeriodDisplay>() : GetServicePeriods();
                    var totalServiceDays = Math.Max(1, servicePeriods.Sum(p => p.EndDate.DayNumber - p.StartDate.DayNumber + 1));
                }
                <section class="hr-card" aria-labelledby="moves-title">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-c" aria-hidden="true"><Icon Name="arrows-right-left" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2" id="moves-title">حركة التنقلات</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    تنقلات الخدمة من الأحدث إلى الأقدم، وما يُحتسب من كل تنقل
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            @if (servicePeriods.Count > 0)
                            {
                                <span class="hr-badge hr-badge-accent">
                                    <span class="hr-num">@N(servicePeriods.Count)</span> تنقل
                                </span>
                            }
                        </div>
                    </div>

                    <div class="hr-card-body">
                        @if (servicePeriods.Count == 0)
                        {
                            <div class="hr-empty">
                                <span class="hr-empty-art" aria-hidden="true"><Icon Name="arrows-right-left" Size="lg" /></span>
                                <p class="hr-h3">لا توجد حركات تنقل مفصلة مسجلة</p>
                                <p class="hr-sub hr-measure-sm">
                                    الخدمة تحتسب حالياً تلقائياً من تاريخ المباشرة (@D(employee.HireDate)) وحتى اليوم كفترة مستمرة واحدة لجميع الأغراض (علاوة، ترفيع، تقاعد).
                                    يمكن إدراج حركات الخدمة والتنقلات من صفحة استيراد البيانات (Excel).
                                </p>
                            </div>
                        }
                        else
                        {
                            <ol class="hr-moves">
                                @foreach (var period in Enumerable.Reverse(servicePeriods))
                                {
                                    var isOut = IsOutOfService(period.FormationName);
                                    var spanDays = period.EndDate.DayNumber - period.StartDate.DayNumber + 1;
                                    var share = Math.Clamp(spanDays * 100.0 / totalServiceDays, 2, 100);

                                    <li class="hr-move @(period.IsCurrent ? "is-current" : "") @(isOut ? "is-out" : "")" @key="period.Id">
                                        <div class="hr-move-when">
                                            <span class="hr-move-year hr-num">@period.StartDate.Year</span>
                                        </div>

                                        <span class="hr-move-node" aria-hidden="true">
                                            @if (isOut)
                                            {
                                                <Icon Name="no-symbol" Size="xs" />
                                            }
                                            else if (period.IsCurrent)
                                            {
                                                <Icon Name="map-pin" Size="xs" />
                                            }
                                        </span>

                                        <article class="hr-move-card">
                                            <header class="hr-move-head">
                                                <h3 class="hr-move-title">@period.FormationName</h3>
                                                @if (period.IsCurrent)
                                                {
                                                    <span class="hr-badge hr-badge-ok">التنقل الحالي</span>
                                                }
                                                @if (isOut)
                                                {
                                                    <span class="hr-badge hr-badge-warn">
                                                        <Icon Name="exclamation-triangle" Size="xs" />
                                                        <span>خارج الخدمة</span>
                                                    </span>
                                                }
                                            </header>

                                            <div class="hr-move-meta">
                                                <span class="hr-move-range">
                                                    <Icon Name="calendar-days" Size="xs" />
                                                    <span>
                                                        من <span class="hr-num">@D(period.StartDate)</span>
                                                        إلى <span class="hr-num">@(period.IsCurrent ? "الآن" : D(period.EndDate))</span>
                                                    </span>
                                                </span>
                                                <span class="hr-move-span">
                                                    <Icon Name="clock" Size="xs" />
                                                    <span class="hr-num">@FormatDuration(period.Years, period.Months, period.Days)</span>
                                                </span>
                                            </div>

                                            @* Relative length of this transfer across the whole record *@
                                            <div class="hr-move-share" title="@($"{share:0.#}% من مجموع مدة التنقلات")" aria-hidden="true">
                                                <span style="inline-size:@(share.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(period.Notes))
                                            {
                                                <p class="hr-move-note">@period.Notes</p>
                                            }

                                            <ul class="hr-move-counts" aria-label="احتساب المدة">
                                                <li class="@(period.CountForAllowance ? "is-ok" : "is-dim")">
                                                    <Icon Name="@(period.CountForAllowance ? "check" : "x-mark")" Size="xs" />
                                                    <span>علاوة @(period.CountForAllowance ? "محتسبة" : "مستثناة")</span>
                                                </li>
                                                <li class="@(period.CountForPromotion ? "is-ok" : "is-dim")">
                                                    <Icon Name="@(period.CountForPromotion ? "check" : "x-mark")" Size="xs" />
                                                    <span>ترفيع @(period.CountForPromotion ? "محتسب" : "مستثنى")</span>
                                                </li>
                                                <li class="@(period.CountForPension ? "is-ok" : "is-dim")">
                                                    <Icon Name="@(period.CountForPension ? "check" : "x-mark")" Size="xs" />
                                                    <span>تقاعد @(period.CountForPension ? "محتسب" : "مستثنى")</span>
                                                </li>
                                            </ul>
                                        </article>
                                    </li>
                                }
                            </ol>

                            @* Summary placed at the bottom as requested *@
                            <dl class="hr-moves-summary" style="margin-block-start: var(--s-4); margin-block-end: 0;">
                                <div class="hr-moves-stat">
                                    <dt>خدمة العلاوة المحتسبة</dt>
                                    <dd class="hr-num">@GetNetAllowanceServiceText()</dd>
                                </div>
                                <div class="hr-moves-stat">
                                    <dt>خدمة الترفيع المحتسبة</dt>
                                    <dd class="hr-num">@GetNetPromotionServiceText()</dd>
                                </div>
                                <div class="hr-moves-stat">
                                    <dt>خدمة التقاعد المحتسبة</dt>
                                    <dd class="hr-num">@GetNetPensionServiceText()</dd>
                                </div>
                            </dl>
                        }
                    </div>
                </section>
            </div>
        </div>

        @* ==================== TAB 4: LETTERS (كتب الشكر والتقدير) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Letters ? "is-active" : "")">
            <div class="hr-stack">

                @* --- appreciation letters --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-iconplate-ok" aria-hidden="true"><Icon Name="sparkles" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">سجل كتب الشكر والتقدير</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    الأوسمة وكتب الشكر الممنوحة، ومدة القِدم الوظيفي المحتسبة عنها
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <span class="hr-badge hr-badge-accent">
                                <span class="hr-num">@N(appreciationLetters.Count)</span> كتاب
                            </span>
                            @if (appreciationLetters.Count > 0)
                            {
                                <span class="hr-badge hr-badge-ok">
                                    <Icon Name="sparkles" Size="xs" />
                                    <span>إجمالي القِدم: @FormatTotalSeniority()</span>
                                </span>
                            }
                        </div>
                    </div>

                    @if (appreciationLetters.Count == 0)
                    {
                        <div class="hr-empty">
                            <span class="hr-empty-art" aria-hidden="true"><Icon Name="sparkles" Size="lg" /></span>
                            <p class="hr-h3">لا توجد كتب شكر مسجلة</p>
                            <p class="hr-sub hr-measure-sm">
                                ستظهر هنا كتب الشكر الممنوحة من الوزير أو الوكيل أو المدير العام فور إضافتها،
                                ومعها القِدم المحتسب عن كل كتاب وفق الضوابط.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <caption class="hr-sr">
                                    كتب الشكر والتقدير الممنوحة للموظف @employee.Name، مرتّبة من الأحدث إلى الأقدم.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">رقم وتاريخ الكتاب</th>
                                        <th scope="col">نوع كتاب الشكر</th>
                                        <th scope="col">الموضوع / العنوان</th>
                                        <th scope="col">القِدم المكتسب</th>
                                        <th scope="col">الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var letter in appreciationLetters)
                                    {
                                        <tr @key="letter.Id">
                                            <td>
                                                <span class="hr-cell-strong">
                                                    @(string.IsNullOrWhiteSpace(letter.LetterNumber)
                                                        ? "بدون رقم كتاب"
                                                        : $"كتاب رقم {letter.LetterNumber}")
                                                </span>
                                                <span class="hr-cell-sub hr-num">@D(letter.LetterDate)</span>
                                            </td>

                                            <td>
                                                <span class="hr-badge">@(letter.Type?.Name ?? "كتاب شكر رسمي")</span>
                                            </td>

                                            <td>
                                                <span class="hr-cell-strong hr-cell-wide">
                                                    @(letter.TitleLookup?.Name ?? (string.IsNullOrWhiteSpace(letter.Title)
                                                        ? "شكر وتقدير للجهود المتميزة"
                                                        : letter.Title))
                                                </span>
                                            </td>

                                            <td>
                                                @if (HasLetterSeniority(letter))
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="sparkles" Size="xs" />
                                                        <span>@FormatLetterSeniority(letter)</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge" style="opacity:0.75;">
                                                        بدون قِدم
                                                    </span>
                                                }
                                                @if ((letter.Count ?? 1) > 1)
                                                {
                                                    <span class="hr-cell-sub hr-num" style="display:block; margin-top:2px;">
                                                        عدد الكتب: @(letter.Count)
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                <span class="hr-cell-sub hr-cell-wide">
                                                    @Or(letter.Notes)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </div>

        @* ==================== TAB 5: PENALTIES (العقوبات الانضباطية) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Penalties ? "is-active" : "")">
            <div class="hr-stack">

                @* --- disciplinary penalties --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate @(employeePenalties.Count > 0 ? "hr-iconplate-danger" : "hr-iconplate-ok")" aria-hidden="true"><Icon Name="exclamation-triangle" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">سجل العقوبات الانضباطية</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    بيانات العقوبات وتاريخ نيل العقوبة والكتب الرسمية الصادرة
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            @if (employeePenalties.Count > 0)
                            {
                                <span class="hr-badge hr-badge-danger">
                                    <Icon Name="exclamation-triangle" Size="xs" />
                                    <span class="hr-num">@N(employeePenalties.Count)</span> عقوبة مسجلة
                                </span>
                            }
                            else
                            {
                                <span class="hr-badge hr-badge-ok">
                                    <Icon Name="check-circle" Size="xs" />
                                    <span>السجل نظيف (خالٍ من العقوبات)</span>
                                </span>
                            }
                        </div>
                    </div>

                    @if (employeePenalties.Count == 0)
                    {
                        <div class="hr-empty">
                            <span class="hr-empty-art" aria-hidden="true"><Icon Name="check-circle" Size="lg" /></span>
                            <p class="hr-h3">لا توجد عقوبات انضباطية مسجلة</p>
                            <p class="hr-sub hr-measure-sm">
                                السجل الوظيفي للموظف خالٍ من أي عقوبات أو إنذارات انضباطية رسمية مسجلة بالنظام.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <caption class="hr-sr">
                                    العقوبات الانضباطية المسجلة للموظف @employee.Name، مرتبة من الأحدث إلى الأقدم.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">العقوبة</th>
                                        <th scope="col">تاريخ نيل العقوبة</th>
                                        <th scope="col">رقم وتاريخ الكتاب</th>
                                        <th scope="col">الجهة / التشكيل</th>
                                        <th scope="col">الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pen in employeePenalties)
                                    {
                                        <tr @key="pen.Id">
                                            <td>
                                                <span class="hr-badge hr-badge-danger" style="font-weight:700;">
                                                    @(pen.PenaltyType?.Name ?? "عقوبة")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hr-cell-strong hr-num">
                                                    @D(pen.PenaltyDate)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hr-cell-strong">
                                                    @(string.IsNullOrWhiteSpace(pen.OrderNumber) ? "—" : $"كتاب رقم {pen.OrderNumber}")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hr-cell-strong">
                                                    @GetPenaltyFormation(pen)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hr-cell-sub hr-cell-wide">
                                                    @Or(pen.Notes)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </div>

        @* ==================== TAB 6: LEAVES (الإجازات والدوام) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Leaves ? "is-active" : "")">
            <div class="hr-stack">

                @* --- leaves and attendance ledger --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-b" aria-hidden="true"><Icon Name="calendar-days" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">سجل وحركات الإجازات الرسمية</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    توثيق الإجازات الاعتيادية والمرضية والخاصة الممنوحة، والأوامر الإدارية المنفذة
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <span class="hr-badge hr-badge-accent">
                                <span class="hr-num">@N(employeeLeaves.Count)</span> حركة مسجلة
                            </span>
                            @if (GetCurrentActiveLeave() is { } activeNowHeader)
                            {
                                <span class="hr-badge hr-badge-warn">
                                    <Icon Name="clock" Size="xs" />
                                    <span>مجاز حالياً حتى @D(activeNowHeader.EndDate)</span>
                                </span>
                            }
                            else
                            {
                                <span class="hr-badge hr-badge-ok">
                                    <Icon Name="check-circle" Size="xs" />
                                    <span>مستمر بالدوام</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="hr-card-body" style="padding-block-start: var(--s-3);">
                        @* ---------- DEDICATED LEAVE BALANCE HERO WIDGET ---------- *@
                        <div class="hr-leave-hero">
                            <div class="hr-leave-hero-primary">
                                <div class="hr-leave-hero-title">
                                    <Icon Name="calendar-days" Size="sm" />
                                    <span>رصيد الإجازات المتبقي</span>
                                </div>
                                <div class="hr-leave-hero-valrow">
                                    <strong class="hr-leave-hero-val @(employee.LeaveBalance.GetValueOrDefault(0) > 0 ? "is-positive" : "")">
                                        @(employee.LeaveBalance.HasValue ? $"{employee.LeaveBalance.Value:G29}" : "—")
                                    </strong>
                                    <span class="hr-leave-hero-unit">يوم مستحق</span>
                                </div>
                                <p class="hr-leave-hero-meta">
                                    الرصيد التراكمي المتبقي للموظف بموجب سجلات الخدمة والتعليمات النافذة.
                                </p>
                            </div>

                            <div class="hr-leave-hero-tile">
                                <div class="hr-leave-hero-tile-label">
                                    <Icon Name="check-badge" Size="xs" />
                                    <span>المتمتّع بها (المتخذ)</span>
                                </div>
                                <div class="hr-leave-hero-tile-val hr-num">
                                    @N(GetTotalLeaveDays()) <span style="font-size:var(--fs-control);font-weight:600;color:var(--text-3);">يوم</span>
                                </div>
                                <div class="hr-leave-hero-tile-foot">
                                    إجمالي الأيام الممنوحة رسمياً
                                </div>
                            </div>

                            <div class="hr-leave-hero-tile">
                                <div class="hr-leave-hero-tile-label">
                                    <Icon Name="clock" Size="xs" />
                                    <span>الموقف الحالي</span>
                                </div>
                                @{
                                    var activeLeaveItem = GetCurrentActiveLeave();
                                }
                                <div class="hr-leave-hero-tile-val">
                                    @if (activeLeaveItem != null)
                                    {
                                        <span class="hr-badge hr-badge-warn" style="font-size:var(--fs-label);padding:0.2rem 0.5rem;">
                                            مجاز حالياً
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-label);padding:0.2rem 0.5rem;">
                                            مستمر بالدوام
                                        </span>
                                    }
                                </div>
                                <div class="hr-leave-hero-tile-foot">
                                    @if (activeLeaveItem != null)
                                    {
                                        <span>ينتهي في @D(activeLeaveItem.EndDate)</span>
                                    }
                                    else
                                    {
                                        <span>على رأس العمل ومباشر</span>
                                    }
                                </div>
                            </div>

                            <div class="hr-leave-hero-tile">
                                <div class="hr-leave-hero-tile-label">
                                    <Icon Name="document-text" Size="xs" />
                                    <span>حركات الإجازة</span>
                                </div>
                                <div class="hr-leave-hero-tile-val hr-num">
                                    @N(employeeLeaves.Count) <span style="font-size:var(--fs-control);font-weight:600;color:var(--text-3);">حركة</span>
                                </div>
                                <div class="hr-leave-hero-tile-foot">
                                    الأوامر الإدارية المنفذة
                                </div>
                            </div>
                        </div>

                    @if (employeeLeaves.Count == 0)
                    {
                        <div class="hr-empty">
                            <span class="hr-empty-art" aria-hidden="true"><Icon Name="calendar-days" Size="lg" /></span>
                            <p class="hr-h3">لا توجد حركات إجازة مسجلة</p>
                            <p class="hr-sub hr-measure-sm">
                                لم يتم تسجيل أي حركات إجازة رسمية لهذا الموظف حتى الآن. تظهر هنا الإجازات المعتمدة وعدد أيامها وأوامرها الإدارية فور تسجيلها.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <caption class="hr-sr">
                                    حركات الإجازات الرسمية للموظف @employee.Name، مرتبة من الأحدث إلى الأقدم.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">نوع الإجازة</th>
                                        <th scope="col">الفترة الزمنية</th>
                                        <th scope="col">المدة</th>
                                        <th scope="col">الأمر الإداري وتاريخه</th>
                                        <th scope="col">الحالة التنفيذية</th>
                                        <th scope="col">الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var leave in employeeLeaves)
                                    {
                                        var isCurrentActive = leave.StartDate <= DateOnly.FromDateTime(DateTime.Today) 
                                            && leave.EndDate >= DateOnly.FromDateTime(DateTime.Today)
                                            && leave.Status != "ملغاة" && leave.Status != "مرفوضة";

                                        <tr @key="leave.Id">
                                            <td>
                                                <div style="display:flex; align-items:center; gap:0.4rem;">
                                                    <span class="hr-badge hr-badge-accent">
                                                        @(leave.LeaveType?.Name ?? "إجازة رسمية")
                                                    </span>
                                                    @if (isCurrentActive)
                                                    {
                                                        <span class="hr-badge hr-badge-warn" style="font-size:var(--fs-caption); padding:0.15rem 0.4rem;">
                                                            جارية اليوم
                                                        </span>
                                                    }
                                                </div>
                                            </td>

                                            <td>
                                                <span class="hr-cell-strong hr-num">
                                                    من @D(leave.StartDate) إلى @D(leave.EndDate)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="hr-badge hr-badge-ok">
                                                    <span class="hr-num">@(leave.DaysCount > 0 ? leave.DaysCount : (leave.EndDate.DayNumber - leave.StartDate.DayNumber + 1))</span> يوم
                                                </span>
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(leave.OrderNumber))
                                                {
                                                    <span class="hr-cell-strong">أمر رقم @leave.OrderNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-cell-sub">بدون رقم أمر</span>
                                                }
                                                @if (leave.OrderDate.HasValue)
                                                {
                                                    <span class="hr-cell-sub hr-num">بتاريخ @D(leave.OrderDate)</span>
                                                }
                                            </td>

                                            <td>
                                                @if (leave.Status == "معتمدة" || string.IsNullOrWhiteSpace(leave.Status))
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="check-circle" Size="xs" />
                                                        <span>معتمدة</span>
                                                    </span>
                                                }
                                                else if (leave.Status == "قيد الانتظار" || leave.Status == "قيد التدقيق")
                                                {
                                                    <span class="hr-badge hr-badge-warn">
                                                        <Icon Name="clock" Size="xs" />
                                                        <span>@leave.Status</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-danger">
                                                        <Icon Name="x-mark" Size="xs" />
                                                        <span>@leave.Status</span>
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                <span class="hr-cell-sub hr-cell-wide">
                                                    @Or(leave.Notes)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    </div>
                </section>
            </div>
        </div>

        @* ==================== TAB 7: COURSES (الدورات التدريبية) ==================== *@
        <div class="hr-tabpanel @(activeTab == ProfileTab.Courses ? "is-active" : "")">
            <div class="hr-stack">

                @* --- training courses ledger --- *@
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-c" aria-hidden="true"><Icon Name="academic-cap" Size="sm" /></span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">سجل الدورات التدريبية</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    الدورات وورش العمل المهنية والتخصصية التي اجتازها الموظف وتواريخها ومددها
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <span class="hr-badge hr-badge-accent">
                                <span class="hr-num">@N(employeeCourses.Count)</span> دورة
                            </span>
                            @if (employeeCourses.Count > 0)
                            {
                                <span class="hr-badge hr-badge-ok">
                                    <span class="hr-num">@N(GetTotalCourseDays())</span> يوم تدريبي
                                </span>
                            }
                        </div>
                    </div>

                    @if (employeeCourses.Count == 0)
                    {
                        <div class="hr-empty">
                            <span class="hr-empty-art" aria-hidden="true"><Icon Name="academic-cap" Size="lg" /></span>
                            <p class="hr-h3">لا توجد دورات تدريبية مسجلة</p>
                            <p class="hr-sub hr-measure-sm">
                                لم يتم تسجيل أي دورات تدريبية لهذا الموظف حتى الآن. تظهر هنا الدورات التخصصية وورش العمل المسجلة أو المستوردة عبر النظام فور إضافتها.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <caption class="hr-sr">
                                    سجل الدورات التدريبية للموظف @employee.Name، مرتبة من الأحدث إلى الأقدم.
                                </caption>
                                <thead>
                                    <tr>
                                        <th scope="col">اسم الدورة التدريبية</th>
                                        <th scope="col">تاريخ البدء</th>
                                        <th scope="col">تاريخ الانتهاء</th>
                                        <th scope="col">المدة</th>
                                        <th scope="col">الجهة المنظمة</th>
                                        <th scope="col">الحالة</th>
                                        <th scope="col">الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in employeeCourses)
                                    {
                                        <tr @key="course.Id">
                                            <td>
                                                <span class="hr-cell-strong">@course.CourseName</span>
                                            </td>
                                            <td>
                                                <span class="hr-cell-sub hr-num">@(course.StartDate.HasValue ? D(course.StartDate) : "-")</span>
                                            </td>
                                            <td>
                                                <span class="hr-cell-sub hr-num">@(course.EndDate.HasValue ? D(course.EndDate) : "-")</span>
                                            </td>
                                            <td>
                                                @if (course.DaysCount.HasValue && course.DaysCount.Value > 0)
                                                {
                                                    <span class="hr-badge hr-badge-accent">
                                                        <span class="hr-num">@course.DaysCount</span> يوم
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">-</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="hr-cell-sub">@Or(course.Institution)</span>
                                            </td>
                                            <td>
                                                @if (course.Status == "معتمدة" || string.IsNullOrWhiteSpace(course.Status))
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="check-circle" Size="xs" />
                                                        <span>@(course.Status ?? "معتمدة")</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge">@course.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="hr-cell-sub hr-cell-wide">@Or(course.Notes)</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </div>

        @* ==================== TAB 8: FEEDBACK (مشاركاتي والتواصل) ==================== *@
        @if (systemFeatures.EnableMyFeedback)
        {
            <div class="hr-tabpanel @(activeTab == ProfileTab.Feedback ? "is-active" : "")">
            <div class="hr-stack">

                @* --- employee feedback & voice ledger (مشاركاتي والتواصل) --- *@
                <section class="hr-card hr-no-print">
                    <div class="hr-card-head">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-a" aria-hidden="true">
                                <Icon Name="chat-bubble-left-right" Size="sm" />
                            </span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">مشاركاتي والتواصل</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    سجل المقترحات والملاحظات والاستفسارات والشكاوى وتتبع ردود إدارة الموارد البشرية
                                </p>
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <span class="hr-badge hr-badge-accent">
                                <span class="hr-num">@employeeFeedbacks.Count</span> مشاركة
                            </span>
                            <button type="button"
                                    class="hr-btn hr-btn-primary hr-btn-sm"
                                    @onclick="() => FeedbackModal.Open()">
                                <Icon Name="plus" Size="xs" />
                                <span>مشاركة جديدة</span>
                            </button>
                            <a href="my-feedback" class="hr-btn hr-btn-secondary hr-btn-sm">
                                <span>لوحة المتابعة</span>
                            </a>
                        </div>
                    </div>

                    @if (employeeFeedbacks.Count == 0)
                    {
                        <div class="hr-empty">
                            <span class="hr-empty-art" aria-hidden="true"><Icon Name="chat-bubble-left-right" Size="lg" /></span>
                            <p class="hr-h3">لا توجد مشاركات أو مقترحات سابقة</p>
                            <p class="hr-sub hr-measure-sm">
                                يمكنك مشاركة أفكارك أو مقترحاتك أو استفساراتك أو شكواك لتطوير بيئة العمل عبر النقر على زر "مشاركة جديدة" أو الزر العائم للتواصل.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <caption class="hr-sr">مشاركات وتواصل الموظف</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">نوع المشاركة</th>
                                        <th scope="col">الموضوع والوصف</th>
                                        <th scope="col">المرفق</th>
                                        <th scope="col">التاريخ</th>
                                        <th scope="col">الحالة التنفيذية</th>
                                        <th scope="col">رد وتوجيهات الإدارة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fb in employeeFeedbacks)
                                    {
                                        <tr @key="fb.Id">
                                            <td>
                                                <span class="hr-badge hr-badge-accent">@fb.FeedbackType</span>
                                                <div class="hr-meta hr-num" style="font-size:var(--fs-caption); margin-top:2px;">@fb.ReferenceNumber</div>
                                            </td>
                                            <td>
                                                <strong class="hr-cell-strong">@fb.Title</strong>
                                                <p class="hr-meta hr-truncate" style="max-width:320px; margin:0;" title="@fb.Description">@fb.Description</p>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(fb.AttachmentFileName))
                                                {
                                                    <a href="api/feedback/attachment/@fb.Id" target="_blank" class="hr-btn hr-btn-secondary hr-btn-xs">
                                                        <Icon Name="arrow-down-tray" Size="xs" />
                                                        <span class="hr-truncate" style="max-width:110px;">@fb.AttachmentFileName</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">بدون</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="hr-num hr-cell-strong">@fb.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                            </td>
                                            <td>
                                                @switch (fb.Status)
                                                {
                                                    case FeedbackStatus.Pending:
                                                        <span class="hr-badge hr-badge-warn">بانتظار المراجعة</span>
                                                        break;
                                                    case FeedbackStatus.InProgress:
                                                        <span class="hr-badge hr-badge-accent">قيد المعالجة</span>
                                                        break;
                                                    case FeedbackStatus.Resolved:
                                                        <span class="hr-badge hr-badge-ok">تمت المعالجة</span>
                                                        break;
                                                    case FeedbackStatus.Rejected:
                                                        <span class="hr-badge hr-badge-danger">محفوظة</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(fb.AdminNotes))
                                                {
                                                    <span class="hr-cell-strong" style="color:var(--ok);">@fb.AdminNotes</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-meta">بانتظار الرد</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </div>
        }

        @* ==================== TAB: VEHICLES & ASSETS (المركبات والمتعلقات) ==================== *@
        @if (isStaff || employeeVehicles.Count > 0)
        {
        <div class="hr-tabpanel @(activeTab == ProfileTab.Vehicles ? "is-active" : "")">
            <div class="hr-stack">
                <section class="hr-card">
                    <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
                        <div class="hr-modal-lead">
                            <span class="hr-iconplate hr-plate-a" aria-hidden="true">
                                <Icon Name="truck" Size="sm" />
                            </span>
                            <div class="hr-modal-titles">
                                <h2 class="hr-h2">مركبات ومتعلقات الموظف</h2>
                                <p class="hr-meta" style="margin-block-start:.25rem">
                                    سجل السيارات المصرح لها بالدخول وتفاصيل تصاريح البوابات للمقرات الخمسة
                                </p>
                            </div>
                        </div>

                        @if (isStaff)
                        {
                            <div class="hr-pagehead-actions">
                                <a href="employee-vehicles/@employee.EmployeeID" class="hr-btn hr-btn-primary hr-btn-sm">
                                    <Icon Name="plus" Size="xs" />
                                    <span>إضافة / إدارة المركبات</span>
                                </a>
                            </div>
                        }
                    </div>

                    <div class="hr-card-body">
                        @if (employeeVehicles.Count == 0)
                        {
                            <div class="hr-empty" style="padding:2rem;">
                                <span class="hr-empty-art hr-plate-a" aria-hidden="true">
                                    <Icon Name="truck" Size="md" />
                                </span>
                                <p class="hr-h3">لا توجد مركبات مسجلة لهذا الموظف</p>
                                <p class="hr-sub hr-measure-sm">
                                    لم يتم تسجيل أي سيارة حتى الآن باسم هذا الموظف لإصدار تصاريح دخول البوابات.
                                </p>
                                @if (isStaff)
                                {
                                    <a href="employee-vehicles/@employee.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm">
                                        <Icon Name="plus" Size="xs" />
                                        <span>تسجيل مركبة الآن</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(320px, 1fr));gap:1rem;">
                                @foreach (var v in employeeVehicles)
                                {
                                    <div class="hr-card" @key="v.Id" style="border:1px solid var(--line-soft);margin:0;">
                                        <div class="hr-card-body" style="display:flex;flex-direction:column;gap:0.75rem;padding:1rem;">
                                            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;">
                                                <div class="iq-license-plate" title="لوحة التسجيل">
                                                    <span class="iq-plate-gov">@v.Governorate</span>
                                                    @if (!string.IsNullOrWhiteSpace(v.PlateLetter))
                                                    {
                                                        <span class="iq-plate-letter">@v.PlateLetter</span>
                                                    }
                                                    <span class="iq-plate-num">@v.PlateNumber</span>
                                                </div>

                                                @if (v.IsAuthorized)
                                                {
                                                    <span class="hr-badge hr-badge-ok">
                                                        <Icon Name="check-circle" Size="xs" />
                                                        <span>مخولة بالدخول</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge hr-badge-danger">
                                                        <Icon Name="no-symbol" Size="xs" />
                                                        <span>غير مخولة</span>
                                                    </span>
                                                }
                                            </div>

                                            <div style="border-bottom:1px solid var(--line-soft);padding-bottom:0.5rem;">
                                                <strong style="font-size:1.1rem;display:block;">@v.Brand @v.Model</strong>
                                                <div style="display:flex;gap:0.5rem;margin-top:0.25rem;">
                                                    @if (!string.IsNullOrWhiteSpace(v.Color))
                                                    {
                                                        <span class="hr-badge">اللون: @v.Color</span>
                                                    }
                                                    @if (v.ManufacturingYear.HasValue)
                                                    {
                                                        <span class="hr-badge">موديل: @v.ManufacturingYear</span>
                                                    }
                                                </div>
                                            </div>

                                            <div style="display:flex;align-items:center;justify-content:space-between;padding:0.35rem 0.6rem;border-radius:var(--r-sm);background:var(--surface-sunken);font-size:0.82rem;">
                                                <div style="display:flex;align-items:center;gap:0.4rem;">
                                                    <span class="hr-meta" style="font-size:0.75rem;">السائق:</span>
                                                    @if (v.IsDriverSelf)
                                                    {
                                                        <span class="hr-badge hr-badge-neutral" style="font-size:0.75rem;display:inline-flex;align-items:center;gap:0.2rem;">
                                                            <Icon Name="user" Size="xs" />
                                                            <span>الموظف نفسه</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-badge hr-badge-info" style="font-size:0.75rem;display:inline-flex;align-items:center;gap:0.2rem;font-weight:600;">
                                                            <Icon Name="identification" Size="xs" />
                                                            <span>@(string.IsNullOrWhiteSpace(v.DriverName) ? "سائق مخصص" : v.DriverName)</span>
                                                        </span>
                                                    }
                                                </div>
                                                @if (!v.IsDriverSelf && !string.IsNullOrWhiteSpace(v.DriverPhone))
                                                {
                                                    <a href="tel:@v.DriverPhone" dir="ltr" class="hr-link hr-num" style="font-size:0.78rem;text-decoration:none;">
                                                        📞 @v.DriverPhone
                                                    </a>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(v.Vin))
                                            {
                                                <div style="font-size:0.8rem;background:var(--surface-sunken);padding:0.35rem 0.5rem;border-radius:var(--r-sm);display:flex;justify-content:space-between;">
                                                    <span class="hr-meta">الشاصي:</span>
                                                    <code dir="ltr" style="font-family:monospace;font-weight:600;color:var(--accent);">@v.Vin</code>
                                                </div>
                                            }

                                            <div>
                                                <span class="hr-meta" style="font-size:0.75rem;display:block;margin-bottom:0.35rem;">تصاريح المقرات المسموح بالدخول إليها:</span>
                                                <div style="display:flex;gap:0.3rem;flex-wrap:wrap;">
                                                    <span class="hr-gate-pill @(v.AllowMainBuilding ? "is-allowed" : "is-blocked")">1- المبنى الرئيسي</span>
                                                    <span class="hr-gate-pill @(v.AllowJadriya ? "is-allowed" : "is-blocked")">2- الجادرية</span>
                                                    <span class="hr-gate-pill @(v.AllowErbil ? "is-allowed" : "is-blocked")">3- أربيل</span>
                                                    <span class="hr-gate-pill @(v.AllowMosul ? "is-allowed" : "is-blocked")">4- الموصل</span>
                                                    <span class="hr-gate-pill @(v.AllowBasra ? "is-allowed" : "is-blocked")">5- البصرة</span>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(v.Notes))
                                            {
                                                <p class="hr-meta" style="font-size:0.8rem;margin:0;">📝 @v.Notes</p>
                                            }
                                        </div>

                                        @if (isStaff)
                                        {
                                            <div class="hr-card-foot" style="display:flex;align-items:center;justify-content:space-between;padding:0.5rem 1rem;background:var(--surface-sunken);border-top:1px solid var(--line-soft);">
                                                <button type="button" class="hr-btn @(v.IsAuthorized ? "hr-btn-warn" : "hr-btn-ok") hr-btn-sm"
                                                        @onclick="() => ToggleVehicleAuthInProfile(v)">
                                                    <Icon Name="@(v.IsAuthorized ? "no-symbol" : "check")" Size="xs" />
                                                    <span>@(v.IsAuthorized ? "تعطيل التخويل" : "تفعيل التخويل")</span>
                                                </button>

                                                <a href="employee-vehicles/@employee.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm">
                                                    <Icon Name="pencil-square" Size="xs" />
                                                    <span>إدارة</span>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
        }

        @* ---------- official print signatures ---------- *@
        <div class="hr-printfoot" aria-hidden="true">
            <div>
                <p class="hr-printfoot-role">الموظف المختص / مدقق البيانات</p>
                <p class="hr-printfoot-rule">التوقيع</p>
            </div>
            <div>
                <p class="hr-printfoot-role">مسؤول الشعبة / التدقيق</p>
                <p class="hr-printfoot-rule">التوقيع</p>
            </div>
            <div>
                <p class="hr-printfoot-role">مدير إدارة الموارد البشرية</p>
                <p class="hr-printfoot-rule">الختم والتوقيع</p>
            </div>
        </div>
    }
</div>

<ConfirmDialog IsOpen="@pendingPhotoDelete"
               Title="حذف الصورة الشخصية"
               Subject="@(employee is null ? null : $"{employee.Name} · {employee.EmployeeID}")"
               Message="سيُلغى تفعيل الصورة الحالية ولن تظهر في سجلات الموظف. يمكن رفع صورة جديدة لاحقاً."
               ConfirmText="حذف الصورة"
               IsBusy="@isDeletingPhoto"
               OnConfirm="ConfirmDeletePhoto"
               OnCancel="() => pendingPhotoDelete = false" />

@* ---------- operation feedback ---------- *@
@* The region is always in the document so an announcement is not competing
   with the node that carries it being inserted at the same moment. *@
<div class="hr-toasts" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="hr-toast">
            <span class="hr-iconplate @(toastIsSuccess ? "hr-iconplate-ok" : "hr-iconplate-danger")" aria-hidden="true">
                <Icon Name="@(toastIsSuccess ? "check-circle" : "exclamation-triangle")" Size="sm" />
            </span>
            <p class="hr-alert-grow hr-wrap-any">@toastMessage</p>
            <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                    @onclick="DismissToast" aria-label="إخفاء الرسالة">
                <Icon Name="x-mark" Size="sm" />
            </button>
        </div>
    }
</div>

@* ==================== ALLOWANCES MANAGEMENT MODAL ==================== *@
@if (showAllowanceModal)
{
    var calc = GetModalCalculation();

    <div class="hr-modal-scrim" @onclick="CloseAllowanceModal">
        <div class="hr-modal hr-modal-xl" role="dialog" aria-modal="true" aria-labelledby="allowance-modal-title" tabindex="-1"
             @onkeydown="OnAllowanceModalKeyDown" @onclick:stopPropagation="true">
            
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-c" style="background:color-mix(in srgb, var(--series-4) 15%, transparent);color:var(--series-4);" aria-hidden="true">
                        <Icon Name="banknotes" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="allowance-modal-title" class="hr-h3" style="margin:0;">إدارة وتحديث حزمة المخصصات والراتب الإجمالي</h2>
                        <p class="hr-meta" style="margin-block-start:2px;font-size:var(--fs-label);">
                            فتح فترة سريان جديدة وإغلاق الفترة السابقة تلقائياً مع توثيق السجل التاريخي
                        </p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="CloseAllowanceModal" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">

            @if (!string.IsNullOrEmpty(allowanceModalError))
            {
                <div class="hr-alert hr-alert-danger" style="margin-block-end:var(--s-3);padding:var(--s-2) var(--s-3);">
                    <Icon Name="exclamation-triangle" Size="xs" />
                    <span>@allowanceModalError</span>
                </div>
            }

            @* Live Summary Bar inside Modal *@
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(150px, 100%), 1fr));gap:var(--s-2);margin-block-end:var(--s-4);padding:var(--s-3);background:var(--surface-sunken);border-radius:var(--r-lg);border:1px solid var(--line);">
                <div>
                    <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">الراتب الإسمي:</span>
                    <strong style="font-size:1.05rem;color:var(--text);">@calc.BasicSalary.ToString("N0") د.ع</strong>
                </div>
                <div>
                    <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">المخصصات النسبية (@calc.TotalPercentageRate.ToString("G29")%):</span>
                    <strong style="font-size:1.05rem;color:var(--series-2);">@calc.TotalPercentageAmount.ToString("N0") د.ع</strong>
                </div>
                <div>
                    <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">المخصصات الثابتة:</span>
                    <strong style="font-size:1.05rem;color:var(--series-4);">@calc.TotalFixedAmount.ToString("N0") د.ع</strong>
                </div>
                <div>
                    <span class="hr-meta" style="font-size:var(--fs-caption);display:block;color:var(--series-3);font-weight:bold;">الراتب الإجمالي المتوقع:</span>
                    <strong style="font-size:1.15rem;color:var(--series-3);">@calc.GrossSalary.ToString("N0") د.ع</strong>
                </div>
            </div>

            @* Basic Period Details Form *@
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(220px, 100%), 1fr));gap:var(--s-3);margin-block-end:var(--s-4);">
                <div>
                    <label for="f-employee-profile-1" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">تاريخ بداية سريان الفترة *</label>
                    <input id="f-employee-profile-1" type="date" class="hr-input" @bind="modalStartDate" style="width:100%;font-size:var(--fs-control);" />
                </div>
                <div>
                    <label for="f-employee-profile-2" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">تاريخ النهاية (اختياري / فارغ للمستمر)</label>
                    <input id="f-employee-profile-2" type="date" class="hr-input" @bind="modalEndDate" style="width:100%;font-size:var(--fs-control);" />
                </div>
                <div>
                    <label for="f-employee-profile-3" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">الراتب الإسمي الأساسي (د.ع) *</label>
                    <input id="f-employee-profile-3" type="number" step="1000" class="hr-input" @bind="modalBasicSalary" style="width:100%;font-size:var(--fs-control);" />
                    @if (suggestedBasicSalary > 0 && modalBasicSalary != suggestedBasicSalary)
                    {
                        <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" style="margin-block-start:2px;font-size:var(--fs-caption);padding:0;" @onclick="() => modalBasicSalary = suggestedBasicSalary">
                            استرجاع راتب السلم الوظيفي (@suggestedBasicSalary.ToString("N0") د.ع)
                        </button>
                    }
                </div>
                <div>
                    <label for="f-employee-profile-4" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">رقم الأمر الإداري</label>
                    <input id="f-employee-profile-4" type="text" class="hr-input" placeholder="مثال: 1045/أ" @bind="modalOrderNumber" style="width:100%;font-size:var(--fs-control);" />
                </div>
                <div>
                    <label for="f-employee-profile-5" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">تاريخ الأمر الإداري</label>
                    <input id="f-employee-profile-5" type="date" class="hr-input" @bind="modalOrderDate" style="width:100%;font-size:var(--fs-control);" />
                </div>
                <div>
                    <label for="f-employee-profile-6" class="hr-label" style="font-size:var(--fs-label);font-weight:600;">سبب التعديل / السند</label>
                    <input id="f-employee-profile-6" type="text" class="hr-input" placeholder="مثال: ترقية، منح مخصصات منصب، زواج..." @bind="modalChangeReason" style="width:100%;font-size:var(--fs-control);" />
                </div>
            </div>

            @* Current Items in this Package Table *@
            <div style="margin-block-end:var(--s-4);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:var(--s-2);flex-wrap:wrap;gap:var(--s-2);">
                    <h3 class="hr-h3" style="margin:0;">بنود المخصصات المشمولة في هذه الفترة (@modalItems.Count)</h3>
                    <span class="hr-meta" style="font-size:var(--fs-caption);">يمكنك حذف أو إضافة أي مخصص أدناه</span>
                </div>

                @if (modalItems.Count > 0)
                {
                    <div class="hr-tablewrap" style="max-height:220px;overflow-y:auto;border:1px solid var(--line);border-radius:var(--r-md);">
                        <table class="hr-table" style="font-size:var(--fs-control);">
                            <thead>
                                <tr>
                                    <th scope="col">اسم المخصص</th>
                                    <th scope="col" style="text-align:center;">نوع الاحتساب</th>
                                    <th scope="col" style="text-align:center;">النسبة / المبلغ</th>
                                    <th scope="col" style="text-align:left;">المبلغ المحسوب شهرياً</th>
                                    <th scope="col" style="width:50px;text-align:center;">إجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in modalItems)
                                {
                                    var calcAmount = item.CalculationType == AllowanceCalculationType.Percentage
                                        ? Math.Round((modalBasicSalary * (item.Percentage ?? 0m)) / 100m, 2)
                                        : (item.FixedAmount ?? 0m);

                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <span class="hr-meta" style="display:block;font-size:var(--fs-caption);">@item.Notes</span>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            @(item.CalculationType == AllowanceCalculationType.Percentage ? "نسبية %" : "مقطوعة")
                                        </td>
                                        <td style="text-align:center;">
                                            @(item.CalculationType == AllowanceCalculationType.Percentage ? $"{item.Percentage:G29}%" : $"{item.FixedAmount:N0} د.ع")
                                        </td>
                                        <td style="text-align:left;">
                                            <strong style="color:var(--series-3);">@calcAmount.ToString("N0") د.ع</strong>
                                        </td>
                                        <td style="text-align:center;">
                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" style="color:var(--danger);" @onclick="() => RemoveItemFromModal(item)" title="حذف هذا المخصص من الحزمة">
                                                <Icon Name="trash" Size="xs" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="hr-empty" style="padding:var(--s-3);border:1px dashed var(--line);border-radius:var(--r-md);">
                        <p class="hr-meta" style="margin:0;">لم يتم إضافة أي مخصص للحزمة بعد. استخدم النموذج أدناه لإضافة مخصصات.</p>
                    </div>
                }
            </div>

            @* Add New Item Sub-Form Box *@
            <div style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);border-radius:var(--r-lg);margin-block-end:var(--s-4);">
                <div style="font-weight:700;font-size:var(--fs-control);margin-block-end:var(--s-2);display:flex;align-items:center;gap:var(--s-2);">
                    <Icon Name="plus-circle" Size="xs" />
                    <span>إضافة مخصص جديد إلى هذه الحزمة</span>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(180px, 100%), 1fr));gap:var(--s-2);align-items:flex-end;">
                    <div>
                        <label for="f-employee-profile-7" class="hr-label" style="font-size:var(--fs-caption);">اختر من الكتالوج أو اكتب مخصص مخصص</label>
                        <select id="f-employee-profile-7" class="hr-input" style="font-size:var(--fs-label);width:100%;" @onchange="OnAllowanceTypeSelected">
                            <option value="">-- اختر مخصص معتمد --</option>
                            @foreach (var t in allowanceTypes)
                            {
                                <option value="@t.Id">@t.Name (@(t.CalculationType == AllowanceCalculationType.Percentage ? $"{t.DefaultPercentage}% نسبية" : $"{t.DefaultAmount:N0} د.ع مقطوعة"))</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label for="f-employee-profile-8" class="hr-label" style="font-size:var(--fs-caption);">اسم المخصص *</label>
                        <input id="f-employee-profile-8" type="text" class="hr-input" placeholder="اسم المخصص" @bind="draftName" style="font-size:var(--fs-label);width:100%;" />
                    </div>

                    <div>
                        <label for="f-employee-profile-9" class="hr-label" style="font-size:var(--fs-caption);">نوع الاحتساب *</label>
                        <select id="f-employee-profile-9" class="hr-input" style="font-size:var(--fs-label);width:100%;" @bind="draftCalcType">
                            <option value="@AllowanceCalculationType.Percentage">نسبية (مضروبة في الراتب الإسمي)</option>
                            <option value="@AllowanceCalculationType.Fixed">ثابتة / مقطوعة (مبلغ محدد)</option>
                        </select>
                    </div>

                    @if (draftCalcType == AllowanceCalculationType.Percentage)
                    {
                        <div>
                            <label for="f-employee-profile-10" class="hr-label" style="font-size:var(--fs-caption);">النسبة المئوية (%) *</label>
                            <input id="f-employee-profile-10" type="number" step="0.5" class="hr-input" placeholder="مثال: 45" @bind="draftPercentage" style="font-size:var(--fs-label);width:100%;" />
                        </div>
                    }
                    else
                    {
                        <div>
                            <label for="f-employee-profile-11" class="hr-label" style="font-size:var(--fs-caption);">المبلغ الثابت (د.ع) *</label>
                            <input id="f-employee-profile-11" type="number" step="1000" class="hr-input" placeholder="مثال: 50000" @bind="draftFixedAmount" style="font-size:var(--fs-label);width:100%;" />
                        </div>
                    }

                    <div>
                        <label for="f-employee-profile-12" class="hr-label" style="font-size:var(--fs-caption);">ملاحظات / السند</label>
                        <input id="f-employee-profile-12" type="text" class="hr-input" placeholder="اختياري" @bind="draftNotes" style="font-size:var(--fs-label);width:100%;" />
                    </div>

                    <div>
                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" style="width:100%;" @onclick="AddDraftItemToModal">
                            <Icon Name="plus" Size="xs" />
                            <span>إضافة للحزمة</span>
                        </button>
                    </div>
                </div>
            </div>

            </div>

            <div class="hr-modal-foot" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                <div class="hr-meta" style="font-size:var(--fs-caption);max-width:480px;">
                    ℹ️ بمجرد الحفظ، ستصبح هذه الحزمة هي المعتمدة حالياً وسيتم إغلاق الفترة السابقة وأرشفتها تلقائياً.
                </div>
                <div style="display:flex;align-items:center;gap:var(--s-2);">
                    <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseAllowanceModal" disabled="@isSavingAllowance">
                        إلغاء
                    </button>
                    <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveAllowancePackageAsync" disabled="@isSavingAllowance">
                        @if (isSavingAllowance)
                        {
                            <span class="hr-spinner hr-spinner-xs"></span>
                            <span>جارٍ الحفظ والترحيل…</span>
                        }
                        else
                        {
                            <Icon Name="check" Size="xs" />
                            <span>حفظ وتفعيل الفترة الجديدة</span>
                        }
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@* ================= MODAL: إضافة / تعديل شهيد ================= *@
@if (showMartyrModal)
{
    <div class="hr-modal-scrim" @onclick="() => showMartyrModal = false">
        <div class="hr-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="martyr-modal-title" tabindex="-1" @onkeydown="OnMartyrModalKeyDown">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-c" style="background:color-mix(in srgb, var(--series-5) 15%, transparent);color:var(--series-5);" aria-hidden="true">
                        <Icon Name="flag" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="martyr-modal-title" class="hr-h3">@(editingMartyr != null ? "تعديل بيانات الشهيد" : "إضافة شهيد لسجل الموظف")</h2>
                        <p class="hr-meta">توثيق بيانات شهداء ذوي الموظف وصلة القرابة ورقم القرار</p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showMartyrModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">
                @if (!string.IsNullOrWhiteSpace(martyrModalError))
                {
                    <div class="hr-alert hr-alert-danger" role="alert">
                        <Icon Name="exclamation-circle" Size="sm" />
                        <span>@martyrModalError</span>
                    </div>
                }

                <div class="hr-field">
                    <label for="f-employee-profile-13" class="hr-field-label">اسم الشهيد <span style="color:var(--danger)">*</span></label>
                    <input id="f-employee-profile-13" type="text" class="hr-input" @bind="modalMartyrName" placeholder="الاسم الثلاثي أو الرباعي للشهيد" />
                </div>

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-14" class="hr-field-label">نوع الشهادة <span style="color:var(--danger)">*</span></label>
                        <select id="f-employee-profile-14" class="hr-select" @bind="modalMartyrdomTypeId">
                            <option value="">-- اختر نوع الشهادة --</option>
                            @foreach (var t in allMartyrdomTypes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-15" class="hr-field-label">صلة القرابة <span style="color:var(--danger)">*</span></label>
                        <select id="f-employee-profile-15" class="hr-select" @bind="modalKinshipId">
                            <option value="">-- اختر صلة القرابة --</option>
                            @foreach (var k in allMartyrKinships)
                            {
                                <option value="@k.Id">@k.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="hr-field">
                    <label for="f-employee-profile-16" class="hr-field-label">رقم وتاريخ القرار</label>
                    <input id="f-employee-profile-16" type="text" class="hr-input hr-num" @bind="modalDecisionNumber" placeholder="مثال: قرار مؤسسة الشهداء رقم 1045 لسنة 2024" />
                </div>

                <div class="hr-field">
                    <label for="f-employee-profile-17" class="hr-field-label">ملاحظات إضافية</label>
                    <textarea id="f-employee-profile-17" class="hr-textarea" @bind="modalMartyrNotes" rows="2" placeholder="أي تفاصيل أو ملاحظات إضافية بخصوص ملف الشهيد…"></textarea>
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showMartyrModal = false">إلغاء</button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveMartyrAsync" disabled="@isSavingMartyr">
                    @if (isSavingMartyr)
                    {
                        <span class="hr-spinner hr-spinner-xs"></span>
                        <span>جارٍ الحفظ…</span>
                    }
                    else
                    {
                        <Icon Name="check" Size="xs" />
                        <span>حفظ بيانات الشهيد</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ================= MODAL: إضافة / تعديل بيانات السكن ================= *@
@if (showResidenceModal)
{
    <div class="hr-modal-scrim" @onclick="() => showResidenceModal = false">
        <div class="hr-modal hr-modal-lg" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="residence-modal-title" tabindex="-1" @onkeydown="OnResidenceModalKeyDown">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-a" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color:var(--accent);" aria-hidden="true">
                        <Icon Name="home" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="residence-modal-title" class="hr-h3">@(editingResidence != null ? "تعديل بيانات السكن" : "إضافة بيانات السكن")</h2>
                        <p class="hr-meta">توثيق بطاقة السكن وموقع الإقامة والإحداثيات الجغرافية (GPS)</p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showResidenceModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">
                @if (!string.IsNullOrWhiteSpace(residenceModalError))
                {
                    <div class="hr-alert hr-alert-danger" role="alert">
                        <Icon Name="exclamation-circle" Size="sm" />
                        <span>@residenceModalError</span>
                    </div>
                }

                <!-- نوع السكن (دار أو شقة) -->
                <div class="hr-field">
                    <span id="housing-type-label" class="hr-field-label">نوع السكن <span class="hr-req" aria-hidden="true">*</span></span>
                    <div role="group" aria-labelledby="housing-type-label" style="display:flex;gap:var(--s-2);">
                        <button type="button"
                                class="hr-btn @(modalHousingType == "دار" ? "hr-btn-primary" : "hr-btn-secondary")"
                                style="flex:1;"
                                aria-pressed="@(modalHousingType == "دار" ? "true" : "false")"
                                @onclick='() => modalHousingType = "دار"'>
                            <Icon Name="home" Size="xs" />
                            <span>دار</span>
                        </button>
                        <button type="button"
                                class="hr-btn @(modalHousingType == "شقة" ? "hr-btn-primary" : "hr-btn-secondary")"
                                style="flex:1;"
                                aria-pressed="@(modalHousingType == "شقة" ? "true" : "false")"
                                @onclick='() => modalHousingType = "شقة"'>
                            <Icon Name="building-office-2" Size="xs" />
                            <span>شقة</span>
                        </button>
                    </div>
                </div>

                <!-- حقول العنوان حسب نوع السكن -->
                @if (modalHousingType == "دار")
                {
                    <div class="hr-grid-2" style="background:var(--surface-sunken);padding:var(--s-3);border-radius:var(--r-md);border:1px solid var(--line);">
                        <div class="hr-field">
                            <label for="f-employee-profile-18" class="hr-field-label">الحي</label>
                            <input id="f-employee-profile-18" type="text" class="hr-input" @bind="modalDistrict" placeholder="اسم الحي" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-19" class="hr-field-label">محلة</label>
                            <input id="f-employee-profile-19" type="text" class="hr-input hr-num" @bind="modalMahalla" placeholder="رقم المحلة" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-20" class="hr-field-label">زقاق</label>
                            <input id="f-employee-profile-20" type="text" class="hr-input hr-num" @bind="modalZuqaq" placeholder="رقم الزقاق" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-21" class="hr-field-label">دار</label>
                            <input id="f-employee-profile-21" type="text" class="hr-input hr-num" @bind="modalDar" placeholder="رقم الدار" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="hr-grid-2" style="background:var(--surface-sunken);padding:var(--s-3);border-radius:var(--r-md);border:1px solid var(--line);">
                        <div class="hr-field">
                            <label for="f-employee-profile-22" class="hr-field-label">اسم المجمع</label>
                            <input id="f-employee-profile-22" type="text" class="hr-input" @bind="modalComplexName" placeholder="اسم المجمع السكني" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-23" class="hr-field-label">البناية</label>
                            <input id="f-employee-profile-23" type="text" class="hr-input hr-num" @bind="modalBuildingNumber" placeholder="رقم البناية / العمارة" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-24" class="hr-field-label">الطابق</label>
                            <input id="f-employee-profile-24" type="text" class="hr-input hr-num" @bind="modalFloorNumber" placeholder="رقم الطابق" />
                        </div>
                        <div class="hr-field">
                            <label for="f-employee-profile-25" class="hr-field-label">الشقة</label>
                            <input id="f-employee-profile-25" type="text" class="hr-input hr-num" @bind="modalApartmentNumber" placeholder="رقم الشقة" />
                        </div>
                    </div>
                }

                <!-- المحافظة ومكتب المعلومات -->
                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-26" class="hr-field-label">المحافظة <span style="color:var(--danger)">*</span></label>
                        <select id="f-employee-profile-26" class="hr-select" @bind="modalGovernorateId">
                            <option value="">-- اختر المحافظة --</option>
                            @foreach (var g in allGovernorates)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-27" class="hr-field-label">مكتب المعلومات</label>
                        <input id="f-employee-profile-27" type="text" class="hr-input" @bind="modalInformationOffice" placeholder="اسم مكتب معلومات بطاقة السكن" />
                    </div>
                </div>

                <!-- اسم رب الأسرة ورقم الاستمارة -->
                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-28" class="hr-field-label">اسم رب الأسرة</label>
                        <input id="f-employee-profile-28" type="text" class="hr-input" @bind="modalFamilyHeadName" placeholder="الاسم المثبت في بطاقة السكن" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-29" class="hr-field-label">رقم الاستمارة</label>
                        <input id="f-employee-profile-29" type="text" class="hr-input hr-num" @bind="modalFormNumber" placeholder="رقم استمارة السكن" />
                    </div>
                </div>

                <!-- تاريخ تنظيم الاستمارة -->
                <div class="hr-field">
                    <label for="f-employee-profile-30" class="hr-field-label">تاريخ تنظيم الاستمارة</label>
                    <input id="f-employee-profile-30" type="date" class="hr-input hr-num" @bind="modalFormDate" />
                </div>

                <!-- الموقع الجغرافي وخريطة السكن -->
                <div style="background:var(--surface-sunken);padding:var(--s-3);border-radius:var(--r-md);border:1px solid var(--line);display:flex;flex-direction:column;gap:var(--s-2);">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                        <label class="hr-field-label" style="margin-bottom:0;font-weight:700;">موقع السكن على الخريطة (GPS)</label>
                        <div style="display:flex;gap:var(--s-2);">
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" @onclick="GetCurrentLocationAsync" title="تحديد الموقع الجغرافي الحالي للجهاز بدقة">
                                <Icon Name="map-pin" Size="xs" />
                                <span>موقعي الحالي (GPS)</span>
                            </button>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" @onclick="TryParseOrResolveUrlAsync" disabled="@isResolvingLocation" title="فحص الرابط واستخراج الإحداثيات">
                                <span>فحص الرابط</span>
                            </button>
                        </div>
                    </div>

                    <div class="hr-field" style="margin-bottom:0;">
                        <input aria-label="رابط موقع السكن على خرائط Google" type="text" class="hr-input"
                               value="@modalLocationUrl"
                               @oninput="OnLocationUrlInput"
                               placeholder="الصق رابط خرائط Google (رابط مشاركة أو كامل) أو الإحداثيات هنا" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(locationDetectionStatus))
                    {
                        var isSuccess = modalLatitude.HasValue && modalLongitude.HasValue;
                        <div role="status" style="font-size:var(--fs-caption);padding:var(--s-1) var(--s-2);border-radius:var(--r-sm);background:@(isSuccess ? "var(--ok-tint)" : "var(--warn-tint)");color:@(isSuccess ? "var(--ok)" : "var(--warn)");display:flex;align-items:center;gap:var(--s-2);">
                            <Icon Name="@(isSuccess ? "check-circle" : "exclamation-circle")" Size="xs" />
                            <span>@locationDetectionStatus</span>
                        </div>
                    }

                    <div class="hr-grid-2" style="margin-top:var(--s-1);">
                        <div class="hr-field" style="margin-bottom:0;">
                            <label for="f-employee-profile-31" class="hr-field-label" style="font-size:var(--fs-caption);">خط العرض (Latitude)</label>
                            <input id="f-employee-profile-31" type="number" step="any" class="hr-input hr-num" style="font-size:var(--fs-caption);"
                                   value="@modalLatitude"
                                   @onchange="@((ChangeEventArgs e) => { if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v)) modalLatitude = v; else modalLatitude = null; })" />
                        </div>
                        <div class="hr-field" style="margin-bottom:0;">
                            <label for="f-employee-profile-32" class="hr-field-label" style="font-size:var(--fs-caption);">خط الطول (Longitude)</label>
                            <input id="f-employee-profile-32" type="number" step="any" class="hr-input hr-num" style="font-size:var(--fs-caption);"
                                   value="@modalLongitude"
                                   @onchange="@((ChangeEventArgs e) => { if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v)) modalLongitude = v; else modalLongitude = null; })" />
                        </div>
                    </div>
                </div>

                <!-- من تاريخ / إلى تاريخ -->
                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-33" class="hr-field-label">من تاريخ</label>
                        <input id="f-employee-profile-33" type="date" class="hr-input hr-num" @bind="modalFromDate" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-34" class="hr-field-label">إلى تاريخ</label>
                        <input id="f-employee-profile-34" type="date" class="hr-input hr-num" @bind="modalToDate" />
                    </div>
                </div>

                <!-- وثائق بطاقة السكن (الوجه والظهر) -->
                <div style="border:1px solid var(--line);border-radius:var(--r-md);padding:var(--s-3);background:var(--surface-sunken);">
                    <div class="hr-grid-2">
                        <!-- الوجه -->
                        <div style="display:flex;flex-direction:column;gap:var(--s-2);">
                            <span style="font-size:var(--fs-control);font-weight:600;">وجه بطاقة السكن:</span>
                            <InputFile OnChange="@((InputFileChangeEventArgs e) => HandleResidenceCardSelected(e, isFront: true))" accept=".jpg,.jpeg,.png,.webp" />
                            @if (!string.IsNullOrEmpty(modalCardFrontPreviewUrl))
                            {
                                <div style="position:relative;width:100%;height:100px;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--line);background:#000;">
                                    <img src="@modalCardFrontPreviewUrl" alt="معاينة الوجه" style="width:100%;height:100%;object-fit:contain;" />
                                    <button type="button" class="hr-btn hr-btn-danger hr-btn-xs" style="position:absolute;top:4px;right:4px;" @onclick="() => RemoveCardFile(true)">
                                        <Icon Name="trash" Size="xs" />
                                    </button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(modalExistingCardFrontKey))
                            {
                                <div style="position:relative;width:100%;height:100px;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--line);background:#000;">
                                    <img src="/api/residence/@(editingResidence?.Id)/card/front" alt="الوجه" style="width:100%;height:100%;object-fit:contain;" />
                                </div>
                            }
                        </div>

                        <!-- الظهر -->
                        <div style="display:flex;flex-direction:column;gap:var(--s-2);">
                            <span style="font-size:var(--fs-control);font-weight:600;">ظهر بطاقة السكن:</span>
                            <InputFile OnChange="@((InputFileChangeEventArgs e) => HandleResidenceCardSelected(e, isFront: false))" accept=".jpg,.jpeg,.png,.webp" />
                            @if (!string.IsNullOrEmpty(modalCardBackPreviewUrl))
                            {
                                <div style="position:relative;width:100%;height:100px;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--line);background:#000;">
                                    <img src="@modalCardBackPreviewUrl" alt="معاينة الظهر" style="width:100%;height:100%;object-fit:contain;" />
                                    <button type="button" class="hr-btn hr-btn-danger hr-btn-xs" style="position:absolute;top:4px;right:4px;" @onclick="() => RemoveCardFile(false)">
                                        <Icon Name="trash" Size="xs" />
                                    </button>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(modalExistingCardBackKey))
                            {
                                <div style="position:relative;width:100%;height:100px;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--line);background:#000;">
                                    <img src="/api/residence/@(editingResidence?.Id)/card/back" alt="الظهر" style="width:100%;height:100%;object-fit:contain;" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="hr-field">
                    <label for="f-employee-profile-35" class="hr-field-label">ملاحظات</label>
                    <textarea id="f-employee-profile-35" class="hr-textarea" @bind="modalResidenceNotes" rows="2" placeholder="أي ملاحظات حول عنوان السكن أو وثائق الإقامة…"></textarea>
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showResidenceModal = false">إلغاء</button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveResidenceAsync" disabled="@isSavingResidence">
                    @if (isSavingResidence)
                    {
                        <span class="hr-spinner hr-spinner-xs"></span>
                        <span>جارٍ الحفظ…</span>
                    }
                    else
                    {
                        <Icon Name="check" Size="xs" />
                        <span>حفظ بيانات السكن</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ================= LIGHTBOX MODAL: استعراض بطاقة السكن والوثائق ================= *@
@if (showCardLightbox)
{
    <div class="hr-modal-scrim" @onclick="() => showCardLightbox = false" style="background:rgba(0,0,0,0.85);z-index:var(--z-modal-stacked);">
        <div class="hr-modal hr-modal-xl" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="card-lightbox-title" tabindex="-1" @onkeydown="OnLightboxModalKeyDown" style="background:var(--surface);">
            <div class="hr-modal-head" style="padding:var(--s-3) var(--s-4);">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate" aria-hidden="true"><Icon Name="identification" Size="sm" /></span>
                    <h2 id="card-lightbox-title" class="hr-h3" style="margin:0;">@lightboxTitle</h2>
                </div>
                <div style="display:flex;align-items:center;gap:var(--s-2);">
                    <a href="@lightboxImageUrl" download target="_blank" class="hr-btn hr-btn-secondary hr-btn-xs">
                        <Icon Name="arrow-down-tray" Size="xs" />
                        <span>تنزيل</span>
                    </a>
                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showCardLightbox = false" aria-label="إغلاق">
                        <Icon Name="x-mark" Size="sm" />
                    </button>
                </div>
            </div>
            <div class="hr-modal-body" style="padding:var(--s-3);display:flex;align-items:center;justify-content:center;background:#000;">
                <img src="@lightboxImageUrl" alt="@lightboxTitle" style="max-height:75dvh;max-width:100%;object-fit:contain;border-radius:var(--radius-sm);" />
            </div>
        </div>
    </div>
}

@* ================= MODAL: ADD / EDIT PASSPORT (توثيق وتعديل جواز السفر) ================= *@
@if (showPassportModal)
{
    <div class="hr-modal-scrim" @onclick="() => showPassportModal = false">
        <div class="hr-modal hr-modal-lg" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="passport-modal-title" tabindex="-1" @onkeydown="OnPassportModalKeyDown">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true"><Icon Name="globe-alt" Size="sm" /></span>
                    <div class="hr-modal-titles">
                        <h2 id="passport-modal-title" class="hr-h3">@(editingPassport == null ? "إضافة وثيقة جواز سفر جديد" : "تعديل بيانات ووثيقة جواز السفر")</h2>
                        <p class="hr-meta">توثيق بيانات جواز السفر العراقي ورفع صورة صفحة البيانات الشخصية</p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showPassportModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">
                @if (!string.IsNullOrEmpty(passportModalError))
                {
                    <div class="hr-alert hr-alert-danger" role="alert">
                        <Icon Name="exclamation-circle" Size="sm" />
                        <span>@passportModalError</span>
                    </div>
                }

                @* --- STEP 1: PRIMARY PASSPORT IMAGE UPLOAD WITH AUTO OCR --- *@
                <div style="background:var(--surface-sunken);border:1.5px dashed var(--line);border-radius:var(--r-lg);padding:var(--s-3);display:flex;flex-direction:column;gap:var(--s-2);">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                        <div style="display:flex;align-items:center;gap:var(--s-2);">
                            <span class="hr-iconplate hr-plate-a" aria-hidden="true" style="width:36px;height:36px;">
                                <Icon Name="camera" Size="sm" />
                            </span>
                            <div>
                                <strong style="font-size:var(--fs-body);color:var(--text);display:block;">1. ارفع أو التقط صورة صفحة الجواز (مسح OCR آلي)</strong>
                                <span class="hr-meta" style="font-size:var(--fs-caption);">سيقوم النظام فوراً بالتعرف الضوئي على بيانات الجواز وتعبئة الحقول أدناه تلقائياً للمراجعة.</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(modalPassportImagePreviewUrl) || !string.IsNullOrEmpty(modalExistingPassportImageKey))
                        {
                            <span class="hr-badge hr-badge-ok" style="font-size:var(--fs-caption);">
                                <Icon Name="check" Size="xs" /> تم تحميل وثيقة
                            </span>
                        }
                    </div>

                    <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;margin-block-start:var(--s-1);">
                        <label class="hr-btn hr-btn-primary hr-btn-sm" style="cursor:pointer;display:inline-flex;align-items:center;gap:var(--s-1);margin:0;">
                            <Icon Name="arrow-up-tray" Size="xs" />
                            <span>@(string.IsNullOrEmpty(modalPassportImagePreviewUrl) && string.IsNullOrEmpty(modalExistingPassportImageKey) ? "اختيار صورة الجواز أو مسحها" : "تغيير صورة الجواز")</span>
                            <InputFile OnChange="HandlePassportImageSelected" accept=".jpg,.jpeg,.png,.webp,.pdf" style="display:none;" />
                        </label>
                        <span class="hr-meta" style="font-size:var(--fs-caption);">الملفات المدعومة: JPG, PNG, WEBP, PDF (أقصى حجم: 10 ميغابايت)</span>
                    </div>

                    @* --- OCR SCANNING INDICATOR & STATUS NOTICES --- *@
                    @if (isScanningOcr)
                    {
                        <div class="hr-alert hr-alert-info" style="display:flex;align-items:center;gap:var(--s-2);padding:var(--s-2);margin:0;">
                            <span class="hr-spinner hr-spinner-xs"></span>
                            <span style="font-weight:700;">جارٍ الفحص الضوئي (OCR) وقراءة شريط الـ MRZ وتدقيق بيانات الجواز آلياً...</span>
                        </div>
                    }
                    else if (mrzScanSuccessNotice != null)
                    {
                        <div class="hr-alert hr-alert-success" style="display:flex;align-items:center;gap:var(--s-2);padding:var(--s-2);margin:0;">
                            <Icon Name="check-circle" Size="xs" />
                            <span>@mrzScanSuccessNotice</span>
                        </div>
                    }
                    else if (ocrScanWarning != null)
                    {
                        <div class="hr-alert hr-alert-warn" style="display:flex;align-items:center;gap:var(--s-2);padding:var(--s-2);margin:0;">
                            <Icon Name="exclamation-triangle" Size="xs" />
                            <span>@ocrScanWarning</span>
                        </div>
                    }

                    @* --- IMAGE PREVIEW --- *@
                    @if (!string.IsNullOrEmpty(modalPassportImagePreviewUrl))
                    {
                        <div style="position:relative;width:100%;max-height:160px;border-radius:var(--r-sm);overflow:hidden;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;margin-block-start:var(--s-1);">
                            <img src="@modalPassportImagePreviewUrl" alt="معاينة صورة الجواز" style="max-height:160px;max-width:100%;object-fit:contain;" />
                            <button type="button" class="hr-btn hr-btn-danger hr-btn-xs" style="position:absolute;top:6px;right:6px;" @onclick="RemovePassportImage" title="حذف الصورة">
                                <Icon Name="trash" Size="xs" />
                                <span>حذف الصورة</span>
                            </button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(modalExistingPassportImageKey) && editingPassport != null)
                    {
                        <div style="position:relative;width:100%;max-height:160px;border-radius:var(--r-sm);overflow:hidden;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;margin-block-start:var(--s-1);">
                            <img src="/api/passport/@(editingPassport.Id)/image" alt="الصورة الحالية" style="max-height:160px;max-width:100%;object-fit:contain;" />
                            <button type="button" class="hr-btn hr-btn-danger hr-btn-xs" style="position:absolute;top:6px;right:6px;" @onclick="RemovePassportImage" title="حذف الصورة الحالية">
                                <Icon Name="trash" Size="xs" />
                                <span>إزالة الصورة</span>
                            </button>
                        </div>
                    }
                </div>

                @* --- STEP 2: VERIFICATION & CONFIRMATION HEADER --- *@
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);margin-block-start:var(--s-2);">
                    <strong style="font-size:var(--fs-body);color:var(--text);display:flex;align-items:center;gap:var(--s-1);">
                        <Icon Name="clipboard-document-check" Size="xs" />
                        <span>2. مراجعة وتأكيد بيانات الجواز قبل الحفظ في السيرفر:</span>
                    </strong>
                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => showAdvancedPassportOptions = !showAdvancedPassportOptions" style="font-size:var(--fs-caption);">
                        <Icon Name="@(showAdvancedPassportOptions ? "chevron-up" : "chevron-down")" Size="xs" />
                        <span>@(showAdvancedPassportOptions ? "إخفاء الخيارات المتقدمة" : "خيارات متقدمة (قراءة الشريحة / MRZ يدوي)")</span>
                    </button>
                </div>

                @* --- ADVANCED OPTIONS (CHIP READER & RAW MRZ PASTE) --- *@
                @if (showAdvancedPassportOptions)
                {
                    <div style="background:var(--surface-sunken);border:1px solid var(--line);border-radius:var(--r-md);padding:var(--s-3);display:flex;flex-direction:column;gap:var(--s-2);">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                            <span style="font-weight:700;font-size:var(--fs-caption);color:var(--text);">طريقة إدخال متقدمة بديلة:</span>
                            <div style="display:flex;gap:var(--s-1);">
                                <button type="button" class="hr-btn @(passportInputMode == PassportInputMode.ChipNfc ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-xs" @onclick="() => passportInputMode = PassportInputMode.ChipNfc">
                                    <Icon Name="cpu-chip" Size="xs" />
                                    <span>قراءة الشريحة الإلكترونية (NFC)</span>
                                </button>
                                <button type="button" class="hr-btn @(passportInputMode == PassportInputMode.OcrMrz ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-xs" @onclick="() => passportInputMode = PassportInputMode.OcrMrz">
                                    <Icon Name="sparkles" Size="xs" />
                                    <span>لصق أسطر الـ MRZ</span>
                                </button>
                            </div>
                        </div>

                        @if (passportInputMode == PassportInputMode.ChipNfc)
                        {
                            <div class="hr-grid-2">
                                <div class="hr-field">
                                    <label class="hr-field-label" style="font-size:var(--fs-caption);">بيانات الشريحة الأساسية (DG1 - MRZ)</label>
                                    <input type="text" class="hr-input hr-num" @bind="chipDg1Mrz" placeholder="أسطر الـ MRZ المقروءة من الشريحة" style="direction:ltr;font-family:monospace;font-size:0.8rem;" />
                                </div>
                                <div class="hr-field">
                                    <label class="hr-field-label" style="font-size:var(--fs-caption);">الاسم العربي من الشريحة (DG11)</label>
                                    <input type="text" class="hr-input" @bind="chipDg11NameAr" placeholder="الاسم الكامل بالعربية" />
                                </div>
                            </div>
                            <div class="hr-grid-2">
                                <div class="hr-field">
                                    <label class="hr-field-label" style="font-size:var(--fs-caption);">اسم الأم ومحل الولادة (DG11)</label>
                                    <div class="hr-form-cols" style="--cols: 1fr 1fr; gap:var(--s-2);">
                                        <input type="text" class="hr-input" @bind="chipDg11Mother" placeholder="اسم الأم" />
                                        <input type="text" class="hr-input" @bind="chipDg11PlaceOfBirth" placeholder="محل الولادة" />
                                    </div>
                                </div>
                                <div class="hr-field">
                                    <label class="hr-field-label" style="font-size:var(--fs-caption);">الصورة البيومترية للشخص (DG2 - Base64)</label>
                                    <input type="text" class="hr-input" @bind="chipDg2PhotoBase64" placeholder="Base64 Image Bytes..." style="direction:ltr;font-size:0.75rem;" />
                                </div>
                            </div>
                            <div style="display:flex;justify-content:flex-end;">
                                <button type="button" class="hr-btn hr-btn-accent hr-btn-sm" @onclick="ApplyChipReading">
                                    <Icon Name="cpu-chip" Size="xs" />
                                    <span>تفريغ بيانات الشريحة والصورة</span>
                                </button>
                            </div>
                            @if (chipScanSuccessNotice != null)
                            {
                                <div class="hr-badge hr-badge-ok">
                                    <Icon Name="check-circle" Size="xs" /> @chipScanSuccessNotice
                                </div>
                            }
                        }
                        else
                        {
                            <div style="display:flex;gap:var(--s-2);align-items:flex-start;flex-wrap:wrap;">
                                <textarea class="hr-textarea hr-num" rows="2" @bind="mrzInputDraft" placeholder="P<IRQ...&#10;A12345678..." style="flex:1;direction:ltr;font-family:monospace;font-size:0.85rem;min-width:240px;"></textarea>
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ApplyMrzScan">
                                    <Icon Name="sparkles" Size="xs" />
                                    <span>تطبيق الـ MRZ</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(modalBiometricPhotoPreviewUrl))
                {
                    <div style="display:flex;align-items:center;gap:var(--s-3);padding:var(--s-2);background:color-mix(in srgb, var(--accent) 8%, var(--surface));border:1px solid var(--accent);border-radius:var(--r-md);">
                        <img src="@modalBiometricPhotoPreviewUrl" alt="الصورة البيومترية المستخرجة" style="width:48px;height:48px;border-radius:var(--r-sm);object-fit:cover;border:1px solid var(--line);" />
                        <div>
                            <span style="font-weight:700;font-size:var(--fs-caption);color:var(--text);">تم استخراج الصورة البيومترية الرسمية من شريحة الجواز (DG2)</span>
                            <p class="hr-meta" style="margin:0;font-size:var(--fs-caption);">سيتم حفظ هذه الصورة عالية الدقة وربطها بسجل الجواز الإلكتروني للموظف.</p>
                        </div>
                    </div>
                }

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-36" class="hr-field-label">رقم جواز السفر <span style="color:var(--danger)">*</span></label>
                        <input id="f-employee-profile-36" type="text" class="hr-input hr-num" @bind="modalPassportNumber" placeholder="مثال: A12345678" style="direction:ltr;font-weight:700;" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-37" class="hr-field-label">نوع الجواز</label>
                        <select id="f-employee-profile-37" class="hr-select" @bind="modalPassportType">
                            <option value="عادي (P)">عادي (P - Ordinary)</option>
                            <option value="دبلوماسي (D)">دبلوماسي (D - Diplomatic)</option>
                            <option value="خدمة (S)">خدمة (S - Service)</option>
                            <option value="خاص (Sp)">خاص (Sp - Special)</option>
                        </select>
                    </div>
                </div>

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-38" class="hr-field-label">الاسم الكامل بالعربية</label>
                        <input id="f-employee-profile-38" type="text" class="hr-input" @bind="modalPassportFullNameAr" placeholder="الاسم الثلاثي أو الرباعي واللقب" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-39" class="hr-field-label">الاسم بالإنجليزية (Full Name)</label>
                        <input id="f-employee-profile-39" type="text" class="hr-input" @bind="modalPassportFullNameEn" placeholder="SURNAME GIVEN NAMES" style="direction:ltr;text-transform:uppercase;" />
                    </div>
                </div>

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-40" class="hr-field-label">الرقم الوطني الموحد / الشخصي</label>
                        <input id="f-employee-profile-40" type="text" class="hr-input hr-num" @bind="modalPassportNationalId" placeholder="الرقم الوطني المثبت بالجواز" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-41" class="hr-field-label">اسم الأم</label>
                        <input id="f-employee-profile-41" type="text" class="hr-input" @bind="modalPassportMotherName" placeholder="اسم الأم الثلاثي" />
                    </div>
                </div>

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-42" class="hr-field-label">الدولة المصدرة والرمز</label>
                        <div class="hr-form-cols" style="--cols: 2fr 1fr; gap: var(--s-2);">
                            <input id="f-employee-profile-42" type="text" class="hr-input" @bind="modalPassportIssuingCountry" placeholder="العراق" />
                            <input aria-label="رمز الدولة المصدرة" type="text" class="hr-input hr-num" @bind="modalPassportCountryCode" placeholder="IRQ" style="direction:ltr;text-transform:uppercase;" />
                        </div>
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-43" class="hr-field-label">جهة أو سلطة الإصدار</label>
                        <input id="f-employee-profile-43" type="text" class="hr-input" @bind="modalPassportIssuingAuthority" placeholder="مثال: مديرية شؤون الجوازات - الكرخ" />
                    </div>
                </div>

                <div class="hr-grid-3">
                    <div class="hr-field">
                        <label for="f-employee-profile-44" class="hr-field-label">محل الولادة</label>
                        <input id="f-employee-profile-44" type="text" class="hr-input" @bind="modalPassportPlaceOfBirth" placeholder="المحافظة / المدينة" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-45" class="hr-field-label">تاريخ الميلاد</label>
                        <input id="f-employee-profile-45" type="date" class="hr-input hr-num" @bind="modalPassportDateOfBirth" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-46" class="hr-field-label">الجنس</label>
                        <select id="f-employee-profile-46" class="hr-select" @bind="modalPassportGender">
                            <option value="ذكر">ذكر (Male)</option>
                            <option value="أنثى">أنثى (Female)</option>
                        </select>
                    </div>
                </div>

                <div class="hr-grid-2">
                    <div class="hr-field">
                        <label for="f-employee-profile-47" class="hr-field-label">تاريخ الإصدار</label>
                        <input id="f-employee-profile-47" type="date" class="hr-input hr-num" @bind="modalPassportIssueDate" />
                    </div>

                    <div class="hr-field">
                        <label for="f-employee-profile-48" class="hr-field-label">تاريخ انتهاء الصلاحية</label>
                        <input id="f-employee-profile-48" type="date" class="hr-input hr-num" @bind="modalPassportExpiryDate" />
                    </div>
                </div>

                <div class="hr-field">
                    <label for="f-employee-profile-49" class="hr-field-label">شريط المقروئية الآلية (MRZ - اختياري)</label>
                    <input id="f-employee-profile-49" type="text" class="hr-input" @bind="modalPassportRawMrz" placeholder="P<IRQ...<<<<<<<<<<<<<<..." style="direction:ltr;font-family:monospace;font-size:0.85rem;" />
                </div>

                <div class="hr-field">
                    <label for="f-employee-profile-50" class="hr-field-label">ملاحظات إضافية</label>
                    <textarea id="f-employee-profile-50" class="hr-textarea" @bind="modalPassportNotes" rows="2" placeholder="أي معلومات أو تأشيرات مسجلة"></textarea>
                </div>
            </div>

            <div class="hr-modal-foot" style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                    @if (editingPassport != null)
                    {
                        <button type="button" class="hr-btn hr-btn-danger hr-btn-sm" @onclick="() => DeletePassportAsync(editingPassport.Id)" disabled="@isSavingPassport">
                            <Icon Name="trash" Size="xs" />
                            <span>حذف الجواز</span>
                        </button>
                    }
                </div>
                <div style="display:flex;align-items:center;gap:var(--s-2);">
                    <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showPassportModal = false">إلغاء</button>
                    <button type="button" class="hr-btn hr-btn-primary" @onclick="SavePassportAsync" disabled="@isSavingPassport">
                        @if (isSavingPassport)
                        {
                            <span class="hr-spinner hr-spinner-xs"></span>
                            <span>جارٍ الحفظ…</span>
                        }
                        else
                        {
                            <Icon Name="check" Size="xs" />
                            <span>حفظ بيانات الجواز</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ==================== MODAL: ADD FINANCIAL TRANSACTION (تسجيل حركة إيداع / سحب) ==================== *@
@if (showAddTransactionModal)
{
    <div class="hr-modal-scrim" @onclick="() => showAddTransactionModal = false">
        <div class="hr-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="transaction-modal-title" tabindex="-1" @onkeydown="OnAddTransactionModalKeyDown">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true">
                        <Icon Name="banknotes" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="transaction-modal-title" class="hr-h3">تسجيل حركة مالية جديدة على الرصيد</h2>
                        <p class="hr-meta">الموظف: <strong>@(employee?.Name)</strong> (الرقم: @(employee?.EmployeeID))</p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showAddTransactionModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">
                <div class="hr-field">
                    <label class="hr-label" for="tx-type">نوع الحركة المالية <span class="hr-req">*</span></label>
                    <select id="tx-type" class="hr-input" @bind="newTxType">
                        <option value="@FinancialTransactionType.Deposit">إيداع (زيادة الرصيد)</option>
                        <option value="@FinancialTransactionType.Withdrawal">سحب (خصم من الرصيد)</option>
                    </select>
                </div>

                <div class="hr-field">
                    <label class="hr-label" for="tx-amount">المبلغ (دينار عراقي) <span class="hr-req">*</span></label>
                    <input id="tx-amount" type="number" min="0" step="any" class="hr-input hr-num" @bind="newTxAmount" @bind:event="oninput" placeholder="مثال: 500000" />
                </div>

                @{
                    var curBal = financialAccount?.Balance ?? 0m;
                    var projectedBal = newTxType == FinancialTransactionType.Deposit
                        ? curBal + newTxAmount
                        : curBal - newTxAmount;
                }

                <div class="hr-card" style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                        <span class="hr-meta">الرصيد الحالي:</span>
                        <span class="hr-num">@curBal.ToString("N0") د.ع</span>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:4px;flex-wrap:wrap;gap:var(--s-2);">
                        <span class="hr-meta">الحركة المطلوبة:</span>
                        <span class="hr-num" style="color:@(newTxType == FinancialTransactionType.Deposit ? "var(--ok)" : "var(--danger)");font-weight:700;">
                            @(newTxType == FinancialTransactionType.Deposit ? "+ " : "- ")@newTxAmount.ToString("N0") د.ع
                        </span>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding-block-start:4px;border-block-start:1px dashed var(--line);flex-wrap:wrap;gap:var(--s-2);">
                        <strong style="color:var(--text);">الرصيد المتوقع بعد الحركة:</strong>
                        <strong class="hr-num" style="font-size:1.1rem;color:@(projectedBal < 0 ? "var(--danger)" : "var(--series-2)");">
                            @projectedBal.ToString("N0") د.ع
                        </strong>
                    </div>
                    @if (projectedBal < 0 && newTxType == FinancialTransactionType.Withdrawal)
                    {
                        <p class="hr-meta" style="color:var(--danger);margin-block-start:4px;">
                            <Icon Name="exclamation-triangle" Size="xs" /> تنبيه: مبلغ السحب يتجاوز الرصيد المتوفر حالياً.
                        </p>
                    }
                </div>

                <div class="hr-field">
                    <label class="hr-label" for="tx-ref">رقم الإشعار / الوصل / المرجع</label>
                    <input id="tx-ref" type="text" class="hr-input" @bind="newTxReference" placeholder="مثال: REC-2026-0042" />
                </div>

                <div class="hr-field">
                    <label class="hr-label" for="tx-desc">البيان / وصف الحركة</label>
                    <input id="tx-desc" type="text" class="hr-input" @bind="newTxDescription" placeholder="مثال: إيداع مكافأة استثنائية / سحب نقدي" />
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showAddTransactionModal = false" disabled="@isSavingFinancial">
                    إلغاء
                </button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveNewTransactionAsync" disabled="@(isSavingFinancial || newTxAmount <= 0)">
