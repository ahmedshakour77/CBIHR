    private async Task SavePassportAsync()
    {
        if (employee == null || !isStaff) return;
        passportModalError = null;

        if (string.IsNullOrWhiteSpace(modalPassportNumber))
        {
            passportModalError = "يرجى إدخال رقم جواز السفر.";
            return;
        }

        isSavingPassport = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            EmployeePassport pass;
            if (editingPassport == null)
            {
                pass = new EmployeePassport
                {
                    EmployeeId = employee.Id,
                    CreatedAt = DateTime.UtcNow,
                    IsActive = true
                };
                db.EmployeePassports.Add(pass);
            }
            else
            {
                pass = await db.EmployeePassports.FirstOrDefaultAsync(p => p.Id == editingPassport.Id)
                       ?? throw new InvalidOperationException("لم يتم العثور على سجل جواز السفر المطلوب تعديله.");
            }

            pass.PassportNumber = modalPassportNumber.Trim().ToUpperInvariant();
            pass.PassportType = string.IsNullOrWhiteSpace(modalPassportType) ? "عادي (P)" : modalPassportType.Trim();
            pass.CountryCode = string.IsNullOrWhiteSpace(modalPassportCountryCode) ? "IRQ" : modalPassportCountryCode.Trim().ToUpperInvariant();
            pass.IssuingCountry = string.IsNullOrWhiteSpace(modalPassportIssuingCountry) ? "العراق" : modalPassportIssuingCountry.Trim();
            pass.IssuingAuthority = string.IsNullOrWhiteSpace(modalPassportIssuingAuthority) ? null : modalPassportIssuingAuthority.Trim();
            pass.NationalIdNumber = string.IsNullOrWhiteSpace(modalPassportNationalId) ? null : modalPassportNationalId.Trim();
            pass.FullNameAr = string.IsNullOrWhiteSpace(modalPassportFullNameAr) ? null : modalPassportFullNameAr.Trim();
            pass.FullNameEn = string.IsNullOrWhiteSpace(modalPassportFullNameEn) ? null : modalPassportFullNameEn.Trim().ToUpperInvariant();
            pass.MotherName = string.IsNullOrWhiteSpace(modalPassportMotherName) ? null : modalPassportMotherName.Trim();
            pass.PlaceOfBirth = string.IsNullOrWhiteSpace(modalPassportPlaceOfBirth) ? null : modalPassportPlaceOfBirth.Trim();
            pass.DateOfBirth = modalPassportDateOfBirth;
            pass.Gender = string.IsNullOrWhiteSpace(modalPassportGender) ? null : modalPassportGender.Trim();
            pass.IssueDate = modalPassportIssueDate;
            pass.ExpiryDate = modalPassportExpiryDate;
            pass.RawMrz = string.IsNullOrWhiteSpace(modalPassportRawMrz) ? null : modalPassportRawMrz.Trim();
            pass.Notes = string.IsNullOrWhiteSpace(modalPassportNotes) ? null : modalPassportNotes.Trim();

            // Scan and save uploaded bio page image
            if (modalPassportImageBytes != null && modalPassportImageFile != null)
            {
                using var scanStream = new MemoryStream(modalPassportImageBytes);
                var scan = await MalwareScanner.ScanAsync(scanStream, modalPassportImageFile.Name);
                if (scan.IsRejected())
                {
                    passportModalError = "تعذر قبول صورة الجواز: لم تجتز الفحص الأمني.";
                    return;
                }

                var ext = Path.GetExtension(modalPassportImageFile.Name);
                if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";
                var key = $"passports/{employee.EmployeeID}/{Guid.NewGuid():N}_page{ext}";
                using var stream = new MemoryStream(modalPassportImageBytes);
                await FileStorage.SaveAsync(stream, key);
                pass.PassportImageKey = key;
                pass.PassportImageFileName = Path.GetFileName(modalPassportImageFile.Name);
                pass.PassportImageContentType = modalPassportImageFile.ContentType;
            }
            else if (string.IsNullOrEmpty(modalExistingPassportImageKey) && !string.IsNullOrEmpty(pass.PassportImageKey))
            {
                try { await FileStorage.DeleteAsync(pass.PassportImageKey); } catch { }
                pass.PassportImageKey = null;
                pass.PassportImageFileName = null;
                pass.PassportImageContentType = null;
            }

            // Save biometric face photo extracted from e-Passport chip (DG2) if available
            if (modalBiometricPhotoBytes != null && modalBiometricPhotoBytes.Length > 0)
            {
                var bioKey = $"passports/{employee.EmployeeID}/{Guid.NewGuid():N}_dg2.jpg";
                using var bioStream = new MemoryStream(modalBiometricPhotoBytes);
                await FileStorage.SaveAsync(bioStream, bioKey);
                pass.BiometricPhotoKey = bioKey;
                pass.BiometricPhotoFileName = "biometric_face_dg2.jpg";
                pass.BiometricPhotoContentType = "image/jpeg";
            }

            await db.SaveChangesAsync();

            // Reload active passport
            employeePassport = await db.EmployeePassports.AsNoTracking()
                .Where(p => p.EmployeeId == employee.Id && p.IsActive)
                .OrderByDescending(p => p.Id)
                .FirstOrDefaultAsync();

            showPassportModal = false;
            ShowToast("تم حفظ وتحديث بيانات وصورة جواز السفر بنجاح.", true);
        }
        catch (Exception ex)
        {
            passportModalError = $"حدث خطأ أثناء حفظ بيانات الجواز: {ex.Message}";
        }
        finally
        {
            isSavingPassport = false;
        }
    }

    private async Task DeletePassportAsync(int passportId)
    {
        if (employee == null) return;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var existing = await db.EmployeePassports.FirstOrDefaultAsync(p => p.Id == passportId);
            if (existing != null)
            {
                if (!string.IsNullOrEmpty(existing.PassportImageKey))
                {
                    try { await FileStorage.DeleteAsync(existing.PassportImageKey); } catch { }
                }
                if (!string.IsNullOrEmpty(existing.BiometricPhotoKey))
                {
                    try { await FileStorage.DeleteAsync(existing.BiometricPhotoKey); } catch { }
                }

                db.EmployeePassports.Remove(existing);
                await db.SaveChangesAsync();
            }

            employeePassport = await db.EmployeePassports.AsNoTracking()
                .Where(p => p.EmployeeId == employee.Id && p.IsActive)
                .OrderByDescending(p => p.Id)
                .FirstOrDefaultAsync();

            showPassportModal = false;
            ShowToast("تم حذف قيد جواز السفر بنجاح.", true);
        }
        catch (Exception ex)
        {
            ShowToast($"تعذر الحذف: {ex.Message}", false);
        }
    }

    public void Dispose()
    {
        FeatureService.OnSettingsChanged -= HandleFeaturesChanged;
        toastCts?.Cancel();
        toastCts?.Dispose();
    }

    private static string FormatBooksUnit(int count)
    {
        if (count == 0) return "كتب";
        if (count == 1) return "كتاب واحد";
        if (count == 2) return "كتابان";
        var rem100 = count % 100;
        if (rem100 >= 3 && rem100 <= 10) return "كتب";
        return "كتاباً";
    }

    private async Task LoadFinancialData(int empId)
    {
        try
        {
            financialAccount = await FinancialService.GetOrCreateAccountAsync(empId);
            financialTransactions = (await FinancialService.GetTransactionsAsync(empId, 100)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading financial data for employee {Id}", empId);
        }
    }

    private void OpenAddTransactionModal()
    {
        if (!isStaff) return;
        newTxType = FinancialTransactionType.Deposit;
        newTxAmount = 0m;
        newTxDescription = null;
        newTxReference = null;
        showAddTransactionModal = true;
    }

    private void OpenQuickTransaction(FinancialTransactionType type)
    {
        if (!isStaff) return;
        newTxType = type;
        newTxAmount = 0m;
        newTxDescription = type == FinancialTransactionType.Deposit ? "إيداع سريع" : "سحب سريع";
        newTxReference = null;
        showAddTransactionModal = true;
    }

    private async Task SaveNewTransactionAsync()
    {
        if (employee == null || newTxAmount <= 0 || !isStaff) return;

        isSavingFinancial = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = auth.User.Identity?.Name ?? "HR_Admin";

            await FinancialService.AddTransactionAsync(
                employee.Id,
                newTxType,
                newTxAmount,
                newTxDescription,
                newTxReference,
                DateTime.UtcNow,
                username);

            await LoadFinancialData(employee.Id);
            showAddTransactionModal = false;
            Toast.Success(newTxType == FinancialTransactionType.Deposit
                ? $"تم تسجيل حركة الإيداع بمبلغ {newTxAmount:N0} د.ع بنجاح."
                : $"تم تسجيل حركة السحب بمبلغ {newTxAmount:N0} د.ع بنجاح.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding financial transaction");
            Toast.Danger($"تعذر تسجيل الحركة المالية: {ex.Message}");
        }
        finally
        {
            isSavingFinancial = false;
        }
    }

    private void OpenUpdateBalancesModal()
    {
        if (!isStaff) return;
        if (financialAccount != null)
        {
            editBalance = financialAccount.Balance;
            editLoanRemaining = financialAccount.LoanRemaining;
            editAdvanceRemaining = financialAccount.AdvanceRemaining;
            editFinancialNotes = financialAccount.Notes;
        }
        else
        {
            editBalance = 0m;
            editLoanRemaining = 0m;
            editAdvanceRemaining = 0m;
            editFinancialNotes = null;
        }
        showUpdateBalancesModal = true;
    }

    private async Task SaveUpdatedBalancesAsync()
    {
        if (employee == null || !isStaff) return;

        isSavingFinancial = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = auth.User.Identity?.Name ?? "HR_Admin";

            await FinancialService.UpdateBalancesAsync(
                employee.Id,
                editBalance,
                editLoanRemaining,
                editAdvanceRemaining,
                editFinancialNotes,
                username);

            await LoadFinancialData(employee.Id);
            showUpdateBalancesModal = false;
            Toast.Success("تم تحديث الأرصدة ومتبقي القروض والسلف بنجاح.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating financial balances");
            Toast.Danger($"تعذر تحديث الأرصدة: {ex.Message}");
        }
        finally
        {
            isSavingFinancial = false;
        }
    }

