            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showGreetingModal = false">
                    إغلاق
                </button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="CopyGreetingText">
                    <Icon Name="clipboard-document" Size="xs" />
                    <span>نسخ نص التهنئة للحافظة</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum BirthdayViewMode
    {
        Upcoming,
        ByMonth,
        ByYearAndGen,
        Cohorts
    }

    private sealed record EmployeeBirthdayItem(
        int Id,
        string EmployeeID,
        string Name,
        DateOnly? BirthDate,
        string? JobTitle,
        string? Formation,
        string? Gender,
        int Age,
        int DaysUntilNext,
        DateOnly NextBirthdayDate,
        ZodiacSignInfo Zodiac,
        GenerationInfo Generation,
        string? PhotoUrl = null);

    private BirthdayViewMode viewMode = BirthdayViewMode.Upcoming;
    private string cohortSubView = "exact_day";
    private bool isLoading = true;
    private DateOnly today;
    private readonly CultureInfo ArabicCulture = new("ar-IQ");

    private List<EmployeeBirthdayItem> allEmployeesWithBirthdays = [];
    private List<EmployeeBirthdayItem> todayBirthdays = [];
    private List<EmployeeBirthdayItem> thisMonthBirthdays = [];

    // KPI stats
    private ZodiacSignInfo? topZodiac;
    private int topZodiacCount = 0;
    private GenerationInfo? topGeneration;
    private double topGenPercentage = 0;
    private int countNext7Days = 0;
    private int countNext30Days = 0;

    // Filters
    private string searchQuery = "";
    private string quickRange = "all";
    private int filterMonth = 0;
    private string filterZodiac = "";
    private string filterGeneration = "";
    private string filterFormation = "";
    private string sortOrder = "upcoming";
    private int selectedMonthView = 0;

    private List<ZodiacSignInfo> allZodiacNames = [];
    private List<GenerationInfo> allGenerationsList = [];
    private List<string> distinctFormations = [];

    // Greeting Modal
    private bool showGreetingModal = false;
    private EmployeeBirthdayItem? greetingTarget;
    private string greetingMessageText = "";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery)
        || quickRange != "all"
        || filterMonth != 0
        || !string.IsNullOrWhiteSpace(filterZodiac)
        || !string.IsNullOrWhiteSpace(filterGeneration)
        || !string.IsNullOrWhiteSpace(filterFormation)
        || sortOrder != "upcoming";

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Now);

        allZodiacNames = new List<DateOnly>
        {
            new(2000, 3, 25), new(2000, 4, 25), new(2000, 5, 25), new(2000, 6, 25),
            new(2000, 7, 25), new(2000, 8, 25), new(2000, 9, 25), new(2000, 10, 25),
            new(2000, 11, 25), new(2000, 12, 25), new(2000, 1, 25), new(2000, 2, 25)
        }.Select(d => ZodiacAndGenerationHelper.GetZodiacSign(d)).ToList();

        allGenerationsList = new List<int> { 2015, 2005, 1990, 1975, 1955, 1940 }
            .Select(y => ZodiacAndGenerationHelper.GetGeneration(y))
            .DistinctBy(g => g.NameAr)
            .ToList();

        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var emps = await db.Employees
                .AsNoTracking()
                .Where(e => e.BirthDate.HasValue)
                .Include(e => e.JobTitle)
                .Include(e => e.Formation)
                .Include(e => e.Gender)
                .ToListAsync();

            // Concurrent resolution of employee profile photo thumbnails
            var avatarTasks = emps.Select(async e =>
            {
                var photo = await AvatarService.GetAvatarDataUrlAsync(e.EmployeeID, null);
                return (e.EmployeeID, photo);
            });
            var avatarResults = await Task.WhenAll(avatarTasks);
            var photoDict = avatarResults.Where(x => !string.IsNullOrEmpty(x.photo)).ToDictionary(x => x.EmployeeID, x => x.photo);

            allEmployeesWithBirthdays = emps.Select(e =>
            {
                var bDate = e.BirthDate!.Value;
                var age = ZodiacAndGenerationHelper.CalculateAge(bDate, today);
                var daysUntil = ZodiacAndGenerationHelper.DaysUntilBirthday(bDate, today);

                var nextBday = new DateOnly(today.Year, bDate.Month, Math.Min(bDate.Day, DateTime.DaysInMonth(today.Year, bDate.Month)));
                if (nextBday < today)
                {
                    nextBday = new DateOnly(today.Year + 1, bDate.Month, Math.Min(bDate.Day, DateTime.DaysInMonth(today.Year + 1, bDate.Month)));
                }

                var zodiac = ZodiacAndGenerationHelper.GetZodiacSign(bDate);
                var gen = ZodiacAndGenerationHelper.GetGeneration(bDate.Year);

                photoDict.TryGetValue(e.EmployeeID, out var photoUrl);

                return new EmployeeBirthdayItem(
                    e.Id,
                    e.EmployeeID,
                    e.Name,
                    bDate,
                    e.JobTitle?.Name,
                    e.Formation?.Name,
                    e.Gender?.Name,
                    age,
                    daysUntil,
                    nextBday,
                    zodiac,
                    gen,
                    photoUrl);
            }).ToList();

            distinctFormations = allEmployeesWithBirthdays
                .Select(e => e.Formation)
                .Where(f => !string.IsNullOrWhiteSpace(f))
                .Select(f => f!)
                .Distinct()
                .OrderBy(f => f)
                .ToList();

            // Calculate KPIs
            todayBirthdays = allEmployeesWithBirthdays.Where(e => e.DaysUntilNext == 0).ToList();
            countNext7Days = allEmployeesWithBirthdays.Count(e => e.DaysUntilNext <= 7);
            countNext30Days = allEmployeesWithBirthdays.Count(e => e.DaysUntilNext <= 30);
            thisMonthBirthdays = allEmployeesWithBirthdays.Where(e => e.BirthDate?.Month == today.Month).ToList();

            if (allEmployeesWithBirthdays.Count > 0)
            {
                var topZGrp = allEmployeesWithBirthdays
                    .GroupBy(e => e.Zodiac.NameAr)
                    .OrderByDescending(g => g.Count())
                    .FirstOrDefault();

                if (topZGrp != null)
                {
                    topZodiac = topZGrp.First().Zodiac;
                    topZodiacCount = topZGrp.Count();
                }

                var topGGrp = allEmployeesWithBirthdays
                    .GroupBy(e => e.Generation.NameAr)
                    .OrderByDescending(g => g.Count())
                    .FirstOrDefault();

                if (topGGrp != null)
                {
                    topGeneration = topGGrp.First().Generation;
                    topGenPercentage = Math.Round(topGGrp.Count() * 100.0 / allEmployeesWithBirthdays.Count, 1);
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر تحميل سجلات أعياد الميلاد: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetQuickRange(string range)
    {
        quickRange = range;
    }

    private List<EmployeeBirthdayItem> GetFilteredEmployees()
    {
        IEnumerable<EmployeeBirthdayItem> query = allEmployeesWithBirthdays;

        // Quick Range filter
        query = quickRange switch
        {
            "today" => query.Where(e => e.DaysUntilNext == 0),
            "week" => query.Where(e => e.DaysUntilNext <= 7),
            "month30" => query.Where(e => e.DaysUntilNext <= 30),
            "current_month" => query.Where(e => e.BirthDate?.Month == today.Month),
            _ => query
        };

        // Text Search
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim();
            query = query.Where(e =>
                e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.EmployeeID.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (e.JobTitle != null && e.JobTitle.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        // Month Filter
        if (filterMonth > 0)
        {
            query = query.Where(e => e.BirthDate?.Month == filterMonth);
        }

        // Zodiac Filter
        if (!string.IsNullOrWhiteSpace(filterZodiac))
        {
            query = query.Where(e => e.Zodiac.NameAr == filterZodiac);
        }

        // Generation Filter
        if (!string.IsNullOrWhiteSpace(filterGeneration))
        {
            query = query.Where(e => e.Generation.NameAr == filterGeneration);
        }

        // Formation Filter
        if (!string.IsNullOrWhiteSpace(filterFormation))
        {
            query = query.Where(e => e.Formation == filterFormation);
        }

        // Sorting
        query = sortOrder switch
        {
            "calendar" => query.OrderBy(e => e.BirthDate?.Month).ThenBy(e => e.BirthDate?.Day),
            "age_desc" => query.OrderByDescending(e => e.Age),
            "age_asc" => query.OrderBy(e => e.Age),
            "name_asc" => query.OrderBy(e => e.Name),
            _ => query.OrderBy(e => e.DaysUntilNext)
        };

        return query.ToList();
    }

    private void ResetFilters()
    {
        searchQuery = "";
        quickRange = "all";
        filterMonth = 0;
        filterZodiac = "";
        filterGeneration = "";
        filterFormation = "";
        sortOrder = "upcoming";
        selectedMonthView = 0;
    }

    private void OpenGreetingModal(EmployeeBirthdayItem emp)
    {
        greetingTarget = emp;
        greetingMessageText = $"حضرة الزميل {emp.Name} المحترم،\n\nبمناسبة ذكرى ميلادكم الميمون، يطيب لإدارة المؤسسة وزملائكم في العمل أن نتقدم إليكم بأسمى عبارات التهنئة وأطيب الأمنيات، متمنين لكم دوام التوفيق والنجاح وموفور الصحة والعطاء في مسيرتكم المهنية والشخصية.\n\nوكل عام وأنتم بخير.";
        showGreetingModal = true;
    }

    private void OnGreetingModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showGreetingModal = false;
    }

    private async Task CopyGreetingText()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", greetingMessageText);
            Toast.Success("تم نسخ نص التهنئة الإدارية للحافظة بنجاح.");
            showGreetingModal = false;
        }
        catch
        {
            Toast.Danger("تعذر النسخ التلقائي للحافظة. يمكنك تحديد النص ونسخه يدوياً.");
        }
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }
}
