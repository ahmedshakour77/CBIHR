@code {
    private enum BirthdayViewMode
    {
        Upcoming,
        ByMonth,
        ByYearAndGen,
        Cohorts
    }

    private sealed record RawEmployeeProjection(
        int Id,
        string EmployeeID,
        string Name,
        DateOnly BirthDate,
        string? JobTitle,
        string? Formation,
        string? Gender);

    private sealed record EmployeeBirthdayItem(
        int Id,
        string EmployeeID,
        string Name,
        string Initials,
        DateOnly? BirthDate,
        int BirthYear,
        int BirthMonth,
        int BirthDay,
        string BirthDateFormatted,
        string DayMonthArabic,
        string MonthDayShort,
        string NextBirthdayFormatted,
        string? JobTitle,
        string? Formation,
        string? Gender,
        int Age,
        int DaysUntilNext,
        DateOnly NextBirthdayDate,
        ZodiacSignInfo Zodiac,
        GenerationInfo Generation,
        string? PhotoUrl = null);

    private sealed record GenerationSummaryGroup(GenerationInfo Generation, int TotalCount);
    private sealed record DayTwinGroup(int Month, int Day, List<EmployeeBirthdayItem> Employees);
    private sealed record YearCohortGroup(int Year, GenerationInfo Generation, List<EmployeeBirthdayItem> Employees);
    private sealed record ZodiacCohortGroup(ZodiacSignInfo Zodiac, List<EmployeeBirthdayItem> Employees);

    // Static in-memory cache for instantaneous load across navigations
    private static List<EmployeeBirthdayItem>? _cachedEmployees;
    private static DateOnly _cachedForDate;
    private static DateTime _cacheExpiresAtUtc = DateTime.MinValue;

    private BirthdayViewMode viewMode = BirthdayViewMode.Upcoming;
    private string upcomingLayout = "cards"; // "cards" | "table"
    private string cohortSubView = "exact_day";
    private bool isLoading = true;
    private long loadDurationMs = 0;
    private DateOnly today;
    private readonly CultureInfo ArabicCulture = new("ar-IQ");

    private List<EmployeeBirthdayItem> allEmployeesWithBirthdays = [];
    private List<EmployeeBirthdayItem> filteredEmployees = [];
    private List<EmployeeBirthdayItem> todayBirthdays = [];
    private List<EmployeeBirthdayItem> thisMonthBirthdays = [];

    // Pre-computed buckets for 0-lag tab switching
    private readonly int[] monthCounts = new int[13];
    private int maxMonthCount = 1;
    private readonly Dictionary<int, List<EmployeeBirthdayItem>> filteredByMonth = new();
    private List<GenerationSummaryGroup> generationSummaryGroups = [];
    private List<DayTwinGroup> dayTwinsGroups = [];
    private List<YearCohortGroup> yearCohortGroups = [];
    private List<ZodiacCohortGroup> zodiacCohortGroups = [];

    // KPI stats
    private ZodiacSignInfo? topZodiac;
    private int topZodiacCount = 0;
    private GenerationInfo? topGeneration;
    private double topGenPercentage = 0;
    private double averageAge = 0;
    private int countNext7Days = 0;
    private int countNext30Days = 0;

    // Filters & Pagination
    private string searchQuery = "";
    private string quickRange = "all";
    private int filterMonth = 0;
    private string filterZodiac = "";
    private string filterGeneration = "";
    private string filterFormation = "";
    private string sortOrder = "upcoming";
    private int selectedMonthView = 0;

    private int currentPage = 1;
    private int pageSize = 24;

    private int TotalUpcomingPages => Math.Max(1, (int)Math.Ceiling((double)filteredEmployees.Count / pageSize));
    private IEnumerable<EmployeeBirthdayItem> PagedUpcomingEmployees =>
        filteredEmployees.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private List<ZodiacSignInfo> allZodiacNames = [];
    private List<GenerationInfo> allGenerationsList = [];
    private List<string> distinctFormations = [];

    // Greeting Modal
    private bool showGreetingModal = false;
    private EmployeeBirthdayItem? greetingTarget;
    private string greetingMessageText = "";
    private bool isSendingTelegramCard = false;

    // Telegram Bot Modal
    private bool showTelegramModal = false;
    private API.HR.Node.Services.Telegram.TelegramBirthdayBotConfig? botConfigDraft;
    private bool isTestingBot = false;
    private string manualChatIdInput = "";
    private string manualChatTitleInput = "";

    private void OpenTelegramBotModal()
    {
        botConfigDraft = TelegramBot.GetConfig();
        showTelegramModal = true;
    }

    private async Task TestTelegramTokenAsync()
    {
        if (botConfigDraft is null) return;
        isTestingBot = true;
        try
        {
            var (ok, msg) = await TelegramBot.TestConnectionAsync(botConfigDraft.BotToken);
            if (ok) Toast.Success(msg);
            else Toast.Danger(msg);
        }
        finally
        {
            isTestingBot = false;
        }
    }

    private async Task SaveTelegramBotSettingsAsync()
    {
        if (botConfigDraft is null) return;
        isTestingBot = true;
        try
        {
            await TelegramBot.SaveConfigAsync(botConfigDraft);
            if (botConfigDraft.IsEnabled && !string.IsNullOrWhiteSpace(botConfigDraft.BotToken))
            {
                var (ok, msg) = await TelegramBot.TestConnectionAsync(botConfigDraft.BotToken);
                if (ok) Toast.Success($"تم حفظ الإعدادات وتفعيل البوت: {msg}");
                else Toast.Warning($"تم حفظ الإعدادات، ولكن تعذر الاتصال: {msg}");
            }
            else
            {
                Toast.Success("تم حفظ إعدادات بوت تيليجرام بنجاح.");
            }
            showTelegramModal = false;
        }
        finally
        {
            isTestingBot = false;
        }
    }

    private void ApprovePendingChat(API.HR.Node.Services.Telegram.TelegramPendingChat pending)
    {
        if (botConfigDraft is null) return;
        botConfigDraft.PendingChats.Remove(pending);
        if (botConfigDraft.AuthorizedChats.All(c => c.ChatId != pending.ChatId))
        {
            botConfigDraft.AuthorizedChats.Add(new API.HR.Node.Services.Telegram.TelegramAuthorizedChat
            {
                ChatId = pending.ChatId,
                Title = pending.Title,
                Username = pending.Username,
                AddedAtUtc = DateTimeOffset.UtcNow,
                ReceiveDailyBroadcast = true
            });
        }
    }

    private void AddManualChatId()
    {
        if (botConfigDraft is null) return;
        if (!long.TryParse(manualChatIdInput.Trim(), out var cid) || cid == 0)
        {
            Toast.Warning("يرجى إدخال رقم Chat ID صحيح.");
            return;
        }
        if (botConfigDraft.AuthorizedChats.All(c => c.ChatId != cid))
        {
            botConfigDraft.AuthorizedChats.Add(new API.HR.Node.Services.Telegram.TelegramAuthorizedChat
            {
                ChatId = cid,
                Title = string.IsNullOrWhiteSpace(manualChatTitleInput) ? $"Chat {cid}" : manualChatTitleInput.Trim(),
                AddedAtUtc = DateTimeOffset.UtcNow,
                ReceiveDailyBroadcast = true
            });
        }
        manualChatIdInput = "";
        manualChatTitleInput = "";
    }

    private async Task BroadcastTodayToTelegramAsync()
    {
        isTestingBot = true;
        try
        {
            var (sent, msg) = await TelegramBot.BroadcastTodayBirthdaysNowAsync();
            if (sent > 0) Toast.Success(msg);
            else Toast.Warning(msg);
        }
        finally
        {
            isTestingBot = false;
        }
    }

    private async Task SendGreetingTargetToTelegramAsync()
    {
        if (greetingTarget is null) return;
        isSendingTelegramCard = true;
        try
        {
            var (ok, msg) = await TelegramBot.SendEmployeeBirthdayToChatsAsync(greetingTarget.EmployeeID);
            if (ok) Toast.Success(msg);
            else Toast.Warning(msg);
        }
        finally
        {
            isSendingTelegramCard = false;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery)
        || quickRange != "all"
        || filterMonth != 0
        || !string.IsNullOrWhiteSpace(filterZodiac)
        || !string.IsNullOrWhiteSpace(filterGeneration)
        || !string.IsNullOrWhiteSpace(filterFormation)
        || sortOrder != "upcoming";

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Now);
        selectedMonthView = today.Month;

        for (int m = 1; m <= 12; m++)
        {
            filteredByMonth[m] = [];
        }

        allZodiacNames = new List<DateOnly>
        {
            new(2000, 3, 25), new(2000, 4, 25), new(2000, 5, 25), new(2000, 6, 25),
            new(2000, 7, 25), new(2000, 8, 25), new(2000, 9, 25), new(2000, 10, 25),
            new(2000, 11, 25), new(2000, 12, 25), new(2000, 1, 25), new(2000, 2, 25)
        }.Select(d => ZodiacAndGenerationHelper.GetZodiacSign(d)).ToList();

        allGenerationsList = new List<int> { 2015, 2005, 1990, 1975, 1955, 1940 }
            .Select(y => ZodiacAndGenerationHelper.GetGeneration(y))
            .DistinctBy(g => g.NameAr)
            .ToList();

        await ReloadDataAsync(forceRefresh: false);
    }

    private async Task ReloadDataAsync(bool forceRefresh = false)
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();
        isLoading = true;

        try
        {
            if (!forceRefresh && _cachedEmployees != null && _cachedForDate == today && DateTime.UtcNow < _cacheExpiresAtUtc)
            {
                allEmployeesWithBirthdays = _cachedEmployees;
            }
            else
            {
                using var scope = ScopeFactory.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

                // 1. Single fast projected query (no full entity materialization, no tracking)
                var rawEmps = await db.Employees
                    .AsNoTracking()
                    .Where(e => !e.IsArchived && e.BirthDate.HasValue)
                    .Select(e => new RawEmployeeProjection(
                        e.Id,
                        e.EmployeeID,
                        e.Name,
                        e.BirthDate!.Value,
                        e.JobTitle != null ? e.JobTitle.Name : null,
                        e.Formation != null ? e.Formation.Name : null,
                        e.Gender != null ? e.Gender.Name : null))
                    .ToListAsync();

                // 2. Single fast query to check which employees have active photos (replaces 2,000+ N+1 queries & file reads!)
                var activePhotoIds = await db.EmployeeProfilePhotos
                    .AsNoTracking()
                    .Where(p => p.IsActive)
                    .Select(p => p.EmployeeID)
                    .Distinct()
                    .ToListAsync();

                var photoSet = new HashSet<string>(activePhotoIds, StringComparer.OrdinalIgnoreCase);

                var built = new List<EmployeeBirthdayItem>(rawEmps.Count);
                foreach (var e in rawEmps)
                {
                    var bDate = e.BirthDate;
                    var age = ZodiacAndGenerationHelper.CalculateAge(bDate, today);
                    var daysUntil = ZodiacAndGenerationHelper.DaysUntilBirthday(bDate, today);

                    var nextBday = new DateOnly(today.Year, bDate.Month, Math.Min(bDate.Day, DateTime.DaysInMonth(today.Year, bDate.Month)));
                    if (nextBday < today)
                    {
                        nextBday = new DateOnly(today.Year + 1, bDate.Month, Math.Min(bDate.Day, DateTime.DaysInMonth(today.Year + 1, bDate.Month)));
                    }

                    var zodiac = ZodiacAndGenerationHelper.GetZodiacSign(bDate);
                    var gen = ZodiacAndGenerationHelper.GetGeneration(bDate.Year);
                    var monthNameAr = ZodiacAndGenerationHelper.FormatMonthArabic(bDate.Month);

                    string? photoUrl = photoSet.Contains(e.EmployeeID)
                        ? $"api/employees/{Uri.EscapeDataString(e.EmployeeID)}/profile-photo/thumbnail"
                        : null;

                    built.Add(new EmployeeBirthdayItem(
                        e.Id,
                        e.EmployeeID,
                        e.Name,
                        AvatarInitials.FromName(e.Name),
                        bDate,
                        bDate.Year,
                        bDate.Month,
                        bDate.Day,
                        bDate.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture),
                        $"{bDate.Day} {monthNameAr}",
                        $"{bDate.Month:00}/{bDate.Day:00}",
                        nextBday.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture),
                        e.JobTitle,
                        e.Formation,
                        e.Gender,
                        age,
                        daysUntil,
                        nextBday,
                        zodiac,
                        gen,
                        photoUrl));
                }

                allEmployeesWithBirthdays = built;
                _cachedEmployees = built;
                _cachedForDate = today;
                _cacheExpiresAtUtc = DateTime.UtcNow.AddMinutes(5);
            }

            ComputeGlobalKpis();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر تحميل سجلات أعياد الميلاد: {ex.Message}");
        }
        finally
        {
            sw.Stop();
            loadDurationMs = sw.ElapsedMilliseconds;
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ComputeGlobalKpis()
    {
        Array.Clear(monthCounts, 0, monthCounts.Length);
        foreach (var e in allEmployeesWithBirthdays)
        {
            if (e.BirthMonth is >= 1 and <= 12)
            {
                monthCounts[e.BirthMonth]++;
            }
        }
        maxMonthCount = Math.Max(1, monthCounts.Max());

        distinctFormations = allEmployeesWithBirthdays
            .Select(e => e.Formation)
            .Where(f => !string.IsNullOrWhiteSpace(f))
            .Select(f => f!)
            .Distinct()
            .OrderBy(f => f)
            .ToList();

        todayBirthdays = allEmployeesWithBirthdays.Where(e => e.DaysUntilNext == 0).ToList();
        countNext7Days = allEmployeesWithBirthdays.Count(e => e.DaysUntilNext <= 7);
        countNext30Days = allEmployeesWithBirthdays.Count(e => e.DaysUntilNext <= 30);
        thisMonthBirthdays = allEmployeesWithBirthdays.Where(e => e.BirthMonth == today.Month).ToList();

        generationSummaryGroups = allEmployeesWithBirthdays
            .GroupBy(e => e.Generation.NameAr)
            .OrderByDescending(g => g.Count())
            .Select(g => new GenerationSummaryGroup(g.First().Generation, g.Count()))
            .ToList();

        if (allEmployeesWithBirthdays.Count > 0)
        {
            averageAge = allEmployeesWithBirthdays.Average(e => e.Age);

            var topZGrp = allEmployeesWithBirthdays
                .GroupBy(e => e.Zodiac.NameAr)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();

            if (topZGrp != null)
            {
                topZodiac = topZGrp.First().Zodiac;
                topZodiacCount = topZGrp.Count();
            }

            if (generationSummaryGroups.Count > 0)
            {
                topGeneration = generationSummaryGroups[0].Generation;
                topGenPercentage = Math.Round(generationSummaryGroups[0].TotalCount * 100.0 / allEmployeesWithBirthdays.Count, 1);
            }
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<EmployeeBirthdayItem> query = allEmployeesWithBirthdays;

        query = quickRange switch
        {
            "today" => query.Where(e => e.DaysUntilNext == 0),
            "week" => query.Where(e => e.DaysUntilNext <= 7),
            "month30" => query.Where(e => e.DaysUntilNext <= 30),
            "current_month" => query.Where(e => e.BirthMonth == today.Month),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim();
            query = query.Where(e =>
                e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || e.EmployeeID.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (e.JobTitle != null && e.JobTitle.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (e.Formation != null && e.Formation.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        if (filterMonth > 0)
        {
            query = query.Where(e => e.BirthMonth == filterMonth);
        }

        if (!string.IsNullOrWhiteSpace(filterZodiac))
        {
            query = query.Where(e => e.Zodiac.NameAr == filterZodiac);
        }

        if (!string.IsNullOrWhiteSpace(filterGeneration))
        {
            query = query.Where(e => e.Generation.NameAr == filterGeneration);
        }

        if (!string.IsNullOrWhiteSpace(filterFormation))
        {
            query = query.Where(e => e.Formation == filterFormation);
        }

        query = sortOrder switch
        {
            "calendar" => query.OrderBy(e => e.BirthMonth).ThenBy(e => e.BirthDay),
            "age_desc" => query.OrderByDescending(e => e.Age),
            "age_asc" => query.OrderBy(e => e.Age),
            "name_asc" => query.OrderBy(e => e.Name),
            _ => query.OrderBy(e => e.DaysUntilNext)
        };

        filteredEmployees = query.ToList();
        currentPage = 1;

        // Pre-populate month buckets
        for (int m = 1; m <= 12; m++)
        {
            filteredByMonth[m] = [];
        }
        foreach (var emp in filteredEmployees.OrderBy(e => e.BirthDay))
        {
            if (emp.BirthMonth is >= 1 and <= 12)
            {
                filteredByMonth[emp.BirthMonth].Add(emp);
            }
        }

        // Pre-populate cohort buckets
        dayTwinsGroups = filteredEmployees
            .GroupBy(e => (e.BirthMonth, e.BirthDay))
            .Where(g => g.Count() >= 2)
            .OrderBy(g => g.Key.BirthMonth)
            .ThenBy(g => g.Key.BirthDay)
            .Select(g => new DayTwinGroup(g.Key.BirthMonth, g.Key.BirthDay, g.OrderBy(x => x.BirthYear).ToList()))
            .ToList();

        yearCohortGroups = filteredEmployees
            .GroupBy(e => e.BirthYear)
            .OrderByDescending(g => g.Key)
            .Select(g => new YearCohortGroup(g.Key, ZodiacAndGenerationHelper.GetGeneration(g.Key), g.OrderBy(x => x.BirthMonth).ThenBy(x => x.BirthDay).ToList()))
            .ToList();

        zodiacCohortGroups = filteredEmployees
            .GroupBy(e => e.Zodiac.NameAr)
            .OrderByDescending(g => g.Count())
            .Select(g => new ZodiacCohortGroup(g.First().Zodiac, g.OrderBy(x => x.BirthMonth).ThenBy(x => x.BirthDay).ToList()))
            .ToList();
    }

    private void SetViewMode(BirthdayViewMode mode)
    {
        viewMode = mode;
        currentPage = 1;
    }

    private void SetQuickRange(string range)
    {
        quickRange = range;
        ApplyFilters();
    }

    private void ToggleMonthQuickFilter(int monthNum)
    {
        if (viewMode == BirthdayViewMode.ByMonth)
        {
            selectedMonthView = selectedMonthView == monthNum ? 0 : monthNum;
        }
        else
        {
            filterMonth = filterMonth == monthNum ? 0 : monthNum;
            ApplyFilters();
        }
    }

    private void ToggleTopZodiacFilter()
    {
        if (topZodiac == null) return;
        filterZodiac = filterZodiac == topZodiac.NameAr ? "" : topZodiac.NameAr;
        ApplyFilters();
    }

    private void ToggleTopGenerationFilter()
    {
        if (topGeneration == null) return;
        filterGeneration = filterGeneration == topGeneration.NameAr ? "" : topGeneration.NameAr;
        ApplyFilters();
    }

    private void ToggleGenerationFilter(string genName)
    {
        filterGeneration = filterGeneration == genName ? "" : genName;
        ApplyFilters();
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        currentPage = Math.Clamp(page, 1, TotalUpcomingPages);
    }

    private void ResetFilters()
    {
        searchQuery = "";
        quickRange = "all";
        filterMonth = 0;
        filterZodiac = "";
        filterGeneration = "";
        filterFormation = "";
        sortOrder = "upcoming";
        selectedMonthView = today.Month;
        ApplyFilters();
    }

