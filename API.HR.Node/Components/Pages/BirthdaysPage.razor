        greetingMessageText = $"حضرة الزميل {emp.Name} المحترم،\n\nبمناسبة ذكرى ميلادكم الميمون، يطيب لإدارة المؤسسة وزملائكم في العمل أن نتقدم إليكم بأسمى عبارات التهنئة وأطيب الأمنيات، متمنين لكم دوام التوفيق والنجاح وموفور الصحة والعطاء في مسيرتكم المهنية والشخصية.\n\nوكل عام وأنتم بخير.";
        showGreetingModal = true;
    }

    private void OnGreetingModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showGreetingModal = false;
    }

    private async Task CopyGreetingText()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", greetingMessageText);
            Toast.Success("تم نسخ نص التهنئة الإدارية للحافظة بنجاح.");
            showGreetingModal = false;
        }
        catch
        {
            Toast.Danger("تعذر النسخ التلقائي للحافظة. يمكنك تحديد النص ونسخه يدوياً.");
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("الرقم الوظيفي,اسم الموظف,تاريخ الميلاد,العمر,الأيام المتبقية,البرج الفلكي,الجيل,التشكيل الإداري,العنوان الوظيفي");

            foreach (var e in filteredEmployees)
            {
                var safeName = e.Name.Replace("\"", "\"\"");
                var safeForm = (e.Formation ?? "").Replace("\"", "\"\"");
                var safeJob = (e.JobTitle ?? "").Replace("\"", "\"\"");
                sb.AppendLine($"\"{e.EmployeeID}\",\"{safeName}\",\"{e.BirthDateFormatted}\",{e.Age},{e.DaysUntilNext},\"{e.Zodiac.NameAr}\",\"{e.Generation.NameAr}\",\"{safeForm}\",\"{safeJob}\"");
            }

            var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);

            await JSRuntime.InvokeVoidAsync("eval", $@"
                (function() {{
                    var a = document.createElement('a');
                    a.href = 'data:text/csv;base64,{base64}';
                    a.download = 'Birthdays-Report-{DateTime.Now:yyyyMMdd}.csv';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر تصدير الملف: {ex.Message}");
        }
    }

