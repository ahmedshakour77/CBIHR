@page "/admin/birthdays"
@page "/birthdays"
@using API.HR.Node.Security
@attribute [Authorize(Policy = Permissions.BirthdaysView)]
@rendermode InteractiveServer

@using System.Globalization
@using System.Text
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Data
@using API.HR.Node.Services.Common
@using API.HR.Node.Components.Layout

@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject API.HR.Node.Services.DesignSystem.IToastService Toast
@inject API.HR.Node.Services.Telegram.ITelegramBirthdayBotService TelegramBot

<PageTitle>تقويم أعياد الميلاد والتصنيف الديمغرافي | الموظف ٣٦٠°</PageTitle>

<div class="hr-stack bday-page">
    <!-- ==================== 1. HEADER & ACTIONS ==================== -->
    <header class="hr-pagehead hr-no-print">
        <div class="hr-pagehead-titles">
            <nav class="hr-crumbs" aria-label="مسار التنقل">
                <a href="" class="hr-crumb">
                    <Icon Name="home" Size="xs" />
                    <span>الرئيسية</span>
                </a>
                <span class="hr-crumb-sep" aria-hidden="true">/</span>
                <span class="hr-crumb is-current" aria-current="page">أعياد الميلاد والمناسبات</span>
            </nav>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-block-start:var(--s-2);flex-wrap:wrap;">
                <h1 class="hr-h1" style="display:flex;align-items:center;gap:0.5rem;">
                    <Icon Name="cake" Size="md" />
                    <span>تقويم أعياد الميلاد والتحليل الديمغرافي</span>
                </h1>
                <span class="hr-badge hr-badge-accent" style="font-size:var(--fs-caption);gap:0.25rem;">
                    <Icon Name="sparkles" Size="xs" />
                    <span>@allEmployeesWithBirthdays.Count.ToString("N0") موظف مسجل</span>
                </span>
                @if (loadDurationMs > 0)
                {
                    <span class="hr-badge" style="font-size:var(--fs-caption);" title="زمن استرجاع وتحليل البيانات">
                        ⚡ @(loadDurationMs)ms
                    </span>
                }
            </div>
            <p class="hr-sub hr-measure" style="margin-block-start:var(--s-1)">
                استعراض تحليلي فوري لتواريخ ميلاد كوادر المؤسسة، مع التصنيف الفلكي والجيلي، ورصد حالات التزامن في أيام وسنوات التولد.
            </p>
        </div>

        <div class="hr-pagehead-actions" style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="OpenTelegramBotModal" title="إعدادات وإدارة بوت تيليجرام لأعياد الميلاد">
                <span style="width:8px;height:8px;border-radius:999px;background:@(TelegramBot.IsConnected ? "#10b981" : "#94a3b8");display:inline-block;"></span>
                <Icon Name="paper-airplane" Size="xs" />
                <span>بوت تيليجرام @(TelegramBot.IsConnected && !string.IsNullOrEmpty(TelegramBot.BotUsername) ? $"(@{TelegramBot.BotUsername})" : "")</span>
            </button>
            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ExportCsvAsync" disabled="@isLoading" title="تصدير القائمة المفلترة إلى ملف CSV">
                <Icon Name="arrow-down-tray" Size="xs" />
                <span>تصدير CSV</span>
            </button>
            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="PrintPage" title="طباعة كشف أعياد الميلاد الرسمي">
                <Icon Name="printer" Size="xs" />
                <span>طباعة الكشف</span>
            </button>
            <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="() => ReloadDataAsync(forceRefresh: true)" disabled="@isLoading">
                <Icon Name="arrow-path" Size="xs" />
                <span>تحديث فوري</span>
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="hr-stack" aria-hidden="true">
            <div class="hr-grid-kpi">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="hr-skeleton" style="height:6.5rem;border-radius:var(--r-lg)"></div>
                }
            </div>
            <div class="hr-skeleton" style="height:5rem;border-radius:var(--r-lg)"></div>
            <div class="hr-skeleton" style="height:18rem;border-radius:var(--r-lg)"></div>
        </div>
    }
    else
    {
        @* ==================== 2. CELEBRATION BANNER FOR TODAY'S BIRTHDAYS ==================== *@
        @if (todayBirthdays.Count > 0)
        {
            <section class="hr-card bday-hero-banner" aria-label="احتفالية مواليد اليوم">
                <div class="bday-hero-top">
                    <div style="display:flex;align-items:center;gap:var(--s-3);">
                        <span class="bday-hero-icon" aria-hidden="true">🎂</span>
                        <div>
                            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                <strong style="font-size:1.15rem;color:var(--text);font-weight:800;">
                                    يصادف اليوم ذكرى ميلاد @todayBirthdays.Count من كوادرنا المتميزين
                                </strong>
                                <span class="hr-badge hr-badge-ok">@today.ToString("dd MMMM yyyy", ArabicCulture)</span>
                            </div>
                            <p class="hr-meta" style="margin-block-start:0.2rem;">
                                تتقدم إدارة المنظومة بأسمى آيات التهاني والتبريكات، متمنين لهم دوام التوفيق والعطاء المهني.
                            </p>
                        </div>
                    </div>

                    <button type="button"
                            class="hr-btn @(quickRange == "today" ? "hr-btn-primary" : "hr-btn-secondary") hr-btn-sm"
                            @onclick='() => SetQuickRange(quickRange == "today" ? "all" : "today")'>
                        <Icon Name="sparkles" Size="xs" />
                        <span>@(quickRange == "today" ? "عرض كافة المواعيد" : $"حصر بمواليد اليوم ({todayBirthdays.Count})")</span>
                    </button>
                </div>

                <div class="bday-hero-pills">
                    @foreach (var emp in todayBirthdays.Take(18))
                    {
                        <div class="bday-hero-pill">
                            <div class="bday-avatar bday-avatar-sm">
                                @if (!string.IsNullOrEmpty(emp.PhotoUrl))
                                {
                                    <img src="@emp.PhotoUrl" alt="@emp.Name" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span>@emp.Initials</span>
                                }
                            </div>
                            <a href="employees/@emp.EmployeeID" class="bday-pill-name">@emp.Name</a>
                            <span class="hr-meta" style="font-size:0.72rem;">(@emp.Age سنة)</span>
                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" style="padding:2px 6px;" @onclick="() => OpenGreetingModal(emp)" title="إرسال أو نسخ تهنئة">
                                <Icon Name="gift" Size="xs" />
                            </button>
                        </div>
                    }
                    @if (todayBirthdays.Count > 18)
                    {
                        <button type="button" class="hr-badge hr-badge-accent" style="cursor:pointer;" @onclick='() => SetQuickRange("today")'>
                            +@(todayBirthdays.Count - 18) آخرين
                        </button>
                    }
                </div>
            </section>
        }

        @* ==================== 3. INTERACTIVE KPI METRIC CARDS ==================== *@
        <section class="hr-grid-kpi" aria-label="المؤشرات الرئيسية لأعياد الميلاد">
            <div class="hr-card hr-stat @(todayBirthdays.Count > 0 ? "hr-stat-ok" : "hr-stat-a") bday-kpi-clickable @(quickRange == "today" ? "is-active-kpi" : "")"
                 @onclick='() => SetQuickRange(quickRange == "today" ? "all" : "today")'
                 title="انقر لتصفية مواليد اليوم">
                <div class="hr-stat-label">
                    <span>مواليد اليوم</span>
                    <span class="hr-iconplate @(todayBirthdays.Count > 0 ? "hr-iconplate-ok" : "hr-plate-a")" aria-hidden="true">
                        <Icon Name="sparkles" Size="sm" />
                    </span>
                </div>
                <strong class="hr-stat-figure">
                    @todayBirthdays.Count <span class="hr-stat-unit">موظف</span>
                </strong>
                <p class="hr-stat-foot">
                    خلال 7 أيام قادمة: <strong class="hr-num">@countNext7Days</strong> موظف
                </p>
            </div>

            <div class="hr-card hr-stat hr-stat-b bday-kpi-clickable @(quickRange == "current_month" ? "is-active-kpi" : "")"
                 @onclick='() => SetQuickRange(quickRange == "current_month" ? "all" : "current_month")'
                 title="انقر لتصفية مواليد هذا الشهر">
                <div class="hr-stat-label">
                    <span>مواليد هذا الشهر</span>
                    <span class="hr-iconplate hr-plate-b" aria-hidden="true">
                        <Icon Name="calendar-days" Size="sm" />
                    </span>
                </div>
                <strong class="hr-stat-figure">
                    @thisMonthBirthdays.Count <span class="hr-stat-unit">موظف</span>
                </strong>
                <p class="hr-stat-foot">
                    شهر: <strong>@ZodiacAndGenerationHelper.FormatMonthArabic(today.Month)</strong> (خلال 30 يوماً: @countNext30Days)
                </p>
            </div>

            <div class="hr-card hr-stat hr-stat-c bday-kpi-clickable @(filterZodiac == topZodiac?.NameAr && !string.IsNullOrEmpty(filterZodiac) ? "is-active-kpi" : "")"
                 @onclick="ToggleTopZodiacFilter"
                 title="انقر لتصفية موظفي البرج الأكثر شيوعاً">
                <div class="hr-stat-label">
                    <span>البرج الأكثر شيوعاً</span>
                    <span class="hr-iconplate hr-plate-c" aria-hidden="true">
                        <Icon Name="sun" Size="sm" />
                    </span>
                </div>
                <strong class="hr-stat-figure hr-stat-figure-text">
                    @(topZodiac?.NameAr ?? "—") <span style="font-size:1.1rem;color: var(--accent-text);">@(topZodiac?.Symbol)</span>
                </strong>
                <p class="hr-stat-foot">
                    @topZodiacCount موظفاً ينتمون لبرج @(topZodiac?.NameAr)
                </p>
            </div>

            <div class="hr-card hr-stat hr-stat-d bday-kpi-clickable @(filterGeneration == topGeneration?.NameAr && !string.IsNullOrEmpty(filterGeneration) ? "is-active-kpi" : "")"
                 @onclick="ToggleTopGenerationFilter"
                 title="انقر لتصفية موظفي الجيل السائد">
                <div class="hr-stat-label">
                    <span>الجيل السائد</span>
                    <span class="hr-iconplate hr-plate-d" aria-hidden="true">
                        <Icon Name="users" Size="sm" />
                    </span>
                </div>
                <strong class="hr-stat-figure hr-stat-figure-text" style="font-size:1.15rem;">
                    @(topGeneration?.NameAr ?? "—")
                </strong>
                <p class="hr-stat-foot">
                    يمثلون نسبة <span class="hr-num">@topGenPercentage%</span> · متوسط العمر: <span class="hr-num">@averageAge.ToString("F1")</span> سنة
                </p>
            </div>
        </section>

        @* ==================== 4. QUICK 12-MONTH INTERACTIVE BAR ==================== *@
        <section class="hr-card hr-no-print bday-months-strip" aria-label="شريط الأشهر السريع">
            <div class="bday-months-grid">
                @for (int m = 1; m <= 12; m++)
                {
                    var monthNum = m;
                    var mCount = monthCounts[monthNum];
                    var isCurrentMonth = monthNum == today.Month;
                    var isSelectedMonth = filterMonth == monthNum || (viewMode == BirthdayViewMode.ByMonth && selectedMonthView == monthNum);
                    var pct = maxMonthCount > 0 ? (mCount * 100.0 / maxMonthCount) : 0;

                    <button type="button"
                            class="bday-month-pill @(isSelectedMonth ? "is-selected" : "") @(isCurrentMonth ? "is-current" : "")"
                            @onclick="() => ToggleMonthQuickFilter(monthNum)"
                            title="شهر @ZodiacAndGenerationHelper.FormatMonthArabic(monthNum): @mCount موظف">
                        <div class="bday-month-pill-top">
                            <span class="bday-month-num">@monthNum</span>
                            <span class="bday-month-name">@GetShortMonthName(monthNum)</span>
                        </div>
                        <strong class="bday-month-count">@mCount</strong>
                        <div class="bday-month-bar">
                            <div class="bday-month-bar-fill" style="width:@pct.ToString("F0", CultureInfo.InvariantCulture)%;"></div>
                        </div>
                    </button>
                }
            </div>
        </section>

        @* ==================== 5. FILTER & VIEW MODE TOOLBAR ==================== *@
        <section class="hr-card hr-no-print" style="padding:var(--s-3) var(--s-4);">
            <div style="display:flex;flex-direction:column;gap:var(--s-3);">
                @* Top Row: View Mode Tabs & Quick Range Filter *@
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-3);">
                    <div class="hr-chips" role="tablist">
                        <button type="button"
                                class="hr-chip @(viewMode == BirthdayViewMode.Upcoming ? "is-selected" : "")"
                                @onclick="() => SetViewMode(BirthdayViewMode.Upcoming)">
                            <Icon Name="clock" Size="xs" />
                            <span>الترتيب الزمني (الأقرب قادماً)</span>
                        </button>

                        <button type="button"
                                class="hr-chip @(viewMode == BirthdayViewMode.ByMonth ? "is-selected" : "")"
                                @onclick="() => SetViewMode(BirthdayViewMode.ByMonth)">
                            <Icon Name="calendar-days" Size="xs" />
                            <span>التقويم السنوي (12 شهراً)</span>
                        </button>

                        <button type="button"
                                class="hr-chip @(viewMode == BirthdayViewMode.ByYearAndGen ? "is-selected" : "")"
                                @onclick="() => SetViewMode(BirthdayViewMode.ByYearAndGen)">
                            <Icon Name="academic-cap" Size="xs" />
                            <span>التحليل الديمغرافي والجيلي</span>
                        </button>

                        <button type="button"
                                class="hr-chip @(viewMode == BirthdayViewMode.Cohorts ? "is-selected" : "")"
                                @onclick="() => SetViewMode(BirthdayViewMode.Cohorts)">
                            <Icon Name="squares-2x2" Size="xs" />
                            <span>المطابقات والتزامن الوظيفي</span>
                        </button>
                    </div>

                    @* Quick Timeframe Filter Pills *@
                    <div style="display:flex;align-items:center;gap:0.35rem;flex-wrap:wrap;">
                        <button type="button"
                                class="hr-btn @(quickRange == "all" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                @onclick='() => SetQuickRange("all")'>
                            الكل (@allEmployeesWithBirthdays.Count)
                        </button>
                        <button type="button"
                                class="hr-btn @(quickRange == "today" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                @onclick='() => SetQuickRange("today")'>
                            اليوم (@todayBirthdays.Count)
                        </button>
                        <button type="button"
                                class="hr-btn @(quickRange == "week" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                @onclick='() => SetQuickRange("week")'>
                            خلال 7 أيام (@countNext7Days)
                        </button>
                        <button type="button"
                                class="hr-btn @(quickRange == "month30" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                @onclick='() => SetQuickRange("month30")'>
                            خلال 30 يوماً (@countNext30Days)
                        </button>
                        <button type="button"
                                class="hr-btn @(quickRange == "current_month" ? "hr-btn-primary" : "hr-btn-quiet") hr-btn-xs"
                                @onclick='() => SetQuickRange("current_month")'>
                            هذا الشهر (@thisMonthBirthdays.Count)
                        </button>
                    </div>
                </div>

                @* Bottom Row: Instant Search & Granular Dropdown Filters *@
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);padding-block-start:var(--s-2);border-block-start:1px dashed var(--line);">
                    <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;flex:1;">
                        <div style="position:relative;min-width:min(240px, 100%);flex:1;max-width:340px;">
                            <input aria-label="البحث في أعياد الميلاد" type="search"
                                   class="hr-input hr-input-sm"
                                   placeholder="بحث فوري بالاسم، الرقم الوظيفي، التشكيل، العنوان…"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @bind:after="ApplyFilters" />
                        </div>

                        <select aria-label="تصفية حسب الشهر" class="hr-input hr-input-sm" style="width:auto;min-width:125px;" @bind="filterMonth" @bind:after="ApplyFilters">
                            <option value="0">كافة الأشهر</option>
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@m - @ZodiacAndGenerationHelper.FormatMonthArabic(m) (@monthCounts[m])</option>
                            }
                        </select>

                        <select aria-label="تصفية حسب البرج" class="hr-input hr-input-sm" style="width:auto;min-width:135px;" @bind="filterZodiac" @bind:after="ApplyFilters">
                            <option value="">كافة الأبراج</option>
                            @foreach (var z in allZodiacNames)
                            {
                                <option value="@z.NameAr">@z.Symbol @z.NameAr (@z.Element)</option>
                            }
                        </select>

                        <select aria-label="تصفية حسب الجيل" class="hr-input hr-input-sm" style="width:auto;min-width:135px;" @bind="filterGeneration" @bind:after="ApplyFilters">
                            <option value="">كافة الأجيال</option>
                            @foreach (var gen in allGenerationsList)
                            {
                                <option value="@gen.NameAr">@gen.NameAr (@gen.YearsRange)</option>
                            }
                        </select>

                        @if (distinctFormations.Count > 1)
                        {
                            <select aria-label="تصفية حسب التشكيل" class="hr-input hr-input-sm" style="width:auto;min-width:140px;max-width:220px;" @bind="filterFormation" @bind:after="ApplyFilters">
                                <option value="">كافة التشكيلات (@distinctFormations.Count)</option>
                                @foreach (var f in distinctFormations)
                                {
                                    <option value="@f">@f</option>
                                }
                            </select>
                        }

                        <select aria-label="ترتيب القائمة" class="hr-input hr-input-sm" style="width:auto;min-width:150px;" @bind="sortOrder" @bind:after="ApplyFilters">
                            <option value="upcoming">الأقرب قادماً (زمنياً)</option>
                            <option value="calendar">حسب يوم وشهر الميلاد</option>
                            <option value="age_desc">الأكبر سناً أولاً</option>
                            <option value="age_asc">الأصغر سناً أولاً</option>
                            <option value="name_asc">أبجدياً (اسم الموظف)</option>
                        </select>
                    </div>

                    <div style="display:flex;align-items:center;gap:0.65rem;">
                        @if (viewMode == BirthdayViewMode.Upcoming)
                        {
                            <div class="hr-segmented" role="group" aria-label="نمط عرض البطاقات أو الجدول">
                                <button type="button"
                                        class="hr-segmented-btn @(upcomingLayout == "cards" ? "is-active" : "")"
                                        @onclick='() => upcomingLayout = "cards"'
                                        title="عرض شبكي بالبطاقات">
                                    <Icon Name="squares-2x2" Size="xs" />
                                    <span>بطاقات</span>
                                </button>
                                <button type="button"
                                        class="hr-segmented-btn @(upcomingLayout == "table" ? "is-active" : "")"
                                        @onclick='() => upcomingLayout = "table"'
                                        title="عرض جدولي مدمج وسريع">
                                    <Icon Name="table-cells" Size="xs" />
                                    <span>جدول</span>
                                </button>
                            </div>
                        }

                        <span class="hr-meta" style="font-size:var(--fs-label);white-space:nowrap;">
                            النتائج: <strong>@filteredEmployees.Count.ToString("N0")</strong> من <strong>@allEmployeesWithBirthdays.Count.ToString("N0")</strong>
                        </span>

                        @if (HasActiveFilters)
                        {
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" @onclick="ResetFilters">
                                <Icon Name="x-mark" Size="xs" />
                                <span>إعادة تعيين</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>

        @* ==================== VIEW 1: UPCOMING TIMELINE (PAGINATED FOR INSTANT RENDERING) ==================== *@
        @if (viewMode == BirthdayViewMode.Upcoming)
        {
            <div class="hr-stack">
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                    <h2 class="hr-h3" style="display:flex;align-items:center;gap:0.5rem;margin:0;">
                        <Icon Name="clock" Size="sm" />
                        <span>جدول أعياد الميلاد المرتب زمنياً</span>
                        <span class="hr-badge hr-badge-accent">@filteredEmployees.Count.ToString("N0") موظفاً</span>
                    </h2>

                    <div style="display:flex;align-items:center;gap:var(--s-2);flex-wrap:wrap;">
                        <span class="hr-meta" style="font-size:var(--fs-xs);">عدد العناصر بالصفحة:</span>
                        <select class="hr-input hr-input-sm" style="width:auto;min-width:85px;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                            <option value="24">24 بطاقة</option>
                            <option value="48">48 بطاقة</option>
                            <option value="96">96 بطاقة</option>
                            <option value="200">200 عنصر</option>
                        </select>
                    </div>
                </div>

                @if (filteredEmployees.Count == 0)
                {
                    <div class="hr-card hr-empty" style="padding:var(--s-8);">
                        <span class="hr-empty-art" aria-hidden="true"><Icon Name="cake" Size="lg" /></span>
                        <p class="hr-h3">لم يتم العثور على سجلات مطابقة للبحث أو الفلترة</p>
                        <p class="hr-sub">يرجى تعديل معايير التصفية أو الضغط على إعادة تعيين الفلاتر.</p>
                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" style="margin-block-start:var(--s-3);" @onclick="ResetFilters">
                            إعادة تعيين الفلاتر
                        </button>
                    </div>
                }
                else if (upcomingLayout == "cards")
                {
                    <div class="bday-cards-grid">
                        @foreach (var item in PagedUpcomingEmployees)
                        {
                            var isToday = item.DaysUntilNext == 0;
                            var isThisWeek = item.DaysUntilNext > 0 && item.DaysUntilNext <= 7;

                            <div class="hr-card bday-emp-card @(isToday ? "is-today" : isThisWeek ? "is-week" : "")" @key="item.Id">
                                <div>
                                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--s-2);margin-block-end:var(--s-3);">
                                        <div style="display:flex;align-items:center;gap:var(--s-3);min-width:0;">
                                            <div class="bday-avatar-wrap">
                                                <div class="bday-avatar @(isToday ? "is-today" : isThisWeek ? "is-week" : "")">
                                                    @if (!string.IsNullOrEmpty(item.PhotoUrl))
                                                    {
                                                        <img src="@item.PhotoUrl" alt="@item.Name" loading="lazy" decoding="async" />
                                                    }
                                                    else
                                                    {
                                                        <span>@item.Initials</span>
                                                    }
                                                </div>
                                                @if (isToday)
                                                {
                                                    <span class="bday-avatar-badge is-today" title="عيد ميلاد اليوم">🎂</span>
                                                }
                                                else if (isThisWeek)
                                                {
                                                    <span class="bday-avatar-badge is-week" title="خلال هذا الأسبوع">✨</span>
                                                }
                                            </div>

                                            <div style="min-width:0;">
                                                <a href="employees/@item.EmployeeID" class="hr-link bday-emp-name" title="@item.Name">
                                                    @item.Name
                                                </a>
                                                <span class="hr-meta" style="font-size:var(--fs-caption);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                                    <span class="hr-num">@item.EmployeeID</span> · @(item.JobTitle ?? "موظف")
                                                </span>
                                            </div>
                                        </div>

                                        @if (isToday)
                                        {
                                            <span class="hr-badge hr-badge-warn" style="font-weight:700;flex-shrink:0;">اليوم! 🎂</span>
                                        }
                                        else if (isThisWeek)
                                        {
                                            <span class="hr-badge hr-badge-warn" style="font-weight:700;flex-shrink:0;">
                                                بعد @item.DaysUntilNext @(item.DaysUntilNext <= 2 ? "يوم" : "أيام")
                                            </span>
                                        }
                                        else if (item.DaysUntilNext <= 30)
                                        {
                                            <span class="hr-badge hr-badge-accent" style="flex-shrink:0;">بعد @item.DaysUntilNext يوماً</span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge" style="flex-shrink:0;">بعد @item.DaysUntilNext يوماً</span>
                                        }
                                    </div>

                                    <div class="bday-date-box">
                                        <div style="display:flex;align-items:center;gap:0.35rem;">
                                            <Icon Name="calendar-days" Size="xs" />
                                            <strong class="hr-num" style="font-size:var(--fs-control);">@item.BirthDateFormatted</strong>
                                            <span class="hr-meta" style="font-size:var(--fs-caption);">(@item.DayMonthArabic)</span>
                                        </div>
                                        <div class="hr-badge" style="font-size:var(--fs-caption);background:var(--surface);font-weight:700;">
                                            العمر: <strong class="hr-num" style="margin-inline-start:3px;">@item.Age سنة</strong>
                                        </div>
                                    </div>

                                    <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;margin-block-end:var(--s-2);">
                                        <span class="hr-badge" style="border:1px solid @item.Zodiac.ElementColor;background:color-mix(in srgb, @item.Zodiac.ElementColor 10%, var(--surface));color:var(--text);font-size:var(--fs-caption);" title="@item.Zodiac.Trait - عنصر: @item.Zodiac.Element">
                                            <span style="color:@item.Zodiac.ElementColor;font-weight:800;font-size:0.95rem;">@item.Zodiac.Symbol</span>
                                            <span>برج @item.Zodiac.NameAr</span>
                                            <span style="font-size:var(--fs-caption);color:var(--text-muted);">(@item.Zodiac.Element)</span>
                                        </span>

                                        <span class="hr-badge @item.Generation.TagClass" style="font-size:var(--fs-caption);" title="@item.Generation.Description (@item.Generation.YearsRange)">
                                            @item.Generation.NameAr
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Formation))
                                    {
                                        <div class="hr-meta" style="font-size:var(--fs-caption);margin-block-start:0.25rem;display:flex;align-items:center;gap:0.3rem;">
                                            <Icon Name="building-office-2" Size="xs" />
                                            <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Formation</span>
                                        </div>
                                    }
                                </div>

                                <div class="bday-card-foot">
                                    <span class="hr-meta" style="font-size:var(--fs-caption);">
                                        المناسبة القادمة: <span class="hr-num">@item.NextBirthdayFormatted</span>
                                    </span>
                                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => OpenGreetingModal(item)" title="نسخ رسالة التهنئة الإدارية">
                                        <Icon Name="gift" Size="xs" />
                                        <span>تهنئة</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @* Compact High-Speed Table Layout *@
                    <div class="hr-card" style="padding:0;overflow:hidden;">
                        <div class="hr-tablewrap">
                            <table class="hr-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width:48px;">الصورة</th>
                                        <th scope="col">الموظف</th>
                                        <th scope="col">الرقم الوظيفي</th>
                                        <th scope="col">تاريخ الميلاد</th>
                                        <th scope="col">العمر</th>
                                        <th scope="col">المتبقي</th>
                                        <th scope="col">البرج الفلكي</th>
                                        <th scope="col">الجيل</th>
                                        <th scope="col">التشكيل الإداري</th>
                                        <th scope="col" style="width:90px;">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var emp in PagedUpcomingEmployees)
                                    {
                                        var isTodayEmp = emp.DaysUntilNext == 0;
                                        <tr @key="emp.Id" style="@(isTodayEmp ? "background:var(--warn-tint);font-weight:700;" : "")">
                                            <td>
                                                <div class="bday-avatar bday-avatar-sm">
                                                    @if (!string.IsNullOrEmpty(emp.PhotoUrl))
                                                    {
                                                        <img src="@emp.PhotoUrl" alt="@emp.Name" loading="lazy" decoding="async" />
                                                    }
                                                    else
                                                    {
                                                        <span>@emp.Initials</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <a href="employees/@emp.EmployeeID" class="hr-link hr-cell-strong">@emp.Name</a>
                                                @if (!string.IsNullOrWhiteSpace(emp.JobTitle))
                                                {
                                                    <div class="hr-meta" style="font-size:var(--fs-caption);">@emp.JobTitle</div>
                                                }
                                            </td>
                                            <td><span class="hr-num">@emp.EmployeeID</span></td>
                                            <td>
                                                <span class="hr-num">@emp.BirthDateFormatted</span>
                                                <span class="hr-meta" style="font-size:var(--fs-caption);display:block;">@emp.DayMonthArabic</span>
                                            </td>
                                            <td><strong class="hr-num">@emp.Age</strong> سنة</td>
                                            <td>
                                                @if (isTodayEmp)
                                                {
                                                    <span class="hr-badge hr-badge-warn">اليوم 🎂</span>
                                                }
                                                else if (emp.DaysUntilNext <= 7)
                                                {
                                                    <span class="hr-badge hr-badge-warn">بعد @emp.DaysUntilNext أيام</span>
                                                }
                                                else
                                                {
                                                    <span class="hr-badge">بعد @emp.DaysUntilNext يوماً</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="hr-badge" style="border:1px solid @emp.Zodiac.ElementColor;font-size:var(--fs-caption);">
                                                    <span style="color:@emp.Zodiac.ElementColor;font-weight:800;">@emp.Zodiac.Symbol</span>
                                                    <span>@emp.Zodiac.NameAr</span>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="hr-badge @emp.Generation.TagClass" style="font-size:var(--fs-caption);">@emp.Generation.NameAr</span>
                                            </td>
                                            <td>@(emp.Formation ?? "—")</td>
                                            <td>
                                                <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => OpenGreetingModal(emp)">
                                                    <Icon Name="gift" Size="xs" />
                                                    <span>تهنئة</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Pagination Controls *@
                @if (TotalUpcomingPages > 1)
                {
                    <div class="hr-card hr-no-print bday-pagination">
                        <span class="hr-meta">
                            عرض <strong>@(((currentPage - 1) * pageSize) + 1)–@(Math.Min(currentPage * pageSize, filteredEmployees.Count))</strong> من أصل <strong>@filteredEmployees.Count.ToString("N0")</strong> موظف
                        </span>

                        <div style="display:flex;align-items:center;gap:0.35rem;flex-wrap:wrap;">
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(1)">الأولى</button>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">السابق</button>

                            <span class="hr-badge hr-badge-accent" style="padding:0.3rem 0.75rem;">
                                صفحة @currentPage من @TotalUpcomingPages
                            </span>

                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" disabled="@(currentPage >= TotalUpcomingPages)" @onclick="() => GoToPage(currentPage + 1)">التالي</button>
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" disabled="@(currentPage >= TotalUpcomingPages)" @onclick="() => GoToPage(TotalUpcomingPages)">الأخيرة</button>
                        </div>
                    </div>
                }
            </div>
        }

        @* ==================== VIEW 2: BY MONTH (12 شهراً) ==================== *@
        @if (viewMode == BirthdayViewMode.ByMonth)
        {
            <div class="hr-stack">
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                    <div>
                        <h2 class="hr-h3">التقويم السنوي الموزع على أشهر السنة</h2>
                        <p class="hr-meta">انقر على أي شهر لعرض كشف موظفيه بشكل فوري أو استعراض الشهر الحالي</p>
                    </div>

                    <div class="hr-chips" role="tablist">
                        <button type="button" class="hr-chip @(selectedMonthView == today.Month ? "is-selected" : "")" @onclick="() => selectedMonthView = today.Month">
                            الشهر الحالي (@ZodiacAndGenerationHelper.FormatMonthArabic(today.Month))
                        </button>
                        <button type="button" class="hr-chip @(selectedMonthView == 0 ? "is-selected" : "")" @onclick="() => selectedMonthView = 0">
                            عرض كافة الأشهر الـ 12
                        </button>
                    </div>
                </div>

                @for (var m = 1; m <= 12; m++)
                {
                    var monthNum = m;
                    if (selectedMonthView != 0 && selectedMonthView != monthNum)
                    {
                        continue;
                    }

                    var monthEmployees = filteredByMonth[monthNum];
                    if (monthEmployees.Count > 0 || selectedMonthView == monthNum)
                    {
                        var isCurrent = monthNum == today.Month;
                        var displayList = selectedMonthView == 0 ? monthEmployees.Take(50).ToList() : monthEmployees;

                        <div class="hr-card" style="border-radius:var(--r-lg);">
                            <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;padding:var(--s-3) var(--s-4);background:var(--surface-sunken);flex-wrap:wrap;gap:var(--s-2);">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <span class="hr-iconplate @(isCurrent ? "hr-plate-ok" : "hr-plate-b")" style="width:2rem;height:2rem;" aria-hidden="true">
                                        <Icon Name="calendar-days" Size="xs" />
                                    </span>
                                    <h3 class="hr-h3" style="margin:0;">
                                        شهر @ZodiacAndGenerationHelper.FormatMonthArabic(monthNum)
                                        <span class="hr-badge" style="margin-inline-start:0.5rem;">@monthEmployees.Count موظفاً</span>
                                    </h3>
                                </div>
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    @if (isCurrent)
                                    {
                                        <span class="hr-badge hr-badge-ok">الشهر الحالي</span>
                                    }
                                    @if (selectedMonthView == 0 && monthEmployees.Count > 50)
                                    {
                                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-xs" @onclick="() => selectedMonthView = monthNum">
                                            عرض كامل الشهر (@monthEmployees.Count)
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="hr-card-body" style="padding:0;">
                                @if (monthEmployees.Count == 0)
                                {
                                    <p class="hr-sub" style="padding:var(--s-4);text-align:center;">لا توجد سجلات أعياد ميلاد مسجلة في هذا الشهر مطابقة لمعايير البحث.</p>
                                }
                                else
                                {
                                    <div class="hr-tablewrap">
                                        <table class="hr-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col" style="width:50px;">الصورة</th>
                                                    <th scope="col">يوم الميلاد</th>
                                                    <th scope="col">الموظف</th>
                                                    <th scope="col">الرقم الوظيفي</th>
                                                    <th scope="col">تاريخ الميلاد الكامل</th>
                                                    <th scope="col">العمر الحالي</th>
                                                    <th scope="col">البرج الفلكي</th>
                                                    <th scope="col">الجيل</th>
                                                    <th scope="col">التشكيل</th>
                                                    <th scope="col" style="width:80px;">إجراء</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var emp in displayList)
                                                {
                                                    var isTodayEmp = emp.DaysUntilNext == 0;
                                                    <tr @key="emp.Id" style="@(isTodayEmp ? "background:var(--warn-tint);font-weight:700;" : "")">
                                                        <td>
                                                            <div class="bday-avatar bday-avatar-sm">
                                                                @if (!string.IsNullOrEmpty(emp.PhotoUrl))
                                                                {
                                                                    <img src="@emp.PhotoUrl" alt="@emp.Name" loading="lazy" decoding="async" />
                                                                }
                                                                else
                                                                {
                                                                    <span>@emp.Initials</span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <strong class="hr-num" style="color: var(--accent-text);font-size:0.95rem;">
                                                                @emp.DayMonthArabic
                                                            </strong>
                                                            @if (isTodayEmp)
                                                            {
                                                                <span class="hr-badge hr-badge-ok" style="margin-inline-start:4px;font-size:var(--fs-caption);">اليوم 🎂</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <a href="employees/@emp.EmployeeID" class="hr-link hr-cell-strong">
                                                                @emp.Name
                                                            </a>
                                                        </td>
                                                        <td><span class="hr-num">@emp.EmployeeID</span></td>
                                                        <td><span class="hr-num">@emp.BirthDateFormatted</span></td>
                                                        <td><span class="hr-num">@emp.Age سنة</span></td>
                                                        <td>
                                                            <span class="hr-badge" style="border:1px solid @emp.Zodiac.ElementColor;font-size:var(--fs-caption);">
                                                                <span style="color:@emp.Zodiac.ElementColor;font-weight:800;">@emp.Zodiac.Symbol</span>
                                                                <span>@emp.Zodiac.NameAr</span>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="hr-badge @emp.Generation.TagClass" style="font-size:var(--fs-caption);">
                                                                @emp.Generation.NameAr
                                                            </span>
                                                        </td>
                                                        <td>@(emp.Formation ?? "—")</td>
                                                        <td>
                                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs" @onclick="() => OpenGreetingModal(emp)" title="تهنئة">
                                                                <Icon Name="gift" Size="xs" />
                                                                <span>تهنئة</span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* ==================== VIEW 3: BY YEAR & GENERATION ==================== *@
        @if (viewMode == BirthdayViewMode.ByYearAndGen)
        {
            <div class="hr-stack">
                <div>
                    <h2 class="hr-h3">التحليل الديمغرافي والجيلي لكوادر المؤسسة</h2>
                    <p class="hr-meta">انقر على أي فئة جيلية لحصر الجدول بموظفي ذلك الجيل</p>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(270px, 100%), 1fr));gap:var(--s-4);">
                    @foreach (var grp in generationSummaryGroups)
                    {
                        var sample = grp.Generation;
                        var count = grp.TotalCount;
                        var pct = allEmployeesWithBirthdays.Count > 0 ? (count * 100.0 / allEmployeesWithBirthdays.Count) : 0;
                        var isGenSelected = filterGeneration == sample.NameAr;

                        <div class="hr-card bday-kpi-clickable @(isGenSelected ? "is-active-kpi" : "")"
                             style="padding:var(--s-4);border-radius:var(--r-lg);border-inline-start:4px solid @sample.Color;"
                             @onclick="() => ToggleGenerationFilter(sample.NameAr)">
                            <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-block-end:var(--s-2);flex-wrap:wrap;gap:var(--s-2);">
                                <div>
                                    <strong style="font-size:1.1rem;color:var(--text);display:block;">@sample.NameAr</strong>
                                    <span class="hr-meta" style="font-size:var(--fs-caption);">@sample.NameEn · (@sample.YearsRange)</span>
                                </div>
                                <span class="hr-badge" style="font-weight:800;font-size:var(--fs-body);">
                                    @count موظف
                                </span>
                            </div>

                            <p class="hr-meta" style="font-size:var(--fs-label);margin-block-end:var(--s-3);">
                                @sample.Description
                            </p>

                            <div style="display:flex;align-items:center;gap:0.5rem;">
                                <div style="flex:1;height:8px;background:var(--surface-sunken);border-radius:var(--r-full);overflow:hidden;">
                                    <div style="width:@pct.ToString("F1", CultureInfo.InvariantCulture)%;height:100%;background:@sample.Color;border-radius:var(--r-full);"></div>
                                </div>
                                <span class="hr-num" style="font-size:var(--fs-label);font-weight:800;color:var(--text);">@pct.ToString("F1")%</span>
                            </div>
                        </div>
                    }
                </div>

                @foreach (var grp in generationSummaryGroups)
                {
                    var sample = grp.Generation;
                    var emps = filteredEmployees
                        .Where(e => e.Generation.NameAr == sample.NameAr)
                        .OrderBy(e => e.BirthYear)
                        .ThenBy(e => e.BirthMonth)
                        .ToList();

                    if (emps.Count > 0)
                    {
                        <div class="hr-card" style="margin-block-start:var(--s-3);border-radius:var(--r-lg);">
                            <div class="hr-card-head" style="display:flex;align-items:center;justify-content:space-between;padding:var(--s-3) var(--s-4);background:var(--surface-sunken);flex-wrap:wrap;gap:var(--s-2);">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <span class="hr-iconplate" style="background:color-mix(in srgb, @sample.Color 15%, transparent);color:@sample.Color;width:2rem;height:2rem;" aria-hidden="true">
                                        <Icon Name="academic-cap" Size="xs" />
                                    </span>
                                    <h3 class="hr-h3" style="margin:0;">
                                        @sample.NameAr (@sample.YearsRange)
                                        <span class="hr-badge" style="margin-inline-start:0.5rem;">@emps.Count موظفاً</span>
                                    </h3>
                                </div>
                            </div>

                            <div class="hr-card-body" style="padding:0;">
                                <div class="hr-tablewrap" style="max-height:420px;overflow-y:auto;">
                                    <table class="hr-table">
                                        <thead>
                                            <tr>
                                                <th scope="col" style="width:50px;">الصورة</th>
                                                <th scope="col">سنة التولد</th>
                                                <th scope="col">الموظف</th>
                                                <th scope="col">الرقم الوظيفي</th>
                                                <th scope="col">تاريخ الميلاد الكامل</th>
                                                <th scope="col">العمر الحالي</th>
                                                <th scope="col">البرج الفلكي</th>
                                                <th scope="col">التشكيل الإداري</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var emp in emps.Take(100))
                                            {
                                                <tr @key="emp.Id">
                                                    <td>
                                                        <div class="bday-avatar bday-avatar-sm">
                                                            @if (!string.IsNullOrEmpty(emp.PhotoUrl))
                                                            {
                                                                <img src="@emp.PhotoUrl" alt="@emp.Name" loading="lazy" decoding="async" />
                                                            }
                                                            else
                                                            {
                                                                <span>@emp.Initials</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td><strong class="hr-num" style="color: var(--accent-text);">@emp.BirthYear</strong></td>
                                                    <td>
                                                        <a href="employees/@emp.EmployeeID" class="hr-link hr-cell-strong">
                                                            @emp.Name
                                                        </a>
                                                    </td>
                                                    <td><span class="hr-num">@emp.EmployeeID</span></td>
                                                    <td><span class="hr-num">@emp.BirthDateFormatted</span></td>
                                                    <td><span class="hr-num">@emp.Age سنة</span></td>
                                                    <td>
                                                        <span class="hr-badge" style="border:1px solid @emp.Zodiac.ElementColor;font-size:var(--fs-caption);">
                                                            <span style="color:@emp.Zodiac.ElementColor;font-weight:800;">@emp.Zodiac.Symbol</span>
                                                            <span>@emp.Zodiac.NameAr</span>
                                                        </span>
                                                    </td>
                                                    <td>@(emp.Formation ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* ==================== VIEW 4: SYNCHRONIZATION & COHORTS ==================== *@
        @if (viewMode == BirthdayViewMode.Cohorts)
        {
            <div class="hr-stack">
                <div>
                    <h2 class="hr-h3">المطابقات والتزامن الوظيفي</h2>
                    <p class="hr-meta">تحليل حالات التزامن في يوم وشهر الميلاد، وتوزيع الكوادر حسب سنة التولد والأبراج الفلكية المشتركة</p>
                </div>

                <div class="hr-tabs-nav" style="border-block-end:1px solid var(--line);margin-block-end:var(--s-4);">
                    <div class="hr-tabs" role="tablist">
                        <button type="button" class="hr-tab @(cohortSubView == "exact_day" ? "is-active" : "")" @onclick='() => cohortSubView = "exact_day"'>
                            <Icon Name="sparkles" Size="xs" />
                            <span>تطابق اليوم والشهر (@dayTwinsGroups.Count)</span>
                        </button>
                        <button type="button" class="hr-tab @(cohortSubView == "same_year" ? "is-active" : "")" @onclick='() => cohortSubView = "same_year"'>
                            <Icon Name="academic-cap" Size="xs" />
                            <span>أفواج سنة الميلاد (@yearCohortGroups.Count)</span>
                        </button>
                        <button type="button" class="hr-tab @(cohortSubView == "zodiac" ? "is-active" : "")" @onclick='() => cohortSubView = "zodiac"'>
                            <Icon Name="sun" Size="xs" />
                            <span>التوزيع الفلكي حسب الأبراج الـ 12</span>
                        </button>
                    </div>
                </div>

                @if (cohortSubView == "exact_day")
                {
                    <div class="hr-stack">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                            <h3 class="hr-h4">الموظفون المشتركون في نفس يوم وشهر الميلاد</h3>
                            <span class="hr-badge hr-badge-ok">@dayTwinsGroups.Count يوماً مشتركاً بين موظفين متعددين</span>
                        </div>

                        @if (dayTwinsGroups.Count == 0)
                        {
                            <div class="hr-card hr-empty" style="padding:var(--s-6);">
                                <p class="hr-sub">لا توجد حالات تطابق في نفس اليوم والشهر ضمن نتائج التصفية الحالية.</p>
                            </div>
                        }
                        else
                        {
                            <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(min(350px, 100%), 1fr));gap:var(--s-4);">
                                @foreach (var grp in dayTwinsGroups.Take(60))
                                {
                                    var first = grp.Employees[0];
                                    var zodiac = first.Zodiac;

                                    <div class="hr-card" style="padding:var(--s-4);border-radius:var(--r-lg);border:1.5px solid color-mix(in srgb, var(--accent) 35%, var(--line));background:var(--surface);">
                                        <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:var(--s-3);padding-block-end:var(--s-2);border-block-end:1px dashed var(--line);flex-wrap:wrap;gap:var(--s-2);">
                                            <div style="display:flex;align-items:center;gap:0.5rem;">
                                                <span class="hr-iconplate hr-plate-a" style="width:2.25rem;height:2.25rem;font-size:1.1rem;" aria-hidden="true">📅</span>
                                                <div>
                                                    <strong style="font-size:1rem;color:var(--text);display:block;">
                                                        @first.DayMonthArabic
                                                    </strong>
                                                    <span class="hr-meta" style="font-size:var(--fs-caption);">
                                                        @zodiac.Symbol برج @zodiac.NameAr (@zodiac.Element)
                                                    </span>
                                                </div>
                                            </div>
                                            <span class="hr-badge hr-badge-accent" style="font-weight:800;">
                                                @grp.Employees.Count موظفين
                                            </span>
                                        </div>

                                        <div style="display:flex;flex-direction:column;gap:var(--s-2);">
                                            @foreach (var emp in grp.Employees)
                                            {
                                                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--s-2) var(--s-3);background:var(--surface-sunken);border-radius:var(--r-md);flex-wrap:wrap;gap:var(--s-2);">
                                                    <div style="display:flex;align-items:center;gap:var(--s-2);">
                                                        <div class="bday-avatar bday-avatar-sm">
                                                            @if (!string.IsNullOrEmpty(emp.PhotoUrl))
                                                            {
                                                                <img src="@emp.PhotoUrl" alt="@emp.Name" loading="lazy" decoding="async" />
                                                            }
                                                            else
                                                            {
                                                                <span>@emp.Initials</span>
                                                            }
                                                        </div>
                                                        <div>
                                                            <a href="employees/@emp.EmployeeID" class="hr-link" style="font-weight:700;font-size:var(--fs-body);">
                                                                @emp.Name
                                                            </a>
                                                            <div class="hr-meta" style="font-size:var(--fs-caption);">
                                                                @(emp.JobTitle ?? "موظف") · @(emp.Formation ?? "")
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div style="display:flex;flex-direction:column;align-items:flex-end;">
                                                        <strong class="hr-num" style="font-size:var(--fs-control);color: var(--accent-text);">
                                                            @emp.BirthYear
                                                        </strong>
                                                        <span class="hr-meta" style="font-size:var(--fs-caption);">(@emp.Age سنة)</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (cohortSubView == "same_year")
                {
                    <div class="hr-stack">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                            <h3 class="hr-h4">أفواج الكوادر حسب سنة التولد</h3>
                            <span class="hr-badge">@yearCohortGroups.Count فوجاً سنوياً</span>
                        </div>

                        <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(min(320px, 100%), 1fr));gap:var(--s-3);">
                            @foreach (var grp in yearCohortGroups)
                            {
                                var year = grp.Year;
                                var gen = grp.Generation;

                                <div class="hr-card" style="padding:var(--s-3) var(--s-4);border-radius:var(--r-md);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-block-end:var(--s-2);flex-wrap:wrap;gap:var(--s-2);">
                                        <div style="display:flex;align-items:center;gap:0.5rem;">
                                            <strong class="hr-num" style="font-size:1.25rem;color: var(--accent-text);font-weight:900;">@year</strong>
                                            <span class="hr-badge @gen.TagClass" style="font-size:var(--fs-caption);">@gen.NameAr</span>
                                        </div>
                                        <span class="hr-badge hr-badge-ok">@grp.Employees.Count موظفاً</span>
                                    </div>

                                    <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-block-start:var(--s-2);max-height:150px;overflow-y:auto;">
                                        @foreach (var emp in grp.Employees.Take(40))
                                        {
                                            <a href="employees/@emp.EmployeeID"
                                               class="hr-chip"
                                               style="font-size:var(--fs-caption);padding:3px 8px;text-decoration:none;display:inline-flex;align-items:center;gap:4px;"
                                               title="مواليد @emp.BirthDateFormatted - برج @emp.Zodiac.NameAr">
                                                <span>@emp.Name</span>
                                                <span class="hr-meta" style="font-size:var(--fs-caption);">(@emp.MonthDayShort)</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (cohortSubView == "zodiac")
                {
                    <div class="hr-stack">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--s-2);">
                            <h3 class="hr-h4">توزيع الكوادر حسب الأبراج الفلكية الـ 12</h3>
                            <span class="hr-badge hr-badge-accent">@zodiacCohortGroups.Count برجاً ممثلاً</span>
                        </div>

                        <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(min(320px, 100%), 1fr));gap:var(--s-4);">
                            @foreach (var grp in zodiacCohortGroups)
                            {
                                var zodiac = grp.Zodiac;
                                var count = grp.Employees.Count;
                                var pct = allEmployeesWithBirthdays.Count > 0 ? (count * 100.0 / allEmployeesWithBirthdays.Count) : 0;

                                <div class="hr-card" style="padding:var(--s-4);border-radius:var(--r-lg);border-block-start:3px solid @zodiac.ElementColor;">
                                    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-block-end:var(--s-2);flex-wrap:wrap;gap:var(--s-2);">
                                        <div style="display:flex;align-items:center;gap:0.5rem;">
                                            <span style="font-size:1.75rem;color:@zodiac.ElementColor;line-height:1;">@zodiac.Symbol</span>
                                            <div>
                                                <strong style="font-size:1.1rem;color:var(--text);display:block;">برج @zodiac.NameAr</strong>
                                                <span class="hr-meta" style="font-size:var(--fs-caption);">@zodiac.NameEn · @zodiac.DateRange</span>
                                            </div>
                                        </div>
                                        <span class="hr-badge" style="font-weight:800;font-size:var(--fs-control);">
                                            @count موظفاً (@pct.ToString("F0")%)
                                        </span>
                                    </div>

                                    <div style="display:flex;align-items:center;gap:0.5rem;margin-block:var(--s-2);">
                                        <span class="hr-badge" style="background:color-mix(in srgb, @zodiac.ElementColor 12%, transparent);color:@zodiac.ElementColor;font-size:var(--fs-caption);font-weight:700;">
                                            عنصر: @zodiac.Element
                                        </span>
                                        <span class="hr-meta" style="font-size:var(--fs-caption);">@zodiac.Trait</span>
                                    </div>

                                    <div style="display:flex;flex-wrap:wrap;gap:0.35rem;margin-block-start:var(--s-3);max-height:150px;overflow-y:auto;padding-block-end:4px;">
                                        @foreach (var emp in grp.Employees.Take(45))
                                        {
                                            <a href="employees/@emp.EmployeeID"
                                               class="hr-chip"
                                               style="font-size:var(--fs-caption);padding:2px 8px;text-decoration:none;display:inline-flex;align-items:center;gap:4px;"
                                               title="@emp.Name - مواليد @emp.BirthDateFormatted">
                                                <span>@emp.Name</span>
                                                <span class="hr-meta" style="font-size:var(--fs-caption);">(@emp.MonthDayShort)</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* ==================== MODAL: OFFICIAL ADMINISTRATIVE GREETING ==================== *@
@if (showGreetingModal && greetingTarget != null)
{
    <div class="hr-modal-scrim" @onclick="() => showGreetingModal = false">
        <div class="hr-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="greeting-modal-title" tabindex="-1" @onkeydown="OnGreetingModalKeyDown">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true">
                        <Icon Name="sparkles" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="greeting-modal-title" class="hr-h3">رسالة التهنئة الإدارية الرسمية</h2>
                        <p class="hr-meta">الموظف: <strong>@greetingTarget.Name</strong> (الرقم: @greetingTarget.EmployeeID)</p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showGreetingModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack">
                <div class="hr-card" style="padding:var(--s-3);background:var(--surface-sunken);border:1px solid var(--line);display:flex;align-items:center;gap:var(--s-3);">
                    <div class="bday-avatar" style="width:3.5rem;height:3.5rem;">
                        @if (!string.IsNullOrEmpty(greetingTarget.PhotoUrl))
                        {
                            <img src="@greetingTarget.PhotoUrl" alt="@greetingTarget.Name" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span>@greetingTarget.Initials</span>
                        }
                    </div>
                    <div style="flex:1;">
                        <strong style="display:block;font-size:1rem;color:var(--text);">@greetingTarget.Name</strong>
                        <span class="hr-meta" style="font-size:var(--fs-label);">
                            @(greetingTarget.JobTitle ?? "موظف") · @(greetingTarget.Formation ?? "المؤسسة")
                        </span>
                        <div style="display:flex;align-items:center;gap:0.5rem;margin-block-start:4px;font-size:var(--fs-caption);">
                            <span>تاريخ الميلاد: <strong class="hr-num">@greetingTarget.BirthDateFormatted</strong></span>
                            <span>·</span>
                            <span>@greetingTarget.Zodiac.Symbol برج @greetingTarget.Zodiac.NameAr</span>
                        </div>
                    </div>
                </div>

                <div class="hr-field">
                    <label class="hr-label" for="greeting-text">صيغة التهنئة الإدارية المقترحة</label>
                    <textarea id="greeting-text" class="hr-input" rows="5" @bind="greetingMessageText"></textarea>
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showGreetingModal = false">
                    إغلاق
                </button>
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="SendGreetingTargetToTelegramAsync" disabled="@isSendingTelegramCard">
                    <Icon Name="paper-airplane" Size="xs" />
                    <span>@(isSendingTelegramCard ? "جارٍ الإرسال..." : "إرسال البطاقة والصورة لتلكرام")</span>
                </button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="CopyGreetingText">
                    <Icon Name="clipboard-document-list" Size="xs" />
                    <span>نسخ نص التهنئة للحافظة</span>
                </button>
            </div>
        </div>
    </div>
}

@* ==================== MODAL: TELEGRAM BIRTHDAY BOT SETTINGS ==================== *@
@if (showTelegramModal && botConfigDraft != null)
{
    <div class="hr-modal-scrim" @onclick="() => showTelegramModal = false">
        <div class="hr-modal" style="max-width:720px;width:95%;" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="tg-bot-modal-title">
            <div class="hr-modal-head">
                <div class="hr-modal-lead">
                    <span class="hr-iconplate hr-plate-a" aria-hidden="true">
                        <Icon Name="paper-airplane" Size="sm" />
                    </span>
                    <div class="hr-modal-titles">
                        <h2 id="tg-bot-modal-title" class="hr-h3">إعدادات وإدارة بوت تيليجرام لأعياد الميلاد</h2>
                        <p class="hr-meta">
                            جلب أعياد ميلاد الموظفين الحاليين، الشهر الحالي والقادم، والبحث المخصص مع الصور الشخصية والتفاصيل بدون أي تعديل على قاعدة البيانات
                        </p>
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon" @onclick="() => showTelegramModal = false" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            <div class="hr-modal-body hr-stack" style="max-height:74vh;overflow-y:auto;">
                <!-- Connection Status Banner -->
                <div class="hr-alert @(TelegramBot.IsConnected ? "hr-alert-ok" : "hr-alert-warn")" style="margin:0;">
                    <Icon Name="@(TelegramBot.IsConnected ? "check-circle" : "information-circle")" Size="sm" />
                    <div class="hr-alert-grow">
                        @if (TelegramBot.IsConnected)
                        {
                            <strong>البوت متصل ويعمل بالخلفية بنجاح @(!string.IsNullOrEmpty(TelegramBot.BotUsername) ? $"(@{TelegramBot.BotUsername})" : "")</strong>
                            <p style="margin:0.2rem 0 0;font-size:0.8rem;">
                                يستجيب للأوامر التفاعلية (مواليد اليوم، الغد، الأسبوع، الشهر الحالي، الشهر القادم، التشكيلات، والبحث بالاسم/التاريخ مع الصور).
                            </p>
                        }
                        else
                        {
                            <strong>البوت غير متصل حالياً</strong>
                            <p style="margin:0.2rem 0 0;font-size:0.8rem;">
                                @(string.IsNullOrWhiteSpace(TelegramBot.LastError)
                                    ? "أدخل رمز البوت (Bot Token) من @BotFather وقم بتفعيل الخيار بالأسفل ثم اضغط حفظ."
                                    : $"آخر ملاحظة: {TelegramBot.LastError}")
                            </p>
                        }
                    </div>
                    @if (TelegramBot.IsConnected)
                    {
                        <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="BroadcastTodayToTelegramAsync" disabled="@isTestingBot">
                            <Icon Name="paper-airplane" Size="xs" />
                            <span>بث مواليد اليوم الآن</span>
                        </button>
                    }
                </div>

                <!-- Bot Token & Core Toggles -->
                <div class="hr-card" style="padding:var(--s-3);display:flex;flex-direction:column;gap:var(--s-3);">
                    <div class="hr-field" style="margin:0;">
                        <label class="hr-label" for="tg-bot-token">رمز البوت (Telegram Bot Token من @@BotFather)</label>
                        <div style="display:flex;gap:0.5rem;">
                            <input id="tg-bot-token"
                                   type="password"
                                   dir="ltr"
                                   class="hr-input hr-num"
                                   style="flex:1;"
                                   placeholder="1234567890:AAH..."
                                   @bind="botConfigDraft.BotToken" />
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="TestTelegramTokenAsync" disabled="@isTestingBot">
                                <Icon Name="bolt" Size="xs" />
                                <span>@(isTestingBot ? "جارٍ الفحص..." : "فحص الرمز")</span>
                            </button>
                        </div>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:0.75rem;">
                        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;font-weight:700;cursor:pointer;">
                            <input type="checkbox" @bind="botConfigDraft.IsEnabled" />
                            <span>تفعيل خدمة البوت في النظام</span>
                        </label>

                        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;font-weight:700;cursor:pointer;">
                            <input type="checkbox" @bind="botConfigDraft.SendPhotosAutomatically" />
                            <span>إرسال الصور الشخصية تلقائياً مع البطاقات</span>
                        </label>

                        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;font-weight:700;cursor:pointer;">
                            <input type="checkbox" @bind="botConfigDraft.DailyAutoBroadcastEnabled" />
                            <span>إشعار صباحي يومي تلقائي بمواليد اليوم</span>
                        </label>

                        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;font-weight:700;cursor:pointer;">
                            <input type="checkbox" @bind="botConfigDraft.AllowAllUsers" />
                            <span>السماح لأي مستخدم بدون رمز سري</span>
                        </label>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.75rem;">
                        <div class="hr-field" style="margin:0;">
                            <label class="hr-label" for="tg-pin-input">رمز التفعيل السري في تيليجرام (PIN)</label>
                            <input id="tg-pin-input"
                                   type="text"
                                   dir="ltr"
                                   class="hr-input hr-num"
                                   placeholder="1234"
                                   @bind="botConfigDraft.AccessPin" />
                            <span class="hr-meta" style="font-size:0.72rem;">من يرسل هذا الرمز للبوت يتم تفعيل حسابه تلقائياً</span>
                        </div>

                        <div class="hr-field" style="margin:0;">
                            <label class="hr-label" for="tg-hour-input">ساعة الإشعار اليومي التلقائي (٠ - ٢٣)</label>
                            <input id="tg-hour-input"
                                   type="number"
                                   min="0"
                                   max="23"
                                   dir="ltr"
                                   class="hr-input hr-num"
                                   @bind="botConfigDraft.DailyBroadcastHourLocal" />
                            <span class="hr-meta" style="font-size:0.72rem;">مثال: 8 تعني الساعة 08:00 صباحاً</span>
                        </div>
                    </div>
                </div>

                <!-- Pending Chats Requests -->
                @if (botConfigDraft.PendingChats.Count > 0)
                {
                    <div class="hr-card" style="padding:var(--s-3);border:1px solid var(--series-4);">
                        <h3 class="hr-eyebrow" style="margin-block-end:0.5rem;">طلبات بانتظار الموافقة (@botConfigDraft.PendingChats.Count)</h3>
                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            @foreach (var p in botConfigDraft.PendingChats.ToList())
                            {
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:0.5rem 0.75rem;background:var(--surface-sunken);border-radius:var(--r-md);">
                                    <div>
                                        <strong style="font-size:0.88rem;">@p.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(p.Username))
                                        {
                                            <span class="hr-meta" dir="ltr"> (@($"@{p.Username}"))</span>
                                        }
                                        <span class="hr-badge hr-num" dir="ltr" style="margin-inline-start:0.4rem;">@p.ChatId</span>
                                    </div>
                                    <div style="display:flex;gap:0.4rem;">
                                        <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="() => ApprovePendingChat(p)">
                                            تفعيل وموافقة
                                        </button>
                                        <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm" @onclick="() => botConfigDraft.PendingChats.Remove(p)">
                                            رفض
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Authorized Chats List -->
                <div class="hr-card" style="padding:var(--s-3);display:flex;flex-direction:column;gap:0.65rem;">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                        <h3 class="hr-eyebrow" style="margin:0;">المحادثات والمستخدمون المخولون (@botConfigDraft.AuthorizedChats.Count)</h3>
                        <div style="display:flex;gap:0.4rem;align-items:center;">
                            <input type="text"
                                   dir="ltr"
                                   class="hr-input hr-num"
                                   style="width:140px;height:2rem;font-size:0.8rem;"
                                   placeholder="Chat ID..."
                                   @bind="manualChatIdInput" />
                            <input type="text"
                                   class="hr-input"
                                   style="width:140px;height:2rem;font-size:0.8rem;"
                                   placeholder="الاسم / الوصف..."
                                   @bind="manualChatTitleInput" />
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="AddManualChatId">
                                إضافة
                            </button>
                        </div>
                    </div>

                    @if (botConfigDraft.AuthorizedChats.Count == 0)
                    {
                        <p class="hr-meta" style="margin:0;">
                            لا توجد محادثات مضافة بعد. افتح البوت في تيليجرام وأرسل <code>/start</code> أو أرسل الرمز السري <code>@botConfigDraft.AccessPin</code> ليتم التفعيل تلقائياً.
                        </p>
                    }
                    else
                    {
                        <div style="display:flex;flex-direction:column;gap:0.4rem;max-height:180px;overflow-y:auto;">
                            @foreach (var chat in botConfigDraft.AuthorizedChats.ToList())
                            {
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:0.45rem 0.7rem;background:var(--surface-sunken);border-radius:var(--r-md);font-size:0.84rem;">
                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                        <strong>@chat.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(chat.Username))
                                        {
                                            <span class="hr-meta" dir="ltr">@($"@{chat.Username}")</span>
                                        }
                                        <code style="font-size:0.75rem;opacity:0.75;" dir="ltr">@chat.ChatId</code>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:0.6rem;">
                                        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.76rem;cursor:pointer;">
                                            <input type="checkbox" @bind="chat.ReceiveDailyBroadcast" />
                                            <span>إشعار يومي</span>
                                        </label>
                                        <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm" style="padding:0.15rem 0.45rem;" @onclick="() => botConfigDraft.AuthorizedChats.Remove(chat)">
                                            حذف
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => showTelegramModal = false">
                    إغلاق
                </button>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveTelegramBotSettingsAsync" disabled="@isTestingBot">
                    <Icon Name="check" Size="xs" />
                    <span>حفظ وتطبيق إعدادات البوت</span>
                </button>
            </div>
        </div>
    </div>
}

