    // Every active filter is one removable control, so a reader can undo
    // exactly the one they meant instead of resetting the whole query.
    private sealed record ActiveFilter(string Key, string Value, Func<Task> Remove);

    private IEnumerable<ActiveFilter> ActiveFilters()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            yield return new ActiveFilter("بحث", searchTerm!, ClearSearch);
        }

        if (photoFilter != "all")
        {
            yield return new ActiveFilter(
                "حالة الصورة",
                photoFilter == "withPhoto" ? "لديهم صورة" : "بدون صورة",
                () => SetPhotoFilter("all"));
        }

        foreach (var formation in selectedFormations.ToList())
        {
            yield return new ActiveFilter("التشكيل", formation, () => RemoveFormation(formation));
        }

        foreach (var position in selectedPositions.ToList())
        {
            yield return new ActiveFilter("المنصب", position, () => RemovePosition(position));
        }

        foreach (var job in selectedJobTitles.ToList())
        {
            yield return new ActiveFilter("العنوان الوظيفي", job, () => RemoveJobTitle(job));
        }

        foreach (var edu in selectedEducations.ToList())
        {
            yield return new ActiveFilter("الشهادة", edu, () => RemoveEducation(edu));
        }

        foreach (var spec in selectedSpecializations.ToList())
        {
            yield return new ActiveFilter("الاختصاص", spec, () => RemoveSpecialization(spec));
        }

        foreach (var year in selectedHireYears.ToList())
        {
            yield return new ActiveFilter("سنة المباشرة", year, () => RemoveHireYear(year));
        }

        foreach (var year in selectedBirthYears.ToList())
        {
            yield return new ActiveFilter("سنة التولد", year, () => RemoveBirthYear(year));
        }

        foreach (var status in selectedStatuses.ToList())
        {
            yield return new ActiveFilter("الحالة", status, () => RemoveStatus(status));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        canManageLifecycle = user.IsInRole("Admin") || user.IsInRole("HRManager");
        currentUserName = user.Identity?.Name ?? "User";

        await LoadFilterOptions();
        await LoadEmployees();
    }

    // ---------- loading ----------

    private async Task LoadFilterOptions()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            statusOptions = await db.EmployeeStatuses.AsNoTracking()
                .Select(s => s.Name).Where(s => !string.IsNullOrEmpty(s))
                .Distinct().OrderBy(s => s).ToListAsync();

            formationOptions = await db.Formations.AsNoTracking()
                .Select(f => f.Name).Where(f => !string.IsNullOrEmpty(f))
                .Distinct().OrderBy(f => f).ToListAsync();

            positionOptions = await db.PositionTitles.AsNoTracking()
                .Select(p => p.Name).Where(p => !string.IsNullOrEmpty(p))
                .Distinct().OrderBy(p => p).ToListAsync();

            jobTitleOptions = await db.JobTitles.AsNoTracking()
                .Select(j => j.Name).Where(j => !string.IsNullOrEmpty(j))
                .Distinct().OrderBy(j => j).ToListAsync();

            educationOptions = await db.EducationLevels.AsNoTracking()
                .Select(e => e.Name).Where(e => !string.IsNullOrEmpty(e))
                .Distinct().OrderBy(e => e).ToListAsync();

            specializationOptions = await db.Specializations.AsNoTracking()
                .Select(s => s.Name).Where(s => !string.IsNullOrEmpty(s))
                .Distinct().OrderBy(s => s).ToListAsync();

            var hireYears = await db.Employees.AsNoTracking()
                .Where(e => e.HireDate != null)
                .Select(e => e.HireDate!.Value.Year)
                .Distinct().OrderByDescending(y => y).ToListAsync();
            hireYearOptions = hireYears.Select(y => y.ToString()).ToList();

            var birthYears = await db.Employees.AsNoTracking()
                .Where(e => e.BirthDate != null)
                .Select(e => e.BirthDate!.Value.Year)
                .Distinct().OrderByDescending(y => y).ToListAsync();
            birthYearOptions = birthYears.Select(y => y.ToString()).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load filter options.");
        }
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        loadFailed = false;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            withPhotoCount = await db.EmployeeProfilePhotos.AsNoTracking()
                .Where(p => p.IsActive).Select(p => p.EmployeeID).Distinct().CountAsync();

            archivedCount = await LifecycleService.GetArchivedCountAsync();
            grandTotal = await db.Employees.AsNoTracking().CountAsync();
            activeTotalCount = grandTotal;
            withoutPhotoCount = Math.Max(0, grandTotal - withPhotoCount);

            IQueryable<Employee> query = isArchivedView
                ? db.Employees.IgnoreQueryFilters().Where(e => e.IsArchived).AsNoTracking()
                : db.Employees.AsNoTracking();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                query = query.Where(e => e.EmployeeID.Contains(term) || e.Name.Contains(term));
            }

            if (selectedStatuses.Count > 0)
            {
                query = query.Where(e => e.EmployeeStatus != null && selectedStatuses.Contains(e.EmployeeStatus.Name));
            }

            if (selectedFormations.Count > 0)
            {
                query = query.Where(e => e.Formation != null && selectedFormations.Contains(e.Formation.Name));
            }

            if (selectedPositions.Count > 0)
            {
                query = query.Where(e => e.PositionTitle != null && selectedPositions.Contains(e.PositionTitle.Name));
            }

            if (selectedJobTitles.Count > 0)
            {
                query = query.Where(e => e.JobTitle != null && selectedJobTitles.Contains(e.JobTitle.Name));
            }

            if (selectedEducations.Count > 0)
            {
                query = query.Where(e => e.EducationLevel != null && selectedEducations.Contains(e.EducationLevel.Name));
            }

            if (selectedSpecializations.Count > 0)
            {
                query = query.Where(e => e.Specialization != null && selectedSpecializations.Contains(e.Specialization.Name));
            }

            if (selectedHireYears.Count > 0)
            {
                var years = selectedHireYears.Where(y => int.TryParse(y, out _)).Select(int.Parse).ToList();
                if (years.Count > 0)
                {
                    query = query.Where(e => e.HireDate != null && years.Contains(e.HireDate.Value.Year));
                }
            }

            if (selectedBirthYears.Count > 0)
            {
                var years = selectedBirthYears.Where(y => int.TryParse(y, out _)).Select(int.Parse).ToList();
                if (years.Count > 0)
                {
                    query = query.Where(e => e.BirthDate != null && years.Contains(e.BirthDate.Value.Year));
                }
            }

            if (photoFilter == "withPhoto")
            {
                query = query.Where(e => db.EmployeeProfilePhotos.Any(p => p.EmployeeID == e.EmployeeID && p.IsActive));
            }
            else if (photoFilter == "withoutPhoto")
            {
                query = query.Where(e => !db.EmployeeProfilePhotos.Any(p => p.EmployeeID == e.EmployeeID && p.IsActive));
            }

            totalCount = await query.CountAsync();
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            if (currentPage > totalPages) currentPage = 1;

            query = sortKey switch
            {
                "id" => sortDesc ? query.OrderByDescending(e => e.EmployeeID) : query.OrderBy(e => e.EmployeeID),
                "name" => sortDesc ? query.OrderByDescending(e => e.Name) : query.OrderBy(e => e.Name),
                "formation" => sortDesc 
                    ? query.OrderByDescending(e => e.Formation == null ? string.Empty : e.Formation.Name) 
                    : query.OrderBy(e => e.Formation == null ? string.Empty : e.Formation.Name),
                "position" => sortDesc 
                    ? query.OrderByDescending(e => e.PositionTitle != null ? e.PositionTitle.Name : (e.JobTitle != null ? e.JobTitle.Name : string.Empty)) 
                    : query.OrderBy(e => e.PositionTitle != null ? e.PositionTitle.Name : (e.JobTitle != null ? e.JobTitle.Name : string.Empty)),
                "job" => sortDesc
                    ? query.OrderByDescending(e => e.JobTitle == null ? string.Empty : e.JobTitle.Name)
                    : query.OrderBy(e => e.JobTitle == null ? string.Empty : e.JobTitle.Name),
                "hire" => sortDesc ? query.OrderByDescending(e => e.HireDate) : query.OrderBy(e => e.HireDate),
                "birth" => sortDesc ? query.OrderByDescending(e => e.BirthDate) : query.OrderBy(e => e.BirthDate),
                "education" => sortDesc 
                    ? query.OrderByDescending(e => e.EducationLevel == null ? string.Empty : e.EducationLevel.Name) 
                    : query.OrderBy(e => e.EducationLevel == null ? string.Empty : e.EducationLevel.Name),
                "specialization" => sortDesc 
                    ? query.OrderByDescending(e => e.Specialization == null ? string.Empty : e.Specialization.Name) 
                    : query.OrderBy(e => e.Specialization == null ? string.Empty : e.Specialization.Name),
                _ => sortDesc ? query.OrderByDescending(e => e.EmployeeID) : query.OrderBy(e => e.EmployeeID)
            };

            employees = await query
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .Select(e => new EmployeeResponse(
                    e.Formation == null ? string.Empty : e.Formation.Name,
                    e.EmployeeID,
                    e.Name,
                    e.JobTitle == null ? string.Empty : e.JobTitle.Name,
                    e.PositionTitle == null ? string.Empty : e.PositionTitle.Name,
                    e.Stage == null ? string.Empty : e.Stage.Name,
                    e.Grade == null ? string.Empty : e.Grade.Name,
                    e.EducationLevel == null ? string.Empty : e.EducationLevel.Name,
                    e.Specialization == null ? string.Empty : e.Specialization.Name,
                    e.LastJobTitleDate,
                    e.HireDate,
                    e.Gender == null ? string.Empty : e.Gender.Name,
                    e.Religion == null ? string.Empty : e.Religion.Name,
                    e.Nationality == null ? string.Empty : e.Nationality.Name,
                    e.FirstDepartment ?? string.Empty,
                    e.BirthDate,
                    e.EmployeeStatus == null ? string.Empty : e.EmployeeStatus.Name,
                    db.EmployeeProfilePhotos.Any(p => p.EmployeeID == e.EmployeeID && p.IsActive),
                    db.EmployeeProfilePhotos.Where(p => p.EmployeeID == e.EmployeeID && p.IsActive)
                        .Select(p => (int?)p.Version).FirstOrDefault(),
                    e.IsArchived,
                    e.ArchivedAt,
                    e.ArchiveReason,
                    e.ArchivedBy))
                .ToListAsync();

            BuildThumbnailUrls();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load employees list.");
            loadFailed = true;
            employees = [];
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

