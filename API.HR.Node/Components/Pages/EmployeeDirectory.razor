@code {
    // ---------- data ----------
    private List<EmployeeResponse> employees = [];
    // Thumbnail URL per employee on the current page; a failed load drops its
    // entry so the face falls back to initials.
    private readonly Dictionary<string, string> photoThumbnails = new();
    private List<string> statusOptions = [];
    private List<string> formationOptions = [];
    private List<string> jobTitleOptions = [];
    private List<string> positionOptions = [];
    private List<string> educationOptions = [];
    private List<string> specializationOptions = [];
    private List<string> hireYearOptions = [];
    private List<string> birthYearOptions = [];

    // ---------- query state ----------
    private string? searchTerm;
    private string photoFilter = "all";
    private HashSet<string> selectedStatuses = new();
    private HashSet<string> selectedFormations = new();
    private HashSet<string> selectedJobTitles = new();
    private HashSet<string> selectedPositions = new();
    private HashSet<string> selectedEducations = new();
    private HashSet<string> selectedSpecializations = new();
    private HashSet<string> selectedHireYears = new();
    private HashSet<string> selectedBirthYears = new();
    private string sortKey = "id";
    private bool sortDesc;
    private int currentPage = 1;
    private int pageSize = 12;

    // ---------- counts ----------
    private int totalCount;
    private int grandTotal;
    private int withPhotoCount;
    private int withoutPhotoCount;
    private int totalPages = 1;

    // ---------- lifecycle state ----------
