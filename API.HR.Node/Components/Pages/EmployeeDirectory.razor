    private async Task UploadPhoto(string employeeId, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        uploadingId = employeeId;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var wrapper = new FormFileWrapper(ms, file.Name, file.ContentType, file.Size);

            var result = await PhotoService.UploadOrReplacePhotoAsync(
                employeeId, wrapper, authState.User, "127.0.0.1", "BlazorClient");

            switch (result)
            {
                case PhotoServiceResult.Success<ProfilePhotoResponse>:
                    ShowToast($"تم حفظ الصورة الشخصية للموظف {employeeId}.", true);
                    await ReloadAfterPhotoChange(employeeId);
                    break;
                case PhotoServiceResult.ValidationError ve:
                    ShowToast($"الملف مرفوض: {ve.Message} — اختر صورة JPEG أو PNG أو WebP بحجم أقل من 10 ميغابايت.", false);
                    break;
                case PhotoServiceResult.NotFound nf:
                    ShowToast(nf.Message, false);
                    break;
                default:
                    ShowToast("تعذّر رفع الصورة. تأكد أن الملف صورة صالحة (JPEG أو PNG أو WebP).", false);
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading photo for employee {EmployeeID}", employeeId);
            ShowToast($"فشل رفع الصورة للموظف {employeeId}. حاول مرة أخرى.", false);
        }
        finally
        {
            uploadingId = null;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeletePhoto()
    {
        if (pendingDelete is null) return;

        var employeeId = pendingDelete.EmployeeID;
        isDeletingPhoto = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await PhotoService.DeletePhotoAsync(employeeId, authState.User, "127.0.0.1", "BlazorClient");

            if (result is PhotoServiceResult.Success<bool>)
            {
                ShowToast($"تم حذف الصورة الشخصية للموظف {employeeId}.", true);
                await ReloadAfterPhotoChange(employeeId);
            }
            else
            {
                ShowToast("تعذّر حذف الصورة. حدّث السجل ثم أعد المحاولة.", false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting photo for employee {EmployeeID}", employeeId);
            ShowToast("تعذّر حذف الصورة بسبب خطأ في النظام.", false);
        }
        finally
        {
            isDeletingPhoto = false;
            pendingDelete = null;
            StateHasChanged();
        }
    }

    private async Task ReloadAfterPhotoChange(string employeeId)
    {
        var openRow = expandedId;
        var openRecordId = recordEmployee?.EmployeeID;

        await LoadEmployees();

        expandedId = openRow;

        // An open dialog has to follow the record it was showing, or it
        // keeps reporting a photo state that no longer exists.
        if (openRecordId is not null)
        {
            var refreshed = employees.FirstOrDefault(x => x.EmployeeID == openRecordId);

            if (refreshed is null)
            {
                CloseRecord();
            }
            else
            {
                OpenRecord(refreshed);
            }
        }
    }

    // ---------- toast ----------

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastIsSuccess = success;

        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(6000, token);
                if (token.IsCancellationRequested) return;

                toastMessage = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { /* replaced by a newer toast */ }
            catch (ObjectDisposedException) { /* circuit gone */ }
        });

        StateHasChanged();
    }

    private void DismissToast()
    {
        toastCts?.Cancel();
        toastMessage = null;
    }

    // ---------- formatting helpers ----------

    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Or(string? value, string fallback = "—") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string D(DateOnly? date) => date?.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture) ?? "—";

    private static string Pct(double value) =>
        Math.Clamp(value, 0, 100).ToString("F2", CultureInfo.InvariantCulture) + "%";

    private static string? ServiceLength(DateOnly? hireDate)
    {
        if (!hireDate.HasValue) return null;

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (hireDate.Value > today) return null;

        var years = today.Year - hireDate.Value.Year;
        if (today.Month < hireDate.Value.Month ||
            (today.Month == hireDate.Value.Month && today.Day < hireDate.Value.Day))
        {
            years--;
        }

        return years <= 0 ? "أقل من سنة" : $"{years.ToString(CultureInfo.InvariantCulture)} سنة";
    }

    private static string? DetailedAge(DateOnly? birthDate)
    {
        if (!birthDate.HasValue) return null;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var birth = birthDate.Value;
        if (birth > today) return null;

        var years = today.Year - birth.Year;
        var months = today.Month - birth.Month;
        var days = today.Day - birth.Day;

        if (days < 0)
        {
            months--;
            var prev = today.AddMonths(-1);
            days += DateTime.DaysInMonth(prev.Year, prev.Month);
        }

        if (months < 0)
        {
            years--;
            months += 12;
        }

        var parts = new List<string>();
        if (years > 0) parts.Add($"{years.ToString(CultureInfo.InvariantCulture)} سنة");
        if (months > 0) parts.Add($"{months.ToString(CultureInfo.InvariantCulture)} شهر");
        if (days > 0 || parts.Count == 0) parts.Add($"{days.ToString(CultureInfo.InvariantCulture)} يوم");

        return string.Join(" و ", parts);
    }

    // Deterministic across restarts: string.GetHashCode is randomized per
    // process, which would repaint every placeholder on each app start.
    // Tones are steps on the brand ramp — enough separation to tell two
    // adjacent placeholders apart, without introducing hues the rest of
    // the system never uses.
    private static string AvatarTone(string? employeeId)
    {
        var tones = new[] { "var(--b-800)", "var(--b-700)", "var(--b-600)", "var(--b-500)" };

        var sum = 0;
        foreach (var ch in employeeId ?? string.Empty)
        {
            sum = (sum * 31 + ch) & 0x7fffffff;
        }

        return tones[sum % tones.Length];
    }

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    private sealed class FormFileWrapper(Stream stream, string fileName, string contentType, long length) : IFormFile
    {
        public string ContentType => contentType;
        public string ContentDisposition => $"inline; filename=\"{fileName}\"";
        public IHeaderDictionary Headers => new HeaderDictionary();
        public long Length => length;
        public string Name => "file";
        public string FileName => fileName;
        public Stream OpenReadStream() => stream;
        public void CopyTo(Stream target) => stream.CopyTo(target);
        public Task CopyToAsync(Stream target, CancellationToken cancellationToken = default) => stream.CopyToAsync(target, cancellationToken);
    }
