    private Dictionary<string, List<EmployeeVehicle>> employeeVehiclesMap = new();
    private bool isLoadingVehicles = false;

    private async Task ToggleDetail(string employeeId)
    {
        if (expandedId == employeeId)
        {
            expandedId = null;
            return;
        }

        expandedId = employeeId;
        if (!employeeVehiclesMap.ContainsKey(employeeId))
        {
            isLoadingVehicles = true;
            try
            {
                var vList = await VehicleService.GetVehiclesByEmployeeCodeAsync(employeeId);
                employeeVehiclesMap[employeeId] = vList;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load vehicles for employee {EmployeeId}", employeeId);
                employeeVehiclesMap[employeeId] = [];
            }
            finally
            {
                isLoadingVehicles = false;
            }
        }
    }

