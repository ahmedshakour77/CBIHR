    private async Task SortBy(string key)
    {
        if (sortKey == key)
        {
            sortDesc = !sortDesc;
        }
        else
        {
            sortKey = key;
            sortDesc = false;
        }

        expandedId = null;
        await LoadEmployees();
    }

    private string AriaSort(string key) => sortKey != key ? "none" : sortDesc ? "descending" : "ascending";

    // A header that offers more than one sort still describes a single column,
    // so aria-sort reports whichever of its keys is the active one.
    private string AriaSortAny(params string[] keys) =>
        keys.Contains(sortKey) ? (sortDesc ? "descending" : "ascending") : "none";

    // aria-sort belongs to the column, so with two controls under one header it
    // cannot say which of them is doing the ordering. Each control carries its
    // own state in its accessible name instead, which is what a screen reader
    // reads when it lands on the button.
    private string SortStateLabel(string key) =>
        sortKey != key ? string.Empty
            : sortDesc ? " — مرتّب تنازلياً"
            : " — مرتّب تصاعدياً";

