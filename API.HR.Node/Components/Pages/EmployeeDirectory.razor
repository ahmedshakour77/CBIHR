    // Faces load from the photo endpoint, not through the circuit. The version
    // in the URL changes when a photo is replaced, so the image swaps; the
    // browser's ETag revalidation makes paging back to a seen page cost 304s.
    private void BuildThumbnailUrls()
    {
        photoThumbnails.Clear();

        foreach (var emp in employees.Where(e => e.HasProfilePhoto))
        {
            photoThumbnails[emp.EmployeeID] = ProfilePhotoUrls.Thumbnail(emp.EmployeeID, emp.ProfilePhotoVersion);
        }
    }

