@page "/employees"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using API.HR.Node.Services.ProfilePhotos
@using API.HR.Node.Services.Employees
@using API.HR.Node.Data
@attribute [Authorize(Roles = "Admin,HRManager,FormationManager,Supervisor")]

@inject IServiceScopeFactory ScopeFactory
@inject IEmployeeProfilePhotoService PhotoService
@inject IEmployeeLifecycleService LifecycleService
@inject IEmployeeVehicleService VehicleService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<EmployeeDirectory> Logger

<PageTitle>سجلات ودليل الموظفين | الموظف ٣٦٠°   </PageTitle>

@*
    Employee directory.

    The dense counterpart to the Employees page: one sortable grid that
    opens a row into the full record in place, rather than sending the
    reader out to a dialog and back for every person.

    Rebuilt on the hr-* vocabulary that every other page already speaks.
    What that migration settled, beyond the paint:

      · The photo-status legend used to sit in the masthead and quietly
        act as a filter. It now sits with the other filters, under its
        own legend, and the masthead carries statistics only.
      · Single-sort headers are announced by aria-sort alone; .hr-th-sort
        draws its arrow from that attribute, so the seen state and the
        announced state cannot drift apart.
      · The identity column is the one header that orders by two fields,
        because it shows two: the name and the job title. aria-sort still
        reports the column's active direction, but it cannot say which of
        the two controls is the one ordering — so each control also states
        its own direction in its accessible name, and .hr-th-dual draws
        each arrow from that control's own state rather than the column's.
        Both channels come from sortKey, so neither can drift.
      · The hand-rolled sheet and lightbox are one shared Modal, so the
        escape routes (button, scrim, Escape, focus return) are the ones
        the rest of the system offers rather than a local approximation.
      · Deleting a photo goes through the shared ConfirmDialog instead of
        swapping the row's actions for an inline "sure?" strip.
      · Search and every filter carry a visible label; the placeholder is
        an example, not the label.
*@

@{
    // ---- shared fragments (declared before first use) ----

    RenderFragment<EmployeeResponse> Face = emp =>
    @<text>
        @if (emp.HasProfilePhoto && photoThumbnails.TryGetValue(emp.EmployeeID, out var thumb))
        {
            <button type="button" class="hr-avatar hr-avatar-btn"
                    @onclick="() => OpenRecord(emp)"
                    aria-label="@($"فتح سجل {emp.Name}")">
                <img src="@thumb" alt="@($"الصورة الشخصية للموظف {emp.Name}")" loading="lazy" decoding="async"
                     @onerror="() => photoThumbnails.Remove(emp.EmployeeID)" />
            </button>
        }
        else
        {
            <span class="hr-avatar" style="background:@AvatarTone(emp.EmployeeID);color:#fff" aria-hidden="true">
                @AvatarInitials.FromName(emp.Name)
            </span>
        }
    </text>;

    RenderFragment<EmployeeResponse> UploadControl = emp =>
    @<label class="hr-btn hr-btn-secondary hr-btn-sm hr-uploadlabel">
        @if (uploadingId == emp.EmployeeID)
        {
            <span class="hr-spinner" aria-hidden="true"></span>
            <span>جارٍ الرفع…</span>
        }
        else
        {
            <Icon Name="arrow-up-tray" Size="xs" />
            <span>@(emp.HasProfilePhoto ? "تغيير" : "رفع")</span>
        }
        <span class="hr-sr">صورة الموظف @emp.Name</span>
        <InputFile accept=".jpg,.jpeg,.png,.webp"
                   disabled="@(uploadingId is not null)"
                   OnChange="@(e => UploadPhoto(emp.EmployeeID, e))" />
    </label>;

    RenderFragment<EmployeeResponse> PhotoBadge = emp =>
    @<text>
        @if (emp.HasProfilePhoto)
        {
            <span class="hr-badge hr-badge-ok">
                <Icon Name="check-circle" Size="xs" />
                <span>موثّقة</span>
                <span class="hr-num">v@(emp.ProfilePhotoVersion ?? 1)</span>
            </span>
        }
        else
        {
            <span class="hr-badge hr-badge-warn">
                <Icon Name="exclamation-triangle" Size="xs" />
                <span>بدون صورة</span>
            </span>
        }
    </text>;

    RenderFragment<EmployeeResponse> RecordFields = emp =>
    @<dl class="hr-deflist">
        <div class="hr-deflist-row">
            <dt>العنوان الوظيفي</dt>
            <dd>@Or(emp.JobTitle)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>المنصب</dt>
            <dd>@Or(emp.PositionTitle)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>التشكيل الإداري</dt>
            <dd>@Or(emp.Formation)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>القسم الأول</dt>
            <dd>@Or(emp.FirstDepartment)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الدرجة والمرحلة</dt>
            <dd>
                <span class="hr-badge">@Or(emp.Grade)</span>
                <span class="hr-badge">@Or(emp.Stage)</span>
            </dd>
        </div>
        <div class="hr-deflist-row">
            <dt>التحصيل الدراسي</dt>
            <dd>@Or(emp.EducationLevel)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الاختصاص</dt>
            <dd>@Or(emp.Specialization)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>تاريخ التعيين</dt>
            <dd>
                <span class="hr-num">@D(emp.HireDate)</span>
                @if (ServiceLength(emp.HireDate) is string svc)
                {
                    <span class="hr-meta">@svc في الخدمة</span>
                }
            </dd>
        </div>
        <div class="hr-deflist-row">
            <dt>تاريخ آخر عنوان وظيفي</dt>
            <dd class="hr-num">@D(emp.LastJobTitleDate)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>تاريخ الميلاد</dt>
            <dd>
                <span class="hr-num">@D(emp.BirthDate)</span>
                @if (DetailedAge(emp.BirthDate) is string age)
                {
                    <span class="hr-meta">@age</span>
                }
            </dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الجنس</dt>
            <dd>@Or(emp.Gender)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الجنسية</dt>
            <dd>@Or(emp.Nationality)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الديانة</dt>
            <dd>@Or(emp.Religion)</dd>
        </div>
        <div class="hr-deflist-row">
            <dt>الحالة الوظيفية</dt>
            <dd>@Or(emp.EmployeeStatus, "مستمر")</dd>
        </div>
    </dl>;
}

<div class="hr-stack">

    @* ---------- masthead ---------- *@
    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <span class="hr-eyebrow">مساحة العمل</span>
            <h1 class="hr-h1">دليل وسجلات الموظفين</h1>
            <p class="hr-sub hr-measure" style="margin-block-start:.5rem">
                سجل الموظفين وصورهم الشخصية: بحث وفرز متقدم، استعراض السجل الكامل موضعياً، وإدارة وتوثيق الصور من مكانها.
            </p>
        </div>

        <div class="hr-pagehead-actions">
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => LoadEmployees()" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="hr-spinner" aria-hidden="true"></span>
                    <span>جارٍ التحديث…</span>
                }
                else
                {
                    <Icon Name="arrow-path" Size="sm" />
                    <span>تحديث</span>
                }
            </button>
            <a href="data-import" class="hr-btn hr-btn-secondary" title="استيراد وتحديث الموظفين من ملف Excel">
                <Icon Name="arrow-up-tray" Size="sm" />
                <span>استيراد ملف Excel</span>
            </a>
        </div>
    </header>

    @* ---------- coverage ---------- *@
    <div class="hr-grid-kpi">
        <div class="hr-card hr-stat hr-stat-a">
            <div class="hr-stat-label">
                <span>إجمالي الموظفين</span>
                <span class="hr-iconplate hr-plate-a" aria-hidden="true"><Icon Name="users" Size="sm" /></span>
            </div>
            <strong class="hr-stat-figure">@N(grandTotal)</strong>
            <p class="hr-stat-foot">سجل في قاعدة البيانات</p>
        </div>

        <div class="hr-card hr-stat hr-stat-ok">
            <div class="hr-stat-label">
                <span>لديهم صورة</span>
                <span class="hr-iconplate hr-iconplate-ok" aria-hidden="true"><Icon Name="camera" Size="sm" /></span>
            </div>
            <strong class="hr-stat-figure">@N(withPhotoCount)</strong>
            <div class="hr-meter" style="margin-block-start:.75rem"
                 role="progressbar" aria-label="نسبة الموظفين الذين لديهم صورة شخصية"
                 aria-valuenow="@((int)CoveragePct)" aria-valuemin="0" aria-valuemax="100">
                <div class="hr-meter-fill is-ok" style="width:@Pct(CoveragePct)"></div>
            </div>
            <p class="hr-stat-foot">من إجمالي السجلات</p>
        </div>

        <div class="hr-card hr-stat hr-stat-warn">
            <div class="hr-stat-label">
                <span>بدون صورة</span>
                <span class="hr-iconplate hr-iconplate-warn" aria-hidden="true"><Icon Name="user-minus" Size="sm" /></span>
            </div>
            <strong class="hr-stat-figure">@N(withoutPhotoCount)</strong>
            <p class="hr-stat-foot">بحاجة إلى توثيق</p>
        </div>

        <div class="hr-card hr-stat hr-stat-d">
            <div class="hr-stat-label">
                <span>نسبة الاكتمال</span>
                <span class="hr-iconplate hr-plate-d" aria-hidden="true"><Icon Name="chart-pie" Size="sm" /></span>
            </div>
            <strong class="hr-stat-figure">@CoveragePct.ToString("F1")<span class="hr-stat-unit">%</span></strong>
            <p class="hr-stat-foot">من ملفات الموظفين موثّقة بصورة</p>
        </div>
    </div>

    @* ---------- filters ---------- *@
    <section class="hr-card">
        <div class="hr-filterbar">
            @* الصف الأول: البحث العام والتنظيم الإداري (مطابق لعمود الموظف وعمود التشكيل والمنصب) *@
            <div class="hr-filterbar-row">
                <div class="hr-field hr-filter-grow">
                    <label class="hr-field-label" for="dir-search">بحث</label>
                    <div class="hr-search">
                        <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="sm" /></span>
                        <input id="dir-search" type="search" class="hr-input"
                               placeholder=" يطابق الاسم أو الرقم الوظيفي."
                               aria-describedby="dir-search-help"
                               value="@searchTerm" @oninput="OnSearchInput" />
                    </div>
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">التشكيل الإداري</span>
                    <MultiSelectDropdown Title="@FormationFilterTitle" Placeholder="ابحث عن تشكيل…" Icon="building-office-2"
                                         Options="@formationOptions" @bind-SelectedValues="selectedFormations"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">المنصب</span>
                    <MultiSelectDropdown Title="@PositionFilterTitle" Placeholder="ابحث عن منصب…" Icon="identification"
                                         Options="@positionOptions" @bind-SelectedValues="selectedPositions"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">العنوان الوظيفي</span>
                    <MultiSelectDropdown Title="@JobTitleFilterTitle" Placeholder="ابحث عن عنوان وظيفي…" Icon="briefcase"
                                         Options="@jobTitleOptions" @bind-SelectedValues="selectedJobTitles"
                                         OnChange="OnFilterChanged" />
                </div>
            </div>

            @* الصف الثاني: فلاتر المؤهلات والتواريخ والحالة (مطابق لعمود الاختصاص والشهادة، المباشرة، التولد) *@
            <div class="hr-filterbar-row">
                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">الشهادة العلمية</span>
                    <MultiSelectDropdown Title="@EducationFilterTitle" Placeholder="ابحث عن شهادة…" Icon="academic-cap"
                                         Options="@educationOptions" @bind-SelectedValues="selectedEducations"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">الاختصاص</span>
                    <MultiSelectDropdown Title="@SpecializationFilterTitle" Placeholder="ابحث عن اختصاص…" Icon="document-text"
                                         Options="@specializationOptions" @bind-SelectedValues="selectedSpecializations"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">سنة المباشرة</span>
                    <MultiSelectDropdown Title="@HireYearFilterTitle" Placeholder="ابحث عن سنة مباشرة…" Icon="clock"
                                         Options="@hireYearOptions" @bind-SelectedValues="selectedHireYears"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">سنة التولد</span>
                    <MultiSelectDropdown Title="@BirthYearFilterTitle" Placeholder="ابحث عن سنة تولد…" Icon="calendar-days"
                                         Options="@birthYearOptions" @bind-SelectedValues="selectedBirthYears"
                                         OnChange="OnFilterChanged" />
                </div>

                <div class="hr-field hr-filter-item">
                    <span class="hr-field-label">الحالة الوظيفية</span>
                    <MultiSelectDropdown Title="@StatusFilterTitle" Placeholder="ابحث عن حالة…" Icon="signal"
                                         Options="@statusOptions" @bind-SelectedValues="selectedStatuses"
                                         OnChange="OnFilterChanged" />
                </div>
            </div>

            @* الصف الثالث: حالة الصورة ومسح عوامل التصفية *@
            <div class="hr-filterbar-row">
                <fieldset class="hr-fieldset hr-filter-grow">
                    <legend class="hr-field-label">حالة الصورة الشخصية</legend>
                    <div class="hr-chips">
                        <button type="button" class="hr-chip" aria-pressed="@((photoFilter == "all") ? "true" : "false")"
                                @onclick='() => SetPhotoFilter("all")'>
                            <span class="hr-dot hr-dot-quiet" aria-hidden="true"></span>
                            <span>الكل</span>
                            <span class="hr-num">@N(grandTotal)</span>
                        </button>
                        <button type="button" class="hr-chip" aria-pressed="@((photoFilter == "withPhoto") ? "true" : "false")"
                                @onclick='() => SetPhotoFilter("withPhoto")'>
                            <span class="hr-dot hr-dot-ok" aria-hidden="true"></span>
                            <span>لديهم صورة</span>
                            <span class="hr-num">@N(withPhotoCount)</span>
                        </button>
                        <button type="button" class="hr-chip" aria-pressed="@((photoFilter == "withoutPhoto") ? "true" : "false")"
                                @onclick='() => SetPhotoFilter("withoutPhoto")'>
                            <span class="hr-dot hr-dot-warn" aria-hidden="true"></span>
                            <span>بدون صورة</span>
                            <span class="hr-num">@N(withoutPhotoCount)</span>
                        </button>
                    </div>
                </fieldset>

                <div class="hr-field hr-filter-item hr-filter-reset">
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-block"
                            @onclick="ResetFilters" disabled="@(ActiveFilterCount == 0)">
                        <Icon Name="x-mark" Size="sm" />
                        <span>مسح عوامل التصفية @(ActiveFilterCount > 0 ? $"({ActiveFilterCount})" : "")</span>
                    </button>
                </div>
            </div>

            @if (ActiveFilterCount > 0)
            {
                <div class="hr-filterbar-row" style="align-items:center">
                    <span class="hr-meta">عوامل التصفية النشطة</span>
                    <div class="hr-chips">
                        @foreach (var filter in ActiveFilters())
                        {
                            <button type="button" class="hr-chip"
                                    @onclick="@(() => filter.Remove())"
                                    aria-label="@($"إزالة عامل التصفية {filter.Key}: {filter.Value}")">
                                <span class="hr-meta">@filter.Key</span>
                                <span class="hr-truncate">@filter.Value</span>
                                <Icon Name="x-mark" Size="xs" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    @* ---------- records ---------- *@
    <section class="hr-card">
        <div class="hr-card-head hr-recordhead">
            <div>
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
                    <h2 class="hr-h2">السجلات</h2>
                    <div class="hr-segment" role="group" aria-label="عرض السجلات">
                        <button type="button" class="hr-segment-btn" aria-pressed="@((!isArchivedView) ? "true" : "false")"
                                @onclick="() => SwitchDirectoryView(false)">
                            <Icon Name="users" Size="xs" />
                            <span>السجلات النشطة (@N(grandTotal))</span>
                        </button>
                        <button type="button" class="hr-segment-btn" aria-pressed="@(isArchivedView ? "true" : "false")"
                                @onclick="() => SwitchDirectoryView(true)">
                            <Icon Name="archive-box" Size="xs" />
                            <span>الأرشيف / المستبعدون (@N(archivedCount))</span>
                        </button>
                    </div>
                </div>
                <p class="hr-meta" style="margin-block-start:.25rem" aria-live="polite">
                    <span class="hr-num">@N(employees.Count)</span> معروضاً من
                    <span class="hr-num">@N(totalCount)</span> نتيجة
                    @(isArchivedView ? "في الأرشيف" : "نشطة")
                </p>
            </div>

            <div class="hr-recordhead-controls">
                <div class="hr-segment" role="group" aria-label="نمط العرض">
                    <button type="button" class="hr-segment-btn" aria-pressed="@((viewMode == "table") ? "true" : "false")"
                            @onclick='() => SetView("table")'>
                        <Icon Name="table-cells" Size="sm" />
                        <span>جدول</span>
                    </button>
                    <button type="button" class="hr-segment-btn" aria-pressed="@((viewMode == "cards") ? "true" : "false")"
                            @onclick='() => SetView("cards")'>
                        <Icon Name="squares-2x2" Size="sm" />
                        <span>كروت</span>
                    </button>
                </div>

                <div class="hr-inlinefield">
                    <label class="hr-meta" for="dir-pagesize">لكل صفحة</label>
                    <select id="dir-pagesize" class="hr-select hr-select-compact" value="@pageSize" @onchange="OnPageSizeChanged">
                        <option value="12">12</option>
                        <option value="24">24</option>
                        <option value="48">48</option>
                        <option value="96">96</option>
                    </select>
                </div>
            </div>
        </div>

        @if (loadFailed)
        {
            <div class="hr-empty">
                <span class="hr-empty-art hr-empty-art-danger" aria-hidden="true"><Icon Name="exclamation-triangle" Size="lg" /></span>
                <p class="hr-h3">تعذّر تحميل السجلات</p>
                <p class="hr-sub hr-measure-sm">لم يستجب مصدر البيانات. تحقّق من الاتصال بقاعدة البيانات ثم أعد المحاولة.</p>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="() => LoadEmployees()">
                    <Icon Name="arrow-path" Size="xs" />
                    <span>إعادة المحاولة</span>
                </button>
            </div>
        }
        else if (isLoading)
        {
            <div class="hr-card-body">
                @if (viewMode == "cards")
                {
                    @* Same wrapper, same grid classes and the same count of
                       placeholders as the loaded state, so the columns do not
                       change when the data arrives. *@
                    <div class="hr-cardsview">
                        <div class="hr-grid-cards hr-grid-cards-quad">
                            @for (var i = 0; i < 8; i++)
                            {
                                <div class="hr-skeleton" style="height:22rem;border-radius:var(--r-lg)" aria-hidden="true"></div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="hr-stack-sm">
                        @for (var i = 0; i < 8; i++)
                        {
                            <div class="hr-skeleton" style="height:3.25rem;border-radius:var(--r)" aria-hidden="true"></div>
                        }
                    </div>
                }
                <p class="hr-sr">جارٍ تحميل سجلات الموظفين…</p>
            </div>
        }
        else if (employees.Count == 0)
        {
            <div class="hr-empty">
                <span class="hr-empty-art" aria-hidden="true"><Icon Name="magnifying-glass" Size="lg" /></span>
                <p class="hr-h3">@(ActiveFilterCount > 0 ? "لا سجل يطابق هذه المعايير" : "لا توجد سجلات موظفين بعد")</p>
                <p class="hr-sub hr-measure-sm">
                    @(ActiveFilterCount > 0
                        ? "البحث وعوامل التصفية النشطة أعلاه لم تُرجع أي موظف. أزل أحد العوامل أو وسّع عبارة البحث."
                        : "بعد استيراد الموظفين ستظهر سجلاتهم هنا، ومعها حالة الصورة الشخصية لكل ملف.")
                </p>
                @if (ActiveFilterCount > 0)
                {
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ResetFilters">
                        <Icon Name="x-mark" Size="xs" />
                        <span>مسح عوامل التصفية</span>
                    </button>
                }
            </div>
        }
        else if (viewMode == "table")
        {
            <div class="hr-tablewrap">
                <table class="hr-table hr-table-wide">
                    <caption class="hr-sr">
                        سجلات الموظفين وحالة صورهم الشخصية، مرتّبة حسب @SortLabel @(sortDesc ? "تنازلياً" : "تصاعدياً").
                    </caption>
                    <thead>
                        <tr>
                            @* 1. الصورة والاسم والرقم الوظيفي في خلية واحدة *@
                            <th scope="col" class="hr-th-dual" aria-sort="@AriaSortAny("name", "id")">
                                <span class="hr-th-label">الموظف والرقم الوظيفي</span>
                                <span class="hr-th-sorts">
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("name")"
                                            @onclick='() => SortBy("name")'>
                                        الاسم<span class="hr-sr">@SortStateLabel("name")</span>
                                    </button>
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("id")"
                                            @onclick='() => SortBy("id")'>
                                        الرقم<span class="hr-sr">@SortStateLabel("id")</span>
                                    </button>
                                </span>
                            </th>

                            @* 2. التشكيل والمنصب بنفس الخلية *@
                            <th scope="col" class="hr-th-dual" aria-sort="@AriaSortAny("formation", "position")">
                                <span class="hr-th-label">التشكيل والمنصب</span>
                                <span class="hr-th-sorts">
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("formation")"
                                            @onclick='() => SortBy("formation")'>
                                        التشكيل<span class="hr-sr">@SortStateLabel("formation")</span>
                                    </button>
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("position")"
                                            @onclick='() => SortBy("position")'>
                                        المنصب<span class="hr-sr">@SortStateLabel("position")</span>
                                    </button>
                                </span>
                            </th>

                            @* 3. المباشرة / الاستبعاد *@
                            @if (isArchivedView)
                            {
                                <th scope="col">
                                    <span class="hr-th-label">تاريخ وسبب الاستبعاد</span>
                                </th>
                            }
                            else
                            {
                                <th scope="col" aria-sort="@AriaSort("hire")">
                                    <span class="hr-th-label">المباشرة والخدمة</span>
                                    <span class="hr-th-sorts">
                                        <button type="button" class="hr-th-sort" @onclick='() => SortBy("hire")'>
                                            المباشرة<span class="hr-sr">@SortStateLabel("hire")</span>
                                        </button>
                                    </span>
                                </th>
                            }

                            @* 4. التولد *@
                            <th scope="col" aria-sort="@AriaSort("birth")">
                                <span class="hr-th-label">التولد والعمر</span>
                                <span class="hr-th-sorts">
                                    <button type="button" class="hr-th-sort" @onclick='() => SortBy("birth")'>
                                        التولد<span class="hr-sr">@SortStateLabel("birth")</span>
                                    </button>
                                </span>
                            </th>

                            @* 5. الاختصاص والشهادة *@
                            <th scope="col" class="hr-th-dual" aria-sort="@AriaSortAny("specialization", "education")">
                                <span class="hr-th-label">الاختصاص والشهادة</span>
                                <span class="hr-th-sorts">
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("specialization")"
                                            @onclick='() => SortBy("specialization")'>
                                        الاختصاص<span class="hr-sr">@SortStateLabel("specialization")</span>
                                    </button>
                                    <button type="button" class="hr-th-sort"
                                            data-sort-state="@AriaSort("education")"
                                            @onclick='() => SortBy("education")'>
                                        الشهادة<span class="hr-sr">@SortStateLabel("education")</span>
                                    </button>
                                </span>
                            </th>

                            @* 6. الإجراءات *@
                            <th scope="col"><span class="hr-sr">إجراءات السجل</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in employees)
                        {
                            var isOpen = expandedId == emp.EmployeeID;
                            var detailId = $"dir-detail-{emp.EmployeeID}";

                            <tr @key="emp.EmployeeID" data-selected="@(isOpen ? "true" : null)">
                                @* 1. خلية الصورة والاسم والرقم الوظيفي *@
                                <td>
                                    <div class="hr-identity">
                                        @Face(emp)
                                        <div class="hr-identity-text">
                                            <a href="employees/@emp.EmployeeID"
                                               class="hr-link hr-cell-strong hr-truncate"
                                               title="عرض الملف الإلكتروني">@emp.Name</a>
                                            <div style="display:inline-flex;align-items:center;gap:0.375rem;margin-top:2px;">
                                                <span class="hr-num hr-badge" style="font-size:var(--fs-caption);padding:0.05rem 0.4rem;font-weight:600;" title="الرقم الوظيفي">
                                                    @emp.EmployeeID
                                                </span>
                                               
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                @* 2. خلية التشكيل والمنصب *@
                                <td>
                                    <span class="hr-cell-strong hr-truncate hr-cell-wide" title="@emp.Formation">@Or(emp.Formation)</span>
                                    <span class="hr-cell-sub hr-truncate hr-cell-wide" title="@(string.IsNullOrEmpty(emp.PositionTitle) ? emp.JobTitle : emp.PositionTitle)">
                                        @Or(string.IsNullOrEmpty(emp.PositionTitle) ? emp.JobTitle : emp.PositionTitle)
                                    </span>
                                </td>

                                @* 3. خلية المباشرة أو الاستبعاد *@
                                <td>
                                    @if (isArchivedView)
                                    {
                                        <span class="hr-badge hr-badge-warn" style="font-weight:600">@Or(emp.ArchiveReason, "استبعاد مؤقت")</span>
                                        <span class="hr-cell-sub">
                                            @(emp.ArchivedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "—")
                                            @if (!string.IsNullOrEmpty(emp.ArchivedBy)) { <span>· @emp.ArchivedBy</span> }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hr-num">@D(emp.HireDate)</span>
                                        @if (ServiceLength(emp.HireDate) is string svc)
                                        {
                                            <span class="hr-cell-sub">@svc في الخدمة</span>
                                        }
                                    }
                                </td>

                                @* 4. خلية التولد *@
                                <td>
                                    <span class="hr-num">@D(emp.BirthDate)</span>
                                    @if (DetailedAge(emp.BirthDate) is string age)
                                    {
                                        <span class="hr-cell-sub" title="@age">@age</span>
                                    }
                                </td>

                                @* 5. خلية الاختصاص والشهادة *@
                                <td>
                                    <span class="hr-cell-strong hr-truncate" title="@emp.Specialization">@Or(emp.Specialization)</span>
                                    <span class="hr-cell-sub hr-truncate" title="@emp.EducationLevel">@Or(emp.EducationLevel)</span>
                                </td>

                                @* 6. خلية إجراءات السجل *@
                                <td>
                                    <div class="hr-rowactions">
                                        <a class="hr-btn hr-btn-primary hr-btn-sm hr-btn-icon"
                                           href="employees/@emp.EmployeeID"
                                           aria-label="@($"الملف الإلكتروني للموظف {emp.Name}")"
                                           title="الملف الإلكتروني الشامل">
                                            <Icon Name="user-circle" Size="xs" />
                                        </a>

                                        @if (isArchivedView)
                                        {
                                            @if (canManageLifecycle)
                                            {
                                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                                                        @onclick="() => PromptRestore(emp)"
                                                        title="استرجاع إلى النظام والتقارير"
                                                        aria-label="@($"استرجاع {emp.Name} إلى النظام والتقارير")">
                                                    <Icon Name="arrow-uturn-left" Size="xs" />
                                                    <span>استرجاع</span>
                                                </button>

                                                <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => PromptHardDelete(emp)"
                                                        title="حذف نهائي لا رجعة فيه"
                                                        aria-label="@($"حذف نهائي للموظف {emp.Name}")">
                                                    <Icon Name="trash" Size="xs" />
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <a class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                               href="employee-contacts/@emp.EmployeeID"
                                               aria-label="@($"وسائل التواصل للموظف {emp.Name}")"
                                               title="وسائل التواصل">
                                                <Icon Name="phone" Size="xs" />
                                            </a>

                                            <a class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                               href="employee-vehicles/@emp.EmployeeID"
                                               aria-label="@($"مركبات وتصاريح دخول الموظف {emp.Name}")"
                                               title="مركبات وتصاريح دخول الموظف">
                                                <Icon Name="truck" Size="xs" />
                                            </a>

                                            @UploadControl(emp)

                                            @if (emp.HasProfilePhoto)
                                            {
                                                <span class="hr-rowactions-sep" aria-hidden="true"></span>
                                                <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => pendingDelete = emp"
                                                        aria-label="@($"حذف صورة {emp.Name}")" title="حذف الصورة">
                                                    <Icon Name="trash" Size="xs" />
                                                </button>
                                            }

                                            @if (canManageLifecycle)
                                            {
                                                <span class="hr-rowactions-sep" aria-hidden="true"></span>
                                                <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => PromptArchive(emp)"
                                                        title="استبعاد مؤقت من النظام والتقارير"
                                                        aria-label="@($"استبعاد مؤقت للموظف {emp.Name}")">
                                                    <Icon Name="archive-box" Size="xs" />
                                                </button>

                                                <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm hr-btn-icon"
                                                        @onclick="() => PromptHardDelete(emp)"
                                                        title="حذف نهائي لا رجعة فيه"
                                                        aria-label="@($"حذف نهائي للموظف {emp.Name}")">
                                                    <Icon Name="trash" Size="xs" />
                                                </button>
                                            }

                                            <span class="hr-rowactions-sep" aria-hidden="true"></span>

                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                    aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@detailId"
                                                    @onclick="() => ToggleDetail(emp.EmployeeID)"
                                                    aria-label="@($"{(isOpen ? "طيّ" : "عرض")} تفاصيل سجل {emp.Name}")"
                                                    title="@(isOpen ? "طيّ التفاصيل" : "عرض التفاصيل")">
                                                <Icon Name="@(isOpen ? "chevron-up" : "chevron-down")" Size="xs" />
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>

                            if (isOpen)
                            {
                                <tr class="hr-detailrow" id="@detailId" @key="@("d-" + emp.EmployeeID)">
                                    <td colspan="6" style="padding:0;background:var(--surface-sunken);">
                                        <div style="padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:1.25rem;border-top:2px solid var(--accent);border-bottom:1px solid var(--line-soft);">

                                            @* 1. Header Bar: Profile details + Action Shortcuts *@
                                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;padding-bottom:1rem;border-bottom:1px solid var(--line-soft);">
                                                <div style="display:flex;align-items:center;gap:0.85rem;">
                                                    <div style="width:3.2rem;height:3.2rem;flex-shrink:0;">
                                                        @Face(emp)
                                                    </div>
                                                    <div>
                                                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                                            <h3 style="margin:0;font-size:1.2rem;font-weight:700;color:var(--text);">
                                                                @emp.Name
                                                            </h3>
                                                            <span class="hr-badge hr-num" style="font-weight:700;">#@emp.EmployeeID</span>
                                                            @if (!string.IsNullOrWhiteSpace(emp.JobTitle))
                                                            {
                                                                <span class="hr-badge hr-badge-accent">@emp.JobTitle</span>
                                                            }
                                                            <span class="hr-badge @(emp.IsArchived ? "hr-badge-warn" : "hr-badge-ok")">
                                                                @(emp.IsArchived ? "مستبعد مؤقتاً" : (string.IsNullOrWhiteSpace(emp.EmployeeStatus) ? "مستمر بالخدمة" : emp.EmployeeStatus))
                                                            </span>
                                                        </div>
                                                        <p class="hr-meta" style="margin:0.25rem 0 0 0;font-size:0.85rem;">
                                                            التشكيل: <strong>@Or(emp.Formation)</strong>
                                                            @if (!string.IsNullOrWhiteSpace(emp.FirstDepartment))
                                                            {
                                                                <span> · القسم: <strong>@emp.FirstDepartment</strong></span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>

                                                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                                    <a href="employee-vehicles/@emp.EmployeeID" class="hr-btn hr-btn-primary hr-btn-sm" title="إدارة المركبات وتصاريح الدخول">
                                                        <Icon Name="truck" Size="xs" />
                                                        <span>المركبات والتصاريح</span>
                                                        @if (employeeVehiclesMap.TryGetValue(emp.EmployeeID, out var userVList) && userVList.Count > 0)
                                                        {
                                                            <span class="hr-badge hr-badge-ok" style="padding:1px 6px;margin-right:4px;">@userVList.Count</span>
                                                        }
                                                    </a>

                                                    <a href="employee-profile/@emp.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm" title="فتح الملف الإلكتروني الشامل">
                                                        <Icon Name="user-circle" Size="xs" />
                                                        <span>الملف الإلكتروني</span>
                                                    </a>

                                                    <a href="employee-contacts/@emp.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm" title="وسائل التواصل">
                                                        <Icon Name="phone" Size="xs" />
                                                        <span>التواصل</span>
                                                    </a>

                                                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="() => OpenRecord(emp)">
                                                        <Icon Name="eye" Size="xs" />
                                                        <span>@(emp.HasProfilePhoto ? "معاينة الصورة" : "البطاقة")</span>
                                                    </button>
                                                </div>
                                            </div>

                                            @* 2. Core Information Cards in a Responsive 3-Column Grid *@
                                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(290px, 1fr));gap:1rem;">

                                                @* Card A: التكليف والموقع الوظيفي *@
                                                <div class="hr-card" style="margin:0;padding:1rem;background:var(--surface);box-shadow:none;border:1px solid var(--line-soft);border-radius:var(--r-md);">
                                                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--line-soft);font-weight:700;color:var(--accent);">
                                                        <Icon Name="briefcase" Size="xs" />
                                                        <span>التكليف والموقع الإداري</span>
                                                    </div>
                                                    <div class="hr-info-grid">
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">العنوان الوظيفي</span>
                                                            <span class="hr-info-v">@Or(emp.JobTitle)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">المنصب</span>
                                                            <span class="hr-info-v">@Or(emp.PositionTitle)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">التشكيل الإداري</span>
                                                            <span class="hr-info-v">@Or(emp.Formation)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">القسم / الشعبة</span>
                                                            <span class="hr-info-v">@Or(emp.FirstDepartment)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">الدرجة والمرحلة</span>
                                                            <span class="hr-info-v">
                                                                <span class="hr-badge hr-badge-accent">@Or(emp.Grade)</span>
                                                                <span class="hr-badge">@Or(emp.Stage)</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* Card B: الخدمة والمسار المهني *@
                                                <div class="hr-card" style="margin:0;padding:1rem;background:var(--surface);box-shadow:none;border:1px solid var(--line-soft);border-radius:var(--r-md);">
                                                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--line-soft);font-weight:700;color:var(--accent);">
                                                        <Icon Name="clock" Size="xs" />
                                                        <span>الخدمة والمسار المهني</span>
                                                    </div>
                                                    <div class="hr-info-grid">
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">تاريخ التعيين</span>
                                                            <span class="hr-info-v">
                                                                <strong class="hr-num">@D(emp.HireDate)</strong>
                                                                @if (ServiceLength(emp.HireDate) is string empServiceLength)
                                                                {
                                                                    <span class="hr-badge hr-badge-ok" style="margin-right:0.35rem;">@empServiceLength في الخدمة</span>
                                                                }
                                                            </span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">تاريخ آخر عنوان وظيفي</span>
                                                            <span class="hr-info-v hr-num">@D(emp.LastJobTitleDate)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">الحالة الوظيفية</span>
                                                            <span class="hr-info-v">@Or(emp.EmployeeStatus, "مستمر بالخدمة")</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">توثيق الصورة</span>
                                                            <span class="hr-info-v">@PhotoBadge(emp)</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* Card C: المؤهل العلمي والبيانات الشخصية *@
                                                <div class="hr-card" style="margin:0;padding:1rem;background:var(--surface);box-shadow:none;border:1px solid var(--line-soft);border-radius:var(--r-md);">
                                                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--line-soft);font-weight:700;color:var(--accent);">
                                                        <Icon Name="academic-cap" Size="xs" />
                                                        <span>المؤهل العلمي والبيانات الشخصية</span>
                                                    </div>
                                                    <div class="hr-info-grid">
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">التحصيل الدراسي</span>
                                                            <span class="hr-info-v"><strong>@Or(emp.EducationLevel)</strong></span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">الاختصاص</span>
                                                            <span class="hr-info-v">@Or(emp.Specialization)</span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">تاريخ الميلاد والعمر</span>
                                                            <span class="hr-info-v">
                                                                <span class="hr-num">@D(emp.BirthDate)</span>
                                                                @if (DetailedAge(emp.BirthDate) is string empAgeDetailed)
                                                                {
                                                                    <span class="hr-meta" style="font-size:0.8rem;margin-right:0.35rem;">(@empAgeDetailed)</span>
                                                                }
                                                            </span>
                                                        </div>
                                                        <div class="hr-info-item">
                                                            <span class="hr-info-k">الجنس والجنسية</span>
                                                            <span class="hr-info-v">@Or(emp.Gender) · @Or(emp.Nationality) · @Or(emp.Religion)</span>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>

                                            @* 3. Card D: Vehicles & Gate Access Permits *@
                                            <div class="hr-card" style="margin:0;padding:1rem;background:var(--surface);box-shadow:none;border:1px solid var(--line-soft);border-radius:var(--r-md);">
                                                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.85rem;padding-bottom:0.5rem;border-bottom:1px solid var(--line-soft);">
                                                    <div style="display:flex;align-items:center;gap:0.5rem;font-weight:700;color:var(--accent);">
                                                        <span class="hr-iconplate hr-plate-a" style="width:2rem;height:2rem;"><Icon Name="truck" Size="xs" /></span>
                                                        <span>مركبات الموظف وتصاريح دخول البوابات والمقرات</span>
                                                    </div>

                                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                                        <a href="employee-vehicles/@emp.EmployeeID" class="hr-btn hr-btn-primary hr-btn-sm">
                                                            <Icon Name="plus" Size="xs" />
                                                            <span>إضافة مركبة / إدارة التصاريح</span>
                                                        </a>
                                                    </div>
                                                </div>

                                                @if (isLoadingVehicles && !employeeVehiclesMap.ContainsKey(emp.EmployeeID))
                                                {
                                                    <div style="padding:1.5rem;text-align:center;">
                                                        <span class="hr-spinner" aria-hidden="true"></span>
                                                        <span class="hr-meta" style="margin-right:0.5rem;">جارٍ فحص وتحميل سجل المركبات للموظف…</span>
                                                    </div>
                                                }
                                                else if (employeeVehiclesMap.TryGetValue(emp.EmployeeID, out var empVehicles) && empVehicles.Count > 0)
                                                {
                                                    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(320px, 1fr));gap:0.85rem;">
                                                        @foreach (var v in empVehicles)
                                                        {
                                                            <div style="background:var(--surface-sunken);border:1px solid var(--line-soft);border-radius:var(--r-md);padding:0.85rem;display:flex;flex-direction:column;gap:0.6rem;">
                                                                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;">
                                                                    <div class="iq-license-plate" title="لوحة التسجيل: @v.Governorate @v.PlateLetter @v.PlateNumber">
                                                                        <span class="iq-plate-gov">@v.Governorate</span>
                                                                        @if (!string.IsNullOrWhiteSpace(v.PlateLetter))
                                                                        {
                                                                            <span class="iq-plate-letter">@v.PlateLetter</span>
                                                                        }
                                                                        <span class="iq-plate-num">@v.PlateNumber</span>
                                                                    </div>

                                                                    @if (v.IsAuthorized)
                                                                    {
                                                                        <span class="hr-badge hr-badge-ok">
                                                                            <Icon Name="check-circle" Size="xs" />
                                                                            <span>مخولة بالدخول</span>
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="hr-badge hr-badge-danger">
                                                                            <Icon Name="no-symbol" Size="xs" />
                                                                            <span>غير مخولة</span>
                                                                        </span>
                                                                    }
                                                                </div>

                                                                <div style="display:flex;align-items:baseline;justify-content:space-between;padding-bottom:0.35rem;border-bottom:1px solid var(--line-soft);">
                                                                    <strong style="font-size:1.02rem;">@v.Brand @v.Model</strong>
                                                                    <div style="display:flex;gap:0.35rem;">
                                                                        @if (!string.IsNullOrWhiteSpace(v.Color))
                                                                        {
                                                                            <span class="hr-meta" style="font-size:0.8rem;">اللون: @v.Color</span>
                                                                        }
                                                                        @if (v.ManufacturingYear.HasValue)
                                                                        {
                                                                            <span class="hr-meta" style="font-size:0.8rem;">موديل: @v.ManufacturingYear</span>
                                                                        }
                                                                    </div>
                                                                </div>

                                                                @if (!string.IsNullOrWhiteSpace(v.Vin))
                                                                {
                                                                    <div style="font-size:0.78rem;background:var(--surface);padding:0.25rem 0.5rem;border-radius:var(--r-sm);border:1px solid var(--line-soft);display:flex;justify-content:space-between;">
                                                                        <span class="hr-meta">رقم الشاصي:</span>
                                                                        <code dir="ltr" style="font-family:monospace;font-weight:600;color:var(--accent);">@v.Vin</code>
                                                                    </div>
                                                                }

                                                                <div>
                                                                    <span class="hr-meta" style="font-size:0.75rem;display:block;margin-bottom:0.3rem;">المقرات المصرح بدخولها:</span>
                                                                    <div style="display:flex;gap:0.3rem;flex-wrap:wrap;">
                                                                        <span class="hr-gate-pill @(v.AllowMainBuilding ? "is-allowed" : "is-blocked")" title="1- المبنى الرئيسي">1- الرئيسي</span>
                                                                        <span class="hr-gate-pill @(v.AllowJadriya ? "is-allowed" : "is-blocked")" title="2- الجادرية">2- الجادرية</span>
                                                                        <span class="hr-gate-pill @(v.AllowErbil ? "is-allowed" : "is-blocked")" title="3- أربيل">3- أربيل</span>
                                                                        <span class="hr-gate-pill @(v.AllowMosul ? "is-allowed" : "is-blocked")" title="4- الموصل">4- الموصل</span>
                                                                        <span class="hr-gate-pill @(v.AllowBasra ? "is-allowed" : "is-blocked")" title="5- البصرة">5- البصرة</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div style="padding:1rem 1.25rem;background:var(--surface-sunken);border-radius:var(--r-md);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
                                                        <div style="display:flex;align-items:center;gap:0.6rem;">
                                                            <span class="hr-iconplate hr-plate-d" style="width:2rem;height:2rem;"><Icon Name="truck" Size="xs" /></span>
                                                            <div>
                                                                <strong style="font-size:0.92rem;display:block;">لا توجد مركبات مسجلة لهذا الموظف حالياً</strong>
                                                                <span class="hr-meta" style="font-size:0.8rem;">يمكنك تسجيل سيارة جديدة وإصدار تصاريح الدخول للمقرات الخمسة بسهولة.</span>
                                                            </div>
                                                        </div>
                                                        <a href="employee-vehicles/@emp.EmployeeID" class="hr-btn hr-btn-secondary hr-btn-sm">
                                                            <Icon Name="plus" Size="xs" />
                                                            <span>تسجيل مركبة الآن</span>
                                                        </a>
                                                    </div>
                                                }
                                            </div>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="hr-card-body">
              <div class="hr-cardsview">
                @if (!string.IsNullOrEmpty(activeMenuEmpId))
                {
                    <div class="hr-card-menu-backdrop" @onclick="CloseCardMenu" aria-hidden="true"></div>
                }
                <ul class="hr-grid-cards hr-grid-cards-quad hr-plainlist">
                    @foreach (var emp in employees)
                    {
                        <li @key="@("c-" + emp.EmployeeID)">
                            <article class="hr-empcard">
                                <div class="hr-empcard-top">
                                    <span class="hr-badge hr-num">@emp.EmployeeID</span>
                                    @PhotoBadge(emp)
                                </div>

                                <div class="hr-empcard-face">
                                    @if (emp.HasProfilePhoto && photoThumbnails.TryGetValue(emp.EmployeeID, out var cardThumb))
                                    {
                                        <button type="button" class="hr-facebtn"
                                                @onclick="() => OpenRecord(emp)"
                                                aria-label="@($"فتح سجل {emp.Name}")">
                                            <img src="@cardThumb" alt="@($"الصورة الشخصية للموظف {emp.Name}")" loading="lazy" decoding="async"
                                                 @onerror="() => photoThumbnails.Remove(emp.EmployeeID)" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="hr-facebtn hr-facebtn-none"
                                              style="background:@AvatarTone(emp.EmployeeID)" aria-hidden="true">
                                            @AvatarInitials.FromName(emp.Name)
                                        </span>
                                    }
                                </div>

                                <div class="hr-empcard-body">
                                    <h3 class="hr-h3 hr-balance">
                                        <a href="employees/@emp.EmployeeID" class="hr-link" title="عرض الملف الإلكتروني">
                                            @emp.Name
                                        </a>
                                    </h3>
                                    <p class="hr-meta hr-clamp-2" style="margin-block-start:.25rem">@Or(emp.JobTitle)</p>

                                    <div class="hr-chips" style="justify-content:center;margin-block-start:.75rem">
                                        @if (!string.IsNullOrWhiteSpace(emp.Formation))
                                        {
                                            <span class="hr-badge" title="التشكيل الإداري">
                                                <Icon Name="building-office-2" Size="xs" />
                                                <span class="hr-truncate">@emp.Formation</span>
                                            </span>
                                        }
                                        <span class="hr-badge" title="الدرجة الوظيفية">
                                            <Icon Name="academic-cap" Size="xs" />
                                            <span>@Or(emp.Grade)</span>
                                        </span>
                                        <span class="hr-badge" title="المرحلة الوظيفية">
                                            <Icon Name="square-3-stack-3d" Size="xs" />
                                            <span>@Or(emp.Stage)</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="hr-empcard-foot">
                                    <a class="hr-btn hr-btn-primary hr-btn-sm hr-empcard-btn-main"
                                       href="employees/@emp.EmployeeID"
                                       aria-label="@($"الملف الإلكتروني للموظف {emp.Name}")"
                                       title="عرض الملف الإلكتروني الشامل">
                                        <Icon Name="user-circle" Size="xs" />
                                        <span>الملف الإلكتروني</span>
                                    </a>

                                    @if (isArchivedView)
                                    {
                                        @if (canManageLifecycle)
                                        {
                                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm hr-btn-icon"
                                                    @onclick="() => PromptRestore(emp)"
                                                    title="استرجاع الموظف إلى النظام والتقارير"
                                                    aria-label="@($"استرجاع {emp.Name} إلى النظام والتقارير")">
                                                <Icon Name="arrow-uturn-left" Size="xs" />
                                            </button>

                                            <button type="button" class="hr-btn hr-btn-danger-quiet hr-btn-sm hr-btn-icon"
                                                    @onclick="() => PromptHardDelete(emp)"
                                                    title="حذف نهائي لا رجعة فيه"
                                                    aria-label="@($"حذف نهائي للموظف {emp.Name}")">
                                                <Icon Name="trash" Size="xs" />
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm hr-btn-icon"
                                                @onclick="() => OpenRecord(emp)"
                                                aria-label="@($"معاينة سريعة لسجل {emp.Name}")"
                                                title="معاينة سريعة">
                                            <Icon Name="clipboard-document-list" Size="xs" />
                                        </button>

                                        <div class="hr-card-menu-anchor">
                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                    @onclick="() => ToggleCardMenu(emp.EmployeeID)"
                                                    aria-expanded="@(activeMenuEmpId == emp.EmployeeID ? "true" : "false")"
                                                    aria-label="المزيد من الإجراءات"
                                                    title="المزيد من الإجراءات">
                                                <Icon Name="ellipsis-horizontal" Size="xs" />
                                            </button>

                                            @if (activeMenuEmpId == emp.EmployeeID)
                                            {
                                                <div class="hr-card-dropdown" role="menu">
                                                    <a class="hr-card-dropdown-item" href="employee-contacts/@emp.EmployeeID" @onclick="CloseCardMenu" role="menuitem">
                                                        <Icon Name="phone" Size="xs" />
                                                        <span>وسائل التواصل</span>
                                                    </a>

                                                    <a class="hr-card-dropdown-item" href="employee-vehicles/@emp.EmployeeID" @onclick="CloseCardMenu" role="menuitem">
                                                        <Icon Name="truck" Size="xs" />
                                                        <span>المركبات والتصاريح</span>
                                                    </a>

                                                    <label class="hr-card-dropdown-item hr-card-dropdown-upload" role="menuitem">
                                                        @if (uploadingId == emp.EmployeeID)
                                                        {
                                                            <span class="hr-spinner" aria-hidden="true"></span>
                                                            <span>جارٍ الرفع…</span>
                                                        }
                                                        else
                                                        {
                                                            <Icon Name="arrow-up-tray" Size="xs" />
                                                            <span>@(emp.HasProfilePhoto ? "تغيير الصورة" : "رفع صورة")</span>
                                                        }
                                                        <InputFile accept=".jpg,.jpeg,.png,.webp"
                                                                   disabled="@(uploadingId is not null)"
                                                                   OnChange="@(async e => { CloseCardMenu(); await UploadPhoto(emp.EmployeeID, e); })" />
                                                    </label>

                                                    @if (emp.HasProfilePhoto)
                                                    {
                                                        <button type="button" class="hr-card-dropdown-item hr-card-dropdown-item-danger"
                                                                @onclick="() => { CloseCardMenu(); pendingDelete = emp; }" role="menuitem">
                                                            <Icon Name="trash" Size="xs" />
                                                            <span>حذف الصورة</span>
                                                        </button>
                                                    }

                                                    @if (canManageLifecycle)
                                                    {
                                                        <div class="hr-card-dropdown-sep" role="separator"></div>

                                                        <button type="button" class="hr-card-dropdown-item"
                                                                @onclick="() => { CloseCardMenu(); PromptArchive(emp); }" role="menuitem">
                                                            <Icon Name="archive-box" Size="xs" />
                                                            <span>استبعاد مؤقت</span>
                                                        </button>

                                                        <button type="button" class="hr-card-dropdown-item hr-card-dropdown-item-danger"
                                                                @onclick="() => { CloseCardMenu(); PromptHardDelete(emp); }" role="menuitem">
                                                            <Icon Name="trash" Size="xs" />
                                                            <span>حذف نهائي</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        </li>
                    }
                </ul>
              </div>
            </div>
        }

        @if (!isLoading && !loadFailed && employees.Count > 0)
        {
            <div class="hr-card-foot">
                <div class="hr-pager">
                    <p class="hr-meta">
                        عرض <span class="hr-num">@N(RangeStart)</span>
                        إلى <span class="hr-num">@N(RangeEnd)</span>
                        من <span class="hr-num">@N(totalCount)</span>
                    </p>

                    <div class="hr-pager-controls">
                        <button type="button" class="hr-pager-btn" @onclick="() => ChangePage(1)"
                                disabled="@(currentPage == 1)" aria-label="الصفحة الأولى">
                            <Icon Name="chevron-double-right" Size="xs" />
                        </button>
                        <button type="button" class="hr-pager-btn" @onclick="() => ChangePage(currentPage - 1)"
                                disabled="@(currentPage == 1)" aria-label="الصفحة السابقة">
                            <Icon Name="chevron-right" Size="xs" />
                        </button>

                        <span class="hr-meta hr-pager-status" aria-live="polite">
                            صفحة <span class="hr-num">@currentPage</span> من <span class="hr-num">@totalPages</span>
                        </span>

                        <button type="button" class="hr-pager-btn" @onclick="() => ChangePage(currentPage + 1)"
                                disabled="@(currentPage >= totalPages)" aria-label="الصفحة التالية">
                            <Icon Name="chevron-left" Size="xs" />
                        </button>
                        <button type="button" class="hr-pager-btn" @onclick="() => ChangePage(totalPages)"
                                disabled="@(currentPage >= totalPages)" aria-label="الصفحة الأخيرة">
                            <Icon Name="chevron-double-left" Size="xs" />
                        </button>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

@* ---------- full record ---------- *@
<Modal IsOpen="@(recordEmployee is not null)"
       Title="@(recordEmployee?.Name ?? "سجل الموظف")"
       Subtitle="@(recordEmployee is null ? null : $"الرقم الوظيفي {recordEmployee.EmployeeID} · {Or(recordEmployee.JobTitle)}")"
       Icon="identification"
       Size="xl"
       OnClose="CloseRecord">
    <Body>
        @if (recordEmployee is not null)
        {
            <div class="hr-preview">
                <div class="hr-preview-media">
                    @if (!string.IsNullOrEmpty(recordPhotoUrl))
                    {
                        <img src="@recordPhotoUrl" alt="@($"الصورة الشخصية للموظف {recordEmployee.Name}")"
                             hidden="@isRecordPhotoLoading"
                             @onload="OnRecordPhotoLoaded"
                             @onerror="OnRecordPhotoFailed" />
                    }
                    @if (isRecordPhotoLoading)
                    {
                        <div class="hr-skeleton" style="width:100%;aspect-ratio:3/4;border-radius:var(--r)" aria-hidden="true"></div>
                        <p class="hr-sr">جارٍ تحميل الصورة الأصلية…</p>
                    }
                    else if (string.IsNullOrEmpty(recordPhotoUrl))
                    {
                        <div class="hr-preview-none">
                            <Icon Name="photo" Size="xl" />
                            <p class="hr-meta" style="margin-block-start:.5rem">لا توجد صورة شخصية</p>
                        </div>
                    }
                </div>

                <div>
                    <div class="hr-chips" style="margin-block-end:.75rem">
                        @PhotoBadge(recordEmployee)
                        <span class="hr-badge">@Or(recordEmployee.EmployeeStatus, "مستمر")</span>
                        @if (recordEmployee.HasProfilePhoto)
                        {
                            <span class="hr-badge">تخزين خاص ومُدقَّق</span>
                        }
                    </div>

                    @RecordFields(recordEmployee)
                </div>
            </div>
        }
    </Body>
    <Footer>
        @if (!string.IsNullOrEmpty(recordPhotoUrl) && !isRecordPhotoLoading && recordEmployee is not null)
        {
            <a class="hr-btn hr-btn-secondary"
               href="@recordPhotoUrl"
               download="@($"Employee_{recordEmployee.EmployeeID}_Profile.jpg")">
                <Icon Name="arrow-down-tray" Size="xs" />
                <span>تحميل الصورة</span>
            </a>
        }
        <button type="button" class="hr-btn hr-btn-primary" @onclick="CloseRecord">إغلاق</button>
    </Footer>
</Modal>

<ConfirmDialog IsOpen="@(pendingDelete is not null)"
               Title="حذف الصورة الشخصية"
               Subject="@(pendingDelete is null ? null : $"{pendingDelete.Name} · {pendingDelete.EmployeeID}")"
               Message="سيُلغى تفعيل الصورة الحالية ولن تظهر في سجلات الموظف. يمكن رفع صورة جديدة لاحقاً."
               ConfirmText="حذف الصورة"
               IsBusy="@isDeletingPhoto"
               OnConfirm="ConfirmDeletePhoto"
               OnCancel="() => pendingDelete = null" />

@* ---------- Archive Employee Modal ---------- *@
<Modal IsOpen="@(employeeToArchive is not null)"
       Title="استبعاد الموظف مؤقتاً (أرشفة)"
       Subtitle="@(employeeToArchive is null ? null : $"الموظف: {employeeToArchive.Name} · الرقم الوظيفي: {employeeToArchive.EmployeeID}")"
       Icon="archive-box"
       Size="md"
       OnClose="() => employeeToArchive = null">
    <Body>
        @if (employeeToArchive is not null)
        {
            <div class="hr-stack-sm">
                <div class="hr-alert hr-alert-warn">
                    <p style="margin:0">
                        <strong>تنبيه:</strong> سيتم استبعاد هذا الموظف مؤقتاً من كافة التقارير ولوحات التحكم وقوائم الموظفين النشطة.
                        سيتم الاحتفاظ بكامل بياناته وسجلاته في الأرشيف ويمكن استرجاعه بنشاط كامل في أي وقت.
                    </p>
                </div>

                <div class="hr-field">
                    <label class="hr-field-label" for="archive-reason">سبب الاستبعاد المؤقت</label>
                    <input id="archive-reason" type="text" class="hr-input" @bind="archiveReasonInput"
                           placeholder="مثال: إجازة طويلة بدون راتب، إعارة، تحقيق إداري، استبعاد بقرار إدارة..." />
                </div>

                <div class="hr-chips" style="margin-block-start:.25rem">
                    <span class="hr-meta">أسباب شائعة:</span>
                    <button type="button" class="hr-chip" @onclick='() => archiveReasonInput = "إجازة طويلة بدون راتب"'>إجازة بدون راتب</button>
                    <button type="button" class="hr-chip" @onclick='() => archiveReasonInput = "إعارة إلى جهة أخرى"'>إعارة</button>
                    <button type="button" class="hr-chip" @onclick='() => archiveReasonInput = "إجراء إداري / تدقيق"'>تدقيق إداري</button>
                    <button type="button" class="hr-chip" @onclick='() => archiveReasonInput = "استبعاد بقرار الإدارة"'>قرار إدارة</button>
                </div>
            </div>
        }
    </Body>
    <Footer>
        <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => employeeToArchive = null" disabled="@isPerformingAction">إلغاء</button>
        <button type="button" class="hr-btn hr-btn-primary" @onclick="ConfirmArchive" disabled="@isPerformingAction">
            @if (isPerformingAction)
            {
                <span class="hr-spinner" aria-hidden="true"></span>
                <span>جارٍ الحفظ…</span>
            }
            else
            {
                <Icon Name="archive-box" Size="xs" />
                <span>تأكيد الاستبعاد المؤقت</span>
            }
        </button>
    </Footer>
</Modal>

@* ---------- Restore Employee Modal ---------- *@
<ConfirmDialog IsOpen="@(employeeToRestore is not null)"
               Title="استرجاع الموظف إلى النظام"
               Subject="@(employeeToRestore is null ? null : $"{employeeToRestore.Name} · {employeeToRestore.EmployeeID}")"
               Message="سيتم إلغاء الاستبعاد المؤقت وإعادة الموظف للظهور في كافة التقارير والقوائم والإحصائيات بنشاط كامل."
               ConfirmText="استرجاع الموظف"
               IsBusy="@isPerformingAction"
               OnConfirm="ConfirmRestore"
               OnCancel="() => employeeToRestore = null" />

@* ---------- Hard Delete Employee Modal ---------- *@
<ConfirmDialog IsOpen="@(employeeToDelete is not null)"
               Title="حذف الموظف نهائياً (Hard Delete)"
               Subject="@(employeeToDelete is null ? null : $"تحذير: {employeeToDelete.Name} · {employeeToDelete.EmployeeID}")"
               Message="تحذير شديد: سيتم حذف هذا الموظف نهائياً من قاعدة البيانات مع كافة السجلات المرتبطة به (الملفات، الإجازات، العقوبات، الشهادات، الحركات، الحسابات المالية). لا يمكن التراجع عن هذا الإجراء إطلاقاً!"
               ConfirmText="حذف نهائي لا رجعة فيه"
               IsBusy="@isPerformingAction"
               OnConfirm="ConfirmHardDelete"
               OnCancel="() => employeeToDelete = null" />

@* ---------- operation feedback ---------- *@
@* The region is always in the document so an announcement is not competing
   with the node that carries it being inserted at the same moment. *@
<div class="hr-toasts" role="status" aria-live="polite">
