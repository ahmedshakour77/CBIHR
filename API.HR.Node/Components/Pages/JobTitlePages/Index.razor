    // CSV Export
    private async Task ExportCsvAsync()
    {
        try
        {
            var list = FilteredPredictions;
            if (list.Count == 0)
            {
                Toast.Warning("لا توجد بيانات مطابقة لتصديرها.");
                return;
            }

            var sb = new System.Text.StringBuilder();
            sb.Append('\uFEFF'); // UTF-8 BOM
            sb.AppendLine("الرقم الوظيفي,اسم الموظف,حالة الموظف,التشكيل,العنوان الحالي,الدرجة الحالية,المرحلة الحالية,المراحل المقررة,العنوان القادم,الدرجة القادمة,تاريخ آخر علاوة,تاريخ آخر عنوان,كتب الشكر بعد العلاوة,القِدم الفعلي (شهر),القِدم المعتمد (سقف 3 أشهر),العقوبات بعد العنوان,التأخير بالعقوبات (شهر),موعد الاستحقاق المتوقع,حالة الاستحقاق");

            foreach (var item in list)
            {
                sb.AppendLine(string.Join(",", new[]
                {
                    EscapeCsv(item.EmployeeID),
                    EscapeCsv(item.EmployeeName),
                    EscapeCsv(item.EmployeeStatusName),
                    EscapeCsv(item.FormationName),
                    EscapeCsv(item.JobTitleName),
                    EscapeCsv(item.GradeName),
                    EscapeCsv(item.StageName),
                    item.RequiredServiceYears.ToString(),
                    EscapeCsv(item.NextJobTitleName),
                    EscapeCsv(item.NextGradeName),
                    item.LastAllowanceDate?.ToString("yyyy/MM/dd") ?? "",
                    item.LastJobTitleDate?.ToString("yyyy/MM/dd") ?? "",
                    item.LettersCount.ToString(),
                    item.RawSeniorityMonths.ToString(),
                    item.EffectiveSeniorityMonths.ToString(),
                    item.PenaltiesCount.ToString(),
                    item.DelayMonths.ToString(),
                    item.PredictedDueDate?.ToString("yyyy/MM/dd") ?? (item.IsDismissed ? "محظور" : ""),
                    EscapeCsv(item.Status)
                }));
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"استحقاق_العناوين_والترقيات_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            await JS.InvokeVoidAsync("downloadFileFromBase64", filename, "text/csv;charset=utf-8", base64);
            Toast.Success("تم تصدير ملف الاستحقاقات بنجاح.");
        }
        catch (Exception ex)
        {
            Toast.Danger($"فشل تصدير التقرير: {ex.Message}");
        }
    }

    private static string EscapeCsv(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(',') || field.Contains('"') || field.Contains('\n') || field.Contains('\r'))
        {
            return $"\"{field.Replace("\"", "\"\"")}\"";
        }
        return field;
    }

    private static int ParseGradeNumber(string? gradeText)
    {
        if (string.IsNullOrWhiteSpace(gradeText)) return 0;
        var clean = gradeText.Trim();

        if (int.TryParse(clean, out var n)) return n;
        if (clean.Contains("عاشرة") || clean.Contains("العاشرة") || clean == "10") return 10;
        if (clean.Contains("تاسعة") || clean.Contains("التاسعة") || clean == "9") return 9;
        if (clean.Contains("ثامنة") || clean.Contains("الثامنة") || clean == "8") return 8;
        if (clean.Contains("سابعة") || clean.Contains("السابعة") || clean == "7") return 7;
        if (clean.Contains("سادسة") || clean.Contains("السادسة") || clean == "6") return 6;
        if (clean.Contains("خامسة") || clean.Contains("الخامسة") || clean == "5") return 5;
        if (clean.Contains("رابعة") || clean.Contains("الرابعة") || clean == "4") return 4;
        if (clean.Contains("ثالثة") || clean.Contains("الثالثة") || clean == "3") return 3;
        if (clean.Contains("ثانية") || clean.Contains("الثانية") || clean == "2") return 2;
        if (clean.Contains("أولى") || clean.Contains("الأولى") || clean.Contains("اولى") || clean == "1") return 1;

        return 0;
    }

    private static int ParseStageNumber(string? stageText)
    {
        if (string.IsNullOrWhiteSpace(stageText)) return 0;
        var clean = stageText.Trim().Replace(" ", "");

        if (int.TryParse(clean, out var n)) return n;
        if (clean.Contains("حادي") || clean.Contains("11")) return 11;
        if (clean.Contains("عاشر") || clean.Contains("10")) return 10;
        if (clean.Contains("تاسع") || clean.Contains("9")) return 9;
        if (clean.Contains("ثامن") || clean.Contains("8")) return 8;
        if (clean.Contains("سابع") || clean.Contains("7")) return 7;
        if (clean.Contains("سادس") || clean.Contains("6")) return 6;
        if (clean.Contains("خامس") || clean.Contains("5")) return 5;
        if (clean.Contains("رابع") || clean.Contains("4")) return 4;
        if (clean.Contains("ثالث") || clean.Contains("3")) return 3;
        if (clean.Contains("ثاني") || clean.Contains("2")) return 2;
        if (clean.Contains("اول") || clean.Contains("أول") || clean.Contains("1")) return 1;

        return 0;
    }

    private static bool IsCeilingTitle(string titleName)
    {
        var clean = titleName.Trim();
        if (clean.Contains("رئيس حرفين اقدم") || clean.Contains("رئيس حرفيين اقدم")) return true;
        if (clean.Contains("رئيس سواق اقدم")) return true;
        if (clean.Contains("موظف خدمات اقدم")) return true;
        if (clean.Contains("رئيس امناء صناديق")) return true;
        if (clean.Contains("معاون رئيس فاحص نقد")) return true;
        if (clean.Contains("رئيس كاتب طابعة") || clean.Contains("رئيس كتاب اقدم")) return true;
        if (clean.Contains("اقدم اول") || clean.Contains("أقدم أول")) return true;

        return false;
    }

    private JobTitle? FindNextTitleFromList(string currentTitle, int nextGrade)
    {
        var clean = currentTitle.Trim();

        if (clean.Contains("مبرمج"))
        {
            return nextGrade switch
            {
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون رئيس مبرمجين") || j.Name.Contains("م رئيس مبرمجين")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مبرمجين"),
                2 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مبرمجين اقدم"),
                1 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مبرمجين اقدم اول"),
                _ => null
            };
        }

        if (clean.Contains("مهندس"))
        {
            return nextGrade switch
            {
                6 => jobTitlesList.FirstOrDefault(j => j.Name == "مهندس"),
                5 => jobTitlesList.FirstOrDefault(j => j.Name == "مهندس اقدم"),
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون رئيس مهندسين") || j.Name.Contains("م رئيس مهندسين")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مهندسين"),
                2 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مهندسين اقدم"),
                1 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس مهندسين اقدم اول"),
                _ => null
            };
        }

        if (clean.Contains("محاسب") || clean.Contains("حسابات"))
        {
            return nextGrade switch
            {
                6 => jobTitlesList.FirstOrDefault(j => j.Name == "محاسب"),
                5 => jobTitlesList.FirstOrDefault(j => j.Name == "محاسب اقدم"),
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون مدير حسابات")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name == "مدير حسابات"),
                2 => jobTitlesList.FirstOrDefault(j => j.Name == "مدير حسابات اقدم"),
                1 => jobTitlesList.FirstOrDefault(j => j.Name == "مدير حسابات اقدم اول"),
                _ => null
            };
        }

        if (clean.Contains("مدقق") || clean.Contains("تدقيق"))
        {
            return nextGrade switch
            {
                6 => jobTitlesList.FirstOrDefault(j => j.Name == "مدقق"),
                5 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مدقق اقدم")),
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون مدير تدقيق")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مدير تدقيق اقدم")),
                2 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مدير تدقيق اقدم اول")),
                _ => null
            };
        }

        if (clean.Contains("قانوني") || clean.Contains("مشاور") || clean.Contains("مستشار"))
        {
            return nextGrade switch
            {
                6 => jobTitlesList.FirstOrDefault(j => j.Name == "قانوني"),
                5 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مشاور قانوني مساعد") || j.Name.Contains("مستشار قانوني مساعد")),
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مشاور قانونى") || j.Name.Contains("مشاور قانوني")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مشاور قانوني اقدم")),
                2 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("مستشار قانوني")),
                _ => null
            };
        }

        if (clean.Contains("ملاحظ"))
        {
            return nextGrade switch
            {
                6 => jobTitlesList.FirstOrDefault(j => j.Name == "ملاحظ"),
                5 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("ملاحظ اقدم")),
                4 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون رئيس ملاحظين")),
                3 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس ملاحظين" || j.Name == "ر ملاحظين"),
                _ => null
            };
        }

        if (clean.Contains("حرفي"))
        {
            return nextGrade switch
            {
                8 => jobTitlesList.FirstOrDefault(j => j.Name == "حرفي اول"),
                7 => jobTitlesList.FirstOrDefault(j => j.Name == "حرفي اقدم"),
                6 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("معاون رئيس حرفيين") || j.Name.Contains("م.رئيس  حرفيين")),
                5 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس حرفين"),
                4 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس حرفين اقدم"),
                _ => null
            };
        }

        if (clean.Contains("سائق") || clean.Contains("سواق"))
        {
            return nextGrade switch
            {
                8 => jobTitlesList.FirstOrDefault(j => j.Name == "سائق اول"),
                7 => jobTitlesList.FirstOrDefault(j => j.Name == "سائق اقدم"),
                6 => jobTitlesList.FirstOrDefault(j => j.Name.Contains("م رئيس سواق")),
                5 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس سواق"),
                4 => jobTitlesList.FirstOrDefault(j => j.Name == "رئيس سواق اقدم"),
                _ => null
            };
        }

        return null;
    }

    private static string PredictStandardNextTitle(string currentTitle, int nextGrade)
    {
        var clean = currentTitle.Trim();

        if (clean.Contains("مبرمج"))
        {
            return nextGrade switch
            {
                4 => "معاون رئيس مبرمجين",
                3 => "رئيس مبرمجين",
                2 => "رئيس مبرمجين اقدم",
                1 => "رئيس مبرمجين اقدم اول",
                _ => $"مبرمج (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("مهندس"))
        {
            return nextGrade switch
            {
                6 => "مهندس",
                5 => "مهندس اقدم",
                4 => "معاون رئيس مهندسين",
                3 => "رئيس مهندسين",
                2 => "رئيس مهندسين اقدم",
                1 => "رئيس مهندسين اقدم اول",
                _ => $"مهندس (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("محاسب") || clean.Contains("حسابات"))
        {
            return nextGrade switch
            {
                6 => "محاسب",
                5 => "محاسب اقدم",
                4 => "معاون مدير حسابات",
                3 => "مدير حسابات",
                2 => "مدير حسابات اقدم",
                1 => "مدير حسابات اقدم اول",
                _ => $"محاسب (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("مدقق"))
        {
            return nextGrade switch
            {
                6 => "مدقق",
                5 => "مدقق اقدم",
                4 => "معاون مدير تدقيق",
                3 => "مدير تدقيق",
                2 => "مدير تدقيق اقدم",
                1 => "مدير تدقيق اقدم اول",
                _ => $"مدقق (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("قانوني") || clean.Contains("مشاور"))
        {
            return nextGrade switch
            {
                6 => "قانوني",
                5 => "مشاور قانوني مساعد",
                4 => "مشاور قانوني",
                3 => "مشاور قانوني اقدم",
                2 => "مستشار قانوني",
                _ => $"قانوني (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("ملاحظ"))
        {
            return nextGrade switch
            {
                6 => "ملاحظ",
                5 => "ملاحظ اقدم",
                4 => "معاون رئيس ملاحظين",
                3 => "رئيس ملاحظين",
                _ => $"ملاحظ (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("حرفي"))
        {
            return nextGrade switch
            {
                8 => "حرفي اول",
                7 => "حرفي اقدم",
                6 => "معاون رئيس حرفيين",
                5 => "رئيس حرفين",
                4 => "رئيس حرفين اقدم",
                _ => $"حرفي (الدرجة {nextGrade})"
            };
        }

        if (clean.Contains("سائق"))
        {
            return nextGrade switch
            {
                8 => "سائق اول",
                7 => "سائق اقدم",
                6 => "م رئيس سواق",
                5 => "رئيس سواق",
                4 => "رئيس سواق اقدم",
                _ => $"سائق (الدرجة {nextGrade})"
            };
        }

        return $"الترقية للدرجة {nextGrade} (ضمن نفس العائلة الوظيفية)";
    }

    public async ValueTask DisposeAsync()
    {
        if (context != null)
        {
            await context.DisposeAsync();
        }
    }
