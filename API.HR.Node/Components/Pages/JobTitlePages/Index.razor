            {
                return jobTitlesList;
            }

            var term = titleSearchQuery.Trim();
            return jobTitlesList.Where(j =>
                j.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (j.Code != null && j.Code.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (j.JobFamily != null && j.JobFamily.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (j.Grade != null && j.Grade.Name.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

