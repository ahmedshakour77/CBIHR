@page "/jobtitles"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,HRManager,FormationManager,Supervisor")]
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Data
@using API.HR.Node.Services
@using API.HR.Node.Services.Localization
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IToastService Toast
@inject ILanguageService Lang
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>استحقاق العناوين والترقيات الوظيفية | منظومة الموارد البشرية</PageTitle>

<style>
    .hr-timeline-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.25rem;
        background: var(--surface-sunken);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        margin-bottom: 1.25rem;
    }
    .hr-timeline-flow {
        display: flex;
        align-items: stretch;
        gap: 0.65rem;
        overflow-x: auto;
        padding-bottom: 0.75rem;
        padding-top: 0.25rem;
    }
    .hr-timeline-node {
        flex: 1 1 180px;
        min-width: 175px;
        max-width: 240px;
        background: var(--surface-raised);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hr-timeline-node:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }
    .hr-timeline-node--current {
        border: 2px solid var(--color-primary);
        background: rgba(59, 130, 246, 0.05);
    }
    .hr-timeline-node--qualifying {
        border: 2px solid #8b5cf6;
        background: rgba(139, 92, 246, 0.05);
    }
    .hr-timeline-node--bonus {
        border: 2px dashed var(--color-success);
        background: rgba(16, 185, 129, 0.06);
    }
    .hr-timeline-node--penalty {
        border: 2px dashed var(--color-danger);
        background: rgba(239, 68, 68, 0.06);
    }
    .hr-timeline-node--target {
        border: 2px solid var(--color-success);
        background: rgba(16, 185, 129, 0.08);
    }
    .hr-timeline-node--blocked {
        border: 2px solid var(--color-danger);
        background: rgba(239, 68, 68, 0.1);
    }
    .hr-timeline-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        font-size: 1.15rem;
        flex-shrink: 0;
        opacity: 0.7;
    }
    .hr-stage-bar {
        display: flex;
        gap: 3px;
        align-items: center;
        margin-top: 4px;
        width: 100%;
        max-width: 120px;
    }
    .hr-stage-segment {
        height: 6px;
        flex: 1;
        border-radius: 2px;
        background: var(--border-subtle);
    }
    .hr-stage-segment--active {
        background: var(--color-primary);
    }
</style>

<div class="hr-stack">
    @* Page Header *@
    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <nav class="hr-crumbs" aria-label="مسار التنقل">
                <a href="" class="hr-crumb">
                    <Icon Name="home" Size="xs" />
                    <span>الرئيسية</span>
                </a>
                <span class="hr-crumb-sep" aria-hidden="true">/</span>
                <span class="hr-crumb hr-crumb-current">استحقاق العناوين والترقيات</span>
            </nav>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-block-start: var(--s-1); flex-wrap: wrap;">
                <h1 class="hr-h1" style="margin: 0;">استحقاق العناوين والترقيات الوظيفية</h1>
                <span class="hr-badge hr-badge--accent" style="font-size: var(--fs-caption); font-weight: 600;">
                    <Icon Name="sparkles" Size="xs" />
                    <span>محرك الاحتساب الذكي الجديد</span>
                </span>
            </div>
            <p class="hr-sub hr-measure" style="margin-block-start: var(--s-1); color: var(--text-muted);">
                احتساب استحقاق الترقية وتغيير العنوان بالسلم الوظيفي، وتطبيق أثر كتب الشكر بما لا يزيد عن 3 أشهر من تاريخ آخر علاوة (السنة الوظيفية)، مع حصر أثر العقوبات ضمن فترة العنوان الحالي.
            </p>
        </div>
        <div class="hr-pagehead-actions" role="group">
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="إعادة احتساب وتحديث البيانات">
                <Icon Name="arrow-path" Size="sm" Class="@(isLoading ? "hr-spin" : "")" />
                <span>إعادة احتساب</span>
            </button>
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="ExportCsvAsync" disabled="@(FilteredPredictions.Count == 0)" title="تصدير النتائج إلى ملف CSV">
                <Icon Name="document-arrow-down" Size="sm" />
                <span>تصدير CSV</span>
            </button>
            <a href="/data-import" class="hr-btn hr-btn-secondary" title="مركز استيراد ملفات الإكسل">
                <Icon Name="arrow-up-tray" Size="sm" />
                <span>استيراد بيانات</span>
            </a>
            <a href="/admin/job-classifications" class="hr-btn hr-btn-primary" title="الانتقال إلى دليل ومكنز العناوين والعوائل الوظيفية">
                <Icon Name="briefcase" Size="sm" />
                <span>دليل العناوين والعوائل</span>
            </a>
        </div>
    </header>

    @* Employee Status Target Selection Panel (اختيار حسب حالة الموظف أولاً ثم الاحتساب) *@
    <div class="hr-card" style="padding: 1.25rem; margin-block-end: var(--s-3); border-inline-start: 4px solid var(--color-primary); background: var(--surface-raised); box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div style="width: 42px; height: 42px; border-radius: var(--radius-md); background: rgba(59, 130, 246, 0.12); color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                    <Icon Name="users" Size="md" />
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span style="font-weight: 700; font-size: 1.05rem; color: var(--text-base);">
                            اختيار واحتساب حسب حالة الموظف
                        </span>
                        <span class="hr-badge hr-badge--primary" style="font-size: var(--fs-caption);">
                            خطوة أساسية أولى
                        </span>
                    </div>
                    <div style="font-size: var(--fs-caption); color: var(--text-muted); margin-top: 0.2rem;">
                        اختر حالة الموظف المستهدفة بالاحتساب (مثل: مستمر بالخدمة، مجاز، منسب) ليتم احتساب استحقاقات الترقية والعناوين والمراحل لهذا الكادر.
                    </div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <label for="emp-status-select" style="font-size: var(--fs-caption); font-weight: 600; color: var(--text-base); white-space: nowrap;">
                        حالة الموظف:
                    </label>
                    <select id="emp-status-select"
                            class="hr-input"
                            style="min-width: 230px; font-weight: 600; padding: 0.45rem 0.75rem;"
                            value="@(selectedEmployeeStatusId?.ToString() ?? "")"
                            @onchange="OnEmployeeStatusDropdownChanged"
                            disabled="@isLoading">
                        <option value="">جميع حالات الموظفين (الكل: @cachedEmployees.Count)</option>
                        @foreach (var st in availableEmployeeStatuses)
                        {
                            int count = cachedEmployees.Count(e => e.EmployeeStatusId == st.Id);
                            <option value="@st.Id">@st.Name (@count موظف)</option>
                        }
                    </select>
                </div>

                <button type="button"
                        class="hr-btn hr-btn-primary"
                        @onclick="OnEmployeeStatusChanged"
                        disabled="@isLoading"
                        title="تنفيذ الاحتساب لكادر الحالة المحددة">
                    <Icon Name="calculator" Size="sm" />
                    <span>احتساب الكادر</span>
                </button>
            </div>
        </div>

        @* Calculation Status & Regulatory Rules Reminder *@
        <div style="margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; font-size: var(--fs-caption);">
            <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted);">
                <Icon Name="information-circle" Size="xs" Class="text-info" />
                <span>
                    الحالة المعتمدة للاحتساب: <strong style="color: var(--color-primary);">@SelectedStatusDisplayName</strong>
                    (العدد: <strong>@predictionsList.Count</strong> موظفاً مشمولاً)
                </span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <span class="hr-badge hr-badge--accent" title="الدرجات العليا 1 و2 و3 و4 و5 تتطلب إكمال 5 مراحل للترفيع">
                    الدرجات العليا (1 - 5): استحقاق بعد 5 مراحل
                </span>
                <span class="hr-badge hr-badge--subtle" title="الدرجات 6 و7 و8 و9 و10 تتطلب إكمال 4 مراحل للترفيع">
                    الدرجات (6 - 10): استحقاق بعد 4 مراحل
                </span>
            </div>
        </div>
    </div>

    @* KPI Stat Cards *@
    <div class="hr-stat-grid" style="margin-block-end: var(--s-4);">
        <div class="hr-stat-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <span class="hr-meta">إجمالي الموظفين الخاضعين</span>
                <span style="color: var(--text-muted);"><Icon Name="users" Size="sm" /></span>
            </div>
            <strong class="hr-stat-val">@predictionsList.Count</strong>
            <span class="hr-sub" style="font-size: var(--fs-caption); color: var(--text-muted);">كادر نشط مشمول بالتنبؤ</span>
        </div>

        <div class="hr-stat-card hr-stat-card--ok">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <span class="hr-meta">مستحقون للترقية الآن</span>
                <span style="color: var(--color-success);"><Icon Name="check-circle" Size="sm" /></span>
            </div>
            <strong class="hr-stat-val">@predictionsList.Count(p => p.IsDueNow)</strong>
            <span class="hr-sub" style="font-size: var(--fs-caption); color: var(--text-muted);">أكملوا المدة واستوفوا الشروط</span>
        </div>

        <div class="hr-stat-card hr-stat-card--warn">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <span class="hr-meta">قريب الاستحقاق (خلال 6 أشهر)</span>
                <span style="color: var(--color-warning);"><Icon Name="clock" Size="sm" /></span>
            </div>
            <strong class="hr-stat-val">@predictionsList.Count(p => p.IsNearDue)</strong>
            <span class="hr-sub" style="font-size: var(--fs-caption); color: var(--text-muted);">يستحقون الترفيع قريباً</span>
        </div>

        <div class="hr-stat-card hr-stat-card--accent">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <span class="hr-meta">تسكين وظيفي</span>
                <span style="color: var(--color-primary);"><Icon Name="arrow-up-right" Size="sm" /></span>
            </div>
            <strong class="hr-stat-val">@predictionsList.Count(p => p.IsStagnated)</strong>
            <span class="hr-sub" style="font-size: var(--fs-caption); color: var(--text-muted);">ترقية درجة وظيفية فقط</span>
        </div>

        <div class="hr-stat-card @(predictionsList.Any(p => p.IsDismissed || p.DelayMonths > 0) ? "hr-stat-card--danger" : "")">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <span class="hr-meta">أثر العقوبات والتأخير</span>
                <span style="color: var(--color-danger);"><Icon Name="shield-exclamation" Size="sm" /></span>
            </div>
            <strong class="hr-stat-val">@predictionsList.Count(p => p.IsDismissed || p.DelayMonths > 0)</strong>
            <span class="hr-sub" style="font-size: var(--fs-caption); color: var(--text-muted);">
                @(predictionsList.Count(p => p.IsDismissed)) حرمان عزل | @(predictionsList.Count(p => p.DelayMonths > 0 && !p.IsDismissed)) تأخير
            </span>
        </div>
    </div>

    @* Navigation Tabs *@
    <div style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border-subtle); margin-block-end: var(--s-3);">
        <button type="button"
                class="hr-btn @(activeTab == "predictions" ? "hr-btn-primary" : "hr-btn-quiet")"
                style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;"
                @onclick='() => SetActiveTab("predictions")'>
            <Icon Name="arrow-trending-up" Size="sm" />
            <span>تنبؤ استحقاق الترقية والعنوان القادم (@predictionsList.Count)</span>
        </button>
        <button type="button"
                class="hr-btn @(activeTab == "titles" ? "hr-btn-primary" : "hr-btn-quiet")"
                style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;"
                @onclick='() => SetActiveTab("titles")'>
            <Icon Name="list-bullet" Size="sm" />
            <span>دليل ومكنز العناوين الوظيفية (@jobTitlesList.Count)</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="hr-card" style="padding: 4rem 2rem; text-align: center; color: var(--text-muted);">
            <div class="hr-spin" style="display: inline-block; font-size: 2rem; margin-bottom: 1rem;">
                <Icon Name="arrow-path" Size="lg" />
            </div>
            <div style="font-size: 1.15rem; font-weight: 600; color: var(--text-base);">جارٍ معالجة السلم الوظيفي واحتساب استحقاقات الكادر...</div>
            <div style="font-size: var(--fs-caption); margin-top: 0.5rem;">
                يتم فحص تاريخ آخر علاوة، كتب الشكر (سقف 3 أشهر)، وتاريخ آخر عنوان مع العقوبات المؤخرة.
            </div>
        </div>
    }
    else if (activeTab == "predictions")
    {
        @* Filter & Search Toolbar *@
        <div class="hr-card" style="padding: 1.25rem; margin-block-end: var(--s-3);">
            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                @* Search Box *@
                <div style="flex: 1 1 240px; min-width: 220px; position: relative;">
                    <input aria-label="البحث في تنبؤات استحقاق العناوين والترقيات" type="search"
                           class="hr-input"
                           placeholder="ابحث بالاسم، الرقم الوظيفي، العنوان، أو التشكيل..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           style="padding-inline-start: 2rem; width: 100%;" />
                    <span style="position: absolute; inset-inline-start: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">
                        <Icon Name="magnifying-glass" Size="xs" />
                    </span>
                </div>

                @* Status Filter *@
                <div style="flex: 0 1 200px; min-width: 170px;">
                    <select aria-label="تصفية حسب حالة الاستحقاق" class="hr-input" @bind="statusFilter">
                        <option value="all">جميع الحالات (@predictionsList.Count)</option>
                        <option value="due_now">مستحقون الآن (@predictionsList.Count(p => p.IsDueNow))</option>
                        <option value="near_due">قريب الاستحقاق (خلال 6 أشهر) (@predictionsList.Count(p => p.IsNearDue))</option>
                        <option value="stagnated">تسكين وظيفي (@predictionsList.Count(p => p.IsStagnated))</option>
                        <option value="letters">حاصلون على كتب شكر (@predictionsList.Count(p => p.LettersCount > 0))</option>
                        <option value="capped_letters">بلغوا سقف الـ 3 أشهر (@predictionsList.Count(p => p.IsSeniorityCapped))</option>
                        <option value="penalties">متأثرون بعقوبات (@predictionsList.Count(p => p.DelayMonths > 0))</option>
                        <option value="dismissed">محروم بعقوبة عزل (@predictionsList.Count(p => p.IsDismissed))</option>
                    </select>
                </div>

                @* Grade Filter *@
                <div style="flex: 0 1 170px; min-width: 150px;">
                    <select aria-label="تصفية حسب الدرجة الوظيفية" class="hr-input" @bind="gradeFilter">
                        <option value="">جميع الدرجات الوظيفية</option>
                        @foreach (var g in availableGrades)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>

                @* Formation Filter *@
                <div style="flex: 0 1 180px; min-width: 160px;">
                    <select aria-label="تصفية حسب التشكيل الإداري" class="hr-input" @bind="formationFilter">
                        <option value="">جميع التشكيلات (@availableFormations.Count)</option>
                        @foreach (var f in availableFormations)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </div>

                @* Sort Dropdown *@
                <div style="flex: 0 1 190px; min-width: 170px;">
                    <select aria-label="ترتيب النتائج" class="hr-input" @bind="sortBy">
                        <option value="due_asc">موعد الاستحقاق (الأقرب أولاً)</option>
                        <option value="due_desc">موعد الاستحقاق (الأبعد أولاً)</option>
                        <option value="name_asc">اسم الموظف (أبجدياً)</option>
                        <option value="id_asc">الرقم الوظيفي</option>
                        <option value="seniority_desc">أعلى قِدم من كتب الشكر</option>
                        <option value="delay_desc">أعلى تأخير بالعقوبات</option>
                    </select>
                </div>

                @* Reset Filter *@
                @if (HasActiveFilters)
                {
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ClearFilters" title="إلغاء الفلاتر والبحث">
                        <Icon Name="x-mark" Size="xs" />
                        <span>إلغاء الفرز</span>
                    </button>
                }

                <div style="margin-inline-start: auto; font-size: var(--fs-caption); color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
                    <span>المطابق: <strong>@FilteredPredictions.Count</strong> من <strong>@predictionsList.Count</strong></span>
                    <span style="opacity: 0.4;">|</span>
                    <label style="display: flex; align-items: center; gap: 0.25rem;">
                        <span>عرض:</span>
                        <select aria-label="عدد السجلات في الصفحة" class="hr-input" style="padding: 0.15rem 0.5rem; width: auto; font-size: var(--fs-caption);" @bind="pageSize">
                            <option value="15">15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </label>
                </div>
            </div>

            @* Quick Technical Rule Note Banner *@
            <div style="margin-block-start: 0.75rem; padding: 0.5rem 0.75rem; background: var(--surface-sunken); border-radius: var(--radius-sm); font-size: var(--fs-caption); color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <Icon Name="information-circle" Size="xs" Class="text-info" />
                <span>
                    <strong>القاعدة الفنية المعتمدة:</strong> كتب الشكر تحتسب من تاريخ <em>آخر علاوة سنوية</em> بسقف لا يزيد عن <strong>3 أشهر</strong> | العقوبات تحصر وتؤخر ضمن <em>فترة العنوان الحالي</em> (من تاريخ آخر عنوان).
                </span>
            </div>
        </div>

        @* Main Predictions Table *@
        <div class="hr-card" style="padding: 0; overflow: hidden;">
            <div class="hr-tablewrap">
                <table class="hr-table" aria-label="جدول تنبؤ استحقاق العناوين والترقيات">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 180px;">الموظف والتشكيل</th>
                            <th scope="col" style="min-width: 160px;">العنوان الحالي والدرجة</th>
                            <th scope="col" style="min-width: 170px;">العنوان القادم المتوقع</th>
                            <th scope="col" style="min-width: 140px;">تواريخ الخدمة</th>
                            <th scope="col" style="min-width: 130px; text-align: center;">كتب الشكر (السنة)</th>
                            <th scope="col" style="min-width: 130px; text-align: center;">العقوبات (العنوان)</th>
                            <th scope="col" style="min-width: 150px;">موعد الاستحقاق</th>
                            <th scope="col" style="min-width: 160px;">حالة التنبؤ</th>
                            <th scope="col" style="min-width: 100px; text-align: center;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedPredictions.Count == 0)
                        {
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                    <Icon Name="magnifying-glass" Size="md" style="opacity: 0.5; margin-bottom: 0.5rem;" />
                                    <div>لا توجد نتائج تطابق معايير البحث والفرز المحددة</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in PagedPredictions)
                            {
                                <tr style="@(p.IsDueNow ? "background: rgba(16, 185, 129, 0.04);" : p.IsDismissed ? "background: rgba(239, 68, 68, 0.04);" : "")">
                                    @* Employee Column *@
                                    <td>
                                        <div style="font-weight: 600;">
                                            <a href="@($"employees/{p.Employee.Id}")" class="hr-link" title="فتح الملف الشخصي للموظف">
                                                @p.EmployeeName
                                            </a>
                                        </div>
                                        <div style="display: flex; gap: 0.4rem; align-items: center; margin-block-start: 0.15rem; font-size: var(--fs-caption); color: var(--text-muted); flex-wrap: wrap;">
                                            <span class="hr-badge" style="padding: 0.1rem 0.35rem; font-family: var(--font-mono, monospace);">@p.EmployeeID</span>
                                            <span class="hr-badge hr-badge--subtle" style="font-size: 0.7rem;">@p.EmployeeStatusName</span>
                                            @if (!string.IsNullOrWhiteSpace(p.FormationName))
                                            {
                                                <span class="hr-truncate" style="max-width: 130px;" title="@p.FormationName">@p.FormationName</span>
                                            }
                                        </div>
                                    </td>

                                    @* Current Title & Grade Column *@
                                    <td>
                                        <div style="font-weight: 500;">@p.JobTitleName</div>
                                        <div style="display: flex; gap: 0.25rem; align-items: center; margin-block-start: 0.15rem; font-size: var(--fs-caption);">
                                            <span class="hr-badge">@p.GradeName</span>
                                            <span class="hr-badge hr-badge--subtle">المرحلة @(p.CurrentStageNum > 0 ? p.CurrentStageNum.ToString() : p.StageName)</span>
                                        </div>
                                        <div class="hr-stage-bar" title="المرحلة @p.CurrentStageNum من @p.RequiredServiceYears (المطلوبة للترقية)">
                                            @for (int i = 1; i <= p.RequiredServiceYears; i++)
                                            {
                                                var isFilled = i <= p.CurrentStageNum;
                                                <span class="hr-stage-segment @(isFilled ? "hr-stage-segment--active" : "")"></span>
                                            }
                                        </div>
                                        <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">
                                            @p.CurrentStageNum / @p.RequiredServiceYears مراحل
                                        </div>
                                    </td>

                                    @* Next Title Column *@
                                    <td>
                                        <div style="font-weight: 600; color: var(--color-primary);">
                                            @p.NextJobTitleName
                                        </div>
                                        <div style="display: flex; gap: 0.25rem; align-items: center; margin-block-start: 0.15rem; font-size: var(--fs-caption);">
                                            @if (p.IsStagnated)
                                            {
                                                <span class="hr-badge hr-badge--accent" title="الموظف مسكّن عند السقف الوظيفي، والترقية تشمل الدرجة فقط">
                                                    تسكين وظيفي
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(p.NextGradeName))
                                            {
                                                <span class="hr-badge hr-badge--subtle">@p.NextGradeName</span>
                                            }
                                        </div>
                                    </td>

                                    @* Dates Column *@
                                    <td>
                                        <div style="font-size: var(--fs-caption); display: grid; gap: 0.15rem;">
                                            <div title="تاريخ آخر علاوة سنوية (بداية السنة الوظيفية)">
                                                <span style="color: var(--text-muted);">آخر علاوة:</span>
                                                <strong style="margin-inline-start: 0.25rem;">@(p.LastAllowanceDate?.ToString("yyyy/MM/dd") ?? "—")</strong>
                                            </div>
                                            <div title="تاريخ آخر ترقية أو عنوان وظيفي">
                                                <span style="color: var(--text-muted);">آخر عنوان:</span>
                                                <span style="margin-inline-start: 0.25rem;">@(p.LastJobTitleDate?.ToString("yyyy/MM/dd") ?? "—")</span>
                                            </div>
                                        </div>
                                    </td>

                                    @* Appreciation Letters Column *@
                                    <td style="text-align: center;">
                                        @if (p.LettersCount > 0)
                                        {
                                            <div style="display: inline-flex; flex-direction: column; align-items: center; gap: 0.15rem;">
                                                <span class="hr-badge hr-badge--ok" title="@p.LettersDetailsTooltip">
                                                    +@p.EffectiveSeniorityMonths شهر قِدم
                                                </span>
                                                @if (p.IsSeniorityCapped)
                                                {
                                                    <span style="font-size: 0.7rem; color: var(--color-warning); font-weight: 600;" title="تم تطبيق سقف الـ 3 أشهر وفق التعليمات من أصل @p.RawSeniorityMonths شهر">
                                                        سقف 3 أشهر (@p.RawSeniorityMonths)
                                                    </span>
                                                }
                                                <span style="font-size: 0.7rem; color: var(--text-muted);">
                                                    @p.LettersCount كتاب بعد العلاوة
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: var(--fs-caption);">0</span>
                                        }
                                    </td>

                                    @* Penalties Column *@
                                    <td style="text-align: center;">
                                        @if (p.IsDismissed)
                                        {
                                            <span class="hr-badge hr-badge--danger" title="عقوبة عزل تمنع الترفيع نهائياً">
                                                عقوبة عزل
                                            </span>
                                        }
                                        else if (p.PenaltiesCount > 0)
                                        {
                                            <div style="display: inline-flex; flex-direction: column; align-items: center; gap: 0.15rem;">
                                                <span class="hr-badge hr-badge--danger" title="@p.PenaltiesSummary">
                                                    -@p.DelayMonths شهر تأخير
                                                </span>
                                                <span style="font-size: 0.7rem; color: var(--text-muted);">
                                                    @p.PenaltiesCount عقوبة بعد العنوان
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: var(--fs-caption);">0</span>
                                        }
                                    </td>

                                    @* Predicted Due Date Column *@
                                    <td>
                                        @if (p.IsDismissed)
                                        {
                                            <span style="color: var(--color-danger); font-weight: 600; font-size: var(--fs-caption);">
                                                محظور من الترفيع
                                            </span>
                                        }
                                        else if (p.PredictedDueDate.HasValue)
                                        {
                                            <div style="font-family: var(--font-mono, monospace); font-weight: 700; font-size: 0.95rem; color: @(p.IsDueNow ? "var(--color-success)" : "var(--text-base)");">
                                                @p.PredictedDueDate.Value.ToString("yyyy/MM/dd")
                                            </div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">
                                                سُلّم: @p.RequiredServiceYears سنوات (مرحلة @p.RequiredServiceYears)
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">—</span>
                                        }
                                    </td>

                                    @* Prediction Status Badge Column *@
                                    <td>
                                        @if (p.IsDueNow)
                                        {
                                            <span class="hr-badge hr-badge--ok" style="font-weight: 600;">
                                                <Icon Name="check" Size="xs" />
                                                <span>@p.Status</span>
                                            </span>
                                        }
                                        else if (p.IsNearDue)
                                        {
                                            <span class="hr-badge hr-badge--warn" style="font-weight: 600;">
                                                <Icon Name="clock" Size="xs" />
                                                <span>@p.Status</span>
                                            </span>
                                        }
                                        else if (p.IsDismissed)
                                        {
                                            <span class="hr-badge hr-badge--danger" style="font-weight: 600;">
                                                <Icon Name="no-symbol" Size="xs" />
                                                <span>@p.Status</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge hr-badge--subtle">
                                                @p.Status
                                            </span>
                                        }
                                    </td>

                                    @* Actions Column *@
                                    <td style="text-align: center;">
                                        <button type="button"
                                                class="hr-btn hr-btn-secondary hr-btn-xs"
                                                @onclick="() => OpenCalculationDetails(p)"
                                                title="عرض رسم التايم لاين والتقرير الرياضي للاحتساب">
                                            <Icon Name="arrow-trending-up" Size="xs" />
                                            <span>التايم لاين</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination Footer *@
            @if (totalPages > 1)
            {
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1.25rem; border-top: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 0.5rem;">
                    <div style="font-size: var(--fs-caption); color: var(--text-muted);">
                        عرض السجلات من <strong>@((currentPage - 1) * pageSize + 1)</strong> إلى <strong>@(Math.Min(currentPage * pageSize, FilteredPredictions.Count))</strong> من أصل <strong>@FilteredPredictions.Count</strong>
                    </div>
                    <div style="display: flex; gap: 0.25rem; align-items: center;">
                        <button type="button"
                                class="hr-btn hr-btn-secondary hr-btn-sm"
                                disabled="@(currentPage == 1)"
                                @onclick="() => ChangePage(currentPage - 1)">
                            <Icon Name="chevron-right" Size="xs" />
                            <span>السابق</span>
                        </button>
                        <span style="font-size: var(--fs-caption); padding: 0 0.5rem;">
                            صفحة <strong>@currentPage</strong> من <strong>@totalPages</strong>
                        </span>
                        <button type="button"
                                class="hr-btn hr-btn-secondary hr-btn-sm"
                                disabled="@(currentPage == totalPages)"
                                @onclick="() => ChangePage(currentPage + 1)">
                            <span>التالي</span>
                            <Icon Name="chevron-left" Size="xs" />
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* Tab 2: Job Titles Dictionary & Classifications *@
        <div class="hr-card" style="padding: 1.25rem; margin-block-end: var(--s-3);">
            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                <div style="flex: 1 1 240px; min-width: 220px; position: relative;">
                    <input aria-label="البحث في دليل العناوين الوظيفية" type="search"
                           class="hr-input"
                           placeholder="ابحث بالرمز، العنوان، العائلة الوظيفية، أو الدرجة..."
                           @bind="titleSearchQuery"
                           @bind:event="oninput"
                           style="padding-inline-start: 2rem; width: 100%;" />
                    <span style="position: absolute; inset-inline-start: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">
                        <Icon Name="magnifying-glass" Size="xs" />
                    </span>
                </div>
                <div style="margin-inline-start: auto; font-size: var(--fs-caption); color: var(--text-muted);">
                    عدد العناوين: <strong>@FilteredJobTitles.Count</strong>
                </div>
            </div>
        </div>

        <div class="hr-card" style="padding: 0; overflow: hidden;">
            <div class="hr-tablewrap">
                <table class="hr-table" aria-label="جدول دليل ومكنز العناوين الوظيفية">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 100px;">الرمز</th>
                            <th scope="col" style="min-width: 200px;">العنوان الوظيفي</th>
                            <th scope="col" style="min-width: 160px;">العائلة الوظيفية</th>
                            <th scope="col" style="min-width: 120px;">الدرجة المعتمدة</th>
                            <th scope="col" style="min-width: 130px; text-align: center;">عدد الكادر المشغول</th>
                            <th scope="col" style="min-width: 180px;">الكادر المرتبط</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredJobTitles.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                    لا توجد عناوين وظيفية مطابقة
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var jt in FilteredJobTitles)
                            {
                                <tr>
                                    <td><span class="hr-badge" style="font-family: var(--font-mono, monospace);">@(jt.Code ?? "—")</span></td>
                                    <td style="font-weight: 600;">@jt.Name</td>
                                    <td>@(jt.JobFamily?.Name ?? "—")</td>
                                    <td>
                                        <span class="hr-badge hr-badge--subtle">@(jt.Grade?.Name ?? "—")</span>
                                    </td>
                                    <td style="text-align: center;">
                                        <strong>@jt.Employees.Count</strong>
                                    </td>
                                    <td>
                                        @if (jt.Employees.Count > 0)
                                        {
                                            <details>
                                                <summary style="cursor: pointer; color: var(--color-primary); font-size: var(--fs-caption); font-weight: 500;">
                                                    استعراض (@jt.Employees.Count موظف)
                                                </summary>
                                                <ul style="max-height: 120px; overflow-y: auto; padding-inline-start: 1rem; margin: 0.25rem 0; font-size: var(--fs-caption);">
                                                    @foreach (var emp in jt.Employees.Take(25))
                                                    {
                                                        <li>
                                                            <a href="@($"employees/{emp.Id}")" class="hr-link">@emp.Name</a>
                                                            <span style="color: var(--text-muted);">(@emp.EmployeeID)</span>
                                                        </li>
                                                    }
                                                    @if (jt.Employees.Count > 25)
                                                    {
                                                        <li style="color: var(--text-muted); font-style: italic;">... والمزيد</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: var(--fs-caption);">لا يوجد كادر حالياً</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Calculation Breakdown Modal / Drawer *@
@if (selectedEmployeePrediction != null)
{
    var p = selectedEmployeePrediction;
    <div class="hr-modal-scrim" @onclick="CloseCalculationDetails" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; padding: 1rem;">
        <div class="hr-card" @onclick:stopPropagation="true" style="width: 100%; max-width: 800px; max-height: 90vh; overflow-y: auto; background: var(--surface-raised, #fff); border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); padding: 1.5rem; position: relative;">
            
            @* Modal Header *@
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; margin-bottom: 1.25rem;">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="hr-badge hr-badge--accent">تفصيل الاحتساب الفني</span>
                        <span class="hr-badge" style="font-family: var(--font-mono, monospace);">@p.EmployeeID</span>
                    </div>
                    <h2 class="hr-h2" style="margin: 0.35rem 0 0 0;">@p.EmployeeName</h2>
                    <div style="font-size: var(--fs-caption); color: var(--text-muted); margin-top: 0.2rem;">
                        @p.FormationName | العنوان الحالي: <strong>@p.JobTitleName</strong> (@p.GradeName - @p.StageName)
                    </div>
                </div>
                <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm" @onclick="CloseCalculationDetails" aria-label="إغلاق">
                    <Icon Name="x-mark" Size="sm" />
                </button>
            </div>

            @* Technical Blocks *@
            <div style="display: grid; gap: 1rem;">
                @* 1. Stage-by-Stage Visual Timeline Diagram (رسم تايم لاين من المرحلة الحالية) *@
                <div class="hr-timeline-container">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                        <div style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem; color: var(--color-primary); font-size: 1rem;">
                            <Icon Name="arrow-trending-up" Size="sm" />
                            <span>رسم التايم لاين لاحتساب الاستحقاق (من المرحلة الحالية @p.CurrentStageNum إلى الترفيع)</span>
                        </div>
                        <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
                            <span class="hr-badge @(p.CurrentGradeNum <= 5 ? "hr-badge--accent" : "hr-badge--subtle")">
                                @(p.CurrentGradeNum <= 5 ? "درجات عليا (1-5): استحقاق بعد 5 مراحل" : "درجات (6-10): استحقاق بعد 4 مراحل")
                            </span>
                            <span class="hr-badge hr-badge--subtle">حالة الموظف: @p.EmployeeStatusName</span>
                        </div>
                    </div>

                    <div style="font-size: var(--fs-caption); color: var(--text-muted);">
                        رسم بياني زمني يوضح كيفية احتساب الاستحقاق مرحلة بمرحلة انطلاقاً من المرحلة التي يشغلها الموظف حالياً (@p.CurrentStageNum) وحتى بلوغ المرحلة المؤهلة للترفيع (@p.RequiredServiceYears مراحل)، مع تطبيق أثر كتب الشكر والعقوبات حتى الموعد النهائي.
                    </div>

                    @* Timeline Flow *@
                    <div class="hr-timeline-flow">
                        @for (int i = 0; i < p.TimelineSteps.Count; i++)
                        {
                            var step = p.TimelineSteps[i];
                            var nodeClass = step.StepType switch
                            {
                                "current" => "hr-timeline-node--current",
                                "qualifying" => "hr-timeline-node--qualifying",
                                "bonus" => "hr-timeline-node--bonus",
                                "penalty" => "hr-timeline-node--penalty",
                                "target" => "hr-timeline-node--target",
                                "blocked" => "hr-timeline-node--blocked",
                                _ => ""
                            };

                            <div class="hr-timeline-node @nodeClass">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.25rem;">
                                    <span class="hr-badge @step.BadgeClass" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;">
                                        @step.BadgeText
                                    </span>
                                    <span style="color: var(--text-muted);"><Icon Name="@step.IconName" Size="xs" /></span>
                                </div>

                                <div style="font-weight: 700; font-size: 0.85rem; color: var(--text-base); margin-top: 0.2rem;">
                                    @step.Title
                                </div>

                                <div style="font-size: 0.75rem; color: var(--text-muted);">
                                    @step.Subtitle
                                </div>

                                @if (step.EstimatedDate.HasValue)
                                {
                                    <div style="margin-top: auto; padding-top: 0.4rem; border-top: 1px dashed var(--border-subtle); display: flex; align-items: center; justify-content: space-between; font-family: var(--font-mono, monospace); font-size: 0.8rem; font-weight: 600;">
                                        <span style="color: var(--text-muted); font-size: 0.7rem;">التاريخ:</span>
                                        <span style="color: @(step.IsTarget ? "var(--color-success)" : "var(--text-base)");">
                                            @step.EstimatedDate.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    </div>
                                }

                                <div style="font-size: 0.7rem; color: var(--text-muted); line-height: 1.25;">
                                    @step.Description
                                </div>
                            </div>

                            @if (i < p.TimelineSteps.Count - 1)
                            {
                                <div class="hr-timeline-arrow" aria-hidden="true">
                                    <span style="font-weight: bold; opacity: 0.6;">←</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                @* 2. Scale and Target *@
                <div style="background: var(--surface-sunken); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                    <div style="font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; color: var(--color-primary);">
                        <Icon Name="chart-bar" Size="xs" />
                        <span>2. متطلبات السلم الوظيفي والعنوان القادم</span>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: var(--fs-caption);">
                        <div>سنوات الخدمة المقررة بالدرجة: <strong>@p.RequiredServiceYears سنوات</strong></div>
                        <div>المرحلة المؤهلة للترفيع: <strong>المرحلة @p.RequiredServiceYears</strong></div>
                        <div>العنوان القادم المتوقع: <strong>@p.NextJobTitleName</strong></div>
                        <div>الدرجة القادمة: <strong>@p.NextGradeName</strong></div>
                    </div>
                </div>

                @* 3. Appreciation Letters (Active Allowance Year) *@
                <div style="background: var(--surface-sunken); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <div style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem; color: var(--color-success);">
                            <Icon Name="document-text" Size="xs" />
                            <span>3. كتب الشكر والقِدم (السنة الوظيفية الحالية)</span>
                        </div>
                        <span class="hr-badge hr-badge--ok">
                            القِدم المعتمد: @p.EffectiveSeniorityMonths أشهر
                        </span>
                    </div>

                    <div style="font-size: var(--fs-caption); margin-bottom: 0.5rem; color: var(--text-muted);">
                        تاريخ بداية السنة الوظيفية: <strong>@(p.AllowancePeriodStartDate?.ToString("yyyy/MM/dd") ?? "غير محدد")</strong> (تاريخ آخر علاوة سنوية).
                    </div>

                    @if (p.LettersAfterAllowance.Count > 0)
                    {
                        <div class="hr-tablewrap" style="max-height: 180px; overflow-y: auto;">
                            <table class="hr-table" style="font-size: var(--fs-caption);">
                                <thead>
                                    <tr>
                                        <th>رقم/تاريخ الكتاب</th>
                                        <th>نوع الشكر</th>
                                        <th>العدد</th>
                                        <th>القِدم المحسوب</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in p.LettersAfterAllowance)
                                    {
                                        <tr>
                                            <td>@(l.LetterNumber ?? "بدون رقم") - @(l.LetterDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                                            <td>@(l.Type?.Name ?? "كتاب شكر عام")</td>
                                            <td>@(l.Count ?? 1)</td>
                                            <td>+@(CalculateLetterSeniority(l)) شهر</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top: 0.5rem; padding: 0.5rem; background: rgba(16, 185, 129, 0.08); border-radius: var(--radius-sm); font-size: var(--fs-caption);">
                            مجموع القِدم الفعلي المكتسب: <strong>@p.RawSeniorityMonths شهر</strong>.
                            @if (p.IsSeniorityCapped)
                            {
                                <span style="color: var(--color-warning); font-weight: 600;">
                                    (تم تقييده بسقف 3 أشهر كحد أقصى وفق التعليمات الرسمية).
                                </span>
                            }
                            else
                            {
                                <span>(تم اعتماد كامل القِدم لعدم تجاوزه سقف الـ 3 أشهر).</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="font-size: var(--fs-caption); color: var(--text-muted); padding: 0.5rem 0;">
                            لم تسجل كتب شكر صادرة بعد تاريخ آخر علاوة.
                        </div>
                    }
                </div>

                @* 4. Penalties (Job Title Period) *@
                <div style="background: var(--surface-sunken); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <div style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem; color: var(--color-danger);">
                            <Icon Name="shield-exclamation" Size="xs" />
                            <span>4. العقوبات والتأخير (فترة العنوان الوظيفي الحالي)</span>
                        </div>
                        <span class="hr-badge @(p.IsDismissed || p.DelayMonths > 0 ? "hr-badge--danger" : "hr-badge--subtle")">
                            @(p.IsDismissed ? "حرمان عزل" : $"تأخير {p.DelayMonths} شهر")
                        </span>
                    </div>

                    <div style="font-size: var(--fs-caption); margin-bottom: 0.5rem; color: var(--text-muted);">
                        تاريخ بداية فترة العنوان: <strong>@(p.TitlePeriodStartDate?.ToString("yyyy/MM/dd") ?? "غير محدد")</strong> (تاريخ آخر تغيير للعنوان الوظيفي).
                    </div>

                    @if (p.PenaltiesAfterTitle.Count > 0)
                    {
                        <div class="hr-tablewrap" style="max-height: 180px; overflow-y: auto;">
                            <table class="hr-table" style="font-size: var(--fs-caption);">
                                <thead>
                                    <tr>
                                        <th>رقم/تاريخ العقوبة</th>
                                        <th>نوع العقوبة</th>
                                        <th>أثر التأخير</th>
                                        <th>الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pen in p.PenaltiesAfterTitle)
                                    {
                                        <tr>
                                            <td>@(pen.OrderNumber ?? "بدون رقم") - @(pen.PenaltyDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                                            <td><strong>@(pen.PenaltyType?.Name ?? "عقوبة انضباطية")</strong></td>
                                            <td>
                                                @{
                                                    var imp = PenaltyTypeDataSeeder.CalculateImpact(pen.PenaltyType, pen.Notes);
                                                }
                                                @if (imp.IsBarredFromPromotion)
                                                {
                                                    <span style="color: var(--color-danger); font-weight: bold;">عزل (حرمان دائم)</span>
                                                }
                                                else
                                                {
                                                    <span>تأخير @imp.DelayMonths شهر</span>
                                                }
                                            </td>
                                            <td style="color: var(--text-muted);">@(pen.Notes ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="font-size: var(--fs-caption); color: var(--text-muted); padding: 0.5rem 0;">
                            لا توجد عقوبات مسجلة ضمن فترة العنوان الحالي للموظف.
                        </div>
                    }
                </div>

                @* 5. Final Equation Walkthrough *@
                <div style="background: var(--surface-raised); border: 2px solid var(--color-primary); padding: 1.25rem; border-radius: var(--radius-md);">
                    <div style="font-weight: 700; margin-bottom: 0.75rem; color: var(--color-primary); display: flex; align-items: center; gap: 0.5rem;">
                        <Icon Name="calculator" Size="sm" />
                        <span>5. المعادلة الرياضية والنتيجة النهائية</span>
                    </div>

                    @if (p.IsDismissed)
                    {
                        <div style="padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border-radius: var(--radius-sm); color: var(--color-danger); font-weight: 600;">
                            الموظف محروم من الترفيع وتغيير العنوان بصورة نهائية بسبب صدور عقوبة عزل.
                        </div>
                    }
                    else if (p.BaseDueDate.HasValue)
                    {
                        <div style="display: grid; gap: 0.5rem; font-size: var(--fs-caption);">
                            <div style="display: flex; justify-content: space-between;">
                                <span>تاريخ الاستحقاق الأساسي (حسب السلم وتاريخ العلاوة):</span>
                                <strong style="font-family: var(--font-mono, monospace);">@p.BaseDueDate.Value.ToString("yyyy/MM/dd")</strong>
                            </div>
                            <div style="display: flex; justify-content: space-between; color: var(--color-success);">
                                <span>خصم القِدم (كتب الشكر ضمن السنة - سقف 3 أشهر):</span>
                                <strong>- @p.EffectiveSeniorityMonths شهر</strong>
                            </div>
                            <div style="display: flex; justify-content: space-between; color: var(--color-danger);">
                                <span>إضافة تأخير العقوبات (ضمن فترة العنوان الحالي):</span>
                                <strong>+ @p.DelayMonths شهر</strong>
                            </div>
                            <div style="height: 1px; background: var(--border-subtle); margin: 0.25rem 0;"></div>
                            <div style="display: flex; justify-content: space-between; font-size: 1.05rem; font-weight: 700; color: var(--text-base);">
                                <span>موعد الاستحقاق المتوقع النهائي:</span>
                                <span style="font-family: var(--font-mono, monospace); color: @(p.IsDueNow ? "var(--color-success)" : "var(--color-primary)");">
                                    @(p.PredictedDueDate?.ToString("yyyy/MM/dd") ?? "—")
                                </span>
                            </div>
                            <div style="margin-top: 0.5rem; text-align: center;">
                                <span class="hr-badge @(p.IsDueNow ? "hr-badge--ok" : p.IsNearDue ? "hr-badge--warn" : "hr-badge--subtle")" style="font-size: var(--fs-body); padding: 0.35rem 1rem;">
                                    @p.Status
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="color: var(--text-muted); font-size: var(--fs-caption);">
                            تعذر احتساب موعد الاستحقاق لعدم توفر تاريخ آخر علاوة أو تاريخ آخر عنوان أو تاريخ التعيين للموظف.
                        </div>
                    }
                </div>
            </div>

            @* Modal Footer *@
            <div style="margin-top: 1.5rem; text-align: end;">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseCalculationDetails">
                    إغلاق النافذة
                </button>
            </div>
        </div>
    </div>
}

@code {
    private ApplicationDbContext context = default!;
    private List<JobTitle> jobTitlesList = new();
    private List<SalaryScale> salaryScalesList = new();
    private List<EmployeePrediction> predictionsList = new();
    private List<Employee> cachedEmployees = new();
    private List<EmployeeStatus> availableEmployeeStatuses = new();
    private int? selectedEmployeeStatusId;
    private bool statusInitialized = false;

    private string activeTab = "predictions";
    private bool isLoading = true;

    // Filters & Sorting state
    private string searchQuery = "";
    private string statusFilter = "all";
    private string gradeFilter = "";
    private string formationFilter = "";
    private string sortBy = "due_asc";
    private int pageSize = 25;
    private int currentPage = 1;

    // Titles Tab state
    private string titleSearchQuery = "";

    // Detail Modal state
    private EmployeePrediction? selectedEmployeePrediction;

    // Distinct lists for dropdowns
    private List<string> availableGrades = new();
    private List<string> availableFormations = new();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        statusFilter != "all" ||
        !string.IsNullOrWhiteSpace(gradeFilter) ||
        !string.IsNullOrWhiteSpace(formationFilter) ||
        sortBy != "due_asc";

    public sealed class TimelineStageStep
    {
        public int StageNumber { get; set; }
        public string Title { get; set; } = "";
        public string Subtitle { get; set; } = "";
        public DateOnly? EstimatedDate { get; set; }
        public string StepType { get; set; } = "normal"; // "current", "upcoming", "qualifying", "bonus", "penalty", "target", "blocked"
        public string BadgeText { get; set; } = "";
        public string BadgeClass { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconName { get; set; } = "clock";
        public bool IsCurrent { get; set; }
        public bool IsQualifying { get; set; }
        public bool IsTarget { get; set; }
    }

    public sealed class EmployeePrediction
    {
        public Employee Employee { get; set; } = null!;
        public string EmployeeName => Employee.Name;
        public string EmployeeID => Employee.EmployeeID;
        public string FormationName => Employee.Formation?.Name ?? Employee.FirstDepartment ?? "";
        public string EmployeeStatusName => Employee.EmployeeStatus?.Name ?? "مستمر بالخدمة";
        public string JobTitleName { get; set; } = "";
        public string NextJobTitleName { get; set; } = "";
        public string NextGradeName { get; set; } = "";
        public string GradeName { get; set; } = "";
        public string StageName { get; set; } = "";
        public int CurrentGradeNum { get; set; }
        public int CurrentStageNum { get; set; }
        public DateOnly? LastJobTitleDate { get; set; }
        public DateOnly? LastAllowanceDate { get; set; }
        public DateOnly? HireDate { get; set; }

        public DateOnly? AllowancePeriodStartDate { get; set; }
        public DateOnly? TitlePeriodStartDate { get; set; }

        public int RequiredServiceYears { get; set; } = 4;
        public bool IsStagnated { get; set; } = false;

        // Appreciation letters in active allowance year
        public List<AppreciationLetter> LettersAfterAllowance { get; set; } = new();
        public int LettersCount { get; set; }
        public int RawSeniorityMonths { get; set; }
        public int EffectiveSeniorityMonths { get; set; }
        public bool IsSeniorityCapped => RawSeniorityMonths > 3;
        public string LettersDetailsTooltip { get; set; } = "";

        // Penalties in active title period
        public List<EmployeePenalty> PenaltiesAfterTitle { get; set; } = new();
        public int PenaltiesCount { get; set; }
        public int DelayMonths { get; set; }
        public bool IsDismissed { get; set; }
        public string PenaltiesSummary { get; set; } = "";

        // Calculation result
        public DateOnly? BaseDueDate { get; set; }
        public DateOnly? PredictedDueDate { get; set; }
        public string Status { get; set; } = "";

        // Visual Timeline steps
        public List<TimelineStageStep> TimelineSteps { get; set; } = new();

        public bool IsDueNow => Status.Contains("مستحق الآن");
        public bool IsNearDue => Status.Contains("قريب الاستحقاق");
    }

    private string SelectedStatusDisplayName =>
        selectedEmployeeStatusId.HasValue
            ? availableEmployeeStatuses.FirstOrDefault(s => s.Id == selectedEmployeeStatusId.Value)?.Name ?? "الحالة المحددة"
            : "جميع حالات الموظفين (الكل)";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            if (context != null)
            {
                await context.DisposeAsync();
            }

            context = DbFactory.CreateDbContext();

            // Seed reference data if needed
            if (!await context.SalaryScales.AnyAsync())
            {
                await API.HR.Node.Services.Salary.SalaryScaleDataSeeder.SeedAsync(context);
            }
            if (!await context.PenaltyTypes.AnyAsync())
            {
                await PenaltyTypeDataSeeder.SeedAsync(context);
            }

            salaryScalesList = await context.SalaryScales.AsNoTracking().ToListAsync();

            jobTitlesList = await context.JobTitles
                .AsNoTracking()
                .Include(j => j.JobFamily)
                .Include(j => j.Grade)
                .Include(j => j.Employees)
                .ToListAsync();

            availableEmployeeStatuses = await context.EmployeeStatuses
                .AsNoTracking()
                .OrderBy(s => s.Name)
                .ToListAsync();

            if (!statusInitialized)
            {
                var defaultStatus = availableEmployeeStatuses.FirstOrDefault(s => s.Name.Contains("مستمر") || s.Name.Contains("فعال"));
                if (defaultStatus != null)
                {
                    selectedEmployeeStatusId = defaultStatus.Id;
                }
                statusInitialized = true;
            }

            cachedEmployees = await context.Employees
                .AsNoTracking()
                .Where(e => !e.IsArchived)
                .Include(e => e.EmployeeStatus)
                .Include(e => e.JobTitle)
                    .ThenInclude(j => j!.JobFamily)
                .Include(e => e.JobTitle)
                    .ThenInclude(j => j!.Grade)
                .Include(e => e.Grade)
                .Include(e => e.Stage)
                .Include(e => e.Formation)
                .Include(e => e.AppreciationLetters)
                    .ThenInclude(l => l.Type)
                .Include(e => e.Penalties)
                    .ThenInclude(p => p.PenaltyType)
                .ToListAsync();

            ExecuteCalculation();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر جلب واحتساب بيانات العناوين: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnEmployeeStatusDropdownChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out var id))
        {
            selectedEmployeeStatusId = id;
        }
        else
        {
            selectedEmployeeStatusId = null;
        }
        OnEmployeeStatusChanged();
    }

    private void OnEmployeeStatusChanged()
    {
        ExecuteCalculation();
        currentPage = 1;
        StateHasChanged();
    }

    private void ExecuteCalculation()
    {
        var targetEmployees = selectedEmployeeStatusId.HasValue
            ? cachedEmployees.Where(e => e.EmployeeStatusId == selectedEmployeeStatusId.Value).ToList()
            : cachedEmployees;

        CalculatePredictions(targetEmployees);

        // Populate filters
        availableGrades = predictionsList
            .Select(p => p.GradeName)
            .Where(g => !string.IsNullOrWhiteSpace(g) && g != "غير محدد")
            .Distinct()
            .OrderBy(g => g)
            .ToList();

        availableFormations = predictionsList
            .Select(p => p.FormationName)
            .Where(f => !string.IsNullOrWhiteSpace(f))
            .Distinct()
            .OrderBy(f => f)
            .ToList();
    }

    private void CalculatePredictions(List<Employee> employees)
    {
        predictionsList.Clear();
        var today = DateOnly.FromDateTime(DateTime.Today);

        foreach (var emp in employees)
        {
            var currentTitleName = emp.JobTitle?.Name ?? "غير محدد";
            var pred = new EmployeePrediction
            {
                Employee = emp,
                JobTitleName = currentTitleName,
                GradeName = emp.Grade?.Name ?? emp.JobTitle?.Grade?.Name ?? "غير محدد",
                StageName = emp.Stage?.Name ?? "غير محدد",
                LastJobTitleDate = emp.LastJobTitleDate,
                LastAllowanceDate = emp.LastAllowanceDate,
                HireDate = emp.HireDate
            };

            // 1. تحديد الدرجة الحالية والمرحلة الحالية كأرقام
            int currentGradeNum = ParseGradeNumber(emp.Grade?.Code ?? emp.JobTitle?.Grade?.Code ?? pred.GradeName);
            int currentStageNum = ParseStageNumber(emp.Stage?.Code ?? emp.Stage?.Name);
            pred.CurrentGradeNum = currentGradeNum;
            pred.CurrentStageNum = currentStageNum;

            // 2. سنوات الخدمة والمراحل المقررة في الدرجة (استحقاق العنوان):
            // يكون بعد خمس مراحل في الدرجات العليا من 1-5، ويكون 4 مراحل في الدرجات من 6-10
            int reqYears;
            if (currentGradeNum >= 1 && currentGradeNum <= 5)
            {
                // الدرجات العليا 1 - 5: خمس مراحل (5 سنوات)
                reqYears = 5;
            }
            else if (currentGradeNum >= 6 && currentGradeNum <= 10)
            {
                // الدرجات من 6 - 10: أربع مراحل (4 سنوات)
                reqYears = 4;
            }
            else
            {
                var scale = salaryScalesList.FirstOrDefault(s =>
                    (emp.GradeId.HasValue && s.GradeId == emp.GradeId.Value) ||
                    (!string.IsNullOrWhiteSpace(emp.Grade?.Code) && s.GradeCode == emp.Grade.Code) ||
                    (currentGradeNum > 0 && s.GradeCode == currentGradeNum.ToString()));

                reqYears = (scale?.RequiredServiceYears.HasValue == true) ? scale.RequiredServiceYears.Value : 4;
            }

            pred.RequiredServiceYears = reqYears;
            int qualifyingStage = reqYears;

            // 3. فحص التسكين الوظيفي والعنوان القادم
            if (currentGradeNum > 1)
            {
                int nextGradeNum = currentGradeNum - 1; // الترفيع يصعد إلى الدرجة الأعلى رقماً أصغر
                pred.NextGradeName = $"الدرجة {nextGradeNum}";

                if (IsCeilingTitle(currentTitleName))
                {
                    pred.IsStagnated = true;
                    pred.NextJobTitleName = currentTitleName; // يبقى نفس العنوان مسكناً
                    pred.NextGradeName = $"الدرجة {nextGradeNum} (تسكين وظيفي)";
                }
                else
                {
                    var familyId = emp.JobTitle?.JobFamilyId;
                    JobTitle? nextTitle = null;

                    if (familyId.HasValue)
                    {
                        nextTitle = jobTitlesList.FirstOrDefault(j =>
                            j.JobFamilyId == familyId.Value &&
                            ((j.Grade != null && (j.Grade.Code == nextGradeNum.ToString() || ParseGradeNumber(j.Grade.Name) == nextGradeNum)) ||
                             j.Code == nextGradeNum.ToString()));
                    }

                    if (nextTitle == null)
                    {
                        nextTitle = FindNextTitleFromList(currentTitleName, nextGradeNum);
                    }

                    pred.NextJobTitleName = nextTitle != null
                        ? nextTitle.Name
                        : PredictStandardNextTitle(currentTitleName, nextGradeNum);
                }
            }
            else if (currentGradeNum == 1)
            {
                pred.IsStagnated = true;
                pred.NextGradeName = "الدرجة العليا / نهاية السلم";
                pred.NextJobTitleName = "الدرجة العليا أ / ب (أعلى السلم)";
            }
            else
            {
                pred.NextGradeName = "غير محدد";
                pred.NextJobTitleName = "يتطلب تحديد درجة الموظف";
            }

            // 4. كتب الشكر: حسب السنة الوظيفية (تاريخ آخر علاوة) بما لا يزيد عن 3 أشهر كقِدم
            var letterStartDate = emp.LastAllowanceDate ?? emp.LastJobTitleDate ?? emp.HireDate;
            pred.AllowancePeriodStartDate = letterStartDate;

            if (letterStartDate.HasValue)
            {
                pred.LettersAfterAllowance = emp.AppreciationLetters
                    .Where(l => l.LetterDate.HasValue && l.LetterDate.Value >= letterStartDate.Value)
                    .OrderByDescending(l => l.LetterDate)
                    .ToList();
            }
            else
            {
                pred.LettersAfterAllowance = emp.AppreciationLetters.OrderByDescending(l => l.LetterDate).ToList();
            }

            pred.LettersCount = pred.LettersAfterAllowance.Sum(l => l.Count ?? 1);

            int rawSeniority = 0;
            var letterTooltipParts = new List<string>();
            foreach (var l in pred.LettersAfterAllowance)
            {
                int count = l.Count ?? 1;
                if (count <= 0) count = 1;
                int monthsFromSingle = CalculateLetterSeniority(l);
                rawSeniority += monthsFromSingle;
                letterTooltipParts.Add($"{l.LetterDate?.ToString("yyyy/MM/dd")}: +{monthsFromSingle} شهر ({l.Type?.Name ?? "شكر"})");
            }
            pred.RawSeniorityMonths = rawSeniority;
            // سقف الـ 3 أشهر وفق التعليمات
            pred.EffectiveSeniorityMonths = Math.Min(3, rawSeniority);
            pred.LettersDetailsTooltip = string.Join(" | ", letterTooltipParts);

            // 5. العقوبات: تحصر ضمن فترة العنوان (من تاريخ آخر عنوان)
            var titleStartDate = emp.LastJobTitleDate ?? emp.HireDate;
            pred.TitlePeriodStartDate = titleStartDate;

            if (titleStartDate.HasValue)
            {
                pred.PenaltiesAfterTitle = emp.Penalties
                    .Where(p => p.PenaltyDate.HasValue && p.PenaltyDate.Value >= titleStartDate.Value)
                    .OrderByDescending(p => p.PenaltyDate)
                    .ToList();
            }
            else
            {
                pred.PenaltiesAfterTitle = emp.Penalties.OrderByDescending(p => p.PenaltyDate).ToList();
            }

            pred.PenaltiesCount = pred.PenaltiesAfterTitle.Count;
            int delayMonths = 0;
            bool isDismissed = false;
            var penSummaryList = new List<string>();

            foreach (var p in pred.PenaltiesAfterTitle)
            {
                var impact = PenaltyTypeDataSeeder.CalculateImpact(p.PenaltyType, p.Notes);
                if (impact.IsBarredFromPromotion)
                {
                    isDismissed = true;
                    penSummaryList.Add("عقوبة عزل (حرمان من الترفيع)");
                    break;
                }

                delayMonths += impact.DelayMonths;
                if (impact.DelayMonths > 0)
                {
                    penSummaryList.Add($"{p.PenaltyType?.Name ?? "عقوبة"}: تأخير {impact.DelayMonths} شهر");
                }
            }

            pred.DelayMonths = delayMonths;
            pred.IsDismissed = isDismissed;
            pred.PenaltiesSummary = string.Join(" | ", penSummaryList);

            // 6. احتساب موعد الاستحقاق المتوقع ورسم التايم لاين
            DateOnly? baseDueDate = null;

            if (isDismissed)
            {
                pred.BaseDueDate = null;
                pred.PredictedDueDate = null;
                pred.Status = "محظور من الترفيع (عقوبة عزل)";
            }
            else
            {
                // أ) إذا توفر تاريخ آخر علاوة:
                if (emp.LastAllowanceDate.HasValue)
                {
                    if (currentStageNum >= qualifyingStage)
                    {
                        baseDueDate = emp.LastAllowanceDate.Value.AddYears(1);
                    }
                    else if (currentStageNum > 0)
                    {
                        int remainingStages = Math.Max(1, qualifyingStage - currentStageNum);
                        baseDueDate = emp.LastAllowanceDate.Value.AddYears(remainingStages);
                    }
                    else
                    {
                        baseDueDate = emp.LastAllowanceDate.Value.AddYears(1);
                    }
                }
                // ب) إذا لم يتوفر تاريخ العلاوة ولكن توفر تاريخ آخر عنوان:
                else if (emp.LastJobTitleDate.HasValue)
                {
                    if (currentStageNum >= qualifyingStage)
                    {
                        baseDueDate = emp.LastJobTitleDate.Value.AddYears(1);
                    }
                    else if (currentStageNum > 0)
                    {
                        int remainingStages = Math.Max(1, qualifyingStage - currentStageNum);
                        baseDueDate = emp.LastJobTitleDate.Value.AddYears(remainingStages);
                    }
                    else
                    {
                        baseDueDate = emp.LastJobTitleDate.Value.AddYears(reqYears);
                    }
                }
                // ج) الاعتماد على تاريخ التعيين كبديل أخير:
                else if (emp.HireDate.HasValue)
                {
                    baseDueDate = emp.HireDate.Value.AddYears(reqYears);
                }

                pred.BaseDueDate = baseDueDate;

                if (baseDueDate.HasValue)
                {
                    // تطبيق القِدم الفعال (سقف 3 أشهر) وإضافة تأخير العقوبات
                    pred.PredictedDueDate = baseDueDate.Value
                        .AddMonths(-pred.EffectiveSeniorityMonths)
                        .AddMonths(pred.DelayMonths);

                    if (today >= pred.PredictedDueDate.Value)
                    {
                        pred.Status = pred.IsStagnated
                            ? "مستحق الآن لترقية الدرجة (تسكين)"
                            : "مستحق الآن للترقية وتغيير العنوان";
                    }
                    else
                    {
                        int diffMonths = ((pred.PredictedDueDate.Value.Year - today.Year) * 12) + (pred.PredictedDueDate.Value.Month - today.Month);
                        if (diffMonths <= 6)
                        {
                            pred.Status = $"قريب الاستحقاق (متبقي {Math.Max(1, diffMonths)} شهر)";
                        }
                        else
                        {
                            pred.Status = $"متبقي {diffMonths} شهر";
                        }
                    }
                }
                else
                {
                    pred.Status = "التواريخ غير مسجلة";
                }
            }

            // 7. بناء تايم لاين واضح من المرحلة الحالية للموظف
            BuildTimeline(pred, currentGradeNum, currentStageNum, qualifyingStage, baseDueDate, today);

            predictionsList.Add(pred);
        }
    }

    private static void BuildTimeline(
        EmployeePrediction pred,
        int currentGradeNum,
        int currentStageNum,
        int qualifyingStage,
        DateOnly? baseDueDate,
        DateOnly today)
    {
        pred.TimelineSteps.Clear();
        var emp = pred.Employee;

        // 1. Current stage step (نقطة البداية: المرحلة الحالية للموظف)
        var currentStartDate = emp.LastAllowanceDate ?? emp.LastJobTitleDate ?? emp.HireDate;
        var currentStep = new TimelineStageStep
        {
            StageNumber = currentStageNum,
            Title = currentStageNum > 0 ? $"المرحلة {currentStageNum} (أنت هنا)" : "المرحلة الحالية (غير محددة)",
            Subtitle = currentGradeNum > 0 ? $"الدرجة {currentGradeNum} - {pred.JobTitleName}" : pred.JobTitleName,
            EstimatedDate = currentStartDate,
            StepType = "current",
            IconName = "home",
            BadgeText = currentStageNum >= qualifyingStage ? "مستوفٍ للمراحل" : "المرحلة الحالية",
            BadgeClass = "hr-badge--primary",
            Description = currentStartDate.HasValue
                ? $"تاريخ نيل المرحلة الحالية: {currentStartDate.Value:yyyy/MM/dd}"
                : "تاريخ نيل المرحلة غير مثبت بالسجل",
            IsCurrent = true
        };
        pred.TimelineSteps.Add(currentStep);

        // 2. إذا كان الموظف أقل من المرحلة المؤهلة: نرسم كل مرحلة من مرحلته الحالية حتى المرحلة المؤهلة
        if (currentStageNum > 0 && currentStageNum < qualifyingStage)
        {
            for (int stage = currentStageNum + 1; stage <= qualifyingStage; stage++)
            {
                int diffYears = stage - currentStageNum;
                DateOnly? stageDate = currentStartDate?.AddYears(diffYears);
                bool isQualifying = (stage == qualifyingStage);

                var nextStep = new TimelineStageStep
                {
                    StageNumber = stage,
                    Title = isQualifying ? $"المرحلة {stage} (المؤهلة للترقية)" : $"المرحلة {stage}",
                    Subtitle = isQualifying ? $"إكمال شرط الدرجة ({qualifyingStage} مراحل)" : "علاوة سنوية دورية",
                    EstimatedDate = stageDate,
                    StepType = isQualifying ? "qualifying" : "upcoming",
                    IconName = isQualifying ? "sparkles" : "arrow-trending-up",
                    BadgeText = isQualifying ? "المرحلة المؤهلة" : $"+سنة (+{diffYears})",
                    BadgeClass = isQualifying ? "hr-badge--accent" : "hr-badge--subtle",
                    Description = isQualifying
                        ? (currentGradeNum <= 5
                            ? "استيفاء شرط الـ 5 مراحل المقررة للدرجات العليا (1-5)"
                            : "استيفاء شرط الـ 4 مراحل المقررة للدرجات (6-10)")
                        : "علاوة سنوية بعد اجتياز سنة خدمة إضافية",
                    IsQualifying = isQualifying
                };
                pred.TimelineSteps.Add(nextStep);
            }
        }
        else if (currentStageNum >= qualifyingStage)
        {
            // الموظف بالفعل بالمرحلة المؤهلة أو تجاوزها
            DateOnly? nextAllowanceYear = currentStartDate?.AddYears(1);
            pred.TimelineSteps.Add(new TimelineStageStep
            {
                StageNumber = currentStageNum,
                Title = "إكمال السنة بالدرجة الحالية",
                Subtitle = $"مستوفٍ لشرط الـ {qualifyingStage} مراحل",
                EstimatedDate = nextAllowanceYear,
                StepType = "qualifying",
                IconName = "check-circle",
                BadgeText = "مراحل مستوفاة",
                BadgeClass = "hr-badge--ok",
                Description = $"الموظف استوفى متطلب السلم الوظيفي ({qualifyingStage} مراحل) وبانتظار الترفيع",
                IsQualifying = true
            });
        }

        // 3. أثر كتب الشكر (تسريع الموعد)
        if (pred.EffectiveSeniorityMonths > 0)
        {
            pred.TimelineSteps.Add(new TimelineStageStep
            {
                StageNumber = 0,
                Title = $"تقديم بالقِدم: -{pred.EffectiveSeniorityMonths} شهر",
                Subtitle = $"{pred.LettersCount} كتب شكر بسنة العلاوة",
                EstimatedDate = null,
                StepType = "bonus",
                IconName = "document-text",
                BadgeText = $"-{pred.EffectiveSeniorityMonths} شهر",
                BadgeClass = "hr-badge--ok",
                Description = pred.IsSeniorityCapped
                    ? $"تم احتساب {pred.EffectiveSeniorityMonths} أشهر كحد أقصى (سقف قانوني من أصل {pred.RawSeniorityMonths} شهر)"
                    : $"تم اعتماد كامل القِدم البالغ {pred.EffectiveSeniorityMonths} شهر لعدم تجاوزه السقف"
            });
        }

        // 4. أثر العقوبات (تأخير الموعد)
        if (pred.DelayMonths > 0 && !pred.IsDismissed)
        {
            pred.TimelineSteps.Add(new TimelineStageStep
            {
                StageNumber = 0,
                Title = $"تأخير بالعقوبات: +{pred.DelayMonths} شهر",
                Subtitle = $"{pred.PenaltiesCount} عقوبة ضمن فترة العنوان",
                EstimatedDate = null,
                StepType = "penalty",
                IconName = "shield-exclamation",
                BadgeText = $"+{pred.DelayMonths} شهر",
                BadgeClass = "hr-badge--danger",
                Description = $"إرجاء موعد الاستحقاق بمقدار {pred.DelayMonths} شهر بسبب العقوبات الانضباطية"
            });
        }

        // 5. عقوبة عزل تمنع الترفيع
        if (pred.IsDismissed)
        {
            pred.TimelineSteps.Add(new TimelineStageStep
            {
                StageNumber = 0,
                Title = "حظر وتجميد (عقوبة عزل)",
                Subtitle = "حرمان نهائي من الترفيع",
                EstimatedDate = null,
                StepType = "blocked",
                IconName = "no-symbol",
                BadgeText = "عقوبة عزل",
                BadgeClass = "hr-badge--danger",
                Description = "الموظف محروم من الترفيع وتغيير العنوان بصورة نهائية بسبب صدور عقوبة عزل"
            });
        }
        else if (pred.PredictedDueDate.HasValue)
        {
            // 6. المحطة الختامية (الاستحقاق والترفيع للعنوان الجديد)
            bool isDue = (today >= pred.PredictedDueDate.Value);
            pred.TimelineSteps.Add(new TimelineStageStep
            {
                StageNumber = qualifyingStage + 1,
                Title = $"استحقاق: {pred.NextJobTitleName}",
                Subtitle = $"{pred.NextGradeName}",
                EstimatedDate = pred.PredictedDueDate.Value,
                StepType = "target",
                IconName = "sparkles",
                BadgeText = isDue ? "مستحق الآن!" : pred.IsNearDue ? "قريب الاستحقاق" : "الموعد النهائي",
                BadgeClass = isDue ? "hr-badge--ok" : pred.IsNearDue ? "hr-badge--warn" : "hr-badge--primary",
                Description = isDue
                    ? "اكتملت جميع المتطلبات والمراحل! الموظف مستحق الآن للترفيع وتغيير العنوان رسمياً."
                    : $"الموعد النهائي المتوقع للترقية: {pred.PredictedDueDate.Value:yyyy/MM/dd} ({pred.Status})",
                IsTarget = true
            });
        }
    }

    private static int CalculateLetterSeniority(AppreciationLetter l)
    {
        int count = l.Count ?? 1;
        if (count <= 0) count = 1;
        if (l.Type != null)
        {
            return (((l.Type.SeniorityYears * 12) + l.Type.SeniorityMonths) * count) + ((l.Type.SeniorityDays * count) / 30);
        }
        return 1 * count;
    }

    // Filter & Sort Logic
    private List<EmployeePrediction> FilteredPredictions
    {
        get
        {
            var q = predictionsList.AsEnumerable();

            // Search query
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                q = q.Where(p =>
                    p.EmployeeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.EmployeeID.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.JobTitleName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.NextJobTitleName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.FormationName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.GradeName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            // Status filter
            q = statusFilter switch
            {
                "due_now" => q.Where(p => p.IsDueNow),
                "near_due" => q.Where(p => p.IsNearDue),
                "stagnated" => q.Where(p => p.IsStagnated),
                "letters" => q.Where(p => p.LettersCount > 0),
                "capped_letters" => q.Where(p => p.IsSeniorityCapped),
                "penalties" => q.Where(p => p.DelayMonths > 0 && !p.IsDismissed),
                "dismissed" => q.Where(p => p.IsDismissed),
                _ => q
            };

            // Grade filter
            if (!string.IsNullOrWhiteSpace(gradeFilter))
            {
                q = q.Where(p => p.GradeName == gradeFilter);
            }

            // Formation filter
            if (!string.IsNullOrWhiteSpace(formationFilter))
            {
                q = q.Where(p => p.FormationName == formationFilter);
            }

            // Sorting
            q = sortBy switch
            {
                "due_desc" => q.OrderByDescending(p => p.PredictedDueDate.HasValue)
                               .ThenByDescending(p => p.PredictedDueDate),
                "name_asc" => q.OrderBy(p => p.EmployeeName),
                "id_asc" => q.OrderBy(p => p.EmployeeID),
                "seniority_desc" => q.OrderByDescending(p => p.EffectiveSeniorityMonths)
                                     .ThenByDescending(p => p.RawSeniorityMonths),
                "delay_desc" => q.OrderByDescending(p => p.IsDismissed)
                                 .ThenByDescending(p => p.DelayMonths),
                _ => q.OrderByDescending(p => p.IsDueNow)
                      .ThenByDescending(p => p.IsNearDue)
                      .ThenBy(p => p.PredictedDueDate.HasValue ? 0 : 1)
                      .ThenBy(p => p.PredictedDueDate)
            };

            return q.ToList();
        }
    }

    private List<EmployeePrediction> PagedPredictions =>
        FilteredPredictions.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredPredictions.Count / pageSize));

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private void ClearFilters()
    {
        searchQuery = "";
        statusFilter = "all";
        gradeFilter = "";
        formationFilter = "";
        sortBy = "due_asc";
        currentPage = 1;
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

