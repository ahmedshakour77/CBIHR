@code {
    [Parameter] public string? EmployeeIdParam { get; set; }

    private List<EmployeeVehicle> vehicles = [];
    private VehicleKpiSummary kpi = new(0, 0, 0, 0, 0, 0, 0, 0);

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isCardView = true;

    // Filters
    private string searchTerm = "";
    private string selectedLocation = "";
    private string authFilter = "all";

    // Modal state
    private bool showModal = false;
    private bool isEditMode = false;
    private int editingVehicleId = 0;
    private string? modalError;

    // Delete modal
    private bool showDeleteModal = false;
    private EmployeeVehicle? vehicleToDelete;

    // Form inputs
    private Employee? selectedEmployee;
    private string empSearchInput = "";
    private List<Employee> empLookupResults = [];

    private string formBrand = "";
    private string formModel = "";
    private string? formColor;
    private string formPlateNumber = "";
    private string? formPlateLetter;
    private string formGov = "بغداد";
    private string? formVin;
    private int? formYear;
    private bool formIsAuthorized = true;
    private bool formAllowMain = true;
    private bool formAllowJadriya = false;
    private bool formAllowErbil = false;
    private bool formAllowMosul = false;
    private bool formAllowBasra = false;
    private bool formIsDriverSelf = true;
    private string? formDriverName;
    private string? formDriverPhone;
    private string? formNotes;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(EmployeeIdParam))
        {
            searchTerm = EmployeeIdParam;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            bool? isAuth = authFilter switch
            {
                "auth" => true,
                "unauth" => false,
                _ => null
            };

            vehicles = await VehicleService.GetAllVehiclesAsync(searchTerm, selectedLocation, isAuth);
            kpi = await VehicleService.GetKpiSummaryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load employee vehicles data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await LoadDataAsync();
    }

    private async Task OnLocationChanged(ChangeEventArgs e)
    {
        selectedLocation = e.Value?.ToString() ?? "";
        await LoadDataAsync();
    }

    private async Task SelectLocation(string loc)
    {
        selectedLocation = loc;
        await LoadDataAsync();
    }

    private async Task OnAuthFilterChanged(ChangeEventArgs e)
    {
        authFilter = e.Value?.ToString() ?? "all";
        await LoadDataAsync();
    }

    private async Task ToggleAuth(EmployeeVehicle vehicle)
    {
        var newStatus = !vehicle.IsAuthorized;
        var ok = await VehicleService.ToggleAuthorizationAsync(vehicle.Id, newStatus);
        if (ok)
        {
            vehicle.IsAuthorized = newStatus;
            kpi = await VehicleService.GetKpiSummaryAsync();
        }
    }

    private async Task OnEmpSearchInput(ChangeEventArgs e)
    {
        empSearchInput = e.Value?.ToString() ?? "";
        if (empSearchInput.Length >= 2)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            empLookupResults = await db.Employees
                .AsNoTracking()
                .Include(emp => emp.Formation)
                .Where(emp => !emp.IsArchived && (emp.Name.Contains(empSearchInput) || emp.EmployeeID.Contains(empSearchInput)))
                .Take(7)
                .ToListAsync();
        }
        else
        {
            empLookupResults.Clear();
        }
    }

    private void ChooseEmployee(Employee emp)
    {
        selectedEmployee = emp;
        empSearchInput = "";
        empLookupResults.Clear();
    }

    private void ClearSelectedEmployee()
    {
        selectedEmployee = null;
        empSearchInput = "";
        empLookupResults.Clear();
    }

    private async void OpenAddModal()
    {
        isEditMode = false;
        editingVehicleId = 0;
        modalError = null;

        formBrand = "";
        formModel = "";
        formColor = "";
        formPlateNumber = "";
        formPlateLetter = "";
        formGov = "بغداد";
        formVin = "";
        formYear = DateTime.Now.Year;
        formIsAuthorized = true;
        formAllowMain = true;
        formAllowJadriya = false;
        formAllowErbil = false;
        formAllowMosul = false;
        formAllowBasra = false;
        formIsDriverSelf = true;
        formDriverName = "";
        formDriverPhone = "";
        formNotes = "";

        // Preselect employee if parameter passed
        if (!string.IsNullOrWhiteSpace(EmployeeIdParam))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            selectedEmployee = await db.Employees
                .AsNoTracking()
                .Include(emp => emp.Formation)
                .FirstOrDefaultAsync(emp => emp.EmployeeID == EmployeeIdParam);
        }
        else
        {
            selectedEmployee = null;
        }

        showModal = true;
    }

    private void OpenEditModal(EmployeeVehicle v)
    {
        isEditMode = true;
        editingVehicleId = v.Id;
        modalError = null;

        selectedEmployee = v.Employee;
        formBrand = v.Brand;
        formModel = v.Model;
        formColor = v.Color;
        formPlateNumber = v.PlateNumber;
        formPlateLetter = v.PlateLetter;
        formGov = v.Governorate;
        formVin = v.Vin;
        formYear = v.ManufacturingYear;
        formIsAuthorized = v.IsAuthorized;
        formAllowMain = v.AllowMainBuilding;
        formAllowJadriya = v.AllowJadriya;
        formAllowErbil = v.AllowErbil;
        formAllowMosul = v.AllowMosul;
        formAllowBasra = v.AllowBasra;
        formIsDriverSelf = v.IsDriverSelf;
        formDriverName = v.DriverName;
        formDriverPhone = v.DriverPhone;
        formNotes = v.Notes;

        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalError = null;
    }

    private void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseModal();
    }

    private void OnDeleteModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showDeleteModal = false;
    }

    private async Task SaveVehicle()
    {
        modalError = null;

        if (selectedEmployee == null)
        {
            modalError = "يرجى اختيار الموظف المالك للمركبة.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formGov))
        {
            modalError = "يرجى تحديد المحافظة المسجلة بها اللوحة.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formPlateNumber))
        {
            modalError = "يرجى إدخال رقم اللوحة.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formBrand))
        {
            modalError = "يرجى إدخال البراند / الشركة المصنعة (مثل: تويوتا، نيسان...).";
            return;
        }

        if (string.IsNullOrWhiteSpace(formModel))
        {
            modalError = "يرجى إدخال الموديل (مثل: كورولا، كامري...).";
            return;
        }

        if (!formIsDriverSelf && string.IsNullOrWhiteSpace(formDriverName))
        {
            modalError = "يرجى إدخال اسم السائق في حال لم يكن الموظف نفسه.";
            return;
        }

        isSaving = true;
        try
        {
            if (isEditMode)
            {
                var vehicle = new EmployeeVehicle
                {
                    Id = editingVehicleId,
                    EmployeeId = selectedEmployee.Id,
                    Brand = formBrand.Trim(),
                    Model = formModel.Trim(),
                    Color = string.IsNullOrWhiteSpace(formColor) ? null : formColor.Trim(),
                    PlateNumber = formPlateNumber.Trim(),
                    PlateLetter = string.IsNullOrWhiteSpace(formPlateLetter) ? null : formPlateLetter.Trim(),
                    Governorate = formGov.Trim(),
                    Vin = string.IsNullOrWhiteSpace(formVin) ? null : formVin.Trim(),
                    ManufacturingYear = formYear,
                    IsDriverSelf = formIsDriverSelf,
                    DriverName = formIsDriverSelf ? null : (string.IsNullOrWhiteSpace(formDriverName) ? null : formDriverName.Trim()),
                    DriverPhone = string.IsNullOrWhiteSpace(formDriverPhone) ? null : formDriverPhone.Trim(),
                    IsAuthorized = formIsAuthorized,
                    AllowMainBuilding = formAllowMain,
                    AllowJadriya = formAllowJadriya,
                    AllowErbil = formAllowErbil,
                    AllowMosul = formAllowMosul,
                    AllowBasra = formAllowBasra,
                    Notes = string.IsNullOrWhiteSpace(formNotes) ? null : formNotes.Trim()
                };

                await VehicleService.UpdateVehicleAsync(vehicle);
            }
            else
            {
                var vehicle = new EmployeeVehicle
                {
                    EmployeeId = selectedEmployee.Id,
                    Brand = formBrand.Trim(),
                    Model = formModel.Trim(),
                    Color = string.IsNullOrWhiteSpace(formColor) ? null : formColor.Trim(),
                    PlateNumber = formPlateNumber.Trim(),
                    PlateLetter = string.IsNullOrWhiteSpace(formPlateLetter) ? null : formPlateLetter.Trim(),
                    Governorate = formGov.Trim(),
                    Vin = string.IsNullOrWhiteSpace(formVin) ? null : formVin.Trim(),
                    ManufacturingYear = formYear,
                    IsDriverSelf = formIsDriverSelf,
                    DriverName = formIsDriverSelf ? null : (string.IsNullOrWhiteSpace(formDriverName) ? null : formDriverName.Trim()),
                    DriverPhone = string.IsNullOrWhiteSpace(formDriverPhone) ? null : formDriverPhone.Trim(),
                    IsAuthorized = formIsAuthorized,
                    AllowMainBuilding = formAllowMain,
                    AllowJadriya = formAllowJadriya,
                    AllowErbil = formAllowErbil,
                    AllowMosul = formAllowMosul,
                    AllowBasra = formAllowBasra,
                    Notes = string.IsNullOrWhiteSpace(formNotes) ? null : formNotes.Trim()
                };

                await VehicleService.AddVehicleAsync(vehicle);
            }

            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalError = $"حدث خطأ أثناء الحفظ: {ex.Message}";
            Logger.LogError(ex, "Error saving vehicle");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(EmployeeVehicle v)
    {
        vehicleToDelete = v;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (vehicleToDelete == null) return;
        isSaving = true;
        try
        {
            await VehicleService.DeleteVehicleAsync(vehicleToDelete.Id);
            showDeleteModal = false;
            vehicleToDelete = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting vehicle");
        }
        finally
        {
            isSaving = false;
        }
    }
}
