    private void ResetTypeForm()
    {
        isEditTypeMode = false;
        typeFormName = string.Empty;
        typeFormNameKu = null;
        typeFormCode = string.Empty;
        typeFormLevel = (unitTypes.Count > 0 ? unitTypes.Max(t => t.HierarchyLevel) + 1 : 1);
        typeFormDesc = string.Empty;
    }

    private void EditType(AdministrativeUnitType type)
    {
        isEditTypeMode = true;
        currentEditingTypeId = type.Id;
        typeFormName = type.Name;
        typeFormNameKu = type.NameKu;
        typeFormCode = type.Code;
        typeFormLevel = type.HierarchyLevel;
        typeFormDesc = type.Description;
    }

    private async Task SaveUnitTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(typeFormName) || string.IsNullOrWhiteSpace(typeFormCode))
        {
            typeErrorMessage = "يرجى كتابة اسم نوع الوحدة ورمزها.";
            return;
        }

        // Same re-entry guard SaveUnitAsync uses: the button is disabled while
        // the round trip is in flight, so a second click cannot create a
        // duplicate record before the first one comes back.
        if (isSavingType) return;

        typeErrorMessage = null;
        isSavingType = true;
        try
        {
            if (isEditTypeMode)
            {
                await OrgService.UpdateUnitTypeAsync(currentEditingTypeId, typeFormName, typeFormNameKu, typeFormCode, typeFormLevel, typeFormDesc, true);
            }
            else
            {
                await OrgService.CreateUnitTypeAsync(typeFormName, typeFormNameKu, typeFormCode, typeFormLevel, typeFormDesc);
            }

            ResetTypeForm();
            unitTypes = await OrgService.GetUnitTypesAsync();
            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            typeErrorMessage = ex.Message;
        }
        finally
        {
            isSavingType = false;
        }
    }

    private async Task DeleteTypeAsync(int typeId)
    {
        if (isSavingType) return;

        typeErrorMessage = null;
        isSavingType = true;
        try
        {
            await OrgService.DeleteUnitTypeAsync(typeId);
            unitTypes = await OrgService.GetUnitTypesAsync();
            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            typeErrorMessage = ex.Message;
        }
        finally
        {
            isSavingType = false;
        }
    }

