    private async Task SaveUnitAsync()
    {
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formCode))
        {
            errorMessage = "يرجى كتابة اسم التشكيل والرمز التعريفي.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (isEditMode)
            {
                await OrgService.UpdateUnitAsync(
                    currentEditingId,
                    formName,
                    formNameKu,
                    formCode,
                    formUnitTypeId,
                    formParentUnitId,
                    formManagerTitle,
                    formManagerEmployeeId,
                    formIsActive,
                    formNotes);
            }
            else
            {
                await OrgService.CreateUnitAsync(
                    formName,
                    formNameKu,
                    formCode,
                    formUnitTypeId,
                    formParentUnitId,
                    formManagerTitle,
                    formManagerEmployeeId,
                    formNotes);
            }

            CloseModal();
            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save unit.");
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void PromptDeleteUnit(int unitId, string unitName, int childrenCount)
    {
        if (childrenCount > 0)
        {
            errorMessage = "لا يمكن حذف هذا التشكيل الإداري لأنه يحتوي على فروع تابعة له. يرجى حذف الفروع أو نقلها أولاً.";
            return;
        }

        unitIdToDelete = unitId;
        unitNameToDelete = unitName;
        isDeleteModalOpen = true;
    }

    private async Task ConfirmDeleteUnitAsync()
    {
        isDeleteModalOpen = false;
        try
        {
            await OrgService.DeleteUnitAsync(unitIdToDelete);
            if (selectedLineage != null && selectedLineage.Any(s => s.UnitId == unitIdToDelete))
            {
                ClearLineage();
            }
            await ReloadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete unit.");
            errorMessage = ex.Message;
        }
    }

