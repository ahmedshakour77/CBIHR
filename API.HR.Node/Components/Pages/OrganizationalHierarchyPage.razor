                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseTypesModal">إغلاق</button>
            </div>
        </div>
    </div>
}

