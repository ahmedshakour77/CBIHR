                                    <button type="button" class="hr-btn hr-btn-quiet hr-btn-xs hr-text-danger" @onclick="() => RemoveStaffFromUnitAsync(emp.EmployeeID)" disabled="@isAssigningStaff" title="إلغاء التبعية لهذا التشكيل">
                                        <Icon Name="x-mark" Size="xs" />
                                        <span>إلغاء الإلحاق</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="hr-modal-foot">
                <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseStaffAssignModal">إغلاق</button>
            </div>
        </div>
    </div>
