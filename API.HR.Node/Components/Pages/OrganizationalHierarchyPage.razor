@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSavingType = false;
    private string? errorMessage;
    private string? typeErrorMessage;

    private List<AdministrativeUnitType> unitTypes = [];
    private List<HierarchyTreeNodeDto> treeRoots = [];
    private List<AdministrativeUnit> allUnitsFlat = [];

    // Lineage Inspector state
    private List<LineageStepDto>? selectedLineage;
    private string selectedUnitName = string.Empty;

    // Unit Modal state
    private bool isModalOpen = false;
    private bool isEditMode = false;
    private int currentEditingId;

    private string formName = string.Empty;
    private string? formNameKu;
    private string formCode = string.Empty;
    private int formUnitTypeId;
    private int? formParentUnitId;
    private string? formManagerTitle;
    private string? formManagerEmployeeId;
    private string? formManagerEmployeeName;
    private int formOrderIndex = 1;
    private bool formIsActive = true;
    private string? formNotes;

    // Manager Picker state
    private bool isManagerPickerOpen = false;
    private string managerSearchTerm = string.Empty;
    private List<HierarchyEmployeeDto> managerCandidates = [];
    private bool isSearchingManagers = false;

    // Staff Assignment state
    private bool isStaffModalOpen = false;
    private int staffModalUnitId;
    private string staffModalUnitName = string.Empty;
    private List<HierarchyEmployeeDto> currentUnitStaff = [];
    private List<HierarchyEmployeeDto> staffCandidates = [];
    private string staffSearchTerm = string.Empty;
    private bool isSearchingStaff = false;
    private bool isAssigningStaff = false;

    // Types Modal state
    private bool isTypesModalOpen = false;
    private bool isEditTypeMode = false;
    private int currentEditingTypeId;
    private string typeFormName = string.Empty;
    private string? typeFormNameKu;
    private string typeFormCode = string.Empty;
    private int typeFormLevel = 1;
    private string? typeFormDesc;

    // Delete Unit Modal state
    private bool isDeleteModalOpen = false;
    private int unitIdToDelete;
    private string unitNameToDelete = string.Empty;

    // Clear confirmation
    private bool isClearConfirmOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            unitTypes = await OrgService.GetUnitTypesAsync();
            allUnitsFlat = await OrgService.GetAllUnitsFlatAsync();
            treeRoots = await OrgService.GetHierarchyTreeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load organizational hierarchy.");
            errorMessage = "حدث خطأ أثناء تحميل شجرة الهيكلية الإدارية.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task InspectLineageAsync(int unitId, string unitName)
    {
        selectedUnitName = unitName;
        selectedLineage = await OrgService.GetLineageToRootAsync(unitId);
        StateHasChanged();
    }

    private void ClearLineage()
    {
        selectedLineage = null;
        selectedUnitName = string.Empty;
    }

    private void OpenAddModalForRoot()
    {
        isEditMode = false;
        errorMessage = null;
        formName = string.Empty;
        formNameKu = null;
        formCode = $"GOV-{DateTime.Now:fff}";
        formUnitTypeId = unitTypes.FirstOrDefault()?.Id ?? 1;
        formParentUnitId = null;
        formManagerTitle = string.Empty;
        formManagerEmployeeId = null;
        formManagerEmployeeName = null;
        formOrderIndex = allUnitsFlat.Count + 1;
        formIsActive = true;
        formNotes = string.Empty;
        isModalOpen = true;
    }

    private void OpenAddModalForParent(int parentId)
    {
        isEditMode = false;
        errorMessage = null;
        formName = string.Empty;
        formNameKu = null;
        formCode = $"SEC-{DateTime.Now:fff}";
        formUnitTypeId = unitTypes.Skip(2).FirstOrDefault()?.Id ?? unitTypes.FirstOrDefault()?.Id ?? 1;
        formParentUnitId = parentId;
        formManagerTitle = string.Empty;
        formManagerEmployeeId = null;
        formManagerEmployeeName = null;
        formOrderIndex = allUnitsFlat.Count(u => u.ParentUnitId == parentId) + 1;
        formIsActive = true;
        formNotes = string.Empty;
        isModalOpen = true;
    }

    private void OpenEditModal(int unitId)
    {
        isEditMode = true;
        currentEditingId = unitId;
        errorMessage = null;

        var unit = allUnitsFlat.FirstOrDefault(u => u.Id == unitId);
        if (unit == null) return;

        formName = unit.Name;
        formNameKu = unit.NameKu;
        formCode = unit.Code;
        formUnitTypeId = unit.UnitTypeId;
        formParentUnitId = unit.ParentUnitId;
        formManagerTitle = unit.ManagerTitle;
        formManagerEmployeeId = unit.ManagerEmployeeId;

        // Try find name from loaded treeRoots
        HierarchyTreeNodeDto? foundNode = FindNodeInTree(treeRoots, unitId);
        formManagerEmployeeName = foundNode?.ManagerName;

        formOrderIndex = unit.OrderIndex;
        formIsActive = unit.IsActive;
        formNotes = unit.Notes;

        isModalOpen = true;
        StateHasChanged();
    }

    private static HierarchyTreeNodeDto? FindNodeInTree(IEnumerable<HierarchyTreeNodeDto> nodes, int id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id) return node;
            var found = FindNodeInTree(node.Children, id);
            if (found != null) return found;
        }
        return null;
    }


    /// <summary>
    /// Escape closes the overlay. Every dialog owes the user a way out that is
    /// not the mouse; these overlays predate the shared <see cref="Common.Modal"/>
    /// and did not have one.
    /// </summary>
    private static void OnOverlayKey(KeyboardEventArgs e, Action close)
    {
        if (e.Key == "Escape")
        {
            close();
        }
    }

