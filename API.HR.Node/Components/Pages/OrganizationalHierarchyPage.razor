                        </div>
                        <div class="hr-field">
                            <label for="organizationalhierarchypage-f12" class="hr-label">المستوى الهرمي (1-10) *</label>
                            <input id="organizationalhierarchypage-f12" type="number" class="hr-input" @bind="typeFormLevel" min="1" max="20" required />
                        </div>
                    </div>
                    <div class="hr-field" style="margin-block-start:var(--s-2);">
                        <label for="organizationalhierarchypage-f13" class="hr-label">الوصف</label>
                        <input id="organizationalhierarchypage-f13" type="text" class="hr-input" @bind="typeFormDesc" placeholder="نبذة عن طبيعة هذا النوع..." />
                    </div>
                    <div style="display:flex;justify-content:flex-end;gap:var(--s-2);margin-block-start:var(--s-3);">
                        @if (isEditTypeMode)
                        {
                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ResetTypeForm">إلغاء التعديل</button>
                        }
                        <button type="button" class="hr-btn hr-btn-primary hr-btn-sm" @onclick="SaveUnitTypeAsync" disabled="@isSavingType">
                            <Icon Name="check" Size="xs" />
                            <span>@(isEditTypeMode ? "حفظ التعديل" : "إضافة النوع")</span>
                        </button>
                    </div>
                </div>

                @* Table of Existing Types *@
                <div style="max-height:16rem;overflow-y:auto;">
                    <table class="hr-table" style="width:100%;font-size:var(--fs-control);">
                        <thead>
                            <tr>
                                <th scope="col">المستوى</th>
                                <th scope="col">الاسم</th>
                                <th scope="col">الاسم (کوردی)</th>
                                <th scope="col">الرمز</th>
                                <th scope="col">إجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in unitTypes.OrderBy(x => x.HierarchyLevel))
                            {
                                <tr>
                                    <td><span class="hr-badge">#@t.HierarchyLevel</span></td>
                                    <td><strong>@t.Name</strong></td>
                                    <td>@(t.NameKu ?? "-")</td>
                                    <td><code>@t.Code</code></td>
                                    <td>
                                        <div style="display:flex;gap:.25rem;">
                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm" @onclick="() => EditType(t)" title="تعديل" aria-label="تعديل">
