                        SecondaryInt = a.SeniorityMonths,
                        ExtraInt = a.SeniorityDays,
                        UsageCount = letterTypeCounts.GetValueOrDefault(a.Id, 0)
                    }).ToList();
                    break;

                case "MartyrdomTypes":
                    var martCounts = await Db.EmployeeMartyrs.Where(m => m.MartyrdomTypeId != null)
                        .GroupBy(m => m.MartyrdomTypeId!.Value)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var martTypes = await Db.MartyrdomTypes.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
                    itemsList = martTypes.Select(m => new LookupRowItem
                    {
                        Id = m.Id,
                        Name = m.Name,
                        Description = m.Description,
                        UsageCount = martCounts.GetValueOrDefault(m.Id, 0)
                    }).ToList();
                    break;

                case "MartyrKinships":
                    var kinCounts = await Db.EmployeeMartyrs.Where(m => m.KinshipId != null)
                        .GroupBy(m => m.KinshipId!.Value)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var kinships = await Db.MartyrKinships.AsNoTracking().OrderBy(x => x.Degree).ToListAsync();
                    itemsList = kinships.Select(k => new LookupRowItem
                    {
                        Id = k.Id,
                        Name = k.Name,
                        SecondaryValue = $"الدرجة {k.Degree}",
                        SecondaryInt = k.Degree,
                        UsageCount = kinCounts.GetValueOrDefault(k.Id, 0)
                    }).ToList();
                    break;

                case "AllowanceTypes":
                    var allowCounts = await Db.EmployeeAllowanceItems
                        .GroupBy(a => a.AllowanceTypeId)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var allowances = await Db.AllowanceTypes.AsNoTracking().OrderBy(x => x.SortOrder).ToListAsync();
                    itemsList = allowances.Select(a => new LookupRowItem
                    {
                        Id = a.Id,
                        Name = a.Name,
                        Code = a.Code,
                        SecondaryValue = a.CalculationType == AllowanceCalculationType.Percentage
                            ? $"{a.DefaultPercentage}% (نسبية)"
                            : $"{a.DefaultAmount:N0} د.ع (مقطوعة)",
                        UsageCount = allowCounts.GetValueOrDefault(a.Id, 0)
                    }).ToList();
                    break;
            }

            CurrentMeta.Count = itemsList.Count;
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر جلب البيانات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

