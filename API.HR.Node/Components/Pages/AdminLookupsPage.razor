    private IEnumerable<LookupMeta> CurrentCategoryLookups =>
        AllLookups.Where(l => l.Category == selectedCategory);

    private LookupMeta CurrentMeta =>
        AllLookups.FirstOrDefault(l => l.Key == selectedLookupKey) ?? AllLookups.First();

    private List<LookupRowItem> itemsList = new();

    private List<LookupRowItem> filteredItems => string.IsNullOrWhiteSpace(searchQuery)
        ? itemsList
        : itemsList.Where(i =>
            (!string.IsNullOrEmpty(i.Name) && i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(i.Code) && i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(i.SecondaryValue) && i.SecondaryValue.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupCountsAsync();
        await LoadCurrentLookupDataAsync();
    }

    private async Task SelectCategory(string categoryKey)
    {
        if (selectedCategory == categoryKey) return;
        selectedCategory = categoryKey;
        var first = CurrentCategoryLookups.FirstOrDefault();
        if (first != null)
        {
            selectedLookupKey = first.Key;
            await LoadCurrentLookupDataAsync();
        }
    }

    private async Task SelectLookup(string lookupKey)
    {
        if (selectedLookupKey == lookupKey) return;
        selectedLookupKey = lookupKey;
        searchQuery = string.Empty;
        await LoadCurrentLookupDataAsync();
    }

    private async Task ReloadCurrentLookupAsync()
    {
        await LoadLookupCountsAsync();
        await LoadCurrentLookupDataAsync();
        Toast.Info("تم تحديث البيانات بنجاح");
    }

    private async Task LoadLookupCountsAsync()
    {
        try
        {
            // Update counts for pills in parallel/batch
            var metaDict = AllLookups.ToDictionary(m => m.Key);
            metaDict["Formations"].Count = await Db.Formations.CountAsync();
            metaDict["AdministrativeUnitTypes"].Count = await Db.AdministrativeUnitTypes.CountAsync();
            metaDict["JobFamilies"].Count = await Db.JobFamilies.CountAsync();
            metaDict["JobTitles"].Count = await Db.JobTitles.CountAsync();
            metaDict["PositionTitles"].Count = await Db.PositionTitles.CountAsync();
            metaDict["Grades"].Count = await Db.Grades.CountAsync();
            metaDict["Stages"].Count = await Db.Stages.CountAsync();
            metaDict["EmployeeStatuses"].Count = await Db.EmployeeStatuses.CountAsync();
            metaDict["EducationLevels"].Count = await Db.EducationLevels.CountAsync();
            metaDict["Specializations"].Count = await Db.Specializations.CountAsync();
            metaDict["Genders"].Count = await Db.Genders.CountAsync();
            metaDict["MaritalStatuses"].Count = await Db.MaritalStatuses.CountAsync();
            metaDict["Governorates"].Count = await Db.Governorates.CountAsync();
            metaDict["Religions"].Count = await Db.Religions.CountAsync();
            metaDict["Nationalities"].Count = await Db.Nationalities.CountAsync();
            metaDict["LeaveTypes"].Count = await Db.LeaveTypes.CountAsync();
            metaDict["PenaltyTypes"].Count = await Db.PenaltyTypes.CountAsync();
            metaDict["AppreciationLetterTitles"].Count = await Db.AppreciationLetterTitles.CountAsync();
            metaDict["AppreciationLetterTypes"].Count = await Db.AppreciationLetterTypes.CountAsync();
            metaDict["MartyrdomTypes"].Count = await Db.MartyrdomTypes.CountAsync();
            metaDict["MartyrKinships"].Count = await Db.MartyrKinships.CountAsync();
            metaDict["AllowanceTypes"].Count = await Db.AllowanceTypes.CountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error counting lookups: {ex.Message}");
        }
    }

    private async Task LoadCurrentLookupDataAsync()
    {
        isLoading = true;
        itemsList.Clear();

        try
        {
            switch (selectedLookupKey)
            {
                case "Formations":
                    var formCounts = await Db.Employees.Where(e => e.FormationId != null)
                        .GroupBy(e => e.FormationId!.Value)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var formations = await Db.Formations.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
                    itemsList = formations.Select(f => new LookupRowItem
                    {
                        Id = f.Id,
                        Name = f.Name,
                        UsageCount = formCounts.GetValueOrDefault(f.Id, 0)
                    }).ToList();
                    break;

                case "AdministrativeUnitTypes":
                    var unitTypeCounts = await Db.AdministrativeUnits
                        .GroupBy(u => u.UnitTypeId)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var unitTypes = await Db.AdministrativeUnitTypes.AsNoTracking().OrderBy(x => x.HierarchyLevel).ToListAsync();
                    itemsList = unitTypes.Select(u => new LookupRowItem
                    {
                        Id = u.Id,
                        Name = u.Name,
                        Code = u.Code,
                        SecondaryValue = $"مستوى {u.HierarchyLevel}",
                        UsageCount = unitTypeCounts.GetValueOrDefault(u.Id, 0)
                    }).ToList();
                    break;

                case "JobFamilies":
                    var familyCounts = await Db.JobTitles.Where(j => j.JobFamilyId != null)
                        .GroupBy(j => j.JobFamilyId!.Value)
                        .Select(g => new { Id = g.Key, Count = g.Count() })
                        .ToDictionaryAsync(x => x.Id, x => x.Count);

                    var families = await Db.JobFamilies.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
