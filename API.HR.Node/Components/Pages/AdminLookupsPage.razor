                case "LeaveTypes":
                    var defaultLeaves = new[] { "إجازة اعتيادية", "إجازة مرضية", "إجازة دراسية", "إجازة أمومة ورعاية طفل", "إجازة بدون راتب", "إجازة حج وعمرة", "إجازة عدة شرعية" };
