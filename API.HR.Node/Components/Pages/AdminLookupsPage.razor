                case "MartyrdomTypes":
                    var defaultMartyrs = new[] { "شهداء العمليات الحربية والأخطاء العسكرية والعمليات الإرهابية", "شهداء ضحايا النظام البائد", "شهداء الواجب والخدمة" };
                    foreach (var m in defaultMartyrs)
                    {
                        if (!await Db.MartyrdomTypes.AnyAsync(x => x.Name == m))
                        {
                            Db.MartyrdomTypes.Add(new MartyrdomType { Name = m });
                        }
                    }
                    break;

                case "MartyrKinships":
                    var defaultKin = new (string Name, int Deg)[]
                    {
                        ("أب", 1), ("أم", 1), ("ابن", 1), ("بنت", 1), ("زوج/زوجة", 1),
                        ("أخ", 2), ("أخت", 2), ("جد/جدة", 2),
                        ("عم/عمة", 3), ("خال/خالة", 3)
                    };
                    foreach (var k in defaultKin)
                    {
                        if (!await Db.MartyrKinships.AnyAsync(x => x.Name == k.Name))
                        {
                            Db.MartyrKinships.Add(new MartyrKinship { Name = k.Name, Degree = k.Deg });
