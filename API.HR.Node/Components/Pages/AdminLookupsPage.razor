@page "/admin/lookups"
@using API.HR.Node.Data
@using API.HR.Node.Data.Allowances
@using API.HR.Node.Data.OrganizationalHierarchy
@using API.HR.Node.Services.DesignSystem
@using API.HR.Node.Services.Localization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Security
@attribute [Authorize(Policy = Permissions.LookupsView)]
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject ILanguageService Lang
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>إدارة القوائم المنسدلة وبيانات الترميز المرجعي | الموظف ٣٦٠°   </PageTitle>

<div class="hr-stack">
    @* Page Header *@
    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                <span class="hr-badge hr-badge--warn">صلاحية إدارة النظام (Admin Only)</span>
                <span class="hr-badge">الترميز والقواميس المرجعية</span>
            </div>
            <h1 class="hr-h1">إدارة القوائم المنسدلة وبيانات الترميز</h1>
            <p class="hr-sub hr-measure" style="margin-block-start: var(--s-1)">
                استعراض كافة القوائم المنسدلة في النظام، إدارة تفاصيلها وترابطاتها الوظيفية والمدنية، وإتاحة الإضافة والتعديل والحذف الآمن مع حماية سلامة السجلات المرتبطة.
            </p>
        </div>
        <div class="hr-pagehead-actions" role="group">
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="ReloadCurrentLookupAsync" disabled="@isLoading" title="إعادة تحميل بيانات القائمة">
                <Icon Name="arrow-path" Size="sm" Class="@(isLoading ? "hr-spin" : "")" />
                <span>تحديث</span>
            </button>
            <button type="button" class="hr-btn hr-btn-primary" @onclick="OpenAddModal" title="إضافة قيمة جديدة لهذه القائمة">
                <Icon Name="plus" Size="sm" />
                <span>إضافة إلى @CurrentMeta.Title</span>
            </button>
        </div>
    </header>

    @* Category Tabs & Lookup Selector *@
    <div class="hr-card" style="padding: 1rem 1.25rem;">
        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            @* Category Selector *@
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--line-soft); padding-bottom: 0.75rem;">
                @foreach (var cat in LookupCategories)
                {
                    var isCatActive = selectedCategory == cat.Key;
                    <button type="button"
                            class="hr-btn @(isCatActive ? "hr-btn-primary" : "hr-btn-secondary")"
                            style="font-size: var(--fs-caption); padding: 0.35rem 0.85rem;"
                            @onclick="() => SelectCategory(cat.Key)">
                        <Icon Name="@cat.Icon" Size="xs" />
                        <span>@cat.Name</span>
                    </button>
                }
            </div>

            @* Sub-lookup pills within selected category *@
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                <span class="hr-meta" style="font-weight: 600; margin-inline-end: 0.25rem;">القائمة المنسدلة:</span>
                @foreach (var item in CurrentCategoryLookups)
                {
                    var isActive = selectedLookupKey == item.Key;
                    <button type="button"
                            class="hr-badge @(isActive ? "hr-badge-accent" : "")"
                            style="cursor: pointer; padding: 0.4rem 0.85rem; font-size: var(--fs-caption); border: 1px solid @(isActive ? "var(--accent)" : "var(--line-soft)"); transition: all 0.15s ease;"
                            @onclick="() => SelectLookup(item.Key)">
                        <span>@item.Title</span>
                        <span style="opacity: 0.75; font-size: 0.85em; margin-inline-start: 0.35rem;">(@item.Count)</span>
                    </button>
                }
            </div>
        </div>
    </div>

    @* Relationship & Context Card *@
    <div class="hr-card" style="padding: 1.15rem 1.35rem; background: var(--accent-tint); border-color: var(--accent-tint-2);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
            <div style="flex: 1 1 320px;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                    <Icon Name="link" Size="sm" />
                    <h2 style="margin: 0; font-size: var(--fs-body); font-weight: 700;">ترابط وتفاصيل قائمة: @CurrentMeta.Title</h2>
                </div>
                <p style="margin: 0; font-size: var(--fs-caption); color: var(--text-muted); line-height: 1.6;">
                    @CurrentMeta.RelationshipDescription
                </p>
                <div style="margin-top: 0.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: var(--fs-caption); color: var(--text-muted);">
                    <span><strong>الجدول في قاعدة البيانات:</strong> <code>@CurrentMeta.DbTableName</code></span>
                    <span><strong>الحقول المرتبطة:</strong> <code>@CurrentMeta.LinkedForeignKey</code></span>
                    <span><strong>أماكن الظهور في الواجهات:</strong> @CurrentMeta.UsedInScreens</span>
                </div>
            </div>

            @if (itemsList.Count == 0 && CurrentMeta.HasDefaultSeeder)
            {
                <div>
                    <button type="button" class="hr-btn hr-btn-secondary" style="border-color: var(--accent);" @onclick="SeedDefaultsAsync" disabled="@isLoading">
                        <Icon Name="sparkles" Size="xs" />
                        <span>تعبئة القيم الافتراضية القياسية</span>
                    </button>
                </div>
            }
        </div>
    </div>

    @* Search & Filter Toolbar *@
    <div class="hr-card" style="padding: 0.85rem 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <div style="flex: 1 1 280px; position: relative;">
                <input aria-label="البحث في عناصر القائمة" type="search"
                       class="hr-input"
                       placeholder="ابحث في عناصر @CurrentMeta.Title بالاسم أو الرمز..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       style="padding-inline-start: 2rem; width: 100%;" />
                <span style="position: absolute; inset-inline-start: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">
                    <Icon Name="magnifying-glass" Size="xs" />
                </span>
            </div>
            <div style="font-size: var(--fs-caption); color: var(--text-muted);">
                إجمالي العناصر: <strong>@filteredItems.Count</strong> من أصل <strong>@itemsList.Count</strong>
            </div>
        </div>
    </div>

    @* Main Lookup Table *@
    <div class="hr-card" style="padding: 0; overflow: hidden;">
        @if (isLoading)
        {
            <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
                <Icon Name="arrow-path" Size="md" Class="hr-spin" />
                <p style="margin-top: 0.5rem;">جاري تحميل بيانات @CurrentMeta.Title...</p>
            </div>
        }
        else if (filteredItems.Count == 0)
        {
            <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
                <Icon Name="inbox" Size="lg" />
                <p style="margin-top: 0.5rem; font-weight: 600;">لا توجد عناصر مسجلة في قائمة @CurrentMeta.Title</p>
                <p style="font-size: var(--fs-caption);">اضغط على زر "إضافة" بالأعلى لإضافة خيارات جديدة لهذه القائمة المنسدلة.</p>
            </div>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table class="hr-table" style="width: 100%; border-collapse: collapse; text-align: start;">
                    <thead>
                        <tr style="background: var(--surface-sunken); border-bottom: 2px solid var(--line-soft);">
                            <th scope="col" style="padding: 0.75rem 1rem; width: 60px;">المعرف</th>
                            <th scope="col" style="padding: 0.75rem 1rem;">الاسم المعتمد (Name)</th>
                            @if (CurrentMeta.HasCode)
                            {
                                <th scope="col" style="padding: 0.75rem 1rem; width: 120px;">الرمز (Code)</th>
                            }
                            @if (CurrentMeta.HasSecondaryField)
                            {
                                <th scope="col" style="padding: 0.75rem 1rem;">@CurrentMeta.SecondaryFieldTitle</th>
                            }
                            <th scope="col" style="padding: 0.75rem 1rem; width: 150px; text-align: center;">سجلات مرتبطة (ترابط)</th>
                            <th scope="col" style="padding: 0.75rem 1rem; width: 140px; text-align: center;">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in filteredItems)
                        {
                            var usageCount = row.UsageCount;
                            <tr style="border-bottom: 1px solid var(--line-soft); transition: background 0.1s ease;">
                                <td style="padding: 0.65rem 1rem; font-weight: 600; color: var(--text-muted);">
                                    #@row.Id
                                </td>
                                <td style="padding: 0.65rem 1rem; font-weight: 600;">
                                    @row.Name
                                    @if (!string.IsNullOrEmpty(row.BadgeText))
                                    {
                                        <span class="hr-badge" style="margin-inline-start: 0.5rem; font-size: 0.8em;">@row.BadgeText</span>
                                    }
                                </td>
                                @if (CurrentMeta.HasCode)
                                {
                                    <td style="padding: 0.65rem 1rem;">
                                        @if (!string.IsNullOrEmpty(row.Code))
                                        {
                                            <code style="background: var(--surface-sunken); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em;">@row.Code</code>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">-</span>
                                        }
                                    </td>
                                }
                                @if (CurrentMeta.HasSecondaryField)
                                {
                                    <td style="padding: 0.65rem 1rem; font-size: var(--fs-caption); color: var(--text-muted);">
                                        @(string.IsNullOrEmpty(row.SecondaryValue) ? "-" : row.SecondaryValue)
                                    </td>
                                }
                                <td style="padding: 0.65rem 1rem; text-align: center;">
                                    @if (usageCount > 0)
                                    {
                                        <span class="hr-badge hr-badge--ok" title="هذا العنصر مستخدم ومقترن بـ @usageCount سجل">
                                            @usageCount سجل مقترن
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hr-badge" style="color: var(--text-muted);" title="عنصر متاح وغير مقترن بأي سجل حتى الآن">
                                            0 (غير مستخدم)
                                        </span>
                                    }
                                </td>
                                <td style="padding: 0.65rem 1rem; text-align: center;">
                                    <div style="display: flex; gap: 0.35rem; justify-content: center;">
                                        <button type="button"
                                                class="hr-btn hr-btn-secondary"
                                                style="padding: 0.25rem 0.5rem;"
                                                @onclick="() => OpenEditModal(row)"
                                                title="تعديل هذا العنصر">
                                            <Icon Name="pencil-square" Size="xs" />
                                        </button>
                                        <button type="button"
                                                class="hr-btn hr-btn-secondary"
                                                style="padding: 0.25rem 0.5rem; color: var(--danger);"
                                                @onclick="() => ConfirmDelete(row)"
                                                title="حذف هذا العنصر">
                                            <Icon Name="trash" Size="xs" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ==================== MODAL: ADD / EDIT LOOKUP ITEM ==================== *@
<Modal IsOpen="@showAddEditModal"
       Title="@(modalItem.Id > 0 ? $"تعديل عنصر في {CurrentMeta.Title}" : $"إضافة خيار جديد إلى {CurrentMeta.Title}")"
       Icon="@(modalItem.Id > 0 ? "pencil-square" : "plus")"
       OnClose="CloseModals">
    <Body>
        <div class="hr-stack" style="gap: 1rem;">
            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="hr-alert hr-alert-danger" role="alert">
                    <Icon Name="exclamation-circle" Size="xs" />
                    <span>@modalError</span>
                </div>
            }

            @* Name field *@
            <div>
                <label for="f-admin-lookups-1" class="hr-field-label">
                    الاسم المعتمد في القائمة <span class="hr-req" aria-hidden="true">*</span>
                </label>
                <input id="f-admin-lookups-1"
                       type="text"
                       class="hr-input"
                       aria-required="true"
                       placeholder="مثال: هندسة برمجيات، ملاك دائم، بغداد..."
                       @bind="modalItem.Name" />
            </div>

            @* Code field (if applicable) *@
            @if (CurrentMeta.HasCode)
            {
                <div>
                    <label for="f-admin-lookups-2" class="hr-field-label">الرمز أو الاختصار (Code)</label>
                    <input id="f-admin-lookups-2"
                           type="text"
                           class="hr-input"
                           placeholder="مثال: ENG, BGD, 01..."
                           @bind="modalItem.Code" />
                </div>
            }

            @* Extra fields specific to lookup type *@
            @if (selectedLookupKey == "PenaltyTypes")
            {
                <div>
                    <label for="f-admin-lookups-3" class="hr-field-label">مدة تأخير الترفيع بالأشهر</label>
                    <input id="f-admin-lookups-3"
                           type="number"
                           class="hr-input"
                           min="0"
                           max="60"
                           @bind="modalItem.SecondaryInt" />
                </div>
                <div>
                    <label for="f-admin-lookups-4" class="hr-field-label">الوصف أو الأثر الانضباطي</label>
                    <input id="f-admin-lookups-4"
                           type="text"
                           class="hr-input"
                           placeholder="تأخير العلاوة والترفيع لمدة شهرين..."
                           @bind="modalItem.Description" />
                </div>
            }
            else if (selectedLookupKey == "MartyrKinships")
            {
                <div>
                    <label for="f-admin-lookups-5" class="hr-field-label">درجة القرابة</label>
                    <select id="f-admin-lookups-5" class="hr-input" @bind="modalItem.SecondaryInt">
                        <option value="1">الدرجة الأولى (أب، أم، ابن، بنت، زوج/زوجة)</option>
                        <option value="2">الدرجة الثانية (أخ، أخت، جد، جدة)</option>
                        <option value="3">الدرجة الثالثة (عم، عمة، خال، خالة)</option>
                        <option value="4">الدرجة الرابعة</option>
                    </select>
                </div>
            }
            else if (selectedLookupKey == "Grades")
            {
                <div>
                    <label for="f-admin-lookups-6" class="hr-field-label">ترتيب الفرز (Sort Order)</label>
                    <input id="f-admin-lookups-6"
                           type="number"
                           class="hr-input"
                           min="1"
                           max="100"
                           @bind="modalItem.SecondaryInt" />
                </div>
            }
            else if (selectedLookupKey == "Stages")
            {
                <div>
                    <label for="f-admin-lookups-7" class="hr-field-label">رقم المرحلة (1-11)</label>
                    <input id="f-admin-lookups-7"
                           type="number"
                           class="hr-input"
                           min="1"
                           max="11"
                           @bind="modalItem.SecondaryInt" />
                </div>
            }
            else if (selectedLookupKey == "AppreciationLetterTypes")
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                    <div>
                        <label for="f-admin-lookups-8" class="hr-field-label">القِدم بالأشهر</label>
                        <input id="f-admin-lookups-8" type="number" class="hr-input" min="0" @bind="modalItem.SecondaryInt" />
                    </div>
                    <div>
                        <label for="f-admin-lookups-9" class="hr-field-label">القِدم بالأيام</label>
                        <input id="f-admin-lookups-9" type="number" class="hr-input" min="0" @bind="modalItem.ExtraInt" />
                    </div>
                </div>
            }
        </div>
    </Body>
    <Footer>
        <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseModals" disabled="@isSubmitting">
            إلغاء
        </button>
        <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveModalItemAsync" disabled="@isSubmitting">
            <Icon Name="check" Size="xs" />
            <span>@(isSubmitting ? "جاري الحفظ..." : "حفظ التغييرات")</span>
        </button>
    </Footer>
</Modal>

@* ==================== MODAL: DELETE CONFIRMATION ==================== *@
<Modal IsOpen="@showDeleteModal"
       Title="تأكيد حذف الخيار المرجعي"
       Icon="exclamation-triangle"
       Size="sm"
       OnClose="CloseModals">
    <Body>
        <div class="hr-stack" style="gap: 0.75rem;">
            @if (itemToDelete != null && itemToDelete.UsageCount > 0)
            {
                <div class="hr-alert hr-alert-danger" style="margin: 0;">
                    <Icon Name="shield-exclamation" Size="sm" />
                    <div>
                        <strong style="display: block; margin-bottom: 0.25rem;">تنبيه حماية سلامة البيانات:</strong>
                        هذا العنصر (<strong>@itemToDelete.Name</strong>) مقترن ومستخدم حالياً في <strong>@itemToDelete.UsageCount</strong> سجل في المنظومة.
                        لا يمكن حذفه مباشرة لمنع تلف أو كسر البيانات في ملفات الموظفين. يجب نقل أو تعديل السجلات المقترنة أولاً.
                    </div>
                </div>
            }
            else
            {
                <p style="margin: 0; font-size: var(--fs-body);">
                    هل أنت متأكد من رغبتك في حذف <strong>"@itemToDelete?.Name"</strong> من قائمة @CurrentMeta.Title؟
                </p>
                <p style="margin: 0; font-size: var(--fs-caption); color: var(--text-muted);">
                    لن يظهر هذا الخيار مجدداً في القوائم المنسدلة بالمنظومة.
                </p>
            }
        </div>
    </Body>
    <Footer>
        <button type="button" class="hr-btn hr-btn-secondary" @onclick="CloseModals" disabled="@isSubmitting">
            إلغاء
        </button>
        <button type="button"
                class="hr-btn hr-btn-danger"
                @onclick="ExecuteDeleteAsync"
                disabled="@(isSubmitting || (itemToDelete != null && itemToDelete.UsageCount > 0))">
            <Icon Name="trash" Size="xs" />
            <span>@(isSubmitting ? "جاري الحذف..." : "تأكيد الحذف")</span>
        </button>
    </Footer>
</Modal>

@code {
    // Categories and metadata structures
    private sealed record LookupCategory(string Key, string Name, string Icon);

    private sealed record LookupMeta(
        string Key,
        string Title,
        string Category,
        string DbTableName,
        string LinkedForeignKey,
        string UsedInScreens,
        string RelationshipDescription,
        bool HasCode = false,
        bool HasSecondaryField = false,
        string SecondaryFieldTitle = "",
        bool HasDefaultSeeder = false
    )
    {
        public int Count { get; set; } = 0;
    }

    private sealed class LookupRowItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Code { get; set; }
        public string? SecondaryValue { get; set; }
        public int? SecondaryInt { get; set; }
        public int? ExtraInt { get; set; }
        public string? Description { get; set; }
        public string? BadgeText { get; set; }
        public int UsageCount { get; set; } = 0;
    }

    // State
    private string selectedCategory = "Organization";
    private string selectedLookupKey = "Formations";
    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private bool isSubmitting = false;

    // Modals
    private bool showAddEditModal = false;
    private bool showDeleteModal = false;
    private string? modalError = null;
    private LookupRowItem modalItem = new();
    private LookupRowItem? itemToDelete = null;

    private readonly List<LookupCategory> LookupCategories = new()
    {
        new("Organization", "الهيكل الإداري والتشكيلات", "building-office-2"),
        new("JobStructure", "المسار والتوصيف الوظيفي", "briefcase"),
        new("CivilData", "البيانات المدنية والشخصية", "user"),
        new("LeavesAndPenalties", "الإجازات والعقوبات", "calendar-days"),
        new("HonorsAndAllowances", "الشكر، الشهداء والمخصصات", "gift")
    };

    private readonly List<LookupMeta> AllLookups = new()
    {
        // 1. Organization
        new("Formations", "التشكيلات الإدارية", "Organization", "Formations", "Employee.FormationId, AdministrativeUnit.FormationId", "ملف الموظف، لوحة مؤشرات التشكيل، شجرة التشكيلات", "التشكيلات الرئيسية في المنظومة. ترتبط بها كافة الوحدات الإدارية والموظفون ورؤساء التشكيلات."),
        new("AdministrativeUnitTypes", "أنواع الوحدات الإدارية", "Organization", "AdministrativeUnitTypes", "AdministrativeUnit.UnitTypeId", "الهيكل التنظيمي الشجري، تصنيف الدوائر والأقسام", "تصنيفات المستوى الإداري (أمانة، مديرية، قسم، شعبة، وحدة). تحدد المستوى الهرمي والتبعية.", HasCode: true),

        // 2. Job Structure
        new("JobFamilies", "العوائل الوظيفية والتصنيف", "JobStructure", "JobFamilies", "JobTitle.JobFamilyId", "دليل العناوين الوظيفية، الهيكل المهني", "التصنيف المهني العام (مثل: المجموعة الهندسية، الإدارية، القانونية، الفنية). تجمع العناوين الوظيفية ذات الطبيعة الواحدة.", HasCode: true),
