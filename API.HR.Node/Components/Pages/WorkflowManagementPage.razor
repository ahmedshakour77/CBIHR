@* ---------- take action ---------- *@
<Modal IsOpen="@(selectedInstance != null)"
       Title="اتخاذ إجراء على المعاملة"
       Subtitle="@(selectedInstance is null ? null : $"المعاملة رقم {selectedInstance.Id}")"
       Icon="check"
       OnClose="() => selectedInstance = null">
    <Body>
        @if (selectedInstance is not null)
        {
            <dl class="hr-deflist">
                <div class="hr-deflist-row">
                    <dt>نوع المسار</dt>
                    <dd>@selectedInstance.WorkflowName</dd>
                </div>
                <div class="hr-deflist-row">
                    <dt>المرحلة الحالية</dt>
                    <dd>@selectedInstance.CurrentStepName <span class="hr-num">(@selectedInstance.CurrentStepCode)</span></dd>
                </div>
            </dl>

            <fieldset class="hr-fieldset" style="margin-block-start:1.25rem">
                <legend class="hr-legend-title">الإجراء المطلوب</legend>
                <div class="hr-optiongrid" style="margin-block-start:.5rem">
                    @foreach (var action in selectedInstance.AvailableActions)
                    {
                        <button type="button"
                                class="hr-optioncard hr-optioncard-btn @(selectedActionCode == action.Code ? "is-selected" : "")"
                                aria-pressed="@((selectedActionCode == action.Code) ? "true" : "false")"
                                @onclick="() => selectedActionCode = action.Code">
                            <span class="hr-optioncard-text">
                                <span class="hr-optioncard-title">@action.Label</span>
                                <span class="hr-optioncard-code hr-num">@action.Code</span>
                            </span>
                        </button>
                    }
                </div>
            </fieldset>

            <div class="hr-field" style="margin-block-start:1.25rem">
                <label class="hr-field-label" for="action-comment">التعليق والسبب الإداري</label>
                <textarea id="action-comment" class="hr-textarea" rows="3"
                          placeholder="سبب الاعتماد أو الرفض" @bind="actionComment"></textarea>
                <p class="hr-help">يُحفظ التعليق في الخط الزمني للمعاملة ويظهر لبقية المعنيين.</p>
            </div>
        }
    </Body>
    <Footer>
        <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => selectedInstance = null" disabled="@isExecutingAction">إلغاء</button>
        <button type="button" class="hr-btn hr-btn-primary" @onclick="ExecuteActionAsync"
                disabled="@(string.IsNullOrWhiteSpace(selectedActionCode) || isExecutingAction)">
            @if (isExecutingAction)
            {
                <span class="hr-spinner" aria-hidden="true"></span>
                <span>جارٍ المعالجة…</span>
            }
            else
            {
                <Icon Name="check" Size="xs" />
                <span>تنفيذ الإجراء</span>
            }
        </button>
    </Footer>
</Modal>

@* ---------- timeline ---------- *@
<Modal IsOpen="@(selectedTimelineItems != null)"
