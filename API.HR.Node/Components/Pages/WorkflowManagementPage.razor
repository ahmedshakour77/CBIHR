@page "/workflows"
@attribute [Authorize(Roles = "Admin,HRManager,FormationManager,Supervisor")]
@rendermode InteractiveServer

@using API.HR.Node.Data.Workflows
@using API.HR.Node.Services.Workflows
@using System.Text.Json

@inject IWorkflowEngine WorkflowEngine
@inject IWorkflowTimelineService TimelineService
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<WorkflowManagementPage> Logger

<PageTitle>المسارات الإدارية | الموظف ٣٦٠°   </PageTitle>

@*
    Workflow engine.

    Five jobs on one page, so they are real tabs: a tablist, aria-selected,
    one panel at a time. The tab that matters most — pending tasks assigned
    to the signed-in user — leads, and carries its count so the badge is
    readable without opening it.

    The API sandbox is a developer surface living inside an operator's
    system. It keeps its console look on purpose, but the console is now a
    contained region with brand-derived tones rather than a second colour
    scheme competing with the page around it.
*@

<div class="hr-stack">

    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <span class="hr-eyebrow">مساحة العمل</span>
            <h1 class="hr-h1">المسارات الإدارية وحوكمة العمليات</h1>
            <p class="hr-sub hr-measure" style="margin-block-start:.5rem">
                محرك المسارات الديناميكي: تعريف الإجراءات، إطلاق المعاملات، تتبّع الخط الزمني، وضبط الأذونات وحماية التزامن.
            </p>
        </div>

        <div class="hr-pagehead-actions">
            <span class="hr-badge hr-badge-warn">
                <Icon Name="inbox" Size="xs" />
                <span>مهامي <span class="hr-num">@myTasks.Count</span></span>
            </span>
            <span class="hr-badge hr-badge-accent">
                <Icon Name="arrow-path" Size="xs" />
                <span>سارية <span class="hr-num">@activeInstancesCount</span></span>
            </span>
            <button type="button" class="hr-btn hr-btn-secondary" @onclick="LoadAllDataAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="hr-spinner" aria-hidden="true"></span>
                    <span>جارٍ التحديث…</span>
                }
                else
                {
                    <Icon Name="arrow-path" Size="sm" />
                    <span>تحديث</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="hr-alert @(isError ? "hr-alert-danger" : "hr-alert-ok")" role="alert">
            <Icon Name="@(isError ? "exclamation-triangle" : "check-circle")" Size="sm" />
            <div class="hr-alert-grow"><p class="hr-wrap-any">@statusMessage</p></div>
            <button type="button" class="hr-btn hr-btn-quiet hr-btn-icon hr-btn-sm"
                    @onclick="() => statusMessage = null" aria-label="إخفاء الرسالة">
                <Icon Name="x-mark" Size="sm" />
            </button>
        </div>
    }

    <div class="hr-tabs" role="tablist" aria-label="أقسام المسارات الإدارية">
        <button type="button" role="tab" class="hr-tab" id="tab-tasks" aria-controls="panel-tasks"
                aria-selected="@((currentTab == "tasks") ? "true" : "false")" @onclick='() => currentTab = "tasks"'>
            <Icon Name="inbox" Size="sm" />
            <span>مهامي المعلقة</span>
            <span class="hr-badge hr-num">@myTasks.Count</span>
        </button>

        <button type="button" role="tab" class="hr-tab" id="tab-start" aria-controls="panel-start"
                aria-selected="@((currentTab == "start") ? "true" : "false")" @onclick='() => currentTab = "start"'>
            <Icon Name="plus" Size="sm" />
            <span>إطلاق معاملة</span>
        </button>

        <button type="button" role="tab" class="hr-tab" id="tab-instances" aria-controls="panel-instances"
                aria-selected="@((currentTab == "instances") ? "true" : "false")" @onclick='() => currentTab = "instances"'>
            <Icon Name="rectangle-stack" Size="sm" />
            <span>المعاملات السارية</span>
        </button>

        <button type="button" role="tab" class="hr-tab" id="tab-definitions" aria-controls="panel-definitions"
                aria-selected="@((currentTab == "definitions") ? "true" : "false")" @onclick='() => currentTab = "definitions"'>
            <Icon Name="cog-6-tooth" Size="sm" />
            <span>تعاريف المسارات</span>
        </button>

        <button type="button" role="tab" class="hr-tab" id="tab-simulator" aria-controls="panel-simulator"
                aria-selected="@((currentTab == "simulator") ? "true" : "false")" @onclick='() => currentTab = "simulator"'>
            <Icon Name="code-bracket" Size="sm" />
            <span>محاكي الواجهات</span>
        </button>
    </div>

    @* ---------- my tasks ---------- *@
    @if (currentTab == "tasks")
    {
        <section id="panel-tasks" role="tabpanel" aria-labelledby="tab-tasks" tabindex="0" class="hr-card">
            <div class="hr-card-head">
                <div>
                    <h2 class="hr-h2">المهام الموجّهة إلى حسابك</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        المعاملات المعلّقة التي تنتظر قرارك: موافقة، رفض، أو إعادة للتعديل.
                    </p>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="hr-card-body">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="hr-skeleton" style="height:3rem;margin-block-end:.5rem" aria-hidden="true"></div>
                    }
                </div>
            }
            else if (myTasks.Count == 0)
            {
                <div class="hr-empty">
                    <span class="hr-empty-art hr-empty-art-ok" aria-hidden="true"><Icon Name="check-circle" Size="lg" /></span>
                    <p class="hr-h3">لا توجد مهام معلّقة</p>
                    <p class="hr-sub hr-measure-sm">كل المعاملات الموجّهة إليك مكتملة.</p>
                </div>
            }
            else
            {
                <div class="hr-tablewrap">
                    <table class="hr-table">
                        <caption class="hr-sr">المهام المعلّقة الموجّهة إلى حسابك</caption>
                        <thead>
                            <tr>
                                <th scope="col">المهمة</th>
                                <th scope="col">المعاملة</th>
                                <th scope="col">المرحلة الحالية</th>
                                <th scope="col">تاريخ الإسناد</th>
                                <th scope="col">الاستحقاق</th>
                                <th scope="col"><span class="hr-sr">إجراءات</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in myTasks)
                            {
                                <tr @key="task.Id">
                                    <td class="hr-num">@task.Id</td>
                                    <td><span class="hr-cell-strong hr-num">@task.WorkflowInstanceId</span></td>
                                    <td>
                                        <span class="hr-cell-strong">@task.StepName</span>
                                        <span class="hr-cell-sub hr-num">@task.StepCode</span>
                                    </td>
                                    <td class="hr-num">@task.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (task.DueAt.HasValue)
                                        {
                                            <span class="hr-badge hr-badge-warn">
                                                <Icon Name="clock" Size="xs" />
                                                <span class="hr-num">@task.DueAt.Value.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="hr-meta">مفتوح</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="hr-rowactions">
                                            <button type="button" class="hr-btn hr-btn-primary hr-btn-sm"
                                                    @onclick="() => OpenActionModal(task.WorkflowInstanceId)">
                                                <Icon Name="check" Size="xs" />
                                                <span>اتخاذ إجراء</span>
                                            </button>
                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm"
                                                    @onclick="() => ViewTimelineAsync(task.WorkflowInstanceId)">
                                                <Icon Name="clock" Size="xs" />
                                                <span>الخط الزمني</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @* ---------- start a workflow ---------- *@
    @if (currentTab == "start")
    {
        <section id="panel-start" role="tabpanel" aria-labelledby="tab-start" tabindex="0" class="hr-card hr-narrow">
            <div class="hr-card-head">
                <div>
                    <h2 class="hr-h2">إطلاق معاملة جديدة</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        اختر نوع المسار وحدّد الكيان المعني لبدء الحركة الإدارية.
                    </p>
                </div>
            </div>

            <div class="hr-card-body">
                <div class="hr-field">
                    <label class="hr-field-label" for="wf-code">نوع المسار الإداري</label>
                    <select id="wf-code" class="hr-select" @bind="newWorkflowCode">
                        @foreach (var def in workflowDefinitions.Where(d => d.IsEnabled))
                        {
                            <option value="@def.Code">@def.Name (@def.Code)</option>
                        }
                    </select>
                </div>

                <div class="hr-field">
                    <label class="hr-field-label" for="wf-entity-type">نوع الكيان المرتبط</label>
                    <input id="wf-entity-type" type="text" class="hr-input" dir="ltr" @bind="newEntityType"
                           placeholder="AppreciationLetter, LeaveRequest…" />
                    <p class="hr-help">اسم الكيان كما هو معرّف في النظام، باللاتينية.</p>
                </div>

                <div class="hr-field">
                    <label class="hr-field-label" for="wf-entity-id">معرّف الكيان</label>
                    <input id="wf-entity-id" type="text" inputmode="numeric" class="hr-input" dir="ltr" @bind="newEntityId"
                           placeholder="1001" />
                </div>
            </div>

            <div class="hr-card-foot" style="display:flex;justify-content:flex-end">
                <button type="button" class="hr-btn hr-btn-primary" @onclick="StartNewWorkflowAsync" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="hr-spinner" aria-hidden="true"></span>
                        <span>جارٍ الإطلاق…</span>
                    }
                    else
                    {
                        <Icon Name="plus" Size="xs" />
                        <span>إطلاق المعاملة</span>
                    }
                </button>
            </div>
        </section>
    }

    @* ---------- running instances ---------- *@
    @if (currentTab == "instances")
    {
        <section id="panel-instances" role="tabpanel" aria-labelledby="tab-instances" tabindex="0" class="hr-card">
            <div class="hr-card-head">
                <div>
                    <h2 class="hr-h2">المعاملات والمسارات السارية</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        كل المعاملات وحالاتها وموقعها الحالي في الخطة الإدارية.
                    </p>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="hr-card-body">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="hr-skeleton" style="height:3rem;margin-block-end:.5rem" aria-hidden="true"></div>
                    }
                </div>
            }
            else if (allInstances.Count == 0)
            {
                <div class="hr-empty">
                    <span class="hr-empty-art" aria-hidden="true"><Icon Name="rectangle-stack" Size="lg" /></span>
                    <p class="hr-h3">لا توجد معاملات</p>
                    <p class="hr-sub hr-measure-sm">لم تُطلق أي معاملة في المسارات الإدارية بعد.</p>
                </div>
            }
            else
            {
                <div class="hr-tablewrap">
                    <table class="hr-table">
                        <caption class="hr-sr">المعاملات الجارية في المسارات الإدارية</caption>
                        <thead>
                            <tr>
                                <th scope="col">المعاملة</th>
                                <th scope="col">المسار</th>
                                <th scope="col">الكيان</th>
                                <th scope="col">المرحلة</th>
                                <th scope="col">المُطلِق</th>
                                <th scope="col">الحالة</th>
                                <th scope="col"><span class="hr-sr">إجراءات</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inst in allInstances)
                            {
                                <tr @key="inst.Id">
                                    <td class="hr-num">@inst.Id</td>
                                    <td>
                                        <span class="hr-cell-strong hr-truncate hr-cell-wide">@inst.WorkflowVersion.WorkflowDefinition.Name</span>
                                        <span class="hr-cell-sub hr-num">@inst.WorkflowVersion.WorkflowDefinition.Code</span>
                                    </td>
                                    <td>
                                        <span class="hr-cell-strong">@inst.EntityType</span>
                                        <span class="hr-cell-sub hr-num">@inst.EntityId</span>
                                    </td>
                                    <td><span class="hr-badge hr-badge-accent">@inst.CurrentStep.Name</span></td>
                                    <td><span class="hr-truncate hr-cell-wide">@inst.InitiatorUserId</span></td>
                                    <td>
                                        @if (inst.Status == WorkflowInstanceStatus.Running)
                                        {
                                            <span class="hr-badge hr-badge-warn">
                                                <Icon Name="clock" Size="xs" />
                                                <span>جارية</span>
                                            </span>
                                        }
                                        else if (inst.Status == WorkflowInstanceStatus.Completed)
                                        {
                                            <span class="hr-badge hr-badge-ok">
                                                <Icon Name="check-circle" Size="xs" />
                                                <span>مكتملة</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="hr-badge hr-badge-danger">
                                                <Icon Name="no-symbol" Size="xs" />
                                                <span>@inst.Status</span>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="hr-rowactions">
                                            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                                                    @onclick="() => OpenActionModal(inst.Id)">
                                                <Icon Name="check" Size="xs" />
                                                <span>الإجراءات</span>
                                            </button>
                                            <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm hr-btn-icon"
                                                    @onclick="() => ViewTimelineAsync(inst.Id)"
                                                    aria-label="@($"الخط الزمني للمعاملة {inst.Id}")" title="الخط الزمني">
                                                <Icon Name="clock" Size="xs" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @* ---------- definitions ---------- *@
    @if (currentTab == "definitions")
    {
        <div id="panel-definitions" role="tabpanel" aria-labelledby="tab-definitions" tabindex="0" class="hr-stack-sm">
            <div class="hr-section-head">
                <div>
                    <h2 class="hr-h2">تعاريف المسارات والنسخ المنشورة</h2>
                    <p class="hr-meta" style="margin-block-start:.25rem">
                        تصميم المسارات وتفعيلها مباشرة للنظام وتطبيق الهاتف، دون كتابة كود.
                    </p>
                </div>
                <button type="button" class="hr-btn hr-btn-primary" @onclick="OpenCreateWorkflowModal">
                    <Icon Name="plus" Size="sm" />
                    <span>مسار جديد</span>
                </button>
            </div>

            @if (workflowDefinitions.Count == 0)
            {
                <div class="hr-card">
                    <div class="hr-empty">
                        <span class="hr-empty-art" aria-hidden="true"><Icon Name="cog-6-tooth" Size="lg" /></span>
                        <p class="hr-h3">لا توجد مسارات معرّفة</p>
                    </div>
                </div>
            }
            else
            {
                <div class="hr-grid-cards">
                    @foreach (var def in workflowDefinitions)
                    {
                        <article class="hr-card" @key="def.Id">
                            <div class="hr-card-body">
                                <div class="hr-idcell">
                                    <span class="hr-iconplate" aria-hidden="true"><Icon Name="square-3-stack-3d" Size="sm" /></span>
                                    <div class="hr-idcell-text">
                                        <h3 class="hr-h3 hr-truncate">@def.Name</h3>
                                        <span class="hr-cell-sub hr-num">@def.Code</span>
                                    </div>
                                    @if (def.IsEnabled)
                                    {
                                        <span class="hr-badge hr-badge-ok">
                                            <Icon Name="check-circle" Size="xs" />
                                            <span>مفعّل</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hr-badge hr-badge-warn">
                                            <Icon Name="no-symbol" Size="xs" />
                                            <span>موقوف</span>
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(def.Description))
                                {
                                    <p class="hr-sub" style="margin-block-start:.75rem">@def.Description</p>
                                }

                                <dl class="hr-deflist" style="margin-block-start:.75rem">
                                    <div class="hr-deflist-row">
                                        <dt>عدد النسخ</dt>
                                        <dd class="hr-num">@def.Versions.Count</dd>
                                    </div>
                                    <div class="hr-deflist-row">
                                        <dt>النسخة المفعّلة</dt>
                                        <dd class="hr-num">
                                            v@(def.Versions.FirstOrDefault(v => v.Status == WorkflowVersionStatus.Published)?.VersionNumber ?? 1)
                                        </dd>
                                    </div>
                                </dl>
                            </div>

                            <div class="hr-card-foot" style="display:flex;justify-content:flex-end">
                                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                                        @onclick="() => OpenFormSchemaEditor(def)">
                                    <Icon Name="document-text" Size="xs" />
                                    <span>استمارة الطلب</span>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }

    @* ---------- API sandbox ---------- *@
    @if (currentTab == "simulator")
    {
        <div id="panel-simulator" role="tabpanel" aria-labelledby="tab-simulator" tabindex="0" class="hr-stack-sm">

            <div class="hr-alert hr-alert-accent">
                <Icon Name="information-circle" Size="sm" />
                <div class="hr-alert-grow">
                    <p class="hr-alert-title">محاكي واجهات العميل والهاتف</p>
                    <p style="margin-block-start:.25rem">
                        بيئة تجريبية لتتبّع تسلسل طلبات الـ REST كما يرسلها التطبيق، مع عرض الحمولة والاستجابة.
                        <span class="hr-num hr-wrap-any" dir="ltr">https://apihr.iraqservice.uk/api</span>
                    </p>
                </div>
            </div>

            @* Progress through the sandbox: each step states its own number
               and label, so the sequence reads without relying on fill. *@
            <ol class="hr-steps">
                <li class="hr-step @(simStep >= 1 ? "is-done" : "")">
                    <span class="hr-step-mark hr-num">1</span>
                    <span>إطلاق المعاملة</span>
                </li>
                <li class="hr-step @(simStep >= 2 ? "is-done" : "")">
                    <span class="hr-step-mark hr-num">2</span>
                    <span>المهام والإجراءات</span>
                </li>
                <li class="hr-step @(simStep >= 3 ? "is-done" : "")">
                    <span class="hr-step-mark hr-num">3</span>
                    <span>تنفيذ القرار</span>
                </li>
                <li class="hr-step @(simStep >= 4 ? "is-done" : "")">
                    <span class="hr-step-mark hr-num">4</span>
                    <span>الخط الزمني</span>
                </li>
            </ol>

            <div class="hr-grid-sandbox">
                <section class="hr-card">
                    <div class="hr-card-head">
                        <div>
                            <h2 class="hr-h2">إرسال الطلب</h2>
                            <p class="hr-meta hr-num" style="margin-block-start:.25rem" dir="ltr">POST /api/workflows/{code}/start</p>
                        </div>
                    </div>

                    <div class="hr-card-body">
                        <div class="hr-filterbar-row" style="align-items:flex-start">
                            <div class="hr-field hr-filter-grow">
                                <label class="hr-field-label" for="sim-code">نوع المسار</label>
                                <select id="sim-code" class="hr-select" @bind="simWorkflowCode" @bind:after="OnSimWorkflowChanged">
                                    @foreach (var def in workflowDefinitions.Where(d => d.IsEnabled))
                                    {
                                        <option value="@def.Code">@def.Name (@def.Code)</option>
                                    }
                                </select>
                            </div>

                            <div class="hr-field hr-filter-item">
                                <label class="hr-field-label" for="sim-entity">معرّف الطلب</label>
                                <input id="sim-entity" type="text" class="hr-input hr-num" dir="ltr" @bind="simEntityId" />
                            </div>
                        </div>

                        <fieldset class="hr-fieldset" style="margin-block-start:1rem">
                            <legend class="hr-legend-title">حقول الاستمارة المعرَّفة لهذا المسار</legend>

                            @if (simFormFields.Count > 0)
                            {
                                @foreach (var field in simFormFields)
                                {
                                    <div class="hr-field">
                                        <label class="hr-field-label" for="@($"simf-{field.Name}")">
                                            @field.Label
                                            @if (field.Required)
                                            {
                                                <span class="hr-req" aria-hidden="true">*</span>
                                                <span class="hr-sr">(حقل مطلوب)</span>
                                            }
                                        </label>
                                        @if (field.Type == "select" && field.Options != null)
                                        {
                                            <select id="@($"simf-{field.Name}")" class="hr-select" @bind="simFormValues[field.Name]">
                                                @foreach (var opt in field.Options)
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input id="@($"simf-{field.Name}")" type="text" class="hr-input"
                                                   placeholder="@field.Placeholder" @bind="simFormValues[field.Name]" />
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="hr-help">لا توجد حقول خاصة معرّفة لهذا المسار.</p>
                            }
                        </fieldset>

                        <button type="button" class="hr-btn hr-btn-primary hr-btn-block" style="margin-block-start:1rem"
                                @onclick="SimulateStartWorkflowAsync">
                            <Icon Name="arrow-up-tray" Size="xs" />
                            <span>إرسال طلب الإطلاق</span>
                        </button>

                        @if (simActiveInstanceId != null)
                        {
                            <div class="hr-divider" style="margin-block:1.5rem"></div>

                            <h3 class="hr-h3">تنفيذ الإجراء</h3>
                            <p class="hr-meta hr-num hr-wrap-any" style="margin-block-start:.25rem" dir="ltr">
                                POST /api/workflow-instances/{id}/actions/{actionCode}
                            </p>

                            <dl class="hr-deflist" style="margin-block-start:.75rem">
                                <div class="hr-deflist-row">
