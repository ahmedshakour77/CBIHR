@* ---------- workflow builder ---------- *@
<Modal IsOpen="@isCreateModalOpen"
       Title="تصميم مسار جديد"
       Subtitle="تعريف المسار ومراحله ونشره مباشرة"
       Icon="square-3-stack-3d"
       Size="xl"
       OnClose="() => isCreateModalOpen = false">
    <Body>
        <fieldset class="hr-fieldset">
            <legend class="hr-legend-title">بيانات المسار</legend>

            <div class="hr-filterbar-row" style="align-items:flex-start;margin-block-start:.5rem">
                <div class="hr-field hr-filter-grow">
                    <label class="hr-field-label" for="def-code">
                        رمز المسار <span class="hr-req" aria-hidden="true">*</span><span class="hr-sr">(حقل مطلوب)</span>
                    </label>
                    <input id="def-code" type="text" class="hr-input hr-num" dir="ltr"
                           placeholder="LEAVE_REQUEST" @bind="newDefCode" />
                    <p class="hr-help">حروف لاتينية كبيرة وشرطة سفلية، يُستخدم في نداءات الواجهة البرمجية.</p>
                </div>

                <div class="hr-field hr-filter-grow">
                    <label class="hr-field-label" for="def-name">
                        اسم المسار <span class="hr-req" aria-hidden="true">*</span><span class="hr-sr">(حقل مطلوب)</span>
                    </label>
                    <input id="def-name" type="text" class="hr-input"
                           placeholder="مسار طلبات الإجازات" @bind="newDefName" />
                </div>
            </div>

            <div class="hr-field">
                <label class="hr-field-label" for="def-desc">وصف المسار</label>
                <input id="def-desc" type="text" class="hr-input"
                       placeholder="مسار عام لمعالجة ومصادقة إجازات الموظفين" @bind="newDefDescription" />
            </div>
        </fieldset>

        <fieldset class="hr-fieldset" style="margin-block-start:1.5rem">
            <div class="hr-section-head" style="margin-block-end:.75rem">
                <legend class="hr-legend-title">المراحل المتسلسلة</legend>
                <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="AddDraftStep">
                    <Icon Name="plus" Size="xs" />
                    <span>إضافة مرحلة</span>
                </button>
            </div>

            @if (draftSteps.Count == 0)
            {
                <p class="hr-contactempty">لم تُضَف أي مرحلة بعد. يبدأ كل مسار بمرحلة بدء وينتهي بمرحلة نهاية.</p>
            }
            else
            {
                <ol class="hr-steplist">
                    @for (int i = 0; i < draftSteps.Count; i++)
                    {
                        var index = i;
                        var step = draftSteps[index];
                        <li class="hr-steprow">
                            <span class="hr-steprow-num hr-num" aria-hidden="true">@(index + 1)</span>

                            <div class="hr-field hr-filter-grow">
                                <label class="hr-sr" for="@($"step-name-{index}")">اسم المرحلة @(index + 1)</label>
                                <input id="@($"step-name-{index}")" type="text" class="hr-input"
                                       placeholder="اسم المرحلة" @bind="step.Name" />
                            </div>

                            <div class="hr-field hr-steprow-code">
                                <label class="hr-sr" for="@($"step-code-{index}")">رمز المرحلة @(index + 1)</label>
                                <input id="@($"step-code-{index}")" type="text" class="hr-input hr-num" dir="ltr"
                                       placeholder="STEP_CODE" @bind="step.Code" />
                            </div>

                            <div class="hr-field hr-steprow-type">
                                <label class="hr-sr" for="@($"step-type-{index}")">نوع المرحلة @(index + 1)</label>
                                <select id="@($"step-type-{index}")" class="hr-select" @bind="step.StepType">
                                    <option value="@WorkflowStepType.Start">بدء</option>
                                    <option value="@WorkflowStepType.Approval">موافقة</option>
                                    <option value="@WorkflowStepType.Review">مراجعة</option>
                                    <option value="@WorkflowStepType.HumanTask">مهمة عمل</option>
                                    <option value="@WorkflowStepType.End">نهاية</option>
                                </select>
                            </div>
                        </li>
                    }
                </ol>
            }
        </fieldset>
    </Body>
    <Footer>
        <button type="button" class="hr-btn hr-btn-secondary" @onclick="() => isCreateModalOpen = false" disabled="@isSavingWorkflow">إلغاء</button>
        <button type="button" class="hr-btn hr-btn-primary" @onclick="SaveAndPublishNewWorkflowAsync" disabled="@isSavingWorkflow">
            @if (isSavingWorkflow)
            {
                <span class="hr-spinner" aria-hidden="true"></span>
                <span>جارٍ الحفظ والنشر…</span>
            }
            else
            {
                <Icon Name="check" Size="xs" />
                <span>حفظ ونشر المسار</span>
            }
        </button>
    </Footer>
</Modal>

@code {
    private string currentTab = "tasks";
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isExecutingAction = false;
    private string? statusMessage;
    private bool isError;

    private List<WorkflowTaskDto> myTasks = new();
    private List<WorkflowInstance> allInstances = new();
    private List<WorkflowDefinition> workflowDefinitions = new();
    private int activeInstancesCount = 0;

    // Start Workflow Form
    private string newWorkflowCode = "APPRECIATION_LETTER";
    private string newEntityType = "AppreciationLetter";
    private string newEntityId = $"APP-{Random.Shared.Next(1000, 9999)}";

    // Action Execution Modal State
    private WorkflowInstanceDto? selectedInstance;
    private string? selectedActionCode;
    private string? actionComment;

    // Timeline Modal State
    private long selectedTimelineInstanceId;
    private List<WorkflowTimelineItemDto>? selectedTimelineItems;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        isLoading = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "systemadmin";

            // 1. Fetch My Tasks
            var tasks = await dbContext.WorkflowTasks
                .AsNoTracking()
                .Include(t => t.WorkflowStep)
                .Include(t => t.WorkflowInstance)
                .Where(t => (t.AssignedUserId == username || t.AssignedUserId == null) && t.Status == WorkflowTaskStatus.Pending)
                .OrderByDescending(t => t.CreatedAt)
                .ToListAsync();

            myTasks = tasks.Select(t => new WorkflowTaskDto(
                t.Id,
                t.WorkflowInstanceId,
                t.WorkflowStep.Code,
                t.WorkflowStep.Name,
                t.Status,
                t.AssignedUserId,
                t.AssignedRoleId,
                t.AssignedDepartmentId,
                t.CreatedAt,
                t.DueAt,
                t.CompletedAt)).ToList();

            // 2. Fetch Active Instances
            allInstances = await dbContext.WorkflowInstances
                .AsNoTracking()
                .Include(i => i.CurrentStep)
                .Include(i => i.WorkflowVersion)
                .ThenInclude(v => v.WorkflowDefinition)
                .OrderByDescending(i => i.StartedAt)
                .ToListAsync();

            activeInstancesCount = allInstances.Count(i => i.Status == WorkflowInstanceStatus.Running);

            // 3. Fetch Workflow Definitions
            workflowDefinitions = await dbContext.WorkflowDefinitions
                .AsNoTracking()
                .Include(d => d.Versions)
                .ToListAsync();

            if (workflowDefinitions.Count > 0 && string.IsNullOrWhiteSpace(newWorkflowCode))
            {
                newWorkflowCode = workflowDefinitions[0].Code;
            }

            LoadSimFormFields();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading workflow management data");
            statusMessage = $"تعذر تحميل بيانات المسارات: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartNewWorkflowAsync()
    {
        if (string.IsNullOrWhiteSpace(newWorkflowCode) || string.IsNullOrWhiteSpace(newEntityType) || string.IsNullOrWhiteSpace(newEntityId))
        {
            statusMessage = "يرجى اختيار نوع المسار وتعبئة نوع الكيان ومعرفه المطلوب.";
            isError = true;
            return;
        }

        isSubmitting = true;
        statusMessage = null;
        isError = false;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "systemadmin";

            var command = new StartWorkflowCommand(
                WorkflowCode: newWorkflowCode,
                EntityType: newEntityType,
                EntityId: newEntityId,
                InitiatorUserId: username);

            var result = await WorkflowEngine.StartAsync(command);

            statusMessage = $"تم إطلاق المعاملة بنجاح لرقم الكيان {newEntityId}. معرف المسار الجاري: #{result.WorkflowInstanceId}. المرحلة الأولى: {result.CurrentStepName}.";
            isError = false;

            // Generate next unique EntityId for subsequent launches
            newEntityId = $"{newEntityType.Substring(0, Math.Min(3, newEntityType.Length)).ToUpperInvariant()}-{Random.Shared.Next(1000, 9999)}";

            await LoadAllDataAsync();
            currentTab = "tasks";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start workflow");
            statusMessage = $"فشل إطلاق المعاملة: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenActionModal(long instanceId)
    {
        try
        {
            selectedInstance = await WorkflowEngine.GetInstanceAsync(instanceId);
            selectedActionCode = selectedInstance.AvailableActions.FirstOrDefault()?.Code;
            actionComment = null;
        }
        catch (Exception ex)
        {
            statusMessage = $"تعذر فتح المعاملة: {ex.Message}";
            isError = true;
        }
    }

    private async Task ExecuteActionAsync()
    {
        if (selectedInstance == null || string.IsNullOrWhiteSpace(selectedActionCode)) return;

        isExecutingAction = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "systemadmin";

            var command = new ExecuteWorkflowActionCommand(
                WorkflowInstanceId: selectedInstance.Id,
                ActionCode: selectedActionCode,
                UserId: username,
                Comment: actionComment,
                RowVersion: selectedInstance.RowVersion,
                IdempotencyKey: Guid.NewGuid().ToString("N"),
                User: authState.User);

            var result = await WorkflowEngine.ExecuteActionAsync(command);

            statusMessage = $"تم تنفيذ الإجراء ({selectedActionCode}) بنجاح. الانتقال من ({result.FromStepCode}) إلى ({result.ToStepCode}). حالة المعاملة: {result.Status}.";
            isError = false;

            selectedInstance = null;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to execute workflow action");
            statusMessage = $"فشل تنفيذ الإجراء: {ex.Message}";
            isError = true;
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task ViewTimelineAsync(long instanceId)
    {
        try
        {
            selectedTimelineInstanceId = instanceId;
            selectedTimelineItems = await TimelineService.GetTimelineAsync(instanceId);
        }
        catch (Exception ex)
        {
            statusMessage = $"تعذر تحميل الخط الزمني: {ex.Message}";
            isError = true;
        }
    }

    // No-Code Creator State
    private bool isCreateModalOpen = false;
    private bool isSavingWorkflow = false;
    private string newDefCode = "LEAVE_REQUEST";
    private string newDefName = "مسار طلبات الإجازات";
    private string newDefDescription = "مسار عام لمعالجة ومصادقة إجازات الموظفين";

    private class DraftStepItem
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public WorkflowStepType StepType { get; set; } = WorkflowStepType.HumanTask;
    }

    private List<DraftStepItem> draftSteps = new();

    private void OpenCreateWorkflowModal()
    {
        newDefCode = $"WF_{DateTime.UtcNow:yyyyMMddHHmm}";
        newDefName = "مسار عمل جديد";
        newDefDescription = "وصف المسار التوضيحي";
        draftSteps = new List<DraftStepItem>
        {
            new DraftStepItem { Code = "SUBMITTED", Name = "تقديم الطلب", StepType = WorkflowStepType.Start },
            new DraftStepItem { Code = "MANAGER_APPROVAL", Name = "موافقة المدير المباشر", StepType = WorkflowStepType.Approval },
            new DraftStepItem { Code = "COMPLETED", Name = "مكتمل ومعتمد", StepType = WorkflowStepType.End }
        };
        isCreateModalOpen = true;
    }

    private void AddDraftStep()
    {
        draftSteps.Add(new DraftStepItem
        {
            Code = $"STEP_{draftSteps.Count + 1}",
            Name = $"المرحلة {draftSteps.Count + 1}",
            StepType = WorkflowStepType.HumanTask
        });
    }

    private async Task SaveAndPublishNewWorkflowAsync()
    {
        if (string.IsNullOrWhiteSpace(newDefCode) || string.IsNullOrWhiteSpace(newDefName) || draftSteps.Count < 2)
        {
            statusMessage = "يرجى تعبئة رمز واسم المسار وإضافة مرحلتين على الأقل.";
            isError = true;
            return;
        }

        isSavingWorkflow = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "systemadmin";

            var def = new WorkflowDefinition
            {
                Code = newDefCode.Trim().ToUpperInvariant(),
                Name = newDefName.Trim(),
                Description = newDefDescription,
                IsEnabled = true,
                CreatedAt = DateTimeOffset.UtcNow,
                CreatedBy = username
            };

            var ver = new WorkflowVersion
            {
                WorkflowDefinition = def,
                VersionNumber = 1,
                Status = WorkflowVersionStatus.Published,
                ChangeDescription = "النسخة الأولى المنشورة من شاشة إدارة المسارات بدون كود",
                CreatedAt = DateTimeOffset.UtcNow,
                CreatedBy = username,
                PublishedAt = DateTimeOffset.UtcNow,
                PublishedBy = username
            };

            var createdSteps = new List<WorkflowStep>();
            for (int i = 0; i < draftSteps.Count; i++)
            {
                var item = draftSteps[i];
                var s = new WorkflowStep
                {
                    WorkflowVersion = ver,
                    Code = item.Code.Trim().ToUpperInvariant(),
                    Name = item.Name.Trim(),
                    StepType = item.StepType,
                    IsStart = i == 0,
                    IsFinal = i == draftSteps.Count - 1,
                    SortOrder = i + 1,
                    ConfigurationJson = "{\"assignmentType\":\"INITIATOR\"}"
                };
                ver.Steps.Add(s);
                createdSteps.Add(s);
            }

            // Create automatic sequential APPROVE transitions
            for (int i = 0; i < createdSteps.Count - 1; i++)
            {
                ver.Transitions.Add(new WorkflowTransition
                {
                    WorkflowVersion = ver,
                    FromStep = createdSteps[i],
                    ToStep = createdSteps[i + 1],
                    ActionCode = i == 0 ? "SUBMIT" : "APPROVE",
                    Priority = 1
                });
            }

            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            dbContext.WorkflowDefinitions.Add(def);
            await dbContext.SaveChangesAsync();

            statusMessage = $"تم حفظ ونشر المسار الجديد ({def.Name}) بنجاح في قاعدة البيانات وتفعيله فوراً لجميع الأجهزة والـ API!";
            isError = false;
            isCreateModalOpen = false;

            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save workflow definition");
            statusMessage = $"فشل حفظ المسار: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSavingWorkflow = false;
        }
    }

    // Form Schema Editor Modal State
    private WorkflowDefinition? editingFormSchemaDef;
    private string editingFormSchemaJson = "";

    // Live Simulator State
    private int simStep = 1;
    private string simWorkflowCode = "WORK_CONTINUATION_REQUEST";
    private string simEntityId = $"SIM-{Random.Shared.Next(1000, 9999)}";
    private Dictionary<string, string> simFormValues = new();
    private List<FormFieldSchema> simFormFields = new();

    private long? simActiveInstanceId;
    private string? simCurrentStepCode;
    private string? simCurrentStepName;
    private string? simRowVersion;
    private List<string> simAvailableActions = new();
    private string? simActionComment;

    private string simHttpRequestJson = "// اضغط على أزرار المحاكي لعرض الـ HTTP Payload";
    private string simHttpResponseJson = "// شاشة استجابة الـ HTTP Response المباشرة";

    public class FormFieldSchema
    {
        public string Name { get; set; } = "";
        public string Label { get; set; } = "";
        public string Type { get; set; } = "text";
        public bool Required { get; set; } = false;
        public string? Placeholder { get; set; }
        public List<string>? Options { get; set; }
    }

    private void OpenFormSchemaEditor(WorkflowDefinition def)
    {
        editingFormSchemaDef = def;
        editingFormSchemaJson = def.FormSchemaJson ?? "[\n  {\n    \"name\": \"purpose\",\n    \"label\": \"سبب تقديم الطلب\",\n    \"type\": \"text\",\n    \"required\": true\n  }\n]";
    }

    private async Task SaveFormSchemaAsync()
    {
        if (editingFormSchemaDef == null) return;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var def = await dbContext.WorkflowDefinitions.FindAsync(editingFormSchemaDef.Id);
            if (def != null)
            {
                def.FormSchemaJson = editingFormSchemaJson;
                await dbContext.SaveChangesAsync();
                statusMessage = $"تم تحديث حقول استمارة الأدمن للمسار ({def.Name}) بنجاح!";
                isError = false;
                editingFormSchemaDef = null;
                await LoadAllDataAsync();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"فشل حفظ الاستمارة: {ex.Message}";
            isError = true;
        }
    }

    private void OnSimWorkflowChanged()
    {
        LoadSimFormFields();
    }

    private void LoadSimFormFields()
    {
        simFormFields.Clear();
        simFormValues.Clear();
        var def = workflowDefinitions.FirstOrDefault(d => d.Code == simWorkflowCode);
        if (def != null && !string.IsNullOrWhiteSpace(def.FormSchemaJson))
        {
            try
            {
                var fields = JsonSerializer.Deserialize<List<FormFieldSchema>>(def.FormSchemaJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (fields != null)
                {
                    simFormFields = fields;
                    foreach (var f in fields)
                    {
                        simFormValues[f.Name] = f.Options?.FirstOrDefault() ?? "";
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to parse FormSchemaJson for simulation");
            }
        }
    }

    private async Task SimulateStartWorkflowAsync()
    {
        simStep = 1;
        var reqPayload = new
        {
            workflowCode = simWorkflowCode,
            entityType = "SimulatedRequest",
            entityId = simEntityId,
            initialContext = simFormValues
        };
        simHttpRequestJson = JsonSerializer.Serialize(reqPayload, new JsonSerializerOptions { WriteIndented = true });

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "systemadmin";

            var initialContextDict = simFormValues.ToDictionary(k => k.Key, v => (object)v.Value);

            var command = new StartWorkflowCommand(
                WorkflowCode: simWorkflowCode,
                EntityType: "SimulatedRequest",
                EntityId: simEntityId,
                InitiatorUserId: username,
                InitialContext: initialContextDict);

            var result = await WorkflowEngine.StartAsync(command);

            simHttpResponseJson = JsonSerializer.Serialize(result, new JsonSerializerOptions { WriteIndented = true });
            simActiveInstanceId = result.WorkflowInstanceId;
            simCurrentStepCode = result.CurrentStepCode;
            simCurrentStepName = result.CurrentStepName;
            simStep = 2;

            await RefreshSimActionsAsync();
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            simHttpResponseJson = JsonSerializer.Serialize(new { error = ex.Message }, new JsonSerializerOptions { WriteIndented = true });
        }
    }

    private async Task RefreshSimActionsAsync()
    {
        if (simActiveInstanceId == null) return;
        try
        {
            var instanceDto = await WorkflowEngine.GetInstanceAsync(simActiveInstanceId.Value);
            simCurrentStepCode = instanceDto.CurrentStepCode;
            simCurrentStepName = instanceDto.CurrentStepName;
            simRowVersion = Convert.ToBase64String(instanceDto.RowVersion);
            simAvailableActions = instanceDto.AvailableActions.Select(a => a.Code).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh sim actions");
        }
    }

    private async Task SimulateExecuteActionAsync(string actionCode)
    {
        if (simActiveInstanceId == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name ?? "systemadmin";

        var actionPayload = new
        {
            actionCode = actionCode,
            comment = simActionComment,
            rowVersion = simRowVersion,
            idempotencyKey = Guid.NewGuid().ToString("N")
        };
        simHttpRequestJson = JsonSerializer.Serialize(actionPayload, new JsonSerializerOptions { WriteIndented = true });

        try
        {
            var command = new ExecuteWorkflowActionCommand(
                WorkflowInstanceId: simActiveInstanceId.Value,
                ActionCode: actionCode,
                UserId: username,
                Comment: simActionComment,
                RowVersion: Convert.FromBase64String(simRowVersion ?? ""),
                IdempotencyKey: Guid.NewGuid().ToString("N"),
                User: authState.User);

            var result = await WorkflowEngine.ExecuteActionAsync(command);
            simHttpResponseJson = JsonSerializer.Serialize(result, new JsonSerializerOptions { WriteIndented = true });

            if (result.Status == WorkflowInstanceStatus.Completed || result.Status == WorkflowInstanceStatus.Rejected)
            {
                simStep = 4;
            }
            else
            {
                simStep = 3;
            }

            await RefreshSimActionsAsync();
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            simHttpResponseJson = JsonSerializer.Serialize(new { error = ex.Message }, new JsonSerializerOptions { WriteIndented = true });
        }
    }
}
