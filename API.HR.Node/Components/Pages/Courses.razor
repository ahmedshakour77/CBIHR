    private void CloseFormModal()
    {
        isFormModalOpen = false;
    }

    private async Task LookupEmployeeByNumber()
    {
        employeeLookupFailed = false;
        formEmployeeName = string.Empty;
        formEmployeeFormation = string.Empty;
        formEmployeeId = null;

        if (string.IsNullOrWhiteSpace(formEmployeeNumber)) return;

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        var emp = await db.Employees
            .Include(e => e.Formation)
            .FirstOrDefaultAsync(e => e.EmployeeID == formEmployeeNumber.Trim());

        if (emp != null)
        {
            formEmployeeId = emp.Id;
            formEmployeeName = emp.Name;
            formEmployeeFormation = emp.Formation?.Name ?? string.Empty;
        }
        else
        {
            employeeLookupFailed = true;
        }
    }

    private async Task SaveCourseAsync()
    {
        if (string.IsNullOrWhiteSpace(formCourseName))
        {
            Toast.Warning("يرجى إدخال اسم الدورة التدريبية.");
            return;
        }

        if (!editingCourseId.HasValue && !formEmployeeId.HasValue)
        {
            await LookupEmployeeByNumber();
            if (!formEmployeeId.HasValue)
            {
                Toast.Warning("يرجى التحقق من الرقم الوظيفي للموظف.");
                return;
            }
        }

        if (formStartDate.HasValue && formEndDate.HasValue && formEndDate.Value < formStartDate.Value)
        {
            Toast.Warning("تاريخ نهاية الدورة لا يمكن أن يكون قبل تاريخ بدئها.");
            return;
        }

        isSubmitting = true;
        try
        {
            using var saveScope = ScopeFactory.CreateScope();
            var db = saveScope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            int? days = formDaysCount;
            if ((!days.HasValue || days.Value <= 0) && formStartDate.HasValue && formEndDate.HasValue)
            {
                days = (formEndDate.Value.DayNumber - formStartDate.Value.DayNumber) + 1;
            }

            if (editingCourseId.HasValue)
            {
                var existing = await db.EmployeeCourses.FirstOrDefaultAsync(c => c.Id == editingCourseId.Value);
                if (existing is null)
                {
                    Toast.Danger("سجل الدورة غير موجود.");
                    return;
                }

                existing.CourseName = formCourseName.Trim();
                existing.StartDate = formStartDate;
                existing.EndDate = formEndDate;
                existing.DaysCount = days;
                existing.Status = formStatus;
                existing.Notes = formNotes?.Trim();

                await db.SaveChangesAsync();
                Toast.Success("تم تحديث بيانات الدورة التدريبية بنجاح.");
            }
            else
            {
                var course = new EmployeeCourse
                {
                    EmployeeId = formEmployeeId!.Value,
                    CourseName = formCourseName.Trim(),
                    StartDate = formStartDate,
                    EndDate = formEndDate,
                    DaysCount = days,
                    Status = formStatus,
                    Notes = formNotes?.Trim(),
                    CreatedAtUtc = DateTimeOffset.UtcNow
                };

                db.EmployeeCourses.Add(course);
                await db.SaveChangesAsync();
                Toast.Success("تم تسجيل الدورة التدريبية بنجاح.");
            }

            isFormModalOpen = false;
            await LoadLookupsAsync();
            await LoadCoursesAsync();
        }
        catch (Exception ex)
        {
            Toast.Danger($"حدث خطأ أثناء حفظ الدورة: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void PromptDelete(EmployeeCourse course)
    {
        courseToDelete = course;
        isDeleteDialogOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (courseToDelete is null) return;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var item = await db.EmployeeCourses.FirstOrDefaultAsync(c => c.Id == courseToDelete.Id);
            if (item != null)
            {
                db.EmployeeCourses.Remove(item);
                await db.SaveChangesAsync();
                Toast.Success("تم حذف سجل الدورة التدريبية بنجاح.");
            }

            isDeleteDialogOpen = false;
            await LoadLookupsAsync();
            await LoadCoursesAsync();
        }
        catch (Exception ex)
        {
            Toast.Danger($"تعذر حذف سجل الدورة: {ex.Message}");
        }
    }

