    private void OpenCreateCourseModal()
    {
        editingCourseId = null;
        formEmployeeNumber = string.Empty;
        formEmployeeName = string.Empty;
        formEmployeeFormation = string.Empty;
        formEmployeeId = null;
        employeeLookupFailed = false;

        formCourseName = string.Empty;
        formStartDate = null;
        formEndDate = null;
        formDaysCount = null;
        formStatus = "معتمدة";
        formNotes = null;

        isFormModalOpen = true;
    }

    private void OpenEditCourseModal(EmployeeCourse course)
    {
        editingCourseId = course.Id;
        formEmployeeNumber = course.Employee.EmployeeID;
        formEmployeeName = course.Employee.Name;
        formEmployeeFormation = course.Employee.Formation?.Name ?? string.Empty;
        formEmployeeId = course.EmployeeId;
        employeeLookupFailed = false;

        formCourseName = course.CourseName;
        formStartDate = course.StartDate;
        formEndDate = course.EndDate;
        formDaysCount = course.DaysCount;
        formStatus = course.Status ?? "معتمدة";
        formNotes = course.Notes;

        isFormModalOpen = true;
