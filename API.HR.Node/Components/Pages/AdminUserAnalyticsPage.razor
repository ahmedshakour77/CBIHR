@page "/admin/user-analytics"
@using System.Globalization
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using API.HR.Node.Data
@using API.HR.Node.Services.Audit
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable

@inject IUserActivityService ActivityService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>نشاط المستخدمين</PageTitle>

@*
    User activity.

    Activity is read as sessions: a run of one user's events with no gap
    longer than 30 minutes, opened by a login and closed by a logout. A
    session is drawn as a ribbon, split into the pages visited and sized by
    the time spent on each; the Day lanes and the User tab both use it, and
    clicking one opens its steps.

    Time on a page is measured from timestamps (from entering a page to the
    next page or the end of the session). The PAGE_VIEW event's own
    DurationSeconds belongs to the page that was left, not the one entered.

    Pages take the --series-* colours; categories never do, so one colour
    means one thing on every tab. Categories carry an icon and a word.
*@

<div class="hr-stack hr-ua">

    <header class="hr-pagehead">
        <div class="hr-pagehead-titles">
            <h1 class="hr-h1">نشاط المستخدمين</h1>
            <p class="hr-sub hr-measure">
                من يستخدم النظام، ومتى، وفي أي صفحات.
                آخر تحديث <span class="hr-num">@_lastRefreshedLocal.ToString("HH:mm:ss")</span>
            </p>
        </div>

        <div class="hr-pagehead-actions">
            <div class="hr-segment" role="group" aria-label="الفترة">
                @foreach (var range in TimeRanges)
                {
                    <button type="button" class="hr-segment-btn"
                            aria-pressed="@(_selectedRange == range.Key ? "true" : "false")"
                            @onclick="() => ChangeRangeAsync(range.Key)">
                        @range.Label
                    </button>
                }
            </div>

            <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm"
                    aria-pressed="@(_autoRefresh ? "true" : "false")"
                    title="@(_autoRefresh ? "إيقاف التحديث التلقائي" : "تحديث تلقائي كل 4 ثوانٍ")"
                    @onclick="ToggleAutoRefresh">
                <span class="hr-dot @(_autoRefresh ? "hr-dot-ok" : "hr-dot-quiet")" aria-hidden="true"></span>
                <span>@(_autoRefresh ? "بث حي" : "البث متوقف")</span>
            </button>

            <button type="button" class="hr-btn hr-btn-secondary hr-btn-icon hr-btn-sm"
                    aria-label="تحديث الآن" title="تحديث الآن"
                    disabled="@_isRefreshing" @onclick="RefreshNowAsync">
                <Icon Name="arrow-path" Size="sm" />
            </button>

            <button type="button" class="hr-btn hr-btn-primary hr-btn-sm"
                    title="تصدير حركات السجل بحسب الفلاتر الحالية"
                    disabled="@(_allRangeEvents.Count == 0)" @onclick="ExportCsvAsync">
                <Icon Name="arrow-down-tray" Size="sm" />
                <span>تصدير CSV</span>
            </button>
        </div>
    </header>

    @if (_dbMergeFailed)
    {
        <div class="hr-alert hr-alert-warn" role="status">
            <Icon Name="exclamation-triangle" Size="sm" />
            <div>
                <p class="hr-alert-title">سجل التدقيق غير مدمج</p>
                <p style="margin-block-start:.25rem">تعذّرت قراءة سجل التدقيق من قاعدة البيانات، فالعرض يقتصر على الحركات المسجلة منذ تشغيل الخادم. سيُعاد المحاولة مع التحديث التالي.</p>
            </div>
        </div>
    }

    <div class="hr-tabs hr-ua-tabs" role="tablist" aria-label="طرق العرض">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" class="hr-tab" id="ua-tab-@tab.Key"
                    aria-selected="@(_activeTab == tab.Key ? "true" : "false")"
                    aria-controls="ua-panel"
                    tabindex="@(_activeTab == tab.Key ? 0 : -1)"
                    @onclick="() => _activeTab = tab.Key"
                    @onkeydown="OnTabKeyAsync">
                <Icon Name="@tab.Icon" Size="sm" />
                <span>@tab.Label</span>
                @if (tab.Key == "live" && _onlineUsers.Count > 0)
                {
                    <span class="hr-tab-badge hr-num">@_onlineUsers.Count</span>
                }
            </button>
        }
    </div>

    <div id="ua-panel" role="tabpanel" aria-labelledby="ua-tab-@_activeTab">
        @if (!_loaded)
        {
            <div class="hr-ua-figs" aria-hidden="true">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="hr-skeleton" style="height:7.5rem"></div>
                }
            </div>
        }
        else if (_allRangeEvents.Count == 0)
        {
            <section class="hr-card">
                <div class="hr-empty">
                    <span class="hr-empty-art" aria-hidden="true"><Icon Name="presentation-chart-bar" Size="lg" /></span>
                    <p class="hr-h3">لا نشاط في هذه الفترة</p>
                    <p class="hr-sub hr-measure-sm">لم تُسجَّل أي حركة لأي مستخدم ضمن «@RangeLabel». جرّب فترة أطول.</p>
                    @if (_selectedRange != "all")
                    {
                        <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick='() => ChangeRangeAsync("all")'>
                            <span>عرض كل السجلات</span>
                        </button>
                    }
                </div>
            </section>
        }
        else if (_activeTab == "overview")
        {
            @Overview
        }
        else if (_activeTab == "live")
        {
            @Live
        }
        else if (_activeTab == "day")
        {
            @Day
        }
        else
        {
            @UserTab
        }
    </div>
</div>

@code {
    // ───────────────────────── Overview ─────────────────────────

    private RenderFragment Overview => @<div class="hr-stack-sm">
        <section class="hr-card hr-ua-figs" aria-label="أرقام الفترة">
            @foreach (var fig in _figures)
            {
                <div class="hr-ua-fig @(fig.Tone is null ? null : $"is-{fig.Tone}")">
                    <p class="hr-ua-fig-label">@fig.Label</p>
                    <p class="hr-ua-fig-value hr-num">@fig.Value</p>
                    <p class="hr-ua-fig-sub">@fig.Sub</p>
                    @if (_buckets.Count > 1)
                    {
                        var max = Math.Max(1, fig.History.Max());
                        <div class="hr-ua-hist" role="img" aria-label="@HistoryLabel(fig)" title="@(fig.HistoryOf ?? fig.Label) بحسب @(_bucketIsHour ? "الساعة" : "اليوم")">
                            @for (var i = 0; i < fig.History.Length; i++)
                            {
                                <span class="hr-ua-hist-bar @(i == fig.History.Length - 1 ? "is-last" : null)"
                                      style="--v:@Css((double)fig.History[i] / max)"
                                      title="@_buckets[i]: @fig.History[i].ToString("N0")"></span>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <div class="hr-ua-split">
            <section class="hr-card">
                <div class="hr-card-head">
                    <div>
                        <h2 class="hr-h2">إيقاع الاستخدام</h2>
                        <p class="hr-sub">عدد الحركات بحسب يوم الأسبوع والساعة.</p>
                    </div>
                </div>
                <div class="hr-card-body hr-viz-heat">
                    <div class="hr-tablewrap">
                        <table class="hr-viz-heat-table hr-ua-heat">
                            <caption class="hr-sr">توزيع الحركات على أيام الأسبوع وساعات اليوم</caption>
                            <thead>
                                <tr>
                                    <th scope="col">اليوم</th>
                                    @for (var h = _heatFromHour; h <= _heatToHour; h++)
                                    {
                                        <th scope="col" class="hr-num">@h.ToString("00")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in WeekOrder)
                                {
                                    <tr @key="day">
                                        <th scope="row">@ArabicCulture.DateTimeFormat.GetDayName(day)</th>
                                        @for (var h = _heatFromHour; h <= _heatToHour; h++)
                                        {
                                            var n = _heat[(int)day, h];
                                            <td>
                                                <span class="hr-viz-heat-cell is-d@(Depth(n, _heatMax))"
                                                      title="@($"{ArabicCulture.DateTimeFormat.GetDayName(day)} {h:00}:00 — {n:N0} حركة")">
                                                    @if (n > 0)
                                                    {
                                                        <span class="hr-num">@Compact(n)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="hr-sr">لا شيء</span>
                                                    }
                                                </span>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="hr-card">
                <div class="hr-card-head">
                    <div>
                        <h2 class="hr-h2">الصفحات الأكثر استخداماً</h2>
                        <p class="hr-sub">بحسب الوقت المقضي فيها.</p>
                    </div>
                </div>
                <div class="hr-card-body">
                    @PageBars(_pageStats.Take(8).ToList())
                </div>
            </section>
        </div>

        <div class="hr-ua-split is-even">
            <section class="hr-card">
                <div class="hr-card-head">
                    <div>
                        <h2 class="hr-h2">أكثر الاختيارات في القوائم</h2>
                        <p class="hr-sub">القيم التي اختارها المستخدمون في القوائم المنسدلة والفلاتر.</p>
                    </div>
                </div>
                <div class="hr-card-body">@ValueBars(_topDropdowns, "لم يُغيَّر أي فلتر أو قائمة في هذه الفترة.")</div>
            </section>
            <section class="hr-card">
                <div class="hr-card-head">
                    <div>
                        <h2 class="hr-h2">أكثر عبارات البحث</h2>
                        <p class="hr-sub">ما كتبه المستخدمون في حقول البحث والإدخال.</p>
                    </div>
                </div>
                <div class="hr-card-body">@ValueBars(_topSearches, "لم يُبحث عن شيء في هذه الفترة.")</div>
            </section>
        </div>

        <section class="hr-card">
            <div class="hr-card-head">
                <div>
                    <h2 class="hr-h2">المستخدمون</h2>
                    <p class="hr-sub"><span class="hr-num">@_users.Count</span> مستخدماً نشطاً خلال «@RangeLabel». افتح أي مستخدم لقراءة جلساته.</p>
                </div>
            </div>
            <div class="hr-tablewrap">
                <table class="hr-table hr-table-tight hr-table-wide">
                    <caption class="hr-sr">ملخص نشاط كل مستخدم</caption>
                    <thead>
                        <tr>
                            <th scope="col">المستخدم</th>
                            <th scope="col">آخر نشاط</th>
                            <th scope="col">الجلسات</th>
                            <th scope="col">وقت الاستخدام</th>
                            <th scope="col">صفحات</th>
                            <th scope="col">بحث</th>
                            <th scope="col">قوائم</th>
                            <th scope="col">نقرات</th>
                            <th scope="col">أمنية</th>
                            <th scope="col"><span class="hr-sr">إجراءات</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _users)
                        {
                            <tr @key="u.Key">
                                <td>@UserCell(u)</td>
                                <td>
                                    <span class="hr-cell-strong">@(u.Online ? "متصل الآن" : RelativeTime(u.LastSeen))</span>
                                    <span class="hr-cell-sub hr-truncate">@(u.LastPageTitle ?? "—")</span>
                                </td>
                                <td class="hr-num">@u.Sessions.ToString("N0")</td>
                                <td class="hr-num">@Short(u.ActiveSeconds)</td>
                                <td class="hr-num">@u.Pages.ToString("N0")</td>
                                <td class="hr-num">@u.Searches.ToString("N0")</td>
                                <td class="hr-num">@u.Dropdowns.ToString("N0")</td>
                                <td class="hr-num">@u.Clicks.ToString("N0")</td>
                                <td>
                                    @if (u.SecurityFailed > 0)
                                    {
                                        <span class="hr-badge hr-badge--plain hr-badge-danger"><Icon Name="exclamation-circle" Size="xs" /><span class="hr-num">@u.Security</span> · <span class="hr-num">@u.SecurityFailed</span> فاشلة</span>
                                    }
                                    else
                                    {
                                        <span class="hr-num">@u.Security.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    <div class="hr-rowactions">
                                        <button type="button" class="hr-btn hr-btn-quiet hr-btn-sm" @onclick="() => OpenUser(u.Key)">
                                            <span>الجلسات</span>
                                            <Icon Name="chevron-left" Size="xs" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>;

    // ───────────────────────── Live ─────────────────────────

    private RenderFragment Live => @<div class="hr-stack-sm">
        <section class="hr-card">
            <div class="hr-card-head">
                <div>
                    <h2 class="hr-h2">في النظام الآن</h2>
                    <p class="hr-sub">من كان له نشاط خلال آخر 5 دقائق ولم يسجّل الخروج، والصفحة التي هو فيها.</p>
                </div>
            </div>
            @if (_onlineUsers.Count == 0)
            {
                <div class="hr-empty">
                    <span class="hr-empty-art" aria-hidden="true"><Icon Name="signal" Size="lg" /></span>
                    <p class="hr-h3">لا أحد متصل الآن</p>
                    <p class="hr-sub hr-measure-sm">
                        @if (_users.Count > 0)
                        {
                            <span>آخر نشاط كان لـ @_users[0].DisplayName @RelativeTime(_users[0].LastSeen).</span>
                        }
                    </p>
                </div>
            }
            else
            {
                <ul class="hr-ua-presence" role="list">
                    @foreach (var u in _onlineUsers)
                    {
                        <li @key="u.Key">
                            <button type="button" class="hr-ua-presence-item" @onclick="() => OpenUser(u.Key)">
                                <span class="hr-avatar hr-ua-avatar is-online" aria-hidden="true">@Initial(u.DisplayName)</span>
                                <span class="hr-ua-presence-text">
                                    <span class="hr-cell-strong">@u.DisplayName</span>
                                    <span class="hr-ua-presence-page">
                                        <span class="hr-truncate">@(u.CurrentPageTitle ?? "—")</span>
                                        @if (u.CurrentPageSince is { } since)
                                        {
                                            <span class="hr-num hr-ua-presence-since" title="الوقت في هذه الصفحة">@Clock(DateTimeOffset.UtcNow - since)</span>
                                        }
                                    </span>
                                    <span class="hr-cell-sub">@RoleLine(u) · دخل @u.SessionStart?.ToLocalTime().ToString("HH:mm")</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="hr-card">
            <div class="hr-toolbar">
                <div class="hr-toolbar-search">
                    <label class="hr-field-label" for="ua-stream-search">بحث في الحركات</label>
                    <div class="hr-search">
                        <span class="hr-search-icon" aria-hidden="true"><Icon Name="magnifying-glass" Size="sm" /></span>
                        <input id="ua-stream-search" type="search" class="hr-input"
                               placeholder="اسم، صفحة، حقل أو قيمة"
                               @bind="_streamSearchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="hr-toolbar-field">
                    <label class="hr-field-label" for="ua-stream-user">المستخدم</label>
                    <select id="ua-stream-user" class="hr-select" @bind="_streamUserFilter">
                        <option value="">كل المستخدمين (@_users.Count)</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u.Key">@u.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="hr-ua-toolbar-chips">
                    <span class="hr-field-label" id="ua-stream-cat">النوع</span>
                    @CategoryChips(_streamCategoryFilter, key => _streamCategoryFilter = key, "ua-stream-cat")
                </div>
            </div>

            @{
                var stream = GetFilteredStreamEvents();
            }
            @if (stream.Count == 0)
            {
                <div class="hr-empty">
                    <span class="hr-empty-art" aria-hidden="true"><Icon Name="funnel" Size="lg" /></span>
                    <p class="hr-h3">لا حركات مطابقة</p>
                    <p class="hr-sub hr-measure-sm">لا توجد حركة تطابق البحث والفلاتر الحالية.</p>
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="ClearStreamFilters">
                        <Icon Name="x-mark" Size="xs" />
                        <span>مسح عوامل التصفية</span>
                    </button>
                </div>
            }
            else
            {
                <div class="hr-tablewrap hr-ua-streamwrap">
                    <table class="hr-table hr-table-tight hr-table-wide">
                        <caption class="hr-sr">سجل حركات المستخدمين، الأحدث أولاً</caption>
                        <thead>
                            <tr>
                                <th scope="col">الوقت</th>
                                <th scope="col">المستخدم</th>
                                <th scope="col">النوع</th>
                                <th scope="col">الحركة</th>
                                <th scope="col">الصفحة</th>
                                <th scope="col">الحقل / العنصر</th>
                                <th scope="col">القيمة / المدة</th>
                                <th scope="col">IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in stream.Take(StreamCap))
                            {
                                <tr @key="ev.Id">
                                    <td class="hr-num" style="white-space:nowrap">
                                        <span class="hr-cell-strong">@ev.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span class="hr-cell-sub">@ev.TimestampUtc.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                    </td>
                                    <td>
                                        <button type="button" class="hr-link hr-ua-linkbtn" @onclick="() => OpenUser(KeyOf(ev))">@DisplayNameOf(ev)</button>
                                        <span class="hr-cell-sub">@ev.UserName@(string.IsNullOrWhiteSpace(ev.UserRole) ? "" : $" · {ev.UserRole}")</span>
                                    </td>
                                    <td>@CategoryTag(ev)</td>
                                    <td><span class="hr-cell-strong">@ev.ActionTitle</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(ev.PagePath))
                                        {
                                            <span class="hr-cell-strong">@(ev.PageTitle ?? UserActivityService.GetArabicPageTitle(ev.PagePath))</span>
                                            <span class="hr-cell-sub hr-num" dir="ltr">@ev.PagePath</span>
                                        }
                                        else
                                        {
                                            <span class="hr-meta">—</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(ev.ElementLabel) ? "—" : ev.ElementLabel)</td>
                                    <td>@ValueCell(ev)</td>
                                    <td class="hr-num" dir="ltr" style="text-align:end">@(string.IsNullOrWhiteSpace(ev.IpAddress) ? "—" : ev.IpAddress)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="hr-card-foot">
                    <p class="hr-meta">
                        عرض <span class="hr-num">@Math.Min(stream.Count, StreamCap).ToString("N0")</span>
                        من <span class="hr-num">@stream.Count.ToString("N0")</span> حركة مطابقة.
                        @if (stream.Count > StreamCap)
                        {
                            <span>يقتصر الجدول على أحدث <span class="hr-num">@StreamCap</span>؛ ملف CSV يضم كل الحركات المطابقة.</span>
                        }
                    </p>
                </div>
            }
        </section>
    </div>;

    // ───────────────────────── Day ─────────────────────────

    private RenderFragment Day => @<div class="hr-stack-sm">
        @{
            var day = _selectedDay ?? _days.FirstOrDefault();
            var dayIndex = _days.IndexOf(day);
            var lanes = DayLanes(day);
            var (fromH, toH) = DayHours(lanes);
            var dayStart = new DateTimeOffset(day.ToDateTime(new TimeOnly(fromH, 0)), LocalOffset(day));
            var spanSecs = (toH - fromH) * 3600.0;
            var isToday = day == DateOnly.FromDateTime(DateTime.Now);
            var nowPos = (DateTimeOffset.Now - dayStart).TotalSeconds / spanSecs;
            var groups = lanes.SelectMany(l => l.Sessions).SelectMany(s => s.Segments).Select(s => s.Group).Distinct().ToList();
        }
        <section class="hr-card">
            <div class="hr-card-head hr-ua-dayhead">
                <div>
                    <h2 class="hr-h2">@day.ToString("dddd d MMMM yyyy", ArabicCulture)</h2>
                    <p class="hr-sub">
                        <span class="hr-num">@lanes.Count</span> مستخدماً ·
                        <span class="hr-num">@lanes.Sum(l => l.Sessions.Count)</span> جلسة.
                        كل شريط جلسة واحدة من الدخول إلى الخروج، مقسّمة على الصفحات بحسب الوقت المقضي في كل منها.
                    </p>
                </div>
                <div class="hr-ua-daynav">
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-icon hr-btn-sm" aria-label="اليوم السابق"
                            disabled="@(dayIndex < 0 || dayIndex >= _days.Count - 1)" @onclick="() => SelectDay(dayIndex + 1)">
                        <Icon Name="chevron-right" Size="sm" />
                    </button>
                    <label class="hr-sr" for="ua-day">اليوم</label>
                    <select id="ua-day" class="hr-select hr-select-compact" value="@day.ToString("yyyy-MM-dd")" @onchange="OnDayPicked">
                        @foreach (var d in _days)
                        {
                            <option value="@d.ToString("yyyy-MM-dd")">@d.ToString("dddd d MMMM", ArabicCulture)</option>
                        }
                    </select>
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-icon hr-btn-sm" aria-label="اليوم التالي"
                            disabled="@(dayIndex <= 0)" @onclick="() => SelectDay(dayIndex - 1)">
                        <Icon Name="chevron-left" Size="sm" />
                    </button>
                </div>
            </div>

            @if (lanes.Count == 0)
            {
                <div class="hr-empty">
                    <span class="hr-empty-art" aria-hidden="true"><Icon Name="calendar-days" Size="lg" /></span>
                    <p class="hr-h3">لا جلسات في هذا اليوم</p>
                </div>
            }
            else
            {
                <div class="hr-ua-lanes-wrap">
                    <div class="hr-ua-lanes" style="--hours:@(toH - fromH)">
                        <div class="hr-ua-axis" aria-hidden="true">
                            <span></span>
                            <span class="hr-ua-axis-ticks">
                                @for (var h = fromH; h < toH; h++)
                                {
                                    <span class="hr-num">@h.ToString("00")</span>
                                }
                            </span>
                        </div>
                        @foreach (var lane in lanes)
                        {
                            <div class="hr-ua-lane" @key="lane.User.Key">
                                <button type="button" class="hr-ua-lane-name" @onclick="() => OpenUser(lane.User.Key)" title="فتح جلسات @lane.User.DisplayName">
                                    <span class="hr-dot @(lane.User.Online ? "hr-dot-ok" : "hr-dot-quiet")" aria-hidden="true"></span>
                                    <span class="hr-truncate">@lane.User.DisplayName</span>
                                    @if (lane.User.Online)
                                    {
                                        <span class="hr-sr">(متصل الآن)</span>
                                    }
                                </button>
                                <div class="hr-ua-track">
                                    @foreach (var s in lane.Sessions)
                                    {
                                        var start = Math.Clamp((s.Start - dayStart).TotalSeconds / spanSecs, 0, 1);
                                        var end = Math.Clamp((s.End - dayStart).TotalSeconds / spanSecs, 0, 1);
                                        <button type="button" @key="s.Id"
                                                class="hr-ua-ribbon @(s.Id == _daySessionId ? "is-on" : null) @(s.Open ? "is-open" : null)"
                                                style="--from:@Css(start);--to:@Css(end)"
                                                aria-pressed="@(s.Id == _daySessionId ? "true" : "false")"
                                                aria-label="@SessionLabel(lane.User, s)"
                                                title="@SessionLabel(lane.User, s)"
                                                @onclick="() => _daySessionId = s.Id">
                                            @Ribbon(s)
                                        </button>
                                    }
                                    @if (isToday && nowPos is > 0 and < 1)
                                    {
                                        <span class="hr-ua-now" style="--at:@Css(nowPos)" aria-hidden="true"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="hr-card-foot">
                    @PageLegend(groups)
                </div>
            }
        </section>

        @{
            var picked = lanes.SelectMany(l => l.Sessions).FirstOrDefault(s => s.Id == _daySessionId);
        }
        @if (picked is not null && _userByKey.TryGetValue(picked.UserKey, out var pickedUser))
        {
            <section class="hr-card">
                <div class="hr-card-head">
                    <div>
                        <h2 class="hr-h2">جلسة @pickedUser.DisplayName</h2>
                        <p class="hr-sub">@SessionSummary(picked)</p>
                    </div>
                    <button type="button" class="hr-btn hr-btn-secondary hr-btn-sm" @onclick="() => OpenUser(pickedUser.Key, picked.Id)">
                        <span>كل جلسات المستخدم</span>
                        <Icon Name="chevron-left" Size="xs" />
                    </button>
                </div>
                <div class="hr-card-body">
                    @Steps(picked.Events.AsEnumerable().Reverse().ToList())
                </div>
            </section>
        }
        else if (lanes.Count > 0)
        {
            <p class="hr-meta hr-ua-hint">اختر شريط جلسة لقراءة خطواتها بالترتيب.</p>
        }
    </div>;

    // ───────────────────────── User ─────────────────────────

    private RenderFragment UserTab => @<div class="hr-stack-sm">
        @{
            var user = SelectedUser;
        }
        <section class="hr-card">
            <div class="hr-toolbar">
                <div class="hr-toolbar-field hr-ua-userpick">
                    <label class="hr-field-label" for="ua-user">المستخدم</label>
                    <select id="ua-user" class="hr-select" value="@user?.Key" @onchange="OnUserPicked">
                        @foreach (var u in _users)
                        {
                            <option value="@u.Key">@u.DisplayName@(u.Online ? " — متصل" : "")</option>
                        }
                    </select>
                </div>
            </div>

            @if (user is not null)
            {
                <div class="hr-card-body hr-ua-who">
                    <span class="hr-avatar hr-avatar-xl hr-ua-avatar @(user.Online ? "is-online" : null)" aria-hidden="true">@Initial(user.DisplayName)</span>
                    <div class="hr-ua-who-text">
                        <h2 class="hr-h1">
                            @user.DisplayName
                            @if (user.Online)
                            {
                                <span class="hr-badge hr-badge-ok"><span>متصل الآن</span></span>
                            }
                        </h2>
                        <p class="hr-sub">
                            <span class="hr-num" dir="ltr">@user.UserName</span>
                            @if (!string.IsNullOrWhiteSpace(user.Role)) { <span> · @user.Role</span> }
                            @if (!string.IsNullOrWhiteSpace(user.EmployeeId)) { <span> · رقم وظيفي <span class="hr-num">@user.EmployeeId</span></span> }
                            <span> · @(user.Online ? $"في {user.CurrentPageTitle ?? "—"}" : $"آخر نشاط {RelativeTime(user.LastSeen)}")</span>
                        </p>
                    </div>
                    <dl class="hr-ua-who-figs">
                        <div><dt>الجلسات</dt><dd class="hr-num">@user.Sessions.ToString("N0")</dd></div>
                        <div><dt>وقت الاستخدام</dt><dd class="hr-num">@Short(user.ActiveSeconds)</dd></div>
                        <div><dt>صفحات</dt><dd class="hr-num">@user.Pages.ToString("N0")</dd></div>
                        <div><dt>بحث وقوائم</dt><dd class="hr-num">@((user.Searches + user.Dropdowns).ToString("N0"))</dd></div>
                        <div><dt>نقرات</dt><dd class="hr-num">@user.Clicks.ToString("N0")</dd></div>
                        <div class="@(user.SecurityFailed > 0 ? "is-danger" : null)"><dt>أمنية@(user.SecurityFailed > 0 ? $" ({user.SecurityFailed} فاشلة)" : "")</dt><dd class="hr-num">@user.Security.ToString("N0")</dd></div>
                    </dl>
                </div>
            }
        </section>

        @if (user is not null)
        {
            var sessions = _sessionsByUser.GetValueOrDefault(user.Key) ?? new List<Session>();
            var session = sessions.FirstOrDefault(s => s.Id == _userSessionId) ?? sessions.FirstOrDefault();
            <div class="hr-ua-split is-reverse">
                <div class="hr-stack-sm">
                    <section class="hr-card">
                        <div class="hr-card-head">
                            <div>
                                <h2 class="hr-h2">الجلسات</h2>
                                <p class="hr-sub">الأحدث أولاً. كل شريط مقسّم على الصفحات بحسب الوقت.</p>
                            </div>
                        </div>
                        <ul class="hr-ua-sessions" role="list">
                            @foreach (var s in sessions.Take(40))
                            {
                                var on = s.Id == session?.Id;
                                <li @key="s.Id">
                                    <button type="button" class="hr-ua-session @(on ? "is-on" : null)"
                                            aria-pressed="@(on ? "true" : "false")" @onclick="() => _userSessionId = s.Id">
                                        <span class="hr-ua-session-top">
                                            <span class="hr-cell-strong">@DayName(s.Start)</span>
                                            <span><span class="hr-num">@s.Start.ToLocalTime().ToString("HH:mm")</span> إلى @(s.Open ? "الآن" : "")<span class="hr-num">@(s.Open ? "" : s.End.ToLocalTime().ToString("HH:mm"))</span></span>
                                        </span>
                                        <span class="hr-ua-ribbon is-static" aria-hidden="true">@Ribbon(s)</span>
                                        <span class="hr-cell-sub">@Short((int)(s.End - s.Start).TotalSeconds) · <span class="hr-num">@s.Segments.Select(x => x.Group).Distinct().Count()</span> صفحات · <span class="hr-num">@s.Events.Count</span> حركة@(s.LoggedOut ? " · سجّل الخروج" : "")</span>
                                    </button>
                                </li>
                            }
                        </ul>
                        @if (sessions.Count > 40)
                        {
                            <div class="hr-card-foot"><p class="hr-meta">تُعرض أحدث <span class="hr-num">40</span> جلسة من <span class="hr-num">@sessions.Count</span>.</p></div>
                        }
                    </section>

                    <section class="hr-card">
                        <div class="hr-card-head">
                            <div>
                                <h2 class="hr-h2">صفحاته الأكثر استخداماً</h2>
                                <p class="hr-sub">بحسب الوقت المقضي خلال «@RangeLabel».</p>
                            </div>
                        </div>
                        <div class="hr-card-body">@PageBars(PageStatsFor(sessions).Take(6).ToList())</div>
                    </section>
                </div>

                <section class="hr-card">
                    @if (session is null)
                    {
                        <div class="hr-empty"><p class="hr-h3">لا جلسات لهذا المستخدم</p></div>
                    }
                    else
                    {
                        var steps = session.Events
                            .Where(e => string.IsNullOrEmpty(_journeyCategoryFilter) || e.Category == _journeyCategoryFilter)
                            .Reverse().Take(300).ToList();
                        <div class="hr-card-head hr-ua-stepshead">
                            <div>
                                <h2 class="hr-h2">خطوات الجلسة</h2>
                                <p class="hr-sub">@SessionSummary(session)</p>
                            </div>
                            @CategoryChips(_journeyCategoryFilter, key => _journeyCategoryFilter = key, null)
                        </div>
                        <div class="hr-card-body">
                            @if (steps.Count == 0)
                            {
                                <p class="hr-viz-empty">لا خطوات من هذا النوع في الجلسة.</p>
                            }
                            else
                            {
                                @Steps(steps)
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </div>;

    // ───────────────────────── Shared fragments ─────────────────────────

    private RenderFragment Ribbon(Session s) => @<span class="hr-ua-ribbon-segs">
        @foreach (var seg in s.Segments)
        {
            <span class="hr-ua-seg is-@SeriesOf(seg.Group)" style="flex-grow:@Math.Max(1, seg.Seconds)" title="@seg.Title — @Short(seg.Seconds)"></span>
        }
        @if (s.Segments.Count == 0)
        {
            <span class="hr-ua-seg is-other" style="flex-grow:1"></span>
        }
    </span>;

    private RenderFragment PageLegend(IEnumerable<string> groups) => @<ul class="hr-ua-legend" role="list" aria-label="ألوان الصفحات">
        @foreach (var g in groups.OrderBy(g => _seriesByGroup.TryGetValue(g, out var i) ? i : 99).DistinctBy(SeriesOf))
        {
            <li><span class="hr-viz-swatch is-@SeriesOf(g)" aria-hidden="true"></span>@(SeriesOf(g) == "other" ? "صفحات أخرى" : _groupTitles.GetValueOrDefault(g, g))</li>
        }
    </ul>;

    private RenderFragment PageBars(IReadOnlyList<PageStat> rows) => @<div class="hr-viz-bars">
        @if (rows.Count == 0)
        {
            <p class="hr-viz-empty">لم تُفتح أي صفحة في هذه الفترة.</p>
        }
        else
        {
            var max = Math.Max(1, rows.Max(r => r.Seconds));
            <ol class="hr-viz-bars-list" aria-label="الصفحات بحسب الوقت المقضي">
                @foreach (var p in rows)
                {
                    <li @key="p.Group" class="hr-viz-bar">
                        <span class="hr-viz-bar-name" title="@p.Title"><span class="hr-viz-swatch is-@SeriesOf(p.Group)" aria-hidden="true"></span> @p.Title</span>
                        <span class="hr-viz-bar-value"><span class="hr-num">@Short(p.Seconds)</span><span class="hr-viz-bar-pct"><span class="hr-num">@p.Visits</span> زيارة · <span class="hr-num">@p.Users</span> مستخدم</span></span>
                        <span class="hr-viz-bar-track" aria-hidden="true"><span class="hr-viz-bar-fill" style="--v:@Css((double)p.Seconds / max)"></span></span>
                    </li>
                }
            </ol>
        }
    </div>;

    private RenderFragment ValueBars(IReadOnlyList<ValueStat> rows, string empty) => @<div class="hr-viz-bars is-dense">
        @if (rows.Count == 0)
        {
            <p class="hr-viz-empty">@empty</p>
        }
        else
        {
            var max = Math.Max(1, rows.Max(r => r.Count));
            <ol class="hr-viz-bars-list">
                @foreach (var r in rows)
                {
                    <li @key="r.Label + r.Value" class="hr-viz-bar">
                        <span class="hr-viz-bar-name" title="@r.Label: @r.Value"><span class="hr-ua-valuechip">@r.Value</span> <span class="hr-meta">@r.Label</span></span>
                        <span class="hr-viz-bar-value"><span class="hr-num">@r.Count.ToString("N0")</span><span class="hr-viz-bar-pct">مرة</span></span>
                        <span class="hr-viz-bar-track" aria-hidden="true"><span class="hr-viz-bar-fill" style="--v:@Css((double)r.Count / max)"></span></span>
                    </li>
                }
            </ol>
        }
    </div>;

    private RenderFragment CategoryChips(string current, Action<string> set, string? labelledBy) => @<div class="hr-chips" role="group" aria-labelledby="@labelledBy" aria-label="@(labelledBy is null ? "نوع الحركة" : null)">
        @foreach (var cat in CategoryFilters)
        {
            <button type="button" class="hr-chip" aria-pressed="@(current == cat.Key ? "true" : "false")" @onclick="() => set(cat.Key)">
                @if (cat.Key.Length > 0)
                {
                    <Icon Name="@CategoryIcon(cat.Key)" Size="xs" />
                }
                <span>@cat.Label</span>
            </button>
        }
    </div>;

    private RenderFragment CategoryTag(UserActivityEvent ev) => @<span class="hr-badge hr-badge--plain @(ev.Success ? null : "hr-badge-danger")">
        <Icon Name="@(ev.Success ? CategoryIcon(ev.Category) : "exclamation-circle")" Size="xs" />
        <span>@CategoryName(ev.Category)@(ev.Success ? "" : " · فاشلة")</span>
    </span>;

    private RenderFragment ValueCell(UserActivityEvent ev) => @<span>
        @if (ev.Category == ActivityCategories.Navigation && ev.DurationSeconds is > 0)
        {
            <span class="hr-meta">قبلها @Short(ev.DurationSeconds.Value)</span>
        }
        else if (!string.IsNullOrWhiteSpace(ev.ValueText))
        {
            <span class="hr-ua-valuechip">@ev.ValueText</span>
        }
        else
        {
            <span class="hr-meta">—</span>
        }
    </span>;

    private RenderFragment UserCell(UserRow u) => @<span class="hr-ua-usercell">
        <span class="hr-avatar hr-avatar-sm hr-ua-avatar @(u.Online ? "is-online" : null)" aria-hidden="true">@Initial(u.DisplayName)</span>
        <span>
            <button type="button" class="hr-link hr-ua-linkbtn" @onclick="() => OpenUser(u.Key)">@u.DisplayName</button>
            <span class="hr-cell-sub">@RoleLine(u)@(u.Online ? " · متصل" : "")</span>
        </span>
    </span>;

    private RenderFragment Steps(IReadOnlyList<UserActivityEvent> events) => @<ol class="hr-ua-steps">
        @foreach (var ev in events)
        {
            <li @key="ev.Id" class="hr-ua-step @(ev.Success ? null : "is-failed")">
                <time class="hr-num" datetime="@ev.TimestampUtc.ToString("o")">@ev.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                <span class="hr-ua-step-mark" aria-hidden="true"><Icon Name="@(ev.Success ? CategoryIcon(ev.Category) : "exclamation-circle")" Size="xs" /></span>
                <div>
                    <p class="hr-ua-step-title">
                        <span class="hr-sr">@CategoryName(ev.Category):</span>
                        @ev.ActionTitle
                        @if (!ev.Success) { <span class="hr-badge hr-badge-danger">فاشلة</span> }
                    </p>
                    <p class="hr-ua-step-meta">
                        @if (!string.IsNullOrWhiteSpace(ev.PagePath) && ev.Category != ActivityCategories.Navigation)
                        {
                            <span>@(ev.PageTitle ?? UserActivityService.GetArabicPageTitle(ev.PagePath))</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.ElementLabel))
                        {
                            <span>@ev.ElementLabel</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.ValueText) && ev.Category != ActivityCategories.Navigation)
                        {
                            <span class="hr-ua-valuechip">@ev.ValueText</span>
                        }
                        @if (ev.Category == ActivityCategories.Navigation && ev.DurationSeconds is > 0)
                        {
                            <span>بعد @Short(ev.DurationSeconds.Value) في الصفحة السابقة</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.IpAddress))
                        {
                            <span class="hr-num" dir="ltr">@ev.IpAddress</span>
                        }
                    </p>
                </div>
            </li>
        }
    </ol>;
}

@code {
    private sealed record RangeOption(string Key, string Label);
    private sealed record TabOption(string Key, string Label, string Icon);
    private sealed record CategoryOption(string Key, string Label);
    private sealed record ValueStat(string Label, string Value, int Count);
    private sealed record PageStat(string Group, string Title, int Seconds, int Visits, int Users);
    private sealed record Figure(string Label, string Value, string Sub, int[] History, string? Tone, string? HistoryOf = null);
    private sealed record Lane(UserRow User, List<Session> Sessions);

    private sealed record Segment(string Group, string Title, DateTimeOffset Start, DateTimeOffset End)
    {
        public int Seconds => (int)Math.Max(0, (End - Start).TotalSeconds);
    }

    private sealed class Session
    {
        public required string Id { get; init; }
        public required string UserKey { get; init; }
        public List<UserActivityEvent> Events { get; } = [];
        public List<Segment> Segments { get; set; } = [];
        public DateTimeOffset Start => Events[0].TimestampUtc;
        public DateTimeOffset End { get; set; }
        public bool Open { get; set; }
        public bool LoggedOut { get; set; }
    }

    private sealed class UserRow
    {
        public required string Key { get; init; }
        public string UserName { get; init; } = "";
        public string DisplayName { get; init; } = "";
        public string? EmployeeId { get; init; }
        public string? Role { get; init; }
        public bool Online { get; init; }
        public DateTimeOffset LastSeen { get; init; }
        public string? LastPageTitle { get; init; }
        public string? CurrentPageTitle { get; init; }
        public DateTimeOffset? CurrentPageSince { get; init; }
        public DateTimeOffset? SessionStart { get; init; }
        public int Sessions { get; init; }
        public int ActiveSeconds { get; init; }
        public int Pages { get; init; }
        public int Searches { get; init; }
        public int Dropdowns { get; init; }
        public int Clicks { get; init; }
        public int Security { get; init; }
        public int SecurityFailed { get; init; }
    }

    private static readonly TimeSpan SessionGap = TimeSpan.FromMinutes(30);
    private static readonly TimeSpan OnlineWindow = TimeSpan.FromMinutes(5);
    private const int StreamCap = 400;
    private static readonly CultureInfo ArabicCulture = CultureInfo.GetCultureInfo("ar-IQ");
    private static readonly DayOfWeek[] WeekOrder =
        [DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday];

    private static readonly RangeOption[] TimeRanges =
    [
        new("today", "اليوم"),
        new("7d", "7 أيام"),
        new("30d", "30 يوماً"),
        new("all", "الكل")
    ];

    private static readonly TabOption[] Tabs =
    [
        new("overview", "نظرة عامة", "chart-bar"),
        new("live", "المباشر والسجل", "signal"),
        new("day", "يوم العمل", "calendar-days"),
        new("user", "مستخدم", "user-circle")
    ];

    private static readonly CategoryOption[] CategoryFilters =
    [
        new("", "الكل"),
        new(ActivityCategories.Auth, "الدخول والخروج"),
        new(ActivityCategories.Navigation, "الصفحات"),
        new(ActivityCategories.Dropdown, "القوائم"),
        new(ActivityCategories.Search, "البحث والكتابة"),
        new(ActivityCategories.Click, "النقرات"),
        new(ActivityCategories.Security, "العمليات الأمنية")
    ];

    private string _selectedRange = "7d";
    private string _activeTab = "overview";
    private bool _autoRefresh = true;
    private bool _loaded;
    private bool _isRefreshing;
    private bool _dbMergeFailed;
    private DateTime _lastRefreshedLocal = DateTime.Now;
    private Timer? _refreshTimer;

    private List<UserActivityEvent> _allRangeEvents = [];
    private List<UserRow> _users = [];
    private List<UserRow> _onlineUsers = [];
    private Dictionary<string, UserRow> _userByKey = [];
    private Dictionary<string, List<Session>> _sessionsByUser = [];
    private List<Session> _sessions = [];
    private List<DateOnly> _days = [];

    private List<Figure> _figures = [];
    private List<string> _buckets = [];
    private bool _bucketIsHour;
    private int[,] _heat = new int[7, 24];
    private int _heatMax;
    private int _heatFromHour = 8;
    private int _heatToHour = 16;
    private List<PageStat> _pageStats = [];
    private List<ValueStat> _topDropdowns = [];
    private List<ValueStat> _topSearches = [];
    private Dictionary<string, int> _seriesByGroup = [];
    private Dictionary<string, string> _groupTitles = [];

    private string? _selectedUserKey;
    private string? _userSessionId;
    private string _journeyCategoryFilter = string.Empty;
    private DateOnly? _selectedDay;
    private string? _daySessionId;

    private string _streamCategoryFilter = string.Empty;
    private string _streamUserFilter = string.Empty;
    private string _streamSearchQuery = string.Empty;

    private string RangeLabel => TimeRanges.First(r => r.Key == _selectedRange).Label;

    private UserRow? SelectedUser =>
        (_selectedUserKey is not null && _userByKey.TryGetValue(_selectedUserKey, out var u) ? u : null) ?? _users.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
        StartOrStopTimer();
    }

    private void StartOrStopTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_autoRefresh)
        {
            _refreshTimer = new Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshDataAsync();
                        StateHasChanged();
                    });
                }
                catch
                {
                    // Ignore timer disposal race
                }
            }, null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
        }
    }

    private void ToggleAutoRefresh()
    {
        _autoRefresh = !_autoRefresh;
        StartOrStopTimer();
    }

    private async Task RefreshNowAsync()
    {
        _isRefreshing = true;
        try { await RefreshDataAsync(); }
        finally { _isRefreshing = false; }
    }

    private async Task ChangeRangeAsync(string rangeKey)
    {
        _selectedRange = rangeKey;
        _selectedDay = null;
        _daySessionId = null;
        _userSessionId = null;
        await RefreshDataAsync();
    }

    private DateTimeOffset? GetFromUtc()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        return _selectedRange switch
        {
            "today" => new DateTimeOffset(DateTime.Today).ToUniversalTime(),
            "7d" => nowUtc.AddDays(-7),
            "30d" => nowUtc.AddDays(-30),
            _ => null
        };
    }

    private async Task RefreshDataAsync()
    {
        var fromUtc = GetFromUtc();

        // 1. Live & JSONL events from UserActivityService
        var memoryEvents = ActivityService.GetRecentEvents(fromUtc: fromUtc, maxCount: 8000).ToList();

        // 2. Merge historical AuditLogs so logins and security actions from before the last restart are included
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.AuditLogs.AsNoTracking().AsQueryable();
            if (fromUtc.HasValue)
            {
                var fromOffset = fromUtc.Value;
                query = query.Where(a => a.Timestamp >= fromOffset);
            }

            var dbLogs = await query
                .OrderByDescending(a => a.Timestamp)
                .Take(1000)
                .ToListAsync();

            var existingKeys = new HashSet<string>(
                memoryEvents.Select(e => $"{e.ActionCode}|{e.UserId}|{e.TimestampUtc.ToUnixTimeSeconds()}"),
                StringComparer.OrdinalIgnoreCase);

            foreach (var log in dbLogs)
            {
                var ts = log.Timestamp;
                if (existingKeys.Contains($"{log.Action}|{log.UserId}|{ts.ToUnixTimeSeconds()}"))
                {
                    continue;
                }

                var isAuth = log.Action.Contains("LOGIN", StringComparison.OrdinalIgnoreCase)
                          || log.Action.Contains("LOGOUT", StringComparison.OrdinalIgnoreCase)
                          || log.Action.Contains("MAGIC", StringComparison.OrdinalIgnoreCase);

                memoryEvents.Add(new UserActivityEvent
                {
                    Id = $"db-{log.Id}",
                    TimestampUtc = ts,
                    UserId = log.UserId ?? string.Empty,
                    UserName = string.IsNullOrWhiteSpace(log.UserId) ? "النظام" : log.UserId,
                    EmployeeId = log.EmployeeID,
                    Category = isAuth ? ActivityCategories.Auth : ActivityCategories.Security,
                    ActionCode = log.Action,
                    ActionTitle = log.Action,
                    ValueText = log.FailureReason,
                    IpAddress = log.IpAddress,
                    UserAgent = log.UserAgent,
                    Success = log.Success
                });
            }
            _dbMergeFailed = false;
        }
        catch
        {
            // Keep the in-memory stream; the page says the audit log is missing.
            _dbMergeFailed = true;
        }

        _allRangeEvents = memoryEvents
            .Where(e => !string.IsNullOrWhiteSpace(e.UserName) || !string.IsNullOrWhiteSpace(e.UserId))
            .OrderByDescending(e => e.TimestampUtc)
            .ToList();

        BuildSessions();
        BuildUsers();
        BuildOverview();

        _days = _sessions.Select(s => DateOnly.FromDateTime(s.Start.LocalDateTime)).Distinct().OrderDescending().ToList();
        if (_selectedDay is { } day && !_days.Contains(day))
        {
            _selectedDay = null;
        }

        _loaded = true;
        _lastRefreshedLocal = DateTime.Now;
    }

    // A session is one user's run of events with no gap over 30 minutes; a successful
    // login opens a new one and a logout closes it.
    private void BuildSessions()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        _sessions = [];
        _sessionsByUser = new(StringComparer.Ordinal);

        foreach (var group in _allRangeEvents.GroupBy(KeyOf))
        {
            var list = new List<Session>();
            Session? current = null;

            foreach (var ev in group.OrderBy(e => e.TimestampUtc))
            {
                var isLogin = ev.Category == ActivityCategories.Auth && ev.Success
                    && ev.ActionCode.Contains("LOGIN", StringComparison.OrdinalIgnoreCase)
                    && !ev.ActionCode.Contains("LOGOUT", StringComparison.OrdinalIgnoreCase);

                if (current is null || ev.TimestampUtc - current.Events[^1].TimestampUtc > SessionGap || (isLogin && current.Events.Count > 0))
                {
                    current = new Session { Id = $"{group.Key}|{ev.TimestampUtc.ToUnixTimeMilliseconds()}", UserKey = group.Key };
                    list.Add(current);
                }

                current.Events.Add(ev);

                if (ev.ActionCode.Equals("USER_LOGOUT", StringComparison.OrdinalIgnoreCase))
                {
                    current.LoggedOut = true;
                    current = null;
                }
            }

            foreach (var s in list)
            {
                var last = s.Events[^1].TimestampUtc;
                s.Open = !s.LoggedOut && nowUtc - last <= OnlineWindow;
                s.End = s.Open ? nowUtc : last;
                s.Segments = BuildSegments(s);
            }

            list.Reverse();
            _sessionsByUser[group.Key] = list;
            _sessions.AddRange(list);
        }

        // Pages keep one colour on every tab: the five with the most time get a series each.
        var totals = _sessions.SelectMany(s => s.Segments)
            .GroupBy(s => s.Group)
            .Select(g => (Group: g.Key, Title: g.First().Title, Seconds: g.Sum(x => x.Seconds)))
            .OrderByDescending(x => x.Seconds)
            .ToList();
        _groupTitles = totals.ToDictionary(t => t.Group, t => t.Title);
        _seriesByGroup = totals.Take(5).Select((t, i) => (t.Group, i)).ToDictionary(x => x.Group, x => x.i + 1);
    }

    private static List<Segment> BuildSegments(Session s)
    {
        var segments = new List<Segment>();
        string? group = null;
        string? title = null;
        DateTimeOffset start = default;

        foreach (var ev in s.Events.Where(e => !string.IsNullOrWhiteSpace(e.PagePath)))
        {
            var g = PageGroup(ev.PagePath);
            if (g == group) continue;
            if (group is not null) segments.Add(new Segment(group, title!, start, ev.TimestampUtc));
            group = g;
            title = GroupTitle(ev);
            start = ev.TimestampUtc;
        }

        if (group is not null) segments.Add(new Segment(group, title!, start, s.End));
        return segments;
    }

    private void BuildUsers()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        _users = _sessionsByUser.Select(kv =>
            {
                var sessions = kv.Value;
                var events = sessions.SelectMany(s => s.Events).ToList();
                var latest = sessions[0];
                var lastEv = latest.Events[^1];
                var online = latest.Open;
                var currentSeg = online ? latest.Segments.LastOrDefault() : null;
                var name = events.Select(e => e.EmployeeName).LastOrDefault(n => !string.IsNullOrWhiteSpace(n));
                var userName = string.IsNullOrWhiteSpace(lastEv.UserName) ? lastEv.UserId : lastEv.UserName;
                return new UserRow
                {
                    Key = kv.Key,
                    UserName = userName,
                    DisplayName = string.IsNullOrWhiteSpace(name) ? userName : name!,
                    EmployeeId = events.Select(e => e.EmployeeId).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    Role = events.Select(e => e.UserRole).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    Online = online,
                    LastSeen = lastEv.TimestampUtc,
                    LastPageTitle = latest.Segments.LastOrDefault()?.Title,
                    CurrentPageTitle = currentSeg?.Title,
                    CurrentPageSince = currentSeg?.Start,
                    SessionStart = latest.Start,
                    Sessions = sessions.Count,
                    ActiveSeconds = sessions.Sum(s => (int)(s.End - s.Start).TotalSeconds),
                    Pages = events.Count(e => e.Category == ActivityCategories.Navigation && e.ActionCode == "PAGE_VIEW"),
                    Searches = events.Count(e => e.Category == ActivityCategories.Search),
                    Dropdowns = events.Count(e => e.Category == ActivityCategories.Dropdown),
                    Clicks = events.Count(e => e.Category == ActivityCategories.Click),
                    Security = events.Count(e => e.Category == ActivityCategories.Security),
                    SecurityFailed = events.Count(e => !e.Success)
                };
            })
            .OrderByDescending(u => u.Online)
            .ThenByDescending(u => u.LastSeen)
            .ToList();

        _userByKey = _users.ToDictionary(u => u.Key, StringComparer.Ordinal);
        _onlineUsers = _users.Where(u => u.Online).ToList();
    }

    private void BuildOverview()
    {
        var nowLocal = DateTime.Now;

        // Buckets: hours of today, or days of the range (the last 30 at most).
        _bucketIsHour = _selectedRange == "today";
        Func<DateTimeOffset, int> bucketOf;
        if (_bucketIsHour)
        {
            var hours = nowLocal.Hour + 1;
            _buckets = Enumerable.Range(0, hours).Select(h => $"{h:00}:00").ToList();
            bucketOf = t => t.LocalDateTime.Date == nowLocal.Date ? t.LocalDateTime.Hour : -1;
        }
        else
        {
            var earliest = _allRangeEvents.Count > 0 ? _allRangeEvents[^1].TimestampUtc.LocalDateTime.Date : nowLocal.Date;
            var span = Math.Clamp((nowLocal.Date - earliest).Days + 1, 1, 30);
            var first = nowLocal.Date.AddDays(1 - span);
            _buckets = Enumerable.Range(0, span).Select(i => first.AddDays(i).ToString("dddd d/M", ArabicCulture)).ToList();
            bucketOf = t => (t.LocalDateTime.Date - first).Days;
        }

        int[] Series(IEnumerable<DateTimeOffset> times)
        {
            var arr = new int[_buckets.Count];
            foreach (var t in times)
            {
                var i = bucketOf(t);
                if (i >= 0 && i < arr.Length) arr[i]++;
            }
            return arr;
        }

        int[] ActiveUsers()
        {
            var arr = new int[_buckets.Count];
            foreach (var g in _allRangeEvents.GroupBy(KeyOf))
            {
                foreach (var i in g.Select(e => bucketOf(e.TimestampUtc)).Distinct())
                {
                    if (i >= 0 && i < arr.Length) arr[i]++;
                }
            }
            return arr;
        }

        var pageViews = _allRangeEvents.Where(e => e.Category == ActivityCategories.Navigation && e.ActionCode == "PAGE_VIEW").ToList();
        var searches = _allRangeEvents.Count(e => e.Category == ActivityCategories.Search);
        var dropdowns = _allRangeEvents.Count(e => e.Category == ActivityCategories.Dropdown);
        var security = _allRangeEvents.Where(e => e.Category == ActivityCategories.Security || !e.Success).ToList();
        var failed = security.Count(e => !e.Success);
        var avgSession = _sessions.Count == 0 ? 0 : (int)_sessions.Average(s => (s.End - s.Start).TotalSeconds);

        _figures =
        [
            new("المتصلون الآن", _onlineUsers.Count.ToString("N0"), $"الأعمدة: النشطون {(_bucketIsHour ? "كل ساعة" : "كل يوم")} من {_users.Count:N0}", ActiveUsers(), _onlineUsers.Count > 0 ? "ok" : null, "المستخدمون النشطون"),
            new("الجلسات", _sessions.Count.ToString("N0"), $"متوسط الجلسة {Short(avgSession)}", Series(_sessions.Select(s => s.Start)), null),
            new("الصفحات المفتوحة", pageViews.Count.ToString("N0"), $"{_groupTitles.Count:N0} صفحة مختلفة", Series(pageViews.Select(e => e.TimestampUtc)), null),
            new("البحث والقوائم", (searches + dropdowns).ToString("N0"), $"{searches:N0} بحث · {dropdowns:N0} قائمة",
                Series(_allRangeEvents.Where(e => e.Category is ActivityCategories.Search or ActivityCategories.Dropdown).Select(e => e.TimestampUtc)), null),
            new("العمليات الأمنية", security.Count.ToString("N0"), failed > 0 ? $"{failed:N0} محاولة فاشلة" : "لا محاولات فاشلة", Series(security.Select(e => e.TimestampUtc)), failed > 0 ? "danger" : null)
        ];

        // Weekday × hour rhythm, trimmed to the hours that have activity (never narrower than 08–16).
        _heat = new int[7, 24];
        foreach (var ev in _allRangeEvents)
        {
            var t = ev.TimestampUtc.LocalDateTime;
            _heat[(int)t.DayOfWeek, t.Hour]++;
        }
        var activeHours = Enumerable.Range(0, 24).Where(h => Enumerable.Range(0, 7).Any(d => _heat[d, h] > 0)).ToList();
        _heatFromHour = Math.Min(8, activeHours.DefaultIfEmpty(8).Min());
        _heatToHour = Math.Max(16, activeHours.DefaultIfEmpty(16).Max());
        _heatMax = _heat.Cast<int>().DefaultIfEmpty(0).Max();

        _pageStats = PageStatsFor(_sessions);

        _topDropdowns = TopValues(ActivityCategories.Dropdown, "قائمة منسدلة");
        _topSearches = TopValues(ActivityCategories.Search, "حقل بحث");
    }

    private static List<PageStat> PageStatsFor(IEnumerable<Session> sessions) =>
        sessions.SelectMany(s => s.Segments.Select(seg => (seg, s.UserKey)))
            .GroupBy(x => x.seg.Group)
            .Select(g => new PageStat(
                g.Key,
                g.First().seg.Title,
                g.Sum(x => x.seg.Seconds),
                g.Count(),
                g.Select(x => x.UserKey).Distinct().Count()))
            .OrderByDescending(p => p.Seconds)
            .ThenByDescending(p => p.Visits)
            .ToList();

    private List<ValueStat> TopValues(string category, string fallbackLabel) =>
        _allRangeEvents
            .Where(e => e.Category == category && !string.IsNullOrWhiteSpace(e.ValueText))
            .GroupBy(e => $"{e.ElementLabel ?? fallbackLabel}|{e.ValueText}")
            .Select(g => new ValueStat(g.First().ElementLabel ?? fallbackLabel, g.First().ValueText!, g.Count()))
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToList();

    private List<Lane> DayLanes(DateOnly day) =>
        _sessions
            .Where(s => DateOnly.FromDateTime(s.Start.LocalDateTime) == day)
            .GroupBy(s => s.UserKey)
            .Where(g => _userByKey.ContainsKey(g.Key))
            .Select(g => new Lane(_userByKey[g.Key], g.OrderBy(s => s.Start).ToList()))
            .OrderBy(l => l.Sessions[0].Start)
            .ToList();

    private static (int From, int To) DayHours(List<Lane> lanes)
    {
        if (lanes.Count == 0) return (8, 16);
        var sessions = lanes.SelectMany(l => l.Sessions).ToList();
        var from = Math.Min(8, sessions.Min(s => s.Start.LocalDateTime.Hour));
        var lastEnd = sessions.Max(s => s.End.LocalDateTime);
        var to = Math.Max(16, Math.Min(24, lastEnd.Hour + 1));
        if (lastEnd.Date > sessions.Min(s => s.Start.LocalDateTime.Date)) to = 24;
        return (from, to);
    }

    private static TimeSpan LocalOffset(DateOnly day) => TimeZoneInfo.Local.GetUtcOffset(day.ToDateTime(new TimeOnly(12, 0)));

    private void SelectDay(int index)
    {
        if (index < 0 || index >= _days.Count) return;
        _selectedDay = _days[index];
        _daySessionId = null;
    }

    private void OnDayPicked(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var day))
        {
            _selectedDay = day;
            _daySessionId = null;
        }
    }

    private void OnUserPicked(ChangeEventArgs e)
    {
        _selectedUserKey = e.Value?.ToString();
        _userSessionId = null;
    }

    // Tabs follow the ARIA pattern: one tab in the Tab order, arrows move along the row
    // (ArrowLeft is "next" in RTL), Home and End jump to the ends.
    private async Task OnTabKeyAsync(KeyboardEventArgs e)
    {
        var i = Array.FindIndex(Tabs, t => t.Key == _activeTab);
        var next = e.Key switch
        {
            "ArrowLeft" => (i + 1) % Tabs.Length,
            "ArrowRight" => (i - 1 + Tabs.Length) % Tabs.Length,
            "Home" => 0,
            "End" => Tabs.Length - 1,
            _ => -1
        };
        if (next < 0) return;
        _activeTab = Tabs[next].Key;
        StateHasChanged();
        await JS.InvokeVoidAsync("eval", $"document.getElementById('ua-tab-{_activeTab}')?.focus()");
    }

    private void OpenUser(string key, string? sessionId = null)
    {
        _selectedUserKey = key;
        _userSessionId = sessionId;
        _activeTab = "user";
    }

    private void ClearStreamFilters()
    {
        _streamCategoryFilter = string.Empty;
        _streamUserFilter = string.Empty;
        _streamSearchQuery = string.Empty;
    }

    private List<UserActivityEvent> GetFilteredStreamEvents()
    {
        var query = _allRangeEvents.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_streamCategoryFilter))
        {
            query = query.Where(e => string.Equals(e.Category, _streamCategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_streamUserFilter))
        {
            query = query.Where(e => KeyOf(e) == _streamUserFilter);
        }

        if (!string.IsNullOrWhiteSpace(_streamSearchQuery))
        {
            var q = _streamSearchQuery.Trim();
            query = query.Where(e =>
                e.ActionTitle.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.UserName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (e.EmployeeName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.ElementLabel?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.ValueText?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.PageTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.PagePath?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query.ToList();
    }

    private async Task ExportCsvAsync()
    {
        var rows = GetFilteredStreamEvents();
        var sb = new StringBuilder();
        sb.AppendLine("Timestamp,UserName,EmployeeName,Role,Category,ActionTitle,PageTitle,PagePath,ElementLabel,ValueText,DurationSeconds,IpAddress,Success");

        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",",
                EscapeCsv(r.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")),
                EscapeCsv(r.UserName),
                EscapeCsv(r.EmployeeName),
                EscapeCsv(r.UserRole),
                EscapeCsv(CategoryName(r.Category)),
                EscapeCsv(r.ActionTitle),
                EscapeCsv(r.PageTitle ?? UserActivityService.GetArabicPageTitle(r.PagePath)),
                EscapeCsv(r.PagePath),
                EscapeCsv(r.ElementLabel),
                EscapeCsv(r.ValueText),
                r.DurationSeconds?.ToString() ?? "",
                EscapeCsv(r.IpAddress),
                r.Success ? "true" : "false"));
        }

        var csvBytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(csvBytes);
        await JS.InvokeVoidAsync("eval", $"{{ const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = 'user-activity-{DateTime.Now:yyyyMMdd-HHmm}.csv'; a.click(); }}");
    }

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "\"\"";
        return $"\"{val.Replace("\"", "\"\"")}\"";
    }

    // ───────────────────────── Formatting ─────────────────────────

    private static string KeyOf(UserActivityEvent e) =>
        (!string.IsNullOrWhiteSpace(e.UserName) ? e.UserName : e.UserId).ToLowerInvariant();

    private string DisplayNameOf(UserActivityEvent e) =>
        _userByKey.TryGetValue(KeyOf(e), out var u) ? u.DisplayName
        : string.IsNullOrWhiteSpace(e.EmployeeName) ? e.UserName : e.EmployeeName;

    private static string PageGroup(string? path)
    {
        var clean = (path ?? "").Split('?', '#')[0].Trim('/').ToLowerInvariant();
        if (clean.Length == 0) return "/";
        var slash = clean.IndexOf('/');
        return slash < 0 ? clean : clean[..slash];
    }

    private static readonly Regex TrailingParens = new(@"\s*\([^)]*\)\s*$", RegexOptions.Compiled);

    // "ملف الموظف (10442)" and "ملف الموظف (10391)" are one page for dwell and colour.
    private static string GroupTitle(UserActivityEvent ev) =>
        TrailingParens.Replace(ev.PageTitle ?? UserActivityService.GetArabicPageTitle(ev.PagePath), "");

    private string SeriesOf(string group) =>
        _seriesByGroup.TryGetValue(group, out var i) ? $"s{i}" : "other";

    private static string CategoryName(string category) => category switch
    {
        ActivityCategories.Auth => "دخول / خروج",
        ActivityCategories.Navigation => "صفحة",
        ActivityCategories.Dropdown => "قائمة",
        ActivityCategories.Search => "بحث / إدخال",
        ActivityCategories.Click => "نقر",
        ActivityCategories.Security => "عملية أمنية",
        _ => category
    };

    private static string CategoryIcon(string category) => category switch
    {
        ActivityCategories.Auth => "arrow-right-on-rectangle",
        ActivityCategories.Navigation => "document-text",
        ActivityCategories.Dropdown => "adjustments-horizontal",
        ActivityCategories.Search => "magnifying-glass",
        ActivityCategories.Click => "squares-2x2",
        ActivityCategories.Security => "shield-check",
        _ => "question-mark-circle"
    };

    private static string RoleLine(UserRow u) =>
        string.Join(" · ", new[] { u.UserName, u.Role }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string Initial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1].ToUpperInvariant();

    private string SessionLabel(UserRow u, Session s) =>
        $"{u.DisplayName}: {s.Start.ToLocalTime():HH:mm} إلى {(s.Open ? "الآن" : s.End.ToLocalTime().ToString("HH:mm"))}، {Short((int)(s.End - s.Start).TotalSeconds)}، "
        + string.Join("، ", s.Segments.GroupBy(x => x.Title).Select(g => $"{g.Key} {Short(g.Sum(x => x.Seconds))}"));

    private static string SessionSummary(Session s) =>
        $"{DayName(s.Start)} من {s.Start.ToLocalTime():HH:mm} إلى {(s.Open ? "الآن" : s.End.ToLocalTime().ToString("HH:mm"))} · "
        + $"{Short((int)(s.End - s.Start).TotalSeconds)} · {s.Events.Count:N0} حركة"
        + (s.LoggedOut ? " · انتهت بتسجيل الخروج" : s.Open ? " · جارية" : "");

    private static string DayName(DateTimeOffset t)
    {
        var d = t.LocalDateTime.Date;
        if (d == DateTime.Today) return "اليوم";
        if (d == DateTime.Today.AddDays(-1)) return "أمس";
        return d.ToString("dddd d MMMM", ArabicCulture);
    }

    private string HistoryLabel(Figure fig) =>
        $"{fig.HistoryOf ?? fig.Label} بحسب {(_bucketIsHour ? "الساعة" : "اليوم")}: "
        + string.Join("، ", _buckets.Select((b, i) => $"{b} {fig.History[i]:N0}"));

    private static int Depth(int n, int max)
    {
        if (n <= 0 || max <= 0) return 0;
        return Math.Clamp((int)Math.Ceiling(n * 5.0 / max), 1, 5);
    }

    private static string Compact(int n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString();

    private static string Css(double v) => Math.Clamp(v, 0, 1).ToString("0.####", CultureInfo.InvariantCulture);

    private static string Short(int seconds)
    {
        if (seconds < 60) return $"{Math.Max(0, seconds)} ث";
        var mins = seconds / 60;
        if (mins < 60) return $"{mins} د";
        return mins % 60 == 0 ? $"{mins / 60} س" : $"{mins / 60} س {mins % 60} د";
    }

    private static string Clock(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes}:{t.Seconds:00}";

    private static string RelativeTime(DateTimeOffset utc)
    {
        var diff = DateTimeOffset.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "الآن";
        if (diff.TotalMinutes < 60) return $"منذ {(int)diff.TotalMinutes} د";
        if (diff.TotalHours < 24) return $"منذ {(int)diff.TotalHours} س";
        return $"{DayName(utc)} {utc.ToLocalTime():HH:mm}";
    }

