@page "/admin/user-analytics"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text
@using API.HR.Node.Data
@using API.HR.Node.Services.Audit
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable

@inject IUserActivityService ActivityService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>تحليلات ومراقبة نشاط المستخدمين</PageTitle>

<div class="max-w-[1650px] mx-auto px-4 sm:px-6 py-6 space-y-6" dir="rtl">

    <!-- Header Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-l from-slate-900 via-indigo-950 to-slate-900 text-white p-6 sm:p-8 shadow-xl border border-indigo-500/20">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-200 text-xs font-bold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>خاص بحساب مسؤول النظام فقط (Admin Only) — الحسابات والأمان</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                    تحليلات ومراقبة نشاط المستخدمين الشاملة
                </h1>
                <p class="text-sm text-slate-300 max-w-3xl leading-relaxed">
                    مراقبة تفصيلية لكل مستخدم من لحظة تسجيل الدخول إلى الخروج: تتبع الصفحات ومدة البقاء فيها، تغييرات القوائم المنسدلة (Dropdowns)، عمليات البحث والكتابة، النقرات، والعمليات الأمنية.
                </p>
            </div>

            <!-- Controls -->
            <div class="flex flex-wrap items-center gap-2.5">
                <!-- Time Range -->
                <div class="inline-flex rounded-xl bg-slate-800/90 p-1 border border-slate-700">
                    @foreach (var range in _timeRanges)
                    {
                        var active = _selectedRange == range.Key;
                        <button type="button"
                                @onclick="() => ChangeRangeAsync(range.Key)"
                                class="px-3 py-1.5 rounded-lg text-xs font-bold transition @(active ? "bg-indigo-600 text-white shadow" : "text-slate-300 hover:text-white")">
                            @range.Label
                        </button>
                    }
                </div>

                <!-- Auto Refresh Toggle -->
                <button type="button"
                        @onclick="ToggleAutoRefresh"
                        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold border transition @(_autoRefresh ? "bg-emerald-500/20 border-emerald-400/40 text-emerald-200" : "bg-slate-800/80 border-slate-700 text-slate-300 hover:text-white")">
                    <span class="w-2 h-2 rounded-full @(_autoRefresh ? "bg-emerald-400 animate-ping" : "bg-slate-500")"></span>
                    <span>@(_autoRefresh ? "بث حي مفعل (٤ث)" : "تفعيل البث الحي")</span>
                </button>

                <!-- Manual Refresh -->
                <button type="button"
                        @onclick="RefreshDataAsync"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/20 text-white border border-white/15 transition">
                    <Icon Name="arrow-path" Class="w-4 h-4" />
                    <span>تحديث الآن</span>
                </button>

                <!-- Export CSV -->
                <button type="button"
                        @onclick="ExportCsvAsync"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white shadow transition">
                    <Icon Name="arrow-down-tray" Class="w-4 h-4" />
                    <span>تصدير CSV</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Executive KPI Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4">
        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">المتصلون الآن</span>
                <span class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400">
                    <Icon Name="signal" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@_onlineUsersCount</span>
                <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">من أصل @_userSummaries.Count مستخدم نشط</span>
            </div>
        </div>

        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">إجمالي الحركات المسجلة</span>
                <span class="p-2 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400">
                    <Icon Name="bolt" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@_allRangeEvents.Count.ToString("N0")</span>
                <span class="text-xs text-slate-500">حركة مفصلة</span>
            </div>
        </div>

        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">الدخول والخروج</span>
                <span class="p-2 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400">
                    <Icon Name="arrow-right-on-rectangle" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@_authEventsCount.ToString("N0")</span>
                <span class="text-xs text-slate-500">عملية مصادقة</span>
            </div>
        </div>

        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">تصفح الصفحات</span>
                <span class="p-2 rounded-xl bg-violet-50 dark:bg-violet-950/50 text-violet-600 dark:text-violet-400">
                    <Icon Name="globe-alt" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@_navEventsCount.ToString("N0")</span>
                <span class="text-xs text-slate-500">انتقال بين الصفحات</span>
            </div>
        </div>

        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">القوائم المنسدلة والبحث</span>
                <span class="p-2 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400">
                    <Icon Name="adjustments-horizontal" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@((_dropdownEventsCount + _searchEventsCount).ToString("N0"))</span>
                <span class="text-xs text-slate-500">@_dropdownEventsCount قائمة / @_searchEventsCount بحث</span>
            </div>
        </div>

        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">النقرات والعمليات الأمنية</span>
                <span class="p-2 rounded-xl bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400">
                    <Icon Name="shield-check" Class="w-5 h-5" />
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-2xl font-black text-slate-900 dark:text-white">@((_clickEventsCount + _securityEventsCount).ToString("N0"))</span>
                <span class="text-xs text-slate-500">@_clickEventsCount نقرة / @_securityEventsCount أمني</span>
            </div>
        </div>
    </div>

    <!-- Main View Tabs -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-3">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick='() => _activeTab = "journey"'
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold transition @(_activeTab == "journey" ? "bg-indigo-600 text-white shadow-sm" : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-50")">
                <Icon Name="user-circle" Class="w-5 h-5" />
                <span>مسار وجلسة المستخدم (من الدخول إلى الخروج)</span>
            </button>

            <button type="button"
                    @onclick='() => _activeTab = "stream"'
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold transition @(_activeTab == "stream" ? "bg-indigo-600 text-white shadow-sm" : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-50")">
                <Icon Name="queue-list" Class="w-5 h-5" />
                <span>البث الحي الشامل لكافة الحركات</span>
            </button>

            <button type="button"
                    @onclick='() => _activeTab = "analytics"'
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold transition @(_activeTab == "analytics" ? "bg-indigo-600 text-white shadow-sm" : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-50")">
                <Icon Name="chart-bar-square" Class="w-5 h-5" />
                <span>الإحصائيات والتحليلات التفصيلية</span>
            </button>
        </div>

        <div class="text-xs text-slate-500 dark:text-slate-400">
            آخر تحديث: <span class="font-bold text-slate-700 dark:text-slate-200">@_lastRefreshedLocal.ToString("HH:mm:ss")</span>
        </div>
    </div>

    @if (_activeTab == "journey")
    {
        <!-- TAB 1: USER JOURNEY (FROM LOGIN TO LOGOUT) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- Left Column: Users List -->
            <div class="lg:col-span-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-800 space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-black text-slate-900 dark:text-white">قائمة المستخدمين المراقبين</h2>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">
                            @_filteredUserSummaries.Count مستخدم
                        </span>
                    </div>
                    <div class="relative">
                        <input type="text"
                               @bind="_userListSearch"
                               @bind:event="oninput"
                               placeholder="ابحث باسم المستخدم أو الرقم الوظيفي..."
                               class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/70 px-3.5 py-2 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    </div>
                </div>

                <div class="divide-y divide-slate-100 dark:divide-slate-800 max-h-[680px] overflow-y-auto">
                    @if (_filteredUserSummaries.Count == 0)
                    {
                        <div class="p-8 text-center text-xs text-slate-400">
                            لا توجد حركات مسجلة للمستخدمين ضمن الفترة المحددة.
                        </div>
                    }
                    else
                    {
                        @foreach (var u in _filteredUserSummaries)
                        {
                            var isSelected = string.Equals(_selectedUserKey, u.UserName, StringComparison.OrdinalIgnoreCase)
                                          || (!string.IsNullOrEmpty(u.UserId) && string.Equals(_selectedUserKey, u.UserId, StringComparison.OrdinalIgnoreCase));

                            <button type="button"
                                    @onclick="() => SelectUserForJourney(u)"
                                    class="w-full text-right p-4 transition flex flex-col gap-2 @(isSelected ? "bg-indigo-50/90 dark:bg-indigo-950/40 border-r-4 border-indigo-600" : "hover:bg-slate-50 dark:hover:bg-slate-800/50")">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <span class="relative flex h-3 w-3 shrink-0">
                                            @if (u.IsOnlineNow)
                                            {
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                                            }
                                            else
                                            {
                                                <span class="relative inline-flex rounded-full h-3 w-3 bg-slate-300 dark:bg-slate-600"></span>
                                            }
                                        </span>
                                        <div class="truncate">
                                            <div class="text-sm font-black text-slate-900 dark:text-white truncate">
                                                @(string.IsNullOrWhiteSpace(u.EmployeeName) ? u.UserName : $"{u.EmployeeName} ({u.UserName})")
                                            </div>
                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(u.UserRole))
                                                {
                                                    <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-semibold">@u.UserRole</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(u.EmployeeId))
                                                {
                                                    <span>رقم وظيفي: @u.EmployeeId</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <span class="px-2 py-0.5 rounded-lg text-xs font-extrabold bg-indigo-100 dark:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 shrink-0">
                                        @u.TotalEvents حركة
                                    </span>
                                </div>

                                <!-- Mini Counters -->
                                <div class="grid grid-cols-5 gap-1 pt-1 text-[11px]">
                                    <div class="rounded-lg bg-slate-100/80 dark:bg-slate-800/70 px-2 py-1 text-center">
                                        <span class="block text-slate-400">دخول</span>
                                        <span class="font-bold text-slate-800 dark:text-slate-200">@u.LoginCount</span>
                                    </div>
                                    <div class="rounded-lg bg-slate-100/80 dark:bg-slate-800/70 px-2 py-1 text-center">
                                        <span class="block text-slate-400">صفحات</span>
                                        <span class="font-bold text-violet-600 dark:text-violet-400">@u.PageViewCount</span>
                                    </div>
                                    <div class="rounded-lg bg-slate-100/80 dark:bg-slate-800/70 px-2 py-1 text-center">
                                        <span class="block text-slate-400">قوائم</span>
                                        <span class="font-bold text-amber-600 dark:text-amber-400">@u.DropdownCount</span>
                                    </div>
                                    <div class="rounded-lg bg-slate-100/80 dark:bg-slate-800/70 px-2 py-1 text-center">
                                        <span class="block text-slate-400">بحث</span>
                                        <span class="font-bold text-emerald-600 dark:text-emerald-400">@u.SearchCount</span>
                                    </div>
                                    <div class="rounded-lg bg-slate-100/80 dark:bg-slate-800/70 px-2 py-1 text-center">
                                        <span class="block text-slate-400">نقرات</span>
                                        <span class="font-bold text-rose-600 dark:text-rose-400">@u.ClickCount</span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                                    <span class="truncate max-w-[210px]">آخر تواجد: @(UserActivityService.GetArabicPageTitle(u.LastPagePath))</span>
                                    <span>@FormatRelativeTime(u.LastSeenUtc)</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>

            <!-- Right Column: Detailed Step-by-Step User Timeline -->
            <div class="lg:col-span-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                @if (_selectedUserSummary is null)
                {
                    <div class="p-12 text-center space-y-2">
                        <div class="mx-auto w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950 flex items-center justify-center text-indigo-600">
                            <Icon Name="cursor-arrow-rays" Class="w-6 h-6" />
                        </div>
                        <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">اختر مستخدماً من القائمة لعرض مساره الكامل</h3>
                        <p class="text-xs text-slate-500">سيتم عرض كل خطوة قام بها المستخدم من لحظة تسجيل الدخول وحتى الخروج بالتسلسل الزمني الدقيق.</p>
                    </div>
                }
                else
                {
                    <!-- Selected User Banner -->
                    <div class="p-5 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 class="text-lg font-black text-slate-900 dark:text-white">
                                        مسار حركات المستخدم: @(_selectedUserSummary.EmployeeName ?? _selectedUserSummary.UserName)
                                    </h2>
                                    @if (_selectedUserSummary.IsOnlineNow)
                                    {
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                                            متصل الآن
                                        </span>
                                    }
                                </div>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    اسم الحساب: <span class="font-bold">@_selectedUserSummary.UserName</span>
                                    | أول نشاط في الفترة: <span class="font-bold">@_selectedUserSummary.FirstSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    | آخر نشاط: <span class="font-bold">@_selectedUserSummary.LastSeenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                </p>
                            </div>

                            <!-- Category Filter inside Journey -->
                            <div class="flex flex-wrap items-center gap-1.5">
                                @foreach (var cat in _categoryFilters)
                                {
                                    var active = _journeyCategoryFilter == cat.Key;
                                    <button type="button"
                                            @onclick="() => _journeyCategoryFilter = cat.Key"
                                            class="px-2.5 py-1 rounded-lg text-xs font-bold transition @(active ? "bg-indigo-600 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700")">
                                        @cat.Label
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Chronological Journey Feed -->
                    <div class="p-5 max-h-[640px] overflow-y-auto space-y-3">
                        @{
                            var journeyEvents = GetSelectedUserJourneyEvents();
                        }
                        @if (journeyEvents.Count == 0)
                        {
                            <div class="p-8 text-center text-xs text-slate-400">
                                لا توجد حركات مطابقة للفلتر المحدد لهذا المستخدم.
                            </div>
                        }
                        else
                        {
                            <div class="relative pr-6 border-r-2 border-indigo-200 dark:border-indigo-900 space-y-3">
                                @foreach (var ev in journeyEvents)
                                {
                                    <div class="relative rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/90 p-3.5 shadow-xs hover:border-indigo-300 transition">
                                        <!-- Timeline Dot -->
                                        <span class="absolute -right-[31px] top-4 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-slate-900 @GetCategoryDotColor(ev.Category)"></span>

                                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold @GetCategoryBadgeClass(ev.Category)">
                                                    @GetCategoryArabicName(ev.Category)
                                                </span>
                                                <span class="text-sm font-extrabold text-slate-900 dark:text-white">
                                                    @ev.ActionTitle
                                                </span>
                                                @if (ev.DurationSeconds is > 0)
                                                {
                                                    <span class="px-2 py-0.5 rounded-md bg-violet-50 dark:bg-violet-950/70 text-violet-700 dark:text-violet-300 text-[11px] font-bold">
                                                        مدة البقاء: @FormatDuration(ev.DurationSeconds.Value)
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0" dir="ltr">
                                                @ev.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </div>
                                        </div>

                                        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-slate-600 dark:text-slate-300">
                                            @if (!string.IsNullOrWhiteSpace(ev.PagePath))
                                            {
                                                <div class="inline-flex items-center gap-1">
                                                    <span class="text-slate-400">الصفحة:</span>
                                                    <span class="font-bold text-indigo-600 dark:text-indigo-400">@(ev.PageTitle ?? UserActivityService.GetArabicPageTitle(ev.PagePath))</span>
                                                    <span class="text-[11px] text-slate-400 font-mono" dir="ltr">(@ev.PagePath)</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ev.ElementLabel))
                                            {
                                                <div class="inline-flex items-center gap-1">
                                                    <span class="text-slate-400">العنصر / الحقل:</span>
                                                    <span class="font-bold text-slate-800 dark:text-slate-100">@ev.ElementLabel</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ev.ValueText))
                                            {
                                                <div class="inline-flex items-center gap-1">
                                                    <span class="text-slate-400">القيمة / الاختيار:</span>
