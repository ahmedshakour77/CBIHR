                                    <td class="py-2.5 px-3 font-black text-indigo-600">@u.TotalEvents</td>
                                    <td class="py-2.5 px-3 font-semibold">@u.LoginCount</td>
                                    <td class="py-2.5 px-3 font-semibold text-violet-600">@u.PageViewCount</td>
                                    <td class="py-2.5 px-3 font-semibold text-amber-600">@u.DropdownCount</td>
                                    <td class="py-2.5 px-3 font-semibold text-emerald-600">@u.SearchCount</td>
                                    <td class="py-2.5 px-3 font-semibold text-rose-600">@u.ClickCount</td>
                                </tr>
