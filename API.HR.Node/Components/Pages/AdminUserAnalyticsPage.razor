    private static string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "أقل من ثانية";
        if (seconds < 60) return $"{seconds} ثانية";
        var mins = seconds / 60;
        var remSecs = seconds % 60;
        if (mins < 60) return remSecs > 0 ? $"{mins} د و {remSecs} ث" : $"{mins} دقيقة";
        var hours = mins / 60;
        var remMins = mins % 60;
        return $"{hours} ساعة و {remMins} د";
    }

    private static string FormatRelativeTime(DateTimeOffset utc)
    {
        var diff = DateTimeOffset.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "الآن";
        if (diff.TotalMinutes < 60) return $"منذ {(int)diff.TotalMinutes} د";
        if (diff.TotalHours < 24) return $"منذ {(int)diff.TotalHours} س";
        return utc.ToLocalTime().ToString("MM/dd HH:mm");
    }

