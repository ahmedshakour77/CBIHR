                <table class="w-full text-right text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/90 text-slate-600 dark:text-slate-300 sticky top-0 z-10 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="py-3 px-4 font-bold">الوقت</th>
