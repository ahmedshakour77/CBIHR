            </div>

            <!-- 3. Top Dropdown Changes & Top Searches -->
            <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-black text-slate-900 dark:text-white">أكثر القوائم المنسدلة (Dropdowns) وعبارات البحث استخداماً</h3>
                        <p class="text-xs text-slate-500">تحليل اختيارات المستخدمين في الفلاتر والقوائم وحقول البحث</p>
                    </div>
                    <Icon Name="adjustments-horizontal" Class="w-6 h-6 text-amber-600" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <h4 class="text-xs font-extrabold text-amber-700 dark:text-amber-400">تغييرات القوائم المنسدلة (Dropdowns)</h4>
                        @foreach (var d in GetTopDropdownStats())
                        {
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 text-xs">
                                <div class="truncate pl-2">
                                    <span class="font-bold text-slate-800 dark:text-slate-200">@d.Label:</span>
                                    <span class="text-amber-700 dark:text-amber-300 font-semibold mr-1">@d.Value</span>
                                </div>
                                <span class="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 font-bold shrink-0">@d.Count مرة</span>
                            </div>
                        }
                    </div>

                    <div class="space-y-2">
                        <h4 class="text-xs font-extrabold text-emerald-700 dark:text-emerald-400">عبارات البحث والإدخال</h4>
                        @foreach (var s in GetTopSearchStats())
                        {
                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 text-xs">
                                <div class="truncate pl-2">
                                    <span class="font-bold text-slate-800 dark:text-slate-200">@s.Label:</span>
                                    <span class="text-emerald-700 dark:text-emerald-300 font-semibold mr-1">@s.Value</span>
                                </div>
                                <span class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold shrink-0">@s.Count مرة</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 4. Hourly Activity Distribution -->
            <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-black text-slate-900 dark:text-white">توزيع كثافة النشاط حسب ساعات اليوم</h3>
                        <p class="text-xs text-slate-500">معرفة أوقات الذروة الفعلية لاستخدام النظام على مدار ٢٤ ساعة</p>
                    </div>
                    <Icon Name="clock" Class="w-6 h-6 text-violet-600" />
                </div>

                @{
                    var hourly = GetHourlyDistribution();
                    var maxHourCount = Math.Max(1, hourly.Max(x => x.Count));
                }
                <div class="grid grid-cols-12 gap-1.5 items-end h-44 pt-4 px-2">
                    @for (var h = 0; h < 24; h += 2)
                    {
                        var bucketCount = hourly[h].Count + hourly[h + 1].Count;
                        var heightPct = Math.Max(6, (int)Math.Round(bucketCount * 100.0 / (maxHourCount * 2)));
                        <div class="flex flex-col items-center gap-1 h-full justify-end">
                            <span class="text-[10px] font-bold text-slate-600 dark:text-slate-300">@bucketCount</span>
                            <div class="w-full rounded-t-lg bg-gradient-to-t from-indigo-600 to-violet-500 transition-all"
                                 style="height: @(Math.Min(100, heightPct))%"></div>
                            <span class="text-[10px] font-mono text-slate-400" dir="ltr">@($"{h:00}:00")</span>
                        </div>
                    }
                </div>
            </div>

        </div>
    }

</div>

@code {
    private sealed record RangeOption(string Key, string Label);
    private sealed record CategoryOption(string Key, string Label);
    private sealed record PageStatRow(string PagePath, string PageTitle, int VisitCount, int UniqueUsers, int TotalSeconds, int AverageSeconds);
    private sealed record LabelValueStatRow(string Label, string Value, int Count);
    private sealed record HourBucket(int Hour, int Count);

    private static readonly RangeOption[] _timeRanges =
    [
        new("today", "اليوم"),
        new("7d", "آخر ٧ أيام"),
        new("30d", "آخر ٣٠ يوماً"),
        new("all", "كل السجلات")
    ];

    private static readonly CategoryOption[] _categoryFilters =
    [
        new("", "الكل"),
        new(ActivityCategories.Auth, "الدخول والخروج"),
        new(ActivityCategories.Navigation, "الصفحات والمدة"),
        new(ActivityCategories.Dropdown, "القوائم المنسدلة"),
        new(ActivityCategories.Search, "البحث والكتابة"),
        new(ActivityCategories.Click, "النقرات والأزرار"),
        new(ActivityCategories.Security, "العمليات الأمنية")
    ];

    private string _selectedRange = "7d";
    private string _activeTab = "journey";
    private bool _autoRefresh = true;
    private DateTime _lastRefreshedLocal = DateTime.Now;
    private Timer? _refreshTimer;

    private List<UserActivityEvent> _allRangeEvents = [];
    private List<UserActivitySummaryDto> _userSummaries = [];

    private string _userListSearch = string.Empty;
    private string? _selectedUserKey;
    private UserActivitySummaryDto? _selectedUserSummary;
    private string _journeyCategoryFilter = string.Empty;

    private string _streamCategoryFilter = string.Empty;
    private string _streamUserFilter = string.Empty;
    private string _streamSearchQuery = string.Empty;

    private int _onlineUsersCount;
    private int _authEventsCount;
    private int _navEventsCount;
    private int _dropdownEventsCount;
    private int _searchEventsCount;
    private int _clickEventsCount;
    private int _securityEventsCount;

    private List<UserActivitySummaryDto> _filteredUserSummaries =>
        string.IsNullOrWhiteSpace(_userListSearch)
            ? _userSummaries
            : _userSummaries.Where(u =>
                u.UserName.Contains(_userListSearch, StringComparison.OrdinalIgnoreCase) ||
                (u.EmployeeName?.Contains(_userListSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.EmployeeId?.Contains(_userListSearch, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
        StartOrStopTimer();
    }

    private void StartOrStopTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_autoRefresh)
        {
            _refreshTimer = new Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshDataAsync();
                        StateHasChanged();
                    });
                }
                catch
                {
                    // Ignore timer disposal race
                }
            }, null, TimeSpan.FromSeconds(4), TimeSpan.FromSeconds(4));
        }
    }

    private void ToggleAutoRefresh()
    {
        _autoRefresh = !_autoRefresh;
        StartOrStopTimer();
    }

    private async Task ChangeRangeAsync(string rangeKey)
    {
        _selectedRange = rangeKey;
        await RefreshDataAsync();
    }

    private DateTimeOffset? GetFromUtc()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        return _selectedRange switch
        {
            "today" => new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero),
            "7d" => nowUtc.AddDays(-7),
            "30d" => nowUtc.AddDays(-30),
            _ => null
        };
    }

    private async Task RefreshDataAsync()
    {
        var fromUtc = GetFromUtc();

        // 1. Live & JSONL events from UserActivityService
        var memoryEvents = ActivityService.GetRecentEvents(fromUtc: fromUtc, maxCount: 8000).ToList();

        // 2. Also merge historical AuditLogs from SQLite so historical logins/actions are always included
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.AuditLogs.AsNoTracking().AsQueryable();
            if (fromUtc.HasValue)
            {
                var fromOffset = fromUtc.Value;
                query = query.Where(a => a.Timestamp >= fromOffset);
            }

            var dbLogs = await query
                .OrderByDescending(a => a.Timestamp)
                .Take(1000)
                .ToListAsync();

            var existingKeys = new HashSet<string>(
                memoryEvents.Select(e => $"{e.ActionCode}|{e.UserId}|{e.TimestampUtc.ToUnixTimeSeconds()}"),
                StringComparer.OrdinalIgnoreCase);

            foreach (var log in dbLogs)
            {
                var ts = log.Timestamp;
                var dedupKey = $"{log.Action}|{log.UserId}|{ts.ToUnixTimeSeconds()}";
                if (existingKeys.Contains(dedupKey))
                {
                    continue;
                }

                var isAuth = log.Action.Contains("LOGIN", StringComparison.OrdinalIgnoreCase)
                          || log.Action.Contains("LOGOUT", StringComparison.OrdinalIgnoreCase)
                          || log.Action.Contains("MAGIC", StringComparison.OrdinalIgnoreCase);

                memoryEvents.Add(new UserActivityEvent
                {
                    Id = $"db-{log.Id}",
                    TimestampUtc = ts,
                    UserId = log.UserId ?? string.Empty,
                    UserName = string.IsNullOrWhiteSpace(log.UserId) ? "النظام" : log.UserId,
                    EmployeeId = log.EmployeeID,
                    Category = isAuth ? ActivityCategories.Auth : ActivityCategories.Security,
                    ActionCode = log.Action,
                    ActionTitle = log.Action,
                    ValueText = log.FailureReason,
                    IpAddress = log.IpAddress,
                    UserAgent = log.UserAgent,
                    Success = log.Success
                });
            }
        }
        catch
        {
            // Keep fast in-memory stream if DB is busy
        }

        _allRangeEvents = memoryEvents
            .OrderByDescending(e => e.TimestampUtc)
            .ToList();

        // Rebuild user summaries across merged events
        var onlineCutoff = DateTimeOffset.UtcNow.AddMinutes(-5);
        _userSummaries = _allRangeEvents
            .Where(e => !string.IsNullOrWhiteSpace(e.UserName) || !string.IsNullOrWhiteSpace(e.UserId))
            .GroupBy(e => !string.IsNullOrWhiteSpace(e.UserName) ? e.UserName.ToLowerInvariant() : e.UserId.ToLowerInvariant())
            .Select(g =>
            {
                var ordered = g.OrderBy(x => x.TimestampUtc).ToList();
                var first = ordered[0];
                var last = ordered[^1];
                return new UserActivitySummaryDto(
                    UserId: last.UserId,
                    UserName: string.IsNullOrWhiteSpace(last.UserName) ? last.UserId : last.UserName,
                    EmployeeId: ordered.Select(x => x.EmployeeId).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    EmployeeName: ordered.Select(x => x.EmployeeName).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    UserRole: ordered.Select(x => x.UserRole).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    TotalEvents: ordered.Count,
                    LoginCount: ordered.Count(x => x.Category == ActivityCategories.Auth && x.ActionCode.Contains("LOGIN", StringComparison.OrdinalIgnoreCase)),
                    PageViewCount: ordered.Count(x => x.Category == ActivityCategories.Navigation && x.ActionCode == "PAGE_VIEW"),
                    SearchCount: ordered.Count(x => x.Category == ActivityCategories.Search),
                    DropdownCount: ordered.Count(x => x.Category == ActivityCategories.Dropdown),
                    ClickCount: ordered.Count(x => x.Category == ActivityCategories.Click),
                    SecurityCount: ordered.Count(x => x.Category == ActivityCategories.Security),
                    FirstSeenUtc: first.TimestampUtc,
                    LastSeenUtc: last.TimestampUtc,
                    LastPagePath: ordered.Select(x => x.PagePath).LastOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                    LastActionTitle: last.ActionTitle,
                    IsOnlineNow: last.TimestampUtc >= onlineCutoff && !string.Equals(last.ActionCode, "USER_LOGOUT", StringComparison.OrdinalIgnoreCase)
                );
            })
            .OrderByDescending(u => u.IsOnlineNow)
            .ThenByDescending(u => u.LastSeenUtc)
            .ToList();

        _onlineUsersCount = _userSummaries.Count(u => u.IsOnlineNow);
        _authEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Auth);
        _navEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Navigation && e.ActionCode == "PAGE_VIEW");
        _dropdownEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Dropdown);
        _searchEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Search);
        _clickEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Click);
        _securityEventsCount = _allRangeEvents.Count(e => e.Category == ActivityCategories.Security);

        if (string.IsNullOrWhiteSpace(_selectedUserKey) && _userSummaries.Count > 0)
        {
            _selectedUserSummary = _userSummaries[0];
            _selectedUserKey = _selectedUserSummary.UserName;
        }
        else if (!string.IsNullOrWhiteSpace(_selectedUserKey))
        {
            _selectedUserSummary = _userSummaries.FirstOrDefault(u =>
                string.Equals(u.UserName, _selectedUserKey, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(u.UserId, _selectedUserKey, StringComparison.OrdinalIgnoreCase));
        }

        _lastRefreshedLocal = DateTime.Now;
    }

    private void SelectUserForJourney(UserActivitySummaryDto user)
    {
        _selectedUserSummary = user;
        _selectedUserKey = user.UserName;
    }

    private List<UserActivityEvent> GetSelectedUserJourneyEvents()
    {
        if (_selectedUserSummary is null)
        {
            return [];
        }

        var query = _allRangeEvents.Where(e =>
            string.Equals(e.UserName, _selectedUserSummary.UserName, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(_selectedUserSummary.UserId) && string.Equals(e.UserId, _selectedUserSummary.UserId, StringComparison.OrdinalIgnoreCase)));

        if (!string.IsNullOrWhiteSpace(_journeyCategoryFilter))
        {
            query = query.Where(e => string.Equals(e.Category, _journeyCategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderByDescending(e => e.TimestampUtc).Take(300).ToList();
    }

    private List<UserActivityEvent> GetFilteredStreamEvents()
    {
        var query = _allRangeEvents.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_streamCategoryFilter))
        {
            query = query.Where(e => string.Equals(e.Category, _streamCategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_streamUserFilter))
        {
            query = query.Where(e =>
                string.Equals(e.UserName, _streamUserFilter, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(e.UserId, _streamUserFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_streamSearchQuery))
        {
            var q = _streamSearchQuery.Trim();
            query = query.Where(e =>
                e.ActionTitle.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.UserName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (e.EmployeeName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.ElementLabel?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.ValueText?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.PageTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.PagePath?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query.ToList();
    }

    private List<PageStatRow> GetTopPagesStats()
    {
        return _allRangeEvents
            .Where(e => e.Category == ActivityCategories.Navigation && !string.IsNullOrWhiteSpace(e.PagePath))
            .GroupBy(e => e.PagePath!.ToLowerInvariant())
            .Select(g =>
            {
                var visits = g.Count(x => x.ActionCode == "PAGE_VIEW");
                var totalSecs = g.Where(x => x.DurationSeconds is > 0).Sum(x => x.DurationSeconds ?? 0);
                var effectiveVisits = Math.Max(1, visits);
                var first = g.First();
                return new PageStatRow(
                    PagePath: first.PagePath!,
                    PageTitle: first.PageTitle ?? UserActivityService.GetArabicPageTitle(first.PagePath),
                    VisitCount: effectiveVisits,
                    UniqueUsers: g.Select(x => x.UserName).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                    TotalSeconds: totalSecs,
                    AverageSeconds: totalSecs / effectiveVisits);
            })
            .OrderByDescending(p => p.VisitCount)
            .ThenByDescending(p => p.TotalSeconds)
            .Take(10)
            .ToList();
    }

    private List<LabelValueStatRow> GetTopDropdownStats()
    {
        return _allRangeEvents
            .Where(e => e.Category == ActivityCategories.Dropdown && !string.IsNullOrWhiteSpace(e.ValueText))
            .GroupBy(e => $"{e.ElementLabel ?? "قائمة"}|{e.ValueText}")
            .Select(g =>
            {
                var f = g.First();
                return new LabelValueStatRow(f.ElementLabel ?? "قائمة منسدلة", f.ValueText ?? "", g.Count());
            })
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToList();
    }

    private List<LabelValueStatRow> GetTopSearchStats()
    {
        return _allRangeEvents
            .Where(e => e.Category == ActivityCategories.Search && !string.IsNullOrWhiteSpace(e.ValueText))
            .GroupBy(e => $"{e.ElementLabel ?? "حقل بحث"}|{e.ValueText}")
            .Select(g =>
            {
                var f = g.First();
                return new LabelValueStatRow(f.ElementLabel ?? "حقل بحث", f.ValueText ?? "", g.Count());
            })
            .OrderByDescending(x => x.Count)
            .Take(8)
            .ToList();
    }

    private List<HourBucket> GetHourlyDistribution()
    {
        var counts = new int[24];
        foreach (var ev in _allRangeEvents)
        {
            var localHour = ev.TimestampUtc.ToLocalTime().Hour;
            if (localHour is >= 0 and < 24)
            {
                counts[localHour]++;
            }
        }
        return Enumerable.Range(0, 24).Select(h => new HourBucket(h, counts[h])).ToList();
    }

    private async Task ExportCsvAsync()
    {
        var rows = GetFilteredStreamEvents();
        var sb = new StringBuilder();
        sb.AppendLine("Timestamp,UserName,EmployeeName,Role,Category,ActionTitle,PageTitle,PagePath,ElementLabel,ValueText,DurationSeconds,IpAddress");

        foreach (var r in rows)
        {
            sb.AppendLine(string.Join(",",
                EscapeCsv(r.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")),
                EscapeCsv(r.UserName),
                EscapeCsv(r.EmployeeName),
                EscapeCsv(r.UserRole),
                EscapeCsv(GetCategoryArabicName(r.Category)),
                EscapeCsv(r.ActionTitle),
                EscapeCsv(r.PageTitle ?? UserActivityService.GetArabicPageTitle(r.PagePath)),
                EscapeCsv(r.PagePath),
                EscapeCsv(r.ElementLabel),
                EscapeCsv(r.ValueText),
                r.DurationSeconds?.ToString() ?? "",
                EscapeCsv(r.IpAddress)));
        }

        var csvBytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(csvBytes);
        await JS.InvokeVoidAsync("eval", $"{{ const a = document.createElement('a'); a.href = 'data:text/csv;base64,{base64}'; a.download = 'user-activity-{DateTime.Now:yyyyMMdd-HHmm}.csv'; a.click(); }}");
    }

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "\"\"";
        return $"\"{val.Replace("\"", "\"\"")}\"";
    }

